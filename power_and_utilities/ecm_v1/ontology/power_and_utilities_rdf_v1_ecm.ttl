ind:complianceGapType rdf:type rdf:Property ;
    rdfs:label 'Compliance Gap Type' ;
    rdfs:comment 'Indicates whether the gap represents a surplus (excess RECs) or a deficit (shortfall).' ;
    rdfs:domain ind:RpsObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recsRetiredMwh rdf:type rdf:Property ;
    rdfs:label 'Recs Retired Mwh' ;
    rdfs:comment 'Total RECs that have been retired (submitted) for the compliance year and jurisdiction.' ;
    rdfs:domain ind:RpsObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recsRetiredPercentage rdf:type rdf:Property ;
    rdfs:label 'Recs Retired Percentage' ;
    rdfs:comment 'Percentage of required RECs that have been retired.' ;
