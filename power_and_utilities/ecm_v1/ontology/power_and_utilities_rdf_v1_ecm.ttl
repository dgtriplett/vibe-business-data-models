    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:derAssetResourceId rdf:type rdf:Property ;
    rdfs:label 'Der Asset Resource Id' ;
    rdfs:comment 'Identifier of the Distributed Energy Resource asset to which this performance summary applies.' ;
