ind:isOutageProne rdf:type rdf:Property ;
    rdfs:label 'Is Outage Prone' ;
    rdfs:comment 'True if the feeder historically experiences frequent outages.' ;
    rdfs:domain ind:Feeder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isUnderConstruction rdf:type rdf:Property ;
    rdfs:label 'Is Under Construction' ;
    rdfs:comment 'True if the feeder is currently being built or upgraded.' ;
    rdfs:domain ind:Distribution ;
