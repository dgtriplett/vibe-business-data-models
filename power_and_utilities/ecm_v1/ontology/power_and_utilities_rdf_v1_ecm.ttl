    rdfs:domain ind:Body ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isFederal rdf:type rdf:Property ;
    rdfs:label 'Is Federal' ;
    rdfs:comment 'True if the agency operates at the federal level.' ;
    rdfs:domain ind:Body ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRegional rdf:type rdf:Property ;
    rdfs:label 'Is Regional' ;
    rdfs:comment 'True if the agency operates at a regional or multi-state level.' ;
    rdfs:domain ind:Body ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isState rdf:type rdf:Property ;
    rdfs:label 'Is State' ;
    rdfs:comment 'True if the agency operates at the state level.' ;
    rdfs:domain ind:Body ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:phoneVerified rdf:type rdf:Property ;
    rdfs:label 'Phone Verified' ;
