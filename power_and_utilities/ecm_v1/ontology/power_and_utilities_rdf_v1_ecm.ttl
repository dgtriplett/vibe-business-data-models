    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ansiStandard rdf:type rdf:Property ;
    rdfs:label 'Ansi Standard' ;
    rdfs:comment 'ANSI standard applied for the test (e.g., ANSI C12.1).' ;
