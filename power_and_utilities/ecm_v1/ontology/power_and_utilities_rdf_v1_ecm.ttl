ind:feederType rdf:type rdf:Property ;
    rdfs:label 'Feeder Type' ;
    rdfs:comment 'Physical construction type of the feeder.' ;
    rdfs:domain ind:Feeder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gisGeometryReference rdf:type rdf:Property ;
    rdfs:label 'Gis Geometry Reference' ;
    rdfs:comment 'Reference to the GIS polyline that models the feeder route.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
