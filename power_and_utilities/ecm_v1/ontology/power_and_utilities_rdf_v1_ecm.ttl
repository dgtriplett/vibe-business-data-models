ind:caidiContribution rdf:type rdf:Property ;
    rdfs:label 'Caidi Contribution' ;
    rdfs:comment 'Average interruption duration contributed by this event to the Customer Average Interruption Duration Index.' ;
    rdfs:domain ind:DistributionOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:customerNotificationStatus rdf:type rdf:Property ;
    rdfs:label 'Customer Notification Status' ;
    rdfs:comment 'Indicates whether affected customers were notified about the outage.' ;
    rdfs:domain ind:DistributionOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:distributionOutageEventDescription rdf:type rdf:Property ;
    rdfs:label 'Distribution Outage Event Description' ;
    rdfs:comment 'Free-form text describing the outage circumstances, equipment involved, or special notes.' ;
