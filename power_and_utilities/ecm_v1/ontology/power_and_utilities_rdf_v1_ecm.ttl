    rdfs:comment 'Foreign key linking to finance.cost_center. Business justification: Outage events\' cost allocation to a cost center is required for Outage Cost Analysis and regulatory reporting.' ;
    rdfs:domain ind:DistributionOutageEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CostCenter .

ind:protectiveDeviceId rdf:type rdf:Property ;
