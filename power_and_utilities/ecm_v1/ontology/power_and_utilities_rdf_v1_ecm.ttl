ind:regulatoryZone rdf:type rdf:Property ;
    rdfs:label 'Regulatory Zone' ;
    rdfs:comment 'Regulatory service zone or jurisdiction applicable to the premise.' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceEligibilityFlag rdf:type rdf:Property ;
    rdfs:label 'Service Eligibility Flag' ;
    rdfs:comment 'Indicates whether the premise is eligible for utility service (true) or excluded (false).' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:zipPlus4 rdf:type rdf:Property ;
    rdfs:label 'Zip Plus4' ;
    rdfs:comment 'Postal code (ZIP+4) for the premise.' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentId rdf:type rdf:Property ;
    rdfs:label 'Segment Id' ;
    rdfs:comment 'Primary key for segment' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:amiEligibilityFlag rdf:type rdf:Property ;
    rdfs:label 'Ami Eligibility Flag' ;
    rdfs:comment 'Indicates whether customers in this segment are eligible for AMI meters.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:drEligibilityFlag rdf:type rdf:Property ;
    rdfs:label 'Dr Eligibility Flag' ;
    rdfs:comment 'Indicates whether the segment can be enrolled in demand-response programs.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:loadProfileClass rdf:type rdf:Property ;
    rdfs:label 'Load Profile Class' ;
    rdfs:comment 'Classification of typical consumption pattern for the segment.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentCode rdf:type rdf:Property ;
    rdfs:label 'Segment Code' ;
    rdfs:comment 'Short alphanumeric code that uniquely identifies the segment within the utility.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentDescription rdf:type rdf:Property ;
    rdfs:label 'Segment Description' ;
    rdfs:comment 'Narrative description providing business context, usage rules, and any special characteristics.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentName rdf:type rdf:Property ;
    rdfs:label 'Segment Name' ;
    rdfs:comment 'Descriptive name of the market segment, e.g., "Small Commercial".' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentStatus rdf:type rdf:Property ;
    rdfs:label 'Segment Status' ;
    rdfs:comment 'Operational status of the segment record.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentTier rdf:type rdf:Property ;
    rdfs:label 'Segment Tier' ;
    rdfs:comment 'Broad classification of the segment by customer type: Residential, Commercial, or Industrial.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subSegment rdf:type rdf:Property ;
    rdfs:label 'Sub Segment' ;
    rdfs:comment 'Specific sub-category such as "Small Commercial", "Large Industrial", or "Agricultural". [ENUM-REF-CANDIDATE: small_commercial|large_commercial|small_industrial|large_industrial|agricultural|government] ' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryTariffScheduleId rdf:type rdf:Property ;
    rdfs:label 'Regulatory Tariff Schedule Id' ;
    rdfs:comment 'Foreign key linking to regulatory.tariff_schedule. Business justification: Service agreements must reference the approved regulatory tariff schedule that governs rates; this link enables rate compliance reporting.' ;
    rdfs:domain ind:ServiceAgreement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TariffSchedule .

ind:servicePointId rdf:type rdf:Property ;
    rdfs:label 'Service Point Id' ;
    rdfs:comment 'FK to distribution.service_point.service_point_id — Customer service agreements are delivered at a physical service point on the distribution network. This FK links customer contracts to physical infrastructure for outage impact analysis.' ;
    rdfs:domain ind:ServiceAgreement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CustomerServicePoint .

ind:billingMethod rdf:type rdf:Property ;
    rdfs:label 'Billing Method' ;
    rdfs:comment 'Preferred method for delivering bills and receiving payments.' ;
    rdfs:domain ind:ServiceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commodityType rdf:type rdf:Property ;
    rdfs:label 'Commodity Type' ;
    rdfs:comment 'Energy commodity supplied under the agreement.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractEndDate rdf:type rdf:Property ;
    rdfs:label 'Contract End Date' ;
    rdfs:comment 'Date the service agreement terminates or expires; null for open-ended contracts.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contractStartDate rdf:type rdf:Property ;
    rdfs:label 'Contract Start Date' ;
    rdfs:comment 'Date the service agreement becomes effective.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contractTermMonths rdf:type rdf:Property ;
    rdfs:label 'Contract Term Months' ;
    rdfs:comment 'Length of the contract in months.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contractTermYears rdf:type rdf:Property ;
    rdfs:label 'Contract Term Years' ;
    rdfs:comment 'Length of the contract in years.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:earlyTerminationFee rdf:type rdf:Property ;
    rdfs:label 'Early Termination Fee' ;
    rdfs:comment 'Fee charged if the agreement is terminated before the contractual end date.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedAnnualUsageMwh rdf:type rdf:Property ;
    rdfs:label 'Estimated Annual Usage Mwh' ;
    rdfs:comment 'Projected annual electricity consumption, expressed in megawatt-hours.' ;
    rdfs:domain ind:ServiceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedMonthlyUsageKwh rdf:type rdf:Property ;
    rdfs:label 'Estimated Monthly Usage Kwh' ;
    rdfs:comment 'Projected electricity consumption for the agreement period, expressed in kilowatt-hours.' ;
    rdfs:domain ind:ServiceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isPrimaryAgreement rdf:type rdf:Property ;
    rdfs:label 'Is Primary Agreement' ;
    rdfs:comment 'True if this agreement is the primary contract for the customer at the service point.' ;
    rdfs:domain ind:ServiceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastBillDate rdf:type rdf:Property ;
    rdfs:label 'Last Bill Date' ;
    rdfs:comment 'Date of the most recent bill issued under this agreement.' ;
    rdfs:domain ind:ServiceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:meterReadCycleDays rdf:type rdf:Property ;
    rdfs:label 'Meter Read Cycle Days' ;
    rdfs:comment 'Number of days between successive meter reads.' ;
    rdfs:domain ind:ServiceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:nextBillDate rdf:type rdf:Property ;
    rdfs:label 'Next Bill Date' ;
    rdfs:comment 'Scheduled date for the next billing cycle.' ;
    rdfs:domain ind:ServiceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paymentTerms rdf:type rdf:Property ;
    rdfs:label 'Payment Terms' ;
    rdfs:comment 'Standard payment terms for invoicing.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateCategory rdf:type rdf:Property ;
    rdfs:label 'Rate Category' ;
    rdfs:comment 'Category of the rate schedule (e.g., fixed, variable, TOU).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryRateCode rdf:type rdf:Property ;
    rdfs:label 'Regulatory Rate Code' ;
    rdfs:comment 'Code used for regulatory reporting of the rate applied.' ;
    rdfs:domain ind:ServiceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceAgreementStatus rdf:type rdf:Property ;
    rdfs:label 'Service Agreement Status' ;
    rdfs:comment 'Current lifecycle status of the service agreement.' ;
    rdfs:domain ind:ServiceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceClass rdf:type rdf:Property ;
    rdfs:label 'Service Class' ;
    rdfs:comment 'Classification of the service based on customer segment.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceLocationLatitude rdf:type rdf:Property ;
    rdfs:label 'Service Location Latitude' ;
    rdfs:comment 'Latitude coordinate of the service point location.' ;
    rdfs:domain ind:ServiceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:serviceLocationLongitude rdf:type rdf:Property ;
    rdfs:label 'Service Location Longitude' ;
    rdfs:comment 'Longitude coordinate of the service point location.' ;
    rdfs:domain ind:ServiceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:serviceStatus rdf:type rdf:Property ;
    rdfs:label 'Service Status' ;
    rdfs:comment 'Current operational status of the service point.' ;
    rdfs:domain ind:Customer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerServicePointId rdf:type rdf:Property ;
    rdfs:label 'Customer Service Point Id' ;
    rdfs:comment 'Unique identifier for the service point.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CustomerServicePoint .

ind:circuitFeederId rdf:type rdf:Property ;
    rdfs:label 'Circuit Feeder Id' ;
    rdfs:comment 'Identifier of the distribution circuit serving the service point.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Feeder .

ind:feederId rdf:type rdf:Property ;
    rdfs:label 'Feeder Id' ;
    rdfs:comment 'Identifier of the feeder line within the circuit.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Feeder .

ind:servicePlanId rdf:type rdf:Property ;
    rdfs:label 'Service Plan Id' ;
    rdfs:comment 'Foreign key linking to product.service_plan. Business justification: Operations track which service plan (pricing structure, contract terms) applies to each service point; required for outage management, demand response enrollment, and compliance reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ServicePlan .

ind:connectionType rdf:type rdf:Property ;
    rdfs:label 'Connection Type' ;
    rdfs:comment 'Physical method of connecting the service point to the distribution network.' ;
    rdfs:domain ind:CustomerServicePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enrollmentDr rdf:type rdf:Property ;
    rdfs:label 'Enrollment Dr' ;
    rdfs:comment 'Indicates participation in Demand Response programs.' ;
    rdfs:domain ind:CustomerServicePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:enrollmentNem rdf:type rdf:Property ;
    rdfs:label 'Enrollment Nem' ;
    rdfs:comment 'Indicates participation in Net Energy Metering program.' ;
    rdfs:domain ind:CustomerServicePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:enrollmentTou rdf:type rdf:Property ;
    rdfs:label 'Enrollment Tou' ;
    rdfs:comment 'Indicates participation in Time-of-Use pricing program.' ;
    rdfs:domain ind:CustomerServicePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:estimatedAnnualConsumptionKwh rdf:type rdf:Property ;
    rdfs:label 'Estimated Annual Consumption Kwh' ;
    rdfs:comment 'Projected annual electricity consumption for planning.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedAnnualConsumptionMcf rdf:type rdf:Property ;
    rdfs:label 'Estimated Annual Consumption Mcf' ;
    rdfs:comment 'Projected annual natural gas consumption.' ;
    rdfs:domain ind:CustomerServicePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:meterInstallationDate rdf:type rdf:Property ;
    rdfs:label 'Meter Installation Date' ;
    rdfs:comment 'Date the current meter was installed at the service point.' ;
    rdfs:domain ind:CustomerServicePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:outageHistoryFlag rdf:type rdf:Property ;
    rdfs:label 'Outage History Flag' ;
    rdfs:comment 'Indicates if outage history is recorded for this service point.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:phaseConfiguration rdf:type rdf:Property ;
    rdfs:label 'Phase Configuration' ;
    rdfs:comment 'Electrical phase configuration of the service point.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceEndDate rdf:type rdf:Property ;
    rdfs:label 'Service End Date' ;
    rdfs:comment 'Date the service point was disconnected or decommissioned.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:servicePointNumber rdf:type rdf:Property ;
    rdfs:label 'Service Point Number' ;
    rdfs:comment 'External reference number for the service point used in CIS.' ;
    rdfs:domain ind:CustomerServicePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceStartDate rdf:type rdf:Property ;
    rdfs:label 'Service Start Date' ;
    rdfs:comment 'Date the service point was first energized for the customer.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:statusEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Status Effective Date' ;
    rdfs:comment 'Date when the current service status became effective.' ;
    rdfs:domain ind:CustomerServicePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:voltageClass rdf:type rdf:Property ;
    rdfs:label 'Voltage Class' ;
    rdfs:comment 'Voltage level of the service point connection.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceTerritoryId rdf:type rdf:Property ;
    rdfs:label 'Service Territory Id' ;
    rdfs:comment 'Primary key for service_territory' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ServiceTerritory .

ind:areaSqMi rdf:type rdf:Property ;
    rdfs:label 'Area Sq Mi' ;
    rdfs:comment 'Geographic area of the territory in square miles.' ;
    rdfs:domain ind:ServiceTerritory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:countyList rdf:type rdf:Property ;
    rdfs:label 'County List' ;
    rdfs:comment 'Comma-separated list of counties included in the territory.' ;
    rdfs:domain ind:ServiceTerritory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gisPolygonCode rdf:type rdf:Property ;
    rdfs:label 'Gis Polygon Code' ;
    rdfs:comment 'Identifier of the GIS polygon stored in the ArcGIS system representing the territory boundary.' ;
    rdfs:domain ind:ServiceTerritory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isCrossState rdf:type rdf:Property ;
    rdfs:label 'Is Cross State' ;
    rdfs:comment 'Indicates if the territory spans more than one state.' ;
    rdfs:domain ind:ServiceTerritory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isDrEligible rdf:type rdf:Property ;
    rdfs:label 'Is Dr Eligible' ;
    rdfs:comment 'Flag indicating eligibility for Demand Response programs.' ;
    rdfs:domain ind:ServiceTerritory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isNemEligible rdf:type rdf:Property ;
    rdfs:label 'Is Nem Eligible' ;
    rdfs:comment 'Flag indicating whether customers in the territory are eligible for Net Energy Metering programs.' ;
    rdfs:domain ind:ServiceTerritory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isTouEligible rdf:type rdf:Property ;
    rdfs:label 'Is Tou Eligible' ;
    rdfs:comment 'Flag indicating eligibility for Time-of-Use rate structures.' ;
    rdfs:domain ind:ServiceTerritory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:jurisdictionPuc rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Puc' ;
    rdfs:comment 'Public Utility Commission (PUC) or Public Service Commission (PSC) docket reference governing the territory.' ;
    rdfs:domain ind:ServiceTerritory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdictionState rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction State' ;
    rdfs:comment 'Two-letter state abbreviation where the territory is located. [ENUM-REF-CANDIDATE: AL|AK|AZ|AR|CA|CO|CT|DE|FL|GA|HI|ID|IL|IN|IA|KS|KY|LA|ME|MD|MA|MI|MN|MS|MO|MT|NE|NV|NH|NJ|NM|NY|NC|ND|OH|OK|OR|PA|RI|SC|SD|TN|TX|UT|VT|VA|WA|WV|WI|WY — promote to reference product]' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastRegulatoryReviewDate rdf:type rdf:Property ;
    rdfs:label 'Last Regulatory Review Date' ;
    rdfs:comment 'Date of the most recent regulatory review or filing for the territory.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:municipalityList rdf:type rdf:Property ;
    rdfs:label 'Municipality List' ;
    rdfs:comment 'Comma-separated list of municipalities included in the territory.' ;
    rdfs:domain ind:ServiceTerritory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryRateScheduleCode rdf:type rdf:Property ;
    rdfs:label 'Primary Rate Schedule Code' ;
    rdfs:comment 'Default rate schedule code applied to customers in this territory.' ;
    rdfs:domain ind:ServiceTerritory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateZone rdf:type rdf:Property ;
    rdfs:label 'Rate Zone' ;
    rdfs:comment 'Rate zone designation used for billing and tariff calculations. [ENUM-REF-CANDIDATE: multiple zones — promote to reference product]' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryDocketUrl rdf:type rdf:Property ;
    rdfs:label 'Regulatory Docket Url' ;
    rdfs:comment 'Web URL to the regulatory docket or filing document.' ;
    rdfs:domain ind:ServiceTerritory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceTerritoryDescription rdf:type rdf:Property ;
    rdfs:label 'Service Territory Description' ;
    rdfs:comment 'Free-form description of the territory, including any special characteristics.' ;
    rdfs:domain ind:ServiceTerritory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceTerritoryStatus rdf:type rdf:Property ;
    rdfs:label 'Service Territory Status' ;
    rdfs:comment 'Current lifecycle status of the territory record.' ;
    rdfs:domain ind:ServiceTerritory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:territoryCode rdf:type rdf:Property ;
    rdfs:label 'Territory Code' ;
    rdfs:comment 'Unique code assigned to the service territory by the utility.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:territoryName rdf:type rdf:Property ;
    rdfs:label 'Territory Name' ;
    rdfs:comment 'Human-readable name of the service territory.' ;
    rdfs:domain ind:ServiceTerritory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thirdPartyAccessId rdf:type rdf:Property ;
    rdfs:label 'Third Party Access Id' ;
    rdfs:comment 'System-generated unique identifier for each third-party access authorization record.' ;
    rdfs:domain ind:ThirdPartyAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:accessCategory rdf:type rdf:Property ;
    rdfs:label 'Access Category' ;
    rdfs:comment 'Permission level granted to the third-party (read-only, write-only, or both).' ;
    rdfs:domain ind:ThirdPartyAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accessReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Access Reference Code' ;
    rdfs:comment 'External reference number or code used by business processes to identify the authorization.' ;
    rdfs:domain ind:ThirdPartyAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorizationScope rdf:type rdf:Property ;
    rdfs:label 'Authorization Scope' ;
    rdfs:comment 'Scope of data the third-party is permitted to access (e.g., usage data, billing data, account data, or all).' ;
    rdfs:domain ind:ThirdPartyAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentChannel rdf:type rdf:Property ;
    rdfs:label 'Consent Channel' ;
    rdfs:comment 'Channel through which the customer gave consent (e.g., web portal, mobile app, phone call, email, in-person).' ;
    rdfs:domain ind:ThirdPartyAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataTypesShared rdf:type rdf:Property ;
    rdfs:label 'Data Types Shared' ;
    rdfs:comment 'Comma-separated list of data categories shared with the third-party (e.g., "usage, billing, account").' ;
    rdfs:domain ind:ThirdPartyAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:privacyPolicyUrl rdf:type rdf:Property ;
    rdfs:label 'Privacy Policy Url' ;
    rdfs:comment 'Link to the third-party\'s privacy policy governing data use.' ;
    rdfs:domain ind:ThirdPartyAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revocationStatus rdf:type rdf:Property ;
    rdfs:label 'Revocation Status' ;
    rdfs:comment 'Current revocation state of the access authorization.' ;
    rdfs:domain ind:ThirdPartyAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revocationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Revocation Timestamp' ;
    rdfs:comment 'Timestamp when the access was revoked or automatically expired.' ;
    rdfs:domain ind:ThirdPartyAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:thirdPartyAccessStatus rdf:type rdf:Property ;
    rdfs:label 'Third Party Access Status' ;
    rdfs:comment 'Overall lifecycle status of the third-party access record.' ;
    rdfs:domain ind:ThirdPartyAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thirdPartyType rdf:type rdf:Property ;
    rdfs:label 'Third Party Type' ;
    rdfs:comment 'Category describing the business role of the third-party entity.' ;
    rdfs:domain ind:ThirdPartyAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aggregatorId rdf:type rdf:Property ;
    rdfs:label 'Aggregator Id' ;
    rdfs:comment 'System identifier of the managing aggregator entity.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Aggregator .

ind:primaryAggregationAggregatorId rdf:type rdf:Property ;
    rdfs:label 'Primary Aggregation Aggregator Id' ;
    rdfs:comment 'System identifier of the managing aggregator entity.' ;
    rdfs:domain ind:AggregationGroup ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Aggregator .

ind:aggregationCode rdf:type rdf:Property ;
    rdfs:label 'Aggregation Code' ;
    rdfs:comment 'External business code or identifier used to reference the aggregation group in market filings and contracts.' ;
    rdfs:domain ind:AggregationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aggregationGroupDescription rdf:type rdf:Property ;
    rdfs:label 'Aggregation Group Description' ;
    rdfs:comment 'Free-form description providing additional context about the aggregation.' ;
    rdfs:domain ind:AggregationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aggregationGroupName rdf:type rdf:Property ;
    rdfs:label 'Aggregation Group Name' ;
    rdfs:comment 'Human-readable name of the aggregation group.' ;
    rdfs:domain ind:AggregationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aggregationGroupStatus rdf:type rdf:Property ;
    rdfs:label 'Aggregation Group Status' ;
    rdfs:comment 'Current lifecycle status of the aggregation group.' ;
    rdfs:domain ind:AggregationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aggregationType rdf:type rdf:Property ;
    rdfs:label 'Aggregation Type' ;
    rdfs:comment 'Category of the aggregation (e.g., Virtual Power Plant, DER fleet, microgrid, or third-party aggregator).' ;
    rdfs:domain ind:AggregationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aggregatorEntityName rdf:type rdf:Property ;
    rdfs:label 'Aggregator Entity Name' ;
    rdfs:comment 'Legal name of the entity that manages the aggregation.' ;
    rdfs:domain ind:AggregationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ancillaryServiceType rdf:type rdf:Property ;
    rdfs:label 'Ancillary Service Type' ;
    rdfs:comment 'Type of ancillary service the aggregation is authorized to provide.' ;
    rdfs:domain ind:AggregationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capacityReserveMw rdf:type rdf:Property ;
    rdfs:label 'Capacity Reserve Mw' ;
    rdfs:comment 'Reserved capacity held by the aggregation for reliability or ancillary services.' ;
    rdfs:domain ind:AggregationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:demandResponseCapability rdf:type rdf:Property ;
    rdfs:label 'Demand Response Capability' ;
    rdfs:comment 'Indicates whether the aggregation can participate in demand-response programs.' ;
    rdfs:domain ind:AggregationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:demandResponseProgram rdf:type rdf:Property ;
    rdfs:label 'Demand Response Program' ;
    rdfs:comment 'Identifier of the demand-response program the aggregation is enrolled in.' ;
    rdfs:domain ind:AggregationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispatchMaxMw rdf:type rdf:Property ;
    rdfs:label 'Dispatch Max Mw' ;
    rdfs:comment 'Maximum MW the aggregation can be dispatched for a given market interval.' ;
    rdfs:domain ind:AggregationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dispatchMinMw rdf:type rdf:Property ;
    rdfs:label 'Dispatch Min Mw' ;
    rdfs:comment 'Minimum MW the aggregation can be dispatched for a given market interval.' ;
    rdfs:domain ind:AggregationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:geographicBoundaryDescription rdf:type rdf:Property ;
    rdfs:label 'Geographic Boundary Description' ;
    rdfs:comment 'Textual description of the geographic area covered by the aggregation (e.g., county list, service territory).' ;
    rdfs:domain ind:AggregationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographicBoundaryType rdf:type rdf:Property ;
    rdfs:label 'Geographic Boundary Type' ;
    rdfs:comment 'Classification of how the geographic boundary is defined.' ;
    rdfs:domain ind:AggregationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isVirtual rdf:type rdf:Property ;
    rdfs:label 'Is Virtual' ;
    rdfs:comment 'Indicates whether the aggregation exists purely as a virtual construct (true) or includes physical assets (false).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastComplianceCheckDate rdf:type rdf:Property ;
    rdfs:label 'Last Compliance Check Date' ;
    rdfs:comment 'Date of the most recent compliance audit for the aggregation.' ;
    rdfs:domain ind:AggregationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:marketParticipationEndDate rdf:type rdf:Property ;
    rdfs:label 'Market Participation End Date' ;
    rdfs:comment 'Date when the aggregation ceased market participation (null if ongoing).' ;
    rdfs:domain ind:AggregationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:marketParticipationStartDate rdf:type rdf:Property ;
    rdfs:label 'Market Participation Start Date' ;
    rdfs:comment 'Date when the aggregation first began participating in market operations.' ;
    rdfs:domain ind:AggregationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:marketProductsAuthorized rdf:type rdf:Property ;
    rdfs:label 'Market Products Authorized' ;
    rdfs:comment 'Comma-separated list of market products the aggregation is authorized to provide.' ;
    rdfs:domain ind:AggregationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketRegistrationCode rdf:type rdf:Property ;
    rdfs:label 'Market Registration Code' ;
    rdfs:comment 'Unique identifier assigned by the RTO/ISO for market registration of the aggregation.' ;
    rdfs:domain ind:AggregationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netEnergyMeteringEnabled rdf:type rdf:Property ;
    rdfs:label 'Net Energy Metering Enabled' ;
    rdfs:comment 'True if the aggregation includes assets participating in a NEM program.' ;
    rdfs:domain ind:AggregationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:netEnergyMeteringProgram rdf:type rdf:Property ;
    rdfs:label 'Net Energy Metering Program' ;
    rdfs:comment 'Name of the NEM program associated with the aggregation.' ;
    rdfs:domain ind:AggregationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:participationMode rdf:type rdf:Property ;
    rdfs:label 'Participation Mode' ;
    rdfs:comment 'Mode of market participation for the aggregation.' ;
    rdfs:domain ind:AggregationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewableEnergyCertificateQuantity rdf:type rdf:Property ;
    rdfs:label 'Renewable Energy Certificate Quantity' ;
    rdfs:comment 'Quantity of Renewable Energy Certificates generated by the aggregation, expressed in megawatt-hours.' ;
    rdfs:domain ind:AggregationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:renewableEnergyCertificateType rdf:type rdf:Property ;
    rdfs:label 'Renewable Energy Certificate Type' ;
    rdfs:comment 'Type of Renewable Energy Certificate associated with the aggregation.' ;
    rdfs:domain ind:AggregationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resourceMixEvPct rdf:type rdf:Property ;
    rdfs:label 'Resource Mix Ev Pct' ;
    rdfs:comment 'Percentage of the aggregation\'s capacity that is provided by electric-vehicle charging infrastructure.' ;
    rdfs:domain ind:AggregationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:resourceMixSolarPct rdf:type rdf:Property ;
    rdfs:label 'Resource Mix Solar Pct' ;
    rdfs:comment 'Percentage of the aggregation\'s capacity that is provided by solar generation assets.' ;
    rdfs:domain ind:AggregationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:resourceMixStoragePct rdf:type rdf:Property ;
    rdfs:label 'Resource Mix Storage Pct' ;
    rdfs:comment 'Percentage of the aggregation\'s capacity that is provided by battery storage assets.' ;
    rdfs:domain ind:AggregationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rtoIsoMarket rdf:type rdf:Property ;
    rdfs:label 'Rto Iso Market' ;
    rdfs:comment 'Regional Transmission Organization or Independent System Operator market where the aggregation participates.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Settlement Account Number' ;
    rdfs:comment 'Account number used for market settlement payments.' ;
    rdfs:domain ind:AggregationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Total Capacity Mw' ;
    rdfs:comment 'Sum of the nominal capacity of all DER assets in the aggregation, expressed in megawatts.' ;
    rdfs:domain ind:AggregationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:aggregatorName rdf:type rdf:Property ;
    rdfs:label 'Aggregator Name' ;
    rdfs:comment 'Legal name of the DER aggregator entity.' ;
    rdfs:domain ind:Aggregator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aggregatorStatus rdf:type rdf:Property ;
    rdfs:label 'Aggregator Status' ;
    rdfs:comment 'Overall operational status of the aggregator.' ;
    rdfs:domain ind:Aggregator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aggregatorType rdf:type rdf:Property ;
    rdfs:label 'Aggregator Type' ;
    rdfs:comment 'Classification of aggregator based on ownership and structure.' ;
    rdfs:domain ind:Aggregator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fercRegistrationNumber rdf:type rdf:Property ;
    rdfs:label 'Ferc Registration Number' ;
    rdfs:comment 'Federal Energy Regulatory Commission registration identifier for the aggregator.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isActive rdf:type rdf:Property ;
    rdfs:label 'Is Active' ;
    rdfs:comment 'Flag indicating if the aggregator is currently active in the program.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCertified rdf:type rdf:Property ;
    rdfs:label 'Is Certified' ;
    rdfs:comment 'Indicates whether the aggregator holds required certifications for market participation.' ;
    rdfs:domain ind:Aggregator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:marketProducts rdf:type rdf:Property ;
    rdfs:label 'Market Products' ;
    rdfs:comment 'Market products the aggregator is authorized to provide.' ;
    rdfs:domain ind:Aggregator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pucAuthorizationNumber rdf:type rdf:Property ;
    rdfs:label 'Puc Authorization Number' ;
    rdfs:comment 'State Public Utility Commission authorization number granting the aggregator permission to operate.' ;
    rdfs:domain ind:Aggregator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalEnrolledCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Total Enrolled Capacity Mw' ;
    rdfs:comment 'Total DER capacity enrolled with the aggregator, measured in megawatts (MW).' ;
    rdfs:domain ind:Aggregator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:websiteUrl rdf:type rdf:Property ;
    rdfs:label 'Website Url' ;
    rdfs:comment 'Public website URL of the aggregator.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zipCode rdf:type rdf:Property ;
    rdfs:label 'Zip Code' ;
    rdfs:comment 'Postal ZIP code of the aggregator\'s primary address.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bessOperationId rdf:type rdf:Property ;
    rdfs:label 'Bess Operation Id' ;
    rdfs:comment 'Unique surrogate key for each BESS operation record.' ;
    rdfs:domain ind:BessOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:complianceObligationId rdf:type rdf:Property ;
    rdfs:label 'Compliance Obligation Id' ;
    rdfs:comment 'Foreign key linking to regulatory.compliance_obligation. Business justification: Battery Energy Storage System operations are subject to specific compliance obligations; FK enables audit trails.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ComplianceObligation .

ind:batteryTemperatureC rdf:type rdf:Property ;
    rdfs:label 'Battery Temperature C' ;
    rdfs:comment 'Measured temperature of the battery pack during the operation, in degrees Celsius.' ;
    rdfs:domain ind:BessOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cycleDepthPct rdf:type rdf:Property ;
    rdfs:label 'Cycle Depth Pct' ;
    rdfs:comment 'Depth of discharge for the cycle, calculated as (soc_start_pct - soc_end_pct) expressed as a percentage.' ;
    rdfs:domain ind:BessOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cycleDurationSeconds rdf:type rdf:Property ;
    rdfs:label 'Cycle Duration Seconds' ;
    rdfs:comment 'Total elapsed time of the operation cycle in seconds.' ;
    rdfs:domain ind:BessOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:degradationEstimatePct rdf:type rdf:Property ;
    rdfs:label 'Degradation Estimate Pct' ;
    rdfs:comment 'Projected remaining capacity loss percentage based on cumulative cycling.' ;
    rdfs:domain ind:BessOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dispatchEventReference rdf:type rdf:Property ;
    rdfs:label 'Dispatch Event Reference' ;
    rdfs:comment 'External identifier linking this BESS operation to the dispatch event that triggered it.' ;
    rdfs:domain ind:BessOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:energyThroughputKwh rdf:type rdf:Property ;
    rdfs:label 'Energy Throughput Kwh' ;
    rdfs:comment 'Actual energy transferred during the operation cycle, measured in kilowatt-hours.' ;
    rdfs:domain ind:BessOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:healthStatus rdf:type rdf:Property ;
    rdfs:label 'Health Status' ;
    rdfs:comment 'Current health condition of the BESS as assessed by the asset health system.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maintenanceDueDate rdf:type rdf:Property ;
    rdfs:label 'Maintenance Due Date' ;
    rdfs:comment 'Planned date for the next scheduled maintenance of the BESS.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:operationMode rdf:type rdf:Property ;
    rdfs:label 'Operation Mode' ;
    rdfs:comment 'Mode of the BESS during the event: charging, discharging, idle, or providing frequency regulation.' ;
    rdfs:domain ind:BessOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:powerSetpointKw rdf:type rdf:Property ;
    rdfs:label 'Power Setpoint Kw' ;
    rdfs:comment 'Target power level commanded for the BESS during the event, expressed in kilowatts.' ;
    rdfs:domain ind:BessOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:roundTripEfficiencyPct rdf:type rdf:Property ;
    rdfs:label 'Round Trip Efficiency Pct' ;
    rdfs:comment 'Efficiency of the charge-discharge cycle, expressed as a percentage of energy out divided by energy in.' ;
    rdfs:domain ind:BessOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:socEndPct rdf:type rdf:Property ;
    rdfs:label 'Soc End Pct' ;
    rdfs:comment 'Battery state of charge at the end of the operation, expressed as a percentage.' ;
    rdfs:domain ind:BessOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:socStartPct rdf:type rdf:Property ;
    rdfs:label 'Soc Start Pct' ;
    rdfs:comment 'Battery state of charge at the beginning of the operation, expressed as a percentage.' ;
    rdfs:domain ind:BessOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:communitySolarSubscriptionId rdf:type rdf:Property ;
    rdfs:label 'Community Solar Subscription Id' ;
    rdfs:comment 'Unique system-generated identifier for the community solar subscription record.' ;
    rdfs:domain ind:CommunitySolarSubscription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:derProgramId rdf:type rdf:Property ;
    rdfs:label 'Der Program Id' ;
    rdfs:comment 'Foreign key linking to der.program. Business justification: Community solar subscriptions are enrollments in a specific program; linking provides program details and avoids duplicated attributes.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DerProgram .

ind:renewableResourceId rdf:type rdf:Property ;
    rdfs:label 'Renewable Resource Id' ;
    rdfs:comment 'Identifier of the remote solar facility to which the subscription is linked.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RenewableResource .

ind:allocatedEnergyPct rdf:type rdf:Property ;
    rdfs:label 'Allocated Energy Pct' ;
    rdfs:comment 'Percentage of the project\'s generated energy that is allocated to this subscription.' ;
    rdfs:domain ind:CommunitySolarSubscription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:billCreditRate rdf:type rdf:Property ;
    rdfs:label 'Bill Credit Rate' ;
    rdfs:comment 'Monetary credit applied to the customer\'s bill for each kilowatt-hour of allocated energy.' ;
    rdfs:domain ind:CommunitySolarSubscription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cancellationDate rdf:type rdf:Property ;
    rdfs:label 'Cancellation Date' ;
    rdfs:comment 'Date the subscription was cancelled, if applicable.' ;
    rdfs:domain ind:CommunitySolarSubscription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:capacityKw rdf:type rdf:Property ;
    rdfs:label 'Capacity Kw' ;
    rdfs:comment 'Maximum kilowatt capacity allocated to the customer under this subscription.' ;
    rdfs:domain ind:Der ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:communitySolarSubscriptionStatus rdf:type rdf:Property ;
    rdfs:label 'Community Solar Subscription Status' ;
    rdfs:comment 'Current lifecycle status of the subscription.' ;
    rdfs:domain ind:CommunitySolarSubscription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityCriteria rdf:type rdf:Property ;
    rdfs:label 'Eligibility Criteria' ;
    rdfs:comment 'Text describing the eligibility rules that the customer satisfied to join the program.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incentiveAmount rdf:type rdf:Property ;
    rdfs:label 'Incentive Amount' ;
    rdfs:comment 'Monetary incentive applied to the subscription (e.g., rebate or tax credit).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:incentiveType rdf:type rdf:Property ;
    rdfs:label 'Incentive Type' ;
    rdfs:comment 'Category of incentive associated with the subscription.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subscriptionEndDate rdf:type rdf:Property ;
    rdfs:label 'Subscription End Date' ;
    rdfs:comment 'Date when the subscription terminates or expires; null for open-ended agreements.' ;
    rdfs:domain ind:CommunitySolarSubscription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:subscriptionNumber rdf:type rdf:Property ;
    rdfs:label 'Subscription Number' ;
    rdfs:comment 'External business identifier assigned to the subscription, used in customer communications and billing.' ;
    rdfs:domain ind:CommunitySolarSubscription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subscriptionStartDate rdf:type rdf:Property ;
    rdfs:label 'Subscription Start Date' ;
    rdfs:comment 'Date when the subscription becomes effective.' ;
    rdfs:domain ind:CommunitySolarSubscription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:subscriptionType rdf:type rdf:Property ;
    rdfs:label 'Subscription Type' ;
    rdfs:comment 'Classification of the subscription based on the solar asset configuration.' ;
    rdfs:domain ind:CommunitySolarSubscription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:termMonths rdf:type rdf:Property ;
    rdfs:label 'Term Months' ;
    rdfs:comment 'Length of the subscription agreement expressed in months.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:transferAllowed rdf:type rdf:Property ;
    rdfs:label 'Transfer Allowed' ;
    rdfs:comment 'Indicates whether the subscription may be transferred to another eligible customer.' ;
    rdfs:domain ind:CommunitySolarSubscription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transferDate rdf:type rdf:Property ;
    rdfs:label 'Transfer Date' ;
    rdfs:comment 'Date the subscription was transferred to a new customer, if applicable.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:environmentalPermitId rdf:type rdf:Property ;
    rdfs:label 'Environmental Permit Id' ;
    rdfs:comment 'Foreign key linking to regulatory.environmental_permit. Business justification: Regulatory permits must be recorded for each DER installation; permits are required for compliance reporting and site approval.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EnvironmentalPermit .

ind:fixedAssetId rdf:type rdf:Property ;
    rdfs:label 'Fixed Asset Id' ;
    rdfs:comment 'Foreign key linking to finance.fixed_asset. Business justification: Asset accounting requires linking each DER resource to its fixed asset record for depreciation, regulatory reporting, and capital cost tracking.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FixedAsset .

ind:plantId rdf:type rdf:Property ;
    rdfs:label 'Plant Id' ;
    rdfs:comment 'Foreign key linking to generation.plant. Business justification: REC compliance requires associating each DER with its parent generation plant for regulator reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Plant .

ind:purchaseOrderId rdf:type rdf:Property ;
    rdfs:label 'Purchase Order Id' ;
    rdfs:comment 'Foreign key linking to supply.purchase_order. Business justification: CAPITAL ASSET TRACKING: Associates the DER asset with the PO that purchased it for cost allocation and audit.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PurchaseOrder .

ind:transmissionSubstationId rdf:type rdf:Property ;
    rdfs:label 'Transmission Substation Id' ;
    rdfs:comment 'Foreign key linking to transmission.transmission_substation. Business justification: DER asset registration records the substation point of interconnection for dispatch, outage coordination, and regulatory reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TransmissionSubstation .

ind:batteryStorageCapacityKwh rdf:type rdf:Property ;
    rdfs:label 'Battery Storage Capacity Kwh' ;
    rdfs:comment 'Energy storage capacity of battery-based DERs.' ;
    rdfs:domain ind:Resource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:communicationProtocol rdf:type rdf:Property ;
    rdfs:label 'Communication Protocol' ;
    rdfs:comment 'Standard protocol used for DER-to-DERMS communication.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceLastCheckedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Compliance Last Checked Timestamp' ;
    rdfs:comment 'Timestamp of the most recent compliance verification.' ;
    rdfs:domain ind:Resource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:configurationApprovalStatus rdf:type rdf:Property ;
    rdfs:label 'Configuration Approval Status' ;
    rdfs:comment 'Current approval state of the DER configuration in DERMS.' ;
    rdfs:domain ind:Resource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:derType rdf:type rdf:Property ;
    rdfs:label 'Der Type' ;
    rdfs:comment 'Technology category of the DER (e.g., rooftop solar, battery storage, EV charger).' ;
    rdfs:domain ind:Der ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dermsDeviceCode rdf:type rdf:Property ;
    rdfs:label 'Derms Device Code' ;
    rdfs:comment 'Identifier of the DER within the Distributed Energy Resource Management System.' ;
    rdfs:domain ind:Resource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evChargingPowerKw rdf:type rdf:Property ;
    rdfs:label 'Ev Charging Power Kw' ;
    rdfs:comment 'Maximum charging power of an EV charging station DER.' ;
    rdfs:domain ind:Resource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ieee1547Category rdf:type rdf:Property ;
    rdfs:label 'Ieee 1547 Category' ;
