ind:calculationMethodology rdf:type rdf:Property ;
    rdfs:label 'Calculation Methodology' ;
    rdfs:comment 'Explanation of how the rider rate is calculated (e.g., fuel cost index, fixed surcharge).' ;
    rdfs:domain ind:RegulatoryTariffRider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryTariffRiderDescription rdf:type rdf:Property ;
    rdfs:label 'Regulatory Tariff Rider Description' ;
    rdfs:comment 'Detailed narrative describing the rider, its intent, and any special conditions.' ;
    rdfs:domain ind:RegulatoryTariffRider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryTariffRiderStatus rdf:type rdf:Property ;
    rdfs:label 'Regulatory Tariff Rider Status' ;
    rdfs:comment 'Current lifecycle status of the rider.' ;
