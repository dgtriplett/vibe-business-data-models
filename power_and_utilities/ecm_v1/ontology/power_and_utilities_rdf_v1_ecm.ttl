ind:transformerRatingMva rdf:type rdf:Property ;
    rdfs:label 'Transformer Rating Mva' ;
    rdfs:comment 'MVA rating of the primary transformer feeding the feeder.' ;
    rdfs:domain ind:Feeder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:voltageKv rdf:type rdf:Property ;
    rdfs:label 'Voltage Kv' ;
    rdfs:comment 'Design voltage level of the feeder in kilovolts.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gasLeakId rdf:type rdf:Property ;
    rdfs:label 'Gas Leak Id' ;
    rdfs:comment 'System-generated unique identifier for each gas leak record.' ;
    rdfs:domain ind:GasLeak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:gasMainId rdf:type rdf:Property ;
    rdfs:label 'Gas Main Id' ;
    rdfs:comment 'Foreign key linking to distribution.gas_main. Business justification: gas_leak.gas_asset_id represents the gas asset where the leak was detected. The asset is a gas_main. Adding gas_main_id FK creates a proper relationship and removes the ambiguous gas_asset_id column.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GasMain .

ind:violationNoticeId rdf:type rdf:Property ;
    rdfs:label 'Violation Notice Id' ;
    rdfs:comment 'Foreign key linking to regulatory.violation_notice. Business justification: Gas leaks can trigger violation notices; linking records the notice associated with each leak incident.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ViolationNotice .

ind:actualRepairCostUsd rdf:type rdf:Property ;
    rdfs:label 'Actual Repair Cost Usd' ;
    rdfs:comment 'Final amount paid for the repair work.' ;
    rdfs:domain ind:GasLeak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:closureStatus rdf:type rdf:Property ;
    rdfs:label 'Closure Status' ;
    rdfs:comment 'Overall lifecycle state of the leak record.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discoveryDate rdf:type rdf:Property ;
    rdfs:label 'Discovery Date' ;
    rdfs:comment 'Calendar date when the leak was initially identified.' ;
