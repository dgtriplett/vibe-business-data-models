    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:availabilityFactorPct rdf:type rdf:Property ;
    rdfs:label 'Availability Factor Pct' ;
    rdfs:comment 'Percentage of time the DER was available to generate power during the period.' ;
    rdfs:domain ind:PerformanceSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:businessEventTimestamp rdf:type rdf:Property ;
    rdfs:label 'Business Event Timestamp' ;
    rdfs:comment 'Timestamp representing the end of the reporting period; used for downstream time-based analytics.' ;
