    rdfs:range xsd:integer .

ind:conductorTemperatureLimitC rdf:type rdf:Property ;
    rdfs:label 'Conductor Temperature Limit C' ;
    rdfs:comment 'Maximum allowable conductor temperature for the rating, expressed in degrees Celsius.' ;
