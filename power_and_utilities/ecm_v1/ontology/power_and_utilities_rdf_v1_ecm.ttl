ind:gasPressureZone rdf:type rdf:Property ;
    rdfs:label 'Gas Pressure Zone' ;
    rdfs:comment 'Pressure zone designation for natural-gas service points.' ;
    rdfs:domain ind:MeteringServicePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastMeterReadTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Meter Read Timestamp' ;
    rdfs:comment 'Date-time of the most recent validated meter reading.' ;
    rdfs:domain ind:MeteringServicePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lastMeterReadValue rdf:type rdf:Property ;
    rdfs:label 'Last Meter Read Value' ;
    rdfs:comment 'Most recent meter reading value in kilowatt-hours.' ;
    rdfs:domain ind:MeteringServicePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:meterCount rdf:type rdf:Property ;
    rdfs:label 'Meter Count' ;
    rdfs:comment 'Number of meters historically installed at this service point.' ;
    rdfs:domain ind:MeteringServicePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:meteringProfileType rdf:type rdf:Property ;
    rdfs:label 'Metering Profile Type' ;
    rdfs:comment 'Rate structure applied to the service point.' ;
    rdfs:domain ind:MeteringServicePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meteringServicePointStatus rdf:type rdf:Property ;
    rdfs:label 'Metering Service Point Status' ;
    rdfs:comment 'Current operational status of the service point.' ;
    rdfs:domain ind:MeteringServicePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:servicePointCode rdf:type rdf:Property ;
    rdfs:label 'Service Point Code' ;
    rdfs:comment 'External code used by operations and billing systems to reference the service point.' ;
    rdfs:domain ind:MeteringServicePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceVoltageKv rdf:type rdf:Property ;
    rdfs:label 'Service Voltage Kv' ;
    rdfs:comment 'Nominal service voltage level in kilovolts.' ;
    rdfs:domain ind:MeteringServicePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:associatedEventMeterEventId rdf:type rdf:Property ;
    rdfs:label 'Associated Event Meter Event Id' ;
    rdfs:comment 'Identifier of a related event (e.g., meter tamper, outage) linked to this register.' ;
    rdfs:domain ind:Register ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MeterEvent .

ind:calibrationDate rdf:type rdf:Property ;
    rdfs:label 'Calibration Date' ;
    rdfs:comment 'Date the register (or its associated sensor) was last calibrated.' ;
    rdfs:domain ind:Register ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:calibrationFactor rdf:type rdf:Property ;
    rdfs:label 'Calibration Factor' ;
    rdfs:comment 'Factor applied during calibration to adjust raw readings.' ;
    rdfs:domain ind:Register ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:digitCount rdf:type rdf:Property ;
    rdfs:label 'Digit Count' ;
    rdfs:comment 'Number of digits the register can display or store.' ;
    rdfs:domain ind:Register ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:emissionFactor rdf:type rdf:Property ;
    rdfs:label 'Emission Factor' ;
    rdfs:comment 'Factor used to calculate emissions from the register\'s consumption (e.g., kg CO₂ per MCF).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isBidirectional rdf:type rdf:Property ;
    rdfs:label 'Is Bidirectional' ;
    rdfs:comment 'Indicates if the register records both delivered and received energy.' ;
