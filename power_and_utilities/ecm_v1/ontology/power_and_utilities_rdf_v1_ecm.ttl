    rdfs:comment 'Internal notes or remarks about the spend record.' ;
    rdfs:domain ind:TechSpend ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recurringFrequency rdf:type rdf:Property ;
    rdfs:label 'Recurring Frequency' ;
    rdfs:comment 'Interval at which recurring spend occurs.' ;
    rdfs:domain ind:TechSpend ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relatedApplication rdf:type rdf:Property ;
    rdfs:label 'Related Application' ;
    rdfs:comment 'Name of the application or system that benefits from the spend.' ;
    rdfs:domain ind:TechSpend ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relatedTechnologyProject rdf:type rdf:Property ;
    rdfs:label 'Related Technology Project' ;
    rdfs:comment 'Business identifier of the technology project linked to this spend.' ;
    rdfs:domain ind:TechSpend ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:spendCategory rdf:type rdf:Property ;
    rdfs:label 'Spend Category' ;
    rdfs:comment 'High-level classification of the spend (e.g., hardware, software, cloud).' ;
    rdfs:domain ind:TechSpend ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:spendDate rdf:type rdf:Property ;
    rdfs:label 'Spend Date' ;
    rdfs:comment 'Date the spend was incurred or recognized.' ;
    rdfs:domain ind:TechSpend ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:spendNumber rdf:type rdf:Property ;
    rdfs:label 'Spend Number' ;
    rdfs:comment 'External reference number assigned to the spend transaction for tracking.' ;
    rdfs:domain ind:TechSpend ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:spendPeriodEnd rdf:type rdf:Property ;
    rdfs:label 'Spend Period End' ;
    rdfs:comment 'End date of the accounting period the spend belongs to.' ;
    rdfs:domain ind:TechSpend ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:spendPeriodStart rdf:type rdf:Property ;
    rdfs:label 'Spend Period Start' ;
    rdfs:comment 'Start date of the accounting period the spend belongs to.' ;
    rdfs:domain ind:TechSpend ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:spendSubcategory rdf:type rdf:Property ;
    rdfs:label 'Spend Subcategory' ;
    rdfs:comment 'More detailed classification within the spend category.' ;
    rdfs:domain ind:TechSpend ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:techSpendDescription rdf:type rdf:Property ;
    rdfs:label 'Tech Spend Description' ;
    rdfs:comment 'Free-form text describing the purpose or nature of the spend.' ;
    rdfs:domain ind:TechSpend ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:annualSpendEstimate rdf:type rdf:Property ;
    rdfs:label 'Annual Spend Estimate' ;
    rdfs:comment 'Projected annual spend with the vendor, expressed in the selected currency.' ;
    rdfs:domain ind:TechVendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approvedVendorListFlag rdf:type rdf:Property ;
    rdfs:label 'Approved Vendor List Flag' ;
    rdfs:comment 'Indicates whether the vendor is on the utility\'s approved vendor list.' ;
    rdfs:domain ind:TechVendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contractStatus rdf:type rdf:Property ;
    rdfs:label 'Contract Status' ;
    rdfs:comment 'Current status of the vendor\'s contract with the utility.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataPrivacyCertification rdf:type rdf:Property ;
    rdfs:label 'Data Privacy Certification' ;
    rdfs:comment 'Security or privacy certification held by the vendor.' ;
    rdfs:domain ind:TechVendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataPrivacyCertificationDate rdf:type rdf:Property ;
    rdfs:label 'Data Privacy Certification Date' ;
    rdfs:comment 'Date when the current data privacy certification was obtained.' ;
    rdfs:domain ind:TechVendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:insuranceCoverageStatus rdf:type rdf:Property ;
    rdfs:label 'Insurance Coverage Status' ;
    rdfs:comment 'Status of the vendor\'s required insurance coverage.' ;
    rdfs:domain ind:TechVendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastRatingDate rdf:type rdf:Property ;
    rdfs:label 'Last Rating Date' ;
    rdfs:comment 'Date when the most recent vendor rating was recorded.' ;
    rdfs:domain ind:TechVendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastSecurityIncidentDate rdf:type rdf:Property ;
    rdfs:label 'Last Security Incident Date' ;
    rdfs:comment 'Date of the most recent security incident involving the vendor.' ;
    rdfs:domain ind:TechVendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastSecurityIncidentDescription rdf:type rdf:Property ;
    rdfs:label 'Last Security Incident Description' ;
    rdfs:comment 'Brief description of the most recent security incident involving the vendor.' ;
    rdfs:domain ind:TechVendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nercCipScrmClassification rdf:type rdf:Property ;
    rdfs:label 'Nerc Cip Scrm Classification' ;
    rdfs:comment 'Supply Chain Risk Management classification per NERC CIP guidelines.' ;
    rdfs:domain ind:TechVendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratingScore rdf:type rdf:Property ;
    rdfs:label 'Rating Score' ;
    rdfs:comment 'Overall performance rating (0.00-5.00) assigned by the utility.' ;
    rdfs:domain ind:TechVendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:registrationNumber rdf:type rdf:Property ;
    rdfs:label 'Registration Number' ;
    rdfs:comment 'State or regulatory registration number for the vendor.' ;
    rdfs:domain ind:TechVendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:securityAssessmentStatus rdf:type rdf:Property ;
    rdfs:label 'Security Assessment Status' ;
    rdfs:comment 'Progress status of the vendor\'s NERC CIP security assessment.' ;
    rdfs:domain ind:TechVendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceArea rdf:type rdf:Property ;
    rdfs:label 'Service Area' ;
    rdfs:comment 'Geographic region(s) where the vendor provides services to the utility.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxIdentificationNumber rdf:type rdf:Property ;
    rdfs:label 'Tax Identification Number' ;
    rdfs:comment 'Government-issued tax identifier for the vendor (e.g., EIN).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:techVendorName rdf:type rdf:Property ;
    rdfs:label 'Tech Vendor Name' ;
    rdfs:comment 'Full legal name of the vendor organization.' ;
    rdfs:domain ind:TechVendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorContactPhone rdf:type rdf:Property ;
    rdfs:label 'Vendor Contact Phone' ;
    rdfs:comment 'Phone number of the secondary vendor contact.' ;
    rdfs:domain ind:TechVendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorContactRole rdf:type rdf:Property ;
    rdfs:label 'Vendor Contact Role' ;
    rdfs:comment 'Role of the secondary vendor contact (e.g., account manager, technical lead).' ;
    rdfs:domain ind:TechVendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorRatingSource rdf:type rdf:Property ;
    rdfs:label 'Vendor Rating Source' ;
    rdfs:comment 'Indicates whether the vendor rating originates from internal assessment or an external audit.' ;
    rdfs:domain ind:TechVendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorType rdf:type rdf:Property ;
    rdfs:label 'Vendor Type' ;
    rdfs:comment 'Classification of the vendor based on the primary products or services provided to the utility.' ;
    rdfs:domain ind:TechVendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:telecomCircuitId rdf:type rdf:Property ;
    rdfs:label 'Telecom Circuit Id' ;
    rdfs:comment 'Unique system-generated identifier for the telecom circuit record.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TelecomCircuit .

ind:backupCircuitId rdf:type rdf:Property ;
    rdfs:label 'Backup Circuit Id' ;
    rdfs:comment 'Reference to a secondary circuit that can serve as a fail-over.' ;
    rdfs:domain ind:TelecomCircuit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TelecomCircuit .

ind:startSiteId rdf:type rdf:Property ;
    rdfs:label 'Start Site Id' ;
    rdfs:comment 'Foreign key linking to property.site. Business justification: Network Operations tracks circuit origin site for outage impact analysis; linking start_site_id to site.site_id enables accurate reporting.' ;
    rdfs:domain ind:TelecomCircuit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Site .

ind:bandwidthMbps rdf:type rdf:Property ;
    rdfs:label 'Bandwidth Mbps' ;
    rdfs:comment 'Provisioned bandwidth capacity of the circuit in megabits per second.' ;
    rdfs:domain ind:TelecomCircuit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:carrier rdf:type rdf:Property ;
    rdfs:label 'Carrier' ;
    rdfs:comment 'Service provider that owns or operates the circuit.' ;
    rdfs:domain ind:TelecomCircuit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:circuitCode rdf:type rdf:Property ;
    rdfs:label 'Circuit Code' ;
    rdfs:comment 'External business identifier assigned by the carrier or internal system.' ;
    rdfs:domain ind:TelecomCircuit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:circuitTag rdf:type rdf:Property ;
    rdfs:label 'Circuit Tag' ;
    rdfs:comment 'User-defined tag for categorization or search.' ;
    rdfs:domain ind:TelecomCircuit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:circuitType rdf:type rdf:Property ;
    rdfs:label 'Circuit Type' ;
    rdfs:comment 'Physical or logical technology used for the circuit.' ;
    rdfs:domain ind:TelecomCircuit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endLocationCode rdf:type rdf:Property ;
    rdfs:label 'End Location Code' ;
    rdfs:comment 'Internal code identifying the end location.' ;
    rdfs:domain ind:TelecomCircuit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endSite rdf:type rdf:Property ;
    rdfs:label 'End Site' ;
    rdfs:comment 'Name of the terminating facility or location for the circuit.' ;
    rdfs:domain ind:TelecomCircuit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failureCount rdf:type rdf:Property ;
    rdfs:label 'Failure Count' ;
    rdfs:comment 'Cumulative number of recorded failures since activation.' ;
    rdfs:domain ind:TelecomCircuit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isPrimary rdf:type rdf:Property ;
    rdfs:label 'Is Primary' ;
    rdfs:comment 'Indicates if this circuit is the primary link for its site.' ;
    rdfs:domain ind:TelecomCircuit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastFailureTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Failure Timestamp' ;
    rdfs:comment 'Timestamp of the most recent failure event on the circuit.' ;
    rdfs:domain ind:TelecomCircuit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:monitoringEnabled rdf:type rdf:Property ;
    rdfs:label 'Monitoring Enabled' ;
    rdfs:comment 'Indicates if the circuit is actively monitored for performance and faults.' ;
    rdfs:domain ind:TelecomCircuit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:monthlyCost rdf:type rdf:Property ;
    rdfs:label 'Monthly Cost' ;
    rdfs:comment 'Recurring monthly charge for the circuit.' ;
    rdfs:domain ind:TelecomCircuit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:networkLayer rdf:type rdf:Property ;
    rdfs:label 'Network Layer' ;
    rdfs:comment 'OSI layer at which the circuit operates.' ;
    rdfs:domain ind:TelecomCircuit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:provisioningStatus rdf:type rdf:Property ;
    rdfs:label 'Provisioning Status' ;
    rdfs:comment 'Current provisioning state of the circuit.' ;
    rdfs:domain ind:TelecomCircuit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qosProfile rdf:type rdf:Property ;
    rdfs:label 'Qos Profile' ;
    rdfs:comment 'Quality-of-Service profile associated with the circuit.' ;
    rdfs:domain ind:TelecomCircuit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:redundancyFlag rdf:type rdf:Property ;
    rdfs:label 'Redundancy Flag' ;
    rdfs:comment 'Indicates whether the circuit provides redundant connectivity.' ;
    rdfs:domain ind:TelecomCircuit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:slaLatencyMs rdf:type rdf:Property ;
    rdfs:label 'Sla Latency Ms' ;
    rdfs:comment 'Maximum latency guaranteed by the service level agreement, in milliseconds.' ;
    rdfs:domain ind:TelecomCircuit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:startLocationCode rdf:type rdf:Property ;
    rdfs:label 'Start Location Code' ;
    rdfs:comment 'Internal code identifying the start location (e.g., substation or data center).' ;
    rdfs:domain ind:TelecomCircuit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:technology rdf:type rdf:Property ;
    rdfs:label 'Technology' ;
    rdfs:comment 'Specific technology standard used for the circuit.' ;
    rdfs:domain ind:TelecomCircuit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:telecomCircuitDescription rdf:type rdf:Property ;
    rdfs:label 'Telecom Circuit Description' ;
    rdfs:comment 'Free-form description providing additional context about the circuit.' ;
    rdfs:domain ind:TelecomCircuit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:telecomCircuitName rdf:type rdf:Property ;
    rdfs:label 'Telecom Circuit Name' ;
    rdfs:comment 'Human-readable name or label for the circuit.' ;
    rdfs:domain ind:TelecomCircuit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:telecomCircuitStatus rdf:type rdf:Property ;
    rdfs:label 'Telecom Circuit Status' ;
    rdfs:comment 'Current lifecycle status of the circuit.' ;
    rdfs:domain ind:TelecomCircuit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ancillaryAwardId rdf:type rdf:Property ;
    rdfs:label 'Ancillary Award Id' ;
    rdfs:comment 'Unique identifier for the ancillary services award record. Primary key for the ancillary award entity.' ;
    rdfs:domain ind:AncillaryAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:marketId rdf:type rdf:Property ;
    rdfs:label 'Market Id' ;
    rdfs:comment 'Reference to the ISO/RTO market in which the ancillary service was awarded.' ;
    rdfs:domain ind:Trading ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Market .

ind:pricingNodeId rdf:type rdf:Property ;
    rdfs:label 'Pricing Node Id' ;
    rdfs:comment 'Reference to the locational marginal pricing (LMP) node or zone where the resource is located and the ancillary service price applies.' ;
    rdfs:domain ind:Trading ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PricingNode .

ind:actualDeliveryMw rdf:type rdf:Property ;
    rdfs:label 'Actual Delivery Mw' ;
    rdfs:comment 'Actual capacity in megawatts delivered by the resource when called upon to provide the ancillary service. May differ from awarded capacity.' ;
    rdfs:domain ind:AncillaryAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:awardAmountUsd rdf:type rdf:Property ;
    rdfs:label 'Award Amount Usd' ;
    rdfs:comment 'Total dollar amount of the ancillary services award, calculated as awarded capacity multiplied by clearing price.' ;
    rdfs:domain ind:AncillaryAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:awardNumber rdf:type rdf:Property ;
    rdfs:label 'Award Number' ;
    rdfs:comment 'External business identifier for the ancillary services award assigned by the ISO/RTO market system.' ;
    rdfs:domain ind:AncillaryAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:awardTimestamp rdf:type rdf:Property ;
    rdfs:label 'Award Timestamp' ;
    rdfs:comment 'Timestamp when the ISO/RTO issued the ancillary services award to the resource.' ;
    rdfs:domain ind:AncillaryAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:awardedCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Awarded Capacity Mw' ;
    rdfs:comment 'The capacity in megawatts (MW) that was awarded to the resource for providing the ancillary service during the specified interval.' ;
    rdfs:domain ind:AncillaryAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:clearingPricePerMw rdf:type rdf:Property ;
    rdfs:label 'Clearing Price Per Mw' ;
    rdfs:comment 'The market clearing price in dollars per megawatt ($/MW) for the ancillary service capacity awarded.' ;
    rdfs:domain ind:AncillaryAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:confirmationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Confirmation Timestamp' ;
    rdfs:comment 'Timestamp when the resource owner or scheduling coordinator confirmed acceptance of the ancillary services award.' ;
    rdfs:domain ind:AncillaryAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:deploymentDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Deployment Duration Minutes' ;
    rdfs:comment 'Total duration in minutes that the ancillary service was actively deployed during the interval.' ;
    rdfs:domain ind:AncillaryAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:deploymentFlag rdf:type rdf:Property ;
    rdfs:label 'Deployment Flag' ;
    rdfs:comment 'Indicates whether the ancillary service was actually deployed (called upon) during the interval. True if deployed, False if only capacity payment applies.' ;
    rdfs:domain ind:AncillaryAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:energyPaymentUsd rdf:type rdf:Property ;
    rdfs:label 'Energy Payment Usd' ;
    rdfs:comment 'Additional payment in dollars for energy delivered when the ancillary service was deployed, separate from the capacity award amount.' ;
    rdfs:domain ind:AncillaryAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:etrmDealNumber rdf:type rdf:Property ;
    rdfs:label 'Etrm Deal Number' ;
    rdfs:comment 'Deal or transaction number in the Allegro ETRM system associated with this ancillary services award.' ;
    rdfs:domain ind:AncillaryAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ingestionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Ingestion Timestamp' ;
    rdfs:comment 'Timestamp when the ancillary award record was ingested into the utility\'s data platform from the source system.' ;
    rdfs:domain ind:Trading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:obligationEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Obligation End Timestamp' ;
    rdfs:comment 'Timestamp when the resource\'s obligation to provide the ancillary service ends.' ;
    rdfs:domain ind:AncillaryAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:obligationStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Obligation Start Timestamp' ;
    rdfs:comment 'Timestamp when the resource\'s obligation to provide the ancillary service begins.' ;
    rdfs:domain ind:AncillaryAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:pricingZone rdf:type rdf:Property ;
    rdfs:label 'Pricing Zone' ;
    rdfs:comment 'Name of the pricing zone or load zone where the ancillary service award applies.' ;
    rdfs:domain ind:Trading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publicationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Publication Timestamp' ;
    rdfs:comment 'Timestamp when the ISO/RTO published the ancillary services award results to market participants.' ;
    rdfs:domain ind:Trading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:settlementRunNumber rdf:type rdf:Property ;
    rdfs:label 'Settlement Run Number' ;
    rdfs:comment 'Sequential number of the settlement run (initial, resettlement, final) in which this award was settled. ISO/RTOs may perform multiple settlement passes.' ;
    rdfs:domain ind:Trading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:approvedCreditLimitUsd rdf:type rdf:Property ;
    rdfs:label 'Approved Credit Limit Usd' ;
    rdfs:comment 'Maximum unsecured credit exposure approved for this counterparty in US dollars, representing the aggregate mark-to-market value of open positions before collateral posting is required.' ;
    rdfs:domain ind:Trading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:collateralHeldUsd rdf:type rdf:Property ;
    rdfs:label 'Collateral Held Usd' ;
    rdfs:comment 'Total value of collateral (cash, letters of credit, guarantees) currently held from this counterparty to secure trading obligations, denominated in US dollars.' ;
    rdfs:domain ind:Counterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:collateralPostedUsd rdf:type rdf:Property ;
    rdfs:label 'Collateral Posted Usd' ;
    rdfs:comment 'Total value of collateral posted by the utility to this counterparty to secure trading obligations, denominated in US dollars.' ;
    rdfs:domain ind:Trading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:counterpartyStatus rdf:type rdf:Property ;
    rdfs:label 'Counterparty Status' ;
    rdfs:comment 'Current lifecycle status of the counterparty relationship: active (approved for trading), suspended (temporarily restricted), inactive (no current trading), credit_watch (under credit review), terminated (relationship ended).' ;
    rdfs:domain ind:Counterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditContactEmail rdf:type rdf:Property ;
    rdfs:label 'Credit Contact Email' ;
    rdfs:comment 'Email address of the credit contact for credit-related communications, margin calls, and collateral requests.' ;
    rdfs:domain ind:Counterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditContactName rdf:type rdf:Property ;
    rdfs:label 'Credit Contact Name' ;
    rdfs:comment 'Full name of the credit department contact responsible for credit limit negotiations, collateral management, and exposure monitoring.' ;
    rdfs:domain ind:Counterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditWatchStatus rdf:type rdf:Property ;
    rdfs:label 'Credit Watch Status' ;
    rdfs:comment 'Current credit monitoring status indicating whether the counterparty is under special credit surveillance: none (normal monitoring), positive_watch (potential upgrade), negative_watch (potential downgrade), under_review (active credit assessment in progress).' ;
    rdfs:domain ind:Counterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:csaEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Csa Effective Date' ;
    rdfs:comment 'Date on which the Credit Support Annex (collateral agreement) with this counterparty became effective, governing margin and collateral posting requirements.' ;
    rdfs:domain ind:Counterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:csaMinimumTransferAmountUsd rdf:type rdf:Property ;
    rdfs:label 'Csa Minimum Transfer Amount Usd' ;
    rdfs:comment 'Minimum dollar amount for any single collateral transfer under the Credit Support Annex, used to avoid administrative burden of small transfers.' ;
    rdfs:domain ind:Counterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:csaThresholdAmountUsd rdf:type rdf:Property ;
    rdfs:label 'Csa Threshold Amount Usd' ;
    rdfs:comment 'Threshold amount in US dollars below which no collateral posting is required under the Credit Support Annex terms.' ;
    rdfs:domain ind:Counterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentCreditExposureUsd rdf:type rdf:Property ;
    rdfs:label 'Current Credit Exposure Usd' ;
    rdfs:comment 'Current mark-to-market credit exposure to this counterparty in US dollars, calculated as the net present value of all open trading positions.' ;
    rdfs:domain ind:Counterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fitchCreditRating rdf:type rdf:Property ;
    rdfs:label 'Fitch Credit Rating' ;
    rdfs:comment 'Current long-term issuer credit rating assigned by Fitch Ratings used for counterparty credit risk assessment.' ;
    rdfs:domain ind:Counterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:guaranteeAmountUsd rdf:type rdf:Property ;
    rdfs:label 'Guarantee Amount Usd' ;
    rdfs:comment 'Maximum amount in US dollars guaranteed by the parent or third-party guarantor for this counterparty\'s obligations.' ;
    rdfs:domain ind:Counterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:headquartersAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Headquarters Address Line1' ;
    rdfs:comment 'Primary street address line of the counterparty\'s corporate headquarters for legal notices and correspondence.' ;
    rdfs:domain ind:Counterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:headquartersAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Headquarters Address Line2' ;
    rdfs:comment 'Secondary address line (suite, floor, building) of the counterparty\'s corporate headquarters.' ;
    rdfs:domain ind:Counterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:headquartersCity rdf:type rdf:Property ;
    rdfs:label 'Headquarters City' ;
    rdfs:comment 'City where the counterparty\'s corporate headquarters is located.' ;
    rdfs:domain ind:Counterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:headquartersCountryCode rdf:type rdf:Property ;
    rdfs:label 'Headquarters Country Code' ;
    rdfs:comment 'Three-letter ISO country code for the counterparty\'s headquarters location, typically USA, CAN (Canada), or MEX (Mexico) for North American energy markets.' ;
    rdfs:domain ind:Counterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:headquartersPostalCode rdf:type rdf:Property ;
    rdfs:label 'Headquarters Postal Code' ;
    rdfs:comment 'Postal or ZIP code of the counterparty\'s corporate headquarters address.' ;
    rdfs:domain ind:Counterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:headquartersStateProvince rdf:type rdf:Property ;
    rdfs:label 'Headquarters State Province' ;
    rdfs:comment 'State or province code where the counterparty\'s corporate headquarters is located.' ;
    rdfs:domain ind:Counterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internalCreditRating rdf:type rdf:Property ;
    rdfs:label 'Internal Credit Rating' ;
    rdfs:comment 'Internally assigned credit rating based on the utility\'s proprietary credit scoring model and risk assessment framework.' ;
    rdfs:domain ind:Counterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastCreditReviewDate rdf:type rdf:Property ;
    rdfs:label 'Last Credit Review Date' ;
    rdfs:comment 'Date of the most recent comprehensive credit review and risk assessment performed for this counterparty.' ;
    rdfs:domain ind:Counterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:legalEntityName rdf:type rdf:Property ;
    rdfs:label 'Legal Entity Name' ;
    rdfs:comment 'Full legal name of the counterparty as registered with regulatory authorities and used in master trading agreements.' ;
    rdfs:domain ind:Counterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:masterAgreementEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Master Agreement Effective Date' ;
    rdfs:comment 'Date on which the master trading agreement with this counterparty became legally effective and binding.' ;
    rdfs:domain ind:Counterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:masterAgreementReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Master Agreement Reference Number' ;
    rdfs:comment 'Unique reference number or identifier assigned to the master trading agreement for contract management and trade confirmation purposes.' ;
    rdfs:domain ind:Counterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:masterAgreementType rdf:type rdf:Property ;
    rdfs:label 'Master Agreement Type' ;
    rdfs:comment 'Type of master trading agreement governing transactions with this counterparty: ISDA (International Swaps and Derivatives Association for financial derivatives), NAESB (North American Energy Standards Board for physical gas), EEI (Edison Electric Institute for physical power), WSPP (Western Systems Power Pool), or custom bilateral agreement.' ;
    rdfs:domain ind:Counterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:moodysCreditRating rdf:type rdf:Property ;
    rdfs:label 'Moodys Credit Rating' ;
    rdfs:comment 'Current long-term issuer credit rating assigned by Moody\'s Investors Service (e.g., Aaa, Baa2, etc.) used for counterparty credit risk assessment.' ;
    rdfs:domain ind:Counterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nercRegistrationCode rdf:type rdf:Property ;
    rdfs:label 'Nerc Registration Code' ;
    rdfs:comment 'NERC-assigned identifier for registered entities subject to Critical Infrastructure Protection (CIP) standards and reliability compliance.' ;
    rdfs:domain ind:Counterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nettingAgreementFlag rdf:type rdf:Property ;
    rdfs:label 'Netting Agreement Flag' ;
    rdfs:comment 'Boolean indicator of whether a payment netting agreement is in place allowing offsetting of amounts owed between parties (True = netting agreement exists, False = gross settlement required).' ;
    rdfs:domain ind:Trading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nextCreditReviewDate rdf:type rdf:Property ;
    rdfs:label 'Next Credit Review Date' ;
    rdfs:comment 'Scheduled date for the next periodic credit review and risk reassessment of this counterparty.' ;
    rdfs:domain ind:Counterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:onboardingDate rdf:type rdf:Property ;
    rdfs:label 'Onboarding Date' ;
    rdfs:comment 'Date when the counterparty was initially onboarded and approved for trading activity, marking the start of the business relationship.' ;
    rdfs:domain ind:Counterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:parentGuarantorName rdf:type rdf:Property ;
    rdfs:label 'Parent Guarantor Name' ;
    rdfs:comment 'Legal name of the parent company or third-party entity providing a guarantee for this counterparty\'s trading obligations, if applicable.' ;
    rdfs:domain ind:Counterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:spCreditRating rdf:type rdf:Property ;
    rdfs:label 'Sp Credit Rating' ;
    rdfs:comment 'Current long-term issuer credit rating assigned by Standard & Poor\'s (e.g., AAA, AA+, BBB-, etc.) used for counterparty credit risk assessment.' ;
    rdfs:domain ind:Counterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditExposureId rdf:type rdf:Property ;
    rdfs:label 'Credit Exposure Id' ;
    rdfs:comment 'Unique identifier for the credit exposure record. Primary key for time-series credit exposure tracking.' ;
    rdfs:domain ind:CreditExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:breachAmountUsd rdf:type rdf:Property ;
    rdfs:label 'Breach Amount Usd' ;
    rdfs:comment 'Amount by which the current exposure exceeds the approved credit limit in US Dollars. Null if no breach exists.' ;
    rdfs:domain ind:CreditExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:collateralReceivedUsd rdf:type rdf:Property ;
    rdfs:label 'Collateral Received Usd' ;
    rdfs:comment 'Total value of collateral received from the counterparty in US Dollars. Includes cash, letters of credit, and other eligible collateral forms.' ;
    rdfs:domain ind:CreditExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:collateralTypePosted rdf:type rdf:Property ;
    rdfs:label 'Collateral Type Posted' ;
    rdfs:comment 'Type of collateral posted by the utility to the counterparty (e.g., cash, letter of credit, parent guarantee).' ;
    rdfs:domain ind:CreditExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collateralTypeReceived rdf:type rdf:Property ;
    rdfs:label 'Collateral Type Received' ;
    rdfs:comment 'Type of collateral received from the counterparty (e.g., cash, letter of credit, parent guarantee).' ;
    rdfs:domain ind:CreditExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commodityConcentrationRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Commodity Concentration Risk Flag' ;
    rdfs:comment 'Indicates whether the exposure to this counterparty represents a concentration risk in a specific commodity (power, gas, RECs). True if concentration risk exists, False otherwise.' ;
    rdfs:domain ind:CreditExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:creditRatingAgency rdf:type rdf:Property ;
    rdfs:label 'Credit Rating Agency' ;
    rdfs:comment 'The rating agency providing the credit rating snapshot as of the exposure date.' ;
    rdfs:domain ind:CreditExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditRatingEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Credit Rating Effective Date' ;
    rdfs:comment 'Date when the credit rating became effective or was last updated by the rating agency.' ;
    rdfs:domain ind:CreditExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:creditStatusEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Credit Status Effective Date' ;
    rdfs:comment 'Date when the current credit status became effective.' ;
    rdfs:domain ind:CreditExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:creditStatusReason rdf:type rdf:Property ;
    rdfs:label 'Credit Status Reason' ;
    rdfs:comment 'Business reason or justification for the current credit status classification (e.g., rating downgrade, payment default, limit breach).' ;
    rdfs:domain ind:CreditExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditUtilizationPercent rdf:type rdf:Property ;
    rdfs:label 'Credit Utilization Percent' ;
    rdfs:comment 'Percentage of the approved credit limit currently utilized. Calculated as (net exposure / approved credit limit) * 100.' ;
    rdfs:domain ind:CreditExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:creditValuationAdjustmentUsd rdf:type rdf:Property ;
    rdfs:label 'Credit Valuation Adjustment Usd' ;
    rdfs:comment 'Credit valuation adjustment representing the market value of counterparty credit risk. Calculated as the difference between risk-free portfolio value and value adjusted for counterparty default risk.' ;
    rdfs:domain ind:CreditExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentExposureUsd rdf:type rdf:Property ;
    rdfs:label 'Current Exposure Usd' ;
    rdfs:comment 'Current mark-to-market exposure to the counterparty in US Dollars. Represents the replacement cost if the counterparty defaults today.' ;
    rdfs:domain ind:CreditExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:daysToMarginCall rdf:type rdf:Property ;
    rdfs:label 'Days To Margin Call' ;
    rdfs:comment 'Number of days until a margin call is required based on current exposure trajectory and contractual terms. Null if no margin call is anticipated.' ;
    rdfs:domain ind:CreditExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:etrmSystemExposureReference rdf:type rdf:Property ;
    rdfs:label 'Etrm System Exposure Reference' ;
    rdfs:comment 'Unique identifier for this credit exposure record in the source Allegro ETRM system. Used for data lineage and reconciliation.' ;
    rdfs:domain ind:CreditExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expectedCreditLossUsd rdf:type rdf:Property ;
    rdfs:label 'Expected Credit Loss Usd' ;
    rdfs:comment 'Expected credit loss calculated per IFRS 9 or CECL accounting standards. Represents the probability-weighted estimate of credit losses.' ;
    rdfs:domain ind:CreditExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exposureAtDefaultUsd rdf:type rdf:Property ;
    rdfs:label 'Exposure At Default Usd' ;
    rdfs:comment 'Estimated exposure amount at the time of counterparty default in US Dollars. Used in expected credit loss calculations.' ;
    rdfs:domain ind:CreditExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exposureBreachFlag rdf:type rdf:Property ;
    rdfs:label 'Exposure Breach Flag' ;
    rdfs:comment 'Indicates whether the current exposure exceeds the approved credit limit. True if in breach, False otherwise.' ;
    rdfs:domain ind:CreditExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exposureCalculationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Exposure Calculation Timestamp' ;
    rdfs:comment 'Timestamp when the credit exposure calculation was performed by the ETRM system.' ;
    rdfs:domain ind:CreditExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:exposureDate rdf:type rdf:Property ;
    rdfs:label 'Exposure Date' ;
    rdfs:comment 'Business date for which the credit exposure is calculated. Represents the snapshot date for this time-series record.' ;
    rdfs:domain ind:CreditExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:geographicConcentrationRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Geographic Concentration Risk Flag' ;
    rdfs:comment 'Indicates whether the exposure to this counterparty represents a concentration risk in a specific geographic region or RTO/ISO market. True if concentration risk exists, False otherwise.' ;
    rdfs:domain ind:CreditExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lossGivenDefaultPercent rdf:type rdf:Property ;
    rdfs:label 'Loss Given Default Percent' ;
    rdfs:comment 'Estimated percentage of exposure that will be lost if the counterparty defaults, after accounting for recovery.' ;
    rdfs:domain ind:CreditExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:marginCallStatus rdf:type rdf:Property ;
    rdfs:label 'Margin Call Status' ;
    rdfs:comment 'Current status of margin call activity for this counterparty as of the exposure date.' ;
    rdfs:domain ind:CreditExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marginCallThresholdUsd rdf:type rdf:Property ;
    rdfs:label 'Margin Call Threshold Usd' ;
    rdfs:comment 'Exposure threshold in US Dollars at which a margin call is triggered per the credit agreement or ISDA CSA.' ;
    rdfs:domain ind:CreditExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netExposureUsd rdf:type rdf:Property ;
    rdfs:label 'Net Exposure Usd' ;
    rdfs:comment 'Net credit exposure after accounting for collateral posted and received. Calculated as current exposure plus potential future exposure minus net collateral.' ;
    rdfs:domain ind:CreditExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nettingSetCode rdf:type rdf:Property ;
    rdfs:label 'Netting Set Code' ;
    rdfs:comment 'Identifier for the netting set under which trades with this counterparty are grouped for exposure calculation purposes.' ;
    rdfs:domain ind:CreditExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pfeCalculationMethod rdf:type rdf:Property ;
    rdfs:label 'Pfe Calculation Method' ;
    rdfs:comment 'Methodology used to calculate the potential future exposure (e.g., Monte Carlo simulation, parametric VaR, historical simulation).' ;
    rdfs:domain ind:CreditExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pfeConfidenceLevelPercent rdf:type rdf:Property ;
    rdfs:label 'Pfe Confidence Level Percent' ;
    rdfs:comment 'Confidence level used in the PFE calculation expressed as a percentage (e.g., 95.00, 99.00). Represents the statistical confidence interval for the exposure estimate.' ;
    rdfs:domain ind:CreditExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pfeTimeHorizonDays rdf:type rdf:Property ;
    rdfs:label 'Pfe Time Horizon Days' ;
    rdfs:comment 'Time horizon in days over which the potential future exposure is calculated (e.g., 10 days, 30 days, 365 days).' ;
    rdfs:domain ind:CreditExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:potentialFutureExposureUsd rdf:type rdf:Property ;
    rdfs:label 'Potential Future Exposure Usd' ;
    rdfs:comment 'Potential future exposure calculated using Monte Carlo or parametric methods. Represents the maximum expected exposure over the life of the contracts at a specified confidence level.' ;
    rdfs:domain ind:CreditExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:probabilityOfDefaultPercent rdf:type rdf:Property ;
    rdfs:label 'Probability Of Default Percent' ;
    rdfs:comment 'Estimated probability that the counterparty will default within a specified time horizon, expressed as a percentage.' ;
    rdfs:domain ind:CreditExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryCapitalChargeUsd rdf:type rdf:Property ;
    rdfs:label 'Regulatory Capital Charge Usd' ;
    rdfs:comment 'Regulatory capital charge required for this credit exposure per Basel III or applicable regulatory framework in US Dollars.' ;
    rdfs:domain ind:CreditExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riskWeightedAssetUsd rdf:type rdf:Property ;
    rdfs:label 'Risk Weighted Asset Usd' ;
    rdfs:comment 'Risk-weighted asset value for this credit exposure calculated per Basel III standardized or internal ratings-based approach in US Dollars.' ;
    rdfs:domain ind:CreditExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hedgeProgramId rdf:type rdf:Property ;
    rdfs:label 'Hedge Program Id' ;
    rdfs:comment 'Unique identifier for the hedge program. Primary key.' ;
    rdfs:domain ind:HedgeProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:approvedVolumeMax rdf:type rdf:Property ;
    rdfs:label 'Approved Volume Max' ;
    rdfs:comment 'Maximum volume approved for hedging under this program, expressed in the commodity\'s standard unit (MWh for electricity, MMBtu for natural gas, tons for coal). Defines the upper bound of the hedging range.' ;
    rdfs:domain ind:HedgeProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approvedVolumeMin rdf:type rdf:Property ;
    rdfs:label 'Approved Volume Min' ;
    rdfs:comment 'Minimum volume approved for hedging under this program, expressed in the commodity\'s standard unit (MWh for electricity, MMBtu for natural gas, tons for coal). Defines the lower bound of the hedging range.' ;
    rdfs:domain ind:HedgeProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:asc815HedgeDesignation rdf:type rdf:Property ;
    rdfs:label 'Asc 815 Hedge Designation' ;
    rdfs:comment 'Hedge accounting designation under ASC 815 (formerly FAS 133): cash flow hedge (hedging variability in future cash flows), fair value hedge (hedging changes in fair value of recognized asset/liability), net investment hedge (hedging foreign currency exposure), or not designated (mark-to-market through earnings).' ;
    rdfs:domain ind:HedgeProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:boardApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Board Approval Date' ;
    rdfs:comment 'Date on which the board of directors or risk committee formally approved this hedge program. Required for governance and regulatory compliance.' ;
    rdfs:domain ind:Trading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:boardApprovalResolutionNumber rdf:type rdf:Property ;
    rdfs:label 'Board Approval Resolution Number' ;
    rdfs:comment 'Official resolution or motion number from the board meeting that approved this hedge program. Used for audit trail and regulatory filings.' ;
    rdfs:domain ind:Trading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costRecoveryEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Cost Recovery Eligible Flag' ;
    rdfs:comment 'Indicates whether costs and gains/losses from this hedge program are eligible for recovery through regulated rates (True) or must be absorbed by shareholders (False). Critical for regulatory accounting and rate case filings.' ;
    rdfs:domain ind:HedgeProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:creditExposureLimitUsd rdf:type rdf:Property ;
    rdfs:label 'Credit Exposure Limit Usd' ;
    rdfs:comment 'Maximum credit exposure limit in USD for counterparty risk under this hedge program. Defines the aggregate mark-to-market exposure allowed across all counterparties.' ;
    rdfs:domain ind:Trading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:effectivenessTestFrequency rdf:type rdf:Property ;
    rdfs:label 'Effectiveness Test Frequency' ;
    rdfs:comment 'Frequency at which hedge effectiveness testing is performed: monthly, quarterly, annually, or at inception only. Defines the ongoing compliance monitoring schedule.' ;
    rdfs:domain ind:HedgeProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:etrmSystemBookReference rdf:type rdf:Property ;
    rdfs:label 'Etrm System Book Reference' ;
    rdfs:comment 'Unique identifier of the trading book in the Allegro ETRM system that corresponds to this hedge program. Used for system integration and position reconciliation.' ;
    rdfs:domain ind:Trading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hedgeEffectivenessTestMethod rdf:type rdf:Property ;
    rdfs:label 'Hedge Effectiveness Test Method' ;
    rdfs:comment 'Method used to assess hedge effectiveness for ASC 815 compliance: dollar offset method, regression analysis, variance reduction analysis, or critical terms match. Required for qualifying hedge accounting treatment.' ;
    rdfs:domain ind:Trading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hedgeHorizonMonths rdf:type rdf:Property ;
    rdfs:label 'Hedge Horizon Months' ;
    rdfs:comment 'Time horizon for the hedge program expressed in months (e.g., 12 for one-year forward, 24 for two-year forward). Defines how far into the future the utility will hedge its exposure.' ;
    rdfs:domain ind:HedgeProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:hedgeRatioTargetPercent rdf:type rdf:Property ;
    rdfs:label 'Hedge Ratio Target Percent' ;
    rdfs:comment 'Target hedge ratio expressed as a percentage of the underlying exposure to be hedged (e.g., 75.00 means hedge 75% of generation output or fuel requirements). Defines the strategic hedging level approved by the board.' ;
    rdfs:domain ind:HedgeProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hedgeType rdf:type rdf:Property ;
    rdfs:label 'Hedge Type' ;
    rdfs:comment 'Classification of the hedge strategy: generation output hedge (hedging power sales), fuel cost hedge (hedging fuel procurement costs), load hedge (hedging customer load obligations), basis hedge (hedging location basis risk), volumetric hedge (hedging quantity risk), or price hedge (hedging price risk).' ;
    rdfs:domain ind:HedgeProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inceptionDate rdf:type rdf:Property ;
    rdfs:label 'Inception Date' ;
    rdfs:comment 'Date on which the hedge program was first established and became operational. Marks the beginning of the program lifecycle.' ;
    rdfs:domain ind:Trading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:instrumentTypesAllowed rdf:type rdf:Property ;
    rdfs:label 'Instrument Types Allowed' ;
    rdfs:comment 'Comma-separated list of derivative instrument types permitted under this hedge program (e.g., \'swap,option,forward,futures,collar\'). Defines the trading strategies and products the desk may use.' ;
    rdfs:domain ind:HedgeProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastLimitReviewDate rdf:type rdf:Property ;
    rdfs:label 'Last Limit Review Date' ;
    rdfs:comment 'Date of the most recent formal review of hedge program limits and parameters by the risk committee or board. Used for governance tracking.' ;
    rdfs:domain ind:Trading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:limitBreachAction rdf:type rdf:Property ;
    rdfs:label 'Limit Breach Action' ;
    rdfs:comment 'Prescribed action to be taken when a risk limit is breached (e.g., \'Immediate position reduction\', \'Escalate to CRO\', \'Suspend new trades\'). Defines the operational response protocol.' ;
    rdfs:domain ind:Trading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextLimitReviewDate rdf:type rdf:Property ;
    rdfs:label 'Next Limit Review Date' ;
    rdfs:comment 'Scheduled date for the next formal review of hedge program limits and parameters. Used for governance planning and compliance monitoring.' ;
    rdfs:domain ind:Trading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:responsibleTraderName rdf:type rdf:Property ;
    rdfs:label 'Responsible Trader Name' ;
    rdfs:comment 'Name of the lead trader or portfolio manager responsible for executing this hedge program.' ;
    rdfs:domain ind:HedgeProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stopLossLimitUsd rdf:type rdf:Property ;
    rdfs:label 'Stop Loss Limit Usd' ;
    rdfs:comment 'Maximum cumulative loss threshold in USD that triggers mandatory position closure or escalation. Used for downside risk protection and loss containment.' ;
    rdfs:domain ind:Trading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tenorLimitMonths rdf:type rdf:Property ;
    rdfs:label 'Tenor Limit Months' ;
    rdfs:comment 'Maximum tenor (time to maturity) allowed for derivative contracts under this hedge program, expressed in months. Defines how far forward the utility may transact.' ;
    rdfs:domain ind:Trading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tradingDesk rdf:type rdf:Property ;
    rdfs:label 'Trading Desk' ;
    rdfs:comment 'Name of the trading desk or business unit responsible for this hedge program (e.g., \'Power Trading\', \'Gas Supply\', \'Fuel Procurement\').' ;
    rdfs:domain ind:Trading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:varConfidenceLevelPercent rdf:type rdf:Property ;
    rdfs:label 'Var Confidence Level Percent' ;
    rdfs:comment 'Confidence level for VaR calculation expressed as a percentage (e.g., 95.00 or 99.00). Defines the statistical confidence interval for the VaR limit.' ;
    rdfs:domain ind:Trading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:varLimitUsd rdf:type rdf:Property ;
    rdfs:label 'Var Limit Usd' ;
    rdfs:comment 'Maximum Value at Risk (VaR) limit for this hedge program expressed in USD. Defines the maximum potential loss at the specified confidence level and time horizon. Used for risk monitoring and limit compliance.' ;
    rdfs:domain ind:Trading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:varTimeHorizonDays rdf:type rdf:Property ;
    rdfs:label 'Var Time Horizon Days' ;
    rdfs:comment 'Time horizon for VaR calculation expressed in days (e.g., 1 for daily VaR, 10 for 10-day VaR). Defines the holding period assumption for the risk measure.' ;
    rdfs:domain ind:Trading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:volumeUnitOfMeasure rdf:type rdf:Property ;
    rdfs:label 'Volume Unit Of Measure' ;
    rdfs:comment 'Unit of measure for approved volumes: MWh (megawatt-hour for electricity), MMBtu (million British thermal units for gas), tons (for coal), GJ (gigajoules), or therms.' ;
    rdfs:domain ind:Trading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confidenceIntervalLower rdf:type rdf:Property ;
    rdfs:label 'Confidence Interval Lower' ;
    rdfs:comment 'For forward curves: lower bound of the confidence interval for the forward price, used for risk assessment.' ;
    rdfs:domain ind:LmpPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:confidenceIntervalUpper rdf:type rdf:Property ;
    rdfs:label 'Confidence Interval Upper' ;
    rdfs:comment 'For forward curves: upper bound of the confidence interval for the forward price, used for risk assessment.' ;
    rdfs:domain ind:LmpPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:congestionComponent rdf:type rdf:Property ;
    rdfs:label 'Congestion Component' ;
    rdfs:comment 'Congestion component of the LMP representing the cost of transmission constraints binding at this location.' ;
    rdfs:domain ind:Trading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:curveDate rdf:type rdf:Property ;
    rdfs:label 'Curve Date' ;
    rdfs:comment 'For forward prices: the date on which the forward curve was published or captured. Null for spot prices.' ;
    rdfs:domain ind:LmpPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:curveSource rdf:type rdf:Property ;
    rdfs:label 'Curve Source' ;
    rdfs:comment 'Source of the forward curve data: ICE (Intercontinental Exchange), CME (Chicago Mercantile Exchange), broker quote, internal model, ISO-published, or third-party vendor.' ;
    rdfs:domain ind:LmpPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryHub rdf:type rdf:Property ;
    rdfs:label 'Delivery Hub' ;
    rdfs:comment 'For forward curves: the standardized delivery hub or zone for the forward contract (e.g., PJM West Hub, MISO Indiana Hub).' ;
    rdfs:domain ind:LmpPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:energyComponent rdf:type rdf:Property ;
    rdfs:label 'Energy Component' ;
    rdfs:comment 'Energy component of the LMP representing the system marginal energy cost, excluding congestion and losses.' ;
    rdfs:domain ind:Trading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forwardPrice rdf:type rdf:Property ;
    rdfs:label 'Forward Price' ;
    rdfs:comment 'For forward curves: the forward price for the specified tenor and delivery hub in dollars per megawatt-hour.' ;
    rdfs:domain ind:LmpPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lmpTotal rdf:type rdf:Property ;
    rdfs:label 'Lmp Total' ;
    rdfs:comment 'Total Locational Marginal Price in dollars per megawatt-hour ($/MWh), representing the marginal cost of serving the next increment of load at this location.' ;
    rdfs:domain ind:LmpPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lossComponent rdf:type rdf:Property ;
    rdfs:label 'Loss Component' ;
    rdfs:comment 'Marginal loss component of the LMP representing the cost of electrical losses from the reference bus to this location.' ;
    rdfs:domain ind:Trading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:negativePriceIndicator rdf:type rdf:Property ;
    rdfs:label 'Negative Price Indicator' ;
    rdfs:comment 'Boolean flag indicating whether the LMP is negative (True), which can occur during periods of excess renewable generation or transmission constraints.' ;
    rdfs:domain ind:LmpPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nodeType rdf:type rdf:Property ;
    rdfs:label 'Node Type' ;
    rdfs:comment 'Classification of the pricing node indicating its role in the market topology.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priceQualityFlag rdf:type rdf:Property ;
    rdfs:label 'Price Quality Flag' ;
    rdfs:comment 'Data quality indicator for the price: valid (normal), estimated (interpolated), missing (no data), anomaly (outlier detected), or corrected (manually adjusted).' ;
    rdfs:domain ind:LmpPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priceSpikeIndicator rdf:type rdf:Property ;
    rdfs:label 'Price Spike Indicator' ;
    rdfs:comment 'Boolean flag indicating whether this price represents a price spike event (True) or normal market conditions (False), based on threshold rules.' ;
    rdfs:domain ind:LmpPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priceType rdf:type rdf:Property ;
    rdfs:label 'Price Type' ;
    rdfs:comment 'Classification of the price record: spot (actual market clearing), forward (future delivery curve), forecast (predicted), or settlement (final reconciled).' ;
    rdfs:domain ind:LmpPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tenor rdf:type rdf:Property ;
    rdfs:label 'Tenor' ;
    rdfs:comment 'For forward curves: the delivery period or tenor of the forward price (e.g., Month-1, Quarter-2, Cal-2025, Peak, Off-Peak).' ;
    rdfs:domain ind:LmpPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketBidId rdf:type rdf:Property ;
    rdfs:label 'Market Bid Id' ;
    rdfs:comment 'Unique identifier for the market bid record. Primary key for the market bid entity.' ;
    rdfs:domain ind:MarketBid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lmpNodeId rdf:type rdf:Property ;
    rdfs:label 'Lmp Node Id' ;
    rdfs:comment 'The pricing node or location identifier where the resource is electrically connected and where LMP is calculated. Used for settlement and congestion analysis.' ;
    rdfs:domain ind:MarketBid ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PricingNode .

ind:traderEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Trader Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Required for Market Bid Execution Report linking each bid to the responsible trader employee; traders are employees who submit bids.' ;
    rdfs:domain ind:Trading ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:acceptanceTimestamp rdf:type rdf:Property ;
    rdfs:label 'Acceptance Timestamp' ;
    rdfs:comment 'The date and time when the bid was accepted by the ISO/RTO market clearing engine. Null if the bid was rejected or is still pending.' ;
    rdfs:domain ind:MarketBid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:bidCurveSegmentNumber rdf:type rdf:Property ;
    rdfs:label 'Bid Curve Segment Number' ;
    rdfs:comment 'The segment number within a multi-part bid curve. Used when a resource submits multiple price-quantity pairs to represent a non-linear supply or demand curve.' ;
    rdfs:domain ind:MarketBid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bidPricePerMwh rdf:type rdf:Property ;
    rdfs:label 'Bid Price Per Mwh' ;
    rdfs:comment 'The price offered or requested for energy delivery, expressed in dollars per megawatt-hour. For supply bids, this is the minimum acceptable price; for demand bids, this is the maximum willingness to pay.' ;
    rdfs:domain ind:MarketBid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bidQuantityMw rdf:type rdf:Property ;
    rdfs:label 'Bid Quantity Mw' ;
    rdfs:comment 'The quantity of energy or capacity offered or requested in the bid, expressed in megawatts. Represents the resource capability or demand flexibility.' ;
    rdfs:domain ind:MarketBid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bidReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Bid Reference Number' ;
    rdfs:comment 'External business identifier for the bid as submitted to the ISO/RTO market system. Used for reconciliation and audit trails.' ;
    rdfs:domain ind:MarketBid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bidStatus rdf:type rdf:Property ;
    rdfs:label 'Bid Status' ;
    rdfs:comment 'Current lifecycle status of the bid in the market clearing process. Tracks whether the bid has been accepted, rejected, or partially cleared by the ISO/RTO.' ;
    rdfs:domain ind:MarketBid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bidType rdf:type rdf:Property ;
    rdfs:label 'Bid Type' ;
    rdfs:comment 'The product type for which the bid is submitted. Energy bids are for MWh delivery; ancillary service bids are for reserves and regulation. [ENUM-REF-CANDIDATE: energy|capacity|regulation_up|regulation_down|spinning_reserve|non_spinning_reserve|supplemental_reserve — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:MarketBid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:blockBidFlag rdf:type rdf:Property ;
    rdfs:label 'Block Bid Flag' ;
    rdfs:comment 'Indicates whether the bid is an all-or-nothing block bid that must be accepted in its entirety or not at all. Used for resources with inflexible operating constraints.' ;
    rdfs:domain ind:MarketBid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:clearedPricePerMwh rdf:type rdf:Property ;
    rdfs:label 'Cleared Price Per Mwh' ;
    rdfs:comment 'The market clearing price at which the bid was accepted, expressed in dollars per megawatt-hour. This is the Locational Marginal Price (LMP) at the resource node.' ;
    rdfs:domain ind:MarketBid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:clearedQuantityMw rdf:type rdf:Property ;
    rdfs:label 'Cleared Quantity Mw' ;
    rdfs:comment 'The actual quantity of energy or capacity that was accepted and cleared by the market. Null if the bid was not accepted or is still pending.' ;
    rdfs:domain ind:MarketBid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hedgeDesignation rdf:type rdf:Property ;
    rdfs:label 'Hedge Designation' ;
    rdfs:comment 'Indicates whether the bid is part of a hedging strategy (physical or financial) or is speculative. Used for risk management and accounting treatment under ASC 815.' ;
    rdfs:domain ind:Trading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maximumQuantityMw rdf:type rdf:Property ;
    rdfs:label 'Maximum Quantity Mw' ;
    rdfs:comment 'The maximum quantity that can be delivered or consumed, representing the upper bound of the resource capability or demand flexibility.' ;
    rdfs:domain ind:MarketBid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumDownTimeHours rdf:type rdf:Property ;
    rdfs:label 'Minimum Down Time Hours' ;
    rdfs:comment 'The minimum number of consecutive hours the resource must remain offline after shutdown. Reflects cooling and maintenance requirements.' ;
    rdfs:domain ind:MarketBid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minimumQuantityMw rdf:type rdf:Property ;
    rdfs:label 'Minimum Quantity Mw' ;
    rdfs:comment 'The minimum quantity that must be accepted for the bid to be economically viable. Used for resources with minimum run constraints or block bids.' ;
    rdfs:domain ind:MarketBid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumRunTimeHours rdf:type rdf:Property ;
    rdfs:label 'Minimum Run Time Hours' ;
    rdfs:comment 'The minimum number of consecutive hours the resource must operate once started. Reflects operational constraints of thermal generating units.' ;
    rdfs:domain ind:MarketBid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:noLoadCost rdf:type rdf:Property ;
    rdfs:label 'No Load Cost' ;
    rdfs:comment 'The fixed hourly cost of keeping the generating unit online at minimum output, expressed in dollars per hour. Used in unit commitment optimization.' ;
    rdfs:domain ind:MarketBid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priceTakerFlag rdf:type rdf:Property ;
    rdfs:label 'Price Taker Flag' ;
    rdfs:comment 'Indicates whether the bid is submitted as a price taker (willing to accept any market clearing price). Common for renewable resources with zero marginal cost.' ;
    rdfs:domain ind:MarketBid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rampRateMwPerMinute rdf:type rdf:Property ;
    rdfs:label 'Ramp Rate Mw Per Minute' ;
    rdfs:comment 'The maximum rate at which the resource can increase or decrease output, expressed in megawatts per minute. Critical for real-time dispatch and frequency regulation.' ;
    rdfs:domain ind:MarketBid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:selfScheduleFlag rdf:type rdf:Property ;
    rdfs:label 'Self Schedule Flag' ;
    rdfs:comment 'Indicates whether the bid is a self-schedule (must-run) rather than an economic bid. Self-schedules are committed regardless of economics, often for reliability or contractual obligations.' ;
    rdfs:domain ind:MarketBid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:startUpCost rdf:type rdf:Property ;
    rdfs:label 'Start Up Cost' ;
    rdfs:comment 'The cost incurred to start the generating unit from an offline state, expressed in dollars. Used in commitment decisions for thermal units.' ;
    rdfs:domain ind:MarketBid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tradingHour rdf:type rdf:Property ;
    rdfs:label 'Trading Hour' ;
    rdfs:comment 'The hour of the operating day for which the bid applies (1-24 in HE format, Hour Ending). Used for hourly market products.' ;
    rdfs:domain ind:MarketBid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tradingInterval rdf:type rdf:Property ;
    rdfs:label 'Trading Interval' ;
    rdfs:comment 'The sub-hourly interval within the trading hour (e.g., 5-minute or 15-minute intervals). Null for hourly products. Used in real-time markets with sub-hourly dispatch.' ;
    rdfs:domain ind:MarketBid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:mtmValuationId rdf:type rdf:Property ;
    rdfs:label 'Mtm Valuation Id' ;
    rdfs:comment 'Unique identifier for the mark-to-market valuation record.' ;
    rdfs:domain ind:MtmValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contractPricePerUnit rdf:type rdf:Property ;
    rdfs:label 'Contract Price Per Unit' ;
    rdfs:comment 'The original contract price per unit ($/MWh or $/MMBtu) at which the position was entered.' ;
    rdfs:domain ind:MtmValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dealNumber rdf:type rdf:Property ;
    rdfs:label 'Deal Number' ;
    rdfs:comment 'The unique deal or transaction number from the ETRM system (Allegro) for the underlying position.' ;
    rdfs:domain ind:MtmValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryPoint rdf:type rdf:Property ;
    rdfs:label 'Delivery Point' ;
    rdfs:comment 'The physical or financial delivery point or hub where the commodity is delivered (e.g., PJM West Hub, Henry Hub).' ;
    rdfs:domain ind:MtmValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:etrmBookReference rdf:type rdf:Property ;
    rdfs:label 'Etrm Book Reference' ;
    rdfs:comment 'The book identifier in the Allegro ETRM system where the position is recorded.' ;
    rdfs:domain ind:MtmValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fairValueHierarchyLevel rdf:type rdf:Property ;
    rdfs:label 'Fair Value Hierarchy Level' ;
    rdfs:comment 'The ASC 820 fair value hierarchy level (Level 1: quoted prices, Level 2: observable inputs, Level 3: unobservable inputs).' ;
    rdfs:domain ind:MtmValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forwardCurveSource rdf:type rdf:Property ;
    rdfs:label 'Forward Curve Source' ;
    rdfs:comment 'The source of the forward price curve used for valuation (e.g., ICE, NYMEX, Bloomberg, internal model).' ;
    rdfs:domain ind:MtmValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forwardPricePerUnit rdf:type rdf:Property ;
    rdfs:label 'Forward Price Per Unit' ;
    rdfs:comment 'The forward market price per unit ($/MWh or $/MMBtu) used for mark-to-market valuation as of the valuation date.' ;
    rdfs:domain ind:MtmValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lmpNode rdf:type rdf:Property ;
    rdfs:label 'Lmp Node' ;
    rdfs:comment 'The specific LMP node or pricing point used for valuation in nodal markets.' ;
    rdfs:domain ind:MtmValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mtmTotalValueUsd rdf:type rdf:Property ;
    rdfs:label 'Mtm Total Value Usd' ;
    rdfs:comment 'The total mark-to-market value in US dollars, calculated as open volume multiplied by MTM value per unit.' ;
    rdfs:domain ind:MtmValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mtmValuePerUnit rdf:type rdf:Property ;
    rdfs:label 'Mtm Value Per Unit' ;
    rdfs:comment 'The mark-to-market value per unit ($/MWh or $/MMBtu), calculated as the difference between forward price and contract price.' ;
    rdfs:domain ind:MtmValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:openVolumeMmbtu rdf:type rdf:Property ;
    rdfs:label 'Open Volume Mmbtu' ;
    rdfs:comment 'The open volume of the position in million British thermal units (MMBtu) for natural gas commodities.' ;
    rdfs:domain ind:MtmValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:openVolumeMwh rdf:type rdf:Property ;
    rdfs:label 'Open Volume Mwh' ;
    rdfs:comment 'The open volume of the position in megawatt-hours (MWh) for power commodities.' ;
    rdfs:domain ind:MtmValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:positionType rdf:type rdf:Property ;
    rdfs:label 'Position Type' ;
    rdfs:comment 'Indicates whether the position is long (buy) or short (sell).' ;
    rdfs:domain ind:MtmValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priceVolatilityPercent rdf:type rdf:Property ;
    rdfs:label 'Price Volatility Percent' ;
    rdfs:comment 'The implied or historical price volatility percentage used in the valuation model.' ;
    rdfs:domain ind:MtmValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tenorMonths rdf:type rdf:Property ;
    rdfs:label 'Tenor Months' ;
    rdfs:comment 'The tenor or duration of the position in months from the valuation date to the delivery period end.' ;
    rdfs:domain ind:MtmValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:unrealizedGainLossUsd rdf:type rdf:Property ;
    rdfs:label 'Unrealized Gain Loss Usd' ;
    rdfs:comment 'The unrealized gain or loss in US dollars for the open position, representing the change in MTM value since the prior valuation date.' ;
    rdfs:domain ind:MtmValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:valuationAdjustmentReason rdf:type rdf:Property ;
    rdfs:label 'Valuation Adjustment Reason' ;
    rdfs:comment 'The reason for any manual adjustment to the valuation, if applicable.' ;
    rdfs:domain ind:MtmValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valuationRunReference rdf:type rdf:Property ;
    rdfs:label 'Valuation Run Reference' ;
    rdfs:comment 'The identifier for the batch valuation run that produced this record, used for audit and reconciliation.' ;
    rdfs:domain ind:MtmValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valuationStatus rdf:type rdf:Property ;
    rdfs:label 'Valuation Status' ;
    rdfs:comment 'The status of the valuation record (preliminary, final, adjusted, cancelled).' ;
    rdfs:domain ind:MtmValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valuationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Valuation Timestamp' ;
    rdfs:comment 'The precise timestamp when the valuation was performed, including time zone.' ;
    rdfs:domain ind:MtmValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:varContributionUsd rdf:type rdf:Property ;
    rdfs:label 'Var Contribution Usd' ;
    rdfs:comment 'The contribution of this position to the portfolio\'s overall Value at Risk (VaR) in US dollars.' ;
    rdfs:domain ind:MtmValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:positionId rdf:type rdf:Property ;
    rdfs:label 'Position Id' ;
    rdfs:comment 'Unique identifier for the trading position snapshot record.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:averageLongPrice rdf:type rdf:Property ;
    rdfs:label 'Average Long Price' ;
    rdfs:comment 'The volume-weighted average price of all long positions in this snapshot, in USD per unit.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:averageNetPrice rdf:type rdf:Property ;
    rdfs:label 'Average Net Price' ;
    rdfs:comment 'The volume-weighted average price of the net open position, in USD per unit.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:averageShortPrice rdf:type rdf:Property ;
    rdfs:label 'Average Short Price' ;
    rdfs:comment 'The volume-weighted average price of all short positions in this snapshot, in USD per unit.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:changeValue rdf:type rdf:Property ;
    rdfs:label 'Change Value' ;
    rdfs:comment 'The change in mark-to-market value from the prior valuation date, in USD.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:changeVolume rdf:type rdf:Property ;
    rdfs:label 'Change Volume' ;
    rdfs:comment 'The change in net volume from the prior valuation date, measured in the same units as net_volume.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:counterpartyExposure rdf:type rdf:Property ;
    rdfs:label 'Counterparty Exposure' ;
    rdfs:comment 'The total credit exposure to counterparties for this position, representing the potential loss if all counterparties default, in USD.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deltaEquivalent rdf:type rdf:Property ;
    rdfs:label 'Delta Equivalent' ;
    rdfs:comment 'The delta-adjusted equivalent volume for options and structured products, representing the linear price risk exposure in the same units as net_volume.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hedgeEffectivenessPercent rdf:type rdf:Property ;
    rdfs:label 'Hedge Effectiveness Percent' ;
    rdfs:comment 'The percentage effectiveness of the hedge relationship, used to determine hedge accounting treatment eligibility (typically 80-125% range for highly effective hedges).' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:longVolume rdf:type rdf:Property ;
    rdfs:label 'Long Volume' ;
    rdfs:comment 'The total volume of long (buy) positions held, measured in MWh for power, MCF for gas, MW for capacity, or REC count for renewable certificates.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:markToMarketValue rdf:type rdf:Property ;
    rdfs:label 'Mark To Market Value' ;
    rdfs:comment 'The fair value of the net open position calculated using current market prices, in USD.' ;
    rdfs:domain ind:Trading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:marketPrice rdf:type rdf:Property ;
    rdfs:label 'Market Price' ;
    rdfs:comment 'The current market price (LMP for power, index price for gas, or market clearing price for capacity/RECs) used for mark-to-market valuation as of the valuation date, in USD per unit.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:marketSegment rdf:type rdf:Property ;
    rdfs:label 'Market Segment' ;
    rdfs:comment 'The market segment in which this position was established (Day-Ahead Market, Real-Time Market, bilateral contract, futures exchange, or options exchange).' ;
    rdfs:domain ind:Trading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netVolume rdf:type rdf:Property ;
    rdfs:label 'Net Volume' ;
    rdfs:comment 'The net open position volume (long minus short), measured in MWh for power, MCF for gas, MW for capacity, or REC count for renewable certificates.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:positionSource rdf:type rdf:Property ;
    rdfs:label 'Position Source' ;
    rdfs:comment 'Indicates whether the position is derived from physical contracts, financial derivatives, or the net of both.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:positionStatus rdf:type rdf:Property ;
    rdfs:label 'Position Status' ;
    rdfs:comment 'The current lifecycle status of the position (open, closed, expired, or settled).' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recInventoryBalance rdf:type rdf:Property ;
    rdfs:label 'Rec Inventory Balance' ;
    rdfs:comment 'For REC commodity type, the current inventory balance of Renewable Energy Certificates held in the portfolio, measured in certificate count.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recVintageYear rdf:type rdf:Property ;
    rdfs:label 'Rec Vintage Year' ;
    rdfs:comment 'For REC commodity type, the vintage year of the renewable energy generation that created the certificates.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rpsComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Rps Compliance Flag' ;
    rdfs:comment 'Indicates whether this position (particularly REC positions) contributes to state Renewable Portfolio Standard compliance obligations.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:shortVolume rdf:type rdf:Property ;
    rdfs:label 'Short Volume' ;
    rdfs:comment 'The total volume of short (sell) positions held, measured in MWh for power, MCF for gas, MW for capacity, or REC count for renewable certificates.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tradingBook rdf:type rdf:Property ;
    rdfs:label 'Trading Book' ;
    rdfs:comment 'The trading book or sub-portfolio classification for internal risk management and P&L attribution.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unrealizedPnl rdf:type rdf:Property ;
    rdfs:label 'Unrealized Pnl' ;
    rdfs:comment 'The unrealized profit or loss on the net open position, calculated as the difference between mark-to-market value and book value, in USD.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:var95 rdf:type rdf:Property ;
    rdfs:label 'Var 95' ;
    rdfs:comment 'The Value at Risk (VaR) for this position at 95% confidence level, representing the maximum expected loss over a one-day holding period, in USD.' ;
    rdfs:domain ind:Position ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contractOwnerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Contract Owner Employee Id' ;
    rdfs:comment 'Identifier for the internal employee responsible for managing and administering this PPA.' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:deliveryPointNodeId rdf:type rdf:Property ;
    rdfs:label 'Delivery Point Node Id' ;
    rdfs:comment 'The ISO/RTO pricing node identifier for the delivery point, used for LMP-based settlement.' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PricingNode .

ind:capacityPaymentPerMwMonth rdf:type rdf:Property ;
    rdfs:label 'Capacity Payment Per Mw Month' ;
    rdfs:comment 'The monthly capacity payment in USD per MW of contracted capacity, applicable when pricing structure includes separate capacity payments.' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:collateralRequirementUsd rdf:type rdf:Property ;
    rdfs:label 'Collateral Requirement Usd' ;
    rdfs:comment 'The amount of collateral in USD that the counterparty must post to secure performance under the PPA.' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contractAmendmentCount rdf:type rdf:Property ;
    rdfs:label 'Contract Amendment Count' ;
    rdfs:comment 'The number of amendments or modifications made to the original PPA since execution.' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contractExecutionDate rdf:type rdf:Property ;
    rdfs:label 'Contract Execution Date' ;
    rdfs:comment 'The date on which the PPA was signed by both parties and became legally binding.' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contractName rdf:type rdf:Property ;
    rdfs:label 'Contract Name' ;
    rdfs:comment 'Descriptive name of the Power Purchase Agreement, often including counterparty and resource type for easy identification.' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractTermEndDate rdf:type rdf:Property ;
    rdfs:label 'Contract Term End Date' ;
    rdfs:comment 'The date on which the Power Purchase Agreement expires and energy delivery obligations cease, unless extended or terminated early.' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contractTermStartDate rdf:type rdf:Property ;
    rdfs:label 'Contract Term Start Date' ;
    rdfs:comment 'The date on which the Power Purchase Agreement becomes effective and energy delivery obligations begin.' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contractValueUsd rdf:type rdf:Property ;
    rdfs:label 'Contract Value Usd' ;
    rdfs:comment 'The estimated total value of the PPA in USD over its full term, calculated from contracted volumes and pricing.' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contractedCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Contracted Capacity Mw' ;
    rdfs:comment 'The nameplate capacity in megawatts (MW) that the seller commits to make available under the PPA.' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contractedEnergyMwhAnnual rdf:type rdf:Property ;
    rdfs:label 'Contracted Energy Mwh Annual' ;
    rdfs:comment 'The annual energy volume in megawatt-hours (MWh) that the seller is expected to deliver under the PPA, often used for renewable PPAs with production estimates.' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:creditRatingRequirement rdf:type rdf:Property ;
    rdfs:label 'Credit Rating Requirement' ;
    rdfs:comment 'Minimum credit rating required for the counterparty under the PPA, if specified (e.g., \'BBB- or higher\').' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:curtailmentCompensationTerms rdf:type rdf:Property ;
    rdfs:label 'Curtailment Compensation Terms' ;
    rdfs:comment 'Description of compensation terms when energy delivery is curtailed, such as payment for lost generation or no compensation.' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:curtailmentProvisionFlag rdf:type rdf:Property ;
    rdfs:label 'Curtailment Provision Flag' ;
    rdfs:comment 'Indicates whether the PPA includes provisions allowing the buyer to curtail (reduce or stop) energy delivery under certain conditions (True) or not (False).' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fixedPricePerMwh rdf:type rdf:Property ;
    rdfs:label 'Fixed Price Per Mwh' ;
    rdfs:comment 'The fixed price in USD per megawatt-hour for energy delivered under the PPA, applicable when pricing structure is fixed.' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forceMajeureTerms rdf:type rdf:Property ;
    rdfs:label 'Force Majeure Terms' ;
    rdfs:comment 'Summary of force majeure provisions that excuse performance due to unforeseeable events (natural disasters, war, regulatory changes, etc.).' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentTermsDays rdf:type rdf:Property ;
    rdfs:label 'Payment Terms Days' ;
    rdfs:comment 'Number of days after invoice date within which payment is due under the PPA (e.g., 30 days).' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priceEscalationRatePercent rdf:type rdf:Property ;
    rdfs:label 'Price Escalation Rate Percent' ;
    rdfs:comment 'The annual percentage rate at which the PPA price escalates over the contract term, if applicable.' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priceIndexReference rdf:type rdf:Property ;
    rdfs:label 'Price Index Reference' ;
    rdfs:comment 'The market index or benchmark to which the PPA price is tied (e.g., \'Henry Hub Natural Gas\', \'PJM Day-Ahead LMP\'), applicable when pricing structure is indexed.' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recInclusionFlag rdf:type rdf:Property ;
    rdfs:label 'Rec Inclusion Flag' ;
    rdfs:comment 'Indicates whether Renewable Energy Certificates (RECs) are included in the PPA and transferred to the buyer (True) or retained by the seller (False).' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recTransferMechanism rdf:type rdf:Property ;
    rdfs:label 'Rec Transfer Mechanism' ;
    rdfs:comment 'Mechanism for REC transfer: bundled (RECs delivered with energy), unbundled (RECs delivered separately), or retained by seller.' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewablePortfolioStandardEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Renewable Portfolio Standard Eligible Flag' ;
    rdfs:comment 'Indicates whether energy from this PPA qualifies for state Renewable Portfolio Standard (RPS) compliance (True) or not (False).' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:settlementFrequency rdf:type rdf:Property ;
    rdfs:label 'Settlement Frequency' ;
    rdfs:comment 'Frequency at which energy deliveries and payments are settled under the PPA: monthly, quarterly, or annual.' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:terminationProvisions rdf:type rdf:Property ;
    rdfs:label 'Termination Provisions' ;
    rdfs:comment 'Summary of conditions under which either party may terminate the PPA early, including notice periods and penalties.' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recTransactionId rdf:type rdf:Property ;
    rdfs:label 'Rec Transaction Id' ;
    rdfs:comment 'Unique identifier for the REC transaction record. Primary key.' ;
    rdfs:domain ind:RecTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:brokerName rdf:type rdf:Property ;
    rdfs:label 'Broker Name' ;
    rdfs:comment 'Name of the broker or intermediary that facilitated the REC transaction, if applicable. Null if transaction was direct between parties.' ;
    rdfs:domain ind:RecTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceProgram rdf:type rdf:Property ;
    rdfs:label 'Compliance Program' ;
    rdfs:comment 'The regulatory compliance program or voluntary program for which the RECs are intended: state RPS (Renewable Portfolio Standard), voluntary green power program, carbon offset program, or corporate sustainability commitment. Free-text to accommodate various state and voluntary programs.' ;
    rdfs:domain ind:RecTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confirmationDate rdf:type rdf:Property ;
    rdfs:label 'Confirmation Date' ;
    rdfs:comment 'Date when the REC transaction was confirmed by the counterparty or broker, validating the transaction terms.' ;
    rdfs:domain ind:Trading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:confirmationNumber rdf:type rdf:Property ;
    rdfs:label 'Confirmation Number' ;
    rdfs:comment 'Confirmation number or reference provided by the counterparty or broker confirming the REC transaction details.' ;
    rdfs:domain ind:RecTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryMethod rdf:type rdf:Property ;
    rdfs:label 'Delivery Method' ;
    rdfs:comment 'Method by which RECs are delivered: registry transfer (electronic transfer within tracking system), physical certificate (paper certificate delivery), or electronic transfer (outside registry system).' ;
    rdfs:domain ind:RecTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:etrmSystemDealReference rdf:type rdf:Property ;
    rdfs:label 'Etrm System Deal Reference' ;
    rdfs:comment 'Unique deal or transaction identifier in the Allegro ETRM system or other energy trading platform. Used for reconciliation between lakehouse and source system.' ;
    rdfs:domain ind:Trading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:greenECertifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Green E Certified Flag' ;
    rdfs:comment 'Indicates whether the RECs are certified under the Green-e voluntary renewable energy certification program. True if Green-e certified, False otherwise.' ;
    rdfs:domain ind:RecTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pricePerRec rdf:type rdf:Property ;
    rdfs:label 'Price Per Rec' ;
    rdfs:comment 'Unit price paid or received per REC certificate, typically expressed in dollars per REC ($/REC). Used to calculate total transaction value.' ;
    rdfs:domain ind:RecTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:registrySystem rdf:type rdf:Property ;
    rdfs:label 'Registry System' ;
    rdfs:comment 'The renewable energy certificate tracking system or registry where the RECs are registered: WREGIS (Western), NEPOOL-GIS (New England), PJM-GATS (PJM), M-RETS (Midwest), NAR (North American Renewables), ERCOT, or MIRECS (Michigan). [ENUM-REF-CANDIDATE: WREGIS|NEPOOL-GIS|PJM-GATS|M-RETS|NAR|ERCOT|MIRECS — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:RecTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalTransactionValue rdf:type rdf:Property ;
    rdfs:label 'Total Transaction Value' ;
    rdfs:comment 'Total monetary value of the REC transaction in USD, calculated as quantity multiplied by price per REC. Represents the gross transaction amount before fees or adjustments.' ;
    rdfs:domain ind:RecTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:traderName rdf:type rdf:Property ;
    rdfs:label 'Trader Name' ;
    rdfs:comment 'Name of the trader or trading desk personnel responsible for executing this REC transaction.' ;
    rdfs:domain ind:RecTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskLimitId rdf:type rdf:Property ;
    rdfs:label 'Risk Limit Id' ;
    rdfs:comment 'Unique identifier for the risk limit record. Primary key for the risk limit entity.' ;
    rdfs:domain ind:RiskLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:approvalAuthority rdf:type rdf:Property ;
    rdfs:label 'Approval Authority' ;
    rdfs:comment 'Organizational role or body that approved this risk limit. Board indicates board of directors approval for enterprise-level limits, CRO (Chief Risk Officer) for portfolio-level limits, CFO (Chief Financial Officer) for financial exposure limits, risk committee for cross-functional limits, desk head for trader-level limits, and trading director for desk-level limits.' ;
    rdfs:domain ind:RiskLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvalResolutionNumber rdf:type rdf:Property ;
    rdfs:label 'Approval Resolution Number' ;
    rdfs:comment 'Reference number of the board resolution, committee decision, or executive approval document that authorized this risk limit. Used for audit trail and regulatory examination.' ;
    rdfs:domain ind:RiskLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:breachAction rdf:type rdf:Property ;
    rdfs:label 'Breach Action' ;
    rdfs:comment 'Automated or procedural action to be taken when this risk limit is breached. Alert generates notification to risk management, block prevents new trades that would increase exposure, escalate triggers management review, auto_hedge initiates automated hedging transactions, manual_review requires trader or desk head intervention before proceeding.' ;
    rdfs:domain ind:RiskLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:breachCount rdf:type rdf:Property ;
    rdfs:label 'Breach Count' ;
    rdfs:comment 'Total number of times this risk limit has been breached since its effective_date. Incremented each time current_exposure_value exceeds limit_value. Used for risk reporting and limit effectiveness analysis.' ;
    rdfs:domain ind:RiskLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:counterpartyCreditRatingThreshold rdf:type rdf:Property ;
    rdfs:label 'Counterparty Credit Rating Threshold' ;
    rdfs:comment 'Minimum credit rating required for counterparties when this limit applies to credit exposure. Expressed using standard rating agency notation (e.g., BBB-, A+, AA). Used to enforce credit quality standards in trading relationships. Nullable for non-credit-related limits.' ;
    rdfs:domain ind:RiskLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currentExposureValue rdf:type rdf:Property ;
    rdfs:label 'Current Exposure Value' ;
    rdfs:comment 'Current absolute exposure value being monitored against this limit, expressed in the same units as limit_value. Sourced from Allegro ETRM mark-to-market valuations, position reports, or credit exposure calculations depending on limit_type.' ;
    rdfs:domain ind:RiskLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentUtilizationPercent rdf:type rdf:Property ;
    rdfs:label 'Current Utilization Percent' ;
    rdfs:comment 'Current utilization of this risk limit expressed as a percentage of the limit_value. Calculated as (current_exposure / limit_value) * 100. Updated in near real-time from Allegro ETRM position data. Values approaching 100% trigger breach alerts.' ;
    rdfs:domain ind:RiskLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:etrmSystemLimitReference rdf:type rdf:Property ;
    rdfs:label 'Etrm System Limit Reference' ;
    rdfs:comment 'Unique identifier for this risk limit in the Allegro ETRM system. Used for system integration, real-time monitoring, and automated breach detection. Enables bidirectional synchronization between lakehouse and operational ETRM platform.' ;
    rdfs:domain ind:RiskLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastBreachDate rdf:type rdf:Property ;
    rdfs:label 'Last Breach Date' ;
    rdfs:comment 'Most recent date on which this risk limit was breached. Nullable if the limit has never been breached. Used for breach pattern analysis and regulatory reporting.' ;
    rdfs:domain ind:RiskLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastBreachValue rdf:type rdf:Property ;
    rdfs:label 'Last Breach Value' ;
    rdfs:comment 'Exposure value at the time of the most recent breach, expressed in limit_unit. Captures the magnitude of the breach for severity analysis and escalation decisions.' ;
    rdfs:domain ind:RiskLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:limitCode rdf:type rdf:Property ;
    rdfs:label 'Limit Code' ;
    rdfs:comment 'Unique alphanumeric code assigned to this risk limit for system identification and cross-reference with Allegro ETRM.' ;
    rdfs:domain ind:RiskLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitCurrency rdf:type rdf:Property ;
    rdfs:label 'Limit Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for monetary limit values. Typically USD for US-based utility operations, but may include CAD for cross-border transactions or other currencies for international hedging activities.' ;
    rdfs:domain ind:RiskLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitName rdf:type rdf:Property ;
    rdfs:label 'Limit Name' ;
    rdfs:comment 'Business-friendly name or title assigned to this risk limit for identification and reporting purposes.' ;
    rdfs:domain ind:RiskLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitScope rdf:type rdf:Property ;
    rdfs:label 'Limit Scope' ;
    rdfs:comment 'Organizational or business dimension to which this risk limit applies, defining whether the limit governs a portfolio, trading desk, individual trader, counterparty relationship, commodity type, geographic region, or ETRM book. [ENUM-REF-CANDIDATE: portfolio|desk|trader|counterparty|commodity|region|book — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:RiskLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitUnit rdf:type rdf:Property ;
    rdfs:label 'Limit Unit' ;
    rdfs:comment 'Unit of measure for the limit_value field. USD for monetary limits, MWh (Megawatt-Hour) for electric energy volume, MMBtu for gas volume, MW (Megawatt) for capacity, MCF (Thousand Cubic Feet) for gas volume, days for tenor limits, percent for concentration limits, and Greek letters (delta, gamma, vega, theta) for option sensitivity limits. [ENUM-REF-CANDIDATE: usd|mwh|mmbtu|mw|mcf|days|percent|delta|gamma|vega|theta — 11 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:RiskLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitValue rdf:type rdf:Property ;
    rdfs:label 'Limit Value' ;
    rdfs:comment 'Numeric threshold value defining the maximum allowable exposure for this risk limit. Interpretation depends on limit_type: for VaR and stop-loss this is a monetary amount, for open position this is a volume (MWh or MMBtu), for credit exposure this is a dollar amount, for tenor this is a time period in days.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryMandateReference rdf:type rdf:Property ;
    rdfs:label 'Regulatory Mandate Reference' ;
    rdfs:comment 'Citation of the regulatory requirement, order, or mandate that necessitates this risk limit. Examples include FERC Order 741, state PUC (Public Utility Commission) directives, NERC (North American Electric Reliability Corporation) standards, or internal policy references. Nullable for discretionary limits not driven by regulatory mandate.' ;
    rdfs:domain ind:RiskLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskLimitStatus rdf:type rdf:Property ;
    rdfs:label 'Risk Limit Status' ;
    rdfs:comment 'Current lifecycle status of this risk limit. Active limits are enforced, suspended limits are temporarily not enforced but remain on record, expired limits have passed their expiry_date, pending_approval limits await formal authorization, superseded limits have been replaced by newer versions.' ;
    rdfs:domain ind:RiskLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scopeIdentifier rdf:type rdf:Property ;
    rdfs:label 'Scope Identifier' ;
    rdfs:comment 'Specific identifier of the entity to which this limit applies (e.g., portfolio code, desk name, trader ID, counterparty code). Used in conjunction with limit_scope to define the exact boundary of the limit.' ;
    rdfs:domain ind:RiskLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timeHorizonDays rdf:type rdf:Property ;
    rdfs:label 'Time Horizon Days' ;
    rdfs:comment 'Time period in days over which the risk limit is measured. For VaR limits, this is the holding period (typically 1 day for trading portfolios). For tenor limits, this is the maximum forward duration allowed. Nullable for instantaneous limits like stop-loss.' ;
    rdfs:domain ind:RiskLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ancillaryServicesCharge rdf:type rdf:Property ;
    rdfs:label 'Ancillary Services Charge' ;
    rdfs:comment 'Charges for ancillary services including regulation, spinning reserves, non-spinning reserves, and voltage support required to maintain grid reliability.' ;
    rdfs:domain ind:Settlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:collateralApplied rdf:type rdf:Property ;
    rdfs:label 'Collateral Applied' ;
    rdfs:comment 'Amount of collateral (cash, letter of credit, or other security) applied against this settlement to reduce credit exposure.' ;
    rdfs:domain ind:Settlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:congestionCharge rdf:type rdf:Property ;
    rdfs:label 'Congestion Charge' ;
    rdfs:comment 'Congestion cost component of the settlement, reflecting transmission constraints and locational price differences in the market.' ;
    rdfs:domain ind:Settlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grossSettlementAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Settlement Amount' ;
    rdfs:comment 'Total settlement value before adjustments, calculated as settled volume multiplied by settlement price. Represents the base transaction value.' ;
    rdfs:domain ind:Settlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:imbalanceCharge rdf:type rdf:Property ;
    rdfs:label 'Imbalance Charge' ;
    rdfs:comment 'Penalty or credit for deviations between scheduled and actual delivery volumes. Calculated based on real-time imbalance pricing.' ;
    rdfs:domain ind:Settlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lossCharge rdf:type rdf:Property ;
    rdfs:label 'Loss Charge' ;
    rdfs:comment 'Marginal loss charge reflecting energy losses during transmission from generation to load. Based on loss factors published by the ISO/RTO.' ;
    rdfs:domain ind:Settlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netSettlementAmount rdf:type rdf:Property ;
    rdfs:label 'Net Settlement Amount' ;
    rdfs:comment 'Final settlement amount after all adjustments, charges, taxes, netting, and collateral. This is the actual payable or receivable amount.' ;
    rdfs:domain ind:Settlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nettingAdjustment rdf:type rdf:Property ;
    rdfs:label 'Netting Adjustment' ;
    rdfs:comment 'Adjustment amount applied when multiple settlements with the same counterparty are netted together under a master netting agreement.' ;
    rdfs:domain ind:Settlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:price rdf:type rdf:Property ;
    rdfs:label 'Price' ;
    rdfs:comment 'Unit price applied to the settled volume. May be a fixed contract price, Locational Marginal Price (LMP), or market clearing price depending on transaction type.' ;
    rdfs:domain ind:Trading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priceUnitOfMeasure rdf:type rdf:Property ;
    rdfs:label 'Price Unit Of Measure' ;
    rdfs:comment 'Unit of measure for the settlement price. Typically USD per MWh for electricity, USD per MMBtu for gas, USD per REC for certificates, USD per MW-day for capacity.' ;
    rdfs:domain ind:Trading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:runReference rdf:type rdf:Property ;
    rdfs:label 'Run Reference' ;
    rdfs:comment 'Identifier for the batch settlement run that produced this settlement record. Used to group settlements processed together and track settlement versions.' ;
    rdfs:domain ind:Settlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:schedulingCharge rdf:type rdf:Property ;
    rdfs:label 'Scheduling Charge' ;
    rdfs:comment 'Administrative fees for scheduling and dispatch services provided by the ISO/RTO or balancing authority.' ;
    rdfs:domain ind:Settlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:settledVolume rdf:type rdf:Property ;
    rdfs:label 'Settled Volume' ;
    rdfs:comment 'Quantity of commodity delivered or service provided during the settlement period. Measured in units appropriate to the commodity type (MWh for electricity, MMBtu for gas, RECs for certificates).' ;
    rdfs:domain ind:Settlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transmissionCharge rdf:type rdf:Property ;
    rdfs:label 'Transmission Charge' ;
    rdfs:comment 'Transmission and distribution charges allocated to this settlement. Includes wheeling fees, congestion charges, and ancillary service costs.' ;
    rdfs:domain ind:Settlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:amendmentVersion rdf:type rdf:Property ;
    rdfs:label 'Amendment Version' ;
    rdfs:comment 'Version number tracking amendments to the original trade. 0 = original trade, incremented for each amendment or modification.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:brokerReference rdf:type rdf:Property ;
    rdfs:label 'Broker Reference' ;
    rdfs:comment 'Reference to the broker or intermediary who facilitated the trade, if applicable. Null for direct bilateral trades or exchange-executed trades.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:buySellIndicator rdf:type rdf:Property ;
    rdfs:label 'Buy Sell Indicator' ;
    rdfs:comment 'Indicates whether the utility is buying or selling the commodity in this trade. Buy = utility is purchasing, Sell = utility is selling.' ;
    rdfs:domain ind:Trading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confirmationMethod rdf:type rdf:Property ;
    rdfs:label 'Confirmation Method' ;
    rdfs:comment 'The method by which the trade was confirmed with the counterparty. Electronic = automated system confirmation, Exchange Matched = automatically matched on exchange platform.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditLimitCheck rdf:type rdf:Property ;
    rdfs:label 'Credit Limit Check' ;
    rdfs:comment 'Indicates whether the trade passed credit limit validation at time of execution. True = credit approved, False = credit limit exceeded or waived.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deliveryEndDate rdf:type rdf:Property ;
    rdfs:label 'Delivery End Date' ;
    rdfs:comment 'The last date of the delivery period when the commodity will be delivered or the contract expires.' ;
    rdfs:domain ind:Trading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deliveryStartDate rdf:type rdf:Property ;
    rdfs:label 'Delivery Start Date' ;
    rdfs:comment 'The first date of the delivery period when the commodity will be delivered or the contract becomes effective.' ;
    rdfs:domain ind:Trading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:etrmTradeNumber rdf:type rdf:Property ;
    rdfs:label 'Etrm Trade Number' ;
    rdfs:comment 'The unique trade number assigned by the Allegro ETRM system. This is the business identifier used by traders and risk managers to reference the trade.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:executionVenue rdf:type rdf:Property ;
    rdfs:label 'Execution Venue' ;
    rdfs:comment 'The market or platform where the trade was executed. Bilateral = over-the-counter direct negotiation, DAM = Day-Ahead Market, RTM = Real-Time Market, ICE = Intercontinental Exchange, CME = Chicago Mercantile Exchange, NYMEX = New York Mercantile Exchange. [ENUM-REF-CANDIDATE: bilateral|dam|rtm|ice|cme|nymex|other_exchange — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hedgeProgramReference rdf:type rdf:Property ;
    rdfs:label 'Hedge Program Reference' ;
    rdfs:comment 'Reference to the specific hedging program or strategy this trade supports, if designated as a hedge. Used for tracking hedge effectiveness and regulatory compliance.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:masterAgreementReference rdf:type rdf:Property ;
    rdfs:label 'Master Agreement Reference' ;
    rdfs:comment 'Reference to the master trading agreement (e.g., ISDA, EEI, NAESB) that governs the legal terms of this trade with the counterparty.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mtmValuationDate rdf:type rdf:Property ;
    rdfs:label 'Mtm Valuation Date' ;
    rdfs:comment 'The date as of which the mark-to-market value was calculated.' ;
    rdfs:domain ind:Trading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:novationFlag rdf:type rdf:Property ;
    rdfs:label 'Novation Flag' ;
    rdfs:comment 'Indicates whether this trade has been novated (transferred to a new counterparty). True = trade has been novated, False = original counterparty remains.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:originalTradeReference rdf:type rdf:Property ;
    rdfs:label 'Original Trade Reference' ;
    rdfs:comment 'Reference to the original trade if this trade is an amendment, novation, or related transaction. Used to maintain audit trail of trade modifications.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tradeDate rdf:type rdf:Property ;
    rdfs:label 'Trade Date' ;
    rdfs:comment 'The date on which the trade was executed and agreed upon by both parties.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:tradeStatus rdf:type rdf:Property ;
    rdfs:label 'Trade Status' ;
    rdfs:comment 'The current lifecycle status of the trade. Active = trade is live and in delivery period, Completed = delivery and settlement finished, Cancelled = trade cancelled before delivery, Terminated = trade ended early by mutual agreement.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tradeTimestamp rdf:type rdf:Property ;
    rdfs:label 'Trade Timestamp' ;
    rdfs:comment 'The precise date and time when the trade was executed, including timezone information. Critical for Day-Ahead Market (DAM) and Real-Time Market (RTM) reconciliation.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:tradeType rdf:type rdf:Property ;
    rdfs:label 'Trade Type' ;
    rdfs:comment 'Classification of the trade structure. Physical = actual delivery of commodity, Financial = cash-settled derivative with no physical delivery, Exchange = traded on organized exchange (ICE, CME), Virtual = virtual bid/offer in DAM/RTM with no physical asset.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transmissionServiceType rdf:type rdf:Property ;
    rdfs:label 'Transmission Service Type' ;
    rdfs:comment 'The type of transmission service associated with power delivery for this trade. Firm = guaranteed delivery, Non-Firm = interruptible, Network = integrated network service, Point-to-Point = specific path reservation, Not Applicable = no transmission component (e.g., gas trade).' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unrealizedGainLoss rdf:type rdf:Property ;
    rdfs:label 'Unrealized Gain Loss' ;
    rdfs:comment 'The unrealized profit or loss on the trade based on current mark-to-market valuation versus original contract value. Positive = gain, Negative = loss. Expressed in USD.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:volumeQuantity rdf:type rdf:Property ;
    rdfs:label 'Volume Quantity' ;
    rdfs:comment 'The total quantity of the commodity being traded. Units depend on commodity type: MWh for power, MCF or MMBtu for natural gas, MW for capacity, number of certificates for RECs.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ancillaryServicesIncludedFlag rdf:type rdf:Property ;
    rdfs:label 'Ancillary Services Included Flag' ;
    rdfs:comment 'Indicates whether ancillary services (regulation, reserves, reactive power) are bundled with this leg. True if ancillary services are included in the transaction, false if energy-only.' ;
    rdfs:domain ind:TradeLeg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:collateralRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Collateral Required Flag' ;
    rdfs:comment 'Indicates whether collateral posting is required for this leg based on credit terms and current exposure. True if collateral is required, false otherwise.' ;
    rdfs:domain ind:TradeLeg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contractPrice rdf:type rdf:Property ;
    rdfs:label 'Contract Price' ;
    rdfs:comment 'Agreed price per unit for this leg. May be a fixed price, floating price indexed to market, or formula-based price. Currency specified in settlement_currency field.' ;
    rdfs:domain ind:TradeLeg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contractQuantity rdf:type rdf:Property ;
    rdfs:label 'Contract Quantity' ;
    rdfs:comment 'Contracted volume or quantity for this leg. Represents the notional amount of the commodity to be delivered or settled. Unit of measure specified in quantity_unit_of_measure field.' ;
    rdfs:domain ind:TradeLeg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:creditExposure rdf:type rdf:Property ;
    rdfs:label 'Credit Exposure' ;
    rdfs:comment 'Current credit exposure to the counterparty for this leg. Calculated based on mark-to-market value and potential future exposure. Used for credit limit monitoring and collateral management.' ;
    rdfs:domain ind:TradeLeg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deliveredQuantity rdf:type rdf:Property ;
    rdfs:label 'Delivered Quantity' ;
    rdfs:comment 'Actual quantity physically delivered or financially settled for this leg. Used for final settlement reconciliation and variance analysis against contract and scheduled quantities.' ;
    rdfs:domain ind:TradeLeg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deliveryPointName rdf:type rdf:Property ;
    rdfs:label 'Delivery Point Name' ;
    rdfs:comment 'Human-readable name of the delivery location such as PJM Western Hub, Henry Hub, or specific substation or pipeline interconnection point.' ;
    rdfs:domain ind:TradeLeg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legSequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Leg Sequence Number' ;
    rdfs:comment 'Sequential ordering of this leg within the parent trade structure. Used to maintain the chronological or logical order of delivery or settlement legs in multi-period instruments.' ;
    rdfs:domain ind:TradeLeg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:legStatus rdf:type rdf:Property ;
    rdfs:label 'Leg Status' ;
    rdfs:comment 'Current lifecycle status of this trade leg. Tracks progression from initial booking through confirmation, scheduling, physical delivery or financial settlement, and final closure.' ;
    rdfs:domain ind:TradeLeg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legType rdf:type rdf:Property ;
    rdfs:label 'Leg Type' ;
    rdfs:comment 'Classification of the leg type within the structured product. Distinguishes between physical delivery legs, financial settlement legs, option exercise legs, swap components, and basis differential legs.' ;
    rdfs:domain ind:TradeLeg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pricingFormula rdf:type rdf:Property ;
    rdfs:label 'Pricing Formula' ;
    rdfs:comment 'Mathematical formula or algorithm used to calculate the final settlement price for this leg. May include heat rate calculations, basis adjustments, escalation factors, or complex option payoff structures.' ;
    rdfs:domain ind:TradeLeg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pricingIndex rdf:type rdf:Property ;
    rdfs:label 'Pricing Index' ;
    rdfs:comment 'Market pricing index or benchmark used for floating price legs. Examples include Day-Ahead LMP at specific node, Real-Time LMP, Henry Hub gas index, or bilateral index agreements.' ;
    rdfs:domain ind:TradeLeg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quantityUnitOfMeasure rdf:type rdf:Property ;
    rdfs:label 'Quantity Unit Of Measure' ;
    rdfs:comment 'Unit of measure for the contract quantity. Common units include MWh (Megawatt-Hour) for electricity energy, MW (Megawatt) for capacity, MMBtu or Dth for natural gas, REC for renewable certificates, and ton CO2 for emissions.' ;
    rdfs:domain ind:TradeLeg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewableAttributeFlag rdf:type rdf:Property ;
    rdfs:label 'Renewable Attribute Flag' ;
    rdfs:comment 'Indicates whether this leg includes renewable energy attributes or Renewable Energy Certificates (RECs). True if renewable attributes are part of the transaction, false for conventional energy.' ;
    rdfs:domain ind:TradeLeg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scheduledQuantity rdf:type rdf:Property ;
    rdfs:label 'Scheduled Quantity' ;
    rdfs:comment 'Actual quantity scheduled or nominated for physical delivery for this leg. May differ from contract quantity due to operational constraints, curtailments, or market conditions.' ;
    rdfs:domain ind:TradeLeg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:schedulingStatus rdf:type rdf:Property ;
    rdfs:label 'Scheduling Status' ;
    rdfs:comment 'Status of physical scheduling or nomination for this leg. Tracks whether the leg has been scheduled with the RTO/ISO or pipeline operator, and any curtailments or adjustments.' ;
    rdfs:domain ind:TradeLeg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementCurrency rdf:type rdf:Property ;
    rdfs:label 'Settlement Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for financial settlement of this leg. Predominantly USD for North American energy markets.' ;
    rdfs:domain ind:TradeLeg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemLegReference rdf:type rdf:Property ;
    rdfs:label 'Source System Leg Reference' ;
    rdfs:comment 'Original leg identifier from the source ETRM system. Maintained for traceability and reconciliation with upstream trading systems.' ;
    rdfs:domain ind:TradeLeg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tradeExecutionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Trade Execution Timestamp' ;
    rdfs:comment 'Precise date and time when this leg was executed or booked in the ETRM system. Critical for regulatory reporting and audit trail.' ;
    rdfs:domain ind:TradeLeg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:transmissionRightsRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Transmission Rights Required Flag' ;
    rdfs:comment 'Indicates whether firm transmission rights or Financial Transmission Rights (FTRs) are required to support physical delivery for this leg. True if transmission rights are needed, false otherwise.' ;
    rdfs:domain ind:TradeLeg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commodityScope rdf:type rdf:Property ;
    rdfs:label 'Commodity Scope' ;
    rdfs:comment 'Primary commodity or commodities traded within this portfolio: power (electricity), gas (natural gas), coal, fuel oil, renewable (RECs and renewable energy), or multi-commodity (mixed).' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currentCreditUtilizationPercent rdf:type rdf:Property ;
    rdfs:label 'Current Credit Utilization Percent' ;
    rdfs:comment 'Current credit exposure utilization as a percentage of the approved credit limit. Calculated as (current credit exposure / credit limit) * 100.' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentPositionUtilizationPercent rdf:type rdf:Property ;
    rdfs:label 'Current Position Utilization Percent' ;
    rdfs:comment 'Current open position utilization as a percentage of the approved position limit. Calculated as (current net position / position limit) * 100.' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentVarUtilizationPercent rdf:type rdf:Property ;
    rdfs:label 'Current Var Utilization Percent' ;
    rdfs:comment 'Current VaR utilization as a percentage of the approved VaR limit. Calculated as (current VaR / VaR limit) * 100.' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hedgeAccountingDesignation rdf:type rdf:Property ;
    rdfs:label 'Hedge Accounting Designation' ;
    rdfs:comment 'Accounting treatment designation under FASB ASC 815: cash flow hedge (hedging variability in cash flows), fair value hedge (hedging changes in fair value), net investment hedge (hedging foreign currency exposure), or not designated (mark-to-market through earnings).' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:markToMarketMethodology rdf:type rdf:Property ;
    rdfs:label 'Mark To Market Methodology' ;
    rdfs:comment 'Valuation methodology used for mark-to-market calculations: forward curve (market forward prices), LMP-based (locational marginal pricing), broker quote (third-party broker quotes), model derived (internal pricing model), or cost basis (historical cost).' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:openPositionLimitMmbtu rdf:type rdf:Property ;
    rdfs:label 'Open Position Limit Mmbtu' ;
    rdfs:comment 'Maximum approved open position limit for gas portfolios expressed in million British thermal units. Represents the maximum net long or short position allowed.' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:openPositionLimitMwh rdf:type rdf:Property ;
    rdfs:label 'Open Position Limit Mwh' ;
    rdfs:comment 'Maximum approved open position limit for power portfolios expressed in megawatt-hours. Represents the maximum net long or short position allowed.' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pnlAttributionMethod rdf:type rdf:Property ;
    rdfs:label 'Pnl Attribution Method' ;
    rdfs:comment 'Method used to attribute profit and loss: trade level (P&L calculated and attributed at individual trade level), portfolio level (P&L calculated at aggregate portfolio level), or blended (combination of both).' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:portfolioCode rdf:type rdf:Property ;
    rdfs:label 'Portfolio Code' ;
    rdfs:comment 'Short alphanumeric code used as the business identifier for the portfolio in trading systems and reports.' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:portfolioName rdf:type rdf:Property ;
    rdfs:label 'Portfolio Name' ;
    rdfs:comment 'Business name of the trading portfolio used for identification and reporting purposes.' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:portfolioStatus rdf:type rdf:Property ;
    rdfs:label 'Portfolio Status' ;
    rdfs:comment 'Current lifecycle status of the trading portfolio: active (operational and accepting new positions), suspended (temporarily inactive), closed (permanently closed), or pending approval (awaiting board or management approval).' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:portfolioType rdf:type rdf:Property ;
    rdfs:label 'Portfolio Type' ;
    rdfs:comment 'Classification of the portfolio by its primary business purpose: generation hedge (hedging generation output), load hedge (hedging customer load obligations), proprietary (speculative trading), ancillary (ancillary services), fuel (fuel procurement hedging), or renewable (renewable energy and REC trading).' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transformerAssociatedTransmissionTransformerId rdf:type rdf:Property ;
    rdfs:label 'Transformer Associated Transmission Transformer Id' ;
    rdfs:comment 'Identifier of the transformer directly connected to the bus, if any.' ;
    rdfs:domain ind:Bus ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TransmissionTransformer .

ind:transmissionTransformerId rdf:type rdf:Property ;
    rdfs:label 'Transmission Transformer Id' ;
    rdfs:comment 'Identifier of the transformer directly connected to the bus, if any.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TransmissionTransformer .

ind:area rdf:type rdf:Property ;
    rdfs:label 'Area' ;
    rdfs:comment 'Geographic or market area to which the bus belongs.' ;
    rdfs:domain ind:Bus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:busDescription rdf:type rdf:Property ;
    rdfs:label 'Bus Description' ;
    rdfs:comment 'Free-form text describing the bus, its role, or special characteristics.' ;
    rdfs:domain ind:Bus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:busName rdf:type rdf:Property ;
    rdfs:label 'Bus Name' ;
    rdfs:comment 'Human-readable name of the bus, often used in schematics and reports.' ;
    rdfs:domain ind:Bus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:busNumber rdf:type rdf:Property ;
    rdfs:label 'Bus Number' ;
    rdfs:comment 'Alphanumeric identifier assigned by SCADA/EMS for the bus.' ;
