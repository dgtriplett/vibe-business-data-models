ind:budgetUsd rdf:type rdf:Property ;
    rdfs:label 'Budget Usd' ;
    rdfs:comment 'Approved monetary budget for the campaign expressed in U.S. dollars.' ;
    rdfs:domain ind:OutreachCampaign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:campaignCode rdf:type rdf:Property ;
    rdfs:label 'Campaign Code' ;
    rdfs:comment 'Human-readable external code or number used to reference the campaign in business processes.' ;
    rdfs:domain ind:OutreachCampaign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:campaignType rdf:type rdf:Property ;
    rdfs:label 'Campaign Type' ;
    rdfs:comment 'Category of the campaign indicating its business purpose.' ;
    rdfs:domain ind:OutreachCampaign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactedAccountCount rdf:type rdf:Property ;
    rdfs:label 'Contacted Account Count' ;
    rdfs:comment 'Number of accounts that were actually contacted during the campaign.' ;
    rdfs:domain ind:OutreachCampaign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:endDate rdf:type rdf:Property ;
    rdfs:label 'End Date' ;
    rdfs:comment 'Date on which the campaign is scheduled to end.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:enrollmentConversionCount rdf:type rdf:Property ;
    rdfs:label 'Enrollment Conversion Count' ;
    rdfs:comment 'Number of responses that resulted in enrollment into a demand-side management program.' ;
    rdfs:domain ind:OutreachCampaign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isTestCampaign rdf:type rdf:Property ;
    rdfs:label 'Is Test Campaign' ;
    rdfs:comment 'Indicates whether the campaign is a pilot or test run (true) or a production campaign (false).' ;
    rdfs:domain ind:OutreachCampaign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outreachCampaignDescription rdf:type rdf:Property ;
    rdfs:label 'Outreach Campaign Description' ;
    rdfs:comment 'Free-form text describing the purpose, scope, and key messages of the campaign.' ;
    rdfs:domain ind:OutreachCampaign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outreachCampaignName rdf:type rdf:Property ;
    rdfs:label 'Outreach Campaign Name' ;
    rdfs:comment 'Descriptive name of the outreach campaign.' ;
    rdfs:domain ind:OutreachCampaign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outreachCampaignStatus rdf:type rdf:Property ;
    rdfs:label 'Outreach Campaign Status' ;
    rdfs:comment 'Current lifecycle status of the campaign.' ;
    rdfs:domain ind:OutreachCampaign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseCount rdf:type rdf:Property ;
    rdfs:label 'Response Count' ;
    rdfs:comment 'Total number of responses received from contacted accounts.' ;
    rdfs:domain ind:OutreachCampaign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:segmentCriteria rdf:type rdf:Property ;
    rdfs:label 'Segment Criteria' ;
    rdfs:comment 'Business rules or filters that define the target customer segment for the campaign.' ;
    rdfs:domain ind:OutreachCampaign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:startDate rdf:type rdf:Property ;
    rdfs:label 'Start Date' ;
    rdfs:comment 'Date on which the campaign is scheduled to begin.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:targetAccountCount rdf:type rdf:Property ;
    rdfs:label 'Target Account Count' ;
    rdfs:comment 'Number of customer accounts identified for outreach.' ;
    rdfs:domain ind:OutreachCampaign ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:satisfactionSurveyId rdf:type rdf:Property ;
    rdfs:label 'Satisfaction Survey Id' ;
    rdfs:comment 'Unique identifier for the satisfaction survey record.' ;
    rdfs:domain ind:SatisfactionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:billingAccuracyRating rdf:type rdf:Property ;
    rdfs:label 'Billing Accuracy Rating' ;
    rdfs:comment 'Customer rating of billing accuracy on a 1-10 scale.' ;
    rdfs:domain ind:SatisfactionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:confidentialityFlag rdf:type rdf:Property ;
    rdfs:label 'Confidentiality Flag' ;
    rdfs:comment 'Indicates if the survey contains confidential information.' ;
    rdfs:domain ind:SatisfactionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deliveryChannel rdf:type rdf:Property ;
    rdfs:label 'Delivery Channel' ;
    rdfs:comment 'Medium through which the survey was delivered to the respondent.' ;
    rdfs:domain ind:SatisfactionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:followUpActionDueDate rdf:type rdf:Property ;
    rdfs:label 'Follow Up Action Due Date' ;
    rdfs:comment 'Target date by which any required follow-up must be completed.' ;
    rdfs:domain ind:SatisfactionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:followUpActionRequired rdf:type rdf:Property ;
    rdfs:label 'Follow Up Action Required' ;
    rdfs:comment 'Indicates whether the survey response triggers a follow-up action.' ;
    rdfs:domain ind:SatisfactionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:kamResponsivenessRating rdf:type rdf:Property ;
    rdfs:label 'Kam Responsiveness Rating' ;
    rdfs:comment 'Rating of the Key Account Manager\'s responsiveness, 1-10.' ;
    rdfs:domain ind:SatisfactionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:npsScore rdf:type rdf:Property ;
    rdfs:label 'Nps Score' ;
    rdfs:comment 'Standard NPS metric indicating likelihood to recommend the utility.' ;
    rdfs:domain ind:SatisfactionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:overallSatisfactionScore rdf:type rdf:Property ;
    rdfs:label 'Overall Satisfaction Score' ;
    rdfs:comment 'Overall rating of the utility service provided by the customer, on a 1-10 scale.' ;
    rdfs:domain ind:SatisfactionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:programValueRating rdf:type rdf:Property ;
    rdfs:label 'Program Value Rating' ;
    rdfs:comment 'Rating of the perceived value of demand-side management or other programs.' ;
    rdfs:domain ind:SatisfactionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:respondentName rdf:type rdf:Property ;
    rdfs:label 'Respondent Name' ;
    rdfs:comment 'Full legal name of the survey respondent.' ;
    rdfs:domain ind:SatisfactionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:respondentRole rdf:type rdf:Property ;
    rdfs:label 'Respondent Role' ;
    rdfs:comment 'Role of the individual who completed the survey.' ;
    rdfs:domain ind:SatisfactionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Response Time Minutes' ;
    rdfs:comment 'Time taken by the respondent to complete the survey, measured in minutes.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:satisfactionSurveyStatus rdf:type rdf:Property ;
    rdfs:label 'Satisfaction Survey Status' ;
    rdfs:comment 'Current lifecycle status of the survey.' ;
    rdfs:domain ind:SatisfactionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceReliabilityRating rdf:type rdf:Property ;
    rdfs:label 'Service Reliability Rating' ;
    rdfs:comment 'Customer rating of service reliability on a 1-10 scale.' ;
    rdfs:domain ind:SatisfactionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:surveyCode rdf:type rdf:Property ;
    rdfs:label 'Survey Code' ;
    rdfs:comment 'External reference code for the survey, used in reporting and tracking.' ;
    rdfs:domain ind:SatisfactionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyDate rdf:type rdf:Property ;
    rdfs:label 'Survey Date' ;
    rdfs:comment 'Calendar date of the survey (date portion of survey_timestamp).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:surveyLanguage rdf:type rdf:Property ;
    rdfs:label 'Survey Language' ;
    rdfs:comment 'Language in which the survey was presented.' ;
    rdfs:domain ind:SatisfactionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyVersion rdf:type rdf:Property ;
    rdfs:label 'Survey Version' ;
    rdfs:comment 'Version of the survey instrument used.' ;
    rdfs:domain ind:SatisfactionSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agreementStatus rdf:type rdf:Property ;
    rdfs:label 'Agreement Status' ;
    rdfs:comment 'Current lifecycle status of the agreement.' ;
    rdfs:domain ind:VppAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agreementTermMonths rdf:type rdf:Property ;
    rdfs:label 'Agreement Term Months' ;
    rdfs:comment 'Duration of the agreement in months.' ;
    rdfs:domain ind:VppAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:capacityPaymentUsdPerKwMonth rdf:type rdf:Property ;
    rdfs:label 'Capacity Payment Usd Per Kw Month' ;
    rdfs:comment 'Compensation rate for committed capacity.' ;
    rdfs:domain ind:VppAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contractVersion rdf:type rdf:Property ;
    rdfs:label 'Contract Version' ;
    rdfs:comment 'Version number of the agreement document.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:derAssetTypes rdf:type rdf:Property ;
    rdfs:label 'Der Asset Types' ;
    rdfs:comment 'Types of distributed energy resources included (e.g., battery storage, backup generation, HVAC load, EV charging).' ;
    rdfs:domain ind:VppAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispatchProtocol rdf:type rdf:Property ;
    rdfs:label 'Dispatch Protocol' ;
    rdfs:comment 'Method by which the VPP operator dispatches resources.' ;
    rdfs:domain ind:VppAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drParticipation rdf:type rdf:Property ;
    rdfs:label 'Dr Participation' ;
    rdfs:comment 'Indicates whether the agreement includes demand response program participation.' ;
    rdfs:domain ind:VppAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:energyPaymentUsdPerKwh rdf:type rdf:Property ;
    rdfs:label 'Energy Payment Usd Per Kwh' ;
    rdfs:comment 'Compensation rate for actual energy dispatched.' ;
    rdfs:domain ind:VppAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exclusiveFlag rdf:type rdf:Property ;
    rdfs:label 'Exclusive Flag' ;
    rdfs:comment 'Indicates if the customer is prohibited from participating in other VPP programs.' ;
    rdfs:domain ind:VppAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maxDispatchPowerKw rdf:type rdf:Property ;
    rdfs:label 'Max Dispatch Power Kw' ;
    rdfs:comment 'Maximum power that can be dispatched from the aggregated resources.' ;
    rdfs:domain ind:VppAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minDispatchPowerKw rdf:type rdf:Property ;
    rdfs:label 'Min Dispatch Power Kw' ;
    rdfs:comment 'Minimum power that must be dispatched when called upon.' ;
    rdfs:domain ind:VppAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pucFilingReference rdf:type rdf:Property ;
    rdfs:label 'Puc Filing Reference' ;
    rdfs:comment 'Reference identifier for the state Public Utility Commission filing.' ;
    rdfs:domain ind:VppAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recEligible rdf:type rdf:Property ;
    rdfs:label 'Rec Eligible' ;
    rdfs:comment 'Flag indicating if the agreement qualifies for Renewable Energy Certificates.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:renewableFlag rdf:type rdf:Property ;
    rdfs:label 'Renewable Flag' ;
    rdfs:comment 'Indicates if the DER assets are primarily renewable (e.g., solar, wind).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:settlementMarket rdf:type rdf:Property ;
    rdfs:label 'Settlement Market' ;
    rdfs:comment 'Wholesale market(s) where the VPP resources are settled.' ;
    rdfs:domain ind:VppAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:signedDate rdf:type rdf:Property ;
    rdfs:label 'Signed Date' ;
    rdfs:comment 'Date when the agreement was signed by all parties.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:totalCommittedCapacityKw rdf:type rdf:Property ;
    rdfs:label 'Total Committed Capacity Kw' ;
    rdfs:comment 'Total capacity in kilowatts that the customer/aggregator commits to provide to the VPP.' ;
    rdfs:domain ind:VppAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vppProgramName rdf:type rdf:Property ;
    rdfs:label 'Vpp Program Name' ;
    rdfs:comment 'Name of the specific VPP program under which the agreement is executed.' ;
    rdfs:domain ind:VppAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:apInvoiceId rdf:type rdf:Property ;
    rdfs:label 'Ap Invoice Id' ;
    rdfs:comment 'Unique surrogate identifier for the accounts payable invoice record in the Databricks Silver Layer. Primary key for this entity.' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:goodsReceiptId rdf:type rdf:Property ;
    rdfs:label 'Goods Receipt Id' ;
    rdfs:comment 'Reference to the SAP MM goods receipt document (MBLNR) confirming physical receipt of materials or services. Required for three-way match (PO/GR/IR) validation before invoice approval and payment release.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GoodsReceipt .

ind:paymentRunId rdf:type rdf:Property ;
    rdfs:label 'Payment Run Id' ;
    rdfs:comment 'Reference to the SAP F110 Automatic Payment Program batch run (identified by run date + run ID) that processed this invoice for payment. Links the invoice to the batch disbursement execution record for bank reconciliation and payment audit trail.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PaymentRun .

ind:checkAchReference rdf:type rdf:Property ;
    rdfs:label 'Check Ach Reference' ;
    rdfs:comment 'The check number (for paper check payments) or ACH/EFT transaction reference number assigned by the bank or SAP payment program. Used for bank statement reconciliation, payment tracing, and stop-payment processing.' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:companyCode rdf:type rdf:Property ;
    rdfs:label 'Company Code' ;
    rdfs:comment 'The SAP FI company code (BUKRS) representing the legal entity or regulated utility subsidiary that owns this invoice. Supports multi-entity financial consolidation, separate regulatory filings per utility operating company, and FERC jurisdictional reporting.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discountDueDate rdf:type rdf:Property ;
    rdfs:label 'Discount Due Date' ;
    rdfs:comment 'The last date by which payment must be made to qualify for the early payment cash discount (SKFDT in SAP). Used by treasury to prioritize payments and capture available discounts for working capital optimization.' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:exchangeRate rdf:type rdf:Property ;
    rdfs:label 'Exchange Rate' ;
    rdfs:comment 'The exchange rate applied to convert the invoice currency to the company\'s functional currency (USD) at the time of posting (KURSF in SAP). Applicable for foreign currency invoices (e.g., international equipment, LNG procurement). Null for USD-denominated invoices.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expenditureCategory rdf:type rdf:Property ;
    rdfs:label 'Expenditure Category' ;
    rdfs:comment 'Designates whether the invoice expenditure is capitalized (CAPEX — added to the regulatory asset base and plant-in-service) or expensed (OPEX — charged to the income statement in the current period). Critical for rate case cost-of-service studies, RAB valuation, and FERC Form 1 reporting.' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fiscalPeriod rdf:type rdf:Property ;
    rdfs:label 'Fiscal Period' ;
    rdfs:comment 'The accounting period (MONAT, 1–16 including special periods) within the fiscal year in which the invoice is posted in SAP FI. Used for monthly close, period-end accruals, and regulatory reporting.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fiscalYear rdf:type rdf:Property ;
    rdfs:label 'Fiscal Year' ;
    rdfs:comment 'The fiscal year (GJAHR) in which this invoice is recorded in SAP FI. Used for annual financial reporting, FERC Form 1 submissions, rate case cost-of-service studies, and CAPEX/OPEX budget tracking.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:grossAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Amount' ;
    rdfs:comment 'The total gross amount of the invoice before tax deductions or discounts, as stated on the vendor\'s invoice (WRBTR in SAP). Represents the base amount for payment terms calculation, CAPEX/OPEX budget consumption, and cash flow planning.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:invoiceDescription rdf:type rdf:Property ;
    rdfs:label 'Invoice Description' ;
    rdfs:comment 'Free-text description of the goods or services invoiced, as entered in the SAP invoice header text (SGTXT). Provides context for the expenditure, supports spend analytics, and aids in dispute resolution and audit inquiries.' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:invoiceReceiptTimestamp rdf:type rdf:Property ;
    rdfs:label 'Invoice Receipt Timestamp' ;
    rdfs:comment 'The date and time when the vendor invoice was received and entered into SAP (CPUDT/CPUTM in RBKP). Marks the start of the AP invoice lifecycle. Used for cycle time measurement (receipt to payment), early payment discount eligibility, and accrual management.' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:invoiceStatus rdf:type rdf:Property ;
    rdfs:label 'Invoice Status' ;
    rdfs:comment 'Current workflow state of the AP invoice through its full lifecycle: received (entered into SAP), under_review (three-way match or approval in progress), approved (cleared for payment), blocked (payment block set — e.g., price variance, quantity discrepancy), paid (payment executed), cancelled (voided). Drives AP aging, cash flow forecasting, and audit trails.' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:invoiceType rdf:type rdf:Property ;
    rdfs:label 'Invoice Type' ;
    rdfs:comment 'Classification of the invoice document type in SAP FI (BLART). Distinguishes standard vendor invoices, credit memos (vendor returns/adjustments), debit memos, recurring invoices (e.g., lease payments), prepayments, and employee expense reimbursements. Drives accounting treatment and payment processing logic.' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isIntercompany rdf:type rdf:Property ;
    rdfs:label 'Is Intercompany' ;
    rdfs:comment 'Indicates whether this invoice represents a transaction between two legal entities within the same utility holding company group (e.g., shared services charges, intercompany fuel transfers, corporate allocations). True = intercompany invoice requiring elimination in consolidated financial statements.' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRecurring rdf:type rdf:Property ;
    rdfs:label 'Is Recurring' ;
    rdfs:comment 'Indicates whether this invoice is part of a recurring payment schedule (e.g., monthly lease payments, standing purchase orders for O&M services, recurring software subscriptions). True = recurring invoice generated from an SAP recurring document template. Supports cash flow forecasting and accrual automation.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentBlockCode rdf:type rdf:Property ;
    rdfs:label 'Payment Block Code' ;
    rdfs:comment 'SAP payment block indicator (ZLSPR) that prevents the invoice from being selected in the automatic payment program run. Common block reasons: price variance exceeds tolerance, quantity discrepancy, missing goods receipt, manual hold pending approval, disputed invoice. Null if no block is set. [ENUM-REF-CANDIDATE: price_variance|quantity_discrepancy|missing_gr|manual_hold|disputed|duplicate_check — promote to reference product]' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentDocumentNumber rdf:type rdf:Property ;
    rdfs:label 'Payment Document Number' ;
    rdfs:comment 'The SAP FI accounting document number generated upon payment execution (clearing document AUGBL). Used to link the open AP invoice item to its clearing payment entry in the general ledger for bank reconciliation and audit trail.' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentTermsCode rdf:type rdf:Property ;
    rdfs:label 'Payment Terms Code' ;
    rdfs:comment 'The SAP payment terms key (ZTERM) defining the payment due date calculation, early payment discount periods, and installment schedules (e.g., NT30 = net 30 days, 2/10NT30 = 2% discount if paid within 10 days, net 30). Drives due date calculation and cash flow forecasting.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postingDate rdf:type rdf:Property ;
    rdfs:label 'Posting Date' ;
    rdfs:comment 'The date on which the invoice was posted to the SAP general ledger (BUDAT). Determines the fiscal period and year for CAPEX/OPEX recognition, regulatory asset accounting under FASB ASC 980, and FERC Form 1 period reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:procurementCategory rdf:type rdf:Property ;
    rdfs:label 'Procurement Category' ;
    rdfs:comment 'Business category of goods or services procured, aligned to the utility\'s spend taxonomy: fuel procurement (coal, gas, nuclear fuel), T&D materials, contractor/construction services, equipment purchases, IT services, professional services, O&M supplies, etc. Supports spend analytics, supplier management, and regulatory cost allocation. [ENUM-REF-CANDIDATE: fuel|materials|contractor_services|equipment|it_services|professional_services|om_supplies|employee_expense — promote to reference product]' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sapDocumentNumber rdf:type rdf:Property ;
    rdfs:label 'Sap Document Number' ;
    rdfs:comment 'The internal SAP FI accounting document number (BELNR) assigned upon invoice posting in the general ledger. Used for reconciliation between the AP subledger and the general ledger in SAP FI/CO.' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxCode rdf:type rdf:Property ;
    rdfs:label 'Tax Code' ;
    rdfs:comment 'The SAP tax code (MWSKZ) applied to the invoice for sales/use tax calculation. Determines the applicable tax rate, tax jurisdiction, and whether the tax is recoverable or non-recoverable. Relevant for state and local tax compliance in utility operations.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:threeWayMatchStatus rdf:type rdf:Property ;
    rdfs:label 'Three Way Match Status' ;
    rdfs:comment 'Result of the three-way match validation between the Purchase Order (PO), Goods Receipt (GR), and Invoice Receipt (IR) in SAP MM/FI. Indicates whether the invoice quantity and price align within tolerance to the PO and GR. Drives automatic payment release or block assignment. \'not_applicable\' for non-PO invoices (e.g., utilities, rent, employee expenses).' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorInvoiceDate rdf:type rdf:Property ;
    rdfs:label 'Vendor Invoice Date' ;
    rdfs:comment 'The date printed on the vendor\'s invoice document (BLDAT in SAP). Represents the principal real-world business event date — when the vendor issued the invoice. Used for payment terms calculation and aging analysis.' ;
    rdfs:domain ind:ApInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:arTransactionId rdf:type rdf:Property ;
    rdfs:label 'Ar Transaction Id' ;
    rdfs:comment 'Unique surrogate identifier for each accounts receivable transaction record in the finance domain. Primary key for the ar_transaction data product.' ;
    rdfs:domain ind:ArTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contractId rdf:type rdf:Property ;
    rdfs:label 'Contract Id' ;
    rdfs:comment 'Reference to the underlying commercial contract, Power Purchase Agreement (PPA), transmission service agreement, or inter-company agreement that governs this AR transaction. Links to the contract master for terms and pricing validation.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:UtilityCompany .

ind:agingBucket rdf:type rdf:Property ;
    rdfs:label 'Aging Bucket' ;
    rdfs:comment 'Aging classification of the outstanding AR balance based on the number of days past the due date. Used for bad debt provisioning, collection prioritization, and AR aging reports required for FERC Form 1 and internal financial reporting.' ;
    rdfs:domain ind:ArTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessUnitCode rdf:type rdf:Property ;
    rdfs:label 'Business Unit Code' ;
    rdfs:comment 'SAP organizational unit code identifying the business unit (e.g., Electric Transmission, Gas Distribution, Generation) responsible for the revenue stream associated with this AR transaction. Used for segment reporting and FERC Form 1 functional classification.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clearingDocumentNumber rdf:type rdf:Property ;
    rdfs:label 'Clearing Document Number' ;
    rdfs:comment 'SAP FI-AR clearing document number assigned when this AR transaction is fully or partially settled against an incoming payment. Enables reconciliation between the AR open item and the corresponding bank receipt or inter-company settlement.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Contract Reference Number' ;
    rdfs:comment 'External contract or agreement reference number (e.g., PPA number, transmission service agreement number, FERC tariff rate schedule reference) associated with this AR transaction. Used for counterparty reconciliation without requiring a join to the contract master.' ;
    rdfs:domain ind:ArTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:counterpartyType rdf:type rdf:Property ;
    rdfs:label 'Counterparty Type' ;
    rdfs:comment 'Classification of the counterparty category for this AR transaction. Distinguishes wholesale energy buyers, inter-company entities, RTO/ISO settlement parties, transmission service customers, REC buyers, and miscellaneous non-retail receivables. Drives reporting segmentation for FERC Form 1 and rate case cost-of-service studies.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dunningDate rdf:type rdf:Property ;
    rdfs:label 'Dunning Date' ;
    rdfs:comment 'Date on which the most recent dunning (collection notice) was issued to the counterparty for this AR transaction. Used to enforce dunning intervals and track collection activity history.' ;
    rdfs:domain ind:ArTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dunningLevel rdf:type rdf:Property ;
    rdfs:label 'Dunning Level' ;
    rdfs:comment 'Current dunning (collection notice) level assigned to this AR transaction in SAP FI-AR, ranging from 0 (no dunning) to the maximum configured level. Higher levels indicate escalating collection actions. Used to track collection effort intensity.' ;
    rdfs:domain ind:ArTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:energyVolumeMwh rdf:type rdf:Property ;
    rdfs:label 'Energy Volume Mwh' ;
    rdfs:comment 'Quantity of electrical energy in Megawatt-Hours (MWh) associated with this AR transaction for wholesale energy sales, RTO/ISO settlements, or PPA deliveries. Null for non-energy revenue streams such as REC sales or inter-company charges.' ;
    rdfs:domain ind:ArTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:intercompanyFlag rdf:type rdf:Property ;
    rdfs:label 'Intercompany Flag' ;
    rdfs:comment 'Indicates whether this AR transaction represents an inter-company charge between affiliated entities within the utility holding company structure. True = inter-company; False = third-party. Required for inter-company elimination in consolidated financial statements.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:invoiceAmount rdf:type rdf:Property ;
    rdfs:label 'Invoice Amount' ;
    rdfs:comment 'Gross billed amount on the AR invoice before any adjustments, credits, or taxes. Represents the total amount owed by the counterparty at the time of invoice issuance. Denominated in the currency specified by currency_code.' ;
    rdfs:domain ind:ArTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lmpPrice rdf:type rdf:Property ;
    rdfs:label 'Lmp Price' ;
    rdfs:comment 'Locational Marginal Price (LMP) in $/MWh used to value wholesale energy transactions settled through the RTO/ISO Day-Ahead Market (DAM) or Real-Time Market (RTM). Sourced from the applicable RTO/ISO settlement statement.' ;
    rdfs:domain ind:ArTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outstandingBalance rdf:type rdf:Property ;
    rdfs:label 'Outstanding Balance' ;
    rdfs:comment 'Remaining unpaid balance on this AR transaction (net_amount minus paid_amount). Represents the current exposure for collection management and bad debt provisioning. Refreshed upon each payment or adjustment posting.' ;
    rdfs:domain ind:ArTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paidAmount rdf:type rdf:Property ;
    rdfs:label 'Paid Amount' ;
    rdfs:comment 'Cumulative amount received from the counterparty against this AR transaction to date. Used to calculate the outstanding balance and determine partial payment status. Updated upon each payment posting in SAP FI-AR.' ;
    rdfs:domain ind:ArTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recQuantity rdf:type rdf:Property ;
    rdfs:label 'Rec Quantity' ;
    rdfs:comment 'Number of Renewable Energy Certificates (RECs) sold and invoiced in this AR transaction. One REC represents one MWh of electricity generated from a qualifying renewable source. Applicable only to REC sales revenue streams.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryAssetFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Asset Flag' ;
    rdfs:comment 'Indicates whether this AR transaction is associated with a FERC or state PUC-approved regulatory asset or deferred revenue mechanism under FASB ASC 980. True = subject to regulatory accounting treatment; False = standard commercial receivable.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:revenueCategory rdf:type rdf:Property ;
    rdfs:label 'Revenue Category' ;
    rdfs:comment 'Business classification of the revenue type driving this AR transaction. Supports segmented revenue reporting for FERC Form 1, rate case cost-of-service studies, and EBITDA analysis. [ENUM-REF-CANDIDATE: wholesale_energy_sales|transmission_wheeling|rec_sales|intercompany_charge|ppa_settlement|ancillary_services|miscellaneous — promote to reference product]' ;
    rdfs:domain ind:ArTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:servicePeriodEnd rdf:type rdf:Property ;
    rdfs:label 'Service Period End' ;
    rdfs:comment 'End date of the billing period or service delivery period covered by this AR transaction. Paired with service_period_start to define the revenue recognition window under FASB ASC 606.' ;
    rdfs:domain ind:ArTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:servicePeriodStart rdf:type rdf:Property ;
    rdfs:label 'Service Period Start' ;
    rdfs:comment 'Start date of the billing period or service delivery period covered by this AR transaction. For wholesale energy sales, this is the start of the energy delivery interval. For transmission wheeling, it is the start of the reservation period. Required for revenue recognition under FASB ASC 606.' ;
    rdfs:domain ind:ArTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:transactionDate rdf:type rdf:Property ;
    rdfs:label 'Transaction Date' ;
    rdfs:comment 'The principal business event date on which the AR transaction was originated — i.e., the date the revenue was earned or the invoice was issued. Used as the basis for aging calculations and revenue recognition under FASB ASC 606.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:transactionStatus rdf:type rdf:Property ;
    rdfs:label 'Transaction Status' ;
    rdfs:comment 'Current lifecycle state of the AR transaction indicating collection progress. Open = unpaid and within terms; partially_paid = partial payment received; paid = fully settled; overdue = past due date; disputed = counterparty has raised a formal dispute; written_off = deemed uncollectible and removed from active AR.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transmissionZone rdf:type rdf:Property ;
    rdfs:label 'Transmission Zone' ;
    rdfs:comment 'RTO/ISO transmission pricing zone or load zone associated with this AR transaction for wheeling charges and transmission service revenues. Used for FERC-jurisdictional revenue allocation and FERC Form 1 reporting.' ;
    rdfs:domain ind:ArTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:writeOffAmount rdf:type rdf:Property ;
    rdfs:label 'Write Off Amount' ;
    rdfs:comment 'Amount written off as uncollectible for this AR transaction. May be less than the full outstanding balance if a partial write-off was applied. Used for bad debt reserve reconciliation and FERC Form 1 reporting.' ;
    rdfs:domain ind:ArTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:writeOffFlag rdf:type rdf:Property ;
    rdfs:label 'Write Off Flag' ;
    rdfs:comment 'Indicates whether this AR transaction has been written off as uncollectible. True = written off and removed from active AR; False = still active. Triggers bad debt expense recognition under FASB ASC 310-10.' ;
    rdfs:domain ind:ArTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:primaryBankPersonId rdf:type rdf:Property ;
    rdfs:label 'Primary Bank Person Id' ;
    rdfs:comment 'Identifier of the primary authorized signer for the account.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Person .

ind:sweepTargetAccountId rdf:type rdf:Property ;
    rdfs:label 'Sweep Target Account Id' ;
    rdfs:comment 'Identifier of the target account for sweep transfers.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BankAccount .

ind:accountOwnerCostCenter rdf:type rdf:Property ;
    rdfs:label 'Account Owner Cost Center' ;
    rdfs:comment 'Cost center code of the owning department.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountOwnerDepartment rdf:type rdf:Property ;
    rdfs:label 'Account Owner Department' ;
    rdfs:comment 'Internal department responsible for the account.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorizedSignerName rdf:type rdf:Property ;
    rdfs:label 'Authorized Signer Name' ;
    rdfs:comment 'Full legal name of the authorized signer.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankAccountStatus rdf:type rdf:Property ;
    rdfs:label 'Bank Account Status' ;
    rdfs:comment 'Current lifecycle status of the bank account.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankBranchCode rdf:type rdf:Property ;
    rdfs:label 'Bank Branch Code' ;
    rdfs:comment 'Identifier for the specific branch of the bank where the account is held.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankName rdf:type rdf:Property ;
    rdfs:label 'Bank Name' ;
    rdfs:comment 'Legal name of the banking institution holding the account.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cashPositioningFlag rdf:type rdf:Property ;
    rdfs:label 'Cash Positioning Flag' ;
    rdfs:comment 'Indicates if the account is used for cash positioning activities.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:closingDate rdf:type rdf:Property ;
    rdfs:label 'Closing Date' ;
    rdfs:comment 'Date the account was closed or terminated (nullable).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dailyTransactionLimit rdf:type rdf:Property ;
    rdfs:label 'Daily Transaction Limit' ;
    rdfs:comment 'Maximum total transaction amount allowed per day.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:debtCovenantComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Debt Covenant Compliance Flag' ;
    rdfs:comment 'Indicates if the account is monitored for debt covenant compliance.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:iban rdf:type rdf:Property ;
    rdfs:label 'Iban' ;
    rdfs:comment 'International Bank Account Number for cross-border transactions.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastReconciledTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Reconciled Timestamp' ;
    rdfs:comment 'Timestamp of the last successful reconciliation.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:openingDate rdf:type rdf:Property ;
    rdfs:label 'Opening Date' ;
    rdfs:comment 'Date the account was opened with the bank.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:overdraftLimit rdf:type rdf:Property ;
    rdfs:label 'Overdraft Limit' ;
    rdfs:comment 'Maximum authorized overdraft amount.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reconciliationStatus rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Status' ;
    rdfs:comment 'Status of the most recent bank reconciliation.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:routingNumber rdf:type rdf:Property ;
    rdfs:label 'Routing Number' ;
    rdfs:comment 'Domestic routing number (e.g., ABA) used for ACH transactions.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sapCostCenterCode rdf:type rdf:Property ;
    rdfs:label 'Sap Cost Center Code' ;
    rdfs:comment 'SAP cost center linked to the account for internal cost allocation.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sapWbsElement rdf:type rdf:Property ;
    rdfs:label 'Sap Wbs Element' ;
    rdfs:comment 'SAP Work Breakdown Structure element associated with the account.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sweepArrangementFlag rdf:type rdf:Property ;
    rdfs:label 'Sweep Arrangement Flag' ;
    rdfs:comment 'Indicates whether the account participates in automatic sweep arrangements.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:swiftCode rdf:type rdf:Property ;
    rdfs:label 'Swift Code' ;
    rdfs:comment 'Bank Identifier Code used for international wire transfers.' ;
    rdfs:domain ind:BankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetId rdf:type rdf:Property ;
    rdfs:label 'Budget Id' ;
    rdfs:comment 'Unique surrogate identifier for each budget record in the Databricks Silver Layer. Serves as the primary key for the budget data product.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Budget .

ind:approverEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Approver Employee Id' ;
    rdfs:comment 'Employee identifier of the individual who approved this budget version. Supports governance audit trails, segregation of duties controls, and regulatory compliance documentation.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:irpCycleId rdf:type rdf:Property ;
    rdfs:label 'Irp Cycle Id' ;
    rdfs:comment 'Reference to the IRP planning cycle this budget is associated with. Supports long-range financial planning for generation, transmission, and distribution capital programs as required by state PUC IRP filings.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Cycle .

ind:profitCenterId rdf:type rdf:Property ;
    rdfs:label 'Profit Center Id' ;
    rdfs:comment 'Foreign key linking to finance.profit_center. Business justification: Budget header should reference the authoritative Cost Center, Profit Center and WBS Element tables rather than storing duplicate codes.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProfitCenter .

ind:assetClass rdf:type rdf:Property ;
    rdfs:label 'Asset Class' ;
    rdfs:comment 'For CAPEX budget lines, the ISO 55000 asset class of the capital investment (e.g., Substation Equipment, Transmission Lines, Distribution Transformers, Gas Mains, Generation Plant). Supports RAB valuation, depreciation scheduling, and FERC plant-in-service reporting. Null for OPEX lines.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetCategory rdf:type rdf:Property ;
    rdfs:label 'Budget Category' ;
    rdfs:comment 'Classifies the budget line as either Operating Expenditure (OPEX) — recurring operational costs — or Capital Expenditure (CAPEX) — investment in long-lived assets. Critical for RAB valuation, depreciation scheduling, and FERC Form 1 plant-in-service reporting.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetNumber rdf:type rdf:Property ;
    rdfs:label 'Budget Number' ;
    rdfs:comment 'Externally-known alphanumeric identifier assigned to the budget in SAP FI/CO (e.g., BUDG-2025-001). Used for cross-system reference and audit trail in rate case filings and FERC Form 1 reporting.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetType rdf:type rdf:Property ;
    rdfs:label 'Budget Type' ;
    rdfs:comment 'Further classifies the budget by accounting treatment: operating (standard O&M), capital (plant investment), regulatory_asset (deferred cost per FASB ASC 980), or regulatory_liability (deferred revenue/obligation per FASB ASC 980). Supports rate case cost-of-service studies.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessArea rdf:type rdf:Property ;
    rdfs:label 'Business Area' ;
    rdfs:comment 'SAP FI business area representing an independent accounting unit within the utility (e.g., Electric, Gas, Corporate). Enables segment reporting and regulatory ring-fencing between electric and gas operations.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capexProgramCode rdf:type rdf:Property ;
    rdfs:label 'Capex Program Code' ;
    rdfs:comment 'Identifies the capital investment program or portfolio this CAPEX budget line belongs to (e.g., Grid Modernization, AMI Deployment, Gas Main Replacement). Supports capital program-level reporting and CPCN regulatory filings. Null for OPEX lines.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:departmentCode rdf:type rdf:Property ;
    rdfs:label 'Department Code' ;
    rdfs:comment 'Organizational department code responsible for this budget line (e.g., DEPT-TRANS, DEPT-DIST, DEPT-GEN). Supports departmental budget ownership, accountability reporting, and workforce cost allocation.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depreciationRate rdf:type rdf:Property ;
    rdfs:label 'Depreciation Rate' ;
    rdfs:comment 'Annual depreciation rate (as a decimal, e.g., 0.0333 for 3.33%) applied to CAPEX budget lines for RAB valuation and FASB ASC 980 regulatory accounting. Null for OPEX lines. Sourced from the utility\'s FERC-approved depreciation study.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:energyDomain rdf:type rdf:Property ;
    rdfs:label 'Energy Domain' ;
    rdfs:comment 'The utility operational domain to which this budget line belongs: generation (fossil/nuclear/renewable), transmission (bulk electric), distribution (last-mile electric), gas (natural gas procurement and distribution), customer_service, or corporate. Supports FERC functional classification and regulatory ring-fencing.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:functionalArea rdf:type rdf:Property ;
    rdfs:label 'Functional Area' ;
    rdfs:comment 'SAP FI/CO functional area code classifying the budget by business function (e.g., Generation, Transmission, Distribution, Customer Service, Corporate). Supports FERC Form 1 functional classification and rate case cost allocation.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundCode rdf:type rdf:Property ;
    rdfs:label 'Fund Code' ;
    rdfs:comment 'Identifies the funding source or appropriation fund for this budget line (e.g., general fund, capital improvement fund, rate case recovery fund). Supports regulatory fund accounting and restricted-use tracking.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:plannedAmount rdf:type rdf:Property ;
    rdfs:label 'Planned Amount' ;
    rdfs:comment 'The budgeted monetary amount for this line item in USD. Represents the authorized spending plan for the GL account, cost center, or WBS element for the specified fiscal period. Core field for variance analysis against actual costs.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:planningHorizonEnd rdf:type rdf:Property ;
    rdfs:label 'Planning Horizon End' ;
    rdfs:comment 'The end date of the planning horizon covered by this budget record (e.g., 2029-12-31). Enables multi-year budget windows for capital programs, IRP cycles, and long-term rate case planning.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:planningHorizonStart rdf:type rdf:Property ;
    rdfs:label 'Planning Horizon Start' ;
    rdfs:comment 'The start date of the planning horizon covered by this budget record (e.g., 2025-01-01). Supports multi-year IRP financial planning and long-range capital investment scheduling.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryLiabilityFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Liability Flag' ;
    rdfs:comment 'Indicates whether this budget line relates to a FASB ASC 980 regulatory liability — an obligation to refund amounts to customers through future rate reductions. True = regulatory liability treatment applies.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:submissionDate rdf:type rdf:Property ;
    rdfs:label 'Submission Date' ;
    rdfs:comment 'The calendar date on which this budget version was formally submitted for review and approval. Supports governance audit trails and regulatory filing deadline tracking for GRC and FERC Form 1.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:varianceThresholdPct rdf:type rdf:Property ;
    rdfs:label 'Variance Threshold Pct' ;
    rdfs:comment 'The allowable percentage variance between budgeted and actual costs before a management escalation or re-forecast is triggered (e.g., 10.00 for 10%). Supports automated variance monitoring and financial control governance.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:versionType rdf:type rdf:Property ;
    rdfs:label 'Version Type' ;
    rdfs:comment 'Indicates the planning iteration of this budget record: initial_plan (original submission), revised_forecast (mid-year revision), final_approved (board/PUC-approved version), or supplemental (out-of-cycle amendment). Supports version-controlled budget management in SAP FI/CO.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetLineId rdf:type rdf:Property ;
    rdfs:label 'Budget Line Id' ;
    rdfs:comment 'Unique surrogate identifier for each budget line item within the enterprise data lakehouse. Primary key for the budget_line product.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BudgetLine .

ind:budgetPlanBudgetId rdf:type rdf:Property ;
    rdfs:label 'Budget Plan Budget Id' ;
    rdfs:comment 'Reference to the parent budget plan or budget version that this line item belongs to. Links the granular line to its overarching planning document.' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Budget .

ind:fundId rdf:type rdf:Property ;
    rdfs:label 'Fund Id' ;
    rdfs:comment 'Reference to the funding source or fund associated with this budget line, such as a regulatory rider fund, capital fund, or operating fund.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Fund .

ind:actualAmount rdf:type rdf:Property ;
    rdfs:label 'Actual Amount' ;
    rdfs:comment 'Actual expenditure or revenue posted to the GL account and cost object for the fiscal period. Sourced from SAP FI actual postings. Used for budget-to-actual variance analysis.' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allocationMethod rdf:type rdf:Property ;
    rdfs:label 'Allocation Method' ;
    rdfs:comment 'Method used to allocate shared or indirect costs to this budget line (e.g., Direct, Proportional, Equal Split, Usage-Based, Headcount). Required for cost-of-service studies in rate case filings.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetControlActive rdf:type rdf:Property ;
    rdfs:label 'Budget Control Active' ;
    rdfs:comment 'Indicates whether SAP CO budget availability control is active for this budget line, preventing expenditures from exceeding the approved budget amount.' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:budgetLineStatus rdf:type rdf:Property ;
    rdfs:label 'Budget Line Status' ;
    rdfs:comment 'Current workflow status of the budget line item. Controls editability and approval routing within the budget planning process.' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:committedAmount rdf:type rdf:Property ;
    rdfs:label 'Committed Amount' ;
    rdfs:comment 'Amount committed against this budget line through purchase orders, contracts, or work orders that have been approved but not yet invoiced. Derived from SAP MM/PM commitment management.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costType rdf:type rdf:Property ;
    rdfs:label 'Cost Type' ;
    rdfs:comment 'Distinguishes between direct costs attributable to a specific activity, indirect costs, allocated overhead, or shared service charges. Used in cost-of-service studies for rate case filings.' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depreciationAmount rdf:type rdf:Property ;
    rdfs:label 'Depreciation Amount' ;
    rdfs:comment 'Planned depreciation expense budgeted for this line item in the fiscal period. Applicable to CAPEX lines where asset depreciation is being planned. Supports EBITDA reporting and RAB calculations.' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expenditureType rdf:type rdf:Property ;
    rdfs:label 'Expenditure Type' ;
    rdfs:comment 'Detailed classification of the expenditure nature (e.g., Labor, Materials, Contractor Services, Depreciation, Fuel, Transmission Charges). Supports O&M cost categorization for regulatory reporting. [ENUM-REF-CANDIDATE: Labor|Materials|Contractor Services|Depreciation|Fuel|Transmission Charges|Other — promote to reference product]' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fiscalQuarter rdf:type rdf:Property ;
    rdfs:label 'Fiscal Quarter' ;
    rdfs:comment 'The fiscal quarter (1–4) within the fiscal year. Supports quarterly financial reporting and regulatory filing schedules.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:functionalAreaCode rdf:type rdf:Property ;
    rdfs:label 'Functional Area Code' ;
    rdfs:comment 'SAP CO functional area code classifying the budget line by business function (e.g., Generation, Transmission, Distribution, Customer Service, Administration). Used for functional cost reporting.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internalOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Internal Order Number' ;
    rdfs:comment 'SAP CO internal order number used for temporary cost collection on specific projects or activities not managed as WBS elements. Supports granular cost tracking for O&M activities.' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lineDescription rdf:type rdf:Property ;
    rdfs:label 'Line Description' ;
    rdfs:comment 'Free-text description of the budget line item, explaining the nature of the planned expenditure or revenue. Used in rate case cost-of-service studies and management reporting.' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lineNumber rdf:type rdf:Property ;
    rdfs:label 'Line Number' ;
    rdfs:comment 'Sequential line number within the parent budget plan, used for ordering and referencing individual line items in budget documents and reports.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rateCaseFlag rdf:type rdf:Property ;
    rdfs:label 'Rate Case Flag' ;
    rdfs:comment 'Indicates whether this budget line is included in a General Rate Case (GRC) or rate case cost-of-service study filing. True when the cost is subject to regulatory review for rate recovery.' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:revisedAmount rdf:type rdf:Property ;
    rdfs:label 'Revised Amount' ;
    rdfs:comment 'The revised or adjusted budget amount following a formal budget amendment or reforecast. Null if no revision has been made. Supports variance analysis between original and revised budgets.' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sourceSystemKey rdf:type rdf:Property ;
    rdfs:label 'Source System Key' ;
    rdfs:comment 'The natural key or document number from the originating SAP FI/CO system (e.g., SAP budget document number) that uniquely identifies this record in the source system. Supports data lineage and reconciliation.' ;
    rdfs:domain ind:BudgetLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountGroup rdf:type rdf:Property ;
    rdfs:label 'Account Group' ;
    rdfs:comment 'SAP FI/CO account group (field KTOKS) that controls the number range and field status for this GL account. Account groups organize accounts into logical segments (e.g., utility plant, O&M expenses, revenue accounts) for master data governance.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alternativeAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Alternative Account Number' ;
    rdfs:comment 'Country-specific or local statutory account number (SAP field ALTKT) used for local GAAP or statutory reporting requirements in jurisdictions where the utility operates. Supports mapping between FERC USoA accounts and state-specific chart of accounts requirements.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chartOfAccountsCode rdf:type rdf:Property ;
    rdfs:label 'Chart Of Accounts Code' ;
    rdfs:comment 'SAP FI/CO chart-of-accounts key (field KTOPL) identifying the specific chart of accounts plan to which this account belongs (e.g., \'UTIL\' for the utility operating chart, \'CONS\' for consolidated). Supports multi-company-code deployments.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consolidationAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Consolidation Account Number' ;
    rdfs:comment 'The group-level or holding company consolidation account number to which this operating entity GL account maps for intercompany elimination and consolidated financial statement preparation. Supports multi-entity utility holding company structures.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:controllingArea rdf:type rdf:Property ;
    rdfs:label 'Controlling Area' ;
    rdfs:comment 'SAP CO controlling area code (field KOKRS) to which this account is relevant for management accounting, cost center accounting, and internal order settlement. Links GL accounts to the CO module for CAPEX/OPEX tracking and EBITDA reporting.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costCategory rdf:type rdf:Property ;
    rdfs:label 'Cost Category' ;
    rdfs:comment 'Classifies the account as capital expenditure (CAPEX), operating expenditure (OPEX), regulatory asset, regulatory liability, or other. Critical for rate case cost-of-service studies, RAB valuation, and FASB ASC 980 regulatory accounting treatment.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costElementCategory rdf:type rdf:Property ;
    rdfs:label 'Cost Element Category' ;
    rdfs:comment 'SAP CO cost element category indicating whether the account is a primary cost element (originating from FI postings), secondary cost element (internal allocations only), or not applicable. Governs cost flow in SAP CO for rate case cost-of-service studies.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deactivationDate rdf:type rdf:Property ;
    rdfs:label 'Deactivation Date' ;
    rdfs:comment 'Date on which this GL account was deactivated or blocked from further postings. Null for currently active accounts. Supports chart of accounts lifecycle management and historical financial reporting for prior periods.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:depreciationRelevant rdf:type rdf:Property ;
    rdfs:label 'Depreciation Relevant' ;
    rdfs:comment 'Indicates whether this account is subject to depreciation calculations in SAP Asset Accounting (AA). Relevant for utility plant accounts included in the Regulatory Asset Base (RAB) and depreciation studies filed with the PUC.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ebitdaCategory rdf:type rdf:Property ;
    rdfs:label 'Ebitda Category' ;
    rdfs:comment 'Maps this account to its EBITDA component for management reporting and investor relations disclosures. Enables automated EBITDA bridge calculations from the general ledger without manual reclassification.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fercAccountDescription rdf:type rdf:Property ;
    rdfs:label 'Ferc Account Description' ;
    rdfs:comment 'Official FERC USoA account title and description corresponding to the mapped FERC account number. Provides regulatory context for auditors, rate case analysts, and FERC Form 1 preparers.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fercScheduleReference rdf:type rdf:Property ;
    rdfs:label 'Ferc Schedule Reference' ;
    rdfs:comment 'Reference to the specific FERC Form 1 schedule and line number where balances in this account are reported (e.g., \'Schedule F1-200 Line 10\'). Enables automated mapping of GL balances to FERC regulatory filings.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fieldStatusGroup rdf:type rdf:Property ;
    rdfs:label 'Field Status Group' ;
    rdfs:comment 'SAP FI/CO field status group (field FSTAG) assigned to this account, controlling which fields are required, optional, or suppressed during journal entry posting. Ensures data completeness for cost center, profit center, and project assignments on regulated utility accounts.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:functionalAreaRelevant rdf:type rdf:Property ;
    rdfs:label 'Functional Area Relevant' ;
    rdfs:comment 'Indicates whether postings to this account require a functional area assignment in SAP FI/CO for cost-of-function reporting. Supports FERC Form 1 functional classification between production, transmission, distribution, and customer service.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:functionalClass rdf:type rdf:Property ;
    rdfs:label 'Functional Class' ;
    rdfs:comment 'FERC USoA functional classification indicating the utility service function to which the account relates. Drives cost-of-service allocation between electric and gas operations for rate case filings and FERC Form 1 reporting. [ENUM-REF-CANDIDATE: electric_plant|gas_plant|common_plant|general_plant|other — promote to reference product]' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:glAccountLongDescription rdf:type rdf:Property ;
    rdfs:label 'Gl Account Long Description' ;
    rdfs:comment 'Extended narrative description of the general ledger account purpose, scope, and allowable posting types. Supports regulatory filings, auditor inquiries, and rate case cost-of-service documentation.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:glAccountName rdf:type rdf:Property ;
    rdfs:label 'Gl Account Name' ;
    rdfs:comment 'Short descriptive name of the general ledger account as maintained in SAP FI/CO (field TXTKS/TXT50). Used as the human-readable identity label displayed in financial reports, trial balances, and rate case filings.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:glAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Gl Account Number' ;
    rdfs:comment 'The externally-known alphanumeric code uniquely identifying the general ledger account within the SAP FI/CO chart of accounts. Used as the primary business identifier for financial postings, rate case cost-of-service studies, and FERC Form 1 reporting. Typically a 6- to 10-digit numeric string aligned with the FERC Uniform System of Accounts numbering convention.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:houseBankRelevant rdf:type rdf:Property ;
    rdfs:label 'House Bank Relevant' ;
    rdfs:comment 'Indicates whether this GL account is a bank account managed through SAP FI house bank configuration. When True, the account is linked to a physical bank account for cash management, treasury operations, and bank reconciliation.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastChangedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Changed Timestamp' ;
    rdfs:comment 'Timestamp of the most recent modification to this chart of accounts master record in SAP FI/CO (fields LAEDA/LAEDT). Supports change management auditing, SOX compliance, and incremental data loading in the Databricks Silver layer.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lineItemDisplay rdf:type rdf:Property ;
    rdfs:label 'Line Item Display' ;
    rdfs:comment 'SAP FI/CO indicator (field XKRES) specifying whether individual line items are stored and displayed for this account. When True, individual journal entry line items are retained for audit trail and detailed account analysis. Required for reconciliation accounts and high-value utility plant accounts.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:normalBalance rdf:type rdf:Property ;
    rdfs:label 'Normal Balance' ;
    rdfs:comment 'Indicates whether the account normally carries a debit or credit balance per double-entry bookkeeping conventions. Used by SAP FI/CO to validate postings and by financial reporting to detect sign anomalies.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:omCategory rdf:type rdf:Property ;
    rdfs:label 'Om Category' ;
    rdfs:comment 'Sub-classification of expense accounts into Operations, Maintenance, or Administrative and General (A&G) per FERC USoA conventions. Used in O&M cost tracking, rate case testimony, and EBITDA reporting.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:openItemManagement rdf:type rdf:Property ;
    rdfs:label 'Open Item Management' ;
    rdfs:comment 'SAP FI/CO indicator (field XOPVW) specifying whether open item management is active for this account. When True, individual postings remain open until cleared by a matching offsetting entry. Used for clearing accounts, suspense accounts, and intercompany accounts.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:plantFunction rdf:type rdf:Property ;
    rdfs:label 'Plant Function' ;
    rdfs:comment 'FERC USoA plant function sub-classification for utility plant accounts (e.g., Steam Production, Nuclear Production, Transmission, Distribution, General). Used in rate base (RAB) calculations and depreciation studies. [ENUM-REF-CANDIDATE: steam_production|nuclear_production|hydraulic_production|other_production|transmission|distribution|general — promote to reference product]' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postingBlocked rdf:type rdf:Property ;
    rdfs:label 'Posting Blocked' ;
    rdfs:comment 'Flag indicating whether direct financial postings to this account are currently blocked in SAP FI/CO (field XSPEB). When True, the account cannot receive new journal entries until unblocked by an authorized finance administrator.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:profitCenterRelevant rdf:type rdf:Property ;
    rdfs:label 'Profit Center Relevant' ;
    rdfs:comment 'Indicates whether postings to this account require a profit center assignment in SAP CO. When True, all journal entries must carry a profit center, enabling segment-level P&L reporting for electric vs. gas operations and regulatory ring-fencing.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rateCaseInclusionFlag rdf:type rdf:Property ;
    rdfs:label 'Rate Case Inclusion Flag' ;
    rdfs:comment 'Indicates whether balances in this account are included in the cost-of-service study for General Rate Case (GRC) or FERC rate case filings. Accounts flagged True are subject to regulatory scrutiny and must be supported by workpapers.' ;
    rdfs:domain ind:ChartOfAccounts ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reconciliationAccountFlag rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Account Flag' ;
    rdfs:comment 'Indicates whether this GL account is a reconciliation account (subledger control account) in SAP FI/CO. Reconciliation accounts aggregate balances from subledgers (AP, AR, asset accounting) and cannot receive direct manual postings.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reconciliationAccountType rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Account Type' ;
    rdfs:comment 'Specifies the subledger type for reconciliation accounts in SAP FI/CO (field MITKZ): accounts receivable, accounts payable, fixed assets, or not applicable for non-reconciliation accounts. Governs which subledger module posts to this control account.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sortKey rdf:type rdf:Property ;
    rdfs:label 'Sort Key' ;
    rdfs:comment 'SAP FI/CO sort key (field ZUAWA) that determines the assignment field populated in line items for this account, controlling how line items are sorted and displayed in account statements. Common values include 001 (posting date), 012 (document number).' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxCategory rdf:type rdf:Property ;
    rdfs:label 'Tax Category' ;
    rdfs:comment 'SAP FI/CO tax category indicator (field MWSKZ) specifying whether the account is relevant for input tax, output tax, or is tax-exempt. Drives automatic tax determination during financial postings for utility sales tax and use tax compliance. [ENUM-REF-CANDIDATE: input_tax|output_tax|tax_exempt|not_relevant — promote to reference product]' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costAllocationId rdf:type rdf:Property ;
    rdfs:label 'Cost Allocation Id' ;
    rdfs:comment 'Unique surrogate identifier for each SAP CO cost allocation or assessment cycle record in the Silver Layer lakehouse. Primary key for this data product.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primarySenderCostCenterId rdf:type rdf:Property ;
    rdfs:label 'Primary Sender Cost Center Id' ;
    rdfs:comment 'Surrogate identifier referencing the cost center from which costs are being distributed (the sender/source in the SAP CO allocation). Typically represents corporate overhead, shared services, or common plant cost centers.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CostCenter .

ind:allocatedAmount rdf:type rdf:Property ;
    rdfs:label 'Allocated Amount' ;
    rdfs:comment 'The gross monetary amount of cost allocated from the sender to the receiver in the company code currency. This is the primary financial fact of the allocation record, used in cost-of-service studies, CAPEX/OPEX tracking, and FERC Form 1 reporting.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allocatedAmountUsd rdf:type rdf:Property ;
    rdfs:label 'Allocated Amount Usd' ;
    rdfs:comment 'The allocated cost amount translated to US Dollars (USD) using the exchange rate applicable at the time of posting. Enables consistent cross-currency financial reporting and FERC Form 1 submissions which require USD denomination.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allocationBasisType rdf:type rdf:Property ;
    rdfs:label 'Allocation Basis Type' ;
    rdfs:comment 'The method or driver used to determine the proportion of costs allocated to each receiver. Common bases include statistical key figures (e.g., kWh consumed), headcount, square footage, revenue, direct cost ratios, or fixed percentages. Critical for rate case cost-of-service justification. [ENUM-REF-CANDIDATE: statistical_key_figure|headcount|square_footage|revenue|direct_cost|fixed_percentage|machine_hours|mwh_generated — promote to reference product]' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationBasisValue rdf:type rdf:Property ;
    rdfs:label 'Allocation Basis Value' ;
    rdfs:comment 'The numeric value of the allocation driver/basis for this receiver (e.g., 1,500 kWh, 45 headcount, 2,000 square feet). Used to verify the proportional split of costs and to support rate case cost-of-service documentation.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allocationDocNumber rdf:type rdf:Property ;
    rdfs:label 'Allocation Doc Number' ;
    rdfs:comment 'The externally-known SAP CO document number uniquely identifying the allocation posting (e.g., assessment cycle run document). Serves as the business identifier traceable back to the source system.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationNotes rdf:type rdf:Property ;
    rdfs:label 'Allocation Notes' ;
    rdfs:comment 'Free-text notes or comments entered by the cost accountant or financial analyst describing the rationale for the allocation, any manual adjustments, or regulatory compliance notes. Supports audit and rate case documentation.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationPercentage rdf:type rdf:Property ;
    rdfs:label 'Allocation Percentage' ;
    rdfs:comment 'The percentage of the sender cost center\'s total cost allocated to this specific receiver, expressed as a decimal (e.g., 0.125000 = 12.5%). Derived from the allocation basis but stored for audit and rate case transparency.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allocationRunTimestamp rdf:type rdf:Property ;
    rdfs:label 'Allocation Run Timestamp' ;
    rdfs:comment 'The date and time when the SAP CO assessment or distribution cycle was executed to generate this allocation record. Distinguishes between multiple runs of the same cycle within a period (e.g., preliminary vs. final close runs).' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:allocationStatus rdf:type rdf:Property ;
    rdfs:label 'Allocation Status' ;
    rdfs:comment 'Current lifecycle status of the allocation record. \'posted\' indicates the allocation has been finalized in SAP CO; \'reversed\' indicates a reversal document exists; \'simulated\' indicates a test run not yet posted; \'blocked\' indicates held for review; \'error\' indicates a processing failure.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationType rdf:type rdf:Property ;
    rdfs:label 'Allocation Type' ;
    rdfs:comment 'Classification of the SAP CO allocation method used: assessment (allocates cost using statistical key figures), distribution (reallocates primary costs), indirect activity allocation, manual reposting, or settlement from internal orders/WBS elements.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessAreaCode rdf:type rdf:Property ;
    rdfs:label 'Business Area Code' ;
    rdfs:comment 'SAP FI business area code representing the organizational segment (e.g., Electric Distribution, Gas Transmission, Corporate) to which the allocated cost belongs. Supports multi-jurisdictional cost separation required by state PUC filings.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capexOpexIndicator rdf:type rdf:Property ;
    rdfs:label 'Capex Opex Indicator' ;
    rdfs:comment 'Indicates whether the allocated cost is classified as Capital Expenditure (CAPEX) or Operating Expenditure (OPEX). Critical for regulatory asset base (RAB) valuation, rate case cost-of-service studies, and FERC Form 1 reporting under FASB ASC 980.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:controllingAreaCode rdf:type rdf:Property ;
    rdfs:label 'Controlling Area Code' ;
    rdfs:comment 'SAP CO controlling area code that defines the organizational scope of cost management. A single controlling area may span multiple company codes in a utility holding company structure.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costElementCode rdf:type rdf:Property ;
    rdfs:label 'Cost Element Code' ;
    rdfs:comment 'SAP CO cost element code representing the nature of the cost being allocated (e.g., labor, depreciation, overhead). Maps to the GL account in SAP FI and is used for cost-of-service studies in rate cases.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costElementName rdf:type rdf:Property ;
    rdfs:label 'Cost Element Name' ;
    rdfs:comment 'Human-readable description of the SAP CO cost element (e.g., \'Salaries and Wages\', \'IT Infrastructure Depreciation\', \'Fleet O&M\'). Supports self-service reporting without requiring a join.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentDate rdf:type rdf:Property ;
    rdfs:label 'Document Date' ;
    rdfs:comment 'The date of the originating allocation document as recorded in SAP CO. May differ from posting_date when allocations are backdated or adjusted for prior periods.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:glAccountCode rdf:type rdf:Property ;
    rdfs:label 'Gl Account Code' ;
    rdfs:comment 'The SAP FI general ledger account code to which the allocated cost is posted. Aligns with the FERC Uniform System of Accounts (e.g., Account 920 for administrative and general salaries, Account 921 for office supplies). Critical for FERC Form 1 reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdictionCode rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Code' ;
    rdfs:comment 'Code identifying the regulatory jurisdiction (e.g., state abbreviation or FERC) to which the allocated cost is attributable. Critical for multi-jurisdictional utilities to separate costs for individual state PUC rate cases and FERC wholesale rate filings.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receiverProfitCenterCode rdf:type rdf:Property ;
    rdfs:label 'Receiver Profit Center Code' ;
    rdfs:comment 'SAP CO profit center code receiving the allocated costs when receiver_type is \'profit_center\'. Used for segment-level profitability reporting and inter-company allocations in multi-jurisdictional utility structures.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receiverType rdf:type rdf:Property ;
    rdfs:label 'Receiver Type' ;
    rdfs:comment 'Discriminator indicating the type of SAP CO object receiving the allocated costs: cost_center (another cost center), profit_center (a profit center for segment reporting), wbs_element (a capital project WBS element for CAPEX tracking), or internal_order.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receiverWbsElementCode rdf:type rdf:Property ;
    rdfs:label 'Receiver Wbs Element Code' ;
    rdfs:comment 'SAP PS Work Breakdown Structure (WBS) element code receiving allocated costs when receiver_type is \'wbs_element\'. Used for CAPEX project cost tracking, regulatory asset base (RAB) valuation, and CPCN project accounting.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reversalDate rdf:type rdf:Property ;
    rdfs:label 'Reversal Date' ;
    rdfs:comment 'The date on which the reversal of this allocation was posted in SAP CO. Null when no reversal exists. Used for period-end close reconciliation and audit trail.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reversalDocNumber rdf:type rdf:Property ;
    rdfs:label 'Reversal Doc Number' ;
    rdfs:comment 'SAP CO document number of the reversal posting if this allocation has been reversed. Null when no reversal exists. Used for audit trail and period-end reconciliation.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:runType rdf:type rdf:Property ;
    rdfs:label 'Run Type' ;
    rdfs:comment 'Indicates whether the allocation was executed against actual costs, planned/budget costs, or as a simulation. \'actual\' postings feed financial statements; \'plan\' allocations support budgeting and CAPEX/OPEX planning; \'simulation\' records are not posted to the ledger.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:senderTotalCost rdf:type rdf:Property ;
    rdfs:label 'Sender Total Cost' ;
    rdfs:comment 'The total cost balance of the sender cost center prior to allocation for the fiscal period. Used to verify that the sum of all allocated_amount values equals the sender\'s total cost, ensuring full cost recovery in the allocation cycle.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:utilityFunction rdf:type rdf:Property ;
    rdfs:label 'Utility Function' ;
    rdfs:comment 'Classifies the allocated cost by utility function per FERC Uniform System of Accounts: generation, transmission, distribution, gas distribution, common (shared across functions), or corporate. Directly supports cost-of-service studies and rate case filings.' ;
    rdfs:domain ind:CostAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:activityTypeCode rdf:type rdf:Property ;
    rdfs:label 'Activity Type Code' ;
    rdfs:comment 'SAP CO activity type code associated with this cost center, defining the type of work or service output (e.g., labor hours, machine hours, kWh produced). Activity types are used to calculate activity prices and allocate costs to cost objects such as maintenance orders and capital projects.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationBasis rdf:type rdf:Property ;
    rdfs:label 'Allocation Basis' ;
    rdfs:comment 'The statistical or activity-based basis used to allocate costs from this cost center (e.g., headcount, floor area, kWh consumed, labor hours). Used in overhead cost allocation cycles and cost-of-service studies to distribute shared costs equitably across cost objects and customer classes.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:annualOpexBudget rdf:type rdf:Property ;
    rdfs:label 'Annual Opex Budget' ;
    rdfs:comment 'Approved annual OPEX budget amount for this cost center in the controlling currency. Represents the authorized spending limit for operations and maintenance activities. Used in budget variance analysis, rate case cost-of-service studies, and EBITDA reporting.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:budgetFiscalYear rdf:type rdf:Property ;
    rdfs:label 'Budget Fiscal Year' ;
    rdfs:comment 'The fiscal year (four-digit integer, e.g., 2025) to which the annual OPEX budget applies. Aligns with the utility\'s regulatory fiscal year for rate case filings and FERC Form 1 annual reporting.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:costCenterCategory rdf:type rdf:Property ;
    rdfs:label 'Cost Center Category' ;
    rdfs:comment 'SAP CO cost center category code that controls which activity types and statistical key figures can be posted. Common utility categories include E (Energy/Production), F (Field Operations), G (General Administration), V (Service/Overhead). Drives cost allocation rules and activity rate calculations. [ENUM-REF-CANDIDATE: E|F|G|V|P|I|H|D — promote to reference product]' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costCenterDescription rdf:type rdf:Property ;
    rdfs:label 'Cost Center Description' ;
    rdfs:comment 'Long-form textual description of the cost center\'s purpose, scope, and organizational context. Provides additional detail beyond the short name for use in financial reports, rate case documentation, and audit support.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costCenterName rdf:type rdf:Property ;
    rdfs:label 'Cost Center Name' ;
    rdfs:comment 'Human-readable descriptive name of the cost center (e.g., \'Transmission District 3 Operations\', \'Nuclear Generation Plant A\', \'Storm Restoration Pool\'). Used in financial reports, budget presentations, and rate case filings.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costCenterStatus rdf:type rdf:Property ;
    rdfs:label 'Cost Center Status' ;
    rdfs:comment 'Current lifecycle status of the cost center. \'active\' indicates the cost center is open for postings; \'locked\' prevents new postings while retaining history; \'closed\' indicates the cost center has been decommissioned. Controls whether financial transactions can be posted against this cost center in SAP CO.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costCenterType rdf:type rdf:Property ;
    rdfs:label 'Cost Center Type' ;
    rdfs:comment 'Classifies whether this record represents a permanent cost center (e.g., generation plant, T&D district, corporate function) or a temporary cost collector such as an internal order for maintenance jobs, storm restoration events, or overhead pools. Drives allocation logic and reporting treatment. [ENUM-REF-CANDIDATE: permanent|internal_order|overhead_pool|storm_restoration|project_collector — promote to reference product]' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:groupCode rdf:type rdf:Property ;
    rdfs:label 'Group Code' ;
    rdfs:comment 'Code identifying the cost center group (hierarchy node) to which this cost center belongs in the SAP CO standard hierarchy. Supports hierarchical OPEX reporting, departmental budgeting roll-ups, and organizational cost aggregation for rate case filings.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isCapitalProject rdf:type rdf:Property ;
    rdfs:label 'Is Capital Project' ;
    rdfs:comment 'Indicates whether this cost center (or internal order) is used as a capital project cost collector for CAPEX tracking. When True, costs are subject to capitalization rules under FASB ASC 360 and are tracked for inclusion in the Regulatory Asset Base (RAB) for rate case filings.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRegulatoryAsset rdf:type rdf:Property ;
    rdfs:label 'Is Regulatory Asset' ;
    rdfs:comment 'Indicates whether costs accumulated in this cost center qualify as a regulatory asset under FASB ASC 980 (Regulated Operations). When True, deferred costs are expected to be recovered through future rate cases and are tracked for RAB valuation and ROE calculations.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isStormRestoration rdf:type rdf:Property ;
    rdfs:label 'Is Storm Restoration' ;
    rdfs:comment 'Indicates whether this cost center is designated for storm restoration cost capture. When True, costs posted here are tracked separately for regulatory recovery filings with state PUCs, FEMA reimbursement claims, and storm cost deferral accounting under FASB ASC 980.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lockIndicator rdf:type rdf:Property ;
    rdfs:label 'Lock Indicator' ;
    rdfs:comment 'SAP CO lock indicator controlling which types of postings are permitted. \'locked_actual\' prevents actual cost postings; \'locked_plan\' prevents planning entries; \'locked_all\' blocks all postings. Used during period-end close, audits, and cost center decommissioning.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overheadRate rdf:type rdf:Property ;
    rdfs:label 'Overhead Rate' ;
    rdfs:comment 'Overhead allocation rate applied to this cost center, expressed as a percentage or fixed amount per activity unit. Used in SAP CO overhead costing sheets to allocate indirect costs (e.g., administrative overhead, facilities costs) to production orders, maintenance orders, and capital projects.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overheadRateType rdf:type rdf:Property ;
    rdfs:label 'Overhead Rate Type' ;
    rdfs:comment 'Specifies whether the overhead rate is applied as a percentage of direct costs, a fixed monetary amount, or an activity-based rate per unit of activity (e.g., per labor hour, per kWh generated). Determines the overhead calculation method in SAP CO.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentCostCenterCode rdf:type rdf:Property ;
    rdfs:label 'Parent Cost Center Code' ;
    rdfs:comment 'Code of the parent cost center in the organizational hierarchy, enabling hierarchical cost roll-up reporting. Supports the construction of cost center trees for budget consolidation, OPEX allocation, and management reporting.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateCaseClassification rdf:type rdf:Property ;
    rdfs:label 'Rate Case Classification' ;
    rdfs:comment 'Functional classification of this cost center for rate case cost-of-service studies filed with state PUCs or FERC. Determines how costs are allocated across customer classes and rate schedules. Aligns with FERC Uniform System of Accounts functional categories. [ENUM-REF-CANDIDATE: generation|transmission|distribution|gas_distribution|customer_service|administrative|common — promote to reference product]' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shortName rdf:type rdf:Property ;
    rdfs:label 'Short Name' ;
    rdfs:comment 'Abbreviated name of the cost center used in SAP CO reports, budget line items, and dashboard displays where space is constrained. Typically up to 20 characters per SAP standard.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:utilitySegment rdf:type rdf:Property ;
    rdfs:label 'Utility Segment' ;
    rdfs:comment 'Identifies whether this cost center belongs to the electric utility segment, gas utility segment, common/shared services, or other. Critical for regulatory cost separation, rate case cost-of-service studies, and FERC jurisdictional reporting. Drives allocation of shared costs between electric and gas rate bases.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workCenterCode rdf:type rdf:Property ;
    rdfs:label 'Work Center Code' ;
    rdfs:comment 'SAP Work Center code linked to this cost center for activity-based costing. Work centers define the capacity and activity rates used to allocate labor and equipment costs to maintenance orders, production orders, and internal orders. Critical for O&M cost tracking.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validFrom rdf:type rdf:Property ;
    rdfs:label 'Valid From' ;
    rdfs:comment 'The date from which this cost center is valid and open for financial postings in SAP CO. Defines the start of the cost center\'s active period. Used to enforce time-dependent master data validity and support historical cost reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:validTo rdf:type rdf:Property ;
    rdfs:label 'Valid To' ;
    rdfs:comment 'The date until which this cost center is valid for financial postings in SAP CO. A far-future date (e.g., 9999-12-31) indicates an open-ended cost center. When set to a past date, the cost center is effectively closed for new postings.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:depreciationRunId rdf:type rdf:Property ;
    rdfs:label 'Depreciation Run Id' ;
    rdfs:comment 'Unique surrogate identifier for each depreciation run record in the SAP FI-AA periodic depreciation calculation. Serves as the primary key for this data product.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assetId rdf:type rdf:Property ;
    rdfs:label 'Asset Id' ;
    rdfs:comment 'Reference to the fixed asset record in SAP FI-AA for which depreciation is being calculated. Links to the asset master data including asset class, useful life, and acquisition value.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:UtilityCompany .

ind:depreciationAreaId rdf:type rdf:Property ;
    rdfs:label 'Depreciation Area Id' ;
    rdfs:comment 'Reference to the depreciation area definition record. SAP FI-AA supports multiple parallel depreciation areas (e.g., book/GAAP, tax, regulatory/FERC) for the same asset.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DepreciationArea .

ind:accumulatedDepreciationAmount rdf:type rdf:Property ;
    rdfs:label 'Accumulated Depreciation Amount' ;
    rdfs:comment 'Total accumulated depreciation for the asset in the specified depreciation area as of the end of the fiscal period, including all prior period depreciation plus the current period posted amount. Key metric for FERC Form 1 balance sheet reporting and RAB valuation.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:acquisitionValueAmount rdf:type rdf:Property ;
    rdfs:label 'Acquisition Value Amount' ;
    rdfs:comment 'Original acquisition cost (gross plant value) of the asset in the specified depreciation area as of the depreciation run date. Serves as the depreciable base for depreciation calculations and FERC Form 1 plant-in-service reporting.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assetNumber rdf:type rdf:Property ;
    rdfs:label 'Asset Number' ;
    rdfs:comment 'The SAP FI-AA asset number (main asset number) identifying the specific fixed asset. Used as the externally visible business identifier for cross-referencing with Maximo EAM and FERC plant account schedules.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetSubnumber rdf:type rdf:Property ;
    rdfs:label 'Asset Subnumber' ;
    rdfs:comment 'SAP FI-AA asset sub-number identifying a component or sub-asset within the main asset record. Supports component-level depreciation tracking for complex utility infrastructure assets.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deferredTaxAmount rdf:type rdf:Property ;
    rdfs:label 'Deferred Tax Amount' ;
    rdfs:comment 'Deferred income tax amount arising from the temporary difference between book depreciation and tax depreciation for the period. Calculated as the difference between tax and book depreciation multiplied by the applicable tax rate. Required for FASB ASC 740 and FERC Form 1 deferred tax reporting.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depreciationAreaCode rdf:type rdf:Property ;
    rdfs:label 'Depreciation Area Code' ;
    rdfs:comment 'SAP FI-AA depreciation area code identifying the valuation basis for this depreciation calculation. Common utility values include \'01\' (book/GAAP), \'10\' (federal tax/MACRS), \'15\' (state tax), \'20\' (regulatory/FERC), \'30\' (cost-of-service/rate case). [ENUM-REF-CANDIDATE: 01|10|15|20|30|31|40 — promote to reference product]' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depreciationAreaType rdf:type rdf:Property ;
    rdfs:label 'Depreciation Area Type' ;
    rdfs:comment 'Business classification of the depreciation area indicating the accounting basis. \'book\' is GAAP/FASB basis; \'tax_federal\' is IRS MACRS basis; \'tax_state\' is state tax basis; \'regulatory\' is FERC/PUC regulatory basis per ASC 980; \'cost_of_service\' is rate case study basis.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depreciationEndDate rdf:type rdf:Property ;
    rdfs:label 'Depreciation End Date' ;
    rdfs:comment 'The planned end date of depreciation for the asset, representing the date when the asset will be fully depreciated based on its useful life and depreciation start date. Used for asset retirement planning and long-range financial forecasting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:depreciationMethodCode rdf:type rdf:Property ;
    rdfs:label 'Depreciation Method Code' ;
    rdfs:comment 'SAP FI-AA depreciation key/method code defining the calculation algorithm applied (e.g., LINA for straight-line, DEGD for declining balance, MACS for MACRS, REGU for regulatory straight-line). Determines how the depreciable base is allocated over the asset useful life.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depreciationMethodName rdf:type rdf:Property ;
    rdfs:label 'Depreciation Method Name' ;
    rdfs:comment 'Human-readable name of the depreciation method applied in this run (e.g., \'Straight-Line\', \'Declining Balance\', \'MACRS 5-Year\', \'Regulatory Straight-Line\', \'Sum-of-Years-Digits\'). Supports rate case documentation and FERC Form 1 narrative disclosures.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depreciationStartDate rdf:type rdf:Property ;
    rdfs:label 'Depreciation Start Date' ;
    rdfs:comment 'The date on which depreciation commenced for the asset in the specified depreciation area. Typically the asset capitalization date or in-service date. Critical for calculating elapsed depreciation and verifying compliance with FERC capitalization policies.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:errorMessage rdf:type rdf:Property ;
    rdfs:label 'Error Message' ;
    rdfs:comment 'System-generated error or warning message from SAP FI-AA when the depreciation run encounters processing issues. Populated only when run_status is \'error\'. Used for operational troubleshooting and period-close exception management.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:executionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Execution Timestamp' ;
    rdfs:comment 'The date and time when the depreciation run was initiated and executed in SAP FI-AA. This is the principal business event timestamp representing when the periodic depreciation calculation was performed.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:isCatchUpRun rdf:type rdf:Property ;
    rdfs:label 'Is Catch Up Run' ;
    rdfs:comment 'Indicates whether this run includes catch-up depreciation for prior periods that were not previously posted (True). Catch-up runs occur when assets are capitalized retroactively or when depreciation parameters are corrected, requiring prior-period adjustments per FASB ASC 250.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isTestRun rdf:type rdf:Property ;
    rdfs:label 'Is Test Run' ;
    rdfs:comment 'Indicates whether this depreciation run was executed in simulation/test mode (True) without posting to the general ledger, or as a live posting run (False). Test runs are used for period-close validation and rate case depreciation projections.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:netBookValueAmount rdf:type rdf:Property ;
    rdfs:label 'Net Book Value Amount' ;
    rdfs:comment 'Net book value of the asset as of the end of the fiscal period, calculated as acquisition cost less accumulated depreciation in the specified depreciation area. Used for RAB valuation, rate case cost-of-service studies, and balance sheet reporting.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:plannedDepreciationAmount rdf:type rdf:Property ;
    rdfs:label 'Planned Depreciation Amount' ;
    rdfs:comment 'The calculated planned depreciation amount for the asset in the specified fiscal period and depreciation area, expressed in the company currency. Represents the depreciation expense as computed by the SAP FI-AA depreciation engine before posting.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:postedDepreciationAmount rdf:type rdf:Property ;
    rdfs:label 'Posted Depreciation Amount' ;
    rdfs:comment 'The actual depreciation amount posted to the general ledger for the asset in the fiscal period. May differ from planned amount due to manual adjustments, partial period calculations, or catch-up depreciation. Core field for FERC Form 1 accumulated depreciation reporting.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryDepreciationRate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Depreciation Rate' ;
    rdfs:comment 'The PUC/FERC-approved annual depreciation rate applied to the asset for regulatory cost-of-service purposes, expressed as a decimal (e.g., 0.033333 for 3.33% straight-line over 30 years). Used in rate case depreciation expense justification and FERC Form 1 reporting.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reversalDocumentNumber rdf:type rdf:Property ;
    rdfs:label 'Reversal Document Number' ;
    rdfs:comment 'SAP FI accounting document number of the reversal entry if this depreciation run has been reversed. Populated only when run_status is \'reversed\'. Provides the audit trail for depreciation corrections and period-close adjustments.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:runNumber rdf:type rdf:Property ;
    rdfs:label 'Run Number' ;
    rdfs:comment 'SAP FI-AA externally visible run identifier assigned by the system when the depreciation posting run is executed (e.g., DEPR-2024-001). Used as the business-facing reference number for audit trails and rate case documentation.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:runStatus rdf:type rdf:Property ;
    rdfs:label 'Run Status' ;
    rdfs:comment 'Current lifecycle status of the depreciation run. \'planned\' indicates scheduled but not yet executed; \'test\' indicates a simulation run without posting; \'posted\' indicates depreciation amounts have been posted to the general ledger; \'reversed\' indicates the run has been reversed; \'error\' indicates the run failed during processing.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salvageValueAmount rdf:type rdf:Property ;
    rdfs:label 'Salvage Value Amount' ;
    rdfs:comment 'Estimated residual/salvage value of the asset at the end of its useful life, used to reduce the depreciable base. Relevant for regulatory depreciation studies and rate case justification of depreciation rates.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unplannedDepreciationAmount rdf:type rdf:Property ;
    rdfs:label 'Unplanned Depreciation Amount' ;
    rdfs:comment 'Additional unplanned (extraordinary) depreciation amount posted outside the standard periodic run, such as impairment write-downs, accelerated depreciation for regulatory purposes, or asset retirement adjustments per FASB ASC 410.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:wbsElementCode rdf:type rdf:Property ;
    rdfs:label 'Wbs Element Code' ;
    rdfs:comment 'SAP PS Work Breakdown Structure element code linking the depreciation to a capital project. Supports CAPEX tracking and project-level depreciation analysis for infrastructure investment programs.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:financeCapexProjectId rdf:type rdf:Property ;
    rdfs:label 'Finance Capex Project Id' ;
    rdfs:comment 'Unique surrogate identifier for the capital expenditure project record in the finance lakehouse. Primary key for this entity.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinanceCapexProject .

ind:actualSpendAmount rdf:type rdf:Property ;
    rdfs:label 'Actual Spend Amount' ;
    rdfs:comment 'Cumulative actual costs incurred and posted to the project to date, in USD. Sourced from SAP PS actual cost postings (COSP). Used for budget variance analysis and FERC Form 1 CWIP reporting.' ;
    rdfs:domain ind:FinanceCapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:afudcAccrualAmount rdf:type rdf:Property ;
    rdfs:label 'Afudc Accrual Amount' ;
    rdfs:comment 'Cumulative Allowance for Funds Used During Construction (AFUDC) accrued on this project to date, in USD. AFUDC capitalizes the cost of debt and equity financing during the construction period, increasing the project\'s capitalized cost and rate base. Governed by FERC regulations and FASB ASC 980-835.' ;
    rdfs:domain ind:FinanceCapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:afudcRate rdf:type rdf:Property ;
    rdfs:label 'Afudc Rate' ;
    rdfs:comment 'The AFUDC capitalization rate applied to this project, expressed as a decimal (e.g., 0.075000 = 7.5%). Set annually by the utility\'s regulatory accounting team per FERC guidelines and approved in rate cases. Used to calculate AFUDC accruals on CWIP balances.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approvedBudgetAmount rdf:type rdf:Property ;
    rdfs:label 'Approved Budget Amount' ;
    rdfs:comment 'Total authorized CAPEX budget for the project as approved by the capital budgeting committee, in USD. Represents the spending ceiling for the project. Corresponds to SAP IM Appropriation Request approved budget value.' ;
    rdfs:domain ind:FinanceCapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:authorizationDate rdf:type rdf:Property ;
    rdfs:label 'Authorization Date' ;
    rdfs:comment 'Date on which the capital project received formal management or board authorization to proceed. Marks the transition from proposed to authorized status and enables CAPEX commitment in SAP IM.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:authorizationNumber rdf:type rdf:Property ;
    rdfs:label 'Authorization Number' ;
    rdfs:comment 'Formal capital authorization or Appropriation Request (AR) number issued by the capital budgeting committee or board upon project approval. Required for CAPEX commitment and spend initiation in SAP IM.' ;
    rdfs:domain ind:FinanceCapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capitalizationDate rdf:type rdf:Property ;
    rdfs:label 'Capitalization Date' ;
    rdfs:comment 'Date on which project costs were settled from the SAP PS project to fixed assets in SAP Asset Accounting (AA), creating the asset under construction (AuC) or final asset records. May differ from in_service_date due to accounting close cycles.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:capitalizedCostAmount rdf:type rdf:Property ;
    rdfs:label 'Capitalized Cost Amount' ;
    rdfs:comment 'Total cost amount settled and capitalized to fixed assets upon project completion, in USD. Includes all direct project costs plus AFUDC accruals. Represents the initial carrying value of the resulting fixed assets on the balance sheet.' ;
    rdfs:domain ind:FinanceCapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedUsefulLifeYears rdf:type rdf:Property ;
    rdfs:label 'Estimated Useful Life Years' ;
    rdfs:comment 'Estimated useful life of the resulting capital assets in years, used to determine depreciation rates and rate base amortization schedules. Set per FERC depreciation study and state PUC-approved depreciation rates.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:irpProgramCode rdf:type rdf:Property ;
    rdfs:label 'Irp Program Code' ;
    rdfs:comment 'Code linking this capital project to the Integrated Resource Plan (IRP) capital investment program or portfolio under which it was authorized. Enables IRP-level capital tracking and regulatory reporting.' ;
    rdfs:domain ind:FinanceCapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isAfudcEligible rdf:type rdf:Property ;
    rdfs:label 'Is Afudc Eligible' ;
    rdfs:comment 'Indicates whether this project qualifies for AFUDC accrual (True) or not (False). Projects must meet FERC and FASB ASC 980-835 criteria for AFUDC eligibility, typically requiring a construction period exceeding one year and costs above a materiality threshold.' ;
    rdfs:domain ind:FinanceCapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCwipInRateBase rdf:type rdf:Property ;
    rdfs:label 'Is Cwip In Rate Base' ;
    rdfs:comment 'Indicates whether Construction Work in Progress (CWIP) balances for this project are currently included in the utility\'s rate base for rate recovery prior to in-service (True) or not (False). CWIP rate base treatment is jurisdiction-specific and requires PUC approval.' ;
    rdfs:domain ind:FinanceCapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRateBaseEligible rdf:type rdf:Property ;
    rdfs:label 'Is Rate Base Eligible' ;
    rdfs:comment 'Indicates whether the completed project assets are eligible for inclusion in the Regulatory Asset Base (RAB) for rate recovery purposes (True) or not (False). Non-eligible projects include those disallowed by regulators or used for non-regulated activities.' ;
    rdfs:domain ind:FinanceCapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:plannedEndDate rdf:type rdf:Property ;
    rdfs:label 'Planned End Date' ;
    rdfs:comment 'Planned date on which all project work is scheduled to be completed and the asset placed in service. Drives AFUDC accrual period and capitalization timeline. Corresponds to SAP PS Basic Finish Date.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ppaReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Ppa Reference Number' ;
    rdfs:comment 'Reference number of the associated Power Purchase Agreement (PPA) if this capital project is related to a renewable energy or generation procurement contract. Null for projects not associated with a PPA. Links capital investment to contracted energy supply.' ;
    rdfs:domain ind:FinanceCapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorityLevel rdf:type rdf:Property ;
    rdfs:label 'Priority Level' ;
    rdfs:comment 'Business priority classification of the capital project used in IRP capital planning and portfolio management. Critical projects are typically regulatory-mandated or safety-driven; high are strategic; medium are operational improvements; low are discretionary.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectManager rdf:type rdf:Property ;
    rdfs:label 'Project Manager' ;
    rdfs:comment 'Name of the employee designated as the responsible project manager for this capital project. Accountable for schedule, budget, and scope delivery. Sourced from SAP PS Responsible Person field.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectSponsor rdf:type rdf:Property ;
    rdfs:label 'Project Sponsor' ;
    rdfs:comment 'Name of the executive or senior manager sponsoring and accountable for the capital project at the business unit level. Responsible for project authorization and escalation decisions.' ;
    rdfs:domain ind:FinanceCapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recProgramCode rdf:type rdf:Property ;
    rdfs:label 'Rec Program Code' ;
    rdfs:comment 'Code identifying the Renewable Energy Certificate (REC) program associated with this capital project, applicable for renewable generation projects (solar, wind, hydro). Used for REC tracking, compliance reporting, and state renewable portfolio standard (RPS) obligations.' ;
    rdfs:domain ind:FinanceCapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revisedBudgetAmount rdf:type rdf:Property ;
    rdfs:label 'Revised Budget Amount' ;
    rdfs:comment 'Most recent revised total CAPEX budget after approved budget amendments or scope changes, in USD. Null if no revisions have been made. Used to track budget overruns and variance analysis.' ;
    rdfs:domain ind:FinanceCapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:utilityDivision rdf:type rdf:Property ;
    rdfs:label 'Utility Division' ;
    rdfs:comment 'Utility business division responsible for this capital project, used for regulatory cost allocation between electric and gas operations and T&D functional separation in rate cases and FERC Form 1 reporting.' ;
    rdfs:domain ind:FinanceCapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wbsLevel rdf:type rdf:Property ;
    rdfs:label 'Wbs Level' ;
    rdfs:comment 'Numeric level of this record within the WBS hierarchy (e.g., 1 = project root, 2 = phase, 3 = work package, 4 = activity). Enables hierarchical cost roll-up and reporting from activity level to total project level.' ;
    rdfs:domain ind:FinanceCapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:financialStatementId rdf:type rdf:Property ;
    rdfs:label 'Financial Statement Id' ;
    rdfs:comment 'Unique surrogate identifier for each financial statement record in the lakehouse silver layer. Primary key for this entity.' ;
    rdfs:domain ind:FinancialStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:auditorOpinionType rdf:type rdf:Property ;
    rdfs:label 'Auditor Opinion Type' ;
    rdfs:comment 'The type of independent auditor opinion issued on this financial statement: unqualified (clean opinion), qualified (with exceptions), adverse (materially misstated), disclaimer (auditor unable to form opinion), or not_yet_audited (interim statements). Required for SEC annual filings and FERC Form 1.' ;
    rdfs:domain ind:FinancialStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capexAmt rdf:type rdf:Property ;
    rdfs:label 'Capex Amt' ;
    rdfs:comment 'Total capital expenditures for the reporting period as reported in the statement of cash flows (investing activities). Includes additions to utility plant in service, Construction Work in Progress (CWIP), and capital project spending. Critical for CAPEX tracking against approved capital budgets and rate case plant additions.' ;
    rdfs:domain ind:FinancialStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:comparativePeriodFlag rdf:type rdf:Property ;
    rdfs:label 'Comparative Period Flag' ;
    rdfs:comment 'Indicates whether this statement record represents a comparative prior-period presentation (True) or the current reporting period (False). GAAP and FERC require prior-period comparatives in annual filings; this flag enables correct pairing of current and comparative records.' ;
    rdfs:domain ind:FinancialStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consolidationType rdf:type rdf:Property ;
    rdfs:label 'Consolidation Type' ;
    rdfs:comment 'Indicates whether the statement presents consolidated financials (all subsidiaries included with intercompany eliminations), standalone entity financials, combined financials (multiple entities without full consolidation), or a business segment view. Critical for multi-entity utility holding company structures.' ;
    rdfs:domain ind:FinancialStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depreciationAmortizationAmt rdf:type rdf:Property ;
    rdfs:label 'Depreciation Amortization Amt' ;
    rdfs:comment 'Total depreciation and amortization expense for the reporting period as reported on the income statement. Includes depreciation of utility plant in service and amortization of regulatory assets. Critical component of EBITDA calculation and rate case depreciation studies.' ;
    rdfs:domain ind:FinancialStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ebitdaAmt rdf:type rdf:Property ;
    rdfs:label 'Ebitda Amt' ;
    rdfs:comment 'Earnings Before Interest, Taxes, Depreciation, and Amortization (EBITDA) for the reporting period. Derived from operating income plus depreciation and amortization. Key performance metric for management reporting, board presentations, and credit rating agency analysis.' ;
    rdfs:domain ind:FinancialStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fercFormNumber rdf:type rdf:Property ;
    rdfs:label 'Ferc Form Number' ;
    rdfs:comment 'Identifies the FERC annual report form associated with this financial statement filing: Form 1 (major electric utilities), Form 2 (major natural gas companies), Form 3 (non-major natural gas companies), Form 6 (oil pipeline companies), Form 60 (centralized service companies). Null for non-FERC filings.' ;
    rdfs:domain ind:FinancialStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingDate rdf:type rdf:Property ;
    rdfs:label 'Filing Date' ;
    rdfs:comment 'The date on which this financial statement was filed with the applicable regulatory body (FERC, state PUC, or SEC). Used to confirm compliance with statutory filing deadlines (e.g., FERC Form 1 due April 18, SEC Form 10-K due 60/75/90 days after fiscal year end).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:incomeTaxExpenseAmt rdf:type rdf:Property ;
    rdfs:label 'Income Tax Expense Amt' ;
    rdfs:comment 'Total income tax expense (current and deferred) for the reporting period. Includes Accumulated Deferred Income Taxes (ADIT) movements relevant to rate base calculations under FASB ASC 980 regulatory accounting.' ;
    rdfs:domain ind:FinancialStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interestExpenseAmt rdf:type rdf:Property ;
    rdfs:label 'Interest Expense Amt' ;
    rdfs:comment 'Total interest and debt service expense for the reporting period, including interest on long-term debt, short-term borrowings, and Allowance for Funds Used During Construction (AFUDC) offsets. Used in EBITDA reconciliation and Weighted Average Cost of Capital (WACC) calculations.' ;
    rdfs:domain ind:FinancialStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:longTermDebtAmt rdf:type rdf:Property ;
    rdfs:label 'Long Term Debt Amt' ;
    rdfs:comment 'Total long-term debt outstanding as reported on the balance sheet, including first mortgage bonds, senior notes, and other long-term borrowings. Used in capital structure analysis for rate case WACC and debt ratio calculations.' ;
    rdfs:domain ind:FinancialStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netIncomeAmt rdf:type rdf:Property ;
    rdfs:label 'Net Income Amt' ;
    rdfs:comment 'Net income (loss) for the reporting period as reported on the income statement after all revenues, expenses, taxes, and non-operating items. Key metric for board reporting, SEC filings, and ROE calculations in rate case proceedings.' ;
    rdfs:domain ind:FinancialStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:operatingCashFlowAmt rdf:type rdf:Property ;
    rdfs:label 'Operating Cash Flow Amt' ;
    rdfs:comment 'Net cash provided by (used in) operating activities as reported on the statement of cash flows. Reflects the utility\'s ability to generate cash from core operations to fund capital investment and debt service.' ;
    rdfs:domain ind:FinancialStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:periodType rdf:type rdf:Property ;
    rdfs:label 'Period Type' ;
    rdfs:comment 'Specifies the duration and aggregation type of the reporting period covered by this statement. Distinguishes between periodic snapshots (monthly, quarterly, annual) and cumulative views (year-to-date, trailing twelve months) used in management reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preparedBy rdf:type rdf:Property ;
    rdfs:label 'Prepared By' ;
    rdfs:comment 'Name or employee ID of the financial analyst or accountant who prepared this financial statement. Supports audit trail and SOX internal control documentation requirements.' ;
    rdfs:domain ind:FinancialStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateCaseDocketNumber rdf:type rdf:Property ;
    rdfs:label 'Rate Case Docket Number' ;
    rdfs:comment 'The regulatory docket or case number assigned by the PUC or FERC to the rate case proceeding for which this financial statement serves as supporting evidence. Links the financial statement to a specific General Rate Case (GRC) or rate case filing. Null if not associated with a rate case.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryAssetsAmt rdf:type rdf:Property ;
    rdfs:label 'Regulatory Assets Amt' ;
    rdfs:comment 'Total regulatory assets recognized on the balance sheet under FASB ASC 980 rate-regulated accounting. Represents costs deferred for future recovery in rates (e.g., deferred storm costs, pension regulatory assets, unamortized debt issuance costs). Key component of the Regulatory Asset Base (RAB).' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryLiabilitiesAmt rdf:type rdf:Property ;
    rdfs:label 'Regulatory Liabilities Amt' ;
    rdfs:comment 'Total regulatory liabilities recognized on the balance sheet under FASB ASC 980, representing amounts collected in rates that are owed back to customers (e.g., excess deferred income taxes from Tax Cuts and Jobs Act, over-collected fuel costs). Offsets rate base in regulatory proceedings.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reportingBasis rdf:type rdf:Property ;
    rdfs:label 'Reporting Basis' ;
    rdfs:comment 'Indicates the accounting basis under which the statement is prepared. GAAP = U.S. Generally Accepted Accounting Principles; regulatory = rate-regulated basis per FASB ASC 980 (includes regulatory assets/liabilities); IFRS = International Financial Reporting Standards; management = internal management reporting basis. Critical for distinguishing FERC regulatory filings from SEC GAAP filings.' ;
    rdfs:domain ind:FinancialStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingUnit rdf:type rdf:Property ;
    rdfs:label 'Reporting Unit' ;
    rdfs:comment 'Specifies the unit in which monetary amounts are expressed in this statement (e.g., dollars, thousands, millions). FERC Form 1 requires reporting in thousands of dollars; SEC filings may use millions. Prevents misinterpretation of reported figures.' ;
    rdfs:domain ind:FinancialStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:restatementFlag rdf:type rdf:Property ;
    rdfs:label 'Restatement Flag' ;
    rdfs:comment 'Indicates whether this financial statement is a restatement of a previously filed statement (True) due to a material error correction or accounting change. Triggers additional disclosure requirements under FASB ASC 250 and SEC restatement reporting rules.' ;
    rdfs:domain ind:FinancialStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:restatementReason rdf:type rdf:Property ;
    rdfs:label 'Restatement Reason' ;
    rdfs:comment 'Narrative description of the reason for restatement when restatement_flag is True (e.g., correction of regulatory asset classification error, change in depreciation method, prior period adjustment). Required for FASB ASC 250 disclosure and SEC restatement filings. Null when restatement_flag is False.' ;
    rdfs:domain ind:FinancialStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewedBy rdf:type rdf:Property ;
    rdfs:label 'Reviewed By' ;
    rdfs:comment 'Name or employee ID of the controller, CFO, or designated reviewer who reviewed and approved this financial statement. Required for SOX Section 302 CEO/CFO certification and internal control documentation.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sapCompanyCode rdf:type rdf:Property ;
    rdfs:label 'Sap Company Code' ;
    rdfs:comment 'The SAP FI/CO company code corresponding to the legal entity for which this financial statement is prepared. Enables direct traceability from the lakehouse silver layer back to the SAP general ledger source system.' ;
    rdfs:domain ind:FinancialStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statementNumber rdf:type rdf:Property ;
    rdfs:label 'Statement Number' ;
    rdfs:comment 'Externally-known business identifier for the financial statement, typically assigned by the financial reporting system (e.g., SAP FI document number or reporting package reference). Used for traceability across reporting cycles.' ;
    rdfs:domain ind:FinancialStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statementStatus rdf:type rdf:Property ;
    rdfs:label 'Statement Status' ;
    rdfs:comment 'Current lifecycle state of the financial statement. Draft = in preparation; under_review = submitted for internal review; approved = signed off by management/board; filed = submitted to regulatory body (FERC, PUC, SEC); restated = previously filed statement that has been corrected; superseded = replaced by a newer version.' ;
    rdfs:domain ind:FinancialStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statementType rdf:type rdf:Property ;
    rdfs:label 'Statement Type' ;
    rdfs:comment 'Classifies the financial statement as one of the four primary financial statement types: balance sheet (statement of financial position), income statement (statement of operations), statement of cash flows, or statement of changes in equity. Drives downstream report formatting and validation rules.' ;
    rdfs:domain ind:FinancialStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalAssetsAmt rdf:type rdf:Property ;
    rdfs:label 'Total Assets Amt' ;
    rdfs:comment 'Total assets as reported on the balance sheet for this entity and period. Represents the sum of all utility plant (net), current assets, regulatory assets, and other assets. Key metric for Regulatory Asset Base (RAB) valuation and rate case filings.' ;
    rdfs:domain ind:FinancialStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalEquityAmt rdf:type rdf:Property ;
    rdfs:label 'Total Equity Amt' ;
    rdfs:comment 'Total shareholders equity (common equity plus preferred equity) as reported on the balance sheet. Used in Return on Equity (ROE) calculations for rate case filings and board financial reporting.' ;
    rdfs:domain ind:FinancialStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalLiabilitiesAmt rdf:type rdf:Property ;
    rdfs:label 'Total Liabilities Amt' ;
    rdfs:comment 'Total liabilities as reported on the balance sheet, including long-term debt, current liabilities, regulatory liabilities, deferred income taxes (ADIT), and other obligations. Used in capital structure analysis for rate case ROE and WACC calculations.' ;
    rdfs:domain ind:FinancialStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalOpexAmt rdf:type rdf:Property ;
    rdfs:label 'Total Opex Amt' ;
    rdfs:comment 'Total operating and maintenance (O&M) expenses as reported on the income statement, including fuel costs, purchased power, transmission, distribution, customer service, and administrative expenses. Key input for OPEX tracking and rate case cost-of-service studies.' ;
    rdfs:domain ind:FinancialStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalRevenueAmt rdf:type rdf:Property ;
    rdfs:label 'Total Revenue Amt' ;
    rdfs:comment 'Total operating revenues as reported on the income statement, including electric revenues, gas revenues, and other operating revenues. Primary top-line metric for EBITDA reporting, rate case revenue requirement studies, and FERC Form 1 Schedule of Revenues.' ;
    rdfs:domain ind:FinancialStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:utilityPlantNetAmt rdf:type rdf:Property ;
    rdfs:label 'Utility Plant Net Amt' ;
    rdfs:comment 'Net utility plant in service (gross plant less accumulated depreciation) as reported on the balance sheet. The largest asset category for a regulated utility and the primary driver of the Regulatory Asset Base (RAB) and rate base calculations.' ;
    rdfs:domain ind:FinancialStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:utilityType rdf:type rdf:Property ;
    rdfs:label 'Utility Type' ;
    rdfs:comment 'Identifies the utility service type covered by this financial statement: electric, gas, combined electric and gas, or other. Supports FERC Form 1 (electric) vs. FERC Form 2 (gas) filing segregation and state PUC rate case cost-of-service studies by utility segment.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acquisitionDate rdf:type rdf:Property ;
    rdfs:label 'Acquisition Date' ;
    rdfs:comment 'Date the asset was acquired or purchased, which may differ from the in-service date for assets requiring installation or construction. Used for asset age analysis and procurement tracking.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assetDescription rdf:type rdf:Property ;
    rdfs:label 'Asset Description' ;
    rdfs:comment 'Short descriptive name of the fixed asset as recorded in the asset master (e.g., \'138kV Transmission Line Segment\', \'Gas Distribution Main 4-inch PE\', \'500MW Steam Turbine Unit 3\'). Used in financial reports and rate case exhibits.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetLongDescription rdf:type rdf:Property ;
    rdfs:label 'Asset Long Description' ;
    rdfs:comment 'Extended narrative description of the fixed asset providing additional technical and location context beyond the short description. Supports regulatory filings and depreciation study documentation.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetRetirementObligation rdf:type rdf:Property ;
    rdfs:label 'Asset Retirement Obligation' ;
    rdfs:comment 'Present value of the legal obligation to retire the asset at end of useful life (e.g., nuclear decommissioning, PCB-contaminated equipment disposal, gas pipeline abandonment). Recorded as a liability under FASB ASC 410-20. Expressed in USD.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bonusDepreciationTaken rdf:type rdf:Property ;
    rdfs:label 'Bonus Depreciation Taken' ;
    rdfs:comment 'Indicates whether federal bonus depreciation (100% first-year expensing under Tax Cuts and Jobs Act or prior bonus depreciation provisions) was claimed for this asset. Affects deferred tax calculations and normalization requirements under FASB ASC 980-740 for regulated utilities.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bookDepreciationMethod rdf:type rdf:Property ;
    rdfs:label 'Book Depreciation Method' ;
    rdfs:comment 'Depreciation method applied for GAAP (book) financial reporting purposes. Regulated utilities predominantly use straight-line or group straight-line methods as approved by the PUC in depreciation studies. Corresponds to SAP FI-AA depreciation key for depreciation area 01.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bookDepreciationRate rdf:type rdf:Property ;
    rdfs:label 'Book Depreciation Rate' ;
    rdfs:comment 'Annual depreciation rate applied for GAAP book purposes, expressed as a decimal (e.g., 0.025000 = 2.5% per year). Derived from useful life and net salvage percentage. Used to compute annual book depreciation expense.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capitalizedInterest rdf:type rdf:Property ;
    rdfs:label 'Capitalized Interest' ;
    rdfs:comment 'Allowance for Funds Used During Construction (AFUDC) or capitalized interest included in the original cost of the asset. For regulated utilities, AFUDC represents the cost of financing construction and is capitalized per FASB ASC 980-835 and FERC regulations. Expressed in USD.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentPeriodDepreciation rdf:type rdf:Property ;
    rdfs:label 'Current Period Depreciation' ;
    rdfs:comment 'Depreciation expense charged for the current accounting period (month or year) for book purposes. Represents the periodic allocation of the depreciable base over the asset\'s useful life. Expressed in USD.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depreciableBase rdf:type rdf:Property ;
    rdfs:label 'Depreciable Base' ;
    rdfs:comment 'The amount subject to depreciation, calculated as original cost minus net salvage value (salvage value minus removal cost estimate). This is the base used to compute periodic depreciation expense. Expressed in USD.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depreciationArea01Amount rdf:type rdf:Property ;
    rdfs:label 'Depreciation Area 01 Amount' ;
    rdfs:comment 'Accumulated depreciation in SAP FI-AA Depreciation Area 01, representing the GAAP book depreciation basis. This is the primary depreciation area used for financial statement reporting and FERC Form 1. Expressed in USD.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depreciationArea15Amount rdf:type rdf:Property ;
    rdfs:label 'Depreciation Area 15 Amount' ;
    rdfs:comment 'Accumulated depreciation in SAP FI-AA Depreciation Area 15, representing the federal income tax (MACRS) depreciation basis. The difference between Area 15 and Area 01 drives the deferred income tax liability calculation under FASB ASC 740. Expressed in USD.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depreciationArea30Amount rdf:type rdf:Property ;
    rdfs:label 'Depreciation Area 30 Amount' ;
    rdfs:comment 'Accumulated depreciation in SAP FI-AA Depreciation Area 30, representing the PUC-approved regulatory depreciation basis. Differences from Area 01 create regulatory assets or liabilities under FASB ASC 980. Expressed in USD.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disposalProceeds rdf:type rdf:Property ;
    rdfs:label 'Disposal Proceeds' ;
    rdfs:comment 'Actual proceeds received from the sale or salvage of the retired asset. Used to compute gain or loss on retirement and to update depreciation reserve accounts. Compared against salvage value estimate for depreciation study calibration. Expressed in USD.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fercJurisdictional rdf:type rdf:Property ;
    rdfs:label 'Ferc Jurisdictional' ;
    rdfs:comment 'Indicates whether the asset is subject to FERC jurisdiction (True) for transmission assets under FERC\'s Open Access Transmission Tariff (OATT) or wholesale rate regulation, versus state PUC jurisdiction only (False). Determines applicable regulatory accounting requirements and rate case venue.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fercPlantAccount rdf:type rdf:Property ;
    rdfs:label 'Ferc Plant Account' ;
    rdfs:comment 'FERC Uniform System of Accounts plant account number classifying the asset (e.g., Account 311 - Steam Production Land, Account 353 - Station Equipment, Account 376 - Distribution Mains, Account 376.1 - Gas Transmission Lines). Mandatory for FERC Form 1 reporting and rate case cost-of-service studies.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gisFeatureReference rdf:type rdf:Property ;
    rdfs:label 'Gis Feature Reference' ;
    rdfs:comment 'Cross-reference identifier linking this fixed asset to its spatial feature record in Esri ArcGIS. Enables geographic rate base analysis, storm damage assessment, and regulatory reporting by geographic area.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:impairmentLoss rdf:type rdf:Property ;
    rdfs:label 'Impairment Loss' ;
    rdfs:comment 'Cumulative impairment loss recognized on the asset when its carrying amount exceeds its recoverable amount. For regulated utilities, impairment may be deferred as a regulatory asset if recovery through future rates is probable under FASB ASC 980. Expressed in USD.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:macrsPropertyClass rdf:type rdf:Property ;
    rdfs:label 'Macrs Property Class' ;
    rdfs:comment 'IRS MACRS property class determining the tax depreciation recovery period (e.g., 5-year, 7-year, 15-year, 20-year). Utility transmission and distribution assets typically fall in the 15-year or 20-year MACRS class. Drives deferred income tax calculations under FASB ASC 740.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maximoAssetReference rdf:type rdf:Property ;
    rdfs:label 'Maximo Asset Reference' ;
    rdfs:comment 'Cross-reference identifier linking this financial fixed asset record to the corresponding physical asset record in Maximo Enterprise Asset Management (EAM). Enables reconciliation between financial accounting (SAP FI-AA) and physical asset management (Maximo) for O&M cost allocation and maintenance history.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originalCost rdf:type rdf:Property ;
    rdfs:label 'Original Cost' ;
    rdfs:comment 'Original cost of the asset at the time of acquisition or construction completion, representing the gross plant investment recorded in the utility plant accounts. Basis for FERC Form 1 gross plant reporting, rate base (RAB) calculation, and depreciation base. Expressed in USD.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:plantLocation rdf:type rdf:Property ;
    rdfs:label 'Plant Location' ;
    rdfs:comment 'Physical location or facility where the asset is installed or operated (e.g., \'Riverside Generating Station\', \'Substation 47 - North District\', \'Gas Compressor Station 12\'). Used for geographic rate base allocation and GIS integration with Esri ArcGIS.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:purchaseOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Purchase Order Number' ;
    rdfs:comment 'SAP MM purchase order number associated with the procurement of this asset. Provides traceability from the capitalized asset back to the original procurement transaction for audit and CAPEX tracking purposes.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rabExclusionReason rdf:type rdf:Property ;
    rdfs:label 'Rab Exclusion Reason' ;
    rdfs:comment 'Reason code explaining why the asset is excluded from the Regulatory Asset Base (RAB) when rab_included is False. Used in rate case testimony and PUC filings to document plant disallowances or exclusions.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rabIncluded rdf:type rdf:Property ;
    rdfs:label 'Rab Included' ;
    rdfs:comment 'Indicates whether this asset is included in the Regulatory Asset Base (RAB) for rate case cost-of-service studies. Assets excluded from RAB (e.g., assets not used and useful, excess capacity, or disallowed plant) do not earn a return in rates. Critical for rate case preparation and PUC filings.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryAccumulatedDepreciation rdf:type rdf:Property ;
    rdfs:label 'Regulatory Accumulated Depreciation' ;
    rdfs:comment 'Total depreciation accumulated using the PUC-approved regulatory depreciation rate from in-service date through current period. Differences between regulatory and book accumulated depreciation create regulatory assets or liabilities under FASB ASC 980. Expressed in USD.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryDepreciationMethod rdf:type rdf:Property ;
    rdfs:label 'Regulatory Depreciation Method' ;
    rdfs:comment 'Depreciation method approved by the state PUC or FERC for regulatory ratemaking purposes. May differ from book depreciation method, creating regulatory assets or liabilities under FASB ASC 980. Used in rate case cost-of-service studies and FERC Form 1 regulatory depreciation schedules.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:removalCostEstimate rdf:type rdf:Property ;
    rdfs:label 'Removal Cost Estimate' ;
    rdfs:comment 'Estimated cost of removing or retiring the asset at end of useful life (cost of removal). For regulated utilities, net salvage (salvage value minus removal cost) is used in depreciation rate calculations filed with the PUC. Expressed in USD.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:retirementCost rdf:type rdf:Property ;
    rdfs:label 'Retirement Cost' ;
    rdfs:comment 'Actual cost incurred to retire and remove the asset from service, including demolition, dismantling, and site remediation costs. Compared against the removal cost estimate for depreciation study accuracy assessment. Expressed in USD.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:retirementType rdf:type rdf:Property ;
    rdfs:label 'Retirement Type' ;
    rdfs:comment 'Classification of the asset retirement event. Normal retirements occur at end of useful life; abnormal retirements occur prematurely due to storm damage, obsolescence, or regulatory disallowance. Abandonment may trigger regulatory asset treatment under FASB ASC 980.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateJurisdiction rdf:type rdf:Property ;
    rdfs:label 'State Jurisdiction' ;
    rdfs:comment 'Two-letter US state code identifying the regulatory jurisdiction under which this asset is rate-based. Determines which state PUC has authority over the asset\'s inclusion in rates. Critical for multi-state utilities performing jurisdictional cost allocation.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxAccumulatedDepreciation rdf:type rdf:Property ;
    rdfs:label 'Tax Accumulated Depreciation' ;
    rdfs:comment 'Total depreciation accumulated for federal income tax purposes (MACRS basis) from in-service date through current period. The difference between tax and book accumulated depreciation represents the temporary timing difference driving deferred income tax balances under FASB ASC 740 and ASC 980. Expressed in USD.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vendorNumber rdf:type rdf:Property ;
    rdfs:label 'Vendor Number' ;
    rdfs:comment 'SAP MM vendor number identifying the supplier from whom the asset was procured. Used for procurement analytics, vendor performance tracking, and supply chain cost analysis for capital projects.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountHierarchyLevel rdf:type rdf:Property ;
    rdfs:label 'Account Hierarchy Level' ;
    rdfs:comment 'The numeric level of this GL account within the financial statement hierarchy (e.g., 1=total, 2=major class, 3=subclass, 4=individual account). Supports hierarchical financial reporting, drill-down analysis in management dashboards, and structured presentation in FERC Form 1 schedules and rate case exhibits.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:accountLongName rdf:type rdf:Property ;
    rdfs:label 'Account Long Name' ;
    rdfs:comment 'The full descriptive name of the GL account (SAP SKB1-TXT50). Provides extended context for the account purpose, used in detailed financial reporting, audit documentation, and regulatory filings where full account descriptions are required.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:afudcEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Afudc Eligible Flag' ;
    rdfs:comment 'Indicates whether this GL account is eligible for AFUDC (Allowance for Funds Used During Construction) capitalization. AFUDC represents the cost of debt and equity funds used to finance construction of utility plant. Eligible accounts are typically construction work in progress (CWIP) accounts under FERC Account 107. AFUDC rates are set by FERC and state PUCs.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:balanceSheetIndicator rdf:type rdf:Property ;
    rdfs:label 'Balance Sheet Indicator' ;
    rdfs:comment 'Indicates whether the GL account is a balance sheet account (carries forward period-end balance) or a profit and loss account (closed to retained earnings at fiscal year-end). Drives SAP period-end closing, financial statement version assignment, and FERC Form 1 balance sheet vs. income statement classification.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depreciationAccountFlag rdf:type rdf:Property ;
    rdfs:label 'Depreciation Account Flag' ;
    rdfs:comment 'Indicates whether this GL account is used to record depreciation expense or accumulated depreciation for utility plant assets. Depreciation accounts are subject to FERC-prescribed depreciation rates, state PUC depreciation studies, and FASB ASC 980 regulatory accounting treatment. Supports depreciation expense tracking for rate case cost-of-service studies.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ebitdaComponent rdf:type rdf:Property ;
    rdfs:label 'Ebitda Component' ;
    rdfs:comment 'Classifies the GL account\'s contribution to EBITDA calculation by identifying which EBITDA component the account feeds (earnings/operating income, interest expense, income taxes, depreciation, or amortization). Supports management reporting, investor relations disclosures, and credit rating agency financial analysis for the utility.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectiveFromDate rdf:type rdf:Property ;
    rdfs:label 'Effective From Date' ;
    rdfs:comment 'The date from which this GL account became effective and available for financial postings. Supports temporal validity tracking for chart of accounts changes, regulatory account restructuring, and historical financial analysis. Accounts created during FERC USoA updates or rate case restructuring carry the date of regulatory approval.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:effectiveToDate rdf:type rdf:Property ;
    rdfs:label 'Effective To Date' ;
    rdfs:comment 'The date on which this GL account ceases to be effective for new financial postings. Null for currently active accounts. Populated when an account is retired, merged, or replaced as part of chart of accounts restructuring, FERC USoA updates, or regulatory account reclassification.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:financialStatementItem rdf:type rdf:Property ;
    rdfs:label 'Financial Statement Item' ;
    rdfs:comment 'The SAP financial statement version item code (FSV item) that maps this GL account to a specific line in the published financial statements (balance sheet, income statement, statement of cash flows). Drives automated financial statement generation, SEC filing preparation, and FERC Form 1 schedule population.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:houseBankAccount rdf:type rdf:Property ;
    rdfs:label 'House Bank Account' ;
    rdfs:comment 'The SAP house bank account identifier (SKB1-HBKID/HKTID) linked to this GL account for bank reconciliation purposes. Populated only for bank GL accounts to enable automatic bank statement processing, electronic bank reconciliation, and cash management reporting.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interestCalculationFlag rdf:type rdf:Property ;
    rdfs:label 'Interest Calculation Flag' ;
    rdfs:comment 'Indicates whether automatic interest calculation is activated for this GL account (SAP SKB1-XINTB). Relevant for regulatory asset/liability accounts where carrying costs or AFUDC (Allowance for Funds Used During Construction) interest accruals are computed under FASB ASC 980 and FERC accounting rules.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lineItemDisplayFlag rdf:type rdf:Property ;
    rdfs:label 'Line Item Display Flag' ;
    rdfs:comment 'Indicates whether individual line item display is activated for this GL account (SAP SKB1-XKRES). When enabled, all individual posting line items are stored and retrievable for detailed audit trail and drill-down analysis. Required for accounts subject to regulatory audit, SOX compliance, and FERC examination.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:onlyBalancesInLocalCurrencyFlag rdf:type rdf:Property ;
    rdfs:label 'Only Balances In Local Currency Flag' ;
    rdfs:comment 'Indicates whether this GL account maintains balances only in local (company code) currency (SAP SKB1-XSALH). When true, foreign currency line items are translated to local currency and only the local currency balance is tracked. Relevant for accounts where foreign currency detail is not required for regulatory reporting.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:openItemManagementFlag rdf:type rdf:Property ;
    rdfs:label 'Open Item Management Flag' ;
    rdfs:comment 'Indicates whether open item management is activated for this GL account (SAP SKB1-XOPVW). When enabled, individual line items remain open until cleared by an offsetting posting (e.g., payment clearing, goods receipt/invoice receipt clearing). Essential for clearing accounts, suspense accounts, and intercompany accounts.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:parentAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Parent Account Number' ;
    rdfs:comment 'The account number of the parent GL account in the chart of accounts hierarchy. Enables hierarchical rollup of account balances for financial statement preparation, management reporting subtotals, and FERC Form 1 schedule aggregations. Null for top-level summary accounts.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planningBlockFlag rdf:type rdf:Property ;
    rdfs:label 'Planning Block Flag' ;
    rdfs:comment 'Indicates whether cost planning postings to this GL account are blocked (SAP SKB1-XSPEP). When true, the account is excluded from CO planning activities such as cost center planning, internal order budgeting, and capital project planning. Supports budget governance and CAPEX/OPEX planning controls.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:plantFunctionCode rdf:type rdf:Property ;
    rdfs:label 'Plant Function Code' ;
    rdfs:comment 'The FERC-defined utility plant function code classifying plant accounts by operational function (e.g., steam production, nuclear production, hydraulic production, transmission, distribution, general plant). Used for FERC Form 1 plant-in-service schedules, depreciation studies, and rate case plant allocation. [ENUM-REF-CANDIDATE: steam_production|nuclear_production|hydraulic_production|other_production|transmission|distribution|general_plant|gas_production|gas_storage|gas_distribution — promote to reference product]' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postingBlockFlag rdf:type rdf:Property ;
    rdfs:label 'Posting Block Flag' ;
    rdfs:comment 'Indicates whether direct financial postings to this GL account are blocked at the company code level (SAP SKB1-XSPEB). When true, no journal entries or document postings can be made to this account, typically applied during period-end close, account restructuring, or regulatory review periods.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:profitCenter rdf:type rdf:Property ;
    rdfs:label 'Profit Center' ;
    rdfs:comment 'The default SAP profit center (SKB1-PRCTR) assigned to this GL account for segment profitability reporting. Enables automatic profit center derivation during financial postings, supporting electric vs. gas segment reporting, regulatory jurisdictional separation, and management reporting by business unit.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryAssetLiabilityType rdf:type rdf:Property ;
    rdfs:label 'Regulatory Asset Liability Type' ;
    rdfs:comment 'Classifies the GL account as a regulatory asset, regulatory liability, or not applicable under FASB ASC 980 regulated operations accounting. Regulatory assets represent costs deferred for future recovery in rates (e.g., storm restoration costs, deferred fuel costs). Regulatory liabilities represent obligations to return amounts to customers through future rates (e.g., excess deferred income taxes, over-collected fuel costs). Critical for RAB valuation and rate case filings.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roeComponentFlag rdf:type rdf:Property ;
    rdfs:label 'Roe Component Flag' ;
    rdfs:comment 'Indicates whether this GL account is included in the Return on Equity (ROE) calculation used in rate case proceedings. ROE-relevant accounts include equity components of the capital structure, net income accounts, and rate base accounts. Supports FERC and state PUC rate of return analysis and allowed ROE determination.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:intercompanyTransactionId rdf:type rdf:Property ;
    rdfs:label 'Intercompany Transaction Id' ;
    rdfs:comment 'System-generated unique identifier for the intercompany transaction record.' ;
    rdfs:domain ind:IntercompanyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:intercompanyJournalEntryId rdf:type rdf:Property ;
    rdfs:label 'Intercompany Journal Entry Id' ;
    rdfs:comment 'Link to the corresponding journal entry in the general ledger.' ;
    rdfs:domain ind:IntercompanyTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:JournalEntry .

ind:reversalOfTransactionIntercompanyTransactionId rdf:type rdf:Property ;
    rdfs:label 'Reversal Of Transaction Intercompany Transaction Id' ;
    rdfs:comment 'Identifier of the original transaction that is being reversed.' ;
    rdfs:domain ind:IntercompanyTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IntercompanyTransaction .

ind:senderLegalEntityId rdf:type rdf:Property ;
    rdfs:label 'Sender Legal Entity Id' ;
    rdfs:comment 'Unique identifier of the sending legal entity within the enterprise master data.' ;
    rdfs:domain ind:IntercompanyTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LegalEntity .

ind:accountingPeriod rdf:type rdf:Property ;
    rdfs:label 'Accounting Period' ;
    rdfs:comment 'Fiscal period identifier (e.g., FY2023Q1) for the transaction.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eliminationFlag rdf:type rdf:Property ;
    rdfs:label 'Elimination Flag' ;
    rdfs:comment 'Indicates whether the transaction is an elimination entry for consolidation purposes.' ;
    rdfs:domain ind:IntercompanyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:intercompanyTransactionDescription rdf:type rdf:Property ;
    rdfs:label 'Intercompany Transaction Description' ;
    rdfs:comment 'Free-text description of the purpose or nature of the intercompany transaction.' ;
    rdfs:domain ind:IntercompanyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:intercompanyTransactionStatus rdf:type rdf:Property ;
    rdfs:label 'Intercompany Transaction Status' ;
    rdfs:comment 'Current lifecycle state of the intercompany transaction.' ;
    rdfs:domain ind:IntercompanyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receiverCompanyCode rdf:type rdf:Property ;
    rdfs:label 'Receiver Company Code' ;
    rdfs:comment 'Code identifying the legal entity that receives the intercompany charge.' ;
    rdfs:domain ind:IntercompanyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receiverLegalEntityCode rdf:type rdf:Property ;
    rdfs:label 'Receiver Legal Entity Code' ;
    rdfs:comment 'Unique identifier of the receiving legal entity within the enterprise master data.' ;
    rdfs:domain ind:IntercompanyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:referenceDocumentNumber rdf:type rdf:Property ;
    rdfs:label 'Reference Document Number' ;
    rdfs:comment 'External document number (e.g., invoice, contract) linked to the transaction.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryAffiliateFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Affiliate Flag' ;
    rdfs:comment 'True if the transaction is subject to PUC affiliate transaction compliance.' ;
    rdfs:domain ind:IntercompanyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reversalFlag rdf:type rdf:Property ;
    rdfs:label 'Reversal Flag' ;
    rdfs:comment 'True if this record represents a reversal of a prior transaction.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:senderCompanyCode rdf:type rdf:Property ;
    rdfs:label 'Sender Company Code' ;
    rdfs:comment 'Code identifying the legal entity that originated the intercompany charge.' ;
    rdfs:domain ind:IntercompanyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionNumber rdf:type rdf:Property ;
    rdfs:label 'Transaction Number' ;
    rdfs:comment 'External business identifier assigned to the transaction (e.g., invoice or journal number).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Transaction Timestamp' ;
    rdfs:comment 'Date and time when the intercompany transaction was executed in the business process.' ;
    rdfs:domain ind:IntercompanyTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:transactionType rdf:type rdf:Property ;
    rdfs:label 'Transaction Type' ;
    rdfs:comment 'Classification of the transaction (e.g., service charge, fuel transfer, capacity payment).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internalOrderId rdf:type rdf:Property ;
    rdfs:label 'Internal Order Id' ;
    rdfs:comment 'Unique surrogate identifier for the SAP CO internal order record in the Databricks Silver Layer. Primary key for this data product.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InternalOrder .

ind:budgetProfile rdf:type rdf:Property ;
    rdfs:label 'Budget Profile' ;
    rdfs:comment 'SAP CO budget profile (Budgetprofil) assigned to this internal order, defining the rules for budget availability control including tolerance limits, warning thresholds, and error actions when actual or committed costs exceed the approved budget.' ;
    rdfs:domain ind:InternalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closedDate rdf:type rdf:Property ;
    rdfs:label 'Closed Date' ;
    rdfs:comment 'The date on which the internal order was fully settled and closed in SAP CO, indicating all costs have been allocated to receivers and the order is archived. Used for financial period-end close management and audit trail.' ;
    rdfs:domain ind:InternalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:committedCost rdf:type rdf:Property ;
    rdfs:label 'Committed Cost' ;
    rdfs:comment 'Total committed costs on this internal order representing purchase orders and contracts issued but not yet invoiced or posted as actual costs. Used for budget availability control and forecasting remaining spend in SAP CO.' ;
    rdfs:domain ind:InternalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastSettledDate rdf:type rdf:Property ;
    rdfs:label 'Last Settled Date' ;
    rdfs:comment 'The date of the most recent period-end settlement run that allocated costs from this internal order to its settlement receivers. Used to confirm that period-end close processes have been completed and to identify orders with outstanding unsettled costs.' ;
    rdfs:domain ind:InternalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:longDescription rdf:type rdf:Property ;
    rdfs:label 'Long Description' ;
    rdfs:comment 'Extended narrative description of the internal order providing full context for the work activity, maintenance job, storm event, or overhead pool. Supports regulatory cost justification in rate case filings and FERC Form 1 reporting.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:objectClass rdf:type rdf:Property ;
    rdfs:label 'Object Class' ;
    rdfs:comment 'SAP CO object class (Objektklasse) of the internal order, which determines how costs are treated in profitability analysis and overhead accounting. \'overhead\' = indirect cost pool; \'investment\' = capital expenditure collection; \'profitability\' = revenue-bearing order; \'accrual\' = accrual accounting order.' ;
    rdfs:domain ind:InternalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:opexCapexIndicator rdf:type rdf:Property ;
    rdfs:label 'Opex Capex Indicator' ;
    rdfs:comment 'Indicates whether costs collected on this internal order are classified as Operating Expenditure (OPEX), Capital Expenditure (CAPEX), or a mixed allocation. Critical for regulatory cost-of-service studies, rate case filings, and FERC Form 1 reporting. OPEX orders are expensed in the period; CAPEX orders are capitalized to the Regulatory Asset Base (RAB).' ;
    rdfs:domain ind:InternalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderCategory rdf:type rdf:Property ;
    rdfs:label 'Order Category' ;
    rdfs:comment 'SAP CO internal order category that determines the fundamental accounting treatment. \'overhead_order\' = collects overhead costs for allocation to cost centers; \'investment_order\' = collects CAPEX costs for capitalization to fixed assets; \'accrual_order\' = supports accrual postings; \'order_with_revenues\' = collects both costs and revenues for profitability analysis.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overheadOrderFlag rdf:type rdf:Property ;
    rdfs:label 'Overhead Order Flag' ;
    rdfs:comment 'Indicates whether this internal order functions as an overhead cost pool for collecting and subsequently allocating indirect costs (e.g., fleet overhead, administrative overhead, safety program costs) to cost centers or other orders via SAP CO overhead allocation cycles.' ;
    rdfs:domain ind:InternalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:plannedTotalCost rdf:type rdf:Property ;
    rdfs:label 'Planned Total Cost' ;
    rdfs:comment 'Total planned (estimated) cost for this internal order as entered in SAP CO cost planning. Represents the expected cost to complete the work activity or fill the overhead pool. Used for budget-to-actual variance analysis and rate case cost-of-service studies.' ;
    rdfs:domain ind:InternalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:planningProfile rdf:type rdf:Property ;
    rdfs:label 'Planning Profile' ;
    rdfs:comment 'SAP CO planning profile assigned to this internal order, controlling the cost planning methodology (e.g., overall planning, annual planning, detailed planning by cost element). Used to standardize cost estimation approaches across O&M and overhead orders.' ;
    rdfs:domain ind:InternalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:profitCenterCode rdf:type rdf:Property ;
    rdfs:label 'Profit Center Code' ;
    rdfs:comment 'Surrogate reference to the SAP CO profit center associated with this internal order. Enables profitability analysis by business segment (e.g., electric distribution, gas distribution, generation) and supports segment reporting under FASB ASC 280 and FERC jurisdictional cost separation.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryRecoveryFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Recovery Flag' ;
    rdfs:comment 'Indicates whether the costs collected on this internal order are eligible for regulatory cost recovery through rates approved by the PUC or FERC. True = costs are recoverable in rates (e.g., storm restoration, mandated compliance work); False = costs are not recoverable or are subject to disallowance review. Supports regulatory asset/liability accounting under FASB ASC 980.' ;
    rdfs:domain ind:InternalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requestingCostCenter rdf:type rdf:Property ;
    rdfs:label 'Requesting Cost Center' ;
    rdfs:comment 'SAP CO cost center code of the organizational unit that requested the creation of this internal order. Distinct from the responsible cost center; used to track which department initiated the work activity or cost collection requirement.' ;
    rdfs:domain ind:InternalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsiblePerson rdf:type rdf:Property ;
    rdfs:label 'Responsible Person' ;
    rdfs:comment 'Name or employee identifier of the person responsible for managing and monitoring this internal order, as recorded in SAP CO master data. Used for cost accountability, budget ownership, and audit trail purposes in financial and regulatory reporting.' ;
    rdfs:domain ind:InternalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementReceiverType rdf:type rdf:Property ;
    rdfs:label 'Settlement Receiver Type' ;
    rdfs:comment 'Type of SAP CO settlement receiver to which costs accumulated on this internal order are settled at period-end. Determines the downstream accounting treatment: \'cost_center\' = OPEX allocation; \'fixed_asset\' = CAPEX capitalization; \'gl_account\' = direct G/L posting; \'wbs_element\' = project cost roll-up.' ;
    rdfs:domain ind:InternalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementRuleProfile rdf:type rdf:Property ;
    rdfs:label 'Settlement Rule Profile' ;
    rdfs:comment 'SAP CO settlement profile (Abrechnungsprofil) assigned to the internal order, defining the rules for how accumulated costs are settled (allocated) to receivers such as cost centers, G/L accounts, fixed assets, or other orders at period-end. Critical for OPEX vs. CAPEX cost classification and regulatory asset capitalization.' ;
    rdfs:domain ind:InternalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shortDescription rdf:type rdf:Property ;
    rdfs:label 'Short Description' ;
    rdfs:comment 'Brief human-readable description of the internal order\'s business purpose, as entered in SAP CO (Kurztext field, up to 40 characters). Used in financial reports, cost center allocations, and regulatory filings to identify the nature of the work or cost pool being tracked.' ;
    rdfs:domain ind:InternalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statisticalOrderFlag rdf:type rdf:Property ;
    rdfs:label 'Statistical Order Flag' ;
    rdfs:comment 'Indicates whether this internal order is a statistical order in SAP CO. True = statistical order used for reporting and analysis purposes only; costs are posted in parallel to a real cost object (cost center or WBS element) and do not affect actual cost flows. False = real order that carries actual costs for settlement.' ;
    rdfs:domain ind:InternalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stormEventFlag rdf:type rdf:Property ;
    rdfs:label 'Storm Event Flag' ;
    rdfs:comment 'Indicates whether this internal order was created specifically to capture costs associated with a storm restoration event. True = storm restoration order eligible for separate regulatory cost recovery tracking and potential extraordinary cost treatment. Supports SAIDI/SAIFI reporting and storm cost deferral accounting.' ;
    rdfs:domain ind:InternalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:technicallyCompleteDate rdf:type rdf:Property ;
    rdfs:label 'Technically Complete Date' ;
    rdfs:comment 'The date on which the internal order was set to \'Technically Complete\' status in SAP CO, indicating that the operational work is finished and no further cost postings should occur. Triggers the settlement process and is used for regulatory cost period cut-off in rate case filings.' ;
    rdfs:domain ind:InternalOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:journalEntryId rdf:type rdf:Property ;
    rdfs:label 'Journal Entry Id' ;
    rdfs:comment 'Unique surrogate identifier for each journal entry record in the general ledger. Serves as the primary key for the journal_entry data product in the Databricks Silver Layer.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:JournalEntry .

ind:accrualIndicator rdf:type rdf:Property ;
    rdfs:label 'Accrual Indicator' ;
    rdfs:comment 'Flag indicating whether the journal entry is an accrual posting (estimated expense or revenue recognized before cash settlement). True for period-end accruals such as unbilled revenue, fuel cost accruals, and O&M expense accruals. Supports accrual reversal tracking.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:approvedByUser rdf:type rdf:Property ;
    rdfs:label 'Approved By User' ;
    rdfs:comment 'SAP user ID of the approver who authorized the journal entry through the workflow approval process. Required for SOX Section 404 segregation of duties controls, particularly for manual journal entries above materiality thresholds.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentField rdf:type rdf:Property ;
    rdfs:label 'Assignment Field' ;
    rdfs:comment 'Free-form assignment field used to carry cross-reference information such as billing document number, meter reading order, payment reference, or asset number. Enables drill-through from GL postings to originating operational transactions. Corresponds to BSEG-ZUONR in SAP.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:debitCreditIndicator rdf:type rdf:Property ;
    rdfs:label 'Debit Credit Indicator' ;
    rdfs:comment 'Indicates whether the journal entry line item is a debit (D) or credit (C) posting. Fundamental to double-entry bookkeeping and GL balance verification. Corresponds to BSEG-SHKZG in SAP.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depreciationArea rdf:type rdf:Property ;
    rdfs:label 'Depreciation Area' ;
    rdfs:comment 'SAP FI-AA depreciation area code indicating the valuation basis for asset-related journal entries (e.g., 01=Book Depreciation, 15=Tax Depreciation, 20=FERC Regulatory Depreciation). Supports parallel valuation for GAAP, tax, and regulatory reporting. Corresponds to BSEG-BZDAT area in SAP.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enteredByUser rdf:type rdf:Property ;
    rdfs:label 'Entered By User' ;
    rdfs:comment 'SAP user ID of the person or system process that created the journal entry. Required for SOX Section 404 internal controls, segregation of duties monitoring, and audit trail documentation. Corresponds to BKPF-USNAM in SAP.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entryStatus rdf:type rdf:Property ;
    rdfs:label 'Entry Status' ;
    rdfs:comment 'Current lifecycle status of the journal entry in the general ledger workflow. \'posted\' = fully committed to GL; \'parked\' = saved but not yet posted (BKPF-XBLNR workflow); \'held\' = incomplete entry; \'reversed\' = offset entry created; \'simulated\' = test posting not committed.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entryTimestamp rdf:type rdf:Property ;
    rdfs:label 'Entry Timestamp' ;
    rdfs:comment 'The exact date and time when the journal entry record was created in the SAP FI system. Provides the audit trail creation timestamp for SOX compliance and internal controls. Corresponds to BKPF-CPUDT and BKPF-CPUTM in SAP.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:headerText rdf:type rdf:Property ;
    rdfs:label 'Header Text' ;
    rdfs:comment 'Free-text description at the journal entry header level explaining the business purpose of the posting (e.g., \'Q3 Fuel Cost Accrual\', \'Storm Restoration Capitalization\', \'FERC Account 403 Depreciation Run\'). Supports audit review and regulatory cost-of-service documentation. Corresponds to BKPF-BKTXT in SAP.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:intercompanyIndicator rdf:type rdf:Property ;
    rdfs:label 'Intercompany Indicator' ;
    rdfs:comment 'Flag indicating whether the journal entry involves a transaction between affiliated entities within the utility holding company. True triggers intercompany elimination processing in consolidated reporting and FERC affiliate transaction disclosure requirements.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lineItemNumber rdf:type rdf:Property ;
    rdfs:label 'Line Item Number' ;
    rdfs:comment 'Sequential line item number within the journal entry document, starting at 1. Uniquely identifies each debit or credit posting line within a multi-line journal entry. Corresponds to BSEG-BUZEI in SAP.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lineItemText rdf:type rdf:Property ;
    rdfs:label 'Line Item Text' ;
    rdfs:comment 'Free-text description at the journal entry line item level providing additional detail about the specific debit or credit posting (e.g., \'Transmission line maintenance labor\', \'Nuclear fuel amortization\'). Supports granular audit trail and FERC cost-of-service line item documentation. Corresponds to BSEG-SGTXT in SAP.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:localCurrencyAmount rdf:type rdf:Property ;
    rdfs:label 'Local Currency Amount' ;
    rdfs:comment 'The journal entry line item amount converted to the company code local currency (typically USD). Used for consolidated financial reporting, EBITDA calculation, and FERC Form 1 reporting where all amounts must be in USD. Corresponds to BSEG-DMBTR in SAP.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:localCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Local Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code of the company code local currency (typically USD for US utilities). Used when transaction currency differs from local currency to support multi-currency financial reporting. Corresponds to BKPF-HWAER in SAP.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postingKey rdf:type rdf:Property ;
    rdfs:label 'Posting Key' ;
    rdfs:comment 'SAP two-digit posting key that determines the account type, debit/credit indicator, and field selection for the line item (e.g., 40=GL Debit, 50=GL Credit, 01=Customer Invoice, 31=Vendor Invoice). Drives the accounting logic for each line. Corresponds to BSEG-BSCHL in SAP. [ENUM-REF-CANDIDATE: 01|31|40|50|70|75|80|90 — promote to reference product]' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recurringEntryIndicator rdf:type rdf:Property ;
    rdfs:label 'Recurring Entry Indicator' ;
    rdfs:comment 'Flag indicating whether the journal entry was generated from a SAP recurring entry template (FBD1). True for fixed monthly postings such as lease payments, depreciation runs, and regulatory amortization entries. Supports automated posting audit trails.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryAssetIndicator rdf:type rdf:Property ;
    rdfs:label 'Regulatory Asset Indicator' ;
    rdfs:comment 'Flag indicating whether the journal entry relates to a FASB ASC 980 regulatory asset or regulatory liability. True for deferred costs or revenues that are recoverable through future rate cases (e.g., storm restoration costs, deferred fuel costs, pension regulatory assets). Critical for RAB valuation.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reversalIndicator rdf:type rdf:Property ;
    rdfs:label 'Reversal Indicator' ;
    rdfs:comment 'Flag indicating whether this journal entry is a reversal of a previously posted document. True when the entry was created via the SAP reversal transaction (FB08/FBR2). Used to identify offsetting entries in audit trails and period-end reconciliation.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reversalReasonCode rdf:type rdf:Property ;
    rdfs:label 'Reversal Reason Code' ;
    rdfs:comment 'SAP-defined reason code explaining why the journal entry was reversed (e.g., 01=Reversal in current period, 02=Reversal in prior period, 03=Accrual reversal). Required for audit documentation and SOX internal controls. Corresponds to BKPF-STGRD in SAP.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reversedDocumentNumber rdf:type rdf:Property ;
    rdfs:label 'Reversed Document Number' ;
    rdfs:comment 'The original SAP FI document number that this entry reverses, if reversal_indicator is True. Enables traceability between reversal entries and their originating documents for audit and regulatory cost-of-service studies. Corresponds to BKPF-STBLG in SAP.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceTransactionType rdf:type rdf:Property ;
    rdfs:label 'Source Transaction Type' ;
    rdfs:comment 'Classification of the originating business process that generated the journal entry. Enables segregation of manual entries from system-generated postings for SOX controls, and supports FERC Form 1 functional cost analysis by transaction origin. [ENUM-REF-CANDIDATE: manual|billing|procurement|payroll|asset|accrual|reversal|period_close|intercompany|energy_trading — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialGlIndicator rdf:type rdf:Property ;
    rdfs:label 'Special Gl Indicator' ;
    rdfs:comment 'SAP special GL indicator for down payments, guarantees, bills of exchange, or regulatory asset/liability postings (e.g., A=Down Payment, E=Security Deposit, F=Regulatory Asset). Critical for FASB ASC 980 regulatory asset and liability accounting. Corresponds to BSEG-UMSKZ in SAP.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tradingPartner rdf:type rdf:Property ;
    rdfs:label 'Trading Partner' ;
    rdfs:comment 'SAP trading partner company code for intercompany journal entries between affiliated entities within the utility holding company structure. Used for intercompany elimination in consolidated financial statements and FERC affiliate transaction reporting. Corresponds to BSEG-VBUND in SAP.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionAmount rdf:type rdf:Property ;
    rdfs:label 'Transaction Amount' ;
    rdfs:comment 'The gross monetary amount of the journal entry line item in the transaction currency. Represents the raw financial value before any local currency conversion. Positive for debits, negative for credits per SAP sign convention. Corresponds to BSEG-WRBTR in SAP.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transactionCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Transaction Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code of the original transaction currency in which the journal entry amount was recorded (e.g., USD for US Dollar). Used for multi-currency postings involving PPAs, energy trading, or international vendor transactions. Corresponds to BKPF-WAERS in SAP.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:journalEntryLineId rdf:type rdf:Property ;
    rdfs:label 'Journal Entry Line Id' ;
    rdfs:comment 'Unique surrogate identifier for each individual debit or credit line item within a SAP FI journal entry. Serves as the primary key for this atomic-level financial posting record in the Databricks Silver Layer.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assignment rdf:type rdf:Property ;
    rdfs:label 'Assignment' ;
    rdfs:comment 'SAP FI assignment field (ZUONR) used for sorting and grouping line items in account statements and open item management. Typically populated with a reference number such as a meter number, work order number, or billing document number for cross-system traceability.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:baselineDate rdf:type rdf:Property ;
    rdfs:label 'Baseline Date' ;
    rdfs:comment 'The baseline date (ZFBDT) used for payment terms calculation on vendor and customer line items. Determines due dates for accounts payable and accounts receivable aging analysis and cash flow forecasting.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:changedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Changed Timestamp' ;
    rdfs:comment 'The timestamp of the most recent modification to this journal entry line item in SAP FI. Supports change data capture (CDC) for the Databricks Silver Layer ingestion pipeline and SOX Section 404 change audit trail requirements.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:clearingDate rdf:type rdf:Property ;
    rdfs:label 'Clearing Date' ;
    rdfs:comment 'The date (AUGDT) on which this open line item was cleared (matched against a payment or offsetting entry) in SAP FI. Null for uncleared items. Used for accounts payable/receivable reconciliation and cash application tracking.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dunningBlock rdf:type rdf:Property ;
    rdfs:label 'Dunning Block' ;
    rdfs:comment 'SAP FI dunning block indicator (MANSP) that prevents automated dunning (payment reminder) notices for this line item. Used for disputed invoices, regulatory-ordered payment holds, or items under PUC complaint review.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lineItemStatus rdf:type rdf:Property ;
    rdfs:label 'Line Item Status' ;
    rdfs:comment 'Current processing status of this journal entry line item in the financial workflow. \'open\' indicates an uncleared item; \'cleared\' indicates matched/settled; \'parked\' indicates a provisional posting pending approval; \'reversed\' indicates a correcting reversal; \'in_dispute\' indicates a contested amount under review.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:localAmount rdf:type rdf:Property ;
    rdfs:label 'Local Amount' ;
    rdfs:comment 'The monetary amount of this line item translated into the company code local currency (DMBTR), typically USD for US utility operations. Used for consolidated financial reporting, FERC Form 1, and FASB ASC 980 regulatory accounting.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:localCurrency rdf:type rdf:Property ;
    rdfs:label 'Local Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the company code local currency (HWAER), typically USD. Distinguishes local currency amounts from transaction currency amounts in multi-currency SAP environments.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentBlock rdf:type rdf:Property ;
    rdfs:label 'Payment Block' ;
    rdfs:comment 'SAP FI payment block indicator (ZLSPR) that prevents automated payment processing for this line item. Used for invoice verification holds, disputed vendor payments, or regulatory compliance holds pending PUC or FERC review.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:plant rdf:type rdf:Property ;
    rdfs:label 'Plant' ;
    rdfs:comment 'SAP logistics plant code (WERKS) associated with this line item, representing a generation facility, service center, or operational location. Links financial postings to physical utility infrastructure for asset accounting and FERC plant account reporting.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:secondLocalAmount rdf:type rdf:Property ;
    rdfs:label 'Second Local Amount' ;
    rdfs:comment 'Amount in the SAP company code second local currency (parallel currency), used for group reporting or regulatory reporting in a secondary currency. Supports consolidated EBITDA and Return on Equity (ROE) calculations at the enterprise level.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transactionCurrency rdf:type rdf:Property ;
    rdfs:label 'Transaction Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the transaction currency (WAERS) of this line item, e.g., USD. Required for multi-currency postings such as Power Purchase Agreement (PPA) settlements or international energy trading transactions.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valueDate rdf:type rdf:Property ;
    rdfs:label 'Value Date' ;
    rdfs:comment 'The value date (VALUT) for this line item, representing the date on which the financial transaction takes economic effect for cash management and liquidity planning purposes. Relevant for energy trading settlements and Power Purchase Agreement (PPA) payments.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:financeLeaseId rdf:type rdf:Property ;
    rdfs:label 'Finance Lease Id' ;
    rdfs:comment 'Unique system-generated identifier for the lease record.' ;
    rdfs:domain ind:FinanceLease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contractDocumentId rdf:type rdf:Property ;
    rdfs:label 'Contract Document Id' ;
    rdfs:comment 'Identifier of the electronic lease contract document stored in the DMS.' ;
    rdfs:domain ind:FinanceLease ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Document .

ind:accountingStandard rdf:type rdf:Property ;
    rdfs:label 'Accounting Standard' ;
    rdfs:comment 'Accounting framework governing lease treatment.' ;
    rdfs:domain ind:FinanceLease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amortizationMethod rdf:type rdf:Property ;
    rdfs:label 'Amortization Method' ;
    rdfs:comment 'Method used to amortize the right-of-use asset over the lease term.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amortizationPeriodYears rdf:type rdf:Property ;
    rdfs:label 'Amortization Period Years' ;
    rdfs:comment 'Number of years over which the asset is amortized.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assetLocation rdf:type rdf:Property ;
    rdfs:label 'Asset Location' ;
    rdfs:comment 'Physical location or site of the leased asset.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:classification rdf:type rdf:Property ;
    rdfs:label 'Classification' ;
    rdfs:comment 'ASC 842 classification indicating whether the lease is operating or finance.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commencementDate rdf:type rdf:Property ;
    rdfs:label 'Commencement Date' ;
    rdfs:comment 'Date the lessee obtains the right to use the asset.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contractStatusDate rdf:type rdf:Property ;
    rdfs:label 'Contract Status Date' ;
    rdfs:comment 'Date when the lease status last changed.' ;
    rdfs:domain ind:FinanceLease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fercForm1Schedule rdf:type rdf:Property ;
    rdfs:label 'Ferc Form1 Schedule' ;
    rdfs:comment 'Schedule identifier for reporting lease obligations on FERC Form 1.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:financeLeaseStatus rdf:type rdf:Property ;
    rdfs:label 'Finance Lease Status' ;
    rdfs:comment 'Current lifecycle status of the lease.' ;
    rdfs:domain ind:FinanceLease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastReviewedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Reviewed Timestamp' ;
    rdfs:comment 'Timestamp of the last formal review of lease terms for compliance.' ;
    rdfs:domain ind:FinanceLease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:leaseDescription rdf:type rdf:Property ;
    rdfs:label 'Lease Description' ;
    rdfs:comment 'Narrative description of the lease purpose and key terms.' ;
    rdfs:domain ind:FinanceLease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leaseNumber rdf:type rdf:Property ;
    rdfs:label 'Lease Number' ;
    rdfs:comment 'External lease agreement number assigned by the utility or lessor.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leaseType rdf:type rdf:Property ;
    rdfs:label 'Lease Type' ;
    rdfs:comment 'Classification of the lease based on its economic substance.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:liability rdf:type rdf:Property ;
    rdfs:label 'Liability' ;
    rdfs:comment 'Present value of lease payments owed at lease commencement.' ;
    rdfs:domain ind:FinanceLease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:modificationDate rdf:type rdf:Property ;
    rdfs:label 'Modification Date' ;
    rdfs:comment 'Date of the most recent lease amendment.' ;
    rdfs:domain ind:FinanceLease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:modificationFlag rdf:type rdf:Property ;
    rdfs:label 'Modification Flag' ;
    rdfs:comment 'Indicates whether the lease has been modified after inception.' ;
    rdfs:domain ind:FinanceLease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentAmount rdf:type rdf:Property ;
    rdfs:label 'Payment Amount' ;
    rdfs:comment 'Base amount due each payment period before taxes or fees.' ;
    rdfs:domain ind:FinanceLease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentCurrency rdf:type rdf:Property ;
    rdfs:label 'Payment Currency' ;
    rdfs:comment 'ISO 4217 currency code for lease payments (e.g., USD).' ;
    rdfs:domain ind:FinanceLease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentDueDate rdf:type rdf:Property ;
    rdfs:label 'Payment Due Date' ;
    rdfs:comment 'Standard calendar date on which each lease payment is due.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paymentFrequency rdf:type rdf:Property ;
    rdfs:label 'Payment Frequency' ;
    rdfs:comment 'How often lease payments are scheduled.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:purchaseOptionFlag rdf:type rdf:Property ;
    rdfs:label 'Purchase Option Flag' ;
    rdfs:comment 'Indicates whether the lease provides a purchase option at termination.' ;
    rdfs:domain ind:FinanceLease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:purchasePrice rdf:type rdf:Property ;
    rdfs:label 'Purchase Price' ;
    rdfs:comment 'Fixed price to purchase the underlying asset if the purchase option is exercised.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:residualValue rdf:type rdf:Property ;
    rdfs:label 'Residual Value' ;
    rdfs:comment 'Estimated fair value of the asset at lease end, used for finance lease calculations.' ;
    rdfs:domain ind:FinanceLease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rightOfUseAssetValue rdf:type rdf:Property ;
    rdfs:label 'Right Of Use Asset Value' ;
    rdfs:comment 'Present value of the right-of-use asset at lease commencement.' ;
    rdfs:domain ind:FinanceLease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:termYears rdf:type rdf:Property ;
    rdfs:label 'Term Years' ;
    rdfs:comment 'Number of whole years in the lease term.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:approvedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Approved By User Employee Id' ;
    rdfs:comment 'SAP user ID of the supervisor or treasury manager who approved the payment proposal before posting. Enforces dual-control requirements for disbursements above threshold amounts per internal controls policy.' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:houseBankBankAccountId rdf:type rdf:Property ;
    rdfs:label 'House Bank Bank Account Id' ;
    rdfs:comment 'SAP FI house bank identifier representing the utility\'s internal bank master record from which payments are disbursed. Links to the specific bank account used for this payment run, supporting bank reconciliation and cash position reporting.' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BankAccount .

ind:reversedRunPaymentRunId rdf:type rdf:Property ;
    rdfs:label 'Reversed Run Payment Run Id' ;
    rdfs:comment 'Reference to the original payment_run_id that this run reverses, if reversal_flag is True. Enables traceability between reversal runs and their originating payment runs for audit and reconciliation purposes.' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PaymentRun .

ind:bankAccountNumberMasked rdf:type rdf:Property ;
    rdfs:label 'Bank Account Number Masked' ;
    rdfs:comment 'Masked representation of the utility\'s disbursement bank account number, showing only the last four digits for identification and reconciliation purposes without exposing the full account number. Used in audit reports and bank reconciliation statements.' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankFileGeneratedFlag rdf:type rdf:Property ;
    rdfs:label 'Bank File Generated Flag' ;
    rdfs:comment 'Indicates whether the payment medium file (e.g., ACH NACHA file, SWIFT MT103, check print file) was successfully generated and transmitted to the bank for this payment run. False indicates a file generation failure requiring investigation.' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bankFileTransmissionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Bank File Transmission Timestamp' ;
    rdfs:comment 'Date and time when the payment medium file was transmitted to the bank or payment processor. Used for bank reconciliation cutoff determination and exception investigation when payments are not reflected in bank statements.' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:bankRoutingNumber rdf:type rdf:Property ;
    rdfs:label 'Bank Routing Number' ;
    rdfs:comment 'American Bankers Association (ABA) routing transit number of the utility\'s disbursement bank. Required for ACH and wire payment file generation and bank reconciliation. Nine-digit numeric code.' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:docsEnteredUpToDate rdf:type rdf:Property ;
    rdfs:label 'Docs Entered Up To Date' ;
    rdfs:comment 'SAP F110 parameter specifying the latest document entry date for invoices to be considered in this payment run. Ensures only invoices entered into SAP by this cutoff date are included, supporting period-close controls.' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:documentCount rdf:type rdf:Property ;
    rdfs:label 'Document Count' ;
    rdfs:comment 'Total number of individual payment documents (FI payment postings) generated by this payment run. Each document represents a payment to a single vendor or employee. Used for run validation, exception monitoring, and audit completeness checks.' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:exceptionCount rdf:type rdf:Property ;
    rdfs:label 'Exception Count' ;
    rdfs:comment 'Number of vendor invoices or payment items that were excluded from this payment run due to exceptions (e.g., payment block, missing bank details, duplicate invoice flag, credit hold). Drives AP exception resolution workflow.' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:grossPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Payment Amount' ;
    rdfs:comment 'Total gross disbursement amount for all payment documents included in this payment run before application of discounts or deductions. Represents the sum of all vendor invoice and expense reimbursement amounts selected for payment. Used for cash flow forecasting and bank reconciliation.' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:invoiceCount rdf:type rdf:Property ;
    rdfs:label 'Invoice Count' ;
    rdfs:comment 'Total number of vendor invoices and expense reimbursement line items cleared (paid) by this payment run. A single payment document may clear multiple invoices; this count reflects the total open items settled.' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:netPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Net Payment Amount' ;
    rdfs:comment 'Net total amount actually disbursed in this payment run after deducting cash discounts and other adjustments from the gross payment amount. This is the actual cash outflow recorded in the treasury cash position and bank statement.' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nextPaymentDate rdf:type rdf:Property ;
    rdfs:label 'Next Payment Date' ;
    rdfs:comment 'The \'next payment date\' parameter used in the SAP F110 payment proposal to determine which open invoices are due for payment. Invoices with a due date on or before this date are selected for inclusion in the run.' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:payingCompanyCode rdf:type rdf:Property ;
    rdfs:label 'Paying Company Code' ;
    rdfs:comment 'SAP FI company code of the legal entity initiating the payment run. For a utility with multiple regulated subsidiaries (electric vs. gas), this identifies which legal entity\'s bank account and chart of accounts are used. Aligns with FERC jurisdictional entity reporting.' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentMethodCode rdf:type rdf:Property ;
    rdfs:label 'Payment Method Code' ;
    rdfs:comment 'SAP FI payment method code indicating the instrument used to disburse funds (e.g., ACH for Automated Clearing House, CHECK for paper check, WIRE for wire transfer, EFT for electronic funds transfer). Drives bank file format generation and clearing account determination.' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentPostedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Payment Posted Timestamp' ;
    rdfs:comment 'Date and time when the payment documents were posted in SAP FI, creating the actual accounting entries and clearing the open vendor items. This is the principal business event timestamp for the payment run lifecycle.' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:paymentProgramVariant rdf:type rdf:Property ;
    rdfs:label 'Payment Program Variant' ;
    rdfs:comment 'SAP FI F110 program variant name that defines the selection parameters for this payment run (e.g., company codes, payment methods, next payment date, vendor selection criteria). Stored for audit traceability and run reproducibility.' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentRunCategory rdf:type rdf:Property ;
    rdfs:label 'Payment Run Category' ;
    rdfs:comment 'Business category of the payables being settled in this run. Distinguishes vendor invoice payments (CAPEX/OPEX procurement), employee expense reimbursements, intercompany settlements, tax remittances, and regulatory fee payments (e.g., FERC filing fees, PUC assessments).' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentRunType rdf:type rdf:Property ;
    rdfs:label 'Payment Run Type' ;
    rdfs:comment 'Classification of the payment run by its business purpose. \'regular\' denotes scheduled weekly/bi-weekly AP runs; \'off_cycle\' denotes ad-hoc runs outside the standard schedule; \'emergency\' denotes urgent disbursements; \'reversal\' denotes runs created to reverse prior payments.' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proposalCreatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Proposal Created Timestamp' ;
    rdfs:comment 'Date and time when the SAP F110 payment proposal was generated. The proposal lists all invoices selected for payment before final posting. Supports audit trail and approval workflow timing.' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:runDate rdf:type rdf:Property ;
    rdfs:label 'Run Date' ;
    rdfs:comment 'The calendar date on which the SAP FI automatic payment program (F110) was executed. This is the principal business event date used for treasury cash management, bank reconciliation, and period-close reporting.' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:runIdentificationKey rdf:type rdf:Property ;
    rdfs:label 'Run Identification Key' ;
    rdfs:comment 'SAP FI run identification key (Identification field in F110) that, together with run_date, uniquely identifies the payment run within SAP. Typically a short alphanumeric code assigned by the AP/treasury team (e.g., \'AP01\', \'WIRE1\').' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorCount rdf:type rdf:Property ;
    rdfs:label 'Vendor Count' ;
    rdfs:comment 'Number of distinct vendors (and/or employees for expense reimbursements) included in this payment run. Used for payment run sizing analysis, bank file validation, and AP workload reporting.' ;
    rdfs:domain ind:PaymentRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rateBaseId rdf:type rdf:Property ;
    rdfs:label 'Rate Base Id' ;
    rdfs:comment 'Unique surrogate identifier for each rate base record in the regulatory asset base (RAB) calculation dataset. Primary key for the rate_base data product.' ;
    rdfs:domain ind:RateBase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:regulatoryAssetId rdf:type rdf:Property ;
    rdfs:label 'Regulatory Asset Id' ;
    rdfs:comment 'Foreign key linking to finance.regulatory_asset. Business justification: Rate Base calculations depend on regulatory asset data; linking provides direct access.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RegulatoryAsset .

ind:accumulatedDepreciationAmt rdf:type rdf:Property ;
    rdfs:label 'Accumulated Depreciation Amt' ;
    rdfs:comment 'Total accumulated depreciation on utility plant in service as of the test year end date. Subtracted from gross plant in service to arrive at net utility plant in the rate base calculation. Sourced from SAP FI/CO asset accounting module.' ;
    rdfs:domain ind:RateBase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:aditAmt rdf:type rdf:Property ;
    rdfs:label 'Adit Amt' ;
    rdfs:comment 'Accumulated Deferred Income Taxes (ADIT) balance that reduces the rate base. ADIT represents the cumulative timing differences between book and tax depreciation, which are treated as a cost-free source of capital that offsets the rate base per IRS normalization rules and FERC/PUC requirements.' ;
    rdfs:domain ind:RateBase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allowedRoeRate rdf:type rdf:Property ;
    rdfs:label 'Allowed Roe Rate' ;
    rdfs:comment 'The authorized Return on Equity (ROE) rate approved by the regulatory commission for this rate case, expressed as a decimal (e.g., 0.0950 for 9.50%). Used to calculate the equity return component of the revenue requirement in cost-of-service studies.' ;
    rdfs:domain ind:RateBase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commissionApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Commission Approval Date' ;
    rdfs:comment 'The date on which the regulatory commission issued its final order approving the rate base for tariff purposes. Nullable until the commission issues its decision following the rate case proceeding.' ;
    rdfs:domain ind:RateBase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:costOfDebtRate rdf:type rdf:Property ;
    rdfs:label 'Cost Of Debt Rate' ;
    rdfs:comment 'The embedded cost of long-term debt used in the capital structure for rate base return calculations, expressed as a decimal (e.g., 0.0450 for 4.50%). Calculated from the utility\'s outstanding long-term debt instruments as filed with the regulatory commission.' ;
    rdfs:domain ind:RateBase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:customerDepositsAmt rdf:type rdf:Property ;
    rdfs:label 'Customer Deposits Amt' ;
    rdfs:comment 'Total customer deposit balances that reduce the rate base. Customer deposits are treated as a cost-free source of capital provided by customers, which offsets the utility\'s rate base investment in cost-of-service studies.' ;
    rdfs:domain ind:RateBase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cwipAmt rdf:type rdf:Property ;
    rdfs:label 'Cwip Amt' ;
    rdfs:comment 'Dollar value of capital projects currently under construction that are included in the rate base per regulatory authorization. CWIP inclusion in rate base is subject to PUC approval and AFUDC (Allowance for Funds Used During Construction) accounting treatment under FASB ASC 980.' ;
    rdfs:domain ind:RateBase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:debtRatio rdf:type rdf:Property ;
    rdfs:label 'Debt Ratio' ;
    rdfs:comment 'The proportion of long-term debt in the approved or proposed capital structure used for rate base return calculations, expressed as a decimal (e.g., 0.5000 for 50%). Together with equity ratio, defines the capital structure for revenue requirement calculations.' ;
    rdfs:domain ind:RateBase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:equityRatio rdf:type rdf:Property ;
    rdfs:label 'Equity Ratio' ;
    rdfs:comment 'The proportion of equity in the approved or proposed capital structure used for rate base return calculations, expressed as a decimal (e.g., 0.5000 for 50%). Determined by the regulatory commission in the rate case proceeding.' ;
    rdfs:domain ind:RateBase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fuelTypeCode rdf:type rdf:Property ;
    rdfs:label 'Fuel Type Code' ;
    rdfs:comment 'Identifies the fuel or energy source type associated with generation plant assets included in this rate base record. Used for Integrated Resource Plan (IRP) reporting, Renewable Energy Certificate (REC) tracking, and environmental compliance cost allocation.' ;
    rdfs:domain ind:RateBase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grossPlantInServiceAmt rdf:type rdf:Property ;
    rdfs:label 'Gross Plant In Service Amt' ;
    rdfs:comment 'Total gross value of utility plant in service (before accumulated depreciation) included in the rate base calculation. Represents the original cost of all depreciable utility assets used and useful in providing regulated service, per FERC Uniform System of Accounts.' ;
    rdfs:domain ind:RateBase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isCwipIncluded rdf:type rdf:Property ;
    rdfs:label 'Is Cwip Included' ;
    rdfs:comment 'Indicates whether Construction Work in Progress (CWIP) is included in the rate base (True) per regulatory authorization, or excluded (False) with AFUDC capitalized instead. CWIP inclusion requires specific PUC or FERC authorization.' ;
    rdfs:domain ind:RateBase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isFercJurisdictional rdf:type rdf:Property ;
    rdfs:label 'Is Ferc Jurisdictional' ;
    rdfs:comment 'Indicates whether this rate base record falls under FERC jurisdiction (True) for interstate transmission and wholesale power sales, or under state PUC jurisdiction (False) for retail distribution and local gas distribution. Determines applicable regulatory accounting and reporting requirements.' ;
    rdfs:domain ind:RateBase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:netUtilityPlantAmt rdf:type rdf:Property ;
    rdfs:label 'Net Utility Plant Amt' ;
    rdfs:comment 'Net book value of utility plant in service, calculated as gross plant in service minus accumulated depreciation. Represents the primary component of the regulatory asset base (RAB) used in cost-of-service studies and Return on Equity (ROE) calculations.' ;
    rdfs:domain ind:RateBase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:plantInServiceDate rdf:type rdf:Property ;
    rdfs:label 'Plant In Service Date' ;
    rdfs:comment 'The date as of which the utility plant in service balance is measured for inclusion in the rate base. Typically the last day of the test year or a specific date established by the regulatory commission for the cost-of-service study.' ;
    rdfs:domain ind:RateBase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rateBaseNumber rdf:type rdf:Property ;
    rdfs:label 'Rate Base Number' ;
    rdfs:comment 'Externally-known business identifier for the rate base record, used in regulatory filings, cost-of-service studies, and rate case submissions to the Public Utility Commission (PUC). Typically formatted as a combination of jurisdiction code, rate class, and test year (e.g., CA-RES-2024).' ;
    rdfs:domain ind:RateBase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateBaseStatus rdf:type rdf:Property ;
    rdfs:label 'Rate Base Status' ;
    rdfs:comment 'Current lifecycle status of the rate base record within the regulatory filing process. Tracks progression from internal draft preparation through regulatory filing, commission approval, and potential supersession by a subsequent rate case.' ;
    rdfs:domain ind:RateBase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateClassCode rdf:type rdf:Property ;
    rdfs:label 'Rate Class Code' ;
    rdfs:comment 'Code identifying the customer rate class (e.g., residential, commercial, industrial, agricultural) to which this rate base component is allocated. Supports cost-of-service allocation studies and rate design for General Rate Case (GRC) filings.' ;
    rdfs:domain ind:RateBase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:returnOnRateBaseAmt rdf:type rdf:Property ;
    rdfs:label 'Return On Rate Base Amt' ;
    rdfs:comment 'The dollar amount of authorized return on the rate base, calculated as total rate base multiplied by the weighted average cost of capital (WACC). Represents the equity and debt return component of the revenue requirement.' ;
    rdfs:domain ind:RateBase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:revenueRequirementAmt rdf:type rdf:Property ;
    rdfs:label 'Revenue Requirement Amt' ;
    rdfs:comment 'The total annual revenue requirement associated with this rate base record, representing the amount the utility is authorized to collect from customers to recover its costs and earn a fair return. Calculated as return on rate base plus operating expenses plus depreciation plus taxes.' ;
    rdfs:domain ind:RateBase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:testYear rdf:type rdf:Property ;
    rdfs:label 'Test Year' ;
    rdfs:comment 'The calendar or fiscal year used as the basis for the rate case cost-of-service study. The test year establishes the period for which rate base, revenues, and expenses are measured to determine revenue requirements in a General Rate Case (GRC) filing.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:testYearType rdf:type rdf:Property ;
    rdfs:label 'Test Year Type' ;
    rdfs:comment 'Indicates whether the test year is based on historical actuals, a projected future period, or a hybrid combination of both. Regulatory commissions may require different test year types depending on jurisdiction rules.' ;
    rdfs:domain ind:RateBase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalRateBaseAmt rdf:type rdf:Property ;
    rdfs:label 'Total Rate Base Amt' ;
    rdfs:comment 'Total regulatory asset base (RAB) amount, representing the net investment on which the utility is entitled to earn a return. Calculated as net utility plant plus CWIP plus working capital allowance plus regulatory assets minus regulatory liabilities minus ADIT minus customer deposits. Used as the basis for ROE and revenue requirement calculations in rate cases.' ;
    rdfs:domain ind:RateBase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:weightedAvgCostOfCapitalRate rdf:type rdf:Property ;
    rdfs:label 'Weighted Avg Cost Of Capital Rate' ;
    rdfs:comment 'The overall weighted average cost of capital (WACC) approved or proposed for this rate base, blending the cost of debt and equity weighted by their respective proportions in the capital structure. Used to calculate the total return on rate base in revenue requirement studies.' ;
    rdfs:domain ind:RateBase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:workingCapitalAllowanceAmt rdf:type rdf:Property ;
    rdfs:label 'Working Capital Allowance Amt' ;
    rdfs:comment 'Allowance for working capital included in the rate base, representing the utility\'s investment in cash and materials needed to operate between billing cycles. Typically calculated using the lead-lag method or a fixed percentage of operating expenses as approved by the PUC.' ;
    rdfs:domain ind:RateBase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:relatedCapitalProjectFinanceCapexProjectId rdf:type rdf:Property ;
    rdfs:label 'Related Capital Project Finance Capex Project Id' ;
    rdfs:comment 'Reference to the capital project in the capital project accounting system (SAP PS) that originated the costs deferred into this regulatory asset. Enables traceability from the regulatory asset balance back to the underlying CAPEX project for rate base and depreciation analysis.' ;
    rdfs:domain ind:RegulatoryAsset ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinanceCapexProject .

ind:relatedFinanceCapexProjectId rdf:type rdf:Property ;
    rdfs:label 'Related Finance Capex Project Id' ;
    rdfs:comment 'Reference to the capital project in the capital project accounting system (SAP PS) that originated the costs deferred into this regulatory asset. Enables traceability from the regulatory asset balance back to the underlying CAPEX project for rate base and depreciation analysis.' ;
    rdfs:domain ind:RegulatoryAsset ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinanceCapexProject .

ind:accruedCarryingCharges rdf:type rdf:Property ;
    rdfs:label 'Accrued Carrying Charges' ;
    rdfs:comment 'The cumulative carrying charges (interest on the deferred balance) accrued on this regulatory asset or liability to date (in USD). Included in the total balance subject to recovery or refund through rates.' ;
    rdfs:domain ind:RegulatoryAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:annualAmortizationAmount rdf:type rdf:Property ;
    rdfs:label 'Annual Amortization Amount' ;
    rdfs:comment 'The annual dollar amount authorized for amortization (recovery or refund) of this regulatory asset or liability through customer rates (in USD). Derived from the approved amortization schedule in the rate order. Used for budgeting and CAPEX/OPEX tracking.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:authorizingJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Authorizing Jurisdiction' ;
    rdfs:comment 'The regulatory jurisdiction that authorized this regulatory asset or liability — Federal Energy Regulatory Commission (FERC) for interstate transmission, state Public Utility Commission (PUC) or Public Service Commission (PSC) for distribution, or both for dual-jurisdiction items.' ;
    rdfs:domain ind:RegulatoryAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:beginningBalance rdf:type rdf:Property ;
    rdfs:label 'Beginning Balance' ;
    rdfs:comment 'The opening balance of the regulatory asset or liability at the start of the current accounting period (in USD). Used as the baseline for amortization calculations and period-over-period variance analysis in FERC Form 1 and rate case filings.' ;
    rdfs:domain ind:RegulatoryAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capitalizationFlag rdf:type rdf:Property ;
    rdfs:label 'Capitalization Flag' ;
    rdfs:comment 'Indicates whether this regulatory asset is classified as a capital expenditure (CAPEX) item on the balance sheet (True) or an operating expenditure (OPEX) deferral (False). Affects rate base inclusion, depreciation treatment, and EBITDA reporting under FASB ASC 980 and FASB ASC 360.' ;
    rdfs:domain ind:RegulatoryAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:carryingChargeRate rdf:type rdf:Property ;
    rdfs:label 'Carrying Charge Rate' ;
    rdfs:comment 'The authorized carrying charge (interest) rate applied to the unamortized balance of this regulatory asset or liability between the deferral date and the recovery start date, expressed as a decimal (e.g., 0.060000 for 6.0%). Compensates the utility for the time value of money on deferred costs.' ;
    rdfs:domain ind:RegulatoryAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cumulativeAmortization rdf:type rdf:Property ;
    rdfs:label 'Cumulative Amortization' ;
    rdfs:comment 'Total amortization recognized to date against this regulatory asset or liability since its inception (in USD). Represents the portion already recovered from or refunded to ratepayers through rates. Used to reconcile the original authorized amount to the current balance.' ;
    rdfs:domain ind:RegulatoryAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deferralStartDate rdf:type rdf:Property ;
    rdfs:label 'Deferral Start Date' ;
    rdfs:comment 'The date on which costs or obligations began to be deferred into this regulatory asset or liability account. May differ from the authorization date if the regulator authorized retroactive deferral. Used for amortization period calculations.' ;
    rdfs:domain ind:RegulatoryAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:disallowanceRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Disallowance Risk Flag' ;
    rdfs:comment 'Indicates whether this regulatory asset carries a risk of partial or full disallowance by the regulator (True = at risk; False = recovery considered probable). Under FASB ASC 980, if recovery is no longer probable, the asset must be written off. Used for financial risk management and disclosure.' ;
    rdfs:domain ind:RegulatoryAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:incomeTaxEffect rdf:type rdf:Property ;
    rdfs:label 'Income Tax Effect' ;
    rdfs:comment 'The deferred income tax amount associated with this regulatory asset or liability (in USD), arising from temporary differences between book and tax treatment of the deferred costs. Required for FASB ASC 740 and ASC 980 interaction disclosures and FERC Form 1 tax normalization schedules.' ;
    rdfs:domain ind:RegulatoryAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nextRegulatoryReviewDate rdf:type rdf:Property ;
    rdfs:label 'Next Regulatory Review Date' ;
    rdfs:comment 'The scheduled date of the next regulatory commission review or rate case proceeding in which this regulatory asset or liability will be examined. Used for proactive regulatory compliance planning and rate case preparation.' ;
    rdfs:domain ind:RegulatoryAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:originalAuthorizedAmount rdf:type rdf:Property ;
    rdfs:label 'Original Authorized Amount' ;
    rdfs:comment 'The total dollar amount of costs or obligations originally authorized by the regulator for deferral and future recovery or refund (in USD). Establishes the ceiling for the regulatory asset or liability as approved in the rate order.' ;
    rdfs:domain ind:RegulatoryAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:originatingEventDescription rdf:type rdf:Property ;
    rdfs:label 'Originating Event Description' ;
    rdfs:comment 'Narrative description of the business event or circumstance that gave rise to this regulatory asset or liability (e.g., \'Hurricane Ida storm restoration costs incurred Q3 2021\', \'Pension obligation increase due to actuarial assumption change\', \'Nuclear decommissioning cost deferral per Order No. 2023-14\'). Supports audit trails and rate case testimony.' ;
    rdfs:domain ind:RegulatoryAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:probabilityOfRecovery rdf:type rdf:Property ;
    rdfs:label 'Probability Of Recovery' ;
    rdfs:comment 'Management\'s assessment of the probability that this regulatory asset will be recovered through future rates, using the FASB ASC 450 contingency framework. \'probable\' supports continued recognition; \'reasonably_possible\' or \'remote\' may trigger impairment or write-off under ASC 980.' ;
    rdfs:domain ind:RegulatoryAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pucDocketNumber rdf:type rdf:Property ;
    rdfs:label 'Puc Docket Number' ;
    rdfs:comment 'The official docket or case number assigned by the state Public Utility Commission (PUC) or Public Service Commission (PSC) authorizing the deferral or recovery of this regulatory asset or liability. Essential for regulatory compliance tracking and rate case filings.' ;
    rdfs:domain ind:RegulatoryAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateBaseEligible rdf:type rdf:Property ;
    rdfs:label 'Rate Base Eligible' ;
    rdfs:comment 'Indicates whether this regulatory asset is included in the Regulatory Asset Base (RAB) for rate-of-return calculations. True if the asset earns a return on investment in the rate base; False if it is a non-earning deferral. Critical for Return on Equity (ROE) and rate case calculations.' ;
    rdfs:domain ind:RegulatoryAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rateOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Rate Order Number' ;
    rdfs:comment 'The specific rate order or commission order number issued by the PUC, PSC, or FERC that authorizes the creation, recovery, or refund of this regulatory asset or liability. Provides the legal basis for FASB ASC 980 recognition.' ;
    rdfs:domain ind:RegulatoryAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoveryEndDate rdf:type rdf:Property ;
    rdfs:label 'Recovery End Date' ;
    rdfs:comment 'The scheduled date on which full amortization (recovery or refund) of this regulatory asset or liability is expected to be completed. Defines the end of the authorized recovery period. Nullable for open-ended or indefinite-term regulatory assets.' ;
    rdfs:domain ind:RegulatoryAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:recoveryMechanism rdf:type rdf:Property ;
    rdfs:label 'Recovery Mechanism' ;
    rdfs:comment 'The rate mechanism through which this regulatory asset is recovered from customers or the regulatory liability is refunded to customers. Examples include base rate inclusion, a specific rate rider, a surcharge, or a Fuel Adjustment Clause (FAC). Critical for revenue management and rate design.' ;
    rdfs:domain ind:RegulatoryAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoveryPeriodYears rdf:type rdf:Property ;
    rdfs:label 'Recovery Period Years' ;
    rdfs:comment 'The total authorized recovery or refund period in years as specified in the rate order. Used for straight-line amortization calculations and for projecting future rate impacts in Integrated Resource Plan (IRP) and rate case cost-of-service studies.' ;
    rdfs:domain ind:RegulatoryAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recoveryStartDate rdf:type rdf:Property ;
    rdfs:label 'Recovery Start Date' ;
    rdfs:comment 'The date on which amortization (recovery from customers or refund to customers) of this regulatory asset or liability commenced through rates. Marks the beginning of the authorized recovery period.' ;
    rdfs:domain ind:RegulatoryAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryAssetCategory rdf:type rdf:Property ;
    rdfs:label 'Regulatory Asset Category' ;
    rdfs:comment 'Business classification grouping the regulatory asset into a standard category such as deferred fuel costs, storm damage costs, pension and OPEB, income taxes recoverable, environmental remediation, asset retirement obligations, or demand-side management program costs. [ENUM-REF-CANDIDATE: deferred_fuel_costs|storm_damage|pension_opeb|income_tax_recoverable|environmental_remediation|asset_retirement_obligation|demand_side_management|rate_case_costs|other — promote to reference product]' ;
    rdfs:domain ind:RegulatoryAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryAssetStatus rdf:type rdf:Property ;
    rdfs:label 'Regulatory Asset Status' ;
    rdfs:comment 'Current lifecycle status of the regulatory asset or liability record. \'active\' indicates balance is being accumulated; \'amortizing\' indicates recovery or refund is in progress; \'fully_amortized\' indicates the balance has been fully recovered or refunded; \'pending_approval\' indicates awaiting regulatory authorization; \'suspended\' indicates recovery temporarily halted by order; \'written_off\' indicates disallowed by regulator.' ;
    rdfs:domain ind:RegulatoryAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:returnOnEquityRate rdf:type rdf:Property ;
    rdfs:label 'Return On Equity Rate' ;
    rdfs:comment 'The authorized Return on Equity (ROE) rate applied to this regulatory asset when it is included in the rate base. Expressed as a decimal (e.g., 0.095000 for 9.5%). Set by the authorizing rate order. Applicable only when rate_base_eligible is True.' ;
    rdfs:domain ind:RegulatoryAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:utilityServiceType rdf:type rdf:Property ;
    rdfs:label 'Utility Service Type' ;
    rdfs:comment 'Identifies whether this regulatory asset or liability relates to the electric utility operations, natural gas utility operations, or both. Required for jurisdictional separation in rate case cost-of-service studies and FERC Form 1 vs. FERC Form 2 reporting.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxProvisionId rdf:type rdf:Property ;
    rdfs:label 'Tax Provision Id' ;
    rdfs:comment 'Unique surrogate identifier for each income tax provision record in the lakehouse Silver layer. Primary key for the tax_provision data product.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:aditBeginningBalanceAmt rdf:type rdf:Property ;
    rdfs:label 'Adit Beginning Balance Amt' ;
    rdfs:comment 'Opening balance of accumulated deferred income taxes (ADIT) for the period. ADIT is a regulatory liability/asset on the rate base that offsets the utility\'s rate base per PUC orders. Critical for rate case revenue requirement and FERC Form 1 reporting.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:aditEndingBalanceAmt rdf:type rdf:Property ;
    rdfs:label 'Adit Ending Balance Amt' ;
    rdfs:comment 'Closing balance of accumulated deferred income taxes (ADIT) for the period after current-period deferred tax expense/benefit and ARAM amortization. Used directly in rate base calculations as a rate base offset per PUC-ordered treatment.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:aramAmortizationAmt rdf:type rdf:Property ;
    rdfs:label 'Aram Amortization Amt' ;
    rdfs:comment 'The period amortization of excess ADIT under the Average Rate Assumption Method (ARAM) as required by IRS normalization rules and FERC Order 849. Represents the amount of excess ADIT returned to customers through rate reductions in the current period.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bonusDepreciationAmt rdf:type rdf:Property ;
    rdfs:label 'Bonus Depreciation Amt' ;
    rdfs:comment 'Additional first-year bonus depreciation claimed under IRC §168(k) for qualifying utility property placed in service during the period. Creates large temporary differences and accelerates ADIT accumulation. Subject to IRS normalization rules for regulated utilities.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bookDepreciationAmt rdf:type rdf:Property ;
    rdfs:label 'Book Depreciation Amt' ;
    rdfs:comment 'Total GAAP straight-line depreciation for the period as recorded in SAP FI/CO asset accounting. Compared against tax depreciation to compute the accelerated depreciation temporary difference driving the deferred tax liability.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentTaxExpenseAmt rdf:type rdf:Property ;
    rdfs:label 'Current Tax Expense Amt' ;
    rdfs:comment 'The portion of total income tax expense attributable to taxes currently payable or refundable for the period. Represents the estimated tax liability on the current-year tax return before deferred items.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deferredTaxAssetAmt rdf:type rdf:Property ;
    rdfs:label 'Deferred Tax Asset Amt' ;
    rdfs:comment 'Gross deferred tax asset balance representing future tax benefits from deductible temporary differences (e.g., pension obligations, asset retirement obligations, regulatory liabilities). Before valuation allowance offset.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deferredTaxExpenseAmt rdf:type rdf:Property ;
    rdfs:label 'Deferred Tax Expense Amt' ;
    rdfs:comment 'The portion of total income tax expense attributable to temporary differences between book and tax basis of assets and liabilities. Positive value indicates deferred tax expense; negative indicates deferred tax benefit.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deferredTaxLiabilityAmt rdf:type rdf:Property ;
    rdfs:label 'Deferred Tax Liability Amt' ;
    rdfs:comment 'Gross deferred tax liability balance representing future tax obligations from taxable temporary differences (e.g., accelerated MACRS depreciation on utility plant, AFUDC equity). Primary driver of ADIT balance for regulated utilities.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:effectiveTaxRate rdf:type rdf:Property ;
    rdfs:label 'Effective Tax Rate' ;
    rdfs:comment 'The ratio of total income tax expense to pre-tax book income, expressed as a decimal (e.g., 0.2100 for 21%). Used in rate case cost-of-service studies and investor reporting. Computed as total_tax_expense_amt / pretax_income_amt.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:excessAditAmt rdf:type rdf:Property ;
    rdfs:label 'Excess Adit Amt' ;
    rdfs:comment 'The excess ADIT balance arising from the reduction in the federal corporate tax rate under the Tax Cuts and Jobs Act (TCJA) of 2017. Subject to ARAM (Average Rate Assumption Method) amortization and must be returned to customers per IRS normalization rules and PUC orders.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interestOnUtpAmt rdf:type rdf:Property ;
    rdfs:label 'Interest On Utp Amt' ;
    rdfs:comment 'Accrued interest expense on uncertain tax position reserves. Classified as income tax expense or interest expense per the entity\'s accounting policy election under ASC 740-10-45-25.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:investmentTaxCreditAmt rdf:type rdf:Property ;
    rdfs:label 'Investment Tax Credit Amt' ;
    rdfs:comment 'Deferred investment tax credit balance for regulated utilities that defer and amortize ITC over the life of the related asset per the deferral method (FASB ASC 980-740). Distinct from current-period ITC flow-through. Tracked separately for normalization compliance.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:jurisdictionType rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Type' ;
    rdfs:comment 'Classification of the taxing authority level: federal (IRS), state (state revenue department), local (municipal), or foreign. Determines applicable tax code, rate schedules, and regulatory reporting requirements.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalEntityCode rdf:type rdf:Property ;
    rdfs:label 'Legal Entity Code' ;
    rdfs:comment 'Code identifying the legal entity (subsidiary or consolidated parent) for which the tax provision is computed. Aligns with SAP company code structure and FERC Form 1 respondent entity.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netOperatingLossCarryforwardAmt rdf:type rdf:Property ;
    rdfs:label 'Net Operating Loss Carryforward Amt' ;
    rdfs:comment 'Cumulative net operating loss carryforward balance available to offset future taxable income. Post-TCJA, federal NOLs are carried forward indefinitely but limited to 80% of taxable income. Generates a deferred tax asset subject to valuation allowance assessment.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:normalizationComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Normalization Compliance Flag' ;
    rdfs:comment 'Indicates whether this tax provision record is in compliance with IRS normalization requirements for regulated utilities (IRC §168(i)(9)). Non-compliance can result in loss of accelerated depreciation benefits. Monitored for FERC and PUC regulatory filings.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:penaltiesOnUtpAmt rdf:type rdf:Property ;
    rdfs:label 'Penalties On Utp Amt' ;
    rdfs:comment 'Accrued tax penalties associated with uncertain tax positions. Classified as income tax expense per the entity\'s accounting policy election. Monitored for rate case disallowance risk.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:permanentDifferenceAmt rdf:type rdf:Property ;
    rdfs:label 'Permanent Difference Amt' ;
    rdfs:comment 'Net permanent differences between book income and taxable income that never reverse (e.g., tax-exempt interest, non-deductible penalties, AFUDC equity component). Key reconciling item in the effective tax rate reconciliation schedule.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pretaxIncomeAmt rdf:type rdf:Property ;
    rdfs:label 'Pretax Income Amt' ;
    rdfs:comment 'Total book income (GAAP) before income tax expense for the period and jurisdiction. Starting point for the effective tax rate reconciliation and current/deferred tax expense computation. Sourced from SAP FI/CO profit center reporting.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:provisionDate rdf:type rdf:Property ;
    rdfs:label 'Provision Date' ;
    rdfs:comment 'The business date on which the income tax provision was calculated and recorded. Represents the principal business event date for this transaction record. Typically the last day of the fiscal period.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:provisionNumber rdf:type rdf:Property ;
    rdfs:label 'Provision Number' ;
    rdfs:comment 'Externally-known business identifier for the tax provision record, typically sourced from SAP FI/CO tax calculation run (e.g., TP-2024-FED-Q4). Used for cross-system reconciliation and audit trail.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:provisionStatus rdf:type rdf:Property ;
    rdfs:label 'Provision Status' ;
    rdfs:comment 'Current lifecycle state of the tax provision record: draft (initial calculation), under_review (tax department review), approved (CFO/controller sign-off), filed (included in tax return), amended (restated), or closed (finalized and archived).' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:provisionType rdf:type rdf:Property ;
    rdfs:label 'Provision Type' ;
    rdfs:comment 'Classifies the nature of the provision calculation: annual (year-end), interim quarterly or monthly (ASC 740-270 estimated annual effective tax rate), true-up (post-filing adjustment), or amended (restated provision). [ENUM-REF-CANDIDATE: annual|interim_quarterly|interim_monthly|true_up|amended — promote to reference product]' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryLiabilityTaxEffectAmt rdf:type rdf:Property ;
    rdfs:label 'Regulatory Liability Tax Effect Amt' ;
    rdfs:comment 'The income tax effect of regulatory liabilities (e.g., excess ADIT returned to customers, over-recovered revenues) recognized under FASB ASC 980. Represents the deferred tax component of regulatory liabilities on the balance sheet.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stateApportionmentFactor rdf:type rdf:Property ;
    rdfs:label 'State Apportionment Factor' ;
    rdfs:comment 'The blended apportionment factor (sales/receipts, payroll, property — weighted per state formula) used to allocate multi-state income to a specific state jurisdiction. Expressed as a decimal (e.g., 0.4523 for 45.23%). Required for state income tax provision calculations.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:statutoryTaxRate rdf:type rdf:Property ;
    rdfs:label 'Statutory Tax Rate' ;
    rdfs:comment 'The enacted statutory income tax rate applicable to the legal entity for the jurisdiction and fiscal year (e.g., 0.2100 for 21% federal corporate rate post-TCJA). Used as the baseline for effective tax rate reconciliation.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxCreditAmt rdf:type rdf:Property ;
    rdfs:label 'Tax Credit Amt' ;
    rdfs:comment 'Total income tax credits recognized in the period, including production tax credits (PTC) for wind/solar generation, investment tax credits (ITC) for renewable energy assets, and R&D credits. Reduces current tax expense dollar-for-dollar.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxDepreciationAmt rdf:type rdf:Property ;
    rdfs:label 'Tax Depreciation Amt' ;
    rdfs:comment 'Total tax depreciation claimed for the period under IRS Modified Accelerated Cost Recovery System (MACRS). Typically exceeds book depreciation for utility plant, creating the primary taxable temporary difference and deferred tax liability for regulated utilities.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxReturnType rdf:type rdf:Property ;
    rdfs:label 'Tax Return Type' ;
    rdfs:comment 'Indicates whether the provision is computed on a consolidated federal return, separate company basis, combined state return, or unitary state return. Critical for apportionment factor allocation and intercompany tax sharing agreement calculations.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:temporaryDifferenceAmt rdf:type rdf:Property ;
    rdfs:label 'Temporary Difference Amt' ;
    rdfs:comment 'Net aggregate temporary difference between book and tax basis of assets and liabilities for the period and jurisdiction. Drives the deferred tax expense/benefit calculation. Includes accelerated depreciation, regulatory assets/liabilities, and pension timing differences.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalTaxExpenseAmt rdf:type rdf:Property ;
    rdfs:label 'Total Tax Expense Amt' ;
    rdfs:comment 'Sum of current and deferred income tax expense for the period. Equals the total provision for income taxes reported on the GAAP income statement. Used in EBITDA reconciliation and rate case revenue requirement calculations.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:uncertainTaxPositionAmt rdf:type rdf:Property ;
    rdfs:label 'Uncertain Tax Position Amt' ;
    rdfs:comment 'Reserve for uncertain tax positions (UTPs) under the more-likely-than-not recognition threshold. Represents the cumulative liability for tax positions that may not be sustained upon IRS or state examination. Disclosed in financial statement footnotes.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:valuationAllowanceAmt rdf:type rdf:Property ;
    rdfs:label 'Valuation Allowance Amt' ;
    rdfs:comment 'Valuation allowance recorded against gross deferred tax assets when it is more likely than not that some portion will not be realized. Reduces net deferred tax asset on the balance sheet per ASC 740 realizability assessment.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:parentWbsElementId rdf:type rdf:Property ;
    rdfs:label 'Parent Wbs Element Id' ;
    rdfs:comment 'Self-referencing identifier pointing to the immediate parent WBS element in the hierarchical project structure. Null for top-level (Level 1) WBS elements. Enables traversal of the full WBS hierarchy for roll-up cost reporting.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WbsElement .

ind:primaryWbsResponsibleEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Wbs Responsible Employee Id' ;
    rdfs:comment 'Reference to the employee (project manager or WBS element owner) accountable for cost control and delivery of this WBS element scope. Sourced from SAP HR.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:accountAssignmentElementFlag rdf:type rdf:Property ;
    rdfs:label 'Account Assignment Element Flag' ;
    rdfs:comment 'Indicates whether this WBS element can be used as an account assignment object on purchase orders, time confirmations, and journal entries in SAP. True = direct cost postings allowed; False = summary/header level only.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:actualCostAmount rdf:type rdf:Property ;
    rdfs:label 'Actual Cost Amount' ;
    rdfs:comment 'Total actual costs posted to this WBS element to date in US dollars, including labor, materials, equipment, and contractor charges. Sourced from SAP CO actual cost line items. Used for CAPEX spend tracking and budget variance reporting.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualFinishDate rdf:type rdf:Property ;
    rdfs:label 'Actual Finish Date' ;
    rdfs:comment 'The date on which work on this WBS element was actually completed. Triggers technical completion status and initiates the asset settlement process to fixed assets.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:billingElementFlag rdf:type rdf:Property ;
    rdfs:label 'Billing Element Flag' ;
    rdfs:comment 'Indicates whether this WBS element is designated as a billing element in SAP PS, enabling it to be used as a reference for customer billing (e.g., for developer-funded projects or contributed capital work orders). True = billing element; False = internal cost tracking only.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:committedCostAmount rdf:type rdf:Property ;
    rdfs:label 'Committed Cost Amount' ;
    rdfs:comment 'Total value of open purchase orders and contracts committed against this WBS element but not yet invoiced or posted as actual costs. Represents financial obligations for cash flow forecasting and budget availability management.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:driverCategory rdf:type rdf:Property ;
    rdfs:label 'Driver Category' ;
    rdfs:comment 'Business driver justifying this capital investment at the WBS element level. Used for rate case cost-of-service studies to demonstrate prudency and necessity of capital expenditures to regulators. \'safety\' = OSHA/PHMSA compliance; \'reliability\' = SAIDI/SAIFI improvement; \'regulatory\' = FERC/NERC/PUC mandate. [ENUM-REF-CANDIDATE: safety|reliability|regulatory|growth|efficiency|environmental|customer_request — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forecastCostAmount rdf:type rdf:Property ;
    rdfs:label 'Forecast Cost Amount' ;
    rdfs:comment 'Project manager\'s current estimate of total cost at completion for this WBS element, incorporating actuals to date plus remaining work estimate. Used for EAC (Estimate at Completion) reporting and CAPEX forecast submissions to regulators.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forecastFinishDate rdf:type rdf:Property ;
    rdfs:label 'Forecast Finish Date' ;
    rdfs:comment 'Project manager\'s current estimate of the completion date for this WBS element, updated periodically during project execution. Used for CAPEX in-service date forecasting submitted to regulators and for IRP planning.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:originalBudgetAmount rdf:type rdf:Property ;
    rdfs:label 'Original Budget Amount' ;
    rdfs:comment 'The initial approved budget for this WBS element at the time of project authorization, before any budget supplements or transfers. Enables tracking of budget changes over the project lifecycle for governance and audit purposes.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:planningElementFlag rdf:type rdf:Property ;
    rdfs:label 'Planning Element Flag' ;
    rdfs:comment 'Indicates whether this WBS element is designated as a planning element in SAP PS, allowing cost planning and budget assignment at this level. True = planning element; False = cost collection only without direct budget assignment.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:plantType rdf:type rdf:Property ;
    rdfs:label 'Plant Type' ;
    rdfs:comment 'Classification of the utility plant type for this WBS element per FERC Uniform System of Accounts. Drives rate base inclusion, depreciation rate assignment, and cost-of-service study allocation.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectId rdf:type rdf:Property ;
    rdfs:label 'Project Id' ;
    rdfs:comment 'Reference to the parent capital project (SAP PS Project Definition) under which this WBS element is organized. Every WBS element belongs to exactly one project.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:settledAmount rdf:type rdf:Property ;
    rdfs:label 'Settled Amount' ;
    rdfs:comment 'Total costs that have been settled from this WBS element to fixed assets (AuC — Asset under Construction) or other receivers upon project completion. Represents the capitalized value transferred to the Regulatory Asset Base (RAB).' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:settlementRule rdf:type rdf:Property ;
    rdfs:label 'Settlement Rule' ;
    rdfs:comment 'Defines how costs accumulated on this WBS element are to be settled to receivers (fixed assets, cost centers, or other WBS elements). \'full_settlement\' = 100% to one receiver; \'partial_settlement\' = split across multiple receivers; \'periodic_settlement\' = settled on a recurring schedule; \'no_settlement\' = costs remain on WBS (e.g., expensed OPEX).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statisticalFlag rdf:type rdf:Property ;
    rdfs:label 'Statistical Flag' ;
    rdfs:comment 'Indicates whether this WBS element is statistical in SAP CO, meaning costs are posted for reporting purposes only and do not affect the primary cost object. Used for management reporting overlays without impacting financial accounting.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:userStatus rdf:type rdf:Property ;
    rdfs:label 'User Status' ;
    rdfs:comment 'Business-defined user status applied to the WBS element beyond the SAP system status (e.g., \'APPR\' = Approved, \'PEND\' = Pending Approval, \'HOLD\' = On Hold, \'CANC\' = Cancelled). Configured per company-specific status profiles in SAP PS. [ENUM-REF-CANDIDATE: approved|pending_approval|on_hold|cancelled|in_review|deferred — promote to reference product]' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wbsElementDescription rdf:type rdf:Property ;
    rdfs:label 'Wbs Element Description' ;
    rdfs:comment 'Short descriptive text explaining the scope of work represented by this WBS element (e.g., \'Substation 12kV Bus Replacement — Civil Works\'). Used in project status reports and CAPEX tracking dashboards.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wbsElementStatus rdf:type rdf:Property ;
    rdfs:label 'Wbs Element Status' ;
    rdfs:comment 'Current system status of the WBS element in SAP PS lifecycle. \'created\' = defined but not yet approved for spending; \'released\' = approved and open for cost postings; \'technically_complete\' = work done, pending financial close; \'closed\' = fully settled and closed; \'locked\' = temporarily blocked for postings; \'deleted\' = logically removed.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workCategory rdf:type rdf:Property ;
    rdfs:label 'Work Category' ;
    rdfs:comment 'Functional category of work performed under this WBS element (e.g., \'new_construction\', \'replacement\', \'upgrade\', \'relocation\', \'decommission\', \'study\', \'land_acquisition\'). Used for asset capitalization classification and rate base analysis. [ENUM-REF-CANDIDATE: new_construction|replacement|upgrade|relocation|decommission|study|land_acquisition|emergency — promote to reference product]' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capacityResourceId rdf:type rdf:Property ;
    rdfs:label 'Capacity Resource Id' ;
    rdfs:comment 'Unique identifier for the capacity resource registered in RTO/ISO capacity markets. Primary key.' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:accreditedCapacityMwIcap rdf:type rdf:Property ;
    rdfs:label 'Accredited Capacity Mw Icap' ;
    rdfs:comment 'The installed capacity (ICAP) value in megawatts (MW) accredited by the RTO/ISO, representing the maximum capacity the resource can provide under reference conditions.' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:accreditedCapacityMwUcap rdf:type rdf:Property ;
    rdfs:label 'Accredited Capacity Mw Ucap' ;
    rdfs:comment 'The unforced capacity (UCAP) value in megawatts (MW), which is ICAP adjusted for the resource\'s expected forced outage rate (EFORd), representing the expected available capacity.' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bonusAmountUsd rdf:type rdf:Property ;
    rdfs:label 'Bonus Amount Usd' ;
    rdfs:comment 'The bonus payment amount in USD earned by the resource for exceeding performance requirements during shortage events or peak periods.' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capacityInterconnectionRights rdf:type rdf:Property ;
    rdfs:label 'Capacity Interconnection Rights' ;
    rdfs:comment 'The type of interconnection rights held by this capacity resource: firm (full deliverability), non-firm (energy-only), or conditional (subject to transmission constraints).' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capacityObligationMw rdf:type rdf:Property ;
    rdfs:label 'Capacity Obligation Mw' ;
    rdfs:comment 'The capacity obligation in megawatts (MW) that this resource has committed to provide in the capacity market for the delivery period.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capacityProductType rdf:type rdf:Property ;
    rdfs:label 'Capacity Product Type' ;
    rdfs:comment 'The capacity product type offered by this resource: base capacity, annual capacity, extended summer capacity, or capacity performance (CP) product.' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capacityRevenueForecastUsd rdf:type rdf:Property ;
    rdfs:label 'Capacity Revenue Forecast Usd' ;
    rdfs:comment 'The forecasted capacity revenue in USD for this resource for the current delivery year, used for financial planning and budgeting.' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capacityTransferRights rdf:type rdf:Property ;
    rdfs:label 'Capacity Transfer Rights' ;
    rdfs:comment 'Indicates whether the capacity obligation can be transferred to another resource or market participant.' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capacityZone rdf:type rdf:Property ;
    rdfs:label 'Capacity Zone' ;
    rdfs:comment 'The geographic capacity zone or locational deliverability area (LDA) where this resource is registered for capacity obligations.' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clearedCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Cleared Capacity Mw' ;
    rdfs:comment 'The capacity in megawatts (MW) that cleared in the most recent capacity auction for this resource.' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:clearedCapacityPriceUsdPerMwDay rdf:type rdf:Property ;
    rdfs:label 'Cleared Capacity Price Usd Per Mw Day' ;
    rdfs:comment 'The cleared capacity price in USD per MW-day that this resource received in the capacity auction.' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deliveryYear rdf:type rdf:Property ;
    rdfs:label 'Delivery Year' ;
    rdfs:comment 'The delivery year (or planning year) for which this capacity resource is committed, typically in format YYYY/YYYY (e.g., 2024/2025).' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectiveLoadCarryingCapabilityMw rdf:type rdf:Property ;
    rdfs:label 'Effective Load Carrying Capability Mw' ;
    rdfs:comment 'The effective load carrying capability (ELCC) in megawatts (MW) for renewable and intermittent resources, representing the equivalent firm capacity contribution based on probabilistic reliability analysis.' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fuelType rdf:type rdf:Property ;
    rdfs:label 'Fuel Type' ;
    rdfs:comment 'The primary fuel type or energy source for this capacity resource. [ENUM-REF-CANDIDATE: coal|natural_gas|nuclear|hydro|wind|solar|oil|biomass|storage — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastPerformanceAssessmentDate rdf:type rdf:Property ;
    rdfs:label 'Last Performance Assessment Date' ;
    rdfs:comment 'The date of the most recent performance assessment conducted for this capacity resource.' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mustOfferObligation rdf:type rdf:Property ;
    rdfs:label 'Must Offer Obligation' ;
    rdfs:comment 'Indicates whether this capacity resource has a must-offer obligation requiring it to offer its capacity into the energy market during the delivery period.' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:netPerformancePaymentUsd rdf:type rdf:Property ;
    rdfs:label 'Net Performance Payment Usd' ;
    rdfs:comment 'The net performance payment in USD for the assessment period, calculated as bonuses minus penalties.' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nextPerformanceAssessmentDate rdf:type rdf:Property ;
    rdfs:label 'Next Performance Assessment Date' ;
    rdfs:comment 'The scheduled date for the next performance assessment of this capacity resource.' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:penaltyAmountUsd rdf:type rdf:Property ;
    rdfs:label 'Penalty Amount Usd' ;
    rdfs:comment 'The penalty amount in USD assessed against the resource for failing to meet capacity obligations during performance assessment intervals.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:performanceAssessmentInterval rdf:type rdf:Property ;
    rdfs:label 'Performance Assessment Interval' ;
    rdfs:comment 'The frequency at which this capacity resource\'s performance is assessed against its capacity obligation.' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualificationStatus rdf:type rdf:Property ;
    rdfs:label 'Qualification Status' ;
    rdfs:comment 'The current qualification status of the capacity resource in the RTO/ISO capacity market.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualificationTestDate rdf:type rdf:Property ;
    rdfs:label 'Qualification Test Date' ;
    rdfs:comment 'The date when the capacity qualification test was performed to verify the resource\'s capability.' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:qualificationTestResultMw rdf:type rdf:Property ;
    rdfs:label 'Qualification Test Result Mw' ;
    rdfs:comment 'The measured capacity output in megawatts (MW) achieved during the qualification test.' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:qualificationTestStatus rdf:type rdf:Property ;
    rdfs:label 'Qualification Test Status' ;
    rdfs:comment 'The outcome status of the capacity qualification test.' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registrationStatus rdf:type rdf:Property ;
    rdfs:label 'Registration Status' ;
    rdfs:comment 'The current registration status of the capacity resource in the RTO/ISO system.' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resourceType rdf:type rdf:Property ;
    rdfs:label 'Resource Type' ;
    rdfs:comment 'The type of capacity resource: generation (traditional power plant), demand response (load reduction), energy efficiency, or storage (battery/pumped hydro).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rtoIsoName rdf:type rdf:Property ;
    rdfs:label 'Rto Iso Name' ;
    rdfs:comment 'The name of the RTO or ISO where this capacity resource is registered. [ENUM-REF-CANDIDATE: PJM|MISO|NYISO|ISO-NE|CAISO|ERCOT|SPP — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rtoIsoRegistrationNumber rdf:type rdf:Property ;
    rdfs:label 'Rto Iso Registration Number' ;
    rdfs:comment 'The unique registration identifier assigned by the RTO/ISO for this capacity resource in their capacity market system.' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seasonalCapacityFlag rdf:type rdf:Property ;
    rdfs:label 'Seasonal Capacity Flag' ;
    rdfs:comment 'Indicates whether this is a seasonal capacity resource with availability limited to specific seasons (e.g., summer-only peaking units).' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:emissionsRecordId rdf:type rdf:Property ;
    rdfs:label 'Emissions Record Id' ;
    rdfs:comment 'Unique identifier for the emissions record. Primary key for this transactional emissions data entity.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:complianceOfficerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Compliance Officer Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Emissions compliance reports must attribute the responsible compliance officer employee for audit trails and regulator filings.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:permitId rdf:type rdf:Property ;
    rdfs:label 'Permit Id' ;
    rdfs:comment 'Identifier for the EPA or state air quality permit governing emissions limits for this generating unit. Links emissions data to regulatory compliance requirements.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Permit .

ind:cemsMonitorCode rdf:type rdf:Property ;
    rdfs:label 'Cems Monitor Code' ;
    rdfs:comment 'EPA-assigned identifier for the continuous emissions monitoring system that recorded this data. Required for EPA compliance reporting and data quality assurance.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certificationStatus rdf:type rdf:Property ;
    rdfs:label 'Certification Status' ;
    rdfs:comment 'Certification status of the emissions data by a qualified professional engineer or responsible official as required by EPA regulations.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certifiedBy rdf:type rdf:Property ;
    rdfs:label 'Certified By' ;
    rdfs:comment 'Name of the qualified professional engineer or responsible official who certified the accuracy of this emissions data for regulatory submission.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:co2EmissionsTons rdf:type rdf:Property ;
    rdfs:label 'Co2 Emissions Tons' ;
    rdfs:comment 'Total carbon dioxide emissions measured in tons for the reporting period. Required for EPA Greenhouse Gas Reporting Program and climate change reporting.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:co2RatePerMmbtu rdf:type rdf:Property ;
    rdfs:label 'Co2 Rate Per Mmbtu' ;
    rdfs:comment 'Carbon dioxide emissions rate expressed as tons per million British thermal units of heat input. Alternative carbon intensity metric based on fuel consumption.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:co2RatePerMwh rdf:type rdf:Property ;
    rdfs:label 'Co2 Rate Per Mwh' ;
    rdfs:comment 'Carbon dioxide emissions rate expressed as tons per megawatt-hour of gross generation. Used for carbon intensity benchmarking and climate reporting.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:co2eEmissionsTons rdf:type rdf:Property ;
    rdfs:label 'Co2e Emissions Tons' ;
    rdfs:comment 'Total greenhouse gas emissions expressed as carbon dioxide equivalent in tons, accounting for global warming potential of all GHGs. Used for comprehensive climate impact reporting.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:controlEquipmentStatus rdf:type rdf:Property ;
    rdfs:label 'Control Equipment Status' ;
    rdfs:comment 'Operational status of emissions control equipment (scrubbers, baghouses, SCR systems) during the reporting period. Impacts emissions levels and compliance.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataQualityIndicator rdf:type rdf:Property ;
    rdfs:label 'Data Quality Indicator' ;
    rdfs:comment 'Indicates the quality and reliability of the emissions data. Valid = measured data, substitute = backup monitoring, missing = data gap, estimated = calculated approximation.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emissionsRecordNumber rdf:type rdf:Property ;
    rdfs:label 'Emissions Record Number' ;
    rdfs:comment 'Business identifier for the emissions record, typically used for external reporting and audit trail purposes.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exceedanceFlag rdf:type rdf:Property ;
    rdfs:label 'Exceedance Flag' ;
    rdfs:comment 'Boolean flag indicating whether any emissions exceeded permit limits during the reporting period. True = exceedance occurred, False = within limits.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exceedanceReason rdf:type rdf:Property ;
    rdfs:label 'Exceedance Reason' ;
    rdfs:comment 'Detailed explanation of the reason for any permit exceedance, including contributing factors and corrective actions taken. Required for EPA compliance reporting.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grossGenerationMwh rdf:type rdf:Property ;
    rdfs:label 'Gross Generation Mwh' ;
    rdfs:comment 'Total gross electrical energy generated measured in megawatt-hours for the reporting period. Used to calculate emissions rates per unit of energy produced.' ;
    rdfs:domain ind:Generation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:heatInputMmbtu rdf:type rdf:Property ;
    rdfs:label 'Heat Input Mmbtu' ;
    rdfs:comment 'Total heat input to the generating unit measured in million British thermal units for the reporting period. Used to calculate emissions rates and heat rate efficiency.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mercuryEmissionsLbs rdf:type rdf:Property ;
    rdfs:label 'Mercury Emissions Lbs' ;
    rdfs:comment 'Total mercury emissions measured in pounds for the reporting period. Required for EPA Mercury and Air Toxics Standards (MATS) compliance.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:monitoringMethod rdf:type rdf:Property ;
    rdfs:label 'Monitoring Method' ;
    rdfs:comment 'The method used to measure or calculate emissions for this record. CEMS = Continuous Emissions Monitoring System, PEMS = Predictive Emissions Monitoring System.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:noxEmissionsTons rdf:type rdf:Property ;
    rdfs:label 'Nox Emissions Tons' ;
    rdfs:comment 'Total nitrogen oxides emissions measured in tons for the reporting period. Required for EPA NOx Budget Trading Program and state air quality compliance.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:noxRatePerMmbtu rdf:type rdf:Property ;
    rdfs:label 'Nox Rate Per Mmbtu' ;
    rdfs:comment 'Nitrogen oxides emissions rate expressed as pounds per million British thermal units of heat input. Key compliance metric for EPA NOx emission standards.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:operatingHours rdf:type rdf:Property ;
    rdfs:label 'Operating Hours' ;
    rdfs:comment 'Total number of hours the generating unit operated during the reporting period. Used to calculate availability and emissions intensity metrics.' ;
    rdfs:domain ind:Generation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:particulateMatterEmissionsLbs rdf:type rdf:Property ;
    rdfs:label 'Particulate Matter Emissions Lbs' ;
    rdfs:comment 'Total particulate matter emissions measured in pounds for the reporting period. Includes PM2.5 and PM10 for air quality compliance.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:permitLimitNoxTons rdf:type rdf:Property ;
    rdfs:label 'Permit Limit Nox Tons' ;
    rdfs:comment 'Maximum allowable nitrogen oxides emissions in tons as specified in the air quality permit for the reporting period. Used to assess compliance status.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:permitLimitSo2Tons rdf:type rdf:Property ;
    rdfs:label 'Permit Limit So2 Tons' ;
    rdfs:comment 'Maximum allowable sulfur dioxide emissions in tons as specified in the air quality permit for the reporting period. Used to assess compliance status.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reportingJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Reporting Jurisdiction' ;
    rdfs:comment 'The regulatory jurisdiction (EPA region, state, or local air quality district) to which this emissions data must be reported. Determines applicable reporting requirements.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingPeriodEnd rdf:type rdf:Property ;
    rdfs:label 'Reporting Period End' ;
    rdfs:comment 'The end date and time of the emissions reporting period. Represents the conclusion of the measurement window for this emissions data.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingPeriodStart rdf:type rdf:Property ;
    rdfs:label 'Reporting Period Start' ;
    rdfs:comment 'The start date and time of the emissions reporting period. Represents the beginning of the measurement window for this emissions data.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:so2EmissionsTons rdf:type rdf:Property ;
    rdfs:label 'So2 Emissions Tons' ;
    rdfs:comment 'Total sulfur dioxide emissions measured in tons for the reporting period. Critical for EPA Clean Air Act compliance and acid rain program reporting.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:so2RatePerMmbtu rdf:type rdf:Property ;
    rdfs:label 'So2 Rate Per Mmbtu' ;
    rdfs:comment 'Sulfur dioxide emissions rate expressed as pounds per million British thermal units of heat input. Key compliance metric for EPA emission standards.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:energyOutputId rdf:type rdf:Property ;
    rdfs:label 'Energy Output Id' ;
    rdfs:comment 'Unique identifier for the energy output record. Primary key for this table.' ;
    rdfs:domain ind:Generation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EnergyOutput .

ind:emsDispatchInstructionId rdf:type rdf:Property ;
    rdfs:label 'Ems Dispatch Instruction Id' ;
    rdfs:comment 'Reference to the EMS dispatch instruction that commanded this generation output level. Links generation output to grid operations dispatch decisions.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EmsDispatchInstruction .

ind:rateScheduleVersionId rdf:type rdf:Property ;
    rdfs:label 'Rate Schedule Version Id' ;
    rdfs:comment 'Foreign key linking to product.rate_schedule_version. Business justification: Energy output records reference the specific rate schedule version applied during settlement, needed for audit trails and regulatory filing.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RateScheduleVersion .

ind:auxiliaryConsumptionMwh rdf:type rdf:Property ;
    rdfs:label 'Auxiliary Consumption Mwh' ;
    rdfs:comment 'Electrical energy consumed by station auxiliary equipment (pumps, fans, controls, lighting) during the generation process, measured in Megawatt-hours (MWh).' ;
    rdfs:domain ind:EnergyOutput ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capacityFactorPercent rdf:type rdf:Property ;
    rdfs:label 'Capacity Factor Percent' ;
    rdfs:comment 'Ratio of actual energy output to maximum possible output over the measurement interval, expressed as a percentage. Key performance indicator for generation asset utilization.' ;
    rdfs:domain ind:Generation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:curtailmentFlag rdf:type rdf:Property ;
    rdfs:label 'Curtailment Flag' ;
    rdfs:comment 'Boolean flag indicating whether this generation output was curtailed (reduced below available capacity) due to grid constraints, economic dispatch, or renewable integration limits.' ;
    rdfs:domain ind:EnergyOutput ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:curtailmentReason rdf:type rdf:Property ;
    rdfs:label 'Curtailment Reason' ;
    rdfs:comment 'Reason code for generation curtailment if curtailment_flag is true. Indicates whether curtailment was due to transmission limits, economic dispatch, or other operational factors.' ;
    rdfs:domain ind:EnergyOutput ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataQualityFlag rdf:type rdf:Property ;
    rdfs:label 'Data Quality Flag' ;
    rdfs:comment 'Quality indicator for this measurement record. Good indicates validated telemetry; suspect/bad indicate potential sensor or communication issues; estimated/manual indicate non-telemetry sources.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emissionsCo2Tons rdf:type rdf:Property ;
    rdfs:label 'Emissions Co2 Tons' ;
    rdfs:comment 'Estimated carbon dioxide (CO2) emissions in tons resulting from this energy generation. Calculated based on fuel consumption and emission factors. Used for environmental reporting and carbon accounting.' ;
    rdfs:domain ind:Generation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:intervalDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Interval Duration Minutes' ;
    rdfs:comment 'The duration of the measurement interval in minutes. Common values include 5, 15, 60 for sub-hourly, quarter-hourly, and hourly intervals.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:intervalEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Interval End Timestamp' ;
    rdfs:comment 'The ending timestamp of the measurement interval for this energy output record. Used for interval-based aggregation and settlement.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:intervalStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Interval Start Timestamp' ;
    rdfs:comment 'The beginning timestamp of the measurement interval for this energy output record. Used for interval-based aggregation and settlement.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:isRenewable rdf:type rdf:Property ;
    rdfs:label 'Is Renewable' ;
    rdfs:comment 'Boolean flag indicating whether this energy output qualifies as renewable energy under applicable regulatory definitions. Used for REC tracking and renewable portfolio standard (RPS) compliance.' ;
    rdfs:domain ind:EnergyOutput ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lmpEnergyPrice rdf:type rdf:Property ;
    rdfs:label 'Lmp Energy Price' ;
    rdfs:comment 'Locational Marginal Price (LMP) energy component in dollars per MWh at the settlement point for this interval. Used for revenue calculation and market settlement.' ;
    rdfs:domain ind:EnergyOutput ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:marketType rdf:type rdf:Property ;
    rdfs:label 'Market Type' ;
    rdfs:comment 'Type of energy market in which this generation was dispatched or settled. Day-ahead market (DAM) vs real-time market (RTM) vs bilateral contract vs self-scheduled.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nameplateCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Nameplate Capacity Mw' ;
    rdfs:comment 'Maximum rated continuous output capacity of the generating unit in Megawatts (MW) as specified by the manufacturer. Used for capacity factor and performance calculations.' ;
    rdfs:domain ind:Generation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netGenerationMwh rdf:type rdf:Property ;
    rdfs:label 'Net Generation Mwh' ;
    rdfs:comment 'Net electrical energy delivered to the grid after subtracting auxiliary consumption, measured in Megawatt-hours (MWh). This is the energy available for sale or transmission.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outputVarianceMw rdf:type rdf:Property ;
    rdfs:label 'Output Variance Mw' ;
    rdfs:comment 'Difference between actual net generation and scheduled output in Megawatts (MW). Positive values indicate over-generation; negative values indicate under-generation.' ;
    rdfs:domain ind:EnergyOutput ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:piPointTag rdf:type rdf:Property ;
    rdfs:label 'Pi Point Tag' ;
    rdfs:comment 'Unique identifier for the PI point in the OSIsoft PI Historian system. Used for direct lookup and integration with real-time operational systems.' ;
    rdfs:domain ind:EnergyOutput ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:powerFactor rdf:type rdf:Property ;
    rdfs:label 'Power Factor' ;
    rdfs:comment 'Ratio of real power (MW) to apparent power (MVA), indicating the efficiency of power delivery. Values range from 0 to 1, with higher values indicating more efficient power delivery.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reactivePowerMvar rdf:type rdf:Property ;
    rdfs:label 'Reactive Power Mvar' ;
    rdfs:comment 'Reactive power output measured in Megavolt-Amperes Reactive (MVAr). Used for voltage support and grid stability, not sold as energy but critical for transmission operations.' ;
    rdfs:domain ind:EnergyOutput ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rtoIsoCode rdf:type rdf:Property ;
    rdfs:label 'Rto Iso Code' ;
    rdfs:comment 'Code identifying the RTO or ISO market in which this generation occurred. Used for settlement reconciliation and market reporting (e.g., PJM, CAISO, ERCOT, MISO, NYISO, ISO-NE, SPP).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduledOutputMw rdf:type rdf:Property ;
    rdfs:label 'Scheduled Output Mw' ;
    rdfs:comment 'Scheduled or expected generation output in Megawatts (MW) for this interval based on day-ahead commitments or dispatch instructions. Used for variance analysis.' ;
    rdfs:domain ind:EnergyOutput ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:settlementPointName rdf:type rdf:Property ;
    rdfs:label 'Settlement Point Name' ;
    rdfs:comment 'Name of the settlement or pricing node where this generation is injected into the grid. Used for locational marginal price (LMP) matching and financial settlement.' ;
    rdfs:domain ind:EnergyOutput ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unitStatus rdf:type rdf:Property ;
    rdfs:label 'Unit Status' ;
    rdfs:comment 'Current operational status of the generating unit at the time of measurement. Indicates whether the unit is actively generating, offline, or in transition. [ENUM-REF-CANDIDATE: online|offline|startup|shutdown|standby|maintenance|forced_outage|planned_outage — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Generation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fuelConsumptionId rdf:type rdf:Property ;
    rdfs:label 'Fuel Consumption Id' ;
    rdfs:comment 'Unique identifier for the fuel consumption transaction record.' ;
    rdfs:domain ind:FuelConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fuelReceiptId rdf:type rdf:Property ;
    rdfs:label 'Fuel Receipt Id' ;
    rdfs:comment 'Reference to the fuel delivery receipt or shipment that supplied this consumed fuel.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FuelReceipt .

ind:supplierVendorId rdf:type rdf:Property ;
    rdfs:label 'Supplier Vendor Id' ;
    rdfs:comment 'Reference to the supplier or vendor that provided the consumed fuel.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:ashContentPercent rdf:type rdf:Property ;
    rdfs:label 'Ash Content Percent' ;
    rdfs:comment 'Percentage of ash content in the consumed fuel (primarily applicable to coal), used for operational efficiency and waste management.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:consumptionDate rdf:type rdf:Property ;
    rdfs:label 'Consumption Date' ;
    rdfs:comment 'The date on which the fuel was consumed by the generating unit.' ;
    rdfs:domain ind:FuelConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:consumptionStatus rdf:type rdf:Property ;
    rdfs:label 'Consumption Status' ;
    rdfs:comment 'Status indicating whether the fuel consumption record represents actual metered consumption, estimated consumption, adjusted values, or preliminary data pending final reconciliation.' ;
    rdfs:domain ind:FuelConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eiaGeneratorCode rdf:type rdf:Property ;
    rdfs:label 'Eia Generator Code' ;
    rdfs:comment 'The unique generator identification code assigned by the EIA for regulatory reporting purposes.' ;
    rdfs:domain ind:FuelConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eiaPlantCode rdf:type rdf:Property ;
    rdfs:label 'Eia Plant Code' ;
    rdfs:comment 'The unique plant identification code assigned by the EIA for regulatory reporting purposes.' ;
    rdfs:domain ind:Generation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eiaReportingMonth rdf:type rdf:Property ;
    rdfs:label 'Eia Reporting Month' ;
    rdfs:comment 'The month for which this fuel consumption is reported to the EIA on Form 923, in YYYY-MM format.' ;
    rdfs:domain ind:FuelConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emissionsNoxTons rdf:type rdf:Property ;
    rdfs:label 'Emissions Nox Tons' ;
    rdfs:comment 'Total nitrogen oxides emissions resulting from the combustion of this fuel quantity, measured in tons. Used for air quality compliance reporting.' ;
    rdfs:domain ind:Generation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:emissionsParticulateTons rdf:type rdf:Property ;
    rdfs:label 'Emissions Particulate Tons' ;
    rdfs:comment 'Total particulate matter emissions resulting from the combustion of this fuel quantity, measured in tons. Used for air quality compliance.' ;
    rdfs:domain ind:FuelConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:emissionsSo2Tons rdf:type rdf:Property ;
    rdfs:label 'Emissions So2 Tons' ;
    rdfs:comment 'Total sulfur dioxide emissions resulting from the combustion of this fuel quantity, measured in tons. Used for acid rain program compliance.' ;
    rdfs:domain ind:Generation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:energyOutputMwh rdf:type rdf:Property ;
    rdfs:label 'Energy Output Mwh' ;
    rdfs:comment 'Total electrical energy output generated by the unit during the period in which this fuel was consumed, measured in Megawatt-hours (MWh). Used for heat rate calculations.' ;
    rdfs:domain ind:Generation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fuelCostPerMmbtu rdf:type rdf:Property ;
    rdfs:label 'Fuel Cost Per Mmbtu' ;
    rdfs:comment 'Cost per million British Thermal Units of heat input, measured in USD per MMBtu. Used for LCOE analysis and fuel cost benchmarking.' ;
    rdfs:domain ind:FuelConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fuelCostPerUnit rdf:type rdf:Property ;
    rdfs:label 'Fuel Cost Per Unit' ;
    rdfs:comment 'Cost per physical unit of fuel consumed, measured in USD per unit (e.g., USD per ton, USD per MCF, USD per gallon).' ;
    rdfs:domain ind:FuelConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fuelOriginState rdf:type rdf:Property ;
    rdfs:label 'Fuel Origin State' ;
    rdfs:comment 'The U.S. state or country from which the consumed fuel originated or was extracted.' ;
    rdfs:domain ind:FuelConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fuelSubtype rdf:type rdf:Property ;
    rdfs:label 'Fuel Subtype' ;
    rdfs:comment 'Detailed subtype or grade of fuel consumed (e.g., bituminous coal, anthracite, pipeline natural gas, liquefied natural gas).' ;
    rdfs:domain ind:FuelConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:heatContentPerUnit rdf:type rdf:Property ;
    rdfs:label 'Heat Content Per Unit' ;
    rdfs:comment 'Average heat content of the fuel per physical unit consumed, measured in BTU per unit (e.g., BTU per ton, BTU per MCF).' ;
    rdfs:domain ind:FuelConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:heatRate rdf:type rdf:Property ;
    rdfs:label 'Heat Rate' ;
    rdfs:comment 'Thermal efficiency of the generating unit, measured in BTU per kilowatt-hour (kWh). Calculated as total_heat_input_mmbtu divided by energy_output_mwh. Lower values indicate higher efficiency.' ;
    rdfs:domain ind:FuelConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inventoryAdjustmentFlag rdf:type rdf:Property ;
    rdfs:label 'Inventory Adjustment Flag' ;
    rdfs:comment 'Indicates whether this consumption record includes an adjustment for fuel inventory reconciliation (true) or represents direct consumption only (false).' ;
    rdfs:domain ind:FuelConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:moistureContentPercent rdf:type rdf:Property ;
    rdfs:label 'Moisture Content Percent' ;
    rdfs:comment 'Percentage of moisture content in the consumed fuel, affecting combustion efficiency and heat rate calculations.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:quantityConsumed rdf:type rdf:Property ;
    rdfs:label 'Quantity Consumed' ;
    rdfs:comment 'Physical quantity of fuel consumed during the reporting period, measured in the unit specified by quantity_unit.' ;
    rdfs:domain ind:FuelConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:quantityUnit rdf:type rdf:Property ;
    rdfs:label 'Quantity Unit' ;
    rdfs:comment 'Unit of measure for the quantity of fuel consumed (tons for coal, MCF for natural gas, gallons for oil, MMBtu for heat content).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sulfurContentPercent rdf:type rdf:Property ;
    rdfs:label 'Sulfur Content Percent' ;
    rdfs:comment 'Percentage of sulfur content in the consumed fuel, used for emissions calculations and environmental compliance reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalFuelCost rdf:type rdf:Property ;
    rdfs:label 'Total Fuel Cost' ;
    rdfs:comment 'Total cost of fuel consumed during the reporting period, measured in USD. Calculated as quantity_consumed multiplied by fuel_cost_per_unit.' ;
    rdfs:domain ind:FuelConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalHeatInputMmbtu rdf:type rdf:Property ;
    rdfs:label 'Total Heat Input Mmbtu' ;
    rdfs:comment 'Total heat input from fuel consumed during the reporting period, measured in million British Thermal Units (MMBtu). Calculated as quantity_consumed multiplied by heat_content_per_unit.' ;
    rdfs:domain ind:FuelConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transportationMode rdf:type rdf:Property ;
    rdfs:label 'Transportation Mode' ;
    rdfs:comment 'Primary mode of transportation used to deliver the fuel to the generation plant.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:busId rdf:type rdf:Property ;
    rdfs:label 'Bus Id' ;
    rdfs:comment 'Foreign key linking to transmission.bus. Business justification: Dispatch and power-flow models require each unit\'s bus mapping; reflected in Real-Time Energy Management System.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Bus .

ind:responsibleCrewId rdf:type rdf:Property ;
    rdfs:label 'Responsible Crew Id' ;
    rdfs:comment 'Foreign key linking to workforce.crew. Business justification: Maintenance scheduling uses this link to assign a specific crew to each generating unit for planned outages and inspections.' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Crew .

ind:unitMeterId rdf:type rdf:Property ;
    rdfs:label 'Unit Meter Id' ;
    rdfs:comment 'Foreign key linking to metering.meter. Business justification: Unit-level metering provides SCADA verification of each generating unit\'s output for dispatch and performance reporting.' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Meter .

ind:ancillaryServicesQualifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Ancillary Services Qualified Flag' ;
    rdfs:comment 'Indicates whether the unit is qualified to provide ancillary services such as frequency regulation, spinning reserves, or voltage support.' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:assetBookValueUsd rdf:type rdf:Property ;
    rdfs:label 'Asset Book Value Usd' ;
    rdfs:comment 'Current book value of the generating unit asset on the company balance sheet, measured in US dollars.' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:balancingAuthority rdf:type rdf:Property ;
    rdfs:label 'Balancing Authority' ;
    rdfs:comment 'NERC-registered balancing authority responsible for real-time balancing of generation and load in the area where the unit operates.' ;
    rdfs:domain ind:Generation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capacityFactorTargetPct rdf:type rdf:Property ;
    rdfs:label 'Capacity Factor Target Pct' ;
    rdfs:comment 'Target or expected capacity factor for the unit, expressed as a percentage of nameplate capacity utilization over a period.' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capacityMarketParticipationFlag rdf:type rdf:Property ;
    rdfs:label 'Capacity Market Participation Flag' ;
    rdfs:comment 'Indicates whether the unit participates in organized capacity markets (e.g., PJM RPM, ISO-NE FCM).' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:carbonCaptureEquippedFlag rdf:type rdf:Property ;
    rdfs:label 'Carbon Capture Equipped Flag' ;
    rdfs:comment 'Indicates whether the unit is equipped with carbon capture and sequestration (CCS) technology.' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coolingSystemType rdf:type rdf:Property ;
    rdfs:label 'Cooling System Type' ;
    rdfs:comment 'Type of cooling system used by the generating unit for thermal management.' ;
    rdfs:domain ind:Generation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eiaUnitCode rdf:type rdf:Property ;
    rdfs:label 'Eia Unit Code' ;
    rdfs:comment 'Official unit identifier assigned by the U.S. Energy Information Administration for regulatory reporting.' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emissionsControlEquipment rdf:type rdf:Property ;
    rdfs:label 'Emissions Control Equipment' ;
    rdfs:comment 'Description of installed emissions control technologies (e.g., scrubbers, SCR, baghouse, ESP) for air quality compliance.' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:energyStorageCapacityMwh rdf:type rdf:Property ;
    rdfs:label 'Energy Storage Capacity Mwh' ;
    rdfs:comment 'Energy storage capacity associated with the unit, if applicable (e.g., battery storage co-located with solar or wind), measured in megawatt-hours.' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fuelTypePrimary rdf:type rdf:Property ;
    rdfs:label 'Fuel Type Primary' ;
    rdfs:comment 'Primary fuel source used by the generating unit for energy production. [ENUM-REF-CANDIDATE: coal|natural_gas|nuclear|hydro|wind|solar|oil|biomass|geothermal|other — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fuelTypeSecondary rdf:type rdf:Property ;
    rdfs:label 'Fuel Type Secondary' ;
    rdfs:comment 'Secondary or backup fuel source that the unit can use, if applicable.' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:heatRateBtuPerKwh rdf:type rdf:Property ;
    rdfs:label 'Heat Rate Btu Per Kwh' ;
    rdfs:comment 'Thermal efficiency measure representing the amount of fuel energy (BTU) required to produce one kilowatt-hour of electricity. Lower values indicate higher efficiency.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interconnectionVoltageKv rdf:type rdf:Property ;
    rdfs:label 'Interconnection Voltage Kv' ;
    rdfs:comment 'Voltage level at which the generating unit interconnects to the transmission or distribution grid, measured in kilovolts.' ;
    rdfs:domain ind:Generation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastMajorOverhaulDate rdf:type rdf:Property ;
    rdfs:label 'Last Major Overhaul Date' ;
    rdfs:comment 'Date of the most recent major overhaul or refurbishment of the generating unit.' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:minimumLoadMw rdf:type rdf:Property ;
    rdfs:label 'Minimum Load Mw' ;
    rdfs:comment 'Minimum generation level at which the unit can operate stably without shutting down, measured in megawatts.' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mustRunDesignationFlag rdf:type rdf:Property ;
    rdfs:label 'Must Run Designation Flag' ;
    rdfs:comment 'Indicates whether the unit has been designated as a must-run or reliability-must-run (RMR) unit by the RTO/ISO for grid reliability.' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nercUnitCode rdf:type rdf:Property ;
    rdfs:label 'Nerc Unit Code' ;
    rdfs:comment 'Unit identifier registered with NERC for reliability compliance and reporting purposes.' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextScheduledOutageDate rdf:type rdf:Property ;
    rdfs:label 'Next Scheduled Outage Date' ;
    rdfs:comment 'Planned date for the next scheduled maintenance outage or planned downtime.' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:piHistorianTagPrefix rdf:type rdf:Property ;
    rdfs:label 'Pi Historian Tag Prefix' ;
    rdfs:comment 'Tag prefix used in OSIsoft PI Historian system for real-time telemetry data points associated with this generating unit.' ;
    rdfs:domain ind:Generation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:plannedUprateCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Planned Uprate Capacity Mw' ;
    rdfs:comment 'Expected capacity increase in megawatts from a planned uprate project.' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:plannedUprateDate rdf:type rdf:Property ;
    rdfs:label 'Planned Uprate Date' ;
    rdfs:comment 'Scheduled date for a planned capacity increase or uprate project for the unit.' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:primeMoverType rdf:type rdf:Property ;
    rdfs:label 'Prime Mover Type' ;
    rdfs:comment 'Type of prime mover technology used by the generating unit. ST=Steam Turbine, GT=Gas Turbine, CC=Combined Cycle, HY=Hydraulic Turbine, PV=Photovoltaic, WT=Wind Turbine, NUC=Nuclear, IC=Internal Combustion, CA=Compressed Air, CT=Combustion Turbine, CS=Combined Cycle Steam, FC=Fuel Cell, OT=Other. [ENUM-REF-CANDIDATE: ST|GT|CC|HY|PV|WT|NUC|IC|CA|CT|CS|FC|OT — 13 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rampRateMwPerMin rdf:type rdf:Property ;
    rdfs:label 'Ramp Rate Mw Per Min' ;
    rdfs:comment 'Maximum rate at which the unit can increase or decrease output, measured in megawatts per minute.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryAssetBaseFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Asset Base Flag' ;
    rdfs:comment 'Indicates whether the generating unit is included in the regulatory asset base for rate recovery purposes.' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:renewableEnergyCertificateEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Renewable Energy Certificate Eligible Flag' ;
    rdfs:comment 'Indicates whether the generating unit is eligible to generate Renewable Energy Certificates under applicable renewable portfolio standards.' ;
    rdfs:domain ind:Generation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rtoIsoRegion rdf:type rdf:Property ;
    rdfs:label 'Rto Iso Region' ;
    rdfs:comment 'The RTO or ISO market region in which the generating unit participates (e.g., PJM, CAISO, ERCOT, MISO, NYISO, ISO-NE, SPP).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scadaIntegrationFlag rdf:type rdf:Property ;
    rdfs:label 'Scada Integration Flag' ;
    rdfs:comment 'Indicates whether the unit is integrated with the SCADA system for real-time monitoring and control.' ;
    rdfs:domain ind:Generation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:startupTimeHours rdf:type rdf:Property ;
    rdfs:label 'Startup Time Hours' ;
    rdfs:comment 'Typical time required to bring the unit from offline to full load operation, measured in hours.' ;
    rdfs:domain ind:Generation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:summerCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Summer Capacity Mw' ;
    rdfs:comment 'Net dependable capacity of the unit during summer peak conditions, accounting for ambient temperature and auxiliary load, measured in megawatts.' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:synchronizationDate rdf:type rdf:Property ;
    rdfs:label 'Synchronization Date' ;
    rdfs:comment 'Date when the generating unit was first synchronized to the electrical grid and began commercial operation.' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:technologyType rdf:type rdf:Property ;
    rdfs:label 'Technology Type' ;
    rdfs:comment 'Detailed technology classification of the generating unit (e.g., \'Pulverized Coal\', \'Combined Cycle Gas Turbine\', \'Onshore Wind\', \'Utility-Scale Solar PV\').' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unitCode rdf:type rdf:Property ;
    rdfs:label 'Unit Code' ;
    rdfs:comment 'Internal business code or identifier for the generating unit used in operational systems and reporting.' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unitName rdf:type rdf:Property ;
    rdfs:label 'Unit Name' ;
    rdfs:comment 'Human-readable name or designation of the generating unit (e.g., \'Unit 1\', \'Turbine A\', \'Solar Block 3\').' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waterSource rdf:type rdf:Property ;
    rdfs:label 'Water Source' ;
    rdfs:comment 'Primary water source used for cooling or steam generation (e.g., river, lake, ocean, municipal, groundwater).' ;
    rdfs:domain ind:Generation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:winterCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Winter Capacity Mw' ;
    rdfs:comment 'Net dependable capacity of the unit during winter peak conditions, accounting for ambient temperature and auxiliary load, measured in megawatts.' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forecastId rdf:type rdf:Property ;
    rdfs:label 'Forecast Id' ;
    rdfs:comment 'Unique identifier for the generation forecast record. Primary key.' ;
    rdfs:domain ind:Forecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:confidenceIntervalLowerMwh rdf:type rdf:Property ;
    rdfs:label 'Confidence Interval Lower Mwh' ;
    rdfs:comment 'Lower bound of the statistical confidence interval for forecasted net generation, typically representing the 10th or 5th percentile outcome. Used for risk assessment and reserve planning.' ;
    rdfs:domain ind:Forecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:confidenceIntervalUpperMwh rdf:type rdf:Property ;
    rdfs:label 'Confidence Interval Upper Mwh' ;
    rdfs:comment 'Upper bound of the statistical confidence interval for forecasted net generation, typically representing the 90th or 95th percentile outcome. Used for risk assessment and reserve planning.' ;
    rdfs:domain ind:Forecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:confidenceLevelPercent rdf:type rdf:Property ;
    rdfs:label 'Confidence Level Percent' ;
    rdfs:comment 'Statistical confidence level associated with the forecast interval bounds, expressed as a percentage (e.g., 90%, 95%). Indicates the probability that actual generation will fall within the specified interval.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:errorMwh rdf:type rdf:Property ;
    rdfs:label 'Error Mwh' ;
    rdfs:comment 'Calculated difference between forecasted and actual generation for historical records. Populated post-facto for model performance tracking and continuous improvement. Null for future forecasts.' ;
    rdfs:domain ind:Forecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:errorPercent rdf:type rdf:Property ;
    rdfs:label 'Error Percent' ;
    rdfs:comment 'Percentage error between forecasted and actual generation for historical records. Populated post-facto for model accuracy assessment. Null for future forecasts.' ;
    rdfs:domain ind:Forecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forcedOutageProbability rdf:type rdf:Property ;
    rdfs:label 'Forced Outage Probability' ;
    rdfs:comment 'Estimated probability of an unplanned forced outage occurring during the forecast period, expressed as a decimal (0.0 to 1.0). Used for reliability planning.' ;
    rdfs:domain ind:Forecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forecastNumber rdf:type rdf:Property ;
    rdfs:label 'Forecast Number' ;
    rdfs:comment 'Business identifier for the generation forecast, used for external reference and tracking in Energy Management System (EMS) and Day-Ahead Market (DAM) submissions.' ;
    rdfs:domain ind:Forecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forecastStatus rdf:type rdf:Property ;
    rdfs:label 'Forecast Status' ;
    rdfs:comment 'Current lifecycle status of the generation forecast record.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forecastedCapacityFactorPercent rdf:type rdf:Property ;
    rdfs:label 'Forecasted Capacity Factor Percent' ;
    rdfs:comment 'Predicted ratio of actual generation output to maximum possible output over the forecast period, expressed as a percentage. Key metric for renewable energy sources and Integrated Resource Plan (IRP) analysis.' ;
    rdfs:domain ind:Forecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forecastedCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Forecasted Capacity Mw' ;
    rdfs:comment 'Predicted instantaneous generation capacity available during the forecast period, measured in Megawatts (MW). Represents the maximum power output the unit or plant can deliver.' ;
    rdfs:domain ind:Forecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forecastedEmissionsCo2Tons rdf:type rdf:Property ;
    rdfs:label 'Forecasted Emissions Co2 Tons' ;
    rdfs:comment 'Predicted carbon dioxide emissions in tons for the forecast period. Used for environmental compliance and Renewable Energy Certificate (REC) tracking.' ;
    rdfs:domain ind:Forecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forecastedEmissionsNoxLbs rdf:type rdf:Property ;
    rdfs:label 'Forecasted Emissions Nox Lbs' ;
    rdfs:comment 'Predicted nitrogen oxides emissions in pounds for the forecast period. Required for EPA air quality compliance reporting.' ;
    rdfs:domain ind:Forecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forecastedEmissionsSo2Lbs rdf:type rdf:Property ;
    rdfs:label 'Forecasted Emissions So2 Lbs' ;
    rdfs:comment 'Predicted sulfur dioxide emissions in pounds for the forecast period. Required for EPA air quality compliance reporting.' ;
    rdfs:domain ind:Forecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forecastedFuelConsumption rdf:type rdf:Property ;
    rdfs:label 'Forecasted Fuel Consumption' ;
    rdfs:comment 'Predicted fuel consumption quantity for the forecast period. Unit of measure varies by fuel type (tons for coal, MCF for natural gas, gallons for oil).' ;
    rdfs:domain ind:Forecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forecastedGrossGenerationMwh rdf:type rdf:Property ;
    rdfs:label 'Forecasted Gross Generation Mwh' ;
    rdfs:comment 'Predicted total electrical energy output at the generator terminals before accounting for auxiliary load or station service, measured in Megawatt-Hours (MWh).' ;
    rdfs:domain ind:Forecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forecastedHeatRateBtuPerKwh rdf:type rdf:Property ;
    rdfs:label 'Forecasted Heat Rate Btu Per Kwh' ;
    rdfs:comment 'Predicted thermal efficiency of the generation unit, measured as BTU of fuel input per kWh of electrical output. Lower values indicate higher efficiency. Key metric for fossil fuel and nuclear plants.' ;
    rdfs:domain ind:Forecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forecastedNetGenerationMwh rdf:type rdf:Property ;
    rdfs:label 'Forecasted Net Generation Mwh' ;
    rdfs:comment 'Predicted electrical energy output available for delivery to the grid after subtracting auxiliary load and station service, measured in Megawatt-Hours (MWh). This is the energy available for sale or dispatch.' ;
    rdfs:domain ind:Forecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fuelConsumptionUnit rdf:type rdf:Property ;
    rdfs:label 'Fuel Consumption Unit' ;
    rdfs:comment 'Unit of measure for forecasted fuel consumption. MCF = Thousand Cubic Feet (natural gas), MMBTU = Million British Thermal Units.' ;
    rdfs:domain ind:Forecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:horizonType rdf:type rdf:Property ;
    rdfs:label 'Horizon Type' ;
    rdfs:comment 'Classification of the forecast time horizon, indicating how far in advance the forecast is made relative to the operational period. Used for Day-Ahead Market (DAM) vs Real-Time Market (RTM) planning.' ;
    rdfs:domain ind:Forecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketBidFlag rdf:type rdf:Property ;
    rdfs:label 'Market Bid Flag' ;
    rdfs:comment 'Indicates whether this forecast was used as the basis for a Day-Ahead Market (DAM) or Real-Time Market (RTM) bid submission to the Regional Transmission Organization (RTO) or Independent System Operator (ISO).' ;
    rdfs:domain ind:Forecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:modelType rdf:type rdf:Property ;
    rdfs:label 'Model Type' ;
    rdfs:comment 'Classification of the forecasting methodology used (statistical time series, machine learning, physical simulation, hybrid approach, or expert judgment).' ;
    rdfs:domain ind:Forecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelVersion rdf:type rdf:Property ;
    rdfs:label 'Model Version' ;
    rdfs:comment 'Identifier for the forecasting algorithm or model version used to generate this forecast. Enables traceability and model performance analysis.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:periodEnd rdf:type rdf:Property ;
    rdfs:label 'Period End' ;
    rdfs:comment 'The ending timestamp of the period for which generation output is forecasted. Represents the real-world operational time window end.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:periodStart rdf:type rdf:Property ;
    rdfs:label 'Period Start' ;
    rdfs:comment 'The beginning timestamp of the period for which generation output is forecasted. Represents the real-world operational time window start.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:plannedOutageFlag rdf:type rdf:Property ;
    rdfs:label 'Planned Outage Flag' ;
    rdfs:comment 'Indicates whether a planned maintenance outage is scheduled during the forecast period, impacting available capacity.' ;
    rdfs:domain ind:Generation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:solarIrradianceWPerM2 rdf:type rdf:Property ;
    rdfs:label 'Solar Irradiance W Per M2' ;
    rdfs:comment 'Forecasted solar irradiance in watts per square meter, used for solar photovoltaic generation forecasting.' ;
    rdfs:domain ind:Forecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:submittedBy rdf:type rdf:Property ;
    rdfs:label 'Submitted By' ;
    rdfs:comment 'Username or identifier of the analyst or system that created and submitted this forecast. Audit trail for accountability.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:weatherScenarioCode rdf:type rdf:Property ;
    rdfs:label 'Weather Scenario Code' ;
    rdfs:comment 'Reference to the weather input scenario or forecast used as input to the generation forecast model. Critical for renewable generation forecasting (solar, wind).' ;
    rdfs:domain ind:Forecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:leadTechnicianId rdf:type rdf:Property ;
    rdfs:label 'Lead Technician Id' ;
    rdfs:comment 'Foreign key linking to workforce.technician. Business justification: Outage work orders require recording the lead technician who directs field activities, needed for safety and regulatory reporting.' ;
    rdfs:domain ind:GenerationOutage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Technician .

ind:affectedCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Affected Capacity Mw' ;
    rdfs:comment 'Amount of generation capacity in megawatts that was unavailable or derated during the outage event.' ;
    rdfs:domain ind:GenerationOutage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:availableCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Available Capacity Mw' ;
    rdfs:comment 'Amount of generation capacity in megawatts that remained available during a partial outage or derating event.' ;
    rdfs:domain ind:Generation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:causeCategory rdf:type rdf:Property ;
    rdfs:label 'Cause Category' ;
    rdfs:comment 'High-level categorization of the outage cause (e.g., equipment failure, fuel supply issue, environmental constraint, regulatory requirement, economic dispatch).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctiveAction rdf:type rdf:Property ;
    rdfs:label 'Corrective Action' ;
    rdfs:comment 'Description of the corrective actions, repairs, or maintenance activities performed to resolve the outage.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataSource rdf:type rdf:Property ;
    rdfs:label 'Data Source' ;
    rdfs:comment 'Source system or interface from which the outage data was captured (e.g., OSIsoft PI Historian, Maximo EAM, manual entry, SCADA).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deratingPercentage rdf:type rdf:Property ;
    rdfs:label 'Derating Percentage' ;
    rdfs:comment 'Percentage of nameplate capacity lost during a derating event, expressed as a decimal (e.g., 25.50 for 25.5%).' ;
    rdfs:domain ind:GenerationOutage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:energyNotProducedMwh rdf:type rdf:Property ;
    rdfs:label 'Energy Not Produced Mwh' ;
    rdfs:comment 'Estimated amount of energy in megawatt-hours that was not generated due to the outage, calculated based on expected dispatch and outage duration.' ;
    rdfs:domain ind:GenerationOutage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:equivalentAvailabilityFactor rdf:type rdf:Property ;
    rdfs:label 'Equivalent Availability Factor' ;
    rdfs:comment 'Calculated metric representing the percentage of time the unit was available to generate at full capacity, accounting for both full and partial outages.' ;
    rdfs:domain ind:GenerationOutage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedCostUsd rdf:type rdf:Property ;
    rdfs:label 'Estimated Cost Usd' ;
    rdfs:comment 'Estimated total cost of the outage in US dollars, including repair costs, replacement power costs, and lost revenue.' ;
    rdfs:domain ind:GenerationOutage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eventNumber rdf:type rdf:Property ;
    rdfs:label 'Event Number' ;
    rdfs:comment 'Business identifier for the outage event, used for tracking and reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forcedOutageRate rdf:type rdf:Property ;
    rdfs:label 'Forced Outage Rate' ;
    rdfs:comment 'Calculated metric representing the percentage of time the unit was unavailable due to forced outages, used for reliability assessment.' ;
    rdfs:domain ind:GenerationOutage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isDeratingEvent rdf:type rdf:Property ;
    rdfs:label 'Is Derating Event' ;
    rdfs:comment 'Flag indicating whether this outage represents a partial capacity loss (derating) rather than a full unit outage.' ;
    rdfs:domain ind:GenerationOutage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isReportableToNerc rdf:type rdf:Property ;
    rdfs:label 'Is Reportable To Nerc' ;
    rdfs:comment 'Flag indicating whether this outage event meets NERC GADS reporting thresholds and must be included in regulatory submissions.' ;
    rdfs:domain ind:GenerationOutage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nercCauseCode rdf:type rdf:Property ;
    rdfs:label 'Nerc Cause Code' ;
    rdfs:comment 'NERC GADS standardized cause code identifying the root cause category of the outage (e.g., boiler, turbine, generator, auxiliary equipment).' ;
    rdfs:domain ind:GenerationOutage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nercEventCode rdf:type rdf:Property ;
    rdfs:label 'Nerc Event Code' ;
    rdfs:comment 'NERC GADS standardized event code providing detailed classification of the outage event type.' ;
    rdfs:domain ind:GenerationOutage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Notification Timestamp' ;
    rdfs:comment 'Date and time when the outage was first reported or notified to grid operations and scheduling.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:outageDescription rdf:type rdf:Property ;
    rdfs:label 'Outage Description' ;
    rdfs:comment 'Detailed narrative description of the outage event, including symptoms, root cause findings, and corrective actions taken.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outageStatus rdf:type rdf:Property ;
    rdfs:label 'Outage Status' ;
    rdfs:comment 'Current lifecycle status of the outage event.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:plannedOutageFactor rdf:type rdf:Property ;
    rdfs:label 'Planned Outage Factor' ;
    rdfs:comment 'Calculated metric representing the percentage of time the unit was unavailable due to planned outages.' ;
    rdfs:domain ind:GenerationOutage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:replacementPowerCostUsd rdf:type rdf:Property ;
    rdfs:label 'Replacement Power Cost Usd' ;
    rdfs:comment 'Cost in US dollars of purchasing replacement power from the market or other sources to cover the unavailable generation capacity.' ;
    rdfs:domain ind:GenerationOutage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:returnToServiceTimestamp rdf:type rdf:Property ;
    rdfs:label 'Return To Service Timestamp' ;
    rdfs:comment 'Date and time when the generating unit was officially returned to service and available for dispatch.' ;
    rdfs:domain ind:GenerationOutage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:scheduledReturnTimestamp rdf:type rdf:Property ;
    rdfs:label 'Scheduled Return Timestamp' ;
    rdfs:comment 'Originally scheduled or estimated date and time for the unit to return to service.' ;
    rdfs:domain ind:GenerationOutage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:serviceFactor rdf:type rdf:Property ;
    rdfs:label 'Service Factor' ;
    rdfs:comment 'Calculated metric representing the percentage of time the unit was in active service during the reporting period.' ;
    rdfs:domain ind:GenerationOutage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unavailableCapacityForcedMw rdf:type rdf:Property ;
    rdfs:label 'Unavailable Capacity Forced Mw' ;
    rdfs:comment 'Amount of generation capacity in megawatts unavailable due to forced (unplanned) outage events.' ;
    rdfs:domain ind:GenerationOutage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unavailableCapacityMaintenanceMw rdf:type rdf:Property ;
    rdfs:label 'Unavailable Capacity Maintenance Mw' ;
    rdfs:comment 'Amount of generation capacity in megawatts unavailable due to maintenance outage activities.' ;
    rdfs:domain ind:GenerationOutage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unavailableCapacityPlannedMw rdf:type rdf:Property ;
    rdfs:label 'Unavailable Capacity Planned Mw' ;
    rdfs:comment 'Amount of generation capacity in megawatts unavailable due to planned outage activities.' ;
    rdfs:domain ind:GenerationOutage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recCertificateId rdf:type rdf:Property ;
    rdfs:label 'Rec Certificate Id' ;
    rdfs:comment 'Unique identifier for the renewable energy certificate record. Primary key for the generation REC certificate product.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RecCertificate .

ind:generationFacilityId rdf:type rdf:Property ;
    rdfs:label 'Generation Facility Id' ;
    rdfs:comment 'Reference to the parent generation facility or plant where the renewable energy was produced.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Facility .

ind:generationRecordEnergyOutputId rdf:type rdf:Property ;
    rdfs:label 'Generation Record Energy Output Id' ;
    rdfs:comment 'Reference to the underlying generation output record in the generation domain that documents the MWh production for which this REC was issued.' ;
    rdfs:domain ind:RecCertificate ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EnergyOutput .

ind:ppaContractId rdf:type rdf:Property ;
    rdfs:label 'Ppa Contract Id' ;
    rdfs:comment 'Reference to the PPA contract under which the renewable energy was procured, if applicable. Links REC to contractual obligations.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PpaContract .

ind:certificateStatus rdf:type rdf:Property ;
    rdfs:label 'Certificate Status' ;
    rdfs:comment 'Current lifecycle status of the REC. Issued: newly created; Active: available for trading; Retired: used for compliance or voluntary claim; Transferred: moved to another account; Expired: past eligibility window; Cancelled: invalidated.' ;
    rdfs:domain ind:RecCertificate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Compliance Jurisdiction' ;
    rdfs:comment 'State or regulatory jurisdiction for which this REC is eligible for RPS compliance (e.g., California, Massachusetts, New York). Some RECs may be eligible in multiple jurisdictions.' ;
    rdfs:domain ind:RecCertificate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceYear rdf:type rdf:Property ;
    rdfs:label 'Compliance Year' ;
    rdfs:comment 'Year for which this REC was or will be used to meet RPS compliance obligations. May differ from vintage year due to banking provisions.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:counterpartyName rdf:type rdf:Property ;
    rdfs:label 'Counterparty Name' ;
    rdfs:comment 'Name of the party with whom the REC was traded (buyer or seller). Used for transaction tracking and reporting.' ;
    rdfs:domain ind:RecCertificate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityFlags rdf:type rdf:Property ;
    rdfs:label 'Eligibility Flags' ;
    rdfs:comment 'Comma-separated list of special eligibility designations for this REC (e.g., Tier 1, Tier 2, Solar Carve-Out, Offshore Wind, In-State, New Vintage). Used to determine which RPS requirements the REC can satisfy.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Facility Capacity Mw' ;
    rdfs:comment 'Nameplate generation capacity of the facility in megawatts. Some RPS programs have size limits or tiers based on facility capacity.' ;
    rdfs:domain ind:RecCertificate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:facilityCommissioningDate rdf:type rdf:Property ;
    rdfs:label 'Facility Commissioning Date' ;
    rdfs:comment 'Date when the generating facility first began commercial operation. Some RPS programs have vintage requirements based on facility age.' ;
    rdfs:domain ind:RecCertificate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:facilityLocationCountry rdf:type rdf:Property ;
    rdfs:label 'Facility Location Country' ;
    rdfs:comment 'Country where the generating facility is located. Most U.S. RPS programs only accept RECs from facilities in the U.S. or specific Canadian provinces.' ;
    rdfs:domain ind:RecCertificate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityLocationState rdf:type rdf:Property ;
    rdfs:label 'Facility Location State' ;
    rdfs:comment 'U.S. state or Canadian province where the generating facility is located. Geographic location affects RPS eligibility in many jurisdictions.' ;
    rdfs:domain ind:RecCertificate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fuelSource rdf:type rdf:Property ;
    rdfs:label 'Fuel Source' ;
    rdfs:comment 'Type of renewable energy source used to generate the electricity for which this REC was issued. Determines eligibility for various RPS compliance programs.' ;
    rdfs:domain ind:RecCertificate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fuelSourceSubcategory rdf:type rdf:Property ;
    rdfs:label 'Fuel Source Subcategory' ;
    rdfs:comment 'More granular classification of the renewable fuel source (e.g., photovoltaic solar, concentrated solar, onshore wind, offshore wind, run-of-river hydro, pumped storage hydro, wood biomass, agricultural biomass).' ;
    rdfs:domain ind:RecCertificate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:generationEndDate rdf:type rdf:Property ;
    rdfs:label 'Generation End Date' ;
    rdfs:comment 'End date of the generation period during which the renewable energy was produced.' ;
    rdfs:domain ind:RecCertificate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:generationMonth rdf:type rdf:Property ;
    rdfs:label 'Generation Month' ;
    rdfs:comment 'Month (1-12) in which the renewable energy was generated. Used for reporting and compliance tracking.' ;
    rdfs:domain ind:RecCertificate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:generationStartDate rdf:type rdf:Property ;
    rdfs:label 'Generation Start Date' ;
    rdfs:comment 'Start date of the generation period during which the renewable energy was produced. RECs are typically issued for monthly or quarterly generation periods.' ;
    rdfs:domain ind:RecCertificate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:generationYear rdf:type rdf:Property ;
    rdfs:label 'Generation Year' ;
    rdfs:comment 'Calendar year in which the renewable energy was generated.' ;
    rdfs:domain ind:RecCertificate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:issuanceDate rdf:type rdf:Property ;
    rdfs:label 'Issuance Date' ;
    rdfs:comment 'Date on which the REC was officially issued by the tracking system registry after verification of generation data.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:marketValueUsd rdf:type rdf:Property ;
    rdfs:label 'Market Value Usd' ;
    rdfs:comment 'Estimated or actual market value of the REC in U.S. dollars at the time of issuance or transaction. Used for financial reporting and asset valuation.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recSerialNumber rdf:type rdf:Property ;
    rdfs:label 'Rec Serial Number' ;
    rdfs:comment 'Unique serial number assigned by the tracking system registry to identify this specific REC. This is the externally-recognized business identifier for the certificate.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retirementAccount rdf:type rdf:Property ;
    rdfs:label 'Retirement Account' ;
    rdfs:comment 'Tracking system account into which the REC was retired. Used to identify the beneficiary of the renewable energy claim.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retirementPurpose rdf:type rdf:Property ;
    rdfs:label 'Retirement Purpose' ;
    rdfs:comment 'Reason for which the REC was retired. RPS Compliance: used to meet state renewable portfolio standard requirements; Voluntary: used for voluntary green power programs or corporate sustainability claims.' ;
    rdfs:domain ind:RecCertificate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trackingSystem rdf:type rdf:Property ;
    rdfs:label 'Tracking System' ;
    rdfs:comment 'Regional or state tracking system registry that issued and tracks this REC (e.g., WREGIS for Western states, NEPOOL GIS for New England, PJM GATS for Mid-Atlantic, M-RETS for Midwest). [ENUM-REF-CANDIDATE: WREGIS|NEPOOL_GIS|PJM_GATS|M_RETS|NAR|ERCOT|MIRECS — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:RecCertificate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trackingSystemAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Tracking System Account Number' ;
    rdfs:comment 'Account identifier in the tracking system registry under which this REC is held or was issued.' ;
    rdfs:domain ind:RecCertificate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionPriceUsd rdf:type rdf:Property ;
    rdfs:label 'Transaction Price Usd' ;
    rdfs:comment 'Actual price paid or received for the REC in a sale or purchase transaction, in U.S. dollars. Null if REC was not traded.' ;
    rdfs:domain ind:RecCertificate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transferRecipientAccount rdf:type rdf:Property ;
    rdfs:label 'Transfer Recipient Account' ;
    rdfs:comment 'Tracking system account identifier of the party to whom the REC was transferred.' ;
    rdfs:domain ind:RecCertificate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationDate rdf:type rdf:Property ;
    rdfs:label 'Verification Date' ;
    rdfs:comment 'Date on which the tracking system completed verification of the generation data and approved issuance of the REC.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:vintageYear rdf:type rdf:Property ;
    rdfs:label 'Vintage Year' ;
    rdfs:comment 'Year in which the renewable energy was generated, used for REC vintage classification. Some RPS programs require specific vintage years for compliance.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:nuclearFuelCycleId rdf:type rdf:Property ;
    rdfs:label 'Nuclear Fuel Cycle Id' ;
    rdfs:comment 'Unique identifier for the nuclear fuel cycle record. Primary key for tracking fuel lifecycle from initial load through burnup to spent fuel storage.' ;
    rdfs:domain ind:NuclearFuelCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fuelVendorId rdf:type rdf:Property ;
    rdfs:label 'Fuel Vendor Id' ;
    rdfs:comment 'Reference to the nuclear fuel vendor who manufactured and supplied the fuel assemblies for this cycle.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:averageDischargeBurnupMwdMtu rdf:type rdf:Property ;
    rdfs:label 'Average Discharge Burnup Mwd Mtu' ;
    rdfs:comment 'Average burnup of fuel assemblies discharged from the core at the end of this cycle. Key metric for fuel performance and economic optimization.' ;
    rdfs:domain ind:NuclearFuelCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:burnupLevelMwdMtu rdf:type rdf:Property ;
    rdfs:label 'Burnup Level Mwd Mtu' ;
    rdfs:comment 'Measure of fuel depletion representing the thermal energy extracted per unit mass of uranium. Higher burnup indicates more efficient fuel utilization. Typical discharge burnup is 40,000-60,000 MWd/MTU.' ;
    rdfs:domain ind:NuclearFuelCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coreThermalPowerMwt rdf:type rdf:Property ;
    rdfs:label 'Core Thermal Power Mwt' ;
    rdfs:comment 'Licensed thermal power rating of the reactor core. Represents the maximum heat generation rate from nuclear fission. Typical values range from 2,000 to 4,000 MWt.' ;
    rdfs:domain ind:NuclearFuelCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cycleEndDate rdf:type rdf:Property ;
    rdfs:label 'Cycle End Date' ;
    rdfs:comment 'Date when the reactor was shut down for refueling outage, ending this fuel cycle. Used to calculate cycle length and capacity factor.' ;
    rdfs:domain ind:NuclearFuelCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cycleLengthDays rdf:type rdf:Property ;
    rdfs:label 'Cycle Length Days' ;
    rdfs:comment 'Duration of the fuel cycle from startup to shutdown, measured in days. Typical cycle lengths range from 18 to 24 months. Used for fuel planning and economic analysis.' ;
    rdfs:domain ind:NuclearFuelCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cycleNumber rdf:type rdf:Property ;
    rdfs:label 'Cycle Number' ;
    rdfs:comment 'Sequential cycle number for the reactor unit. Increments with each refueling outage. Used for lifecycle tracking and performance trending.' ;
    rdfs:domain ind:NuclearFuelCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cycleStartDate rdf:type rdf:Property ;
    rdfs:label 'Cycle Start Date' ;
    rdfs:comment 'Date when the reactor achieved initial criticality and began power operations for this fuel cycle. Marks the beginning of the fuel burnup period.' ;
    rdfs:domain ind:NuclearFuelCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:energyGeneratedMwh rdf:type rdf:Property ;
    rdfs:label 'Energy Generated Mwh' ;
    rdfs:comment 'Total electrical energy generated during this fuel cycle, measured in megawatt-hours. Used for fuel cost allocation and performance analysis.' ;
    rdfs:domain ind:NuclearFuelCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:enrichmentLevelPercent rdf:type rdf:Property ;
    rdfs:label 'Enrichment Level Percent' ;
    rdfs:comment 'Percentage of fissile uranium-235 isotope in the fuel assembly. Typical commercial reactor enrichment ranges from 3% to 5%. Critical for criticality safety and burnup calculations.' ;
    rdfs:domain ind:NuclearFuelCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:freshFuelAssemblyCount rdf:type rdf:Property ;
    rdfs:label 'Fresh Fuel Assembly Count' ;
    rdfs:comment 'Number of new (unirradiated) fuel assemblies loaded during the refueling outage. Typically one-third to one-half of the core is replaced each cycle.' ;
    rdfs:domain ind:NuclearFuelCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fuelAssemblyBatchNumber rdf:type rdf:Property ;
    rdfs:label 'Fuel Assembly Batch Number' ;
    rdfs:comment 'Unique batch identifier assigned by the fuel vendor to the fuel assembly group. Used for tracking and regulatory reporting to NRC.' ;
    rdfs:domain ind:NuclearFuelCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fuelAssemblyCount rdf:type rdf:Property ;
    rdfs:label 'Fuel Assembly Count' ;
    rdfs:comment 'Total number of fuel assemblies loaded in the reactor core for this cycle. Typical PWR cores contain 150-200 assemblies; BWR cores contain 600-800 assemblies.' ;
    rdfs:domain ind:NuclearFuelCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fuelCostPerMwhUsd rdf:type rdf:Property ;
    rdfs:label 'Fuel Cost Per Mwh Usd' ;
    rdfs:comment 'Unit fuel cost calculated as total fuel cost divided by energy generated during the cycle. Key metric for Levelized Cost of Energy (LCOE) analysis and rate case filings.' ;
    rdfs:domain ind:NuclearFuelCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fuelCostUsd rdf:type rdf:Property ;
    rdfs:label 'Fuel Cost Usd' ;
    rdfs:comment 'Total cost of nuclear fuel for this cycle including uranium procurement, conversion, enrichment, and fabrication. Capitalized and amortized under FASB ASC 980 for regulated utilities.' ;
    rdfs:domain ind:NuclearFuelCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fuelDesignCode rdf:type rdf:Property ;
    rdfs:label 'Fuel Design Code' ;
    rdfs:comment 'Vendor-specific fuel assembly design designation. Examples include Westinghouse 17x17 PERFORMANCE+, GE GE14, or Framatome AFA-3G. Used for technical specifications and licensing.' ;
    rdfs:domain ind:NuclearFuelCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:initialUraniumLoadMtu rdf:type rdf:Property ;
    rdfs:label 'Initial Uranium Load Mtu' ;
    rdfs:comment 'Total mass of uranium loaded into the reactor core at the start of the fuel cycle, measured in metric tons of uranium. Used for fuel cost accounting and inventory management.' ;
    rdfs:domain ind:NuclearFuelCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nrcLicenseNumber rdf:type rdf:Property ;
    rdfs:label 'Nrc License Number' ;
    rdfs:comment 'NRC operating license number authorizing operation of the reactor unit. Format is NPF (Nuclear Power Facility) or DPR (Demonstration Power Reactor) followed by numeric identifier.' ;
    rdfs:domain ind:NuclearFuelCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:peakRodBurnupMwdMtu rdf:type rdf:Property ;
    rdfs:label 'Peak Rod Burnup Mwd Mtu' ;
    rdfs:comment 'Maximum burnup achieved by any individual fuel rod in the core during this cycle. Must remain below regulatory limits to ensure fuel integrity.' ;
    rdfs:domain ind:NuclearFuelCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recGeneratedCount rdf:type rdf:Property ;
    rdfs:label 'Rec Generated Count' ;
    rdfs:comment 'Number of Renewable Energy Certificates generated for this cycle. Some jurisdictions classify nuclear as eligible for REC programs or similar clean energy credits.' ;
    rdfs:domain ind:NuclearFuelCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:regulatoryReportingPeriod rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reporting Period' ;
    rdfs:comment 'Reporting period for NRC and FERC filings associated with this fuel cycle. Format is YYYY-QN for quarterly or YYYY-MM for monthly reporting.' ;
    rdfs:domain ind:NuclearFuelCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:spentFuelStorageLocation rdf:type rdf:Property ;
    rdfs:label 'Spent Fuel Storage Location' ;
    rdfs:comment 'Physical location identifier for spent fuel storage, either in spent fuel pool or dry cask storage. Format includes pool/cask identifier and position coordinates.' ;
    rdfs:domain ind:NuclearFuelCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thermalEfficiencyPercent rdf:type rdf:Property ;
    rdfs:label 'Thermal Efficiency Percent' ;
    rdfs:comment 'Ratio of electrical energy output to thermal energy input from nuclear fission, expressed as percentage. Typical nuclear plant thermal efficiency is 33-37%.' ;
    rdfs:domain ind:NuclearFuelCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualRetirementDate rdf:type rdf:Property ;
    rdfs:label 'Actual Retirement Date' ;
    rdfs:comment 'Actual date when the generation plant was permanently retired from service. Null if plant is still operational.' ;
    rdfs:domain ind:Plant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:bookValueUsd rdf:type rdf:Property ;
    rdfs:label 'Book Value Usd' ;
    rdfs:comment 'Current net book value of the plant asset in US dollars after accumulated depreciation.' ;
    rdfs:domain ind:Plant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cogenerationFlag rdf:type rdf:Property ;
    rdfs:label 'Cogeneration Flag' ;
    rdfs:comment 'Indicates whether the plant is a combined heat and power (CHP) facility producing both electricity and useful thermal energy.' ;
    rdfs:domain ind:Plant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commercialOperationDate rdf:type rdf:Property ;
    rdfs:label 'Commercial Operation Date' ;
    rdfs:comment 'Date when the generation plant began commercial operation and started delivering power to the grid.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:constructionCostUsd rdf:type rdf:Property ;
    rdfs:label 'Construction Cost Usd' ;
    rdfs:comment 'Total capital expenditure for plant construction in US dollars, used for depreciation and rate base calculations.' ;
    rdfs:domain ind:Plant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:emergencyContactNumber rdf:type rdf:Property ;
    rdfs:label 'Emergency Contact Number' ;
    rdfs:comment '24/7 emergency contact telephone number for the plant used for outage coordination and emergency response.' ;
    rdfs:domain ind:Plant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emissionsControlledFlag rdf:type rdf:Property ;
    rdfs:label 'Emissions Controlled Flag' ;
    rdfs:comment 'Indicates whether the plant has emissions control equipment installed (e.g., scrubbers, selective catalytic reduction).' ;
    rdfs:domain ind:Plant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fercLicenseNumber rdf:type rdf:Property ;
    rdfs:label 'Ferc License Number' ;
    rdfs:comment 'FERC-issued license number for hydroelectric projects or other facilities requiring federal authorization.' ;
    rdfs:domain ind:Plant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fuelCategory rdf:type rdf:Property ;
    rdfs:label 'Fuel Category' ;
    rdfs:comment 'Primary fuel or energy source used by the generation plant for electricity production. [ENUM-REF-CANDIDATE: coal|natural_gas|oil|nuclear|solar|wind|hydro|biomass|geothermal|other — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Plant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:installedCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Installed Capacity Mw' ;
    rdfs:comment 'Total nameplate generation capacity of the plant in megawatts, representing the maximum rated output under ideal conditions.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isoRtoMarket rdf:type rdf:Property ;
    rdfs:label 'Iso Rto Market' ;
    rdfs:comment 'Name of the ISO or RTO market where the plant is interconnected and participates in wholesale energy markets.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:managerName rdf:type rdf:Property ;
    rdfs:label 'Manager Name' ;
    rdfs:comment 'Name of the individual responsible for day-to-day operations and management of the generation facility.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nercPlantCode rdf:type rdf:Property ;
    rdfs:label 'Nerc Plant Code' ;
    rdfs:comment 'NERC-assigned unique identifier for the generation plant used for reliability reporting and compliance.' ;
    rdfs:domain ind:Plant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Net Capacity Mw' ;
    rdfs:comment 'Net generation capacity in megawatts after accounting for auxiliary load and station service requirements.' ;
    rdfs:domain ind:Plant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:numberOfUnits rdf:type rdf:Property ;
    rdfs:label 'Number Of Units' ;
    rdfs:comment 'Total count of individual generation units or turbines within the plant facility.' ;
    rdfs:domain ind:Plant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:plannedRetirementDate rdf:type rdf:Property ;
    rdfs:label 'Planned Retirement Date' ;
    rdfs:comment 'Scheduled date for permanent retirement or decommissioning of the generation facility. Null if no retirement is planned.' ;
    rdfs:domain ind:Plant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:plantCode rdf:type rdf:Property ;
    rdfs:label 'Plant Code' ;
    rdfs:comment 'Internal utility-assigned alphanumeric code for the generation plant used in operational systems.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:plantName rdf:type rdf:Property ;
    rdfs:label 'Plant Name' ;
    rdfs:comment 'Official name of the generation facility as registered with regulatory authorities.' ;
    rdfs:domain ind:Plant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryTechnology rdf:type rdf:Property ;
    rdfs:label 'Primary Technology' ;
    rdfs:comment 'Specific generation technology employed by the plant (e.g., combined cycle, steam turbine, photovoltaic, wind turbine).' ;
    rdfs:domain ind:Plant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scadaSystemTag rdf:type rdf:Property ;
    rdfs:label 'Scada System Tag' ;
    rdfs:comment 'Primary SCADA system tag or identifier used to retrieve real-time operational data from OSIsoft PI Historian.' ;
    rdfs:domain ind:Plant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transmissionOwner rdf:type rdf:Property ;
    rdfs:label 'Transmission Owner' ;
    rdfs:comment 'Entity that owns the transmission facilities to which the plant is interconnected.' ;
    rdfs:domain ind:Plant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ppaDeliveryId rdf:type rdf:Property ;
    rdfs:label 'Ppa Delivery Id' ;
    rdfs:comment 'Unique identifier for each PPA delivery transaction record.' ;
    rdfs:domain ind:PpaDelivery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:balancingAuthorityBalancingAreaId rdf:type rdf:Property ;
    rdfs:label 'Balancing Authority Balancing Area Id' ;
    rdfs:comment 'Reference to the balancing authority area in which this delivery occurred, relevant for grid operations and settlement.' ;
    rdfs:domain ind:PpaDelivery ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BalancingArea .

ind:actualDeliveryMwh rdf:type rdf:Property ;
    rdfs:label 'Actual Delivery Mwh' ;
    rdfs:comment 'The actual amount of energy in megawatt-hours (MWh) that was delivered during this period, as measured by metering systems.' ;
    rdfs:domain ind:PpaDelivery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ancillaryServicesAmount rdf:type rdf:Property ;
    rdfs:label 'Ancillary Services Amount' ;
    rdfs:comment 'The dollar amount charged for ancillary services such as frequency regulation, voltage support, and operating reserves associated with this delivery.' ;
    rdfs:domain ind:PpaDelivery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capacityPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Capacity Payment Amount' ;
    rdfs:comment 'The dollar amount paid for capacity availability during this delivery period, separate from energy payment, if the PPA includes capacity charges.' ;
    rdfs:domain ind:PpaDelivery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contractedPricePerMwh rdf:type rdf:Property ;
    rdfs:label 'Contracted Price Per Mwh' ;
    rdfs:comment 'The base price per megawatt-hour (MWh) specified in the PPA contract for this delivery period.' ;
    rdfs:domain ind:PpaDelivery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:curtailmentMwh rdf:type rdf:Property ;
    rdfs:label 'Curtailment Mwh' ;
    rdfs:comment 'The amount of energy in megawatt-hours (MWh) that was curtailed or not delivered due to grid constraints, economic dispatch, or other operational reasons.' ;
    rdfs:domain ind:PpaDelivery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:curtailmentReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Curtailment Reason Description' ;
    rdfs:comment 'Detailed narrative explanation of the circumstances that led to curtailment of the scheduled delivery.' ;
    rdfs:domain ind:PpaDelivery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryDate rdf:type rdf:Property ;
    rdfs:label 'Delivery Date' ;
    rdfs:comment 'The calendar date on which the energy delivery occurred, used for daily aggregation and reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deliveryPeriodEnd rdf:type rdf:Property ;
    rdfs:label 'Delivery Period End' ;
    rdfs:comment 'The timestamp when the delivery period ended, representing the conclusion of energy flow under this transaction.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryPeriodStart rdf:type rdf:Property ;
    rdfs:label 'Delivery Period Start' ;
    rdfs:comment 'The timestamp when the delivery period began, representing the start of energy flow under this transaction.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryPointCode rdf:type rdf:Property ;
    rdfs:label 'Delivery Point Code' ;
    rdfs:comment 'Reference to the physical or virtual delivery point where energy was transferred to the buyer under the PPA.' ;
    rdfs:domain ind:PpaDelivery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:deliveryStatus rdf:type rdf:Property ;
    rdfs:label 'Delivery Status' ;
    rdfs:comment 'Current lifecycle status of the delivery transaction in the settlement workflow.' ;
    rdfs:domain ind:PpaDelivery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryTransactionNumber rdf:type rdf:Property ;
    rdfs:label 'Delivery Transaction Number' ;
    rdfs:comment 'Externally-known unique transaction identifier for this delivery event, used for settlement and reconciliation.' ;
    rdfs:domain ind:PpaDelivery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:energyPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Energy Payment Amount' ;
    rdfs:comment 'The dollar amount paid specifically for energy delivered (MWh), calculated as actual delivery multiplied by energy price component.' ;
    rdfs:domain ind:PpaDelivery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forceMajeureFlag rdf:type rdf:Property ;
    rdfs:label 'Force Majeure Flag' ;
    rdfs:comment 'Indicates whether this delivery was affected by a force majeure event as defined in the PPA contract, which may excuse non-performance.' ;
    rdfs:domain ind:PpaDelivery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priceAdjustmentAmount rdf:type rdf:Property ;
    rdfs:label 'Price Adjustment Amount' ;
    rdfs:comment 'Total dollar amount of adjustments applied to the base contracted price, including penalties, bonuses, indexation, or other contractual modifications.' ;
    rdfs:domain ind:PpaDelivery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recTransferFlag rdf:type rdf:Property ;
    rdfs:label 'Rec Transfer Flag' ;
    rdfs:comment 'Indicates whether RECs were transferred to the buyer as part of this delivery transaction (True) or retained by the seller (False).' ;
    rdfs:domain ind:PpaDelivery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scheduledDeliveryMwh rdf:type rdf:Property ;
    rdfs:label 'Scheduled Delivery Mwh' ;
    rdfs:comment 'The contracted or scheduled amount of energy in megawatt-hours (MWh) that was planned for delivery during this period.' ;
    rdfs:domain ind:PpaDelivery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:schedulingCoordinator rdf:type rdf:Property ;
    rdfs:label 'Scheduling Coordinator' ;
    rdfs:comment 'Name or identifier of the entity responsible for scheduling this delivery with the Independent System Operator (ISO) or Regional Transmission Organization (RTO).' ;
    rdfs:domain ind:PpaDelivery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementPricePerMwh rdf:type rdf:Property ;
    rdfs:label 'Settlement Price Per Mwh' ;
    rdfs:comment 'The price per megawatt-hour (MWh) applied to this delivery for settlement purposes, which may differ from the contracted price due to adjustments, penalties, or market conditions.' ;
    rdfs:domain ind:PpaDelivery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:timeOfUsePeriod rdf:type rdf:Property ;
    rdfs:label 'Time Of Use Period' ;
    rdfs:comment 'The time-of-use pricing period classification for this delivery, affecting settlement price and capacity value.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Total Payment Amount' ;
    rdfs:comment 'The total dollar amount payable for this delivery transaction, calculated as actual delivery multiplied by settlement price plus any adjustments.' ;
    rdfs:domain ind:PpaDelivery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transmissionChargeAmount rdf:type rdf:Property ;
    rdfs:label 'Transmission Charge Amount' ;
    rdfs:comment 'The dollar amount of transmission and delivery charges associated with moving the energy from generation point to delivery point.' ;
    rdfs:domain ind:PpaDelivery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:varianceMwh rdf:type rdf:Property ;
    rdfs:label 'Variance Mwh' ;
    rdfs:comment 'The difference between scheduled and actual delivery in megawatt-hours (MWh), calculated as actual minus scheduled, used for performance monitoring and settlement adjustments.' ;
    rdfs:domain ind:PpaDelivery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:resourceMeterId rdf:type rdf:Property ;
    rdfs:label 'Resource Meter Id' ;
    rdfs:comment 'Foreign key linking to metering.meter. Business justification: Renewable resource (e.g., solar farm) must be linked to a meter for REC tracking and net-metering calculations.' ;
    rdfs:domain ind:RenewableResource ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Meter .

ind:transmissionInterconnectionAgreementId rdf:type rdf:Property ;
    rdfs:label 'Transmission Interconnection Agreement Id' ;
    rdfs:comment 'Foreign key linking to transmission.interconnection_agreement. Business justification: Renewable projects must be linked to their Interconnection Agreement for compliance and market eligibility.' ;
    rdfs:domain ind:RenewableResource ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InterconnectionAgreement .

ind:capacityFactorDesignPct rdf:type rdf:Property ;
    rdfs:label 'Capacity Factor Design Pct' ;
    rdfs:comment 'Design or expected capacity factor as a percentage, representing the ratio of actual energy output to theoretical maximum output over a year. Used for Integrated Resource Plan (IRP) modeling and Levelized Cost of Energy (LCOE) analysis. Typical values: solar 15-25%, wind 30-45%, hydro 40-60%.' ;
    rdfs:domain ind:RenewableResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dermsIntegrationFlag rdf:type rdf:Property ;
    rdfs:label 'Derms Integration Flag' ;
    rdfs:comment 'Indicates whether the renewable resource is integrated with the utility\'s Distributed Energy Resource Management System for real-time monitoring, forecasting, and dispatch control. True if integrated, False otherwise. Supports Virtual Power Plant (VPP) operations and grid flexibility.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:eamAssetNumber rdf:type rdf:Property ;
    rdfs:label 'Eam Asset Number' ;
    rdfs:comment 'Unique identifier linking this renewable resource to its asset record in the Enterprise Asset Management system (Maximo). Used for maintenance planning, work order management, and asset lifecycle tracking.' ;
    rdfs:domain ind:RenewableResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gisAssetReference rdf:type rdf:Property ;
    rdfs:label 'Gis Asset Reference' ;
    rdfs:comment 'Unique identifier linking this renewable resource to its representation in the utility\'s GIS system (Esri ArcGIS). Enables spatial analysis, asset visualization, and integration with transmission and distribution network models.' ;
    rdfs:domain ind:RenewableResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hubHeightM rdf:type rdf:Property ;
    rdfs:label 'Hub Height M' ;
    rdfs:comment 'Height of the wind turbine hub above ground level in meters. Critical parameter for wind resource assessment and energy yield modeling. Applicable to wind resources only. Null for solar and hydro.' ;
    rdfs:domain ind:RenewableResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:installedCapacityMwAc rdf:type rdf:Property ;
    rdfs:label 'Installed Capacity Mw Ac' ;
    rdfs:comment 'Nameplate capacity of the renewable resource in megawatts AC (alternating current), representing the maximum continuous electrical output at the point of interconnection. For solar, this is the inverter-limited AC capacity.' ;
    rdfs:domain ind:RenewableResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:installedCapacityMwDc rdf:type rdf:Property ;
    rdfs:label 'Installed Capacity Mw Dc' ;
    rdfs:comment 'For solar PV resources, the total DC capacity of the solar panels before inversion. Null for non-solar resources. Used to calculate DC-to-AC ratio for solar performance analysis.' ;
    rdfs:domain ind:RenewableResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inverterManufacturer rdf:type rdf:Property ;
    rdfs:label 'Inverter Manufacturer' ;
    rdfs:comment 'Manufacturer of the inverter equipment for solar PV resources (e.g., \'SMA\', \'Fronius\', \'SolarEdge\'). Applicable to solar PV only. Null for wind and hydro.' ;
    rdfs:domain ind:RenewableResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inverterModel rdf:type rdf:Property ;
    rdfs:label 'Inverter Model' ;
    rdfs:comment 'Model designation of the inverter equipment for solar PV resources. Applicable to solar PV only. Null for wind and hydro.' ;
    rdfs:domain ind:RenewableResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nemEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Nem Eligible Flag' ;
    rdfs:comment 'Indicates whether the renewable resource is eligible for Net Energy Metering programs, allowing bidirectional energy flow and credit for excess generation. True if eligible, False otherwise. Primarily applicable to distributed solar resources.' ;
    rdfs:domain ind:RenewableResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ownerOperatorType rdf:type rdf:Property ;
    rdfs:label 'Owner Operator Type' ;
    rdfs:comment 'Classification of ownership and operational responsibility. Utility-owned indicates direct ownership and operation, third-party PPA indicates independent power producer with power purchase agreement, customer-owned NEM indicates behind-the-meter distributed generation, joint venture indicates shared ownership.' ;
    rdfs:domain ind:RenewableResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:panelModel rdf:type rdf:Property ;
    rdfs:label 'Panel Model' ;
    rdfs:comment 'Manufacturer and model designation of solar panels installed (e.g., \'SunPower Maxeon 3-400W\'). Applicable to solar PV resources only. Null for wind and hydro.' ;
    rdfs:domain ind:RenewableResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ppaContractNumber rdf:type rdf:Property ;
    rdfs:label 'Ppa Contract Number' ;
    rdfs:comment 'Unique identifier for the Power Purchase Agreement governing the sale of energy and/or capacity from this renewable resource. References the contractual terms, pricing structure, and delivery obligations. Confidential business information.' ;
    rdfs:domain ind:RenewableResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recTrackingSystemCode rdf:type rdf:Property ;
    rdfs:label 'Rec Tracking System Code' ;
    rdfs:comment 'Unique identifier assigned by the regional REC tracking system (e.g., PJM-GATS, WREGIS, M-RETS) for tracking and trading renewable energy certificates generated by this resource. Used for renewable portfolio standard (RPS) compliance and REC monetization.' ;
    rdfs:domain ind:RenewableResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordActiveFlag rdf:type rdf:Property ;
    rdfs:label 'Record Active Flag' ;
    rdfs:comment 'Indicates whether this renewable resource record is currently active in the system. True for active records, False for logically deleted or archived records. Used for soft-delete pattern and historical record retention.' ;
    rdfs:domain ind:RenewableResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reservoirCapacityAcreFeet rdf:type rdf:Property ;
    rdfs:label 'Reservoir Capacity Acre Feet' ;
    rdfs:comment 'Total storage capacity of the hydro reservoir in acre-feet. Applicable to pumped storage and reservoir-based hydro. Null for run-of-river hydro, solar, and wind.' ;
    rdfs:domain ind:RenewableResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:resourceCode rdf:type rdf:Property ;
    rdfs:label 'Resource Code' ;
    rdfs:comment 'Externally-known unique business identifier for the renewable resource, used in operational systems and regulatory reporting. Typically follows utility naming convention for generation assets.' ;
    rdfs:domain ind:RenewableResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resourceZone rdf:type rdf:Property ;
    rdfs:label 'Resource Zone' ;
    rdfs:comment 'Geographic or operational zone designation for the renewable resource, used for resource planning and dispatch optimization. May align with ISO/RTO pricing zones or internal planning regions.' ;
    rdfs:domain ind:RenewableResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rotorDiameterM rdf:type rdf:Property ;
    rdfs:label 'Rotor Diameter M' ;
    rdfs:comment 'Diameter of the wind turbine rotor (blade tip to blade tip) in meters. Determines swept area and energy capture capability. Applicable to wind resources only. Null for solar and hydro.' ;
    rdfs:domain ind:RenewableResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:turbineModel rdf:type rdf:Property ;
    rdfs:label 'Turbine Model' ;
    rdfs:comment 'Manufacturer and model designation of wind turbine (e.g., \'GE 2.5-120\', \'Vestas V150-4.2MW\'). Applicable to wind resources only. Null for solar and hydro.' ;
    rdfs:domain ind:RenewableResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waterHeadM rdf:type rdf:Property ;
    rdfs:label 'Water Head M' ;
    rdfs:comment 'Vertical distance (head) between the upstream water level and the turbine in meters. Key parameter for hydro generation capacity and efficiency. Applicable to hydro resources only. Null for solar and wind.' ;
    rdfs:domain ind:RenewableResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:startupShutdownEventId rdf:type rdf:Property ;
    rdfs:label 'Startup Shutdown Event Id' ;
    rdfs:comment 'Unique identifier for the startup or shutdown event record.' ;
    rdfs:domain ind:StartupShutdownEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:initiatingTechnicianId rdf:type rdf:Property ;
    rdfs:label 'Initiating Technician Id' ;
    rdfs:comment 'Foreign key linking to workforce.technician. Business justification: Startup/shutdown logs capture the technician who initiated the event, essential for cost allocation and incident analysis.' ;
    rdfs:domain ind:StartupShutdownEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Technician .

ind:emissionFactorCode rdf:type rdf:Property ;
    rdfs:label 'Emission Factor Code' ;
    rdfs:comment 'Code of the emission factor methodology applied to calculate emissions for this event.' ;
    rdfs:domain ind:StartupShutdownEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Event Reference Code' ;
    rdfs:comment 'Business identifier code assigned to the event for external tracking and reporting.' ;
    rdfs:domain ind:StartupShutdownEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fuelConsumedMmbtu rdf:type rdf:Property ;
    rdfs:label 'Fuel Consumed Mmbtu' ;
    rdfs:comment 'Amount of fuel used during the startup, measured in million British thermal units.' ;
    rdfs:domain ind:StartupShutdownEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:initiatingCause rdf:type rdf:Property ;
    rdfs:label 'Initiating Cause' ;
    rdfs:comment 'Primary cause that triggered the startup or shutdown.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isEstimated rdf:type rdf:Property ;
    rdfs:label 'Is Estimated' ;
    rdfs:comment 'Indicates whether any numeric values (fuel, emissions, cost) are estimated rather than measured.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isReportableToFerc rdf:type rdf:Property ;
    rdfs:label 'Is Reportable To Ferc' ;
    rdfs:comment 'Indicates if the event must be reported to the Federal Energy Regulatory Commission.' ;
    rdfs:domain ind:StartupShutdownEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:netStartupCostUsd rdf:type rdf:Property ;
    rdfs:label 'Net Startup Cost Usd' ;
    rdfs:comment 'Net cost after adjustments, representing the final amount charged for the startup.' ;
    rdfs:domain ind:StartupShutdownEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:startupCostAdjustmentUsd rdf:type rdf:Property ;
    rdfs:label 'Startup Cost Adjustment Usd' ;
    rdfs:comment 'Any adjustments (credits or penalties) applied to the base startup cost.' ;
    rdfs:domain ind:StartupShutdownEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:startupCostUsd rdf:type rdf:Property ;
    rdfs:label 'Startup Cost Usd' ;
    rdfs:comment 'Direct cost incurred for the unit startup, expressed in US dollars.' ;
    rdfs:domain ind:StartupShutdownEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:startupShutdownEventStatus rdf:type rdf:Property ;
    rdfs:label 'Startup Shutdown Event Status' ;
    rdfs:comment 'Current lifecycle status of the startup/shutdown event.' ;
    rdfs:domain ind:StartupShutdownEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unitStatusAfter rdf:type rdf:Property ;
    rdfs:label 'Unit Status After' ;
    rdfs:comment 'Operational status of the unit immediately after the event.' ;
    rdfs:domain ind:StartupShutdownEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unitStatusBefore rdf:type rdf:Property ;
    rdfs:label 'Unit Status Before' ;
    rdfs:comment 'Operational status of the unit immediately before the event.' ;
    rdfs:domain ind:StartupShutdownEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unitAvailabilityId rdf:type rdf:Property ;
    rdfs:label 'Unit Availability Id' ;
    rdfs:comment 'Unique identifier for the unit availability record.' ;
    rdfs:domain ind:UnitAvailability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:availabilityDate rdf:type rdf:Property ;
    rdfs:label 'Availability Date' ;
    rdfs:comment 'The calendar date for which this availability record applies.' ;
    rdfs:domain ind:UnitAvailability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:availabilityHour rdf:type rdf:Property ;
    rdfs:label 'Availability Hour' ;
    rdfs:comment 'The hour of the day (0-23) for hourly availability tracking. Null for daily aggregated records.' ;
    rdfs:domain ind:UnitAvailability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:availabilityStatus rdf:type rdf:Property ;
    rdfs:label 'Availability Status' ;
    rdfs:comment 'Current operational availability status of the generating unit for the specified period.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deratedCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Derated Capacity Mw' ;
    rdfs:comment 'The reduction in generating capacity in megawatts due to partial equipment failure or operational constraints while the unit remains in service.' ;
    rdfs:domain ind:UnitAvailability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deratingFlag rdf:type rdf:Property ;
    rdfs:label 'Derating Flag' ;
    rdfs:comment 'Indicates whether the unit is operating at reduced capacity due to a derating event.' ;
    rdfs:domain ind:UnitAvailability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:environmentalConstraintFlag rdf:type rdf:Property ;
    rdfs:label 'Environmental Constraint Flag' ;
    rdfs:comment 'Indicates whether environmental permit limits (emissions, water discharge, noise) are constraining unit availability or capacity.' ;
    rdfs:domain ind:UnitAvailability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:equivalentAvailabilityFactorPercent rdf:type rdf:Property ;
    rdfs:label 'Equivalent Availability Factor Percent' ;
    rdfs:comment 'NERC GADS metric representing the percentage of time the unit was available to generate at full capacity, accounting for partial outages and deratings.' ;
    rdfs:domain ind:UnitAvailability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:equivalentForcedOutageRatePercent rdf:type rdf:Property ;
    rdfs:label 'Equivalent Forced Outage Rate Percent' ;
    rdfs:comment 'NERC GADS metric representing the percentage of time the unit was unavailable due to forced outages, including partial forced outages.' ;
    rdfs:domain ind:UnitAvailability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eventDurationHours rdf:type rdf:Property ;
    rdfs:label 'Event Duration Hours' ;
    rdfs:comment 'The total duration of the availability event in hours, calculated from start to end timestamp.' ;
    rdfs:domain ind:UnitAvailability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eventEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Event End Timestamp' ;
    rdfs:comment 'The precise date and time when the availability event (outage or derating) ended and the unit returned to available status. Null for ongoing events.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:eventStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Event Start Timestamp' ;
    rdfs:comment 'The precise date and time when the availability event (outage or derating) began.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:forcedOutageCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Forced Outage Capacity Mw' ;
    rdfs:comment 'The capacity in megawatts unavailable due to unplanned forced outages caused by equipment failure or emergency conditions.' ;
    rdfs:domain ind:UnitAvailability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fuelAvailabilityStatus rdf:type rdf:Property ;
    rdfs:label 'Fuel Availability Status' ;
    rdfs:comment 'Status of fuel availability for the generating unit, which may impact operational availability (applicable to fossil fuel and biomass units).' ;
    rdfs:domain ind:UnitAvailability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gadsEventCode rdf:type rdf:Property ;
    rdfs:label 'Gads Event Code' ;
    rdfs:comment 'NERC GADS standardized event code classifying the type of availability event (e.g., U1, U2, U3 for unplanned outages; PO for planned outages).' ;
    rdfs:domain ind:UnitAvailability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maintenanceOutageCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Maintenance Outage Capacity Mw' ;
    rdfs:comment 'The capacity in megawatts unavailable due to maintenance outages that can be deferred beyond the end of the next weekend but require attention within six weeks.' ;
    rdfs:domain ind:UnitAvailability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netDependableCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Net Dependable Capacity Mw' ;
    rdfs:comment 'The maximum net capacity in megawatts that the unit can sustain over a specified period under normal operating conditions, accounting for station service loads.' ;
    rdfs:domain ind:UnitAvailability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:operatorNotes rdf:type rdf:Property ;
    rdfs:label 'Operator Notes' ;
    rdfs:comment 'Free-text notes entered by plant operators or control room staff providing additional context about the availability event.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outageCauseCode rdf:type rdf:Property ;
    rdfs:label 'Outage Cause Code' ;
    rdfs:comment 'Standardized code identifying the root cause or component system responsible for the outage or derating event.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outageCauseDescription rdf:type rdf:Property ;
    rdfs:label 'Outage Cause Description' ;
    rdfs:comment 'Detailed narrative description of the cause of the outage or derating event, including affected equipment and failure mode.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:plannedOutageCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Planned Outage Capacity Mw' ;
    rdfs:comment 'The capacity in megawatts unavailable due to scheduled planned outages for maintenance or overhaul.' ;
    rdfs:domain ind:UnitAvailability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recordCreatedBy rdf:type rdf:Property ;
    rdfs:label 'Record Created By' ;
    rdfs:comment 'The user ID or system process that created this availability record.' ;
    rdfs:domain ind:UnitAvailability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordUpdatedBy rdf:type rdf:Property ;
    rdfs:label 'Record Updated By' ;
    rdfs:comment 'The user ID or system process that last updated this availability record.' ;
    rdfs:domain ind:UnitAvailability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsibleSystem rdf:type rdf:Property ;
    rdfs:label 'Responsible System' ;
    rdfs:comment 'The source system responsible for capturing and reporting this availability data (EMS, SCADA, PI Historian, manual entry).' ;
    rdfs:domain ind:UnitAvailability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seasonalDeratingFlag rdf:type rdf:Property ;
    rdfs:label 'Seasonal Derating Flag' ;
    rdfs:comment 'Indicates whether the capacity reduction is due to seasonal environmental factors (e.g., high ambient temperature, low water availability).' ;
    rdfs:domain ind:UnitAvailability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transmissionConstraintFlag rdf:type rdf:Property ;
    rdfs:label 'Transmission Constraint Flag' ;
    rdfs:comment 'Indicates whether transmission system constraints are limiting the units ability to deliver available capacity to the grid.' ;
    rdfs:domain ind:UnitAvailability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:unavailableCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Unavailable Capacity Mw' ;
    rdfs:comment 'The generating capacity in megawatts that is unavailable due to outages or deratings during the period.' ;
    rdfs:domain ind:UnitAvailability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:alarmEventId rdf:type rdf:Property ;
    rdfs:label 'Alarm Event Id' ;
    rdfs:comment 'Unique identifier for the alarm event record. Primary key.' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AlarmEvent .

ind:shelvedByOperatorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Shelved By Operator Employee Id' ;
    rdfs:comment 'User ID of the operator who shelved the alarm. Required for audit and compliance.' ;
    rdfs:domain ind:AlarmEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:acknowledgedByOperatorName rdf:type rdf:Property ;
    rdfs:label 'Acknowledged By Operator Name' ;
    rdfs:comment 'Full name of the operator who acknowledged the alarm. Denormalized for reporting convenience.' ;
    rdfs:domain ind:AlarmEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acknowledgedFlag rdf:type rdf:Property ;
    rdfs:label 'Acknowledged Flag' ;
    rdfs:comment 'Indicates whether the alarm has been acknowledged by an operator. True if acknowledged, False if still unacknowledged.' ;
    rdfs:domain ind:AlarmEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:acknowledgedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Acknowledged Timestamp' ;
    rdfs:comment 'Date and time when the alarm was acknowledged by an operator. Null if not yet acknowledged.' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:alarmCategory rdf:type rdf:Property ;
    rdfs:label 'Alarm Category' ;
    rdfs:comment 'Business classification of the alarm condition: thermal_overload (conductor or transformer heating), voltage_violation (over/under voltage), frequency_deviation (grid frequency out of range), equipment_failure (device malfunction), communication_loss (telemetry failure), or protection_system (relay or breaker operation).' ;
    rdfs:domain ind:AlarmEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alarmCount rdf:type rdf:Property ;
    rdfs:label 'Alarm Count' ;
    rdfs:comment 'Number of times this alarm condition has occurred for this asset within the current analysis window. Used for alarm flood detection and nuisance alarm identification.' ;
    rdfs:domain ind:AlarmEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:alarmDescription rdf:type rdf:Property ;
    rdfs:label 'Alarm Description' ;
    rdfs:comment 'Detailed description of the alarm condition, including context, potential causes, and recommended operator actions. Used for training and alarm rationalization.' ;
    rdfs:domain ind:AlarmEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alarmMessage rdf:type rdf:Property ;
    rdfs:label 'Alarm Message' ;
    rdfs:comment 'Full alarm message text as presented to the operator in the SCADA/EMS system. Includes asset name, condition description, and measured value.' ;
    rdfs:domain ind:AlarmEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alarmState rdf:type rdf:Property ;
    rdfs:label 'Alarm State' ;
    rdfs:comment 'Current lifecycle state of the alarm: active (unacknowledged and condition persists), acknowledged (operator has seen it), cleared (condition returned to normal), shelved (temporarily disabled), suppressed (filtered by alarm management logic), or stale (communication lost).' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alarmTimestamp rdf:type rdf:Property ;
    rdfs:label 'Alarm Timestamp' ;
    rdfs:comment 'Precise date and time when the alarm condition was detected and the alarm was triggered in the SCADA/EMS system. This is the operational event time, distinct from record creation time.' ;
    rdfs:domain ind:AlarmEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:alarmType rdf:type rdf:Property ;
    rdfs:label 'Alarm Type' ;
    rdfs:comment 'Classification of the alarm based on the nature of the monitored condition: analog (threshold violation on continuous measurement), digital (discrete state change), calculated (derived condition), communication (loss of signal), equipment_status (device health), or protection_operation (relay trip).' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cipClassification rdf:type rdf:Property ;
    rdfs:label 'Cip Classification' ;
    rdfs:comment 'NERC CIP impact classification of the asset or system that generated this alarm: high (critical cyber assets), medium (medium impact BES cyber systems), low (low impact BES cyber systems), or not_applicable.' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clearedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Cleared Timestamp' ;
    rdfs:comment 'Date and time when the alarm condition returned to normal and the alarm was cleared. Null if alarm is still active.' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:emsAlarmCode rdf:type rdf:Property ;
    rdfs:label 'Ems Alarm Code' ;
    rdfs:comment 'Native alarm identifier from the EMS system. Used for cross-system reconciliation and audit trails.' ;
    rdfs:domain ind:AlarmEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nercReportableFlag rdf:type rdf:Property ;
    rdfs:label 'Nerc Reportable Flag' ;
    rdfs:comment 'Indicates whether this alarm represents a condition that must be reported to NERC under reliability standards (e.g., Bulk Electric System disturbance, CIP cyber security event). True if reportable, False otherwise.' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:shelvedFlag rdf:type rdf:Property ;
    rdfs:label 'Shelved Flag' ;
    rdfs:comment 'Indicates whether the alarm has been temporarily shelved (suppressed) by an operator. True if shelved, False otherwise. Shelving is used during maintenance or known abnormal conditions.' ;
    rdfs:domain ind:AlarmEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:shelvedReason rdf:type rdf:Property ;
    rdfs:label 'Shelved Reason' ;
    rdfs:comment 'Operator-entered justification for shelving the alarm (e.g., \'Planned maintenance on Transformer T-101\', \'Known communication issue during storm\').' ;
    rdfs:domain ind:AlarmEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shelvedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Shelved Timestamp' ;
    rdfs:comment 'Date and time when the alarm was shelved. Null if not shelved.' ;
    rdfs:domain ind:AlarmEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:suppressedFlag rdf:type rdf:Property ;
    rdfs:label 'Suppressed Flag' ;
    rdfs:comment 'Indicates whether the alarm was automatically suppressed by alarm management logic (e.g., flood suppression, consequential alarm filtering). True if suppressed, False otherwise.' ;
    rdfs:domain ind:AlarmEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:suppressionRule rdf:type rdf:Property ;
    rdfs:label 'Suppression Rule' ;
    rdfs:comment 'Name or identifier of the alarm management rule that suppressed this alarm (e.g., \'Substation Lockout Flood Suppression\', \'Communication Loss Consequential Filter\').' ;
    rdfs:domain ind:AlarmEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thresholdValue rdf:type rdf:Property ;
    rdfs:label 'Threshold Value' ;
    rdfs:comment 'The configured threshold or setpoint that was exceeded to trigger the alarm (e.g., high limit, low limit, deadband). Null for digital/status alarms.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:timeToAcknowledgeSeconds rdf:type rdf:Property ;
    rdfs:label 'Time To Acknowledge Seconds' ;
    rdfs:comment 'Elapsed time in seconds between alarm_timestamp and acknowledged_timestamp. Key performance indicator for operator response time per ISA-18.2.' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:timeToClearSeconds rdf:type rdf:Property ;
    rdfs:label 'Time To Clear Seconds' ;
    rdfs:comment 'Elapsed time in seconds between alarm_timestamp and cleared_timestamp. Measures total alarm duration and system restoration time.' ;
    rdfs:domain ind:AlarmEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:triggerValue rdf:type rdf:Property ;
    rdfs:label 'Trigger Value' ;
    rdfs:comment 'The measured value that triggered the alarm condition (e.g., actual current in amps, voltage in kV, temperature in Celsius, frequency in Hz). Null for digital/status alarms.' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:abbreviation rdf:type rdf:Property ;
    rdfs:label 'Abbreviation' ;
    rdfs:comment 'Short-form abbreviation or acronym for the balancing authority area used in SCADA displays, EMS dispatch screens, and operational communications (e.g., MISO, PJM, SPP).' ;
    rdfs:domain ind:BalancingArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agcEnabled rdf:type rdf:Property ;
    rdfs:label 'Agc Enabled' ;
    rdfs:comment 'Indicates whether Automatic Generation Control (AGC) is active for this balancing area. AGC continuously adjusts generator output to maintain ACE within NERC BAL-001 limits. Critical flag for EMS dispatch configuration.' ;
    rdfs:domain ind:BalancingArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:areaSqMiles rdf:type rdf:Property ;
    rdfs:label 'Area Sq Miles' ;
    rdfs:comment 'Total geographic area of the balancing authority service territory in square miles. Used in infrastructure density analysis, storm response planning, and regulatory filings with state PUCs.' ;
    rdfs:domain ind:BalancingArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:areaType rdf:type rdf:Property ;
    rdfs:label 'Area Type' ;
    rdfs:comment 'Classification of the operational jurisdiction type. Distinguishes between a full NERC-registered balancing authority, a sub-control area operating under a parent BA, or a reserve sharing group. Drives dispatch logic and reliability obligation scope in the EMS.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:balancingAreaName rdf:type rdf:Property ;
    rdfs:label 'Balancing Area Name' ;
    rdfs:comment 'Full legal or operational name of the balancing authority area as registered with NERC and recognized by FERC. Used in regulatory filings, RTO/ISO coordination, and operational reporting.' ;
    rdfs:domain ind:BalancingArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:controlAreaAceLimitMw rdf:type rdf:Property ;
    rdfs:label 'Control Area Ace Limit Mw' ;
    rdfs:comment 'The maximum allowable Area Control Error (ACE) in megawatts for this balancing area, as defined in the NERC BAL-001 standard. ACE is the real-time difference between actual and scheduled interchange plus frequency bias. This limit drives EMS automatic generation control (AGC) setpoints.' ;
    rdfs:domain ind:BalancingArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:demandResponseCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Demand Response Capacity Mw' ;
    rdfs:comment 'Total enrolled demand response (DR) capacity in megawatts (MW) available within this balancing area for dispatch during peak demand or grid emergency events. Includes both direct load control and interruptible load programs.' ;
    rdfs:domain ind:BalancingArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:derCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Der Capacity Mw' ;
    rdfs:comment 'Total nameplate capacity of distributed energy resources (DER) — including rooftop solar, battery storage, and small-scale generation — interconnected within this balancing area. Used in DERMS integration and load forecasting.' ;
    rdfs:domain ind:BalancingArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eiaBaCode rdf:type rdf:Property ;
    rdfs:label 'Eia Ba Code' ;
    rdfs:comment 'The EIA-assigned balancing authority code used in mandatory EIA Form 930 (Hourly Electric Grid Monitor) and EIA Form 411 submissions. Enables linkage between operational data and public EIA reporting.' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emsSystemCode rdf:type rdf:Property ;
    rdfs:label 'Ems System Code' ;
    rdfs:comment 'The native identifier for this balancing area as configured in the GE PowerOn Advanced Energy Management System (EMS). Used for cross-referencing real-time operational data from the EMS with the lakehouse silver layer record.' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:frequencyBiasMwPerHz rdf:type rdf:Property ;
    rdfs:label 'Frequency Bias Mw Per Hz' ;
    rdfs:comment 'The frequency bias setting for this balancing area expressed in megawatts per hertz (MW/Hz). This value is used in the ACE calculation formula and must be reported to NERC annually under BAL-003. Configured in the EMS AGC module.' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interchangeSchedulingMethod rdf:type rdf:Property ;
    rdfs:label 'Interchange Scheduling Method' ;
    rdfs:comment 'The method used to schedule energy interchange transactions across the balancing area boundary. E-Tag indicates use of the NERC e-Tag system for electronic tagging of interchange. RTO-managed indicates the RTO/ISO controls interchange scheduling.' ;
    rdfs:domain ind:BalancingArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interconnection rdf:type rdf:Property ;
    rdfs:label 'Interconnection' ;
    rdfs:comment 'The North American AC synchronous interconnection to which this balancing area belongs. Determines frequency regulation obligations, emergency assistance protocols, and NERC reliability standards applicability.' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:latitudeCentroid rdf:type rdf:Property ;
    rdfs:label 'Latitude Centroid' ;
    rdfs:comment 'Decimal latitude of the geographic centroid of the balancing area boundary polygon, in WGS84 coordinate reference system. Used for GIS visualization in Esri ArcGIS and spatial analytics.' ;
    rdfs:domain ind:BalancingArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lmpPricingNodeCode rdf:type rdf:Property ;
    rdfs:label 'Lmp Pricing Node Code' ;
    rdfs:comment 'The RTO/ISO-assigned pricing node code for the primary Locational Marginal Price (LMP) settlement point associated with this balancing area. Used in Allegro ETRM for energy trading settlement and DAM/RTM position management.' ;
    rdfs:domain ind:BalancingArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loadServingEntityCount rdf:type rdf:Property ;
    rdfs:label 'Load Serving Entity Count' ;
    rdfs:comment 'Number of load serving entities (LSEs) operating within this balancing area. Used in resource adequacy planning, reserve sharing agreements, and NERC reliability assessments.' ;
    rdfs:domain ind:BalancingArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:longitudeCentroid rdf:type rdf:Property ;
    rdfs:label 'Longitude Centroid' ;
    rdfs:comment 'Decimal longitude of the geographic centroid of the balancing area boundary polygon, in WGS84 coordinate reference system. Used for GIS visualization in Esri ArcGIS and spatial analytics.' ;
    rdfs:domain ind:BalancingArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:marketParticipation rdf:type rdf:Property ;
    rdfs:label 'Market Participation' ;
    rdfs:comment 'Indicates whether this balancing area participates in a wholesale energy market (Day-Ahead Market or Real-Time Market) operated by an RTO/ISO. True for market-participating areas; False for vertically integrated utilities operating outside organized markets.' ;
    rdfs:domain ind:BalancingArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nercBaaCode rdf:type rdf:Property ;
    rdfs:label 'Nerc Baa Code' ;
    rdfs:comment 'The official NERC-assigned alphanumeric code uniquely identifying this balancing authority area within the North American bulk electric system. Used in NERC compliance filings, EIA-411 submissions, and interchange scheduling.' ;
    rdfs:domain ind:BalancingArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nercRegistrationDate rdf:type rdf:Property ;
    rdfs:label 'Nerc Registration Date' ;
    rdfs:comment 'The date on which this balancing authority area was formally registered with NERC as a functional entity. Establishes the start of NERC reliability standard compliance obligations.' ;
    rdfs:domain ind:BalancingArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nominalFrequencyHz rdf:type rdf:Property ;
    rdfs:label 'Nominal Frequency Hz' ;
    rdfs:comment 'The nominal AC system frequency in hertz (Hz) for this balancing area (typically 60.000 Hz for North American interconnections). Used as the reference frequency for ACE calculations and frequency regulation compliance.' ;
    rdfs:domain ind:BalancingArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:operatingReserveRequirementMw rdf:type rdf:Property ;
    rdfs:label 'Operating Reserve Requirement Mw' ;
    rdfs:comment 'The minimum operating reserve requirement in megawatts (MW) that must be maintained within this balancing area at all times, per NERC BAL-002 and applicable RTO/ISO tariff requirements. Includes both spinning and non-spinning reserves.' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:peakLoadMw rdf:type rdf:Property ;
    rdfs:label 'Peak Load Mw' ;
    rdfs:comment 'Historical or projected annual peak demand in megawatts (MW) for the balancing area. Used in reserve margin calculations, IRP planning, and NERC reliability assessments submitted to FERC and state PUCs.' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:primaryFrequencyRegulationMhz rdf:type rdf:Property ;
    rdfs:label 'Primary Frequency Regulation Mhz' ;
    rdfs:comment 'The primary frequency response obligation assigned to this balancing area, expressed in megahertz (MHz) of frequency deviation response capability. Used in NERC BAL-003 compliance tracking and EMS frequency regulation dispatch.' ;
    rdfs:domain ind:BalancingArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:renewableCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Renewable Capacity Mw' ;
    rdfs:comment 'Total nameplate capacity of renewable energy sources (wind, solar, hydro, geothermal) in megawatts (MW) within the balancing area. Used in REC tracking, IRP filings, and state renewable portfolio standard (RPS) compliance reporting.' ;
    rdfs:domain ind:BalancingArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reserveMarginPct rdf:type rdf:Property ;
    rdfs:label 'Reserve Margin Pct' ;
    rdfs:comment 'The required or actual planning reserve margin expressed as a percentage of peak load. Represents the buffer of generation capacity above peak demand required to maintain reliability. Reported in IRP filings and NERC assessments.' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rtoIsoMembership rdf:type rdf:Property ;
    rdfs:label 'Rto Iso Membership' ;
    rdfs:comment 'Name of the RTO or ISO within which this balancing area operates or is a member (e.g., PJM Interconnection, MISO, SPP, CAISO, ERCOT, NYISO, ISO-NE). Null if the utility operates as an independent balancing authority outside an RTO/ISO.' ;
    rdfs:domain ind:BalancingArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:saidiTargetMinutes rdf:type rdf:Property ;
    rdfs:label 'Saidi Target Minutes' ;
    rdfs:comment 'The annual SAIDI performance target in minutes for this balancing area, representing the average total duration of interruptions per customer. Reported to state PUCs and used in reliability benchmarking.' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:saifiTarget rdf:type rdf:Property ;
    rdfs:label 'Saifi Target' ;
    rdfs:comment 'The annual SAIFI performance target for this balancing area, representing the average number of interruptions per customer per year. Reported to state PUCs and used in reliability benchmarking alongside SAIDI.' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scadaAreaCode rdf:type rdf:Property ;
    rdfs:label 'Scada Area Code' ;
    rdfs:comment 'The SCADA system area code assigned to this balancing area in the operational technology environment. Used to correlate real-time telemetry from OSIsoft PI Historian with the balancing area master record for operational intelligence.' ;
    rdfs:domain ind:BalancingArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:spinningReserveRequirementMw rdf:type rdf:Property ;
    rdfs:label 'Spinning Reserve Requirement Mw' ;
    rdfs:comment 'The minimum spinning (synchronized) reserve requirement in megawatts (MW) for this balancing area. Spinning reserves must be online and capable of responding within 10 minutes per NERC BAL-002 standards.' ;
    rdfs:domain ind:BalancingArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stateCodes rdf:type rdf:Property ;
    rdfs:label 'State Codes' ;
    rdfs:comment 'Comma-separated list of two-letter US state abbreviations (e.g., OH,IN,MI) representing the states within or overlapping the balancing area boundary. Determines which state PUC jurisdictions apply for rate case filings and regulatory compliance.' ;
    rdfs:domain ind:BalancingArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tieLineCount rdf:type rdf:Property ;
    rdfs:label 'Tie Line Count' ;
    rdfs:comment 'Number of high-voltage transmission tie lines connecting this balancing area to adjacent balancing areas. Used in interchange scheduling, contingency analysis, and NERC CIP-014 physical security assessments.' ;
    rdfs:domain ind:BalancingArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:timeZone rdf:type rdf:Property ;
    rdfs:label 'Time Zone' ;
    rdfs:comment 'The IANA time zone identifier for the primary operating time zone of this balancing area (e.g., America/Chicago, America/New_York). Used for scheduling, dispatch, and market settlement time alignment.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transmissionOperatorCode rdf:type rdf:Property ;
    rdfs:label 'Transmission Operator Code' ;
    rdfs:comment 'The NERC-assigned identifier of the Transmission Operator (TOP) responsible for operating the transmission facilities within this balancing area. May differ from the balancing authority in restructured markets.' ;
    rdfs:domain ind:BalancingArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transmissionVoltageKv rdf:type rdf:Property ;
    rdfs:label 'Transmission Voltage Kv' ;
    rdfs:comment 'The primary bulk electric system transmission voltage level in kilovolts (kV) for this balancing area (e.g., 345 kV, 500 kV, 765 kV). Defines the BES threshold and NERC CIP applicability scope.' ;
    rdfs:domain ind:BalancingArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cipStandardId rdf:type rdf:Property ;
    rdfs:label 'Cip Standard Id' ;
    rdfs:comment 'Foreign key linking to regulatory.cip_standard. Business justification: Each control zone is subject to a specific CIP standard; the FK supports compliance tracking and audit readiness.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CipStandard .

ind:controlCenterId rdf:type rdf:Property ;
    rdfs:label 'Control Center Id' ;
    rdfs:comment 'Foreign key linking to gridops.control_center. Business justification: A control center oversees multiple control zones; adding control_zone.control_center_id creates the necessary parent relationship and eliminates the silo for control_center.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ControlCenter .

ind:amiMeterCount rdf:type rdf:Property ;
    rdfs:label 'Ami Meter Count' ;
    rdfs:comment 'Number of Advanced Metering Infrastructure (AMI) smart meters deployed within this control zone. Used for demand response targeting, load disaggregation, and meter data management (MDM) reporting.' ;
    rdfs:domain ind:ControlZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:areaControlErrorThresholdMw rdf:type rdf:Property ;
    rdfs:label 'Area Control Error Threshold Mw' ;
    rdfs:comment 'Maximum allowable Area Control Error (ACE) in Megawatts (MW) for this control zone before corrective dispatch action is triggered. Defined per NERC BAL-001 compliance requirements for balancing authority performance.' ;
    rdfs:domain ind:ControlZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:busCount rdf:type rdf:Property ;
    rdfs:label 'Bus Count' ;
    rdfs:comment 'Number of electrical buses (nodes) within this control zone as modeled in the EMS network topology. Used for state estimation, power flow analysis, and contingency analysis.' ;
    rdfs:domain ind:ControlZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:criticalInfrastructureFlag rdf:type rdf:Property ;
    rdfs:label 'Critical Infrastructure Flag' ;
    rdfs:comment 'Indicates whether this control zone contains or serves Critical Infrastructure Protection (CIP) assets as defined by NERC CIP standards. Zones flagged true require enhanced cybersecurity controls and physical security measures.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:customerCount rdf:type rdf:Property ;
    rdfs:label 'Customer Count' ;
    rdfs:comment 'Total number of end-use customers (residential and commercial) served within this control zone. Used for SAIDI/SAIFI/CAIDI reliability index calculations and outage impact assessments.' ;
    rdfs:domain ind:ControlZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:derIntegrationEnabled rdf:type rdf:Property ;
    rdfs:label 'Der Integration Enabled' ;
    rdfs:comment 'Indicates whether Distributed Energy Resources (DER) — including rooftop solar, battery storage, and small-scale generation — are actively managed within this control zone via the DERMS platform.' ;
    rdfs:domain ind:ControlZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dispatchPriority rdf:type rdf:Property ;
    rdfs:label 'Dispatch Priority' ;
    rdfs:comment 'Numeric priority rank assigned to this control zone for load dispatch and restoration sequencing. Lower values indicate higher priority. Used by EMS/DMS operators during contingency events and load shedding scenarios.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dmsZoneCode rdf:type rdf:Property ;
    rdfs:label 'Dms Zone Code' ;
    rdfs:comment 'Zone identifier as configured in the Distribution Management System (DMS) for feeder switching, fault isolation, and service restoration coordination. Distinct from the EMS zone ID as DMS operates at distribution voltage levels.' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drProgramEligible rdf:type rdf:Property ;
    rdfs:label 'Dr Program Eligible' ;
    rdfs:comment 'Indicates whether this control zone participates in Demand Response (DR) dispatch programs. Zones flagged true are included in DR event targeting, load curtailment calculations, and DERMS coordination.' ;
    rdfs:domain ind:ControlZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:emsZoneCode rdf:type rdf:Property ;
    rdfs:label 'Ems Zone Code' ;
    rdfs:comment 'Zone identifier as configured in the Energy Management System (EMS) for state estimation, optimal power flow, and automatic generation control (AGC) dispatch. Enables cross-system traceability between the EMS and the data lakehouse.' ;
    rdfs:domain ind:ControlZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feederCount rdf:type rdf:Property ;
    rdfs:label 'Feeder Count' ;
    rdfs:comment 'Number of distribution feeders managed within this control zone. Supports feeder load balancing, switching order management, and outage restoration planning in the DMS.' ;
    rdfs:domain ind:ControlZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:frequencyRegulationEligible rdf:type rdf:Property ;
    rdfs:label 'Frequency Regulation Eligible' ;
    rdfs:comment 'Indicates whether this control zone is eligible to provide frequency regulation ancillary services to the balancing authority or RTO/ISO market. True if the zone has resources capable of automatic generation control (AGC) response.' ;
    rdfs:domain ind:ControlZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gisZoneCode rdf:type rdf:Property ;
    rdfs:label 'Gis Zone Code' ;
    rdfs:comment 'Zone identifier in the Esri ArcGIS geospatial system. Links the logical control zone to its physical geographic boundary polygon for spatial analysis, outage impact mapping, and infrastructure planning.' ;
    rdfs:domain ind:ControlZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interconnectionType rdf:type rdf:Property ;
    rdfs:label 'Interconnection Type' ;
    rdfs:comment 'North American electrical interconnection to which this control zone belongs: Eastern Interconnection, Western Interconnection, ERCOT (Texas), Alaska, or Hawaii. Determines synchronous grid boundaries and applicable NERC reliability standards.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastConfigurationReviewDate rdf:type rdf:Property ;
    rdfs:label 'Last Configuration Review Date' ;
    rdfs:comment 'Date of the most recent formal review of this control zone\'s EMS/DMS configuration parameters, including voltage setpoints, protection relay settings, and dispatch parameters. Supports NERC FAC-002 compliance documentation.' ;
    rdfs:domain ind:ControlZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:loadForecastModel rdf:type rdf:Property ;
    rdfs:label 'Load Forecast Model' ;
    rdfs:comment 'Type of load forecasting methodology applied to this control zone within the Energy Management System (EMS). Determines how short-term and long-term load forecasts are generated for dispatch coordination and resource planning.' ;
    rdfs:domain ind:ControlZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loadSheddingEligible rdf:type rdf:Property ;
    rdfs:label 'Load Shedding Eligible' ;
    rdfs:comment 'Indicates whether this control zone is eligible for controlled load shedding during grid emergency conditions. Zones containing critical infrastructure (hospitals, emergency services) are typically excluded.' ;
    rdfs:domain ind:ControlZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nercCipClassification rdf:type rdf:Property ;
    rdfs:label 'Nerc Cip Classification' ;
    rdfs:comment 'NERC CIP impact classification level for Bulk Electric System (BES) assets within this control zone. High and Medium classifications require mandatory cybersecurity and physical security controls per NERC CIP-002 through CIP-014.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netEnergyMeteringEligible rdf:type rdf:Property ;
    rdfs:label 'Net Energy Metering Eligible' ;
    rdfs:comment 'Indicates whether customers within this control zone are eligible for Net Energy Metering (NEM) programs, allowing bi-directional energy flow credit for distributed generation (e.g., rooftop solar). Affects load forecasting and grid hosting capacity analysis.' ;
    rdfs:domain ind:ControlZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:omsZoneCode rdf:type rdf:Property ;
    rdfs:label 'Oms Zone Code' ;
    rdfs:comment 'Zone identifier as registered in the Outage Management System (OMS). Used to correlate outage events, crew dispatch, and restoration activities to this control zone for SAIDI/SAIFI/CAIDI reporting.' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateCode rdf:type rdf:Property ;
    rdfs:label 'State Code' ;
    rdfs:comment 'Two-letter US state code for the primary jurisdiction in which this control zone operates. Determines applicable state Public Utility Commission (PUC) regulations, rate cases, and reliability standards.' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:substationCount rdf:type rdf:Property ;
    rdfs:label 'Substation Count' ;
    rdfs:comment 'Number of substations included within this control zone. Used for operational complexity assessment, maintenance planning, and regulatory asset base (RAB) reporting.' ;
    rdfs:domain ind:ControlZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tieLineCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Tie Line Capacity Mw' ;
    rdfs:comment 'Total rated transfer capacity in Megawatts (MW) of all tie lines connecting this control zone to adjacent zones or balancing areas. Used for interchange scheduling and Available Transfer Capability (ATC) calculations.' ;
    rdfs:domain ind:ControlZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:touPricingApplicable rdf:type rdf:Property ;
    rdfs:label 'Tou Pricing Applicable' ;
    rdfs:comment 'Indicates whether Time-of-Use (TOU) pricing rates are applicable to customers within this control zone. Drives load shape modeling and demand response program design for the zone.' ;
    rdfs:domain ind:ControlZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:voltageControlMode rdf:type rdf:Property ;
    rdfs:label 'Voltage Control Mode' ;
    rdfs:comment 'Operational mode for voltage control within this zone as configured in the DMS/EMS. Automatic mode enables closed-loop voltage regulation; supervisory mode allows operator-directed control; manual mode requires direct field action.' ;
    rdfs:domain ind:ControlZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:weatherZoneCode rdf:type rdf:Property ;
    rdfs:label 'Weather Zone Code' ;
    rdfs:comment 'Code identifying the weather forecast zone associated with this control zone. Weather zone data drives temperature-sensitive load forecasting models and storm preparedness planning within the EMS.' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zoneCode rdf:type rdf:Property ;
    rdfs:label 'Zone Code' ;
    rdfs:comment 'Externally-known alphanumeric code uniquely identifying the control zone within the Energy Management System (EMS) and Distribution Management System (DMS). Used in SCADA displays, switching orders, and operational reports.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zoneDescription rdf:type rdf:Property ;
    rdfs:label 'Zone Description' ;
    rdfs:comment 'Free-text operational description of the control zone including its geographic boundaries, key assets, operational characteristics, and any special operating conditions or constraints relevant to dispatch and reliability management.' ;
    rdfs:domain ind:ControlZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zoneName rdf:type rdf:Property ;
    rdfs:label 'Zone Name' ;
    rdfs:comment 'Human-readable name of the control zone used in operational dashboards, load forecasting reports, and dispatch coordination communications.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zoneStatus rdf:type rdf:Property ;
    rdfs:label 'Zone Status' ;
    rdfs:comment 'Current lifecycle status of the control zone within the EMS/DMS. Active zones participate in real-time dispatch and load forecasting. Commissioning zones are being brought into service. Decommissioned zones are retired from grid operations.' ;
    rdfs:domain ind:ControlZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zoneType rdf:type rdf:Property ;
    rdfs:label 'Zone Type' ;
    rdfs:comment 'Operational classification of the control zone indicating its primary grid function: load (demand-side), generation (supply-side), transmission (bulk power), distribution (end-delivery), balancing (area control), or interchange (tie-point between areas).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actualMwReduction rdf:type rdf:Property ;
    rdfs:label 'Actual Mw Reduction' ;
    rdfs:comment 'The actual measured load reduction in megawatts (MW) achieved across all participating resources, aggregated from interval meter data.' ;
    rdfs:domain ind:DrDispatchEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:baselineMethodology rdf:type rdf:Property ;
    rdfs:label 'Baseline Methodology' ;
    rdfs:comment 'The baseline calculation methodology used to determine pre-event load and measure actual reduction: high 10 of 10 (highest 10 of last 10 similar days), mid 8 of 10, high 5 of 10, customer baseline (negotiated), or meter before/after (direct measurement).' ;
    rdfs:domain ind:DrDispatchEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispatchAuthorizationCode rdf:type rdf:Property ;
    rdfs:label 'Dispatch Authorization Code' ;
    rdfs:comment 'The authorization code or approval reference for the dispatch event, required for emergency and economic dispatches per operating procedures.' ;
    rdfs:domain ind:DrDispatchEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispatchDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Dispatch Duration Minutes' ;
    rdfs:comment 'The total duration of the DR dispatch event in minutes, calculated from start to end timestamp.' ;
    rdfs:domain ind:DrDispatchEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dispatchEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Dispatch End Timestamp' ;
    rdfs:comment 'The scheduled end date and time for the DR curtailment event.' ;
    rdfs:domain ind:DrDispatchEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dispatchIssuedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Dispatch Issued Timestamp' ;
    rdfs:comment 'The date and time when the DR dispatch event was issued by grid operations to participating resources.' ;
    rdfs:domain ind:DrDispatchEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dispatchNotes rdf:type rdf:Property ;
    rdfs:label 'Dispatch Notes' ;
    rdfs:comment 'Free-text operational notes and comments recorded by the dispatch operator regarding event circumstances, special conditions, or post-event observations.' ;
    rdfs:domain ind:DrDispatchEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispatchStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Dispatch Start Timestamp' ;
    rdfs:comment 'The scheduled start date and time for the DR curtailment event.' ;
    rdfs:domain ind:DrDispatchEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dispatchStatus rdf:type rdf:Property ;
    rdfs:label 'Dispatch Status' ;
    rdfs:comment 'Current lifecycle status of the DR dispatch event: pending (notification sent, not yet active), active (curtailment in progress), completed (event concluded), cancelled (event aborted), failed (dispatch unsuccessful).' ;
    rdfs:domain ind:DrDispatchEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispatchTriggerType rdf:type rdf:Property ;
    rdfs:label 'Dispatch Trigger Type' ;
    rdfs:comment 'The operational reason for issuing the DR dispatch: emergency (grid emergency), economic (price-driven), capacity (resource adequacy), test (program validation), scheduled (planned event), or reliability (NERC compliance).' ;
    rdfs:domain ind:DrDispatchEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ferc2222ReportableFlag rdf:type rdf:Property ;
    rdfs:label 'Ferc 2222 Reportable Flag' ;
    rdfs:comment 'Boolean flag indicating whether this dispatch event involves aggregated DER participation and is reportable under FERC Order 2222 requirements.' ;
    rdfs:domain ind:DrDispatchEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:frequencyDeviationHz rdf:type rdf:Property ;
    rdfs:label 'Frequency Deviation Hz' ;
    rdfs:comment 'The grid frequency deviation in hertz (Hz) from nominal 60 Hz at the time of dispatch, if the dispatch was triggered by frequency regulation needs.' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gridEmergencyLevel rdf:type rdf:Property ;
    rdfs:label 'Grid Emergency Level' ;
    rdfs:comment 'The grid emergency alert level at the time of dispatch issuance, ranging from normal to emergency levels 1-3 per NERC EEA protocols.' ;
    rdfs:domain ind:DrDispatchEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lmpTriggerPrice rdf:type rdf:Property ;
    rdfs:label 'Lmp Trigger Price' ;
    rdfs:comment 'The locational marginal price (LMP) in dollars per MWh that triggered an economic DR dispatch, if applicable.' ;
    rdfs:domain ind:DrDispatchEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:notificationLeadTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Notification Lead Time Minutes' ;
    rdfs:comment 'The advance notice time in minutes between dispatch issuance and dispatch start, as required by program rules.' ;
    rdfs:domain ind:DrDispatchEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:notificationMethod rdf:type rdf:Property ;
    rdfs:label 'Notification Method' ;
    rdfs:comment 'The primary method used to notify DR participants of the dispatch event: automated signal (OpenADR, API), phone, email, SMS, web portal, or SCADA command.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performancePercentage rdf:type rdf:Property ;
    rdfs:label 'Performance Percentage' ;
    rdfs:comment 'The overall performance of the dispatch event expressed as a percentage of actual MW reduction divided by target MW reduction.' ;
    rdfs:domain ind:DrDispatchEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scadaSnapshotTimestamp rdf:type rdf:Property ;
    rdfs:label 'Scada Snapshot Timestamp' ;
    rdfs:comment 'The timestamp of the SCADA system snapshot captured at dispatch issuance, used for grid state verification and post-event analysis.' ;
    rdfs:domain ind:DrDispatchEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:settlementReadyFlag rdf:type rdf:Property ;
    rdfs:label 'Settlement Ready Flag' ;
    rdfs:comment 'Boolean flag indicating whether all performance data has been validated and the event is ready for financial settlement and capacity payment processing.' ;
    rdfs:domain ind:DrDispatchEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:targetMwReduction rdf:type rdf:Property ;
    rdfs:label 'Target Mw Reduction' ;
    rdfs:comment 'The total target load reduction in megawatts (MW) requested from all participating DR resources for this dispatch event.' ;
    rdfs:domain ind:DrDispatchEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalResourcesDispatched rdf:type rdf:Property ;
    rdfs:label 'Total Resources Dispatched' ;
    rdfs:comment 'The total count of individual DR resources (customers, aggregators, DERs) that were dispatched as part of this event.' ;
    rdfs:domain ind:DrDispatchEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalResourcesResponded rdf:type rdf:Property ;
    rdfs:label 'Total Resources Responded' ;
    rdfs:comment 'The count of dispatched resources that successfully responded and achieved measurable load reduction during the event.' ;
    rdfs:domain ind:DrDispatchEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:voltageDeviationKv rdf:type rdf:Property ;
    rdfs:label 'Voltage Deviation Kv' ;
    rdfs:comment 'The voltage deviation in kilovolts (kV) from nominal levels at critical substations, if the dispatch was triggered by voltage control needs.' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:weatherAdjustedFlag rdf:type rdf:Property ;
    rdfs:label 'Weather Adjusted Flag' ;
    rdfs:comment 'Boolean flag indicating whether the baseline and performance calculations were adjusted for weather conditions (temperature, humidity) per program rules.' ;
    rdfs:domain ind:DrDispatchEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:drResourceResponseId rdf:type rdf:Property ;
    rdfs:label 'Dr Resource Response Id' ;
    rdfs:comment 'Unique identifier for the demand response resource response record. Primary key.' ;
    rdfs:domain ind:DrResourceResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:drResourceId rdf:type rdf:Property ;
    rdfs:label 'Dr Resource Id' ;
    rdfs:comment 'Reference to the specific DR resource or aggregator that responded to the dispatch event.' ;
    rdfs:domain ind:DrResourceResponse ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Resource .

ind:actualLoadMw rdf:type rdf:Property ;
    rdfs:label 'Actual Load Mw' ;
    rdfs:comment 'The actual metered load in megawatts during the DR event period, measured from AMI or SCADA systems.' ;
    rdfs:domain ind:DrResourceResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualReductionMw rdf:type rdf:Property ;
    rdfs:label 'Actual Reduction Mw' ;
    rdfs:comment 'The actual measured load reduction in megawatts achieved by the resource, calculated as baseline minus actual load.' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:balancingAuthorityArea rdf:type rdf:Property ;
    rdfs:label 'Balancing Authority Area' ;
    rdfs:comment 'The balancing authority area code where this DR resource is located and responded.' ;
    rdfs:domain ind:DrResourceResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:baselineCalculationMethod rdf:type rdf:Property ;
    rdfs:label 'Baseline Calculation Method' ;
    rdfs:comment 'The methodology used to calculate the baseline load for this resource (e.g., 10-of-10, 5-of-10, regression-based).' ;
    rdfs:domain ind:DrResourceResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:baselineLoadMw rdf:type rdf:Property ;
    rdfs:label 'Baseline Load Mw' ;
    rdfs:comment 'The calculated baseline load in megawatts representing what the resource would have consumed without the DR event, used for settlement calculations.' ;
    rdfs:domain ind:DrResourceResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:compliancePercentage rdf:type rdf:Property ;
    rdfs:label 'Compliance Percentage' ;
    rdfs:comment 'The percentage of nominated reduction actually delivered, calculated as (actual reduction / nominated reduction) * 100.' ;
    rdfs:domain ind:DrResourceResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dispatchInstructionType rdf:type rdf:Property ;
    rdfs:label 'Dispatch Instruction Type' ;
    rdfs:comment 'Classification of the dispatch instruction that triggered this response.' ;
    rdfs:domain ind:DrResourceResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Event Duration Minutes' ;
    rdfs:comment 'The total duration in minutes that the resource was expected to maintain the load reduction.' ;
    rdfs:domain ind:DrResourceResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:nominatedReductionMw rdf:type rdf:Property ;
    rdfs:label 'Nominated Reduction Mw' ;
    rdfs:comment 'The committed or nominated load reduction in megawatts that the resource agreed to provide for this dispatch event.' ;
    rdfs:domain ind:DrResourceResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nonComplianceReason rdf:type rdf:Property ;
    rdfs:label 'Non Compliance Reason' ;
    rdfs:comment 'Explanation or code indicating why the resource failed to meet compliance requirements, if applicable.' ;
    rdfs:domain ind:DrResourceResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reboundEffectMw rdf:type rdf:Property ;
    rdfs:label 'Rebound Effect Mw' ;
    rdfs:comment 'The measured load increase in megawatts immediately following the DR event, representing the rebound or snapback effect.' ;
    rdfs:domain ind:DrResourceResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reductionVarianceMw rdf:type rdf:Property ;
    rdfs:label 'Reduction Variance Mw' ;
    rdfs:comment 'The difference between nominated and actual reduction in megawatts, used for compliance and performance assessment.' ;
    rdfs:domain ind:DrResourceResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:responseEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Response End Timestamp' ;
    rdfs:comment 'The actual date and time when the resource completed its response to the dispatch event.' ;
    rdfs:domain ind:DrResourceResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:responseStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Response Start Timestamp' ;
    rdfs:comment 'The actual date and time when the resource began responding to the dispatch signal.' ;
    rdfs:domain ind:DrResourceResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:telemetryQualityFlag rdf:type rdf:Property ;
    rdfs:label 'Telemetry Quality Flag' ;
    rdfs:comment 'Data quality indicator for the metered telemetry used in this response measurement.' ;
    rdfs:domain ind:DrResourceResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:weatherAdjustmentApplied rdf:type rdf:Property ;
    rdfs:label 'Weather Adjustment Applied' ;
    rdfs:comment 'Indicates whether a weather-based adjustment was applied to the baseline calculation to account for temperature or other weather impacts.' ;
    rdfs:domain ind:DrResourceResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:operatorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Operator Employee Id' ;
    rdfs:comment 'Reference to the EMS operator or system entity (AGC) that issued this dispatch instruction. Used for accountability and audit trail per NERC CIP and reliability standards.' ;
    rdfs:domain ind:EmsDispatchInstruction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:acknowledgmentStatus rdf:type rdf:Property ;
    rdfs:label 'Acknowledgment Status' ;
    rdfs:comment 'Status of the generating unit or resource operator\'s acknowledgment of this dispatch instruction. Pending indicates awaiting response; acknowledged confirms receipt; not_acknowledged indicates no response within the required window; rejected indicates the resource declined the instruction.' ;
    rdfs:domain ind:EmsDispatchInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acknowledgmentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Acknowledgment Timestamp' ;
    rdfs:comment 'The date and time at which the generating unit operator or automated system acknowledged receipt of this dispatch instruction.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:agcSequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Agc Sequence Number' ;
    rdfs:comment 'Sequential number assigned by the Automatic Generation Control (AGC) system for this dispatch instruction within a given AGC scan cycle. Used to correlate instructions to AGC telemetry cycles in OSIsoft PI Historian.' ;
    rdfs:domain ind:EmsDispatchInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:co2EmissionRateLbPerMwh rdf:type rdf:Property ;
    rdfs:label 'Co2 Emission Rate Lb Per Mwh' ;
    rdfs:comment 'The estimated CO2 emission rate for the dispatched generating unit at the instructed MW setpoint, expressed in pounds per MWh. Used for environmental compliance reporting to EPA and state regulators.' ;
    rdfs:domain ind:EmsDispatchInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contingencyName rdf:type rdf:Property ;
    rdfs:label 'Contingency Name' ;
    rdfs:comment 'The name or identifier of the N-1 or N-2 contingency scenario that triggered this dispatch instruction, if applicable. Used for post-contingency analysis and NERC reliability event reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:derFlag rdf:type rdf:Property ;
    rdfs:label 'Der Flag' ;
    rdfs:comment 'Indicates whether this dispatch instruction targets a Distributed Energy Resource (DER) such as rooftop solar, battery storage, or small-scale generation managed via DERMS.' ;
    rdfs:domain ind:EmsDispatchInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dispatchType rdf:type rdf:Property ;
    rdfs:label 'Dispatch Type' ;
    rdfs:comment 'Indicates whether the dispatch instruction was generated automatically by the AGC system or issued manually by an EMS operator. Automatic instructions originate from AGC scan cycles; manual instructions are operator-initiated.' ;
    rdfs:domain ind:EmsDispatchInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectiveTimestamp rdf:type rdf:Property ;
    rdfs:label 'Effective Timestamp' ;
    rdfs:comment 'The date and time at which the dispatch instruction is expected to take effect at the generating unit. May differ from instruction_timestamp due to ramp lead time or scheduling offset.' ;
    rdfs:domain ind:EmsDispatchInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:energySourceType rdf:type rdf:Property ;
    rdfs:label 'Energy Source Type' ;
    rdfs:comment 'The primary energy source type of the dispatched generating unit or resource. Used for generation mix reporting, renewable energy tracking, and REC (Renewable Energy Certificate) accounting. [ENUM-REF-CANDIDATE: fossil_fuel|nuclear|hydro|wind|solar|battery_storage|demand_response|other — promote to reference product]' ;
    rdfs:domain ind:EmsDispatchInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expiryTimestamp rdf:type rdf:Property ;
    rdfs:label 'Expiry Timestamp' ;
    rdfs:comment 'The date and time at which this dispatch instruction expires or is superseded if not acknowledged or executed. After this time, the instruction is considered void.' ;
    rdfs:domain ind:EmsDispatchInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:frequencyRegulationFlag rdf:type rdf:Property ;
    rdfs:label 'Frequency Regulation Flag' ;
    rdfs:comment 'Indicates whether this dispatch instruction is associated with frequency regulation service (AGC regulation signal). True when the instruction is part of a regulation up/down signal from the balancing authority.' ;
    rdfs:domain ind:EmsDispatchInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:instructionNumber rdf:type rdf:Property ;
    rdfs:label 'Instruction Number' ;
    rdfs:comment 'Externally-known, human-readable business identifier for the dispatch instruction, used in operator logs, audit trails, and regulatory filings. Format: EMS-DISP-YYYY-NNNNNN.' ;
    rdfs:domain ind:EmsDispatchInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:instructionStatus rdf:type rdf:Property ;
    rdfs:label 'Instruction Status' ;
    rdfs:comment 'Current lifecycle status of the dispatch instruction. Tracks the workflow from issuance through acknowledgment, execution, and completion or cancellation. [ENUM-REF-CANDIDATE: issued|acknowledged|executing|completed|cancelled|rejected — promote to reference product if additional statuses are needed]' ;
    rdfs:domain ind:EmsDispatchInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:instructionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Instruction Timestamp' ;
    rdfs:comment 'The precise date and time (with timezone offset) at which the EMS issued this dispatch instruction to the generating unit or controllable resource. This is the principal business event timestamp.' ;
    rdfs:domain ind:EmsDispatchInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lmpAtDispatch rdf:type rdf:Property ;
    rdfs:label 'Lmp At Dispatch' ;
    rdfs:comment 'The Locational Marginal Price (LMP) in dollars per MWh at the dispatch node at the time this instruction was issued. Used for economic dispatch evaluation and post-dispatch settlement.' ;
    rdfs:domain ind:EmsDispatchInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lmpNodeCode rdf:type rdf:Property ;
    rdfs:label 'Lmp Node Code' ;
    rdfs:comment 'Reference to the pricing node at which the Locational Marginal Price (LMP) applies for this dispatch instruction. Used for economic dispatch optimization and settlement calculations.' ;
    rdfs:domain ind:EmsDispatchInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:marketIntervalCode rdf:type rdf:Property ;
    rdfs:label 'Market Interval Code' ;
    rdfs:comment 'Reference to the energy market interval (Day-Ahead Market or Real-Time Market) associated with this dispatch instruction. Links to the market scheduling system or ETRM (Allegro) interval record.' ;
    rdfs:domain ind:EmsDispatchInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:mvarSetpoint rdf:type rdf:Property ;
    rdfs:label 'Mvar Setpoint' ;
    rdfs:comment 'The target reactive power output level in Megavars (MVAR) instructed for voltage support purposes. Applicable when dispatch_reason is voltage_support or when reactive dispatch is co-optimized.' ;
    rdfs:domain ind:EmsDispatchInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mwActualResponse rdf:type rdf:Property ;
    rdfs:label 'Mw Actual Response' ;
    rdfs:comment 'The actual MW output achieved by the generating unit in response to this dispatch instruction, as measured by SCADA telemetry from OSIsoft PI Historian. Used to assess dispatch compliance and unit performance.' ;
    rdfs:domain ind:EmsDispatchInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mwComplianceDeviation rdf:type rdf:Property ;
    rdfs:label 'Mw Compliance Deviation' ;
    rdfs:comment 'The difference in MW between the instructed setpoint and the actual response (mw_actual_response minus mw_setpoint). Positive values indicate over-generation; negative values indicate under-generation. Used for NERC compliance analysis.' ;
    rdfs:domain ind:EmsDispatchInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mwDelta rdf:type rdf:Property ;
    rdfs:label 'Mw Delta' ;
    rdfs:comment 'The change in MW output instructed by this dispatch (mw_setpoint minus mw_setpoint_prior). Positive values indicate an increase in generation; negative values indicate a decrease. Used for ramp compliance analysis.' ;
    rdfs:domain ind:EmsDispatchInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mwSetpoint rdf:type rdf:Property ;
    rdfs:label 'Mw Setpoint' ;
    rdfs:comment 'The target real power output level in Megawatts (MW) that the generating unit or controllable resource is instructed to achieve. This is the principal quantitative dispatch directive.' ;
    rdfs:domain ind:EmsDispatchInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mwSetpointPrior rdf:type rdf:Property ;
    rdfs:label 'Mw Setpoint Prior' ;
    rdfs:comment 'The MW setpoint that was in effect immediately before this dispatch instruction was issued. Used to calculate the MW delta and assess ramp requirements.' ;
    rdfs:domain ind:EmsDispatchInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulationDirection rdf:type rdf:Property ;
    rdfs:label 'Regulation Direction' ;
    rdfs:comment 'Direction of frequency regulation service associated with this dispatch instruction. \'up\' indicates regulation up (increase output); \'down\' indicates regulation down (decrease output); \'none\' for non-regulation dispatches.' ;
    rdfs:domain ind:EmsDispatchInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rejectionReason rdf:type rdf:Property ;
    rdfs:label 'Rejection Reason' ;
    rdfs:comment 'Free-text or coded reason provided by the resource operator when a dispatch instruction is rejected or not acknowledged. Used for reliability event analysis and operator performance review.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reserveType rdf:type rdf:Property ;
    rdfs:label 'Reserve Type' ;
    rdfs:comment 'Type of operating reserve being activated by this dispatch instruction, if applicable. Spinning reserves are online and synchronized; non-spinning reserves can be brought online within 10 minutes; supplemental reserves provide longer-term backup.' ;
    rdfs:domain ind:EmsDispatchInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseTimestamp rdf:type rdf:Property ;
    rdfs:label 'Response Timestamp' ;
    rdfs:comment 'The date and time at which the generating unit reached or was confirmed to be at the instructed MW setpoint, as recorded by SCADA telemetry.' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:energyBalanceId rdf:type rdf:Property ;
    rdfs:label 'Energy Balance Id' ;
    rdfs:comment 'Unique surrogate identifier for each energy balance record in the balancing area. Primary key for the energy_balance data product.' ;
    rdfs:domain ind:EnergyBalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:aceAverageMw rdf:type rdf:Property ;
    rdfs:label 'Ace Average Mw' ;
    rdfs:comment 'Average Area Control Error (ACE) over the interval period in Megawatts (MW). Used for NERC Control Performance Standard (CPS1/CPS2) compliance calculations and regulatory reporting to NERC and state PUCs.' ;
    rdfs:domain ind:EnergyBalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:aceMw rdf:type rdf:Property ;
    rdfs:label 'Ace Mw' ;
    rdfs:comment 'Area Control Error (ACE) for the balancing area during the interval, expressed in Megawatts (MW). ACE = (Actual Net Interchange – Scheduled Net Interchange) – 10B(Actual Frequency – Scheduled Frequency). Key NERC BAL-001 compliance metric measuring real-time generation-load balance.' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualInterchangeMwh rdf:type rdf:Property ;
    rdfs:label 'Actual Interchange Mwh' ;
    rdfs:comment 'Actual metered energy interchange across balancing area tie-lines during the interval, expressed in MWh. Compared against scheduled_interchange_mwh to compute interchange deviation for NERC BAL compliance.' ;
    rdfs:domain ind:EnergyBalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cps1Score rdf:type rdf:Property ;
    rdfs:label 'Cps1 Score' ;
    rdfs:comment 'NERC Control Performance Standard 1 (CPS1) compliance score for the interval, expressed as a percentage. CPS1 measures the one-minute average ACE relative to frequency deviation. NERC requires a minimum 100% CPS1 score on a rolling 12-month basis.' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cps2ViolationFlag rdf:type rdf:Property ;
    rdfs:label 'Cps2 Violation Flag' ;
    rdfs:comment 'Indicates whether the balancing area exceeded the NERC Control Performance Standard 2 (CPS2) ACE limit (L10) during this interval. True = CPS2 violation occurred; False = within limits. Triggers mandatory NERC reporting when True.' ;
    rdfs:domain ind:EnergyBalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataQualityCode rdf:type rdf:Property ;
    rdfs:label 'Data Quality Code' ;
    rdfs:comment 'Quality indicator for the energy balance record derived from SCADA/PI Historian telemetry quality flags. \'good\' = validated telemetry; \'suspect\' = questionable reading requiring review; \'estimated\' = gap-filled or interpolated; \'bad\' = failed quality check; \'missing\' = no telemetry received.' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:derNetInjectionMwh rdf:type rdf:Property ;
    rdfs:label 'Der Net Injection Mwh' ;
    rdfs:comment 'Net energy injected into the grid from Distributed Energy Resources (DER) including rooftop solar, battery storage, and small-scale generation during the interval, expressed in MWh. Tracked via DERMS integration.' ;
    rdfs:domain ind:EnergyBalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:drResponseMwh rdf:type rdf:Property ;
    rdfs:label 'Dr Response Mwh' ;
    rdfs:comment 'Energy reduction achieved through Demand Response (DR) dispatch during the interval, expressed in MWh. Represents load curtailment from DR programs activated by the EMS/DERMS. Used for DR settlement and NERC BAL compliance.' ;
    rdfs:domain ind:EnergyBalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eia930ReportedFlag rdf:type rdf:Property ;
    rdfs:label 'Eia 930 Reported Flag' ;
    rdfs:comment 'Indicates whether this energy balance record has been included in an EIA Form 930 (Hourly Electric Grid Monitor) submission. True = reported to EIA; False = pending submission. Supports regulatory reporting completeness tracking.' ;
    rdfs:domain ind:EnergyBalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:finalizedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Finalized Timestamp' ;
    rdfs:comment 'Timestamp when this energy balance record was promoted from \'preliminary\' to \'final\' status following validation. Marks the completion of the operational accounting close for the interval.' ;
    rdfs:domain ind:EnergyBalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:fossilGenerationMwh rdf:type rdf:Property ;
    rdfs:label 'Fossil Generation Mwh' ;
    rdfs:comment 'Total energy generated from fossil fuel sources (natural gas, coal, oil) within the balancing area during the interval, expressed in MWh. Subset of total_generation_mwh. Used for emissions reporting to EPA and EIA.' ;
    rdfs:domain ind:EnergyBalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inadvertentInterchangeMwh rdf:type rdf:Property ;
    rdfs:label 'Inadvertent Interchange Mwh' ;
    rdfs:comment 'Accumulated inadvertent energy interchange for the interval, expressed in MWh. Represents the difference between actual and scheduled interchange that must be repaid to neighboring balancing areas per NERC BAL-005 payback requirements.' ;
    rdfs:domain ind:EnergyBalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:loadForecastErrorMwh rdf:type rdf:Property ;
    rdfs:label 'Load Forecast Error Mwh' ;
    rdfs:comment 'Difference between actual total load and forecasted load for the interval, expressed in MWh (actual minus forecast). Positive value indicates load exceeded forecast; negative indicates load was below forecast. Used to evaluate forecasting accuracy and improve EMS models.' ;
    rdfs:domain ind:EnergyBalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:loadForecastMwh rdf:type rdf:Property ;
    rdfs:label 'Load Forecast Mwh' ;
    rdfs:comment 'Forecasted energy load for the balancing area during the interval, expressed in MWh. Generated by the EMS load forecasting module prior to the operating interval. Used to compute forecast error and support dispatch planning.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nercComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Nerc Compliance Flag' ;
    rdfs:comment 'Indicates whether this energy balance interval is fully compliant with applicable NERC BAL reliability standards (BAL-001, BAL-002, BAL-003, BAL-005). True = compliant; False = one or more NERC BAL standard violations detected. Triggers compliance workflow when False.' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nercTagNumber rdf:type rdf:Property ;
    rdfs:label 'Nerc Tag Number' ;
    rdfs:comment 'NERC e-Tag identifier associated with the scheduled interchange transactions contributing to this energy balance interval. Used for cross-referencing with NERC e-Tag system for interchange scheduling and curtailment tracking.' ;
    rdfs:domain ind:EnergyBalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netInterchangeMwh rdf:type rdf:Property ;
    rdfs:label 'Net Interchange Mwh' ;
    rdfs:comment 'Net energy exchanged across the balancing area boundary during the interval, expressed in Megawatt-Hours (MWh). Positive value indicates net export; negative value indicates net import. Computed as sum of all scheduled and actual tie-line flows.' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nuclearGenerationMwh rdf:type rdf:Property ;
    rdfs:label 'Nuclear Generation Mwh' ;
    rdfs:comment 'Total energy generated from nuclear sources within the balancing area during the interval, expressed in MWh. Subset of total_generation_mwh. Reported separately per NRC and EIA requirements.' ;
    rdfs:domain ind:EnergyBalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:operatingDate rdf:type rdf:Property ;
    rdfs:label 'Operating Date' ;
    rdfs:comment 'The calendar date (in local prevailing time) to which this energy balance interval belongs. Used for daily aggregation, settlement, and regulatory reporting aligned to the operating day.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:operatingHour rdf:type rdf:Property ;
    rdfs:label 'Operating Hour' ;
    rdfs:comment 'The hour of the operating day (0–23) in which this interval falls, expressed in local prevailing time. Used for hourly aggregation, TOU analysis, and RTO/ISO settlement hour alignment.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:operatingReserveMw rdf:type rdf:Property ;
    rdfs:label 'Operating Reserve Mw' ;
    rdfs:comment 'Total operating reserve available in the balancing area at the start of the interval, expressed in Megawatts (MW). Includes spinning and non-spinning reserves. NERC BAL-002 compliance metric.' ;
    rdfs:domain ind:EnergyBalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:renewableGenerationMwh rdf:type rdf:Property ;
    rdfs:label 'Renewable Generation Mwh' ;
    rdfs:comment 'Total energy generated from renewable sources (wind, solar, hydro, geothermal, biomass) within the balancing area during the interval, expressed in MWh. Subset of total_generation_mwh. Supports Renewable Energy Certificate (REC) tracking and IRP reporting.' ;
    rdfs:domain ind:EnergyBalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:revisionReason rdf:type rdf:Property ;
    rdfs:label 'Revision Reason' ;
    rdfs:comment 'Free-text description of the reason for the most recent revision to this energy balance record (e.g., \'meter data correction\', \'SCADA telemetry gap fill\', \'RTO settlement adjustment\'). Populated only when revision_number > 0.' ;
    rdfs:domain ind:EnergyBalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduledInterchangeMwh rdf:type rdf:Property ;
    rdfs:label 'Scheduled Interchange Mwh' ;
    rdfs:comment 'Total energy interchange scheduled across balancing area tie-lines for the interval, expressed in MWh. Represents the Day-Ahead Market (DAM) or intra-day scheduled position prior to real-time deviations.' ;
    rdfs:domain ind:EnergyBalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:settledTimestamp rdf:type rdf:Property ;
    rdfs:label 'Settled Timestamp' ;
    rdfs:comment 'Timestamp when this energy balance record was accepted and confirmed by the RTO/ISO for financial settlement. Marks the completion of the market settlement lifecycle for the interval.' ;
    rdfs:domain ind:EnergyBalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:settlementPeriodType rdf:type rdf:Property ;
    rdfs:label 'Settlement Period Type' ;
    rdfs:comment 'Identifies the market settlement period type for this energy balance record. \'real_time\' = RTM interval data; \'day_ahead\' = DAM scheduled position; \'final_settlement\' = post-operating-day settlement; \'resettlement\' = corrected settlement after dispute resolution.' ;
    rdfs:domain ind:EnergyBalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:spinningReserveMw rdf:type rdf:Property ;
    rdfs:label 'Spinning Reserve Mw' ;
    rdfs:comment 'Spinning (synchronized) reserve available in the balancing area during the interval, expressed in MW. Subset of operating_reserve_mw representing generation online and capable of immediate response. NERC BAL-002 compliance metric.' ;
    rdfs:domain ind:EnergyBalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalGenerationMwh rdf:type rdf:Property ;
    rdfs:label 'Total Generation Mwh' ;
    rdfs:comment 'Total electrical energy generated within the balancing area during the interval, expressed in Megawatt-Hours (MWh). Aggregates all generation resources including fossil fuel, nuclear, and renewable sources. Sourced from SCADA/PI Historian telemetry.' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalLoadMwh rdf:type rdf:Property ;
    rdfs:label 'Total Load Mwh' ;
    rdfs:comment 'Total electrical energy consumed by load within the balancing area during the interval, expressed in Megawatt-Hours (MWh). Represents native load plus losses. Sourced from SCADA/PI Historian telemetry.' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transmissionLossesMwh rdf:type rdf:Property ;
    rdfs:label 'Transmission Losses Mwh' ;
    rdfs:comment 'Estimated electrical energy lost in transmission and distribution within the balancing area during the interval, expressed in MWh. Used in energy accounting identity: Generation = Load + Net Interchange + Losses.' ;
    rdfs:domain ind:EnergyBalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:frequencyRegulationEventId rdf:type rdf:Property ;
    rdfs:label 'Frequency Regulation Event Id' ;
    rdfs:comment 'Unique surrogate identifier for each frequency regulation event record in the balancing area. Primary key for this data product.' ;
    rdfs:domain ind:FrequencyRegulationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:aceThresholdMw rdf:type rdf:Property ;
    rdfs:label 'Ace Threshold Mw' ;
    rdfs:comment 'The ACE threshold in Megawatts (MW) that, when exceeded, triggers a compliance event or corrective action. Derived from the Balancing Authority\'s frequency bias setting and NERC BAL-001 control performance standards.' ;
    rdfs:domain ind:FrequencyRegulationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:aceValueMw rdf:type rdf:Property ;
    rdfs:label 'Ace Value Mw' ;
    rdfs:comment 'Instantaneous Area Control Error (ACE) value in Megawatts (MW) at the time of the event. ACE represents the difference between actual and scheduled net interchange, adjusted for frequency bias. This is the authoritative ACE measurement for NERC BAL-001 real power balancing compliance.' ;
    rdfs:domain ind:FrequencyRegulationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualInterchangeMw rdf:type rdf:Property ;
    rdfs:label 'Actual Interchange Mw' ;
    rdfs:comment 'The actual measured net interchange in Megawatts (MW) with neighboring balancing areas at the time of the event, as recorded by SCADA/EMS metering. The difference between actual and scheduled interchange is a primary component of the ACE calculation.' ;
    rdfs:domain ind:FrequencyRegulationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:agcResponseMw rdf:type rdf:Property ;
    rdfs:label 'Agc Response Mw' ;
    rdfs:comment 'Total Megawatts (MW) of generation adjustment dispatched by the Automatic Generation Control (AGC) system in response to this frequency regulation event. Represents the corrective generation signal sent to participating generating units.' ;
    rdfs:domain ind:FrequencyRegulationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:baalExceedanceFlag rdf:type rdf:Property ;
    rdfs:label 'Baal Exceedance Flag' ;
    rdfs:comment 'Indicates whether the Balancing Authority ACE Limit (BAAL) was exceeded during this event. True if ACE exceeded the BAAL threshold as defined in NERC BAL-001-2, triggering mandatory corrective action and potential compliance reporting.' ;
    rdfs:domain ind:FrequencyRegulationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:baalHighMw rdf:type rdf:Property ;
    rdfs:label 'Baal High Mw' ;
    rdfs:comment 'The upper Balancing Authority ACE Limit (BAAL) threshold in Megawatts (MW) applicable during this event interval. Defined per NERC BAL-001-2 and used to assess whether the balancing authority exceeded its allowable ACE boundary.' ;
    rdfs:domain ind:FrequencyRegulationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:baalLowMw rdf:type rdf:Property ;
    rdfs:label 'Baal Low Mw' ;
    rdfs:comment 'The lower Balancing Authority ACE Limit (BAAL) threshold in Megawatts (MW) applicable during this event interval. Defined per NERC BAL-001-2 and used to assess whether the balancing authority exceeded its allowable ACE boundary on the under-generation side.' ;
    rdfs:domain ind:FrequencyRegulationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:controlAreaCode rdf:type rdf:Property ;
    rdfs:label 'Control Area Code' ;
    rdfs:comment 'NERC-assigned alphanumeric code identifying the Balancing Authority control area where the event occurred. Used in NERC compliance filings, RTO/ISO interchange scheduling, and energy balance reporting.' ;
    rdfs:domain ind:FrequencyRegulationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctiveActionTaken rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Taken' ;
    rdfs:comment 'Narrative description of the corrective actions taken by the EMS/AGC system or grid operators to restore frequency and ACE to within compliance limits. Includes AGC dispatch instructions, manual operator interventions, and emergency procedures. Required for NERC BAL-002 disturbance control documentation.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cps2Score rdf:type rdf:Property ;
    rdfs:label 'Cps2 Score' ;
    rdfs:comment 'NERC Control Performance Standard 2 (CPS2) compliance score as a percentage for the reporting interval. CPS2 measures the 10-minute average ACE against the L10 limit, with a minimum compliance threshold of 90%. Values below 90% indicate non-compliance with NERC BAL-001.' ;
    rdfs:domain ind:FrequencyRegulationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disturbanceCause rdf:type rdf:Property ;
    rdfs:label 'Disturbance Cause' ;
    rdfs:comment 'Root cause classification of the frequency regulation event or disturbance. Used for post-event analysis, NERC BAL-002 disturbance control standard reporting, and operational reliability improvement. [ENUM-REF-CANDIDATE: generation_trip|load_loss|transmission_fault|interchange_error|equipment_failure|weather_event|unknown — promote to reference product]' ;
    rdfs:domain ind:FrequencyRegulationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emsEventCode rdf:type rdf:Property ;
    rdfs:label 'Ems Event Code' ;
    rdfs:comment 'The native event identifier assigned by the Energy Management System (EMS) — specifically GE PowerOn — for this frequency regulation event. Used for cross-referencing between the lakehouse Silver layer and the operational EMS source system for audit and reconciliation purposes.' ;
    rdfs:domain ind:FrequencyRegulationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventCode rdf:type rdf:Property ;
    rdfs:label 'Event Code' ;
    rdfs:comment 'Externally-known alphanumeric identifier assigned to this frequency regulation event, used in NERC compliance filings, RTO/ISO settlement reports, and operational logs. Format: FRE-{YYYY}-{NNNNNN}.' ;
    rdfs:domain ind:FrequencyRegulationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventSeverity rdf:type rdf:Property ;
    rdfs:label 'Event Severity' ;
    rdfs:comment 'Operational severity classification of the frequency regulation event based on the magnitude of frequency deviation, ACE exceedance, and system impact. Used for prioritizing operator response, escalation workflows, and post-event reliability analysis.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventStatus rdf:type rdf:Property ;
    rdfs:label 'Event Status' ;
    rdfs:comment 'Current lifecycle state of the frequency regulation event record. \'active\' indicates the event is ongoing; \'resolved\' indicates corrective action has restored normal frequency; \'under_review\' indicates post-event analysis is in progress; \'reported\' indicates the event has been submitted to NERC/RTO; \'closed\' indicates all follow-up actions are complete.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:frequencyBiasSettingMwPerHz rdf:type rdf:Property ;
    rdfs:label 'Frequency Bias Setting Mw Per Hz' ;
    rdfs:comment 'The balancing authority\'s frequency bias setting in Megawatts per Hertz (MW/Hz) in effect during this event. Used in the ACE calculation formula: ACE = (NIA - NIS) - 10B(FA - FS). Must be reported to NERC and the RTO/ISO per BAL-001 and BAL-005 requirements.' ;
    rdfs:domain ind:FrequencyRegulationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:frequencyNadirHz rdf:type rdf:Property ;
    rdfs:label 'Frequency Nadir Hz' ;
    rdfs:comment 'The lowest instantaneous system frequency in Hertz (Hz) recorded during this event, representing the frequency nadir following a generation loss or load increase disturbance. Critical metric for NERC BAL-003 frequency response adequacy assessment.' ;
    rdfs:domain ind:FrequencyRegulationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:frequencyResponseMwPerHz rdf:type rdf:Property ;
    rdfs:label 'Frequency Response Mw Per Hz' ;
    rdfs:comment 'The balancing authority\'s measured frequency response in Megawatts per Hertz (MW/Hz) during this event. Compared against the NERC-assigned Frequency Response Obligation (FRO) to assess BAL-003 compliance. A more negative value indicates stronger frequency response.' ;
    rdfs:domain ind:FrequencyRegulationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interconnectionName rdf:type rdf:Property ;
    rdfs:label 'Interconnection Name' ;
    rdfs:comment 'Name of the North American electrical interconnection (synchronous grid) within which this frequency regulation event occurred. Determines the nominal frequency standard (60 Hz) and the pool of balancing authorities sharing frequency response obligations.' ;
    rdfs:domain ind:FrequencyRegulationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nercViolationFlag rdf:type rdf:Property ;
    rdfs:label 'Nerc Violation Flag' ;
    rdfs:comment 'Indicates whether this event resulted in a confirmed violation of a NERC reliability standard (e.g., BAL-001 CPS1/CPS2 non-compliance, BAL-002 disturbance control failure, BAL-003 frequency response obligation shortfall). True triggers mandatory NERC self-report or enforcement action.' ;
    rdfs:domain ind:FrequencyRegulationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:piTagReference rdf:type rdf:Property ;
    rdfs:label 'Pi Tag Reference' ;
    rdfs:comment 'The OSIsoft PI Historian tag name or tag path associated with the primary frequency or ACE measurement for this event. Enables direct traceability from the Silver layer record back to the real-time operational data stream in the PI Historian for validation and reprocessing.' ;
    rdfs:domain ind:FrequencyRegulationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulationDownMw rdf:type rdf:Property ;
    rdfs:label 'Regulation Down Mw' ;
    rdfs:comment 'Megawatts (MW) of regulation-down reserve deployed during this event to decrease generation output and correct an over-frequency or positive ACE condition. Reported separately for RTO/ISO market settlement and NERC BAL-002 compliance.' ;
    rdfs:domain ind:FrequencyRegulationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulationReserveDeployedMw rdf:type rdf:Property ;
    rdfs:label 'Regulation Reserve Deployed Mw' ;
    rdfs:comment 'Total regulation reserve capacity deployed in Megawatts (MW) during this event. Includes both regulation-up and regulation-down resources activated to restore ACE to within compliance limits. Used for RTO/ISO settlement and reserve adequacy reporting.' ;
    rdfs:domain ind:FrequencyRegulationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulationUpMw rdf:type rdf:Property ;
    rdfs:label 'Regulation Up Mw' ;
    rdfs:comment 'Megawatts (MW) of regulation-up reserve deployed during this event to increase generation output and correct an under-frequency or negative ACE condition. Reported separately for RTO/ISO market settlement and NERC BAL-002 compliance.' ;
    rdfs:domain ind:FrequencyRegulationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reportingIntervalType rdf:type rdf:Property ;
    rdfs:label 'Reporting Interval Type' ;
    rdfs:comment 'The sub-hourly or hourly interval granularity for energy accounting data associated with this event record. Determines the resolution of generation, load, interchange, and ACE values stored. Aligns with RTO/ISO settlement interval requirements and NERC BAL-001 compliance measurement periods.' ;
    rdfs:domain ind:FrequencyRegulationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduledInterchangeMw rdf:type rdf:Property ;
    rdfs:label 'Scheduled Interchange Mw' ;
    rdfs:comment 'The net scheduled interchange in Megawatts (MW) with neighboring balancing areas at the time of the event, as agreed through the interchange scheduling process. Used in the ACE calculation and compared against actual interchange to determine the interchange component of ACE.' ;
    rdfs:domain ind:FrequencyRegulationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:settlementIntervalCode rdf:type rdf:Property ;
    rdfs:label 'Settlement Interval Code' ;
    rdfs:comment 'Reference to the RTO/ISO market settlement interval record associated with this energy balance event. Links frequency regulation and energy accounting data to the corresponding Day-Ahead Market (DAM) or Real-Time Market (RTM) settlement period.' ;
    rdfs:domain ind:FrequencyRegulationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:systemFrequencyHz rdf:type rdf:Property ;
    rdfs:label 'System Frequency Hz' ;
    rdfs:comment 'Measured system frequency in Hertz (Hz) at the time of the event trigger. Nominal value is 60.000 Hz for North American interconnections. Deviations from 60 Hz trigger frequency regulation responses per NERC BAL-003 frequency response obligations.' ;
    rdfs:domain ind:FrequencyRegulationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:systemLossesMwh rdf:type rdf:Property ;
    rdfs:label 'System Losses Mwh' ;
    rdfs:comment 'Estimated transmission and distribution system losses in Megawatt-Hours (MWh) during the event interval. Used in energy balance reconciliation: Generation = Load + Net Interchange + Losses. Supports NERC BAL-001 energy accounting and EIA reporting.' ;
    rdfs:domain ind:FrequencyRegulationEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gridContingencyId rdf:type rdf:Property ;
    rdfs:label 'Grid Contingency Id' ;
    rdfs:comment 'Unique identifier for the grid contingency scenario record. Primary key for the grid contingency data product.' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GridContingency .

ind:balancingAreaCode rdf:type rdf:Property ;
    rdfs:label 'Balancing Area Code' ;
    rdfs:comment 'Code identifying the balancing area or balancing authority area where this contingency is defined and monitored, used for jurisdictional and operational coordination.' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cascadingOutageRisk rdf:type rdf:Property ;
    rdfs:label 'Cascading Outage Risk' ;
    rdfs:comment 'Assessment of the risk that this contingency could trigger cascading outages affecting a wider area of the Bulk Electric System (BES), based on system topology, protection schemes, and historical events.' ;
    rdfs:domain ind:GridContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contingencyCategory rdf:type rdf:Property ;
    rdfs:label 'Contingency Category' ;
    rdfs:comment 'NERC TPL planning category classification: P0 (no contingency/base case), P1 (single element), P2 (single element with stuck breaker), P3 (loss of generator), P4 (multiple elements), P5 (delayed fault clearing), P6 (system instability), P7 (common structure). [ENUM-REF-CANDIDATE: P0|P1|P2|P3|P4|P5|P6|P7 — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:GridContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contingencyCode rdf:type rdf:Property ;
    rdfs:label 'Contingency Code' ;
    rdfs:comment 'Unique business identifier or code used to reference this contingency in operational systems, study reports, and inter-system communication.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contingencyType rdf:type rdf:Property ;
    rdfs:label 'Contingency Type' ;
    rdfs:comment 'Classification of the contingency scenario based on the number and type of elements removed. N-1 represents single element outage, N-2 represents simultaneous loss of two elements, N-1-1 represents sequential loss of two elements. [ENUM-REF-CANDIDATE: N-1|N-2|N-1-1|generator_trip|line_trip|transformer_trip|bus_fault|multiple_element — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctiveActionRequired rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Required' ;
    rdfs:comment 'Boolean flag indicating whether corrective actions (generation redispatch, transmission switching, load shedding) are required to maintain system reliability if this contingency occurs.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctiveActionTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Time Minutes' ;
    rdfs:comment 'Maximum time in minutes allowed to implement corrective actions after this contingency occurs, based on thermal time constants, voltage decay rates, and operational procedures.' ;
    rdfs:domain ind:GridContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:correctiveActionType rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Type' ;
    rdfs:comment 'Type of corrective action recommended or required to mitigate violations resulting from this contingency. May include multiple actions separated by semicolons (e.g., \'generation redispatch; transmission switching\').' ;
    rdfs:domain ind:GridContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:elementsRemovedCount rdf:type rdf:Property ;
    rdfs:label 'Elements Removed Count' ;
    rdfs:comment 'Count of transmission or generation elements (lines, transformers, generators, buses) that are removed or tripped in this contingency scenario definition.' ;
    rdfs:domain ind:GridContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:gridContingencyStatus rdf:type rdf:Property ;
    rdfs:label 'Grid Contingency Status' ;
    rdfs:comment 'Current lifecycle status of the contingency scenario in the real-time security assessment engine. Active contingencies are monitored continuously; inactive contingencies are excluded from real-time analysis.' ;
    rdfs:domain ind:GridContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastAssessmentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Assessment Timestamp' ;
    rdfs:comment 'Timestamp of the most recent real-time or study-mode security assessment execution that evaluated this contingency scenario.' ;
    rdfs:domain ind:GridContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lastViolationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Violation Timestamp' ;
    rdfs:comment 'Timestamp when this contingency most recently resulted in a thermal, voltage, or stability violation during security assessment. Null if no violations have been detected.' ;
    rdfs:domain ind:GridContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:monitoringElementsCount rdf:type rdf:Property ;
    rdfs:label 'Monitoring Elements Count' ;
    rdfs:comment 'Count of transmission elements (lines, transformers, interfaces) that are monitored for thermal overload, voltage violation, or stability issues when this contingency is applied in security assessment.' ;
    rdfs:domain ind:GridContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryElementName rdf:type rdf:Property ;
    rdfs:label 'Primary Element Name' ;
    rdfs:comment 'Name or identifier of the primary transmission or generation element that is removed in this contingency scenario, as defined in the EMS network model.' ;
    rdfs:domain ind:GridContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryElementType rdf:type rdf:Property ;
    rdfs:label 'Primary Element Type' ;
    rdfs:comment 'Type classification of the primary element that is removed or fails in this contingency scenario.' ;
    rdfs:domain ind:GridContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryElementVoltageKv rdf:type rdf:Property ;
    rdfs:label 'Primary Element Voltage Kv' ;
    rdfs:comment 'Nominal voltage level in kilovolts of the primary element involved in the contingency scenario.' ;
    rdfs:domain ind:GridContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:probabilityClass rdf:type rdf:Property ;
    rdfs:label 'Probability Class' ;
    rdfs:comment 'Qualitative assessment of the likelihood of this contingency occurring based on historical outage data, equipment reliability, and operational experience.' ;
    rdfs:domain ind:GridContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:probabilityValue rdf:type rdf:Property ;
    rdfs:label 'Probability Value' ;
    rdfs:comment 'Quantitative probability estimate (0.0 to 1.0) representing the annual likelihood of this contingency scenario occurring, derived from historical reliability data and risk assessment models.' ;
    rdfs:domain ind:GridContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:realTimeAssessmentEnabled rdf:type rdf:Property ;
    rdfs:label 'Real Time Assessment Enabled' ;
    rdfs:comment 'Boolean flag indicating whether this contingency is included in the real-time security assessment (RTSA) engine that runs continuously in the EMS to monitor system security.' ;
    rdfs:domain ind:GridContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:secondaryElementName rdf:type rdf:Property ;
    rdfs:label 'Secondary Element Name' ;
    rdfs:comment 'Name or identifier of the secondary element removed in N-2 or N-1-1 contingency scenarios. Null for single-element contingencies.' ;
    rdfs:domain ind:GridContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:secondaryElementType rdf:type rdf:Property ;
    rdfs:label 'Secondary Element Type' ;
    rdfs:comment 'Type classification of the secondary element removed in N-2 or N-1-1 contingency scenarios. Set to \'none\' for single-element (N-1) contingencies. [ENUM-REF-CANDIDATE: transmission_line|transformer|generator|bus|shunt_device|hvdc_link|none — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:GridContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:severityRating rdf:type rdf:Property ;
    rdfs:label 'Severity Rating' ;
    rdfs:comment 'Assessment of the potential impact severity if this contingency were to occur, considering load at risk, voltage collapse potential, cascading outage risk, and system stability margin degradation.' ;
    rdfs:domain ind:GridContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stabilityMarginPercent rdf:type rdf:Property ;
    rdfs:label 'Stability Margin Percent' ;
    rdfs:comment 'Percentage margin between the current operating point and the stability limit (voltage collapse point or transient stability limit) under this contingency scenario. Higher values indicate greater system security.' ;
    rdfs:domain ind:GridContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:studyModeEnabled rdf:type rdf:Property ;
    rdfs:label 'Study Mode Enabled' ;
    rdfs:comment 'Boolean flag indicating whether this contingency is included in offline study-mode security assessments used for day-ahead planning, seasonal studies, and long-term transmission planning.' ;
    rdfs:domain ind:GridContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:thermalLimitMva rdf:type rdf:Property ;
    rdfs:label 'Thermal Limit Mva' ;
    rdfs:comment 'Maximum thermal capacity in MVA for the most critical monitored element under this contingency scenario, representing the binding constraint for system operations.' ;
    rdfs:domain ind:GridContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:voltageLimitLowerPu rdf:type rdf:Property ;
    rdfs:label 'Voltage Limit Lower Pu' ;
    rdfs:comment 'Minimum acceptable voltage in per-unit (pu) for monitored buses under this contingency scenario, typically 0.90 to 0.95 pu for transmission systems per NERC standards.' ;
    rdfs:domain ind:GridContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:voltageLimitUpperPu rdf:type rdf:Property ;
    rdfs:label 'Voltage Limit Upper Pu' ;
    rdfs:comment 'Maximum acceptable voltage in per-unit (pu) for monitored buses under this contingency scenario, typically 1.05 to 1.10 pu for transmission systems per NERC standards.' ;
    rdfs:domain ind:GridContingency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:affectedFeederCode rdf:type rdf:Property ;
    rdfs:label 'Affected Feeder Code' ;
    rdfs:comment 'Code identifying the distribution feeder (primary circuit) affected by the outage. Critical for outage location, crew dispatch, and reliability metric calculation by feeder.' ;
    rdfs:domain ind:GridopsOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:affectedSubstationCode rdf:type rdf:Property ;
    rdfs:label 'Affected Substation Code' ;
    rdfs:comment 'Code identifying the substation serving the affected network segment. Used for outage aggregation, crew routing, and asset management coordination.' ;
    rdfs:domain ind:GridopsOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confirmedCustomersAffected rdf:type rdf:Property ;
    rdfs:label 'Confirmed Customers Affected' ;
    rdfs:comment 'Final confirmed count of customer accounts that experienced a service interruption during this outage event. Used for official SAIDI, SAIFI, CAIDI, and MAIFI calculations and regulatory reporting.' ;
    rdfs:domain ind:GridopsOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:crewDispatchTimestamp rdf:type rdf:Property ;
    rdfs:label 'Crew Dispatch Timestamp' ;
    rdfs:comment 'Date and time when field crews were dispatched to investigate and restore the outage. Used to calculate response time metrics and crew utilization.' ;
    rdfs:domain ind:GridopsOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:criticalInfrastructureAffectedFlag rdf:type rdf:Property ;
    rdfs:label 'Critical Infrastructure Affected Flag' ;
    rdfs:comment 'Boolean indicator whether the outage affected critical infrastructure customers (hospitals, emergency services, water treatment, communications). Triggers priority restoration and regulatory notification.' ;
    rdfs:domain ind:GridopsOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:customerMinutesInterrupted rdf:type rdf:Property ;
    rdfs:label 'Customer Minutes Interrupted' ;
    rdfs:comment 'Total customer-minutes of interruption, calculated as the sum of (customers affected × duration) for each restoration milestone. Primary input for SAIDI calculation. Also known as CMI.' ;
    rdfs:domain ind:GridopsOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:equipmentFailedType rdf:type rdf:Property ;
    rdfs:label 'Equipment Failed Type' ;
    rdfs:comment 'Type of equipment that failed and caused the outage (e.g., transformer, recloser, fuse, conductor, insulator, switch). Links to asset management for failure analysis and replacement planning.' ;
    rdfs:domain ind:GridopsOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedRestorationTime rdf:type rdf:Property ;
    rdfs:label 'Estimated Restoration Time' ;
    rdfs:comment 'The estimated date and time when service is expected to be fully restored. Communicated to customers and updated as restoration progresses. Also known as ETR.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:faultIsolationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Fault Isolation Timestamp' ;
    rdfs:comment 'Date and time when the fault was successfully isolated from the rest of the network through switching operations. Enables partial restoration to unaffected customers.' ;
    rdfs:domain ind:GridopsOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:firstRestorationTimestamp rdf:type rdf:Property ;
    rdfs:label 'First Restoration Timestamp' ;
    rdfs:comment 'Date and time when service was first restored to any subset of affected customers, typically through switching operations or temporary measures.' ;
    rdfs:domain ind:GridopsOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:omsExternalReference rdf:type rdf:Property ;
    rdfs:label 'Oms External Reference' ;
    rdfs:comment 'External identifier from the source OMS system (GE PowerOn). Used for cross-system reconciliation and data lineage tracking. Also known as OMS external ID.' ;
    rdfs:domain ind:GridopsOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:omsSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Oms Source System' ;
    rdfs:comment 'Name of the source OMS system that created this outage record (e.g., GE PowerOn, Oracle OMS). Used for data lineage and multi-system integration scenarios. Also known as OMS source system.' ;
    rdfs:domain ind:GridopsOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outageLocationAddress rdf:type rdf:Property ;
    rdfs:label 'Outage Location Address' ;
    rdfs:comment 'Street address or nearest intersection to the outage location. Used for crew dispatch, customer communication, and regulatory reporting. Organizational contact data classified as confidential.' ;
    rdfs:domain ind:GridopsOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outageLocationLatitude rdf:type rdf:Property ;
    rdfs:label 'Outage Location Latitude' ;
    rdfs:comment 'Geographic latitude coordinate of the outage location in decimal degrees. Used for crew routing, GIS mapping, and spatial analysis of outage patterns.' ;
    rdfs:domain ind:GridopsOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outageLocationLongitude rdf:type rdf:Property ;
    rdfs:label 'Outage Location Longitude' ;
    rdfs:comment 'Geographic longitude coordinate of the outage location in decimal degrees. Used for crew routing, GIS mapping, and spatial analysis of outage patterns.' ;
    rdfs:domain ind:GridopsOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outageNumber rdf:type rdf:Property ;
    rdfs:label 'Outage Number' ;
    rdfs:comment 'Business identifier for the outage event, typically generated by the OMS (GE PowerOn). Used for external communication, crew dispatch, and regulatory reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:peakCustomersOut rdf:type rdf:Property ;
    rdfs:label 'Peak Customers Out' ;
    rdfs:comment 'Maximum number of customers simultaneously without service at any point during the outage event. Used for storm impact assessment and resource planning.' ;
    rdfs:domain ind:GridopsOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:regulatoryNotificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Notification Required Flag' ;
    rdfs:comment 'Boolean indicator whether this outage event requires notification to regulatory authorities (state PUC, FERC, DOE) based on customer count, duration, or critical infrastructure impact thresholds.' ;
    rdfs:domain ind:GridopsOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryNotificationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Regulatory Notification Timestamp' ;
    rdfs:comment 'Date and time when regulatory notification was submitted to the appropriate authority (state PUC, FERC, DOE). Required for compliance audit trail.' ;
    rdfs:domain ind:GridopsOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:restorationMethod rdf:type rdf:Property ;
    rdfs:label 'Restoration Method' ;
    rdfs:comment 'Primary method used to restore service (e.g., switching, repair, replacement, temporary bypass, mobile substation). Used for restoration strategy analysis and resource planning.' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stormName rdf:type rdf:Property ;
    rdfs:label 'Storm Name' ;
    rdfs:comment 'Name or identifier of the storm event if this outage was part of a named storm (e.g., Hurricane Ida, Winter Storm Uri). Used for storm impact analysis and FEMA reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvingSupervisorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Approving Supervisor Employee Id' ;
    rdfs:comment 'Reference to the grid operations supervisor or reliability coordinator who reviewed and approved this switching order for execution.' ;
    rdfs:domain ind:GridopsSwitchingOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:executingCrewId rdf:type rdf:Property ;
    rdfs:label 'Executing Crew Id' ;
    rdfs:comment 'Reference to the field crew or operations team assigned to physically execute the switching steps in this order.' ;
    rdfs:domain ind:GridopsSwitchingOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Crew .

ind:omsOutageGridopsOutageEventId rdf:type rdf:Property ;
    rdfs:label 'Oms Outage Gridops Outage Event Id' ;
    rdfs:comment 'Reference to the associated planned outage record in the Outage Management System (OMS) if this switching order is coordinated with customer outage notifications.' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GridopsOutageEvent .

ind:primaryGridopsIncidentId rdf:type rdf:Property ;
    rdfs:label 'Primary Gridops Incident Id' ;
    rdfs:comment 'Reference to the grid operations incident or reliability event that triggered this switching order, if applicable (e.g., fault, equipment failure, system disturbance).' ;
    rdfs:domain ind:GridopsSwitchingOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Incident .

ind:actualCompletionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Actual Completion Timestamp' ;
    rdfs:comment 'The actual date and time when the final switching step in this order was completed and the order was closed.' ;
    rdfs:domain ind:GridopsSwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:affectedCircuitCount rdf:type rdf:Property ;
    rdfs:label 'Affected Circuit Count' ;
    rdfs:comment 'The number of electrical circuits (feeders, transmission lines, or distribution circuits) that will be impacted by the execution of this switching order.' ;
    rdfs:domain ind:GridopsSwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:approvingSupervisorName rdf:type rdf:Property ;
    rdfs:label 'Approving Supervisor Name' ;
    rdfs:comment 'Full name of the operations supervisor or reliability coordinator who approved this switching order.' ;
    rdfs:domain ind:GridopsSwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cancellationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Cancellation Timestamp' ;
    rdfs:comment 'The date and time when this switching order was cancelled or voided, if applicable.' ;
    rdfs:domain ind:GridopsSwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:emergencyRestorationFlag rdf:type rdf:Property ;
    rdfs:label 'Emergency Restoration Flag' ;
    rdfs:comment 'Boolean indicator whether this switching order is part of an emergency restoration effort following an unplanned outage or system disturbance. True indicates emergency restoration.' ;
    rdfs:domain ind:GridopsSwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:estimatedCustomerImpactCount rdf:type rdf:Property ;
    rdfs:label 'Estimated Customer Impact Count' ;
    rdfs:comment 'The estimated number of customer accounts that may experience service interruption or voltage fluctuation during the execution of this switching order.' ;
    rdfs:domain ind:GridopsSwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:issuingOperatorName rdf:type rdf:Property ;
    rdfs:label 'Issuing Operator Name' ;
    rdfs:comment 'Full name of the certified system operator who created and issued this switching order.' ;
    rdfs:domain ind:GridopsSwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lotoTagNumbers rdf:type rdf:Property ;
    rdfs:label 'Loto Tag Numbers' ;
    rdfs:comment 'Comma-separated list of Lock Out Tag Out (LOTO) tag numbers applied to equipment as part of this switching order to ensure worker safety during de-energized work.' ;
    rdfs:domain ind:GridopsSwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:networkSegment rdf:type rdf:Property ;
    rdfs:label 'Network Segment' ;
    rdfs:comment 'The segment of the electrical network where the switching order will be executed: transmission (high-voltage bulk power), distribution (medium/low-voltage customer delivery), substation (transformation and switching facilities), or generation (power plant interconnection).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderPurpose rdf:type rdf:Property ;
    rdfs:label 'Order Purpose' ;
    rdfs:comment 'Detailed business justification and operational purpose for issuing this switching order, including work scope, equipment involved, and expected outcomes.' ;
    rdfs:domain ind:GridopsSwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outageCoordinationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Outage Coordination Required Flag' ;
    rdfs:comment 'Boolean indicator whether this switching order requires coordination with the Outage Management System (OMS) for planned customer outage notifications. True indicates OMS coordination is required.' ;
    rdfs:domain ind:GridopsSwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reliabilityImpactAssessment rdf:type rdf:Property ;
    rdfs:label 'Reliability Impact Assessment' ;
    rdfs:comment 'Documented assessment of the potential impact of this switching order on system reliability, including contingency analysis, N-1 criteria evaluation, and risk mitigation measures.' ;
    rdfs:domain ind:GridopsSwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:safetyClearanceRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Safety Clearance Required Flag' ;
    rdfs:comment 'Boolean indicator whether this switching order requires formal safety clearance and Lock Out Tag Out (LOTO) procedures before execution. True indicates safety clearance is mandatory.' ;
    rdfs:domain ind:GridopsSwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scadaMonitoringEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Scada Monitoring Enabled Flag' ;
    rdfs:comment 'Boolean indicator whether real-time SCADA monitoring and telemetry is enabled for the equipment and circuits affected by this switching order. True indicates SCADA monitoring is active.' ;
    rdfs:domain ind:GridopsSwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scheduledCompletionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Scheduled Completion Timestamp' ;
    rdfs:comment 'The planned date and time when execution of this switching order is expected to be completed, including all steps and restoration.' ;
    rdfs:domain ind:GridopsSwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:scheduledStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Scheduled Start Timestamp' ;
    rdfs:comment 'The planned date and time when execution of this switching order is scheduled to begin.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sequenceValidationStatus rdf:type rdf:Property ;
    rdfs:label 'Sequence Validation Status' ;
    rdfs:comment 'Status of automated or manual validation of the switching step sequence for electrical safety, operational feasibility, and compliance with switching procedures: not validated, validated (passed all checks), validation failed (errors detected), or override approved (validation bypassed by authority).' ;
    rdfs:domain ind:GridopsSwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:switchingProcedureReference rdf:type rdf:Property ;
    rdfs:label 'Switching Procedure Reference' ;
    rdfs:comment 'Reference to the standard operating procedure (SOP) or switching instruction document that governs the execution of this switching order, including document number and version.' ;
    rdfs:domain ind:GridopsSwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loadForecastId rdf:type rdf:Property ;
    rdfs:label 'Load Forecast Id' ;
    rdfs:comment 'Unique surrogate identifier for each load forecast record in the balancing area Energy Management System (EMS) forecasting engine. Primary key for the load_forecast data product.' ;
    rdfs:domain ind:LoadForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:weatherForecastId rdf:type rdf:Property ;
    rdfs:label 'Weather Forecast Id' ;
    rdfs:comment 'Foreign key linking to gridops.weather_forecast. Business justification: Load forecasts are derived from a specific weather forecast; FK links forecast source.' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WeatherForecast .

ind:actualDemandMw rdf:type rdf:Property ;
    rdfs:label 'Actual Demand Mw' ;
    rdfs:comment 'The observed actual electrical load demand in Megawatts (MW) for the forecast interval, populated post-interval from SCADA telemetry or OSIsoft PI Historian. Null until the interval has elapsed and actuals are available. Used for forecast accuracy tracking and model performance evaluation.' ;
    rdfs:domain ind:LoadForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:confidenceIntervalLowerMw rdf:type rdf:Property ;
    rdfs:label 'Confidence Interval Lower Mw' ;
    rdfs:comment 'The lower bound of the statistical confidence interval for the forecasted demand in Megawatts (MW). Represents the minimum plausible demand at the specified confidence level. Used for probabilistic unit commitment and reserve margin planning.' ;
    rdfs:domain ind:LoadForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:confidenceIntervalUpperMw rdf:type rdf:Property ;
    rdfs:label 'Confidence Interval Upper Mw' ;
    rdfs:comment 'The upper bound of the statistical confidence interval for the forecasted demand in Megawatts (MW). Represents the maximum plausible demand at the specified confidence level. Used for contingency planning and operating reserve determination.' ;
    rdfs:domain ind:LoadForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:confidenceLevelPct rdf:type rdf:Property ;
    rdfs:label 'Confidence Level Pct' ;
    rdfs:comment 'The statistical confidence level expressed as a percentage (e.g., 90.00, 95.00) associated with the confidence interval bounds. Indicates the probability that actual demand will fall within the stated confidence interval bounds.' ;
    rdfs:domain ind:LoadForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coolingDegreeDays rdf:type rdf:Property ;
    rdfs:label 'Cooling Degree Days' ;
    rdfs:comment 'The number of Cooling Degree Days (CDD) for the forecast date, calculated as the number of degrees the mean daily temperature exceeds 65°F. A standard weather normalization metric used in load forecasting models to quantify cooling-driven electrical demand.' ;
    rdfs:domain ind:LoadForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:derGenerationForecastMw rdf:type rdf:Property ;
    rdfs:label 'Der Generation Forecast Mw' ;
    rdfs:comment 'The forecasted generation output in Megawatts (MW) from Distributed Energy Resources (DER) including rooftop solar, behind-the-meter storage, and small-scale generation within the distribution system. Subtracted from gross load to derive net load. Sourced from DERMS forecasting.' ;
    rdfs:domain ind:LoadForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:drDispatchedMw rdf:type rdf:Property ;
    rdfs:label 'Dr Dispatched Mw' ;
    rdfs:comment 'The amount of Demand Response (DR) capacity in Megawatts (MW) that has been dispatched or is planned to be dispatched during this forecast interval. Represents load reduction committed through DR programs, reducing the net load the grid must serve. Used for DR dispatch planning and DERMS coordination.' ;
    rdfs:domain ind:LoadForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forecastDate rdf:type rdf:Property ;
    rdfs:label 'Forecast Date' ;
    rdfs:comment 'The calendar date for which the load forecast applies. For day-ahead forecasts this is the operating day being forecasted. Used for daily operations planning, Day-Ahead Market (DAM) scheduling, and next-day unit commitment.' ;
    rdfs:domain ind:LoadForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:forecastErrorMw rdf:type rdf:Property ;
    rdfs:label 'Forecast Error Mw' ;
    rdfs:comment 'The absolute difference between forecasted demand and actual demand in Megawatts (MW), calculated as actual_demand_mw minus forecasted_demand_mw. Positive values indicate under-forecasting; negative values indicate over-forecasting. Populated post-interval for accuracy tracking.' ;
    rdfs:domain ind:LoadForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forecastErrorPct rdf:type rdf:Property ;
    rdfs:label 'Forecast Error Pct' ;
    rdfs:comment 'The forecast error expressed as a percentage of actual demand, calculated as (actual_demand_mw - forecasted_demand_mw) / actual_demand_mw * 100. Used as the primary KPI for EMS forecasting model accuracy assessment and NERC compliance reporting.' ;
    rdfs:domain ind:LoadForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forecastHorizonType rdf:type rdf:Property ;
    rdfs:label 'Forecast Horizon Type' ;
    rdfs:comment 'Classification of the forecast by its planning horizon. Short-term covers hourly/daily intervals; medium-term covers weekly/monthly; persistence uses the last observed value as the forecast; day-ahead supports Day-Ahead Market (DAM) scheduling; real-time supports Real-Time Market (RTM) dispatch. [ENUM-REF-CANDIDATE: short_term|medium_term|long_term|persistence|day_ahead|real_time — promote to reference product]' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forecastHumidityPct rdf:type rdf:Property ;
    rdfs:label 'Forecast Humidity Pct' ;
    rdfs:comment 'The forecasted relative humidity percentage used as a secondary weather input to the load forecasting model. Humidity affects the heat index and cooling load, particularly for residential and commercial air conditioning demand.' ;
    rdfs:domain ind:LoadForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forecastIntervalEnd rdf:type rdf:Property ;
    rdfs:label 'Forecast Interval End' ;
    rdfs:comment 'The ending date and time of the interval for which the load demand is being forecasted. Together with forecast_interval_start, defines the precise time window of the forecast. Stored in ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX).' ;
    rdfs:domain ind:LoadForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:forecastIntervalStart rdf:type rdf:Property ;
    rdfs:label 'Forecast Interval Start' ;
    rdfs:comment 'The beginning date and time of the interval for which the load demand is being forecasted. For hourly forecasts this marks the top of the hour; for daily forecasts this marks midnight. Used for unit commitment scheduling, interchange scheduling, and DR dispatch planning. Stored in ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX).' ;
    rdfs:domain ind:LoadForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:forecastModelName rdf:type rdf:Property ;
    rdfs:label 'Forecast Model Name' ;
    rdfs:comment 'The name or identifier of the load forecasting algorithm or model used to produce this forecast (e.g., regression-based, neural network, ensemble). Supports model governance, audit trail, and comparison of forecast accuracy across different modeling approaches in the EMS.' ;
    rdfs:domain ind:LoadForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forecastModelVersion rdf:type rdf:Property ;
    rdfs:label 'Forecast Model Version' ;
    rdfs:comment 'The version string of the EMS load forecasting model used to produce this forecast (e.g., \'3.2.1\'). Enables traceability of forecast outputs to specific model releases, supporting model validation, regulatory audit, and accuracy benchmarking.' ;
    rdfs:domain ind:LoadForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forecastModelVersionCode rdf:type rdf:Property ;
    rdfs:label 'Forecast Model Version Code' ;
    rdfs:comment 'Reference to the specific version of the EMS load forecasting model used to produce this forecast. Enables accuracy tracking across model versions, supports model governance, and facilitates comparison of forecast performance between model iterations.' ;
    rdfs:domain ind:LoadForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:forecastNotes rdf:type rdf:Property ;
    rdfs:label 'Forecast Notes' ;
    rdfs:comment 'Free-text field for operational notes, qualitative adjustments, or override justifications applied to this forecast record by EMS operators. Captures manual interventions, special event adjustments (e.g., major sporting events, industrial shutdowns), or model override rationale for audit and review purposes.' ;
    rdfs:domain ind:LoadForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forecastRunNumber rdf:type rdf:Property ;
    rdfs:label 'Forecast Run Number' ;
    rdfs:comment 'Externally-known business identifier assigned by the EMS forecasting engine to uniquely identify a specific forecast run or batch. Used to group all interval records produced in a single forecast execution cycle. Aligns with OSIsoft PI Historian and GE PowerOn EMS run identifiers.' ;
    rdfs:domain ind:LoadForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forecastRunTimestamp rdf:type rdf:Property ;
    rdfs:label 'Forecast Run Timestamp' ;
    rdfs:comment 'The date and time at which the EMS forecasting engine initiated and completed the forecast run that produced this record. This is the principal business event timestamp representing when the forecast was generated, distinct from the interval being forecasted. Stored in ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX).' ;
    rdfs:domain ind:LoadForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:forecastTemperatureF rdf:type rdf:Property ;
    rdfs:label 'Forecast Temperature F' ;
    rdfs:comment 'The forecasted ambient temperature in degrees Fahrenheit used as the primary weather input to the load forecasting model for this interval. Temperature is the dominant weather driver of electrical load in most utility service territories.' ;
    rdfs:domain ind:LoadForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forecastedDemandMw rdf:type rdf:Property ;
    rdfs:label 'Forecasted Demand Mw' ;
    rdfs:comment 'The primary forecasted electrical load demand in Megawatts (MW) for the specified interval. This is the principal quantitative output of the EMS forecasting engine, used for unit commitment, interchange scheduling, and next-day operations planning.' ;
    rdfs:domain ind:LoadForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:heatingDegreeDays rdf:type rdf:Property ;
    rdfs:label 'Heating Degree Days' ;
    rdfs:comment 'The number of Heating Degree Days (HDD) for the forecast date, calculated as the number of degrees the mean daily temperature falls below 65°F. A standard weather normalization metric used in load forecasting models to quantify heating-driven electrical and gas demand.' ;
    rdfs:domain ind:LoadForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interchangeScheduleMw rdf:type rdf:Property ;
    rdfs:label 'Interchange Schedule Mw' ;
    rdfs:comment 'The scheduled net interchange in Megawatts (MW) with neighboring balancing areas or the Regional Transmission Organization (RTO)/Independent System Operator (ISO) for this forecast interval. Positive values indicate net imports; negative values indicate net exports. Used in balancing area control and unit commitment.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isPeakPeriod rdf:type rdf:Property ;
    rdfs:label 'Is Peak Period' ;
    rdfs:comment 'Boolean flag indicating whether this forecast interval falls within a designated peak demand period as defined by the utility\'s tariff or operational planning criteria. Used to identify intervals requiring heightened operational attention, DR dispatch readiness, and capacity reserve verification.' ;
    rdfs:domain ind:LoadForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isReliabilityEvent rdf:type rdf:Property ;
    rdfs:label 'Is Reliability Event' ;
    rdfs:comment 'Boolean flag indicating whether this forecast interval is associated with a declared reliability event (e.g., emergency operating condition, NERC alert, extreme weather advisory). When true, the forecast may have been produced under emergency protocols with modified model parameters.' ;
    rdfs:domain ind:LoadForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:manualOverrideFlag rdf:type rdf:Property ;
    rdfs:label 'Manual Override Flag' ;
    rdfs:comment 'Boolean flag indicating whether an EMS operator manually overrode the model-generated forecast value for this interval. When true, the forecasted_demand_mw reflects an operator-adjusted value rather than the raw model output. Supports audit trail and model accuracy analysis.' ;
    rdfs:domain ind:LoadForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:netLoadForecastMw rdf:type rdf:Property ;
    rdfs:label 'Net Load Forecast Mw' ;
    rdfs:comment 'The forecasted net load in Megawatts (MW) after subtracting Distributed Energy Resources (DER) generation (e.g., rooftop solar, behind-the-meter storage) from gross forecasted demand. Net load is the actual generation requirement that dispatchable resources must meet. Critical for unit commitment and interchange scheduling.' ;
    rdfs:domain ind:LoadForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:operatingDay rdf:type rdf:Property ;
    rdfs:label 'Operating Day' ;
    rdfs:comment 'The NERC-defined operating day (midnight to midnight local time) to which this forecast record belongs. Distinct from forecast_date in that it represents the grid operations scheduling day used by the Regional Transmission Organization (RTO) or Independent System Operator (ISO) for market and reliability purposes.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:peakDemandEstimateMw rdf:type rdf:Property ;
    rdfs:label 'Peak Demand Estimate Mw' ;
    rdfs:comment 'The estimated peak electrical demand in Megawatts (MW) expected within the forecast period. Critical for capacity planning, reserve margin calculations, and Demand Response (DR) dispatch planning. Used in General Rate Case (GRC) filings and Integrated Resource Plan (IRP) submissions.' ;
    rdfs:domain ind:LoadForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:weatherAdjustedBaselineMw rdf:type rdf:Property ;
    rdfs:label 'Weather Adjusted Baseline Mw' ;
    rdfs:comment 'The weather-normalized baseline load demand in Megawatts (MW), representing what demand would be under normal or reference weather conditions. Used to isolate weather-driven load variability from underlying demand trends for regulatory reporting and Integrated Resource Plan (IRP) analysis.' ;
    rdfs:domain ind:LoadForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:weatherStationCode rdf:type rdf:Property ;
    rdfs:label 'Weather Station Code' ;
    rdfs:comment 'Reference to the primary weather station or weather data source used to supply temperature, humidity, and other meteorological inputs to the load forecasting model for this forecast interval. Weather normalization is a core component of EMS load forecasting.' ;
    rdfs:domain ind:LoadForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:operatorLogId rdf:type rdf:Property ;
    rdfs:label 'Operator Log Id' ;
    rdfs:comment 'Unique surrogate identifier for each operator log entry in the grid operations control room. Primary key for the operator_log data product.' ;
    rdfs:domain ind:OperatorLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryOperatorPersonId rdf:type rdf:Property ;
    rdfs:label 'Primary Operator Person Id' ;
    rdfs:comment 'Reference to the licensed control room operator who authored this log entry. Links to the workforce/employee master record. Required for NERC CIP personnel accountability and shift responsibility tracking.' ;
    rdfs:domain ind:OperatorLog ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Person .

ind:safetyAuditId rdf:type rdf:Property ;
    rdfs:label 'Safety Audit Id' ;
    rdfs:comment 'Foreign key linking to safety.safety_audit. Business justification: Safety audits review operator logs to verify compliance with operating procedures and identify violations.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SafetyAudit .

ind:scadaAlarmAlarmEventId rdf:type rdf:Property ;
    rdfs:label 'Scada Alarm Alarm Event Id' ;
    rdfs:comment 'The alarm identifier from the SCADA or EMS system that triggered or is associated with this log entry. Populated for alarm_acknowledgment entry types. Enables traceability from the operator log back to the originating SCADA alarm in OSIsoft PI Historian or GE PowerOn.' ;
    rdfs:domain ind:OperatorLog ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AlarmEvent .

ind:shiftId rdf:type rdf:Property ;
    rdfs:label 'Shift Id' ;
    rdfs:comment 'Reference to the operational shift during which this log entry was created. Enables shift-level aggregation of events, handover documentation, and accountability reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Shift .

ind:shiftSupervisorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Shift Supervisor Employee Id' ;
    rdfs:comment 'Reference to the shift supervisor who reviewed or approved this log entry. Required for entries of critical or high priority. Supports supervisory accountability and NERC CIP-004 personnel management compliance.' ;
    rdfs:domain ind:OperatorLog ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:attachmentReference rdf:type rdf:Property ;
    rdfs:label 'Attachment Reference' ;
    rdfs:comment 'File path, document management system reference, or URL pointing to supporting documentation attached to this log entry (e.g., switching order PDF, alarm printout, event report). Null if no attachment.' ;
    rdfs:domain ind:OperatorLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:communicationMethod rdf:type rdf:Property ;
    rdfs:label 'Communication Method' ;
    rdfs:comment 'The method or channel used for the communication recorded in this log entry. Relevant for NERC COM-001 compliance which mandates reliable communication facilities for grid operators.' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:communicationParty rdf:type rdf:Property ;
    rdfs:label 'Communication Party' ;
    rdfs:comment 'The name or identifier of the external or internal party involved in a communication log entry (e.g., RTO/ISO operator name, neighboring utility, field crew ID, supervisor name). Populated for communication entry types.' ;
    rdfs:domain ind:OperatorLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drDispatchMw rdf:type rdf:Property ;
    rdfs:label 'Dr Dispatch Mw' ;
    rdfs:comment 'The quantity of Demand Response (DR) capacity dispatched or curtailed in Megawatts (MW) as recorded in this log entry. Populated for demand_response entry category entries.' ;
    rdfs:domain ind:OperatorLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:entryCategory rdf:type rdf:Property ;
    rdfs:label 'Entry Category' ;
    rdfs:comment 'Operational category classifying the functional area of the grid operation described in this log entry. Supports domain-specific filtering for post-event analysis and regulatory reporting. [ENUM-REF-CANDIDATE: generation|transmission|distribution|demand_response|frequency_regulation|voltage_control|outage|switching|environmental|safety|administrative — promote to reference product]' ;
    rdfs:domain ind:OperatorLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entryType rdf:type rdf:Property ;
    rdfs:label 'Entry Type' ;
    rdfs:comment 'Categorical discriminator classifying the nature of the log entry. \'action\' = operator-initiated grid action; \'alarm_acknowledgment\' = SCADA/EMS alarm acknowledged; \'communication\' = inter-operator or inter-entity communication; \'observation\' = operational observation or reading; \'switching_order\' = switching order execution step; \'note\' = general operational note.' ;
    rdfs:domain ind:OperatorLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventOccurredTimestamp rdf:type rdf:Property ;
    rdfs:label 'Event Occurred Timestamp' ;
    rdfs:comment 'The precise date and time (UTC) when the actual grid event, alarm, or operational action physically occurred, as distinct from when the operator recorded it. Critical for post-event timeline reconstruction and NERC reliability event analysis. May differ from entry_timestamp due to logging latency.' ;
    rdfs:domain ind:OperatorLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:generationMw rdf:type rdf:Property ;
    rdfs:label 'Generation Mw' ;
    rdfs:comment 'The measured or dispatched generation output in Megawatts (MW) referenced in this log entry. Relevant for generation dispatch, curtailment, and unit commitment actions.' ;
    rdfs:domain ind:OperatorLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:loadMw rdf:type rdf:Property ;
    rdfs:label 'Load Mw' ;
    rdfs:comment 'The measured or observed load in Megawatts (MW) at the time of the log entry. Relevant for load shedding, demand response dispatch, and load balancing actions. Null if not applicable to the entry type.' ;
    rdfs:domain ind:OperatorLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:logEntryNumber rdf:type rdf:Property ;
    rdfs:label 'Log Entry Number' ;
    rdfs:comment 'Externally-known, human-readable sequential identifier for the log entry (e.g., OL-2024-00123456). Used for cross-referencing in regulatory audits, NERC compliance filings, and post-event analysis reports.' ;
    rdfs:domain ind:OperatorLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:narrative rdf:type rdf:Property ;
    rdfs:label 'Narrative' ;
    rdfs:comment 'Free-text narrative entered by the operator describing the action taken, observation made, alarm acknowledged, or communication recorded. This is the primary payload of the log entry and serves as the official operational record for post-event analysis, regulatory audits, and NERC CIP compliance reviews.' ;
    rdfs:domain ind:OperatorLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nercReportable rdf:type rdf:Property ;
    rdfs:label 'Nerc Reportable' ;
    rdfs:comment 'Indicates whether this log entry is associated with a NERC-reportable reliability event per NERC EOP-004 disturbance reporting thresholds. True = event meets NERC reporting criteria and must be submitted to NERC/DOE via OE-417 or similar form.' ;
    rdfs:domain ind:OperatorLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nercStandardReference rdf:type rdf:Property ;
    rdfs:label 'Nerc Standard Reference' ;
    rdfs:comment 'The specific NERC Reliability Standard(s) applicable to the action or event described in this log entry (e.g., BAL-001, EOP-004, CIP-007). Supports compliance mapping and regulatory audit traceability.' ;
    rdfs:domain ind:OperatorLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outageTicketNumber rdf:type rdf:Property ;
    rdfs:label 'Outage Ticket Number' ;
    rdfs:comment 'The outage ticket or trouble order number from the OMS associated with this log entry. Populated when the log entry relates to an active outage event. Enables correlation between operator actions and outage management workflows.' ;
    rdfs:domain ind:OperatorLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pucReportable rdf:type rdf:Property ;
    rdfs:label 'Puc Reportable' ;
    rdfs:comment 'Indicates whether this log entry is associated with an event that must be reported to the state Public Utility Commission (PUC) or Public Service Commission (PSC) per state regulatory requirements. True = state regulatory reporting obligation exists.' ;
    rdfs:domain ind:OperatorLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reviewedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Reviewed Timestamp' ;
    rdfs:comment 'The date and time when the shift supervisor reviewed this log entry. Null if not yet reviewed. Part of the log entry lifecycle audit trail required for NERC compliance.' ;
    rdfs:domain ind:OperatorLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sourceLogReference rdf:type rdf:Property ;
    rdfs:label 'Source Log Reference' ;
    rdfs:comment 'The native log or record identifier from the originating source system (EMS, DMS, OMS, SCADA). Enables traceability back to the system of record for data lineage and reconciliation purposes in the Silver layer.' ;
    rdfs:domain ind:OperatorLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:switchingOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Switching Order Number' ;
    rdfs:comment 'The switching order number from the DMS/OMS system associated with this log entry. Populated for switching_order entry types. Links the operator log to the formal switching order workflow in GE PowerOn Advanced DMS/OMS.' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:voidReason rdf:type rdf:Property ;
    rdfs:label 'Void Reason' ;
    rdfs:comment 'Free-text explanation for why this log entry was voided or invalidated. Populated only when entry_status = \'voided\'. Maintains audit trail integrity by preserving the reason for invalidation rather than deleting the record.' ;
    rdfs:domain ind:OperatorLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outageRestorationLogId rdf:type rdf:Property ;
    rdfs:label 'Outage Restoration Log Id' ;
    rdfs:comment 'Unique identifier for each restoration activity log entry. Primary key for the outage restoration log.' ;
    rdfs:domain ind:OutageRestorationLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:automatedRestorationFlag rdf:type rdf:Property ;
    rdfs:label 'Automated Restoration Flag' ;
    rdfs:comment 'Indicates whether this restoration was performed automatically by distribution automation systems. True if automated, false if manual crew intervention was required.' ;
    rdfs:domain ind:OutageRestorationLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:crewType rdf:type rdf:Property ;
    rdfs:label 'Crew Type' ;
    rdfs:comment 'Classification of crew performing the restoration work. Distinguishes between internal utility crews, contractors, mutual aid crews, and emergency response teams.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerCallbackRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Customer Callback Required Flag' ;
    rdfs:comment 'Indicates whether customer callbacks are required after this restoration milestone. True if customers need to be contacted to verify service restoration.' ;
    rdfs:domain ind:OutageRestorationLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:customersRestoredCount rdf:type rdf:Property ;
    rdfs:label 'Customers Restored Count' ;
    rdfs:comment 'Number of customers whose service was restored at this milestone. Used for calculating cumulative restoration progress and regulatory reporting.' ;
    rdfs:domain ind:OutageRestorationLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:deviceLocation rdf:type rdf:Property ;
    rdfs:label 'Device Location' ;
    rdfs:comment 'Physical location or address of the device operated during restoration. Enables geographic analysis of restoration activities.' ;
    rdfs:domain ind:OutageRestorationLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deviceOperated rdf:type rdf:Property ;
    rdfs:label 'Device Operated' ;
    rdfs:comment 'Identifier or name of the electrical device operated during this restoration milestone (e.g., circuit breaker, recloser, switch). Supports asset performance analysis.' ;
    rdfs:domain ind:OutageRestorationLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dmsEventCode rdf:type rdf:Property ;
    rdfs:label 'Dms Event Code' ;
    rdfs:comment 'Reference identifier from the Distribution Management System for this restoration event. Links to DMS for advanced distribution automation analysis.' ;
    rdfs:domain ind:OutageRestorationLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:equipmentFailureFlag rdf:type rdf:Property ;
    rdfs:label 'Equipment Failure Flag' ;
    rdfs:comment 'Indicates whether equipment failure was identified during this restoration activity. True if equipment failure was discovered, false otherwise.' ;
    rdfs:domain ind:OutageRestorationLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:loadRestoredMw rdf:type rdf:Property ;
    rdfs:label 'Load Restored Mw' ;
    rdfs:comment 'Amount of electrical load in megawatts restored at this milestone. Supports grid operations analysis and capacity restoration tracking.' ;
    rdfs:domain ind:OutageRestorationLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mutualAidRequestFlag rdf:type rdf:Property ;
    rdfs:label 'Mutual Aid Request Flag' ;
    rdfs:comment 'Indicates whether mutual aid resources were requested or utilized for this restoration activity. True if mutual aid was involved, false otherwise.' ;
    rdfs:domain ind:OutageRestorationLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:omsTicketNumber rdf:type rdf:Property ;
    rdfs:label 'Oms Ticket Number' ;
    rdfs:comment 'Reference number of the OMS trouble ticket associated with this restoration activity. Links to outage management system for end-to-end outage tracking.' ;
    rdfs:domain ind:OutageRestorationLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:restorationCostEstimate rdf:type rdf:Property ;
    rdfs:label 'Restoration Cost Estimate' ;
    rdfs:comment 'Estimated cost in USD associated with this restoration activity. Includes labor, materials, and equipment costs for financial tracking and storm cost analysis.' ;
    rdfs:domain ind:OutageRestorationLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:restorationDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Restoration Duration Minutes' ;
    rdfs:comment 'Duration in minutes from outage start to this restoration milestone. Used for calculating CAIDI (Customer Average Interruption Duration Index) and other reliability metrics.' ;
    rdfs:domain ind:OutageRestorationLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:restorationMilestoneType rdf:type rdf:Property ;
    rdfs:label 'Restoration Milestone Type' ;
    rdfs:comment 'Classification of the restoration activity milestone. Defines the type of restoration event being logged (crew dispatch, fault isolation, switching, partial or full restoration).' ;
    rdfs:domain ind:OutageRestorationLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:restorationNotes rdf:type rdf:Property ;
    rdfs:label 'Restoration Notes' ;
    rdfs:comment 'Free-text notes and observations recorded by field crews during restoration activity. Captures operational details, challenges encountered, and lessons learned.' ;
    rdfs:domain ind:OutageRestorationLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:restorationSequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Restoration Sequence Number' ;
    rdfs:comment 'Sequential ordering of restoration activities within a single outage event. Enables chronological reconstruction of restoration workflow.' ;
    rdfs:domain ind:OutageRestorationLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:restorationStatus rdf:type rdf:Property ;
    rdfs:label 'Restoration Status' ;
    rdfs:comment 'Current status of this restoration activity. Tracks whether the restoration milestone is in progress, completed, failed, or pending verification.' ;
    rdfs:domain ind:OutageRestorationLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scadaConfirmationFlag rdf:type rdf:Property ;
    rdfs:label 'Scada Confirmation Flag' ;
    rdfs:comment 'Indicates whether the restoration activity was confirmed via SCADA system. True if SCADA telemetry verified the restoration, false if manual confirmation only.' ;
    rdfs:domain ind:OutageRestorationLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:vegetationRelatedFlag rdf:type rdf:Property ;
    rdfs:label 'Vegetation Related Flag' ;
    rdfs:comment 'Indicates whether vegetation contact or interference was involved in the outage being restored. True if vegetation-related, false otherwise.' ;
    rdfs:domain ind:OutageRestorationLog ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:affectedFacilities rdf:type rdf:Property ;
    rdfs:label 'Affected Facilities' ;
    rdfs:comment 'List or description of transmission lines, substations, generation units, or other Bulk Electric System (BES) facilities impacted by the reliability event. Includes facility identifiers and equipment names.' ;
    rdfs:domain ind:ReliabilityEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:analysisCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Analysis Completion Date' ;
    rdfs:comment 'Date when the post-event analysis or root cause investigation was completed. Null if analysis is not yet complete or not required.' ;
    rdfs:domain ind:ReliabilityEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:caidiImpactMinutes rdf:type rdf:Property ;
    rdfs:label 'Caidi Impact Minutes' ;
    rdfs:comment 'Contribution of this reliability event to the utility\'s CAIDI metric, measured in average minutes per customer interruption. Used for reliability performance tracking and regulatory reporting.' ;
    rdfs:domain ind:ReliabilityEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cipIncidentFlag rdf:type rdf:Property ;
    rdfs:label 'Cip Incident Flag' ;
    rdfs:comment 'Indicates whether this reliability event is also classified as a NERC CIP cyber security or physical security incident requiring separate CIP incident reporting. True if CIP incident reporting is required.' ;
    rdfs:domain ind:ReliabilityEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contributingFactors rdf:type rdf:Property ;
    rdfs:label 'Contributing Factors' ;
    rdfs:comment 'Additional factors that contributed to the severity or propagation of the reliability event. May include cascading failures, inadequate operating reserves, communication failures, or procedural gaps.' ;
    rdfs:domain ind:ReliabilityEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:controlRoomLocation rdf:type rdf:Property ;
    rdfs:label 'Control Room Location' ;
    rdfs:comment 'Physical location or identifier of the control room where the reliability event was managed. Used for tracking operational responsibility and shift coordination.' ;
    rdfs:domain ind:ReliabilityEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctiveActionsTaken rdf:type rdf:Property ;
    rdfs:label 'Corrective Actions Taken' ;
    rdfs:comment 'Description of immediate corrective actions taken by operators to mitigate or resolve the reliability event. Includes switching operations, load shedding, generation dispatch adjustments, and emergency procedures executed.' ;
    rdfs:domain ind:ReliabilityEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:detectionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Detection Timestamp' ;
    rdfs:comment 'Date and time when the reliability event was first detected by control room operators, SCADA alarms, or automated monitoring systems. May differ from event start if detection was delayed.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:emsCaseCode rdf:type rdf:Property ;
    rdfs:label 'Ems Case Code' ;
    rdfs:comment 'Identifier for the EMS state estimator case or snapshot associated with the reliability event. Links to power flow analysis and system state data at the time of the event.' ;
    rdfs:domain ind:ReliabilityEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedRestorationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Estimated Restoration Timestamp' ;
    rdfs:comment 'Estimated date and time when full service restoration is expected to be completed. Updated as restoration work progresses. Null if event is already resolved.' ;
    rdfs:domain ind:ReliabilityEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:eventClassification rdf:type rdf:Property ;
    rdfs:label 'Event Classification' ;
    rdfs:comment 'Primary classification of the reliability event per NERC EOP/TOP standards and internal utility categorization. Determines regulatory reporting obligations and escalation procedures.' ;
    rdfs:domain ind:ReliabilityEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lessonsLearned rdf:type rdf:Property ;
    rdfs:label 'Lessons Learned' ;
    rdfs:comment 'Summary of key lessons learned from the reliability event. Includes insights on operational procedures, equipment performance, communication effectiveness, and recommendations for improvement.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mwGenerationLost rdf:type rdf:Property ;
    rdfs:label 'Mw Generation Lost' ;
    rdfs:comment 'Total amount of generation capacity lost during the reliability event, measured in megawatts. Includes forced outages and emergency shutdowns of generation units.' ;
    rdfs:domain ind:ReliabilityEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mwLoadLost rdf:type rdf:Property ;
    rdfs:label 'Mw Load Lost' ;
    rdfs:comment 'Total amount of customer load lost during the reliability event, measured in megawatts. Key metric for assessing event severity and NERC reporting thresholds.' ;
    rdfs:domain ind:ReliabilityEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nercOe417ReportNumber rdf:type rdf:Property ;
    rdfs:label 'Nerc Oe417 Report Number' ;
    rdfs:comment 'Unique identifier for the NERC OE-417 Electric Emergency Incident and Disturbance Report filed for this reliability event. Links to official regulatory submission.' ;
    rdfs:domain ind:ReliabilityEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operatorEntryType rdf:type rdf:Property ;
    rdfs:label 'Operator Entry Type' ;
    rdfs:comment 'Classification of the operator log entry by type. Distinguishes between event-related actions, routine observations, shift logs, standing orders, and equipment status notes. [ENUM-REF-CANDIDATE: event_action|observation|communication|shift_handoff|alarm_ack|switching_order|standing_order|equipment_status — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:ReliabilityEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operatorLogEntry rdf:type rdf:Property ;
    rdfs:label 'Operator Log Entry' ;
    rdfs:comment 'Chronological free-text narrative of operator actions, observations, and communications during the reliability event. Includes shift handoff notes, alarm acknowledgments, switching orders executed, and inter-utility communications. Forms the official auditable operational record.' ;
    rdfs:domain ind:ReliabilityEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operatorName rdf:type rdf:Property ;
    rdfs:label 'Operator Name' ;
    rdfs:comment 'Name of the control room operator who logged the entry or took action during the reliability event. Used for operational accountability and training purposes.' ;
    rdfs:domain ind:ReliabilityEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postEventAnalysisRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Post Event Analysis Required Flag' ;
    rdfs:comment 'Indicates whether a formal post-event analysis or root cause investigation is required for this reliability event. True for significant events requiring detailed technical review.' ;
    rdfs:domain ind:ReliabilityEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:preventiveActionsRecommended rdf:type rdf:Property ;
    rdfs:label 'Preventive Actions Recommended' ;
    rdfs:comment 'Recommended preventive actions to avoid recurrence of similar reliability events. May include equipment upgrades, procedure changes, training enhancements, or system reinforcements.' ;
    rdfs:domain ind:ReliabilityEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:restorationPriority rdf:type rdf:Property ;
    rdfs:label 'Restoration Priority' ;
    rdfs:comment 'Priority level assigned for service restoration efforts. Critical priority for hospitals, emergency services, and critical infrastructure; high for large customer groups; medium and low for routine restoration.' ;
    rdfs:domain ind:ReliabilityEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:saidiImpactMinutes rdf:type rdf:Property ;
    rdfs:label 'Saidi Impact Minutes' ;
    rdfs:comment 'Contribution of this reliability event to the utility\'s SAIDI metric, measured in customer-minutes of interruption. Used for reliability performance tracking and regulatory reporting.' ;
    rdfs:domain ind:ReliabilityEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:saifiImpactCount rdf:type rdf:Property ;
    rdfs:label 'Saifi Impact Count' ;
    rdfs:comment 'Contribution of this reliability event to the utility\'s SAIFI metric, measured as interruption frequency per customer. Used for reliability performance tracking and regulatory reporting.' ;
    rdfs:domain ind:ReliabilityEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scadaAlarmCount rdf:type rdf:Property ;
    rdfs:label 'Scada Alarm Count' ;
    rdfs:comment 'Total number of SCADA alarms triggered during the reliability event. Used to assess event complexity and operator workload during the incident.' ;
    rdfs:domain ind:ReliabilityEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:shiftSupervisorName rdf:type rdf:Property ;
    rdfs:label 'Shift Supervisor Name' ;
    rdfs:comment 'Name of the shift supervisor on duty during the reliability event. Used for operational accountability and post-event review coordination.' ;
    rdfs:domain ind:ReliabilityEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateReportableFlag rdf:type rdf:Property ;
    rdfs:label 'State Reportable Flag' ;
    rdfs:comment 'Indicates whether this event must be reported to state Public Utility Commission per state-specific disturbance reporting requirements. True if state reporting is required.' ;
    rdfs:domain ind:ReliabilityEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:associatedAssetAssetRegistryId rdf:type rdf:Property ;
    rdfs:label 'Associated Asset Asset Registry Id' ;
    rdfs:comment 'Reference to the grid asset (substation, transformer, generator, transmission line, distribution feeder, capacitor bank, etc.) that this SCADA point monitors or controls. Links the telemetry point to the physical asset in the asset management system (Maximo EAM or Esri ArcGIS). Used for asset health analytics and outage correlation.' ;
    rdfs:domain ind:ScadaPoint ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Registry .

ind:associatedAssetRegistryId rdf:type rdf:Property ;
    rdfs:label 'Associated Asset Registry Id' ;
    rdfs:comment 'Reference to the grid asset (substation, transformer, generator, transmission line, distribution feeder, capacitor bank, etc.) that this SCADA point monitors or controls. Links the telemetry point to the physical asset in the asset management system (Maximo EAM or Esri ArcGIS). Used for asset health analytics and outage correlation.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Registry .

ind:alarmHighHighLimit rdf:type rdf:Property ;
    rdfs:label 'Alarm High High Limit' ;
    rdfs:comment 'The critical upper threshold (High-High) above which an emergency or critical alarm is triggered, indicating a severe operational condition requiring immediate operator action. Expressed in engineering units. Used in EMS/DMS for two-tier alarm escalation (High vs. High-High). Supports NERC reliability event classification.' ;
    rdfs:domain ind:ScadaPoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:alarmHighLimit rdf:type rdf:Property ;
    rdfs:label 'Alarm High Limit' ;
    rdfs:comment 'The upper operational threshold above which an alarm condition is triggered in the EMS/DMS/SCADA system. When the measured value exceeds this limit, an alarm notification is generated for grid operators. Expressed in engineering units. Configured in GE PowerOn EMS/DMS alarm management module.' ;
    rdfs:domain ind:ScadaPoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:alarmLowLimit rdf:type rdf:Property ;
    rdfs:label 'Alarm Low Limit' ;
    rdfs:comment 'The lower operational threshold below which an alarm condition is triggered in the EMS/DMS/SCADA system. When the measured value falls below this limit, an alarm notification is generated for grid operators. Expressed in engineering units. Configured in GE PowerOn EMS/DMS alarm management module.' ;
    rdfs:domain ind:ScadaPoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:alarmLowLowLimit rdf:type rdf:Property ;
    rdfs:label 'Alarm Low Low Limit' ;
    rdfs:comment 'The critical lower threshold (Low-Low) below which an emergency or critical alarm is triggered, indicating a severe operational condition requiring immediate operator action. Expressed in engineering units. Used in EMS/DMS for two-tier alarm escalation (Low vs. Low-Low). Supports NERC reliability event classification.' ;
    rdfs:domain ind:ScadaPoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commissionedDate rdf:type rdf:Property ;
    rdfs:label 'Commissioned Date' ;
    rdfs:comment 'The date on which this SCADA point was formally commissioned and activated in the operational SCADA/EMS/DMS system. Marks the start of the point\'s active lifecycle. Used for asset age analysis, warranty tracking, and NERC CIP change management audit trails.' ;
    rdfs:domain ind:ScadaPoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:compressionEnabled rdf:type rdf:Property ;
    rdfs:label 'Compression Enabled' ;
    rdfs:comment 'Indicates whether OSIsoft PI Historian data compression (exception and compression deviation) is enabled for this point. When True, PI Historian applies the deadband_value and compression deviation to reduce storage while preserving data fidelity. When False, all scanned values are archived (raw storage mode). Impacts PI Historian storage sizing and data retrieval performance.' ;
    rdfs:domain ind:ScadaPoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deadbandValue rdf:type rdf:Property ;
    rdfs:label 'Deadband Value' ;
    rdfs:comment 'The minimum change in the measured value required to trigger a new data archive event in OSIsoft PI Historian (exception deviation). Expressed in the same engineering units as the point. Prevents excessive data storage for slowly-changing signals while ensuring meaningful changes are captured. Configured per point in PI Historian compression settings.' ;
    rdfs:domain ind:ScadaPoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:decommissionedDate rdf:type rdf:Property ;
    rdfs:label 'Decommissioned Date' ;
    rdfs:comment 'The date on which this SCADA point was decommissioned and removed from active scanning in the SCADA/EMS/DMS system. Null if the point is still active. Used for lifecycle management, historical data archival decisions, and NERC CIP asset retirement documentation.' ;
    rdfs:domain ind:ScadaPoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:emsPointAddress rdf:type rdf:Property ;
    rdfs:label 'Ems Point Address' ;
    rdfs:comment 'The point address or database key used to reference this telemetry point within the GE PowerOn EMS/DMS real-time database. Typically a hierarchical address string (e.g., \'AREA.SUBSTATION.DEVICE.MEASUREMENT\'). Used for EMS state estimation, contingency analysis, and real-time display binding.' ;
    rdfs:domain ind:ScadaPoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:energyType rdf:type rdf:Property ;
    rdfs:label 'Energy Type' ;
    rdfs:comment 'Identifies whether this SCADA point monitors an electric grid asset or a natural gas infrastructure asset. \'electric\' = electric T&D or generation; \'gas\' = natural gas pipeline, compressor, or distribution; \'both\' = dual-fuel or combined measurement point. Supports domain partitioning for electric vs. gas operations analytics.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engineeringUnit rdf:type rdf:Property ;
    rdfs:label 'Engineering Unit' ;
    rdfs:comment 'The physical unit of measurement associated with the SCADA point value (e.g., \'kV\', \'MW\', \'MVAr\', \'A\', \'Hz\', \'degF\', \'PSI\', \'MCF/hr\', \'kWh\'). Sourced from OSIsoft PI Historian engineering unit configuration. Critical for correct interpretation of telemetry values in EMS, DMS, and analytics applications. Aligns with IEC 61970 CIM unit symbols.' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:functionalLocation rdf:type rdf:Property ;
    rdfs:label 'Functional Location' ;
    rdfs:comment 'The SAP PM (Plant Maintenance) functional location code identifying the hierarchical physical location of the asset associated with this SCADA point (e.g., \'TX-SUBST-A-XFMR-01\'). Links SCADA telemetry to the SAP ERP asset hierarchy for O&M cost allocation, work order management, and CAPEX/OPEX tracking.' ;
    rdfs:domain ind:ScadaPoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isAlarmed rdf:type rdf:Property ;
    rdfs:label 'Is Alarmed' ;
    rdfs:comment 'Indicates whether alarm processing is enabled for this SCADA point in the EMS/DMS alarm management system. True = alarm limits are active and will generate operator notifications; False = alarm processing suppressed (e.g., during maintenance or commissioning). Drives alarm display filtering in GE PowerOn EMS/DMS.' ;
    rdfs:domain ind:ScadaPoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isBesApplicable rdf:type rdf:Property ;
    rdfs:label 'Is Bes Applicable' ;
    rdfs:comment 'Indicates whether this SCADA point is associated with a Bulk Electric System (BES) element as defined by NERC. BES-applicable points are subject to NERC CIP cybersecurity standards and NERC reliability standards reporting requirements. True = BES applicable; False = non-BES (distribution or sub-transmission).' ;
    rdfs:domain ind:ScadaPoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCipApplicable rdf:type rdf:Property ;
    rdfs:label 'Is Cip Applicable' ;
    rdfs:comment 'Indicates whether this SCADA point is subject to NERC Critical Infrastructure Protection (CIP) cybersecurity standards. CIP-applicable points require access control, monitoring, and change management per NERC CIP-007-6. True = CIP applicable; False = not subject to CIP requirements.' ;
    rdfs:domain ind:ScadaPoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isControllable rdf:type rdf:Property ;
    rdfs:label 'Is Controllable' ;
    rdfs:comment 'Indicates whether this SCADA point supports remote control operations (e.g., breaker open/close, tap changer raise/lower, setpoint adjustment) from the EMS/DMS/SCADA master station. True = remote control enabled; False = read-only telemetry. Critical for access control and NERC CIP classification of control points.' ;
    rdfs:domain ind:ScadaPoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:measurementCategory rdf:type rdf:Property ;
    rdfs:label 'Measurement Category' ;
    rdfs:comment 'The physical or electrical quantity being measured by this SCADA point. Categorizes the telemetry by measurement domain for analytics, display grouping, and regulatory reporting. Examples: \'voltage\' (kV), \'power_mw\' (real power), \'power_mvar\' (reactive power), \'frequency\' (Hz), \'flow_mcf\' (gas flow), \'pressure\' (PSI). [ENUM-REF-CANDIDATE: voltage|current|power_mw|power_mvar|frequency|energy_mwh|flow_mcf|pressure|temperature|status_indication|position — promote to reference product]' ;
    rdfs:domain ind:ScadaPoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextCalibrationDate rdf:type rdf:Property ;
    rdfs:label 'Next Calibration Date' ;
    rdfs:comment 'The scheduled date for the next calibration or verification of the field instrument associated with this SCADA point. Drives preventive maintenance work order generation in Maximo EAM. Ensures compliance with PHMSA gas measurement calibration intervals and OSHA instrument maintenance requirements.' ;
    rdfs:domain ind:ScadaPoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nominalValue rdf:type rdf:Property ;
    rdfs:label 'Nominal Value' ;
    rdfs:comment 'The expected or design nominal operating value for this SCADA point under normal grid conditions (e.g., nominal voltage = 138.0 kV, nominal frequency = 60.0 Hz). Used as a reference baseline for deviation analysis, alarm limit setting, and grid state estimation in EMS. Expressed in engineering units.' ;
    rdfs:domain ind:ScadaPoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:offsetValue rdf:type rdf:Property ;
    rdfs:label 'Offset Value' ;
    rdfs:comment 'Additive offset applied after scale factor conversion to produce the final engineering unit value from the raw telemetry input. Used to correct for zero-point calibration errors or instrument biases. Configured in OSIsoft PI Historian or GE PowerOn EMS/DMS as part of the point\'s conversion formula.' ;
    rdfs:domain ind:ScadaPoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:piPointCode rdf:type rdf:Property ;
    rdfs:label 'Pi Point Code' ;
    rdfs:comment 'The native point identifier (PI Point ID or PI Tag Name) assigned by OSIsoft PI Historian for this SCADA telemetry point. Used for direct API queries to PI Historian via PI Web API or PI OLEDB. Enables traceability from the Silver Layer back to the source historian record.' ;
    rdfs:domain ind:ScadaPoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pointClass rdf:type rdf:Property ;
    rdfs:label 'Point Class' ;
    rdfs:comment 'Functional classification of the SCADA point indicating its operational role. \'measurement\' = real-time telemetry value; \'status\' = equipment state indication; \'control\' = remotely operable control point; \'setpoint\' = configurable operating parameter; \'alarm\' = alarm/event indicator. Used for access control, display filtering, and NERC CIP classification.' ;
    rdfs:domain ind:ScadaPoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pointDescription rdf:type rdf:Property ;
    rdfs:label 'Point Description' ;
    rdfs:comment 'Free-text description of the SCADA telemetry point providing additional context about what is being measured, the associated equipment, and its operational significance. Sourced from OSIsoft PI Historian point descriptor field. Used in operator displays, engineering documentation, and data catalog search.' ;
    rdfs:domain ind:ScadaPoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pointName rdf:type rdf:Property ;
    rdfs:label 'Point Name' ;
    rdfs:comment 'Human-readable name of the SCADA telemetry point as configured in OSIsoft PI Historian or GE PowerOn EMS/DMS. Serves as the primary identity label for the point (e.g., \'SUBST_A_BUS1_VOLT\', \'GEN_UNIT3_MW_OUTPUT\'). Used by grid operators and engineers to identify the measurement in real-time displays and historian queries.' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pointStatus rdf:type rdf:Property ;
    rdfs:label 'Point Status' ;
    rdfs:comment 'Current lifecycle status of the SCADA point in the master catalog. \'active\' = currently scanning and reporting; \'inactive\' = configured but not scanning; \'commissioned\' = newly added and validated; \'decommissioned\' = retired from service; \'suspended\' = temporarily halted due to maintenance or fault. Drives data quality filtering in PI Historian and Silver Layer ingestion.' ;
    rdfs:domain ind:ScadaPoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pointType rdf:type rdf:Property ;
    rdfs:label 'Point Type' ;
    rdfs:comment 'Classification of the SCADA telemetry point by signal type. \'analog\' = continuous measurement (e.g., voltage, MW flow); \'digital\' = discrete state (e.g., breaker open/closed); \'accumulator\' = pulse-count integration (e.g., energy meter pulse); \'string\' = text-based status; \'calculated\' = derived value computed within the historian or EMS.' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rawHighLimit rdf:type rdf:Property ;
    rdfs:label 'Raw High Limit' ;
    rdfs:comment 'The maximum raw input value (in engineering units) that the SCADA point can physically receive from the field device before being flagged as out-of-range. Values above this threshold are treated as bad quality data. Configured in OSIsoft PI Historian and GE PowerOn EMS/DMS for data validation.' ;
    rdfs:domain ind:ScadaPoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rawLowLimit rdf:type rdf:Property ;
    rdfs:label 'Raw Low Limit' ;
    rdfs:comment 'The minimum raw input value (in engineering units) that the SCADA point can physically receive from the field device before being flagged as out-of-range. Values below this threshold are treated as bad quality data. Configured in OSIsoft PI Historian and GE PowerOn EMS/DMS for data validation.' ;
    rdfs:domain ind:ScadaPoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rtuAddress rdf:type rdf:Property ;
    rdfs:label 'Rtu Address' ;
    rdfs:comment 'The communication address of the Remote Terminal Unit (RTU) or Intelligent Electronic Device (IED) from which this SCADA point is polled. Includes protocol-specific addressing (e.g., DNP3 address, Modbus register, IEC 60870-5-101/104 information object address). Used for field device troubleshooting and communication diagnostics.' ;
    rdfs:domain ind:ScadaPoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scaleFactor rdf:type rdf:Property ;
    rdfs:label 'Scale Factor' ;
    rdfs:comment 'Multiplier applied to the raw telemetry input value to convert it to engineering units. For example, a current transformer (CT) ratio or potential transformer (PT) ratio applied to raw analog counts. Configured in OSIsoft PI Historian or GE PowerOn EMS/DMS as part of the point\'s conversion formula.' ;
    rdfs:domain ind:ScadaPoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scanRateSeconds rdf:type rdf:Property ;
    rdfs:label 'Scan Rate Seconds' ;
    rdfs:comment 'The frequency in seconds at which the SCADA system polls or samples this telemetry point from the field device (RTU, IED, or PLC). Common values: 2 (high-frequency protection), 4 (standard SCADA), 30 (slow telemetry), 60 (non-critical). Determines data density in PI Historian and impacts AMI/SCADA bandwidth planning.' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tagCode rdf:type rdf:Property ;
    rdfs:label 'Tag Code' ;
    rdfs:comment 'Externally-known unique tag identifier assigned to the SCADA point in the source operational system (OSIsoft PI Historian tag name or GE PowerOn point address). This is the business identifier used across OMS, DMS, EMS, and PI Historian integrations to reference the telemetry point. Equivalent to the PI tag name in OSIsoft PI.' ;
    rdfs:domain ind:ScadaPoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scadaReadingId rdf:type rdf:Property ;
    rdfs:label 'Scada Reading Id' ;
    rdfs:comment 'Unique surrogate identifier for each SCADA telemetry reading or alarm event record in the Silver layer. Entity role: EVENT_LOG — this is an append-only stream of immutable timestamped observations and alarm events captured from SCADA points via OSIsoft PI Historian.' ;
    rdfs:domain ind:ScadaReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:drDispatchEventId rdf:type rdf:Property ;
    rdfs:label 'Dr Dispatch Dr Dispatch Event Id' ;
    rdfs:comment 'Reference to the Demand Response (DR) dispatch event that this SCADA reading is associated with, when the reading reflects load reduction or DR program response. Enables measurement and verification (M&V) of DR performance against dispatch instructions.' ;
    rdfs:domain ind:ScadaReading ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DrDispatchEvent .

ind:lmpPriceId rdf:type rdf:Property ;
    rdfs:label 'Lmp Price Id' ;
    rdfs:comment 'Reference to the RTO/ISO pricing node (LMP node) associated with this SCADA measurement point. Enables correlation of real-time telemetry with Day-Ahead Market (DAM) and Real-Time Market (RTM) LMP prices for congestion analysis and energy trading settlement.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LmpPrice .

ind:alarmDurationSeconds rdf:type rdf:Property ;
    rdfs:label 'Alarm Duration Seconds' ;
    rdfs:comment 'The elapsed time in seconds between alarm trigger (reading_timestamp) and alarm cleared (cleared_timestamp). Used for ISA-18.2 alarm flood analysis, chattering alarm detection (alarms clearing and re-triggering rapidly), and post-event reliability analysis. Null if alarm is still active or not an alarm record.' ;
    rdfs:domain ind:ScadaReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:alarmPointRef rdf:type rdf:Property ;
    rdfs:label 'Alarm Point Ref' ;
    rdfs:comment 'The unique identifier or tag reference of the SCADA alarm point as configured in the DMS/EMS alarm management system (e.g., \'ALM_SUB_NORTH_BKR101_THERMAL\'). Used to cross-reference alarm events back to the alarm rationalization register and ISA-18.2 master alarm database.' ;
    rdfs:domain ind:ScadaReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alarmPriority rdf:type rdf:Property ;
    rdfs:label 'Alarm Priority' ;
    rdfs:comment 'The ISA-18.2 priority level assigned to the alarm (critical, high, medium, low, advisory). Drives operator response urgency, alarm flood analysis, and alarm rationalization reviews. Null for non-alarm readings.' ;
    rdfs:domain ind:ScadaReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alarmThreshold rdf:type rdf:Property ;
    rdfs:label 'Alarm Threshold' ;
    rdfs:comment 'The configured setpoint or limit value that, when crossed by the measured value, triggers the alarm (e.g., 110 MW thermal limit, 0.95 pu voltage low limit, 59.95 Hz under-frequency threshold). Supports alarm rationalization and threshold optimization analysis.' ;
    rdfs:domain ind:ScadaReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:analogValue rdf:type rdf:Property ;
    rdfs:label 'Analog Value' ;
    rdfs:comment 'The numeric measured value for analog SCADA points (e.g., 345.7 kV, 150.3 MW, 60.02 Hz, 1250 amps). This is the principal EVENT_PAYLOAD_OR_VALUE for analog readings. Null for digital state points. Stored in the engineering unit defined by engineering_unit.' ;
    rdfs:domain ind:ScadaReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:compressionDeviation rdf:type rdf:Property ;
    rdfs:label 'Compression Deviation' ;
    rdfs:comment 'The PI Historian compression deviation (swinging door algorithm tolerance) applied to this tag. Determines how aggressively PI compresses the time-series data. Understanding compression settings is essential for accurate signal reconstruction in load forecasting and post-event analysis.' ;
    rdfs:domain ind:ScadaReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:digitalState rdf:type rdf:Property ;
    rdfs:label 'Digital State' ;
    rdfs:comment 'The discrete state value for digital SCADA points representing equipment status (e.g., breaker open/closed, switch status, protection relay trip/normal, recloser enabled/disabled). Null for analog measurement points. [ENUM-REF-CANDIDATE: open|closed|trip|lockout|normal|abnormal|on|off|enabled|disabled — promote to reference product]' ;
    rdfs:domain ind:ScadaReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exceptionDeviation rdf:type rdf:Property ;
    rdfs:label 'Exception Deviation' ;
    rdfs:comment 'The configured exception deviation (deadband) value for this PI tag — the minimum change in analog value required to trigger a new archive event in PI Historian. A reading is stored only when the value changes by more than this amount. Used to understand data compression behavior and reconstruct continuous signal profiles.' ;
    rdfs:domain ind:ScadaReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fercJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Ferc Jurisdiction' ;
    rdfs:comment 'Indicates whether the asset associated with this SCADA point falls under FERC jurisdictional transmission (interstate), state PUC jurisdictional distribution, or is exempt. Determines applicable regulatory reporting requirements for FERC Form 1, NERC reliability standards, and rate case filings.' ;
    rdfs:domain ind:Gridops ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ingestedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Ingested Timestamp' ;
    rdfs:comment 'The UTC timestamp at which this record was written into the Silver layer lakehouse table. Used to measure data latency, detect backfill scenarios, and support audit trails. Distinct from reading_timestamp which reflects the real-world event time.' ;
    rdfs:domain ind:ScadaReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:isAlarm rdf:type rdf:Property ;
    rdfs:label 'Is Alarm' ;
    rdfs:comment 'Indicates whether this record represents an alarm event (True) or a routine telemetry reading (False). Partitions the dataset for alarm management workflows, ISA-18.2 alarm rationalization analysis, and operator performance review.' ;
    rdfs:domain ind:ScadaReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isShelved rdf:type rdf:Property ;
    rdfs:label 'Is Shelved' ;
    rdfs:comment 'Indicates whether the alarm has been temporarily shelved (removed from active annunciation for a defined period) per ISA-18.2 shelving practice. Shelved alarms are excluded from alarm flood counts but must be tracked for rationalization audits.' ;
    rdfs:domain ind:ScadaReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSuppressed rdf:type rdf:Property ;
    rdfs:label 'Is Suppressed' ;
    rdfs:comment 'Indicates whether the alarm is in a suppressed (by-design disabled) state, such as during planned maintenance or equipment outage. Suppressed alarms must be documented and reviewed per ISA-18.2 alarm rationalization requirements.' ;
    rdfs:domain ind:ScadaReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:measurementType rdf:type rdf:Property ;
    rdfs:label 'Measurement Type' ;
    rdfs:comment 'The engineering quantity being measured by this SCADA point (e.g., MW for real power, MVAR for reactive power, kV for voltage, Hz for frequency, amps for current, temperature_c for equipment temperature, flow_mcf for gas flow). Drives unit-of-measure validation and alarm threshold interpretation. [ENUM-REF-CANDIDATE: MW|MVAR|kV|Hz|amps|temperature_c|MVA|power_factor|tap_position|flow_mcf|pressure_psi|status — promote to reference product]' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nercCipAssetClass rdf:type rdf:Property ;
    rdfs:label 'Nerc Cip Asset Class' ;
    rdfs:comment 'The NERC CIP Bulk Electric System (BES) asset classification for the asset associated with this SCADA point (BES_high, BES_medium, BES_low, non_BES). Determines applicable NERC CIP cybersecurity standards (CIP-002 through CIP-014) and access control requirements for this telemetry data.' ;
    rdfs:domain ind:ScadaReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:piArchiveName rdf:type rdf:Property ;
    rdfs:label 'Pi Archive Name' ;
    rdfs:comment 'The name of the OSIsoft PI Historian archive file or data archive from which this reading was extracted (e.g., \'PI_ARCHIVE_2024_Q1\'). Supports data lineage, archive retrieval for post-event analysis, and Silver layer backfill reconciliation.' ;
    rdfs:domain ind:ScadaReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:piTagCode rdf:type rdf:Property ;
    rdfs:label 'Pi Tag Code' ;
    rdfs:comment 'Reference to the PI Historian tag (SCADA point) that emitted this reading. Serves as the EVENT_SOURCE_REFERENCE linking the observation back to the originating sensor or control point definition.' ;
    rdfs:domain ind:ScadaReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:qualityCode rdf:type rdf:Property ;
    rdfs:label 'Quality Code' ;
    rdfs:comment 'OSIsoft PI Historian quality descriptor indicating the reliability of the reading (e.g., good = valid telemetry, bad = hardware/comm failure, uncertain = questionable signal, substituted = manually entered replacement, stale = no update within scan cycle). Critical for filtering unreliable data in operational analytics and NERC compliance evidence. [ENUM-REF-CANDIDATE: good|bad|uncertain|substituted|manual|stale|comm_fail|out_of_scan — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rawValueString rdf:type rdf:Property ;
    rdfs:label 'Raw Value String' ;
    rdfs:comment 'The original unparsed string representation of the SCADA point value as received from the RTU/IED before type conversion and engineering unit scaling. Preserved for data quality investigation, protocol debugging, and Silver layer reconciliation against the Bronze raw landing zone.' ;
    rdfs:domain ind:ScadaReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readingTimestamp rdf:type rdf:Property ;
    rdfs:label 'Reading Timestamp' ;
    rdfs:comment 'The precise UTC timestamp at which the SCADA point value was sampled or the alarm event was triggered, as recorded by OSIsoft PI Historian. This is the principal EVENT_TIMESTAMP and the primary time axis for all operational analysis, post-event review, and NERC compliance evidence.' ;
    rdfs:domain ind:ScadaReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:rtuCode rdf:type rdf:Property ;
    rdfs:label 'Rtu Code' ;
    rdfs:comment 'The identifier of the Remote Terminal Unit (RTU) or Intelligent Electronic Device (IED) that collected and transmitted this SCADA reading to the EMS/DMS. Supports communication path diagnostics, RTU performance monitoring, and NERC CIP-007 device inventory tracking.' ;
    rdfs:domain ind:ScadaReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shelveExpiryTimestamp rdf:type rdf:Property ;
    rdfs:label 'Shelve Expiry Timestamp' ;
    rdfs:comment 'The UTC timestamp at which a shelved alarm is scheduled to automatically return to active annunciation. Supports ISA-18.2 shelving time-limit enforcement and alarm rationalization audit trails. Null if alarm is not shelved.' ;
    rdfs:domain ind:ScadaReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:substitutionReason rdf:type rdf:Property ;
    rdfs:label 'Substitution Reason' ;
    rdfs:comment 'When quality_code is \'substituted\', this field records the reason the original telemetry value was replaced (e.g., manual_entry by operator, estimated from adjacent readings, comm_failure_fill during communication outage, maintenance_hold during planned work). Required for NERC compliance evidence and data quality audit trails.' ;
    rdfs:domain ind:ScadaReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:securityAssessmentId rdf:type rdf:Property ;
    rdfs:label 'Security Assessment Id' ;
    rdfs:comment 'Unique identifier for the security assessment record. Primary key.' ;
    rdfs:domain ind:SecurityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assessmentDurationSeconds rdf:type rdf:Property ;
    rdfs:label 'Assessment Duration Seconds' ;
    rdfs:comment 'Total execution time of the security assessment in seconds, from initiation to completion.' ;
    rdfs:domain ind:SecurityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contingencyCount rdf:type rdf:Property ;
    rdfs:label 'Contingency Count' ;
    rdfs:comment 'Total number of contingencies (N-1, N-2, etc.) analyzed during this security assessment.' ;
    rdfs:domain ind:SecurityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:convergenceIterations rdf:type rdf:Property ;
    rdfs:label 'Convergence Iterations' ;
    rdfs:comment 'Number of iterations required for the power flow calculation to converge during the assessment.' ;
    rdfs:domain ind:SecurityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:correctiveActionSummary rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Summary' ;
    rdfs:comment 'Summary of recommended corrective actions to address violations, such as generation redispatch, load shedding, switching operations, or voltage control adjustments.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxThermalLoadingPct rdf:type rdf:Property ;
    rdfs:label 'Max Thermal Loading Pct' ;
    rdfs:comment 'The highest thermal loading percentage observed on any transmission element during the assessment, expressed as a percentage of the element\'s rated capacity.' ;
    rdfs:domain ind:SecurityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maxVoltagePu rdf:type rdf:Property ;
    rdfs:label 'Max Voltage Pu' ;
    rdfs:comment 'The highest voltage level observed at any bus during the assessment, expressed in per-unit (pu) of nominal voltage.' ;
    rdfs:domain ind:SecurityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minVoltagePu rdf:type rdf:Property ;
    rdfs:label 'Min Voltage Pu' ;
    rdfs:comment 'The lowest voltage level observed at any bus during the assessment, expressed in per-unit (pu) of nominal voltage.' ;
    rdfs:domain ind:SecurityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:peakDemandFlag rdf:type rdf:Property ;
    rdfs:label 'Peak Demand Flag' ;
    rdfs:comment 'Boolean flag indicating whether the assessment was performed during a peak demand period (True = peak demand, False = off-peak).' ;
    rdfs:domain ind:SecurityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:powerFlowConvergenceFlag rdf:type rdf:Property ;
    rdfs:label 'Power Flow Convergence Flag' ;
    rdfs:comment 'Boolean flag indicating whether the power flow calculation converged successfully during the assessment (True = converged, False = did not converge).' ;
    rdfs:domain ind:SecurityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reliabilityCoordinatorNotified rdf:type rdf:Property ;
    rdfs:label 'Reliability Coordinator Notified' ;
    rdfs:comment 'Boolean flag indicating whether the Reliability Coordinator was notified of critical violations found in this assessment (True = notified, False = not notified).' ;
    rdfs:domain ind:SecurityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reserveMarginMw rdf:type rdf:Property ;
    rdfs:label 'Reserve Margin Mw' ;
    rdfs:comment 'Available operating reserve margin in megawatts at the time of the assessment, representing the difference between available generation and current load.' ;
    rdfs:domain ind:SecurityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scadaSnapshotReference rdf:type rdf:Property ;
    rdfs:label 'Scada Snapshot Reference' ;
    rdfs:comment 'Identifier of the SCADA data snapshot used as the base case for this security assessment.' ;
    rdfs:domain ind:SecurityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stabilityViolationCount rdf:type rdf:Property ;
    rdfs:label 'Stability Violation Count' ;
    rdfs:comment 'Number of stability violations (transient, voltage, or oscillatory stability) detected during dynamic security assessment.' ;
    rdfs:domain ind:SecurityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:studyCaseName rdf:type rdf:Property ;
    rdfs:label 'Study Case Name' ;
    rdfs:comment 'The name or identifier of the study case or scenario used for this assessment, typically defined in the EMS study environment.' ;
    rdfs:domain ind:SecurityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thermalOverloadCount rdf:type rdf:Property ;
    rdfs:label 'Thermal Overload Count' ;
    rdfs:comment 'Number of thermal overload violations detected on transmission lines, transformers, or other equipment during the assessment.' ;
    rdfs:domain ind:SecurityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalGenerationMw rdf:type rdf:Property ;
    rdfs:label 'Total Generation Mw' ;
    rdfs:comment 'Total system generation in megawatts at the time of the security assessment.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalLoadMw rdf:type rdf:Property ;
    rdfs:label 'Total Load Mw' ;
    rdfs:comment 'Total system load in megawatts at the time of the security assessment.' ;
    rdfs:domain ind:SecurityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:violationCount rdf:type rdf:Property ;
    rdfs:label 'Violation Count' ;
    rdfs:comment 'Total number of reliability violations (thermal, voltage, stability) detected across all contingencies in this assessment.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:voltageViolationCount rdf:type rdf:Property ;
    rdfs:label 'Voltage Violation Count' ;
    rdfs:comment 'Number of voltage limit violations (high or low voltage) detected at buses or substations during the assessment.' ;
    rdfs:domain ind:SecurityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:worstContingencyDescription rdf:type rdf:Property ;
    rdfs:label 'Worst Contingency Description' ;
    rdfs:comment 'Detailed description of the worst-case contingency scenario, including affected equipment and outage conditions.' ;
    rdfs:domain ind:SecurityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:worstViolationSeverity rdf:type rdf:Property ;
    rdfs:label 'Worst Violation Severity' ;
    rdfs:comment 'Severity classification of the most critical violation found during the assessment: critical (immediate action required), high (urgent attention), medium (monitor closely), low (minor concern), or none (no violations).' ;
    rdfs:domain ind:SecurityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:switchingStepId rdf:type rdf:Property ;
    rdfs:label 'Switching Step Id' ;
    rdfs:comment 'Unique system-generated identifier for each individual switching step record within the Databricks Silver Layer. Serves as the primary key for this entity.' ;
    rdfs:domain ind:SwitchingStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:authorizingOperatorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Authorizing Operator Employee Id' ;
    rdfs:comment 'Reference to the control room operator or supervisor who authorized execution of this switching step. Supports two-person integrity requirements and chain-of-command compliance for high-voltage switching operations.' ;
    rdfs:domain ind:SwitchingStep ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:deviceId rdf:type rdf:Property ;
    rdfs:label 'Device Id' ;
    rdfs:comment 'Reference to the specific grid device (breaker, switch, disconnect, recloser, sectionalizer) on which this switching action is to be performed. Links to the asset registry in the Distribution Management System (DMS) or GIS.' ;
    rdfs:domain ind:SwitchingStep ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:NetworkDevice .

ind:primarySwitchingPersonId rdf:type rdf:Property ;
    rdfs:label 'Primary Switching Person Id' ;
    rdfs:comment 'Reference to the operator or field technician who physically executed or confirmed execution of this switching step. Provides accountability and traceability for safety compliance and post-event analysis.' ;
    rdfs:domain ind:SwitchingStep ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Person .

ind:actualExecutionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Actual Execution Timestamp' ;
    rdfs:comment 'The actual date and time at which this switching step was physically completed by the executing operator. Used for outage duration calculations, SAIDI/SAIFI reporting, and post-switching analysis.' ;
    rdfs:domain ind:SwitchingStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:arcFlashBoundaryFt rdf:type rdf:Property ;
    rdfs:label 'Arc Flash Boundary Ft' ;
    rdfs:comment 'The calculated arc flash protection boundary in feet for the device associated with this switching step, as determined by arc flash hazard analysis. Defines the minimum safe approach distance for personnel.' ;
    rdfs:domain ind:SwitchingStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:confirmedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Confirmed Timestamp' ;
    rdfs:comment 'The date and time at which the control room operator confirmed receipt of the completed step notification from the field operator. Captures the two-way communication verification required for safe switching operations.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:criticalCustomerImpacted rdf:type rdf:Property ;
    rdfs:label 'Critical Customer Impacted' ;
    rdfs:comment 'Indicates whether this switching step affects one or more critical customers (hospitals, emergency services, water treatment facilities, or other life-safety accounts). Triggers priority restoration protocols and regulatory notification requirements.' ;
    rdfs:domain ind:SwitchingStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:customersAffectedCount rdf:type rdf:Property ;
    rdfs:label 'Customers Affected Count' ;
    rdfs:comment 'The number of customer service points that are de-energized or affected as a direct result of this switching step. Used for outage impact assessment, SAIDI/SAIFI calculations, and customer notification prioritization.' ;
    rdfs:domain ind:SwitchingStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:deviationReason rdf:type rdf:Property ;
    rdfs:label 'Deviation Reason' ;
    rdfs:comment 'Explanation for any deviation from the planned switching step, such as a step being skipped, reordered, or modified during execution. Required for post-event review and regulatory compliance documentation.' ;
    rdfs:domain ind:SwitchingStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deviceName rdf:type rdf:Property ;
    rdfs:label 'Device Name' ;
    rdfs:comment 'Human-readable name or label of the grid device targeted by this switching step, as maintained in the Distribution Management System (DMS) or GIS asset registry. Supports operator identification in the field.' ;
    rdfs:domain ind:SwitchingStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deviceStateAfter rdf:type rdf:Property ;
    rdfs:label 'Device State After' ;
    rdfs:comment 'The verified state of the switching device immediately after this step was executed. Confirms the post-condition of the device and validates that the intended switching action was successfully completed.' ;
    rdfs:domain ind:SwitchingStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deviceStateBefore rdf:type rdf:Property ;
    rdfs:label 'Device State Before' ;
    rdfs:comment 'The verified state of the switching device immediately before this step was executed. Confirms the pre-condition of the device and supports post-event reconstruction of grid topology changes.' ;
    rdfs:domain ind:SwitchingStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:executingOperatorName rdf:type rdf:Property ;
    rdfs:label 'Executing Operator Name' ;
    rdfs:comment 'Full name of the operator or field technician who executed this switching step. Captured at time of execution for audit trail and regulatory compliance purposes.' ;
    rdfs:domain ind:SwitchingStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loadCurrentAmps rdf:type rdf:Property ;
    rdfs:label 'Load Current Amps' ;
    rdfs:comment 'The measured or estimated load current in amperes flowing through the device at the time of the switching step. Used to assess whether the switching operation is within the device\'s rated interrupting capacity.' ;
    rdfs:domain ind:SwitchingStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:networkModelNodeCode rdf:type rdf:Property ;
    rdfs:label 'Network Model Node Code' ;
    rdfs:comment 'The node identifier of the target device within the DMS/EMS network connectivity model. Used for power flow analysis, load flow calculations, and topology processing to validate switching step safety.' ;
    rdfs:domain ind:SwitchingStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ppeRequired rdf:type rdf:Property ;
    rdfs:label 'Ppe Required' ;
    rdfs:comment 'Description of the minimum Personal Protective Equipment (PPE) required for safe execution of this switching step, such as arc flash suit rating, rubber gloves class, and face shield requirements per OSHA and NFPA 70E standards.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:protectiveRelayCoordination rdf:type rdf:Property ;
    rdfs:label 'Protective Relay Coordination' ;
    rdfs:comment 'Indicates whether protective relay coordination checks are required before executing this switching step. Ensures that relay settings and protection schemes remain valid after the switching operation to prevent cascading failures.' ;
    rdfs:domain ind:SwitchingStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:remoteOperation rdf:type rdf:Property ;
    rdfs:label 'Remote Operation' ;
    rdfs:comment 'Indicates whether this switching step was executed remotely from the control room via SCADA/DMS, as opposed to a manual field operation by a crew member. Distinguishes automated from manual switching for reliability analysis.' ;
    rdfs:domain ind:SwitchingStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:repeatBackVerified rdf:type rdf:Property ;
    rdfs:label 'Repeat Back Verified' ;
    rdfs:comment 'Indicates whether the field operator performed a verbal repeat-back of the switching instruction to the control room operator prior to execution, as required by NERC operating procedures for safe switching.' ;
    rdfs:domain ind:SwitchingStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:safetyTagNumber rdf:type rdf:Property ;
    rdfs:label 'Safety Tag Number' ;
    rdfs:comment 'The unique identifier of the safety tag (hold tag, caution tag, or danger tag) associated with this switching step. Required for lockout/tagout (LOTO) compliance tracking and personnel protection verification.' ;
    rdfs:domain ind:SwitchingStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:safetyTagRequired rdf:type rdf:Property ;
    rdfs:label 'Safety Tag Required' ;
    rdfs:comment 'Indicates whether a safety tag (hold tag, caution tag, or danger tag) must be applied or verified before this switching step can be executed. Critical for personnel safety and OSHA compliance.' ;
    rdfs:domain ind:SwitchingStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:safetyTagType rdf:type rdf:Property ;
    rdfs:label 'Safety Tag Type' ;
    rdfs:comment 'Classification of the safety tag associated with this switching step. Distinguishes between hold tags (prohibit operation), caution tags (warn of hazard), danger tags (imminent hazard), and clearance tags (work authorization).' ;
    rdfs:domain ind:SwitchingStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scadaVerified rdf:type rdf:Property ;
    rdfs:label 'Scada Verified' ;
    rdfs:comment 'Indicates whether the device state change for this switching step was independently verified by the Supervisory Control and Data Acquisition (SCADA) system, providing automated confirmation beyond operator verbal report.' ;
    rdfs:domain ind:SwitchingStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scheduledExecutionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Scheduled Execution Timestamp' ;
    rdfs:comment 'The planned date and time at which this switching step is scheduled to be executed, as defined in the approved switching order. Used for outage coordination and crew scheduling.' ;
    rdfs:domain ind:SwitchingStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sourceSystemStepReference rdf:type rdf:Property ;
    rdfs:label 'Source System Step Reference' ;
    rdfs:comment 'The native identifier of this switching step record in the originating operational system (GE PowerOn DMS/OMS). Preserves the source system key for data lineage, reconciliation, and cross-system traceability in the Silver Layer.' ;
    rdfs:domain ind:SwitchingStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stepInstruction rdf:type rdf:Property ;
    rdfs:label 'Step Instruction' ;
    rdfs:comment 'Detailed written instruction describing the exact action to be performed in this switching step, including device location, access method, and any special precautions. Provides the field operator with unambiguous direction.' ;
    rdfs:domain ind:SwitchingStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stepNotes rdf:type rdf:Property ;
    rdfs:label 'Step Notes' ;
    rdfs:comment 'Free-text field for operator notes, observations, or deviations recorded at the time of step execution. Captures field conditions, anomalies, or explanations for skipped or failed steps.' ;
    rdfs:domain ind:SwitchingStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stepNumber rdf:type rdf:Property ;
    rdfs:label 'Step Number' ;
    rdfs:comment 'Sequential position of this switching step within the parent switching order. Defines the mandatory execution order of discrete switching actions to ensure safe and correct grid reconfiguration.' ;
    rdfs:domain ind:SwitchingStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:stepStatus rdf:type rdf:Property ;
    rdfs:label 'Step Status' ;
    rdfs:comment 'Current execution lifecycle state of this individual switching step. Tracks whether the step is awaiting execution, actively being performed, successfully completed, skipped per approved deviation, failed, or cancelled.' ;
    rdfs:domain ind:SwitchingStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stepType rdf:type rdf:Property ;
    rdfs:label 'Step Type' ;
    rdfs:comment 'Classifies the nature of this switching step within the overall switching plan. Primary steps are the core switching actions; contingency steps are alternatives; restoration steps return the grid to normal; verification steps confirm device state; notification steps record required communications.' ;
    rdfs:domain ind:SwitchingStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:switchingPurpose rdf:type rdf:Property ;
    rdfs:label 'Switching Purpose' ;
    rdfs:comment 'The operational reason or purpose for which this switching step is being performed. Classifies the switching activity to support reliability reporting, outage analysis, and regulatory compliance categorization. [ENUM-REF-CANDIDATE: planned_maintenance|emergency_restoration|load_transfer|fault_isolation|construction|testing — promote to reference product if additional values are needed]' ;
    rdfs:domain ind:SwitchingStep ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transmissionLimitId rdf:type rdf:Property ;
    rdfs:label 'Transmission Limit Id' ;
    rdfs:comment 'Unique identifier for the transmission limit record. Primary key for this entity.' ;
    rdfs:domain ind:TransmissionLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dynamicRatingEnabled rdf:type rdf:Property ;
    rdfs:label 'Dynamic Rating Enabled' ;
    rdfs:comment 'Indicates whether dynamic line rating (real-time adjustment based on weather and conductor temperature) is enabled for this facility. True if enabled, False otherwise.' ;
    rdfs:domain ind:TransmissionLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:emergencyRating15minMva rdf:type rdf:Property ;
    rdfs:label 'Emergency Rating 15min Mva' ;
    rdfs:comment 'Short-term emergency rating in MVA that the facility can sustain for up to 15 minutes without damage, used during contingency conditions.' ;
    rdfs:domain ind:TransmissionLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:emergencyRating4hrMva rdf:type rdf:Property ;
    rdfs:label 'Emergency Rating 4hr Mva' ;
    rdfs:comment 'Long-term emergency rating in MVA that the facility can sustain for up to 4 hours, typically used for post-contingency load relief operations.' ;
    rdfs:domain ind:TransmissionLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:emsLimitCode rdf:type rdf:Property ;
    rdfs:label 'Ems Limit Code' ;
    rdfs:comment 'Identifier of this limit record in the Energy Management System (EMS) used for real-time security analysis and dispatch.' ;
    rdfs:domain ind:TransmissionLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitNotes rdf:type rdf:Property ;
    rdfs:label 'Limit Notes' ;
    rdfs:comment 'Free-text notes providing additional context, operational instructions, or special conditions related to this transmission limit.' ;
    rdfs:domain ind:TransmissionLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitSource rdf:type rdf:Property ;
    rdfs:label 'Limit Source' ;
    rdfs:comment 'Origin of the limit value: thermal analysis, voltage analysis, stability study, manufacturer equipment rating, field test measurement, or engineering judgment.' ;
    rdfs:domain ind:TransmissionLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitStatus rdf:type rdf:Property ;
    rdfs:label 'Limit Status' ;
    rdfs:comment 'Current lifecycle status of the limit record: active (enforced in EMS), inactive, suspended (temporarily not enforced), pending approval, or retired.' ;
    rdfs:domain ind:TransmissionLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitType rdf:type rdf:Property ;
    rdfs:label 'Limit Type' ;
    rdfs:comment 'Physical constraint type: thermal (conductor heating), voltage (bus voltage deviation), stability (transient/voltage/oscillatory stability limits).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loadDumpRatingMva rdf:type rdf:Property ;
    rdfs:label 'Load Dump Rating Mva' ;
    rdfs:comment 'Maximum load that can be shed or transferred through this facility during emergency load dump or load shedding operations.' ;
    rdfs:domain ind:TransmissionLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:normalRatingMva rdf:type rdf:Property ;
    rdfs:label 'Normal Rating Mva' ;
    rdfs:comment 'Continuous normal operating limit in megavolt-amperes (MVA) under normal ambient and system conditions. This is the baseline thermal or transfer capability limit.' ;
    rdfs:domain ind:TransmissionLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:normalRatingMw rdf:type rdf:Property ;
    rdfs:label 'Normal Rating Mw' ;
    rdfs:comment 'Continuous normal operating limit in megawatts (MW) for real power transfer. Used for flowgates and interfaces where MW is the primary constraint metric.' ;
    rdfs:domain ind:TransmissionLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scadaMonitored rdf:type rdf:Property ;
    rdfs:label 'Scada Monitored' ;
    rdfs:comment 'Indicates whether this transmission limit is actively monitored in real-time via SCADA telemetry. True if monitored, False otherwise.' ;
    rdfs:domain ind:TransmissionLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:seasonCode rdf:type rdf:Property ;
    rdfs:label 'Season Code' ;
    rdfs:comment 'Season during which this limit applies: summer, winter, spring, fall, or year-round. Seasonal limits reflect ambient temperature and load pattern variations.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seasonalAdjustmentFactor rdf:type rdf:Property ;
    rdfs:label 'Seasonal Adjustment Factor' ;
    rdfs:comment 'Multiplier applied to base ratings to account for seasonal ambient temperature variations (e.g., summer de-rating, winter up-rating). Typically ranges from 0.8 to 1.2.' ;
    rdfs:domain ind:TransmissionLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:studyReference rdf:type rdf:Property ;
    rdfs:label 'Study Reference' ;
    rdfs:comment 'Reference identifier or document name of the engineering study (thermal, voltage, or stability study) that established this limit.' ;
    rdfs:domain ind:TransmissionLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:voltageLimitHighKv rdf:type rdf:Property ;
    rdfs:label 'Voltage Limit High Kv' ;
    rdfs:comment 'Upper voltage limit in kilovolts (kV) for voltage-constrained facilities. Exceeding this limit may cause equipment damage or system instability.' ;
    rdfs:domain ind:TransmissionLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:voltageLimitLowKv rdf:type rdf:Property ;
    rdfs:label 'Voltage Limit Low Kv' ;
    rdfs:comment 'Lower voltage limit in kilovolts (kV) for voltage-constrained facilities. Falling below this limit may cause voltage collapse or equipment malfunction.' ;
    rdfs:domain ind:TransmissionLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:voltageControlActionId rdf:type rdf:Property ;
    rdfs:label 'Voltage Control Action Id' ;
    rdfs:comment 'Unique identifier for the voltage control action record.' ;
    rdfs:domain ind:VoltageControlAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:approverId rdf:type rdf:Property ;
    rdfs:label 'Approver Id' ;
    rdfs:comment 'Reference to the supervisor or reliability coordinator who approved the voltage control action. Null if no approval was required.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:emsDispatchInstructionId rdf:type rdf:Property ;
    rdfs:label 'Ems Dispatch Ems Dispatch Instruction Id' ;
    rdfs:comment 'The dispatch instruction identifier from the Energy Management System that authorized or triggered this voltage control action.' ;
    rdfs:domain ind:VoltageControlAction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EmsDispatchInstruction .

ind:outageGridopsOutageEventId rdf:type rdf:Property ;
    rdfs:label 'Outage Gridops Outage Event Id' ;
    rdfs:comment 'Reference to an outage record if this voltage control action was related to outage management or restoration activities.' ;
    rdfs:domain ind:VoltageControlAction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GridopsOutageEvent .

ind:primaryVoltageEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Voltage Employee Id' ;
    rdfs:comment 'Reference to the grid operator who initiated the manual voltage control action. Null if action was automated.' ;
    rdfs:domain ind:VoltageControlAction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:verifiedByOperatorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Verified By Operator Employee Id' ;
    rdfs:comment 'Reference to the operator who verified the successful completion and effectiveness of the voltage control action.' ;
    rdfs:domain ind:VoltageControlAction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:actionDurationSeconds rdf:type rdf:Property ;
    rdfs:label 'Action Duration Seconds' ;
    rdfs:comment 'The time in seconds from action initiation to completion or failure.' ;
    rdfs:domain ind:VoltageControlAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actionMode rdf:type rdf:Property ;
    rdfs:label 'Action Mode' ;
    rdfs:comment 'Indicates whether the voltage control action was initiated manually by an operator, automatically by control system, scheduled as part of planned operations, or triggered by emergency conditions.' ;
    rdfs:domain ind:VoltageControlAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionNotes rdf:type rdf:Property ;
    rdfs:label 'Action Notes' ;
    rdfs:comment 'Free-text notes or comments entered by the operator or system regarding the voltage control action, including justification, observations, or special circumstances.' ;
    rdfs:domain ind:VoltageControlAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionPriority rdf:type rdf:Property ;
    rdfs:label 'Action Priority' ;
    rdfs:comment 'The operational priority level assigned to the voltage control action based on the severity of the voltage deviation and potential impact on grid reliability.' ;
    rdfs:domain ind:VoltageControlAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionStatus rdf:type rdf:Property ;
    rdfs:label 'Action Status' ;
    rdfs:comment 'The execution status of the voltage control action indicating whether it completed successfully, failed, partially completed, was aborted, or is pending verification.' ;
    rdfs:domain ind:VoltageControlAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvalRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Approval Required Flag' ;
    rdfs:comment 'Boolean indicator of whether the voltage control action required supervisory or reliability coordinator approval before execution.' ;
    rdfs:domain ind:VoltageControlAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:automationSystemSource rdf:type rdf:Property ;
    rdfs:label 'Automation System Source' ;
    rdfs:comment 'The name or identifier of the automated control system that initiated the voltage control action (e.g., DMS, DERMS, voltage regulator controller). Null if action was manual.' ;
    rdfs:domain ind:VoltageControlAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capacitorBankMvar rdf:type rdf:Property ;
    rdfs:label 'Capacitor Bank Mvar' ;
    rdfs:comment 'The reactive power rating in megavolt-amperes reactive of the capacitor bank that was switched. Null if action did not involve a capacitor bank.' ;
    rdfs:domain ind:VoltageControlAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:controlAlgorithm rdf:type rdf:Property ;
    rdfs:label 'Control Algorithm' ;
    rdfs:comment 'The name or identifier of the control algorithm or logic used to determine the voltage control action (e.g., volt-var optimization, conservation voltage reduction, local voltage control). Null if action was manual.' ;
    rdfs:domain ind:VoltageControlAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:generationAtActionMw rdf:type rdf:Property ;
    rdfs:label 'Generation At Action Mw' ;
    rdfs:comment 'The total real power generation in megawatts at the target bus or substation at the time the voltage control action was executed.' ;
    rdfs:domain ind:VoltageControlAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:initiatingCondition rdf:type rdf:Property ;
    rdfs:label 'Initiating Condition' ;
    rdfs:comment 'The operational condition or event that triggered the need for voltage control action.' ;
    rdfs:domain ind:VoltageControlAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loadAtActionMw rdf:type rdf:Property ;
    rdfs:label 'Load At Action Mw' ;
    rdfs:comment 'The total real power load in megawatts at the target bus or substation at the time the voltage control action was executed.' ;
    rdfs:domain ind:VoltageControlAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:postActionVoltageKv rdf:type rdf:Property ;
    rdfs:label 'Post Action Voltage Kv' ;
    rdfs:comment 'The voltage level in kilovolts measured at the target bus immediately after the control action was executed.' ;
    rdfs:domain ind:VoltageControlAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:powerFactorPostAction rdf:type rdf:Property ;
    rdfs:label 'Power Factor Post Action' ;
    rdfs:comment 'The power factor measured at the target bus immediately after the voltage control action was executed. Value ranges from -1.0 to 1.0.' ;
    rdfs:domain ind:VoltageControlAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:powerFactorPreAction rdf:type rdf:Property ;
    rdfs:label 'Power Factor Pre Action' ;
    rdfs:comment 'The power factor measured at the target bus immediately before the voltage control action was executed. Value ranges from -1.0 to 1.0.' ;
    rdfs:domain ind:VoltageControlAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preActionVoltageKv rdf:type rdf:Property ;
    rdfs:label 'Pre Action Voltage Kv' ;
    rdfs:comment 'The voltage level in kilovolts measured at the target bus immediately before the control action was executed.' ;
    rdfs:domain ind:VoltageControlAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reactivePowerChangeMvar rdf:type rdf:Property ;
    rdfs:label 'Reactive Power Change Mvar' ;
    rdfs:comment 'The change in reactive power in megavolt-amperes reactive resulting from the voltage control action. Positive values indicate reactive power injection, negative values indicate absorption.' ;
    rdfs:domain ind:VoltageControlAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reactorMvar rdf:type rdf:Property ;
    rdfs:label 'Reactor Mvar' ;
    rdfs:comment 'The reactive power rating in megavolt-amperes reactive of the reactor that was switched. Null if action did not involve a reactor.' ;
    rdfs:domain ind:VoltageControlAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tapPositionChange rdf:type rdf:Property ;
    rdfs:label 'Tap Position Change' ;
    rdfs:comment 'The number of tap positions changed on a tap changer device. Positive values indicate raise operations, negative values indicate lower operations. Null if action did not involve a tap changer.' ;
    rdfs:domain ind:VoltageControlAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:targetVoltageKv rdf:type rdf:Property ;
    rdfs:label 'Target Voltage Kv' ;
    rdfs:comment 'The desired voltage level in kilovolts that the control action was intended to achieve at the target bus.' ;
    rdfs:domain ind:VoltageControlAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:voltageDeviationPercent rdf:type rdf:Property ;
    rdfs:label 'Voltage Deviation Percent' ;
    rdfs:comment 'The percentage deviation of pre-action voltage from the nominal voltage level, calculated as ((pre_action_voltage - nominal_voltage) / nominal_voltage) * 100.' ;
    rdfs:domain ind:VoltageControlAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:voltageProfileComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Voltage Profile Compliance Flag' ;
    rdfs:comment 'Boolean indicator of whether the post-action voltage level is within the acceptable voltage profile limits defined by regulatory standards and operational procedures.' ;
    rdfs:domain ind:VoltageControlAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cloudCoverPct rdf:type rdf:Property ;
    rdfs:label 'Cloud Cover Pct' ;
    rdfs:comment 'Forecasted fraction of sky covered by clouds, expressed as a percentage.' ;
    rdfs:domain ind:WeatherForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dewPointC rdf:type rdf:Property ;
    rdfs:label 'Dew Point C' ;
    rdfs:comment 'Forecasted dew point temperature in degrees Celsius.' ;
    rdfs:domain ind:WeatherForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forecastConfidenceScore rdf:type rdf:Property ;
    rdfs:label 'Forecast Confidence Score' ;
    rdfs:comment 'Numerical confidence rating (0-100) assigned by the model to the forecast.' ;
    rdfs:domain ind:WeatherForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forecastHorizonHours rdf:type rdf:Property ;
    rdfs:label 'Forecast Horizon Hours' ;
    rdfs:comment 'Number of hours ahead that the forecast covers.' ;
    rdfs:domain ind:WeatherForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:forecastTimestamp rdf:type rdf:Property ;
    rdfs:label 'Forecast Timestamp' ;
    rdfs:comment 'Date and time for which the forecast values are applicable.' ;
    rdfs:domain ind:WeatherForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:humidityAdjustmentFactor rdf:type rdf:Property ;
    rdfs:label 'Humidity Adjustment Factor' ;
    rdfs:comment 'Numeric factor used to modify forecast values for humidity influences.' ;
    rdfs:domain ind:WeatherForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:humidityPct rdf:type rdf:Property ;
    rdfs:label 'Humidity Pct' ;
    rdfs:comment 'Forecasted relative humidity as a percentage.' ;
    rdfs:domain ind:WeatherForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isAdjustedForHumidity rdf:type rdf:Property ;
    rdfs:label 'Is Adjusted For Humidity' ;
    rdfs:comment 'Indicates whether humidity-based corrections were applied (true/false).' ;
    rdfs:domain ind:WeatherForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isAdjustedForTerrain rdf:type rdf:Property ;
    rdfs:label 'Is Adjusted For Terrain' ;
    rdfs:comment 'Indicates whether terrain effects were applied to the forecast (true/false).' ;
    rdfs:domain ind:WeatherForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isAdjustedForTimeOfDay rdf:type rdf:Property ;
    rdfs:label 'Is Adjusted For Time Of Day' ;
    rdfs:comment 'Indicates whether diurnal effects were applied to the forecast (true/false).' ;
    rdfs:domain ind:WeatherForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:precipitationInches rdf:type rdf:Property ;
    rdfs:label 'Precipitation Inches' ;
    rdfs:comment 'Forecasted total precipitation depth in inches.' ;
    rdfs:domain ind:WeatherForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pressureHpa rdf:type rdf:Property ;
    rdfs:label 'Pressure Hpa' ;
    rdfs:comment 'Forecasted sea-level atmospheric pressure in hectopascals.' ;
    rdfs:domain ind:WeatherForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:probabilityOfPrecipitationPct rdf:type rdf:Property ;
    rdfs:label 'Probability Of Precipitation Pct' ;
    rdfs:comment 'Forecasted likelihood of precipitation expressed as a percentage.' ;
    rdfs:domain ind:WeatherForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recordCreatedDate rdf:type rdf:Property ;
    rdfs:label 'Record Created Date' ;
    rdfs:comment 'Calendar date when the forecast record was first stored in the lakehouse.' ;
    rdfs:domain ind:WeatherForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:severeWeatherFlag rdf:type rdf:Property ;
    rdfs:label 'Severe Weather Flag' ;
    rdfs:comment 'Indicates whether the forecast includes any severe weather conditions (true/false).' ;
    rdfs:domain ind:WeatherForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:solarRadiationWM2 rdf:type rdf:Property ;
    rdfs:label 'Solar Radiation W M2' ;
    rdfs:comment 'Forecasted solar irradiance in watts per square meter.' ;
    rdfs:domain ind:WeatherForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:terrainAdjustmentFactor rdf:type rdf:Property ;
    rdfs:label 'Terrain Adjustment Factor' ;
    rdfs:comment 'Numeric factor used to modify forecast values for terrain influences.' ;
    rdfs:domain ind:WeatherForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:timeOfDayAdjustmentFactor rdf:type rdf:Property ;
    rdfs:label 'Time Of Day Adjustment Factor' ;
    rdfs:comment 'Numeric factor used to modify forecast values for time-of-day influences.' ;
    rdfs:domain ind:WeatherForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:uvIndex rdf:type rdf:Property ;
    rdfs:label 'Uv Index' ;
    rdfs:comment 'Forecasted ultraviolet index indicating sunburn risk.' ;
    rdfs:domain ind:WeatherForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:visibilityMi rdf:type rdf:Property ;
    rdfs:label 'Visibility Mi' ;
    rdfs:comment 'Forecasted horizontal visibility distance in miles.' ;
    rdfs:domain ind:WeatherForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:windDirectionDeg rdf:type rdf:Property ;
    rdfs:label 'Wind Direction Deg' ;
    rdfs:comment 'Forecasted wind direction expressed as degrees from true north.' ;
    rdfs:domain ind:WeatherForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:intervalReadId rdf:type rdf:Property ;
    rdfs:label 'Interval Read Id' ;
    rdfs:comment 'System-generated unique identifier for each interval read record.' ;
    rdfs:domain ind:IntervalRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:geographicLocationId rdf:type rdf:Property ;
    rdfs:label 'Geographic Location Id' ;
    rdfs:comment 'Reference to the location entity where the meter is installed.' ;
    rdfs:domain ind:IntervalRead ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Location .

ind:registerId rdf:type rdf:Property ;
    rdfs:label 'Register Id' ;
    rdfs:comment 'Foreign key linking to metering.register. Business justification: Interval reads are captured per register; adding register_id creates the correct child-to-parent link and removes the redundant meter_id.' ;
    rdfs:domain ind:Metering ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Register .

ind:channelNumber rdf:type rdf:Property ;
    rdfs:label 'Channel Number' ;
    rdfs:comment 'Channel on the meter that produced this reading (e.g., 1 for net kWh, 2 for reactive kVAR).' ;
    rdfs:domain ind:IntervalRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:consumptionDirection rdf:type rdf:Property ;
    rdfs:label 'Consumption Direction' ;
    rdfs:comment 'Specifies if the energy was delivered to the customer or received from the customer (e.g., net-metering).' ;
    rdfs:domain ind:IntervalRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctedValue rdf:type rdf:Property ;
    rdfs:label 'Corrected Value' ;
    rdfs:comment 'Adjusted value after VEE processing, if different from raw.' ;
    rdfs:domain ind:IntervalRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:correctionReason rdf:type rdf:Property ;
    rdfs:label 'Correction Reason' ;
    rdfs:comment 'Free-text explanation for any adjustment applied to the raw reading.' ;
    rdfs:domain ind:IntervalRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cumulativeReading rdf:type rdf:Property ;
    rdfs:label 'Cumulative Reading' ;
    rdfs:comment 'Running total of the measured quantity up to the end of this interval.' ;
    rdfs:domain ind:IntervalRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:demandKvar rdf:type rdf:Property ;
    rdfs:label 'Demand Kvar' ;
    rdfs:comment 'Instantaneous reactive power demand for the interval, when applicable.' ;
    rdfs:domain ind:IntervalRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:demandKw rdf:type rdf:Property ;
    rdfs:label 'Demand Kw' ;
    rdfs:comment 'Instantaneous active power demand for the interval, when applicable.' ;
    rdfs:domain ind:IntervalRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deviceSerial rdf:type rdf:Property ;
    rdfs:label 'Device Serial' ;
    rdfs:comment 'Manufacturer-assigned serial number of the AMI device.' ;
    rdfs:domain ind:IntervalRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimationMethod rdf:type rdf:Property ;
    rdfs:label 'Estimation Method' ;
    rdfs:comment 'Algorithm used when the reading is estimated.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:intervalEnd rdf:type rdf:Property ;
    rdfs:label 'Interval End' ;
    rdfs:comment 'End of the measurement interval.' ;
    rdfs:domain ind:Metering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:intervalReadStatus rdf:type rdf:Property ;
    rdfs:label 'Interval Read Status' ;
    rdfs:comment 'Current lifecycle state of the interval record.' ;
    rdfs:domain ind:IntervalRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:intervalSequence rdf:type rdf:Property ;
    rdfs:label 'Interval Sequence' ;
    rdfs:comment 'Ordinal position of the interval within a day (e.g., 1-96 for 15-min intervals).' ;
    rdfs:domain ind:IntervalRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:intervalStart rdf:type rdf:Property ;
    rdfs:label 'Interval Start' ;
    rdfs:comment 'Start of the measurement interval.' ;
    rdfs:domain ind:Metering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:isMissing rdf:type rdf:Property ;
    rdfs:label 'Is Missing' ;
    rdfs:comment 'True if no measurement was captured for the interval.' ;
    rdfs:domain ind:IntervalRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:loadProfileCode rdf:type rdf:Property ;
    rdfs:label 'Load Profile Code' ;
    rdfs:comment 'Code indicating the tariff profile applied to the reading (Time-of-Use, Real-Time Pricing, Critical Peak Pricing).' ;
    rdfs:domain ind:IntervalRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readType rdf:type rdf:Property ;
    rdfs:label 'Read Type' ;
    rdfs:comment 'Indicates whether the value is a direct measurement or an estimate.' ;
    rdfs:domain ind:Metering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readingSequence rdf:type rdf:Property ;
    rdfs:label 'Reading Sequence' ;
    rdfs:comment 'Monotonically increasing sequence to preserve ordering of reads for a meter.' ;
    rdfs:domain ind:Metering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:readingValue rdf:type rdf:Property ;
    rdfs:label 'Reading Value' ;
    rdfs:comment 'Unadjusted measurement value captured from the meter.' ;
    rdfs:domain ind:IntervalRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tariffCode rdf:type rdf:Property ;
    rdfs:label 'Tariff Code' ;
    rdfs:comment 'Identifier of the rate schedule governing this interval.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:installerTechnicianId rdf:type rdf:Property ;
    rdfs:label 'Installer Technician Id' ;
    rdfs:comment 'Foreign key linking to workforce.technician. Business justification: Installation Process: records which technician installed the meter for warranty, compliance, and asset-management reporting.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Technician .

ind:accuracyClass rdf:type rdf:Property ;
    rdfs:label 'Accuracy Class' ;
    rdfs:comment 'ANSI accuracy classification indicating maximum allowable measurement error as a percentage of full scale. Lower numbers indicate higher precision. Determines testing frequency and revenue-grade certification requirements.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ctRatio rdf:type rdf:Property ;
    rdfs:label 'Ct Ratio' ;
    rdfs:comment 'Current transformer ratio for instrument-rated meters (e.g., 200:5, 400:5). Used to calculate actual consumption from meter readings. Null for self-contained meters. Critical for accurate billing calculations.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currentRatingAmps rdf:type rdf:Property ;
    rdfs:label 'Current Rating Amps' ;
    rdfs:comment 'Maximum continuous current rating of the electric meter in amperes. Determines meter capacity and must align with service entrance equipment ratings. Used for load analysis and meter sizing validation.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:demandMeteringEnabled rdf:type rdf:Property ;
    rdfs:label 'Demand Metering Enabled' ;
    rdfs:comment 'Indicates whether the meter measures and records peak demand (kW) in addition to energy consumption (kWh). Required for commercial/industrial rate structures with demand charges. Determines billing calculation logic.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:expectedLifeYears rdf:type rdf:Property ;
    rdfs:label 'Expected Life Years' ;
    rdfs:comment 'Estimated useful life of the meter asset in years for depreciation and replacement planning. Typically 15-30 years depending on technology and service class. Used for capital planning and rate case filings.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:firmwareVersion rdf:type rdf:Property ;
    rdfs:label 'Firmware Version' ;
    rdfs:comment 'Current firmware version installed on the meter device. Critical for security patch management, feature enablement, and compatibility with MDM system. Format varies by manufacturer.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:form rdf:type rdf:Property ;
    rdfs:label 'Form' ;
    rdfs:comment 'ANSI standard form designation indicating meter socket configuration and wiring arrangement (e.g., Form 2S, Form 12S, Form 16S). Determines physical installation requirements and measurement capabilities.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:installationStatus rdf:type rdf:Property ;
    rdfs:label 'Installation Status' ;
    rdfs:comment 'Current physical deployment state of the meter asset. Installed indicates active field deployment. In_stock indicates warehouse inventory. In_shop indicates repair/testing. Retired indicates end-of-life but not yet disposed.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastCommunicationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Communication Timestamp' ;
    rdfs:comment 'Timestamp of most recent successful data exchange between the meter and the MDM headend system. Used for communication health monitoring, outage detection, and data quality assessment.' ;
    rdfs:domain ind:Metering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:meterClass rdf:type rdf:Property ;
    rdfs:label 'Meter Class' ;
    rdfs:comment 'Customer service class designation for the meter installation. Determines applicable tariffs, demand response eligibility, and regulatory rate class assignment.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:multiplier rdf:type rdf:Property ;
    rdfs:label 'Multiplier' ;
    rdfs:comment 'Numeric multiplier applied to meter register readings to calculate actual consumption. Derived from CT/PT ratios and meter configuration. Essential for accurate billing and energy accounting.' ;
    rdfs:domain ind:Metering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netMeteringEnabled rdf:type rdf:Property ;
    rdfs:label 'Net Metering Enabled' ;
    rdfs:comment 'Indicates whether the meter supports bidirectional energy measurement for customer-owned generation (solar, wind). True for NEM-eligible installations. Requires meter capable of measuring both delivered and received energy.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nextTestDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Test Due Date' ;
    rdfs:comment 'Scheduled date for next required accuracy test or recertification. Calculated based on last test date and regulatory testing interval. Used for compliance tracking and preventive maintenance scheduling.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:numberOfDials rdf:type rdf:Property ;
    rdfs:label 'Number Of Dials' ;
    rdfs:comment 'Count of mechanical register dials on the meter face for manual reading. Determines reading format and maximum register capacity. Typically 4-6 dials for residential, more for commercial/industrial.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ptRatio rdf:type rdf:Property ;
    rdfs:label 'Pt Ratio' ;
    rdfs:comment 'Potential transformer ratio for high-voltage metering installations (e.g., 7200:120). Used with CT ratio to calculate actual energy consumption. Null for low-voltage self-contained meters.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:purchaseCost rdf:type rdf:Property ;
    rdfs:label 'Purchase Cost' ;
    rdfs:comment 'Original acquisition cost of the meter device in USD. Used for asset capitalization, depreciation calculations, and rate base reporting. Includes device cost only, not installation labor.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:purchaseDate rdf:type rdf:Property ;
    rdfs:label 'Purchase Date' ;
    rdfs:comment 'Date the utility acquired the meter from the manufacturer or vendor. Used for warranty tracking, depreciation calculations, and procurement analytics. May differ from installation date.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:readCycle rdf:type rdf:Property ;
    rdfs:label 'Read Cycle' ;
    rdfs:comment 'Billing cycle designation indicating when the meter is read each month (e.g., cycle 01 = 1st-5th of month). Used for billing schedule coordination and read validation. Typically 20-30 cycles per service territory.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registerCapacityKwh rdf:type rdf:Property ;
    rdfs:label 'Register Capacity Kwh' ;
    rdfs:comment 'Maximum cumulative energy value the meter register can display before rolling over to zero. Used to detect and correct rollover events in consumption calculations. Measured in kilowatt-hours for electric meters.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:remoteDisconnectCapable rdf:type rdf:Property ;
    rdfs:label 'Remote Disconnect Capable' ;
    rdfs:comment 'Indicates whether the meter has an integrated service switch that can be remotely controlled to connect or disconnect service. Used for credit management, move-in/move-out automation, and emergency load shedding.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:removalDate rdf:type rdf:Property ;
    rdfs:label 'Removal Date' ;
    rdfs:comment 'Date the meter was removed from service at a premise. Null for currently installed meters. Used for lifecycle tracking, final billing, and asset disposition workflows.' ;
    rdfs:domain ind:Metering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:routeCode rdf:type rdf:Property ;
    rdfs:label 'Route Code' ;
    rdfs:comment 'Geographic route assignment for manual meter reading or field inspection. Used for workforce scheduling and route optimization. May be null for AMI meters with automated reading.' ;
    rdfs:domain ind:Metering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sealNumber rdf:type rdf:Property ;
    rdfs:label 'Seal Number' ;
    rdfs:comment 'Unique identifier of the tamper-evident seal applied to the meter enclosure. Used to detect unauthorized access, meter tampering, and theft of service. Recorded during installation and verified during field inspections.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testDate rdf:type rdf:Property ;
    rdfs:label 'Test Date' ;
    rdfs:comment 'Date of most recent accuracy test or calibration performed on the meter. Used to schedule periodic testing per regulatory requirements and manufacturer recommendations. Typically required every 5-15 years depending on jurisdiction.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:timeOfUseEnabled rdf:type rdf:Property ;
    rdfs:label 'Time Of Use Enabled' ;
    rdfs:comment 'Indicates whether the meter is configured to collect interval data for time-differentiated rate structures. True for meters supporting TOU, CPP, or RTP rates. Requires AMI technology and MDM interval data processing.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:meterConfigurationId rdf:type rdf:Property ;
    rdfs:label 'Meter Configuration Id' ;
    rdfs:comment 'Unique surrogate key for each meter configuration record.' ;
    rdfs:domain ind:MeterConfiguration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:touScheduleId rdf:type rdf:Property ;
    rdfs:label 'Tou Schedule Id' ;
    rdfs:comment 'Reference to the Time-of-Use schedule applied by this configuration.' ;
    rdfs:domain ind:Metering ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TouSchedule .

ind:configCode rdf:type rdf:Property ;
    rdfs:label 'Config Code' ;
    rdfs:comment 'Business identifier code for the configuration profile.' ;
    rdfs:domain ind:MeterConfiguration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:configName rdf:type rdf:Property ;
    rdfs:label 'Config Name' ;
    rdfs:comment 'Human-readable name for the configuration profile.' ;
    rdfs:domain ind:MeterConfiguration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:configType rdf:type rdf:Property ;
    rdfs:label 'Config Type' ;
    rdfs:comment 'Category of rate structure the configuration supports (e.g., Time-of-Use, Real-Time Pricing, Critical Peak Pricing).' ;
    rdfs:domain ind:MeterConfiguration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:demandIntervalLengthMinutes rdf:type rdf:Property ;
    rdfs:label 'Demand Interval Length Minutes' ;
    rdfs:comment 'Length of the demand measurement interval used for demand-side analytics.' ;
    rdfs:domain ind:MeterConfiguration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:intervalLengthMinutes rdf:type rdf:Property ;
    rdfs:label 'Interval Length Minutes' ;
    rdfs:comment 'Length of the measurement interval for energy consumption reads (e.g., 15, 30, 60).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastPushTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Push Timestamp' ;
    rdfs:comment 'Date-time when the configuration was last pushed to the meter.' ;
    rdfs:domain ind:MeterConfiguration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:loadProfileEnabled rdf:type rdf:Property ;
    rdfs:label 'Load Profile Enabled' ;
    rdfs:comment 'Indicates whether detailed load-profile recording is enabled.' ;
    rdfs:domain ind:MeterConfiguration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:meterConfigurationDescription rdf:type rdf:Property ;
    rdfs:label 'Meter Configuration Description' ;
    rdfs:comment 'Free-form text describing the purpose and details of the configuration.' ;
    rdfs:domain ind:MeterConfiguration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meterConfigurationStatus rdf:type rdf:Property ;
    rdfs:label 'Meter Configuration Status' ;
    rdfs:comment 'Current lifecycle status of the configuration.' ;
    rdfs:domain ind:MeterConfiguration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outageDetectionThreshold rdf:type rdf:Property ;
    rdfs:label 'Outage Detection Threshold' ;
    rdfs:comment 'Power threshold (in kilowatts) used to detect a potential outage.' ;
    rdfs:domain ind:MeterConfiguration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:remoteConnectEnabled rdf:type rdf:Property ;
    rdfs:label 'Remote Connect Enabled' ;
    rdfs:comment 'Indicates whether the meter can be remotely connected (energized) via the configuration.' ;
    rdfs:domain ind:MeterConfiguration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:remoteDisconnectEnabled rdf:type rdf:Property ;
    rdfs:label 'Remote Disconnect Enabled' ;
    rdfs:comment 'Indicates whether the meter can be remotely disconnected (de-energized) via the configuration.' ;
    rdfs:domain ind:MeterConfiguration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tamperDetectionEnabled rdf:type rdf:Property ;
    rdfs:label 'Tamper Detection Enabled' ;
    rdfs:comment 'Indicates whether tamper detection logic is active for the meter.' ;
    rdfs:domain ind:MeterConfiguration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:meterEventId rdf:type rdf:Property ;
    rdfs:label 'Meter Event Id' ;
    rdfs:comment 'Unique identifier for each meter event record.' ;
    rdfs:domain ind:MeterEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:batteryLevelPercent rdf:type rdf:Property ;
    rdfs:label 'Battery Level Percent' ;
    rdfs:comment 'Remaining battery charge expressed as a percentage.' ;
    rdfs:domain ind:MeterEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:errorCode rdf:type rdf:Property ;
    rdfs:label 'Error Code' ;
    rdfs:comment 'Standardized error identifier for processing failures.' ;
    rdfs:domain ind:MeterEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedFlag rdf:type rdf:Property ;
    rdfs:label 'Estimated Flag' ;
    rdfs:comment 'True if the event value was derived by estimation algorithms.' ;
    rdfs:domain ind:MeterEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:eventDescription rdf:type rdf:Property ;
    rdfs:label 'Event Description' ;
    rdfs:comment 'Detailed narrative describing the event context and any relevant observations.' ;
    rdfs:domain ind:MeterEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isTestEvent rdf:type rdf:Property ;
    rdfs:label 'Is Test Event' ;
    rdfs:comment 'True if the event originates from a test or simulation; otherwise false.' ;
    rdfs:domain ind:MeterEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:meterState rdf:type rdf:Property ;
    rdfs:label 'Meter State' ;
    rdfs:comment 'Current lifecycle state of the meter.' ;
    rdfs:domain ind:MeterEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:processingAttempts rdf:type rdf:Property ;
    rdfs:label 'Processing Attempts' ;
    rdfs:comment 'Count of processing retries due to failures or validation errors.' ;
    rdfs:domain ind:MeterEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:processingTimestamp rdf:type rdf:Property ;
    rdfs:label 'Processing Timestamp' ;
    rdfs:comment 'Date and time the event was ingested and processed.' ;
    rdfs:domain ind:Metering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:rawPayload rdf:type rdf:Property ;
    rdfs:label 'Raw Payload' ;
    rdfs:comment 'Unparsed JSON or binary string containing the original event data.' ;
    rdfs:domain ind:MeterEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolutionOutcome rdf:type rdf:Property ;
    rdfs:label 'Resolution Outcome' ;
    rdfs:comment 'Result of the event resolution process.' ;
    rdfs:domain ind:MeterEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:signalStrengthDbm rdf:type rdf:Property ;
    rdfs:label 'Signal Strength Dbm' ;
    rdfs:comment 'Measured radio signal strength of the meter at the time of the event.' ;
    rdfs:domain ind:MeterEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:meterPremiseId rdf:type rdf:Property ;
    rdfs:label 'Meter Premise Id' ;
    rdfs:comment 'Unique surrogate key for each meter-premise association record.' ;
    rdfs:domain ind:MeterPremise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:associationNumber rdf:type rdf:Property ;
    rdfs:label 'Association Number' ;
    rdfs:comment 'Business identifier for the meter-premise relationship, used in operational and regulatory reporting.' ;
    rdfs:domain ind:MeterPremise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:associationType rdf:type rdf:Property ;
    rdfs:label 'Association Type' ;
    rdfs:comment 'Classification of the relationship (e.g., primary service meter, secondary backup meter).' ;
    rdfs:domain ind:MeterPremise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastValidationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Validation Timestamp' ;
    rdfs:comment 'Timestamp of the most recent data validation run for this association.' ;
    rdfs:domain ind:Metering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:meterPremiseStatus rdf:type rdf:Property ;
    rdfs:label 'Meter Premise Status' ;
    rdfs:comment 'Current lifecycle status of the meter-premise association.' ;
    rdfs:domain ind:MeterPremise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meterStatus rdf:type rdf:Property ;
    rdfs:label 'Meter Status' ;
    rdfs:comment 'Current operational condition of the meter device.' ;
    rdfs:domain ind:MeterPremise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netMeteringRegister rdf:type rdf:Property ;
    rdfs:label 'Net Metering Register' ;
    rdfs:comment 'Specifies which register(s) capture net-metered energy.' ;
    rdfs:domain ind:MeterPremise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registerType rdf:type rdf:Property ;
    rdfs:label 'Register Type' ;
    rdfs:comment 'Type of register captured (total consumption, peak demand, off-peak, etc.).' ;
    rdfs:domain ind:Metering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meterReadScheduleId rdf:type rdf:Property ;
    rdfs:label 'Meter Read Schedule Id' ;
    rdfs:comment 'System-generated unique identifier for the meter read schedule record.' ;
    rdfs:domain ind:Metering ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MeterReadSchedule .

ind:estimatedWindowEnd rdf:type rdf:Property ;
    rdfs:label 'Estimated Window End' ;
    rdfs:comment 'End of the estimated time window for the read.' ;
    rdfs:domain ind:MeterReadSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:estimatedWindowStart rdf:type rdf:Property ;
    rdfs:label 'Estimated Window Start' ;
    rdfs:comment 'Start of the estimated time window during which the read should be completed.' ;
    rdfs:domain ind:MeterReadSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lastActualReadDate rdf:type rdf:Property ;
    rdfs:label 'Last Actual Read Date' ;
    rdfs:comment 'Date of the most recent successful manual or AMI read.' ;
    rdfs:domain ind:MeterReadSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastActualReadTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Actual Read Timestamp' ;
    rdfs:comment 'Timestamp of the most recent successful read.' ;
    rdfs:domain ind:MeterReadSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:meterCountInRoute rdf:type rdf:Property ;
    rdfs:label 'Meter Count In Route' ;
    rdfs:comment 'Number of meters associated with this schedule on the route.' ;
    rdfs:domain ind:MeterReadSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:meterReadScheduleDescription rdf:type rdf:Property ;
    rdfs:label 'Meter Read Schedule Description' ;
    rdfs:comment 'Free-form text describing the purpose or special notes for the schedule.' ;
    rdfs:domain ind:MeterReadSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meterReadScheduleStatus rdf:type rdf:Property ;
    rdfs:label 'Meter Read Schedule Status' ;
    rdfs:comment 'Current lifecycle status of the schedule.' ;
    rdfs:domain ind:MeterReadSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readFrequencyDays rdf:type rdf:Property ;
    rdfs:label 'Read Frequency Days' ;
    rdfs:comment 'Number of days between scheduled reads for this schedule.' ;
    rdfs:domain ind:MeterReadSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:readMethod rdf:type rdf:Property ;
    rdfs:label 'Read Method' ;
    rdfs:comment 'Method used to obtain the meter reading.' ;
    rdfs:domain ind:MeterReadSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readSequence rdf:type rdf:Property ;
    rdfs:label 'Read Sequence' ;
    rdfs:comment 'Ordinal position of this schedule within the assigned route.' ;
    rdfs:domain ind:MeterReadSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:scheduleCode rdf:type rdf:Property ;
    rdfs:label 'Schedule Code' ;
    rdfs:comment 'Business identifier code used in downstream systems to reference this schedule.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleName rdf:type rdf:Property ;
    rdfs:label 'Schedule Name' ;
    rdfs:comment 'Human-readable name describing the read schedule (e.g., "Residential Monthly Cycle").' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleType rdf:type rdf:Property ;
    rdfs:label 'Schedule Type' ;
    rdfs:comment 'Classification of the schedule frequency type (e.g., monthly, bi-monthly, daily, AMI).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduledReadDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Read Date' ;
    rdfs:comment 'Planned calendar date for the next meter read.' ;
    rdfs:domain ind:MeterReadSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:scheduledReadTimestamp rdf:type rdf:Property ;
    rdfs:label 'Scheduled Read Timestamp' ;
    rdfs:comment 'Exact timestamp when the read is expected to occur (used for AMI polling).' ;
    rdfs:domain ind:MeterReadSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:meterTestId rdf:type rdf:Property ;
    rdfs:label 'Meter Test Id' ;
    rdfs:comment 'Unique system-generated identifier for each meter accuracy test record.' ;
    rdfs:domain ind:MeterTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:accuracyFullLoadPercent rdf:type rdf:Property ;
    rdfs:label 'Accuracy Full Load Percent' ;
    rdfs:comment 'Measured accuracy percentage of the meter at full load conditions.' ;
    rdfs:domain ind:MeterTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:accuracyLightLoadPercent rdf:type rdf:Property ;
    rdfs:label 'Accuracy Light Load Percent' ;
    rdfs:comment 'Measured accuracy percentage of the meter at light load conditions.' ;
    rdfs:domain ind:MeterTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ambientHumidityPercent rdf:type rdf:Property ;
    rdfs:label 'Ambient Humidity Percent' ;
    rdfs:comment 'Relative humidity at the test site, expressed as a percentage.' ;
