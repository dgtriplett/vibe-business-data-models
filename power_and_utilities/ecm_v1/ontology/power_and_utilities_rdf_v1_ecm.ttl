    rdfs:range xsd:dateTime .

ind:capacityFactorPct rdf:type rdf:Property ;
    rdfs:label 'Capacity Factor Pct' ;
    rdfs:comment 'Actual energy produced divided by the maximum possible output over the period, expressed as a percentage.' ;
