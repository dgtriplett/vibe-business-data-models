ind:outageCountYear rdf:type rdf:Property ;
    rdfs:label 'Outage Count Year' ;
    rdfs:comment 'Number of recorded outages on the feeder in the most recent calendar year.' ;
    rdfs:domain ind:Feeder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:protectionDeviceId rdf:type rdf:Property ;
    rdfs:label 'Protection Device Id' ;
    rdfs:comment 'Identifier of the primary protective device (e.g., recloser, breaker) for the feeder.' ;
    rdfs:domain ind:Feeder ;
    rdf:type owl:DatatypeProperty ;
