# RDFS Schema for Business: Power and Utilities

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix ind: <http://datamodel.lakehouse.org/business/power_and_utilities#> .

# --- Root Business Class ---
ind:Business rdf:type rdfs:Class ;
    rdfs:label 'Business' ;
    rdfs:comment 'Root class for all business entities' .

# --- Specific Business: Power and Utilities ---
ind:UtilityCompany rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Business ;
    rdfs:label 'Power and Utilities' ;
    rdfs:comment 'I am an electric and gas utility with energy generation, transmission, and distribution to serve residential and commercial customers' .

# --- Domain Classes ---
ind:Generation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UtilityCompany ;
    rdfs:label 'Generation' ;
    rdfs:comment 'Owns all data related to electric power generation assets and operations across fossil fuel plants, nuclear facilities, and renewable energy sources (solar, wind, hydro). Tracks generation capacity (MW), energy output (MWh), unit performance, fuel consumption, heat rates, emissions, capacity factors, and plant availability. Supports IRP, LCOE analysis, and REC tracking. Integrates with OSIsoft PI Historian for real-time telemetry.' .

ind:Transmission rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UtilityCompany ;
    rdfs:label 'Transmission' ;
    rdfs:comment 'Manages the high-voltage bulk electric system (BES) including transmission lines, substations, transformers, and grid interconnections. Serves as the SSOT for transmission topology, line ratings, outage events, power flow data, and SCADA-sourced EMS telemetry. Supports FERC tariff compliance, RTO/ISO scheduling, LMP settlement inputs, and NERC CIP compliance.' .

ind:Distribution rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UtilityCompany ;
    rdfs:label 'Distribution' ;
    rdfs:comment 'Owns the medium- and low-voltage electric distribution network and natural gas pipeline distribution infrastructure delivering energy to end customers. Serves as the SSOT for circuit topology, feeder configurations, poles, transformers, service connections, DMS/OMS events, outage records, and SAIDI/SAIFI/CAIDI reliability metrics. Integrates with GE PowerOn DMS/OMS and Esri ArcGIS for geospatial network modeling.' .

ind:Gridops rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UtilityCompany ;
    rdfs:label 'Gridops' ;
    rdfs:comment 'Owns real-time and near-real-time grid operational data including SCADA monitoring, EMS dispatch, load forecasting, demand response (DR) dispatch, frequency regulation, voltage control, and outage management coordination. Manages balancing area control, switching orders, and reliability event logging. Integrates with OMS, DMS, PI Historian, and DERMS for operational intelligence.' .

ind:Metering rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UtilityCompany ;
    rdfs:label 'Metering' ;
    rdfs:comment 'Owns all meter asset records, AMI device configurations, interval read data, and meter data validation, estimation, and editing (VEE) workflows. Serves as the SSOT for meter-to-premise associations, register reads, interval energy data (kWh, MCF, Therms), meter events, and data quality. Managed through Oracle Utilities MDM. Supports TOU, RTP, and CPP rate structures and feeds billing with validated consumption.' .

ind:Customer rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UtilityCompany ;
    rdfs:label 'Customer' ;
    rdfs:comment 'Single source of truth for all customer identities serving residential, commercial, and industrial (RCI) segments. Manages customer profiles, service addresses, account relationships, premise and service point associations, enrollment lifecycle, contact preferences, and customer segmentation. Integrates with Oracle CC&B (CIS) and Salesforce CRM. Supports NEM, TOU, and DR program enrollment.' .

ind:Billing rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UtilityCompany ;
    rdfs:label 'Billing' ;
    rdfs:comment 'Single source of truth for all revenue transactions including invoice generation, rate schedule application, payment processing, adjustments, deposits, disputes, and collections. Manages residential and commercial billing cycles, TOU/CPP/RTP rate calculations, and revenue recognition per FASB ASC 980. Supports GRC and ROE reporting. Integrates with Oracle CC&B and SAP FI/CO for revenue posting.' .

ind:Trading rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UtilityCompany ;
    rdfs:label 'Trading' ;
    rdfs:comment 'Energy trading and risk management including wholesale power purchases, PPAs, REC transactions, DAM and RTM market participation, hedging strategies, portfolio optimization, and ancillary services. Manages trading positions, counterparty contracts, LMP-based settlements, mark-to-market valuations, and market exposure. Integrates with Allegro ETRM for position management and risk reporting.' .

ind:Asset rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UtilityCompany ;
    rdfs:label 'Asset' ;
    rdfs:comment 'Enterprise asset management serving as the SSOT for all physical infrastructure assets across generation, T&D, gas systems, substations, and field equipment. Manages asset registry, lifecycle status, condition metrics, depreciation schedules, maintenance work orders, inspections, and CAPEX planning. Integrates with Maximo EAM and Esri ArcGIS for geospatial asset tracking. Supports ISO 55000 compliance and RAB reporting.' .

ind:Workforce rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UtilityCompany ;
    rdfs:label 'Workforce' ;
    rdfs:comment 'Field workforce management including crew scheduling, dispatch, work assignment, mobile workforce coordination, labor tracking, and emergency storm response staffing. Manages technicians, lineworkers, meter readers, field service personnel, qualifications, certifications, and union agreements. Integrates with ClickSoftware WFM and SAP HR. Supports T&D construction, O&M crew dispatch, and OSHA safety training compliance.' .

ind:Supply rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UtilityCompany ;
    rdfs:label 'Supply' ;
    rdfs:comment 'Procurement and supply chain management for fuel (coal, natural gas, uranium), materials, equipment, and services. Manages vendor relationships, purchase orders, contracts, inventory, logistics, and supplier performance. Supports CAPEX project material staging, storm restoration inventory, and fuel supply chain for generation plants. Integrates with SAP MM for procurement operations.' .

ind:Der rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UtilityCompany ;
    rdfs:label 'Der' ;
    rdfs:comment 'Distributed energy resources management including rooftop solar, battery storage, EV charging infrastructure, microgrids, and customer-sited generation. Manages NEM programs, interconnection requests, DER aggregation, VPP coordination, and grid integration. Integrates with DERMS platforms for real-time DER visibility and dispatch optimization.' .

ind:Product rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UtilityCompany ;
    rdfs:label 'Product' ;
    rdfs:comment 'Owns the utility rate and service product catalog including electric and gas rate schedules, tariff riders, demand response programs, DER/NEM offerings, energy efficiency programs, and commercial service plans. Serves as the SSOT for rate code definitions, eligibility rules, TOU/CPP/RTP pricing structures, and program terms filed with state PUCs. Feeds billing rate engine and customer enrollment.' .

ind:Regulatory rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UtilityCompany ;
    rdfs:label 'Regulatory' ;
    rdfs:comment 'Owns all regulatory filing data, rate case documentation, tariff schedules, and compliance reporting submitted to FERC, NERC, state PUCs, EPA, and PHMSA. Manages CPCN filings, GRC dockets, IRP submissions, NERC CIP compliance evidence, and regulatory correspondence. Serves as the SSOT for approved rates, regulatory assets (RAB), and compliance obligation tracking.' .

ind:Safety rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UtilityCompany ;
    rdfs:label 'Safety' ;
    rdfs:comment 'Manages occupational safety programs, environmental health, incident reporting, hazardous material handling, and environmental compliance across all utility operations. Tracks OSHA recordable incidents, near-misses, safety audits, PPE compliance, PSC safety audits, EPA emissions reporting, PHMSA pipeline integrity management, and CIP compliance. Supports safety culture metrics and corrective action tracking.' .

ind:Finance rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UtilityCompany ;
    rdfs:label 'Finance' ;
    rdfs:comment 'Corporate financial management serving as the SSOT for general ledger, cost centers, capital project accounting, budgeting, financial planning, CAPEX/OPEX tracking, depreciation, and financial reporting. Manages chart of accounts, RAB valuation, ROE calculations, EBITDA reporting, and FASB ASC 980 regulatory asset/liability accounting. Supports rate case cost-of-service studies and FERC Form 1 reporting. Integrates with SAP FI/CO.' .

ind:Engagement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UtilityCompany ;
    rdfs:label 'Engagement' ;
    rdfs:comment 'Manages commercial and key account customer engagement, demand-side management (DSM) program participation, and Salesforce-driven CRM interactions for C&I customers. Owns opportunity tracking, energy audit records, DR enrollment agreements, and customer satisfaction data. Supports load management programs, VPP participation agreements, and large customer contract negotiations.' .

ind:Property rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UtilityCompany ;
    rdfs:label 'Property' ;
    rdfs:comment 'Manages utility-owned real property, land rights, easements, buildings, facilities, and physical site master data. Serves as SSOT for all geographic and property assets distinct from electrical/gas infrastructure.' .

ind:Technology rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UtilityCompany ;
    rdfs:label 'Technology' ;
    rdfs:comment 'Manages IT and OT infrastructure, cybersecurity programs, network assets, SCADA/EMS system configurations, and digital platform lifecycle for the utility. Covers IT asset management, OT/IT convergence, application portfolio, and technology project delivery.' .

# --- Data Product Classes (Tables) ---
ind:ChartOfAccounts rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Chart Of Accounts' ;
    rdfs:comment 'Master repository of all general ledger account codes used by the utility, organized by account class (assets, liabilities, equity, revenues, expenses, O&M). Aligned with FERC Uniform System of Accounts (USoA) and FASB ASC 980 regulated operations classifications. Serves as the foundational reference for all financial postings across SAP FI/CO, rate case cost-of-service studies, and FERC Form 1 reporting.' .

ind:CostCenter rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Cost Center' ;
    rdfs:comment 'Organizational cost collection master representing both permanent cost centers (generation plants, T&D districts, corporate functions) and temporary cost collectors (internal orders for maintenance jobs, storm restoration, overhead pools). Supports OPEX allocation, departmental budgeting, overhead cost pooling, storm restoration cost capture, activity-based cost tracking, and cost-of-service studies for rate case filings. Hierarchically organized by cost center group aligned with the utility\'s organizational structure. Internal orders provide short-term cost collection for activities that do not warrant a full project structure.' .

ind:GlAccount rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Gl Account' ;
    rdfs:comment 'Master repository and control record for all general ledger accounts, encompassing the chart of accounts structure (account classes, groups, FERC USoA alignment), individual account properties (account type, balance sheet/P&L indicator, tax category, reconciliation account flag, posting controls), and period-end account balances by reporting entity. Serves as the foundational reference for all financial postings across SAP FI/CO, financial statement preparation, rate case cost-of-service studies, and FERC Form 1 reporting. Organized by account class (assets, liabilities, equity, revenues, expenses, O&M) aligned with FASB ASC 980 regulated operations classifications.' .

ind:JournalEntry rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Journal Entry' ;
    rdfs:comment 'Complete general ledger journal entry record including header and line-item detail for all financial postings — manual journal entries, system-generated postings from billing/procurement/payroll, accruals, reversals, and period-end closing entries. Header captures posting date, fiscal period, document type, company code, and originating transaction reference. Each line item specifies the GL account, cost center, profit center, WBS element, debit/credit amount in transaction and local currency, tax code, and assignment field. Provides the atomic-level audit trail for all financial postings required for FERC Form 1 and regulatory cost-of-service studies.' .

ind:JournalEntryLine rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Journal Entry Line' ;
    rdfs:comment 'Individual debit and credit line items within a SAP FI journal entry, each specifying the GL account, cost center, profit center, WBS element, amount in transaction and local currency, tax code, and assignment field. Provides the atomic-level audit trail for all financial postings required for FERC Form 1 and regulatory cost-of-service studies.' .

ind:FinanceCapexProject rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Finance Capex Project' ;
    rdfs:comment 'SAP PS/IM capital expenditure project master representing individual capital investment projects (e.g., substation upgrades, AMI deployment, pipeline replacement) including their hierarchical Work Breakdown Structure (WBS) elements for granular cost tracking. Tracks project authorization, CAPEX budget, actual spend by WBS element, AFUDC (Allowance for Funds Used During Construction) accruals, and in-service date for asset capitalization. WBS elements map to specific scopes of work and accumulate costs that settle to fixed assets upon project completion. Supports CPCN filings and IRP capital planning.' .

ind:WbsElement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Wbs Element' ;
    rdfs:comment 'SAP PS Work Breakdown Structure element representing a hierarchical subdivision of a capital project used for granular cost tracking, budget control, and asset capitalization. Each WBS element maps to a specific scope of work within a CAPEX project and accumulates costs that are eventually settled to fixed assets upon project completion.' .

ind:InternalOrder rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Internal Order' ;
    rdfs:comment 'SAP CO internal order used to collect and monitor costs for short-term operational activities, maintenance jobs, and overhead cost pools that do not warrant a full project structure. Supports OPEX tracking for O&M activities, storm restoration cost capture for regulatory recovery, and overhead allocation to cost centers.' .

ind:Budget rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Budget' ;
    rdfs:comment 'Annual and multi-year financial budget records including header-level plan metadata and granular line items for cost centers, profit centers, and capital projects covering both OPEX and CAPEX. Header stores budget version (initial plan, revised forecast, final approved), approval status, and planning horizon. Line items specify GL account, cost center or WBS element, fiscal period, budget category (OPEX/CAPEX), and planned amount. Supports GRC rate case cost-of-service studies, IRP financial planning, and variance analysis between budgeted and actual costs at the account and cost object level.' .

ind:BudgetLine rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Budget Line' ;
    rdfs:comment 'Granular budget line items within a budget plan, specifying the GL account, cost center or WBS element, fiscal period, budget category (OPEX/CAPEX), and planned amount. Enables variance analysis between budgeted and actual costs at the account and cost object level for management reporting and regulatory cost justification.' .

ind:FixedAsset rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Fixed Asset' ;
    rdfs:comment 'Comprehensive fixed asset accounting record for all capitalized utility plant assets including generation equipment, transmission lines, distribution infrastructure, gas pipeline assets, and right-of-use assets from leases. Encompasses the asset master (original cost, in-service date, FERC plant account classification, RAB inclusion status), periodic depreciation calculations across all depreciation areas (book, tax, regulatory) with method and useful life parameters, accumulated depreciation, net book value, retirement/disposal tracking, and depreciation run history. Supports FASB ASC 980 regulatory depreciation studies, rate case depreciation expense justification, and FERC Form 1 accumulated depreciation reporting.' .

ind:DepreciationRun rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Depreciation Run' ;
    rdfs:comment 'SAP FI-AA periodic depreciation calculation run records capturing planned and posted depreciation amounts by asset, depreciation area (book, tax, regulatory), fiscal period, and depreciation method. Supports FASB ASC 980 regulatory depreciation studies, rate case depreciation expense justification, and FERC Form 1 accumulated depreciation reporting.' .

ind:RegulatoryAsset rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Regulatory Asset' ;
    rdfs:comment 'FASB ASC 980 regulatory asset and regulatory liability records representing costs or obligations that regulators have authorized for future recovery or refund through rates. Tracks the regulatory asset/liability balance, amortization schedule, authorizing rate order, PUC docket reference, and recovery period. Essential for regulated utility financial reporting and rate base calculations.' .

ind:RateBase rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Rate Base' ;
    rdfs:comment 'Regulatory rate base (RAB) calculation records supporting GRC and rate case filings. Captures the components of rate base including net utility plant, working capital allowance, regulatory assets/liabilities, accumulated deferred income taxes (ADIT), and customer deposits. Tracks rate base by jurisdiction, rate class, and test year for PUC cost-of-service studies and ROE calculations.' .

ind:CostAllocation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Cost Allocation' ;
    rdfs:comment 'SAP CO cost allocation and assessment cycle records distributing shared costs (e.g., corporate overhead, shared services, common plant) from sender cost centers to receiver cost centers, profit centers, or WBS elements. Supports fully-allocated cost-of-service studies for rate cases and inter-company cost allocation for multi-jurisdictional utilities.' .

ind:ApInvoice rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Ap Invoice' ;
    rdfs:comment 'Accounts payable full lifecycle record covering vendor invoice receipt, validation (three-way match with PO/GR/IR), approval, payment execution, and batch payment run processing. Tracks invoice details (vendor, amount, tax, payment terms, due date), payment processing (payment method, payment date, bank account, check/ACH reference, batch payment run parameters), and settlement status. Covers fuel procurement, materials, contractor services, equipment purchases, and employee expense reimbursements. Includes automatic payment program run records for batch disbursement execution. Supports OPEX/CAPEX expenditure tracking, cash flow management, and bank reconciliation.' .

ind:ArTransaction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Ar Transaction' ;
    rdfs:comment 'Accounts receivable transaction records for non-retail-billing receivables including inter-company charges, wholesale energy sales settlements, REC sales proceeds, transmission service revenues, FERC-jurisdictional wheeling charges, and miscellaneous revenue. Tracks counterparty, invoice amount, due date, collection status, aging bucket, and write-off history. Complements the billing domain\'s customer AR for non-retail revenue streams.' .

ind:PaymentRun rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Payment Run' ;
    rdfs:comment 'SAP FI automatic payment program run records capturing batch payment executions for vendor invoices and employee expense reimbursements. Tracks payment run date, payment method (ACH, check, wire), total payment amount, bank account, and individual payment documents generated. Supports treasury cash management and bank reconciliation.' .

ind:FinancialStatement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Financial Statement' ;
    rdfs:comment 'Periodic financial statement records (balance sheet, income statement, statement of cash flows) prepared for internal management reporting, board reporting, SEC filings, and regulatory submissions including FERC Form 1 and state PUC annual reports. Captures statement type, reporting period, entity/segment, and GAAP vs. regulatory basis indicators.' .

ind:TaxProvision rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Tax Provision' ;
    rdfs:comment 'Income tax provision and deferred tax records capturing current tax expense, deferred tax expense, effective tax rate reconciliation, and accumulated deferred income taxes (ADIT) by jurisdiction and legal entity. Tracks IRS normalization requirements for regulated utilities, excess ADIT balances subject to ARAM (Average Rate Assumption Method) amortization per Tax Cuts and Jobs Act, state/federal tax apportionment factors, and PUC-ordered rate base ADIT offsets. Essential for rate case revenue requirement calculations and FERC Form 1 tax reporting.' .

ind:BalancingArea rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Gridops ;
    rdfs:label 'Balancing Area' ;
    rdfs:comment 'Master record for each balancing authority area (BAA) or control area managed by the utility, defining geographic and electrical boundaries, interchange schedules, and reliability obligations under NERC standards. Serves as the top-level operational jurisdiction for EMS dispatch and frequency regulation activities.' .

ind:ControlZone rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Gridops ;
    rdfs:label 'Control Zone' ;
    rdfs:comment 'Defines electrical control zones within the balancing area, representing logical subdivisions of the grid used for load forecasting, voltage control, and dispatch coordination. Each zone maps to a set of buses, substations, and feeders managed under a unified operational strategy within the EMS/DMS.' .

ind:ScadaPoint rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Gridops ;
    rdfs:label 'Scada Point' ;
    rdfs:comment 'Master catalog of all SCADA telemetry points (analog and digital) monitored via OSIsoft PI Historian and GE PowerOn EMS/DMS. Each record defines a measurement point including point name, tag ID, associated asset, engineering units, scan rate, deadband, and alarm thresholds. Serves as the SSOT for real-time grid telemetry configuration.' .

ind:ScadaReading rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Gridops ;
    rdfs:label 'Scada Reading' ;
    rdfs:comment 'Near-real-time and historical telemetry readings and alarm events captured from SCADA points via OSIsoft PI Historian. Stores timestamped analog values (MW, MVAR, kV, Hz, amps, temperature), digital state changes (breaker open/close, switch status, protection relay operations), and alarm records. Alarm data includes alarm point reference, alarm type (thermal overload, voltage violation, equipment failure, communication loss, protection operation), priority level per ISA-18.2 alarm management standard, trigger value, threshold, acknowledgment status, acknowledging operator, shelving status, suppression state, and time to acknowledge/clear. This is the highest-volume product in the domain and the foundation for all real-time operational decisions, alarm management and rationalization, operator performance review, post-event analysis, NERC CIP-007 compliance, and NERC compliance evidence.' .

ind:EmsDispatchInstruction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Gridops ;
    rdfs:label 'Ems Dispatch Instruction' ;
    rdfs:comment 'Records each generation dispatch instruction issued by the Energy Management System (EMS) to generating units or controllable resources within the balancing area. Captures MW setpoint, ramp rate, dispatch reason (economic, reliability, regulation), issuing operator, and acknowledgment status. Integrates with AGC (Automatic Generation Control) and manual operator actions.' .

ind:LoadForecast rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Gridops ;
    rdfs:label 'Load Forecast' ;
    rdfs:comment 'Stores short-term (hourly/daily), medium-term (weekly/monthly), and persistence forecasts produced by the EMS forecasting engine for the balancing area and control zones. Includes forecasted MW demand by interval, weather-adjusted baseline, peak demand estimate, confidence interval, forecast model version, and actual vs. forecast variance for accuracy tracking. Used for unit commitment, interchange scheduling, DR dispatch planning, and next-day operations planning.' .

ind:FrequencyRegulationEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Gridops ;
    rdfs:label 'Frequency Regulation Event' ;
    rdfs:comment 'Captures frequency regulation events, ACE (Area Control Error) exceedances, AGC response actions, and serves as the single source of truth for all energy balance and frequency compliance data for the balancing area. Records include: frequency deviations from 60 Hz, CPS1/CPS2/BAAL compliance metrics, regulation reserve deployment, and corrective actions taken. Also stores hourly and sub-hourly energy accounting: total generation (MWh), total load (MWh), net interchange (MWh), system losses, and ACE values by interval. Supports NERC BAL-001 (real power balancing), BAL-002 (disturbance control), BAL-003 (frequency response), energy balance reporting for RTO/ISO settlement, and operational energy accounting. This is the authoritative product for all ACE-related data, frequency compliance, and energy balance records.' .

ind:VoltageControlAction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Gridops ;
    rdfs:label 'Voltage Control Action' ;
    rdfs:comment 'Records operator and automated voltage control actions taken within the grid including capacitor bank switching, reactor switching, tap changer adjustments, and reactive power dispatch. Captures target bus, pre-action voltage (kV), post-action voltage (kV), action type, initiating condition, and operator or automation source. Supports voltage profile compliance and post-event review.' .

ind:GridopsSwitchingOrder rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Gridops ;
    rdfs:label 'Gridops Switching Order' ;
    rdfs:comment 'Manages switching orders issued by grid operations for planned and emergency switching sequences on the transmission and distribution network. Each order contains a header (order number, purpose, issuing operator, approving supervisor, execution status, safety clearances, LOTO tags) and an ordered sequence of switching steps (discrete actions on breakers, switches, and disconnects with per-step device identifier, action type, required safety tag, completion timestamp, executing operator, and sequence validation). Integrates with GE PowerOn DMS/OMS. Supports planned maintenance isolation, emergency fault restoration, and safety compliance tracking through granular step-level execution audit.' .

ind:SwitchingStep rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Gridops ;
    rdfs:label 'Switching Step' ;
    rdfs:comment 'Individual step within a switching order defining a single discrete switching action (open/close breaker, isolate section, ground equipment). Captures step sequence number, device identifier, action type, required safety tag, completion timestamp, and executing operator. Enables granular tracking of switching sequence execution and safety compliance.' .

ind:GridopsOutageEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Gridops ;
    rdfs:label 'Gridops Outage Event' ;
    rdfs:comment 'Master record for each grid outage event managed through the OMS (GE PowerOn), encompassing the full outage lifecycle from detection through restoration. Header captures outage type (planned/unplanned/momentary), affected network segment, cause code (IEEE 1366), estimated and confirmed customers affected, start timestamp, ETR (estimated time of restoration), and regulatory notification status. Includes a chronological restoration log tracking each milestone (crew dispatch, fault isolation, switching action, partial restoration, full restoration) with timestamps, restored customer counts, restoration method, and responsible crew. Serves as the SSOT for outage lifecycle management, SAIDI/SAIFI/CAIDI/MAIFI calculation, regulatory reporting (state PUC, DOE OE-417), and post-storm analysis.' .

ind:OutageRestorationLog rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Gridops ;
    rdfs:label 'Outage Restoration Log' ;
    rdfs:comment 'Detailed chronological log of restoration activities for each outage event, capturing each restoration milestone (crew dispatch, fault isolation, switching action, partial restoration, full restoration). Records timestamp, restored customer count, restoration method, and responsible crew. Supports CAIDI calculation, regulatory reporting, and post-storm analysis.' .

ind:ReliabilityEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Gridops ;
    rdfs:label 'Reliability Event' ;
    rdfs:comment 'Records NERC-reportable and internally tracked reliability events including disturbances, contingencies, N-1 violations, BES incidents, and all associated operator log entries and control room communications. Each event captures classification per NERC EOP/TOP standards, affected facilities, initiating cause, system impact (MW lost, customers affected), regulatory reporting obligation, and timeline. Includes chronological operator actions, observations, shift handoff notes, alarm acknowledgments, inter-utility communications, and free-text narratives forming the complete operational record. Also serves as the repository for routine operator log entries (shift logs, standing orders, equipment status notes) classified by entry type. Feeds NERC OE-417, state PUC disturbance reporting, NERC CIP compliance evidence, and serves as the official auditable operational record for all control room activities.' .

ind:DrDispatchEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Gridops ;
    rdfs:label 'Dr Dispatch Event' ;
    rdfs:comment 'Records each demand response (DR) dispatch event issued by grid operations to enrolled DR resources and aggregators, with full per-resource performance tracking. Header captures dispatch trigger (emergency, economic, capacity, test), target MW reduction, dispatch window, notification method, and overall program compliance status. Detail records capture each participating resource\'s identifier, resource type, nominated MW reduction, actual metered MW reduction (from interval meter data), response time, ramp compliance, performance score, and settlement-ready compliance flag. Integrates with DERMS for DER-based DR and with the product domain for DR program definitions. Supports DR capacity payment settlement, program compliance verification, FERC Order 2222 reporting, and resource performance trending.' .

ind:DrResourceResponse rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Gridops ;
    rdfs:label 'Dr Resource Response' ;
    rdfs:comment 'Captures the measured performance response of each individual DR resource or aggregator to a specific DR dispatch event. Records resource identifier, nominated MW reduction, actual metered MW reduction, response time, compliance flag, and performance score. Used for DR settlement, program compliance verification, and resource performance tracking.' .

ind:GridContingency rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Gridops ;
    rdfs:label 'Grid Contingency' ;
    rdfs:comment 'Defines credible contingency scenarios (N-1, N-2, N-1-1) and stores all real-time and study-mode security assessment results performed by the EMS. Master contingency records specify contingency name, element(s) removed, contingency type, probability, monitoring elements, thermal and voltage limits, and active/inactive status in real-time security assessment. Assessment result records capture study timestamp, study type (real-time, day-ahead, planning), base case power flow results, number of violations found, worst-case contingency ranking, thermal overload details, voltage violation details, stability margin, and recommended corrective actions (redispatch, switching, load shed). Supports NERC TPL-001 through TPL-004, FAC-001/FAC-002 reliability standards, operator situational awareness, and real-time reliability compliance.' .

ind:SecurityAssessment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Gridops ;
    rdfs:label 'Security Assessment' ;
    rdfs:comment 'Records results of real-time and study-mode security assessments (contingency analysis, power flow, voltage stability) performed by the EMS. Captures assessment timestamp, study type, number of violations found, worst-case contingency, thermal overload count, voltage violation count, and recommended corrective actions. Supports operator situational awareness and NERC reliability compliance.' .

ind:OperatorLog rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Gridops ;
    rdfs:label 'Operator Log' ;
    rdfs:comment 'Chronological log of operator actions, observations, and communications recorded in the grid operations control room. Each entry captures timestamp, operator ID, shift, log entry type (action, alarm acknowledgment, communication, note), associated asset or event, and free-text narrative. Serves as the official operational record for post-event analysis, regulatory audits, and NERC CIP compliance.' .

ind:AlarmEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Gridops ;
    rdfs:label 'Alarm Event' ;
    rdfs:comment 'Records each SCADA/EMS alarm generated from monitored grid assets including thermal overloads, voltage violations, equipment failures, communication loss, and protection system operations. Captures alarm point, alarm type, priority level (per ISA-18.2 alarm management standard), trigger value, threshold, acknowledgment status, acknowledging operator, shelving status, and time to acknowledge/clear. Supports alarm rationalization, operator performance review, and NERC CIP-007 compliance.' .

ind:EnergyBalance rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Gridops ;
    rdfs:label 'Energy Balance' ;
    rdfs:comment 'Hourly and sub-hourly energy balance records for the balancing area capturing total generation (MWh), total load (MWh), net interchange (MWh), losses, and ACE (Area Control Error). Derived from SCADA telemetry and used for NERC BAL compliance reporting, settlement with RTOs/ISOs, and operational accounting. Represents the authoritative near-real-time energy accounting record for the balancing area.' .

ind:TransmissionLimit rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Gridops ;
    rdfs:label 'Transmission Limit' ;
    rdfs:comment 'Master records for thermal, voltage, and stability limits on transmission facilities (lines, transformers, flowgates, interfaces) enforced in real-time operations. Captures normal rating (MVA/MW), emergency rating (15-min/4-hr), load dump rating, seasonal and ambient-adjusted ratings, applicable contingency, limit source (thermal/voltage/stability), and effective date. These limits are the hard constraints enforced by EMS security analysis and operator dispatch decisions per NERC FAC-008.' .

ind:Technician rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Technician' ;
    rdfs:comment 'Master record for all field workforce personnel including lineworkers, meter readers, field service technicians, gas technicians, and T&D construction crew members. Serves as the SSOT for worker identity, employment classification, union affiliation, craft type, and base assignment. Sourced from SAP HR and ClickSoftware WFM. Distinct from the corporate HR employee record — this is the operational field workforce profile used for dispatch, scheduling, and OSHA compliance tracking.' .

ind:Crew rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Crew' ;
    rdfs:comment 'Defines a named field crew unit composed of one or more technicians assigned to perform T&D construction, O&M maintenance, storm restoration, or gas distribution work. Tracks crew type (electric line, gas, metering, substation), crew size, home depot/garage, crew lead, and operational status. A crew is a persistent organizational unit that can be dispatched as a single entity in ClickSoftware WFM.' .

ind:CrewMember rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Crew Member' ;
    rdfs:comment 'Association entity linking individual technicians to crews, capturing role within the crew (lead, journeyman, apprentice, helper), effective dates of crew membership, union classification, and active status. Supports many-to-many crew composition over time as crew rosters change with seasonal staffing, storm augmentation, and contractor supplementation.' .

ind:WorkOrderAssignment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Work Order Assignment' ;
    rdfs:comment 'Transactional record capturing the dispatch and assignment of a technician or crew to a specific work order (sourced from Maximo EAM or GE PowerOn OMS). Tracks assignment date/time, scheduled start and end, actual arrival and departure, travel time, assignment status (dispatched, en-route, on-site, completed, cancelled), and mobile acknowledgment. This is the core operational dispatch record in ClickSoftware WFM linking workforce to work execution.' .

ind:Shift rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Shift' ;
    rdfs:comment 'Defines scheduled work shifts for field workforce including shift type (day, evening, night, rotating), shift start and end times, shift duration, overtime eligibility, and applicable union agreement provisions. Shifts are the building blocks of crew scheduling and are used to calculate labor hours, overtime costs, and OSHA fatigue compliance for T&D field operations.' .

ind:Schedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Schedule' ;
    rdfs:comment 'Planned work schedule for a technician or crew over a defined planning horizon (daily, weekly, or monthly). Captures scheduled shifts, days on/off, planned assignments, territory coverage, and schedule status (draft, published, confirmed). Generated by ClickSoftware WFM optimization engine and used for resource capacity planning, outage response readiness, and union contract compliance (minimum rest periods, consecutive days worked).' .

ind:TimeEntry rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Time Entry' ;
    rdfs:comment 'Transactional record of actual hours worked by a technician for a given date, work order, or cost object. Captures regular, overtime, double-time, travel, standby, and on-call hours with applicable pay code and cost center. Includes overtime pre-authorization tracking (requesting supervisor, authorization type, estimated vs actual hours). Supports CAPEX/OPEX labor cost classification via WBS element, union agreement overtime provisions, and FERC account coding. Sourced from ClickSoftware mobile time capture and integrated into SAP HR/Payroll.' .

ind:Qualification rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Qualification' ;
    rdfs:comment 'Master catalog of workforce qualifications, certifications, and competencies required for field utility work. Includes qualification type (CDL Class A, OSHA 10/30, NFPA 70E Arc Flash, Gas Operator Qualification, Substation Switching Authorization, Lineworker Journeyman Certificate), issuing authority, validity period, renewal requirements, and regulatory mandate (OSHA, PHMSA, NERC CIP). This is the reference catalog — not the individual worker\'s attainment record.' .

ind:TechnicianQualification rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Technician Qualification' ;
    rdfs:comment 'Tracks each technician\'s attainment, expiration, and renewal status for every required qualification or certification. Captures issue date, expiration date, certifying body, certificate number, training provider, and compliance status. Supports OSHA safety training compliance, PHMSA Operator Qualification (OQ) program for gas workers, NERC CIP personnel training requirements, and ClickSoftware skill-based dispatch matching. Triggers renewal alerts before expiration.' .

ind:UnionAgreement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Union Agreement' ;
    rdfs:comment 'Master record for collective bargaining agreements (CBAs) governing unionized field workforce including IBEW (International Brotherhood of Electrical Workers) and other trade union contracts. Captures agreement name, union local number, effective and expiration dates, wage scales by classification, overtime rules, call-out provisions, storm pay provisions, grievance procedures, and jurisdictional work rules. Drives labor cost calculations and scheduling constraint enforcement.' .

ind:LaborRate rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Labor Rate' ;
    rdfs:comment 'Reference table of labor rates by craft classification, union agreement, pay grade, and effective date period. Captures straight-time rate, overtime rate, double-time rate, on-call rate, storm rate, and applicable burden/overhead percentages. Used for work order cost estimation, CAPEX/OPEX labor cost allocation, rate case labor cost support, and contractor vs. employee cost comparison. Sourced from SAP HR wage type configuration and union CBA schedules.' .

ind:Absence rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Absence' ;
    rdfs:comment 'Transactional record of planned and unplanned workforce absences including vacation, sick leave, FMLA, union leave, jury duty, military leave, and workers compensation leave. Captures absence type, start date, end date, duration in hours, approval status, and impact on crew coverage. Integrated with SAP HR absence management and used by ClickSoftware WFM to adjust available resource capacity for scheduling and storm response staffing.' .

ind:StormEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Storm Event' ;
    rdfs:comment 'Master record for declared storm and emergency events that trigger emergency workforce mobilization protocols. Captures storm name, storm type (hurricane, ice storm, derecho, nor\'easter), declaration date/time, affected service territory, estimated restoration time (ERT), storm level (1-5 severity), mutual aid activation flag, and storm status (active, restoration, demobilization, closed). Drives storm crew scheduling, mutual aid crew tracking, and SAIDI/SAIFI storm exclusion reporting.' .

ind:StormAssignment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Storm Assignment' ;
    rdfs:comment 'Transactional record tracking crew and technician assignments during a declared storm event, including both internal utility crews and mutual aid crews from other utilities under EEI mutual aid agreements. Captures storm event reference, assigned crew or technician, assignment role (restoration, damage assessment, wire guard), reporting depot, mobilization and demobilization timestamps, and hours worked under storm pay provisions. For mutual aid crews: originating utility, crew composition, equipment brought, and cost reimbursement tracking. Supports IBEW storm pay calculation, EEI mutual aid billing, and post-storm cost recovery filings.' .

ind:OnCallRotation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'On Call Rotation' ;
    rdfs:comment 'Defines the on-call rotation schedule for field technicians and crews responsible for after-hours emergency response including outage restoration, gas leak response, and downed wire calls. Captures rotation period (weekly, bi-weekly), technician assigned, backup technician, on-call start and end date/time, response time SLA (e.g., 30-minute callout), and union on-call pay provision. Supports 24/7 emergency dispatch readiness and union CBA on-call compensation compliance.' .

ind:Plant rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Generation ;
    rdfs:label 'Plant' ;
    rdfs:comment 'Master record for each electric power generation facility operated by the utility, including fossil fuel (coal, natural gas, oil), nuclear, and renewable (solar, wind, hydro) plants. Captures plant name, NERC plant code, EIA plant ID, plant type, fuel category, installed capacity (MW), commercial operation date, retirement date, regulatory jurisdiction, ISO/RTO interconnection, geographic coordinates, FERC license number, and operational status. Serves as the SSOT for generation plant identity and is the anchor entity for all generation domain products.' .

ind:GeneratingUnit rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Generation ;
    rdfs:label 'Generating Unit' ;
    rdfs:comment 'Master record for each individual generating unit (boiler-turbine set, reactor unit, wind turbine, solar inverter block, hydro turbine) within a plant. Tracks unit name, EIA unit code, NERC unit ID, prime mover type (ST, GT, CC, HY, PV, WT, NUC), nameplate capacity (MW), summer/winter capacity ratings, heat rate (BTU/kWh), fuel type, unit status (operating, mothballed, retired), synchronization date, and associated plant. Enables unit-level performance tracking, IRP modeling, and LCOE analysis.' .

ind:EnergyOutput rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Generation ;
    rdfs:label 'Energy Output' ;
    rdfs:comment 'Hourly and sub-hourly generation output records for each generating unit sourced from OSIsoft PI Historian telemetry. Captures gross generation (MWh), net generation (MWh), auxiliary consumption (MWh), reactive power (MVAr), power factor, frequency, timestamp, data quality flag, and PI tag reference. Supports periodic aggregation for capacity factor calculation, FERC EQR submissions, RTO/ISO settlement reconciliation, and all generation performance KPI derivation including heat rate when combined with fuel consumption records.' .

ind:FuelConsumption rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Generation ;
    rdfs:label 'Fuel Consumption' ;
    rdfs:comment 'Transactional record of fuel consumed by each generating unit per operating period. Captures fuel type, quantity consumed (MCF, tons, MMBtu, gallons), heat content (BTU/unit), total heat input (MMBtu), fuel cost per unit, total fuel cost, delivery receipt reference, and reporting period. Supports EIA Form 923 fuel consumption reporting, heat rate calculations, LCOE analysis, and emissions inventory.' .

ind:UnitAvailability rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Generation ;
    rdfs:label 'Unit Availability' ;
    rdfs:comment 'Daily and hourly availability status records for each generating unit tracking available capacity (MW), unavailable capacity (MW), planned outage capacity, forced outage capacity, maintenance outage capacity, and derating events. Captures NERC GADS event codes, outage cause codes, start/end timestamps, and responsible system (EMS/SCADA). Enables SAIDI/SAIFI-equivalent generation reliability metrics, NERC GADS reporting, and capacity planning.' .

ind:GenerationOutage rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Generation ;
    rdfs:label 'Generation Outage' ;
    rdfs:comment 'Single source of truth for all generating unit outages, deratings, and availability states. Captures planned, forced, and maintenance outages as well as daily/hourly availability status records including available capacity (MW), unavailable capacity by cause category (planned, forced, maintenance), and derating events with partial capacity loss. Records outage type, NERC GADS cause code and event code, affected capacity (MW), outage start/end timestamps, return-to-service time, responsible crew, and work order reference. Calculates equivalent availability factor (EAF), forced outage rate (FOR), planned outage factor (POF), and service factor. Serves as the single source of truth for NERC GADS reporting (IEEE 762), generation reliability metrics, capacity planning, and all unit availability tracking.' .

ind:EmissionsRecord rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Generation ;
    rdfs:label 'Emissions Record' ;
    rdfs:comment 'Transactional emissions data for each generating unit capturing SO2 (tons), NOx (tons), CO2 (tons), CO2e (tons), mercury (lbs), particulate matter (lbs), heat input (MMBtu), emissions rates per MMBtu and per MWh, EPA CEMS monitor ID, reporting period, and compliance status against applicable EPA permits and state air quality standards. Supports EPA Clean Air Act reporting, FERC EQR, and state PUC environmental compliance filings.' .

ind:RecCertificate rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Generation ;
    rdfs:label 'Rec Certificate' ;
    rdfs:comment 'Renewable Energy Certificate (REC) records tracking each MWh of renewable generation eligible for REC issuance. Captures REC serial number, generating unit, generation period, fuel source (solar, wind, hydro, biomass), vintage year, tracking system (WREGIS, NEPOOL GIS, PJM GATS), certificate status (issued, retired, transferred, expired), retirement purpose (RPS compliance, voluntary), and associated energy output record. Supports state RPS compliance and voluntary renewable energy programs.' .

ind:PpaDelivery rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Generation ;
    rdfs:label 'Ppa Delivery' ;
    rdfs:comment 'Transactional records of actual energy deliveries under each PPA contract on a daily or monthly basis. Captures scheduled delivery (MWh), actual delivery (MWh), curtailment (MWh), curtailment reason, settlement price, total payment amount, delivery period, and variance from contracted volume. Supports PPA performance monitoring, invoice reconciliation with trading/billing domains, and FERC EQR reporting.' .

ind:Forecast rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Generation ;
    rdfs:label 'Forecast' ;
    rdfs:comment 'Forward-looking generation output forecasts for each plant or unit across multiple time horizons (day-ahead, week-ahead, monthly, annual). Captures forecast period, forecast horizon type, forecasted gross generation (MWh), forecasted net generation (MWh), forecasted capacity factor, forecast model version, weather input assumptions, and confidence interval. Supports DAM bidding, load forecasting integration, and IRP planning. Distinct from analytics — these are operational planning records used in EMS dispatch.' .

ind:NuclearFuelCycle rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Generation ;
    rdfs:label 'Nuclear Fuel Cycle' ;
    rdfs:comment 'Master records tracking the nuclear fuel lifecycle for each reactor unit including fuel assembly batch ID, enrichment level (% U-235), initial uranium load (MTU), burnup level (MWd/MTU), cycle start/end dates, refueling outage reference, spent fuel storage location, NRC license reference, and fuel vendor. Supports NRC regulatory reporting, nuclear fuel cost accounting under FASB ASC 980, and long-term fuel planning.' .

ind:RenewableResource rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Generation ;
    rdfs:label 'Renewable Resource' ;
    rdfs:comment 'Master records for renewable generation resource characteristics specific to solar, wind, and hydro units. Captures resource type (solar PV, solar thermal, wind onshore, wind offshore, run-of-river hydro, pumped storage), panel/turbine model, installed capacity (MW-DC/MW-AC for solar), hub height (wind), rotor diameter (wind), water head (hydro), resource zone, interconnection agreement number, NEM eligibility flag, and DERMS integration flag. Supports IRP renewable portfolio planning and REC tracking.' .

ind:CapacityResource rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Generation ;
    rdfs:label 'Capacity Resource' ;
    rdfs:comment 'Master records for generating units registered as capacity resources in RTO/ISO capacity markets (PJM RPM, MISO PRA, NYISO ICAP, ISO-NE FCA). Captures capacity zone, accredited capacity (MW-ICAP, MW-UCAP), capacity product type (base capacity, CP), qualification test results, effective load carrying capability (ELCC) for renewables, capacity obligation (MW), performance assessment intervals, bonus/penalty amounts, and associated RTO/ISO registration ID. Distinct from capacity market bidding (owned by trading domain) — this product tracks the physical unit\'s qualification and accreditation status only. Supports capacity revenue forecasting and FERC market compliance.' .

ind:Registry rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Asset ;
    rdfs:label 'Registry' ;
    rdfs:comment 'Master record for every physical infrastructure asset owned or operated by the utility, including generation plant equipment, T&D poles/lines/cables, gas pipeline segments, substations, transformers, meters, and field devices. Serves as the enterprise SSOT for asset identity, classification (referencing asset class), installation details, geospatial location (FK to location), manufacturer data, model/serial numbers, rated capacity, voltage class, material composition, commissioning date, retirement date, and current lifecycle status. Integrates with Maximo EAM as the system of record and Esri ArcGIS for spatial attributes. Supports ISO 55000 asset management compliance and RAB reporting to state PUCs. Technical material specifications for procurement are referenced via FK to the supply domain\'s material master.' .

ind:Hierarchy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Asset ;
    rdfs:label 'Hierarchy' ;
    rdfs:comment 'Defines the parent-child structural hierarchy of utility assets, enabling roll-up from individual components (e.g., a circuit breaker) to functional units (e.g., a substation bay) to facilities (e.g., a substation) to network segments (e.g., a transmission corridor). Captures hierarchy type (functional, spatial, accounting), relationship effective dates, and hierarchy level codes. Used for CAPEX roll-up, maintenance planning, outage impact analysis, and RAB reporting. Sourced from Maximo EAM location/asset hierarchy and Esri ArcGIS network topology.' .

ind:Location rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Asset ;
    rdfs:label 'Location' ;
    rdfs:comment 'Geospatial and physical location master for utility assets, capturing GPS coordinates (latitude/longitude), GIS feature class, county/municipality, service territory zone, transmission/distribution circuit identifier, substation name, pole/structure number, underground vault reference, and address where applicable. Integrates with Esri ArcGIS for spatial data management. Supports field crew navigation, outage restoration, permitting, and regulatory territory reporting. Each asset in asset_registry references one location record.' .

ind:Classification rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Asset ;
    rdfs:label 'Classification' ;
    rdfs:comment 'Reference taxonomy defining the classification scheme for utility assets by asset class code, asset class name, asset category (generation, transmission, distribution, gas, substation, metering, fleet, IT/OT), FERC account number for regulatory accounting, depreciation method, standard useful life in years, capitalization threshold, and applicable maintenance strategy. Aligns with FERC Uniform System of Accounts and FASB ASC 980 regulated operations accounting. Used for depreciation scheduling, RAB calculation, and rate case filing.' .

ind:ConditionAssessment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Asset ;
    rdfs:label 'Condition Assessment' ;
    rdfs:comment 'Comprehensive condition monitoring and assessment records for utility assets, serving as the single source of truth for asset health data. Captures three integrated record types: (1) Inspection events — formal field inspections conducted by utility crews, third-party inspectors, or regulatory auditors including inspection type (routine patrol, thermographic, structural, environmental, NERC CIP, PHMSA pipeline), inspector certification, inspection result (pass/fail/conditional), findings summary, deficiency count, and regulatory program association; (2) Condition scores — periodic condition grades (1-5 scale), condition index scores, failure probability ratings, remaining useful life estimates, recommended remediation actions, and assessment method (visual, thermographic, ultrasonic, oil sample); (3) Operational readings — quantitative measurements from SCADA/PI Historian and field instruments including transformer loading %, oil temperature, dissolved gas analysis (DGA) ppm, cable insulation resistance MΩ, gas pipeline pressure PSI, vibration levels, and threshold breach flags. Feeds asset health index calculations for risk-based maintenance prioritization and CAPEX planning. Sourced from Maximo inspection workflows, OSIsoft PI Historian, and field measurement instruments. Distinct from AMI meter interval reads (owned by metering domain).' .

ind:WorkOrder rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Asset ;
    rdfs:label 'Work Order' ;
    rdfs:comment 'Maximo-sourced work order master representing all planned, corrective, and emergency maintenance activities performed on utility assets. Captures work order number, work type (preventive maintenance, corrective maintenance, inspection, capital project, emergency restoration), priority level, originating source (SCADA alarm, inspection finding, customer complaint, scheduled PM), work order status, planned start/finish dates, actual start/finish dates, crew assignment, estimated and actual labor hours, estimated and actual material cost, and associated asset. Central operational record linking asset maintenance to workforce dispatch and supply chain material consumption.' .

ind:WorkOrderTask rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Asset ;
    rdfs:label 'Work Order Task' ;
    rdfs:comment 'Individual task or job plan step within a Maximo work order, capturing task sequence number, task description, craft/skill required, estimated labor hours per craft, actual labor hours, task status, completion date, and technician notes. Enables granular tracking of multi-step maintenance procedures (e.g., transformer oil sampling, relay testing, gas leak survey steps) and supports labor cost allocation at the task level. Child entity of work_order.' .

ind:PmSchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Asset ;
    rdfs:label 'Pm Schedule' ;
    rdfs:comment 'Preventive maintenance program master defining both the strategic maintenance policy and operational scheduling for asset classes and individual assets. Serves as the single source of truth for all PM configuration — equivalent to the Maximo PM record. Captures PM program name, maintenance strategy type (time-based, condition-based, reliability-centered RCM, risk-based), strategy rationale, frequency type and interval (calendar days, operating hours, condition trigger), criticality tier (1-critical, 2-essential, 3-standard), regulatory compliance driver (NERC, PHMSA, PUC), associated job plan template, applicable asset class or individual asset, annual O&M budget allocation, required inspection frequency, last completion date, next due date, schedule status, and plan review cycle. Drives automatic work order generation in Maximo, supports O&M budget forecasting, documents maintenance compliance for regulatory filings, and provides the strategic policy context for maintenance program governance.' .

ind:Inspection rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Asset ;
    rdfs:label 'Inspection' ;
    rdfs:comment 'Field inspection event record capturing formal asset inspections conducted by utility crews, third-party inspectors, or regulatory auditors. Includes inspection type (routine patrol, thermographic, structural, environmental, NERC CIP, PHMSA pipeline), inspection date, inspector name and certification, inspection result (pass/fail/conditional), findings summary, number of deficiencies identified, corrective action required flag, follow-up work order reference, and regulatory program association. Distinct from asset_condition (which captures the scored health state) — inspection is the event record of the inspection activity itself.' .

ind:FailureEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Asset ;
    rdfs:label 'Failure Event' ;
    rdfs:comment 'Records of asset failures, forced outages, and unplanned equipment failures capturing failure date/time, failure mode (insulation breakdown, mechanical wear, corrosion, overload, lightning strike, etc.), failure severity, affected asset, contributing cause codes, mean time between failures (MTBF) tracking, repair action taken, return-to-service date/time, and associated work order. Feeds reliability metrics (SAIDI, SAIFI, CAIDI) and supports root cause analysis, asset replacement prioritization, and insurance claims. Sourced from OMS/DMS failure records and Maximo failure reporting.' .

ind:DepreciationSchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Asset ;
    rdfs:label 'Depreciation Schedule' ;
    rdfs:comment 'Asset depreciation schedule records aligned with FERC Uniform System of Accounts and FASB ASC 980 regulated operations accounting. Captures asset ID, depreciation method (straight-line, MACRS, units-of-production), depreciable cost basis, accumulated depreciation to date, annual depreciation expense, net book value, remaining depreciable life, salvage value estimate, depreciation study reference, and effective date. Supports RAB (Regulatory Asset Base) calculation for rate case filings with state PUCs and FERC. Integrates with SAP FI/CO fixed asset module.' .

ind:AssetCapexProject rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Asset ;
    rdfs:label 'Asset Capex Project' ;
    rdfs:comment 'Capital expenditure project master for utility infrastructure investments including new construction, major refurbishment, system upgrades, technology modernization, and asset replacement programs. Captures project number (SAP WBS element), project name, project type (new construction, replacement, upgrade, compliance-driven, capacity expansion), sponsoring business unit, total authorized budget (CAPEX), actual spend to date, forecast at completion, project phase (planning, design, procurement, construction, commissioning, closed), in-service date target, regulatory approval reference (CPCN), IRP alignment flag, replacement driver (end-of-life, condition-based, compliance, capacity, technology obsolescence), replacement priority score, planning horizon (1-year, 5-year, 10-year), and funding source. Integrates with SAP PS (Project System) and supports CAPEX planning, replacement program management, and rate case capital testimony.' .

ind:LifecycleEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Asset ;
    rdfs:label 'Lifecycle Event' ;
    rdfs:comment 'Chronological log of significant lifecycle state transitions for each asset, capturing event type (commissioned, transferred, modified, refurbished, retired, disposed, written-off), event date, previous status, new status, triggering work order or project reference, authorizing personnel, and event notes. Provides a complete audit trail of an assets life from installation through retirement. Supports ISO 55000 lifecycle management, regulatory asset tracking, and insurance valuation. Distinct from asset_condition (health snapshots) and failure_event (unplanned failures).' .

ind:RiskAssessment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Asset ;
    rdfs:label 'Risk Assessment' ;
    rdfs:comment 'Risk assessment records for utility assets capturing probability of failure score, consequence of failure score (safety, reliability, environmental, financial), composite risk index, risk tier classification (high/medium/low), risk driver (age, condition, loading, environmental exposure, criticality of served load), recommended risk mitigation action, target mitigation date, and risk assessment date. Supports risk-based asset management per ISO 55000, CAPEX prioritization for replacement programs, and regulatory justification for capital investments in rate cases.' .

ind:OperationalReading rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Asset ;
    rdfs:label 'Operational Reading' ;
    rdfs:comment 'Periodic operational measurement and performance readings recorded against utility assets, capturing measurement type (transformer loading %, oil temperature, dissolved gas analysis ppm, cable insulation resistance MΩ, gas pipeline pressure PSI, vibration level, battery state-of-charge), measured value, unit of measure, measurement timestamp, measurement source (SCADA/PI Historian, manual field reading, lab analysis), and threshold breach flag. Distinct from AMI meter interval reads (owned by metering domain) — this covers operational asset health measurements from OSIsoft PI Historian and field instruments.' .

ind:ComplianceDocument rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Asset ;
    rdfs:label 'Compliance Document' ;
    rdfs:comment 'Regulatory compliance and technical documentation registry linking permits, licenses, engineering drawings, and operational documents to utility assets and facilities. Captures document/permit type (construction permit, operating license, environmental permit, right-of-way, easement, engineering drawing, as-built, test report, O&M manual, relay setting sheet), issuing authority or document originator, document/permit number, revision, issue date, expiration date, renewal status, compliance conditions, storage location (DMS reference), and associated asset or facility. Supports regulatory compliance tracking, field crew access to technical documentation, ISO 55000 information management, and rate case documentation of permit costs.' .

ind:Counterparty rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Trading ;
    rdfs:label 'Counterparty' ;
    rdfs:comment 'Master record for all trading counterparties including wholesale power buyers/sellers, financial institutions, ISOs/RTOs, PPA offtakers, and fuel suppliers. Captures legal entity details, credit ratings (S&P/Moody\'s), FERC/NERC registration status, DUNS number, jurisdiction, counterparty type (utility, marketer, financial, ISO, generator), approved credit limit, current credit exposure, collateral requirements (CSA terms), netting agreement flag, master agreement references (ISDA/NAESB/EEI), and credit watch status. Serves as the SSOT for counterparty identity, credit profile, and exposure management within the trading domain.' .

ind:Trade rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Trading ;
    rdfs:label 'Trade' ;
    rdfs:comment 'Core transactional record for every executed energy trade including wholesale power purchases/sales, natural gas trades, financial swaps, options, forwards, futures, FTRs/ARRs/CRRs (congestion revenue rights), and hedge instruments. Captures ETRM system trade number, trade date/time, commodity type (power, gas, REC, capacity, FTR), trade type (physical, financial, exchange), buy/sell indicator, volume (MWh/MCF/MW), price, delivery period start/end, delivery point, counterparty reference, trader ID, portfolio/book reference, hedge program reference (if designated), ASC 815 hedge designation, confirmation status, confirmation method, execution venue (bilateral, DAM, RTM, ICE, CME), broker reference, and amendment/novation history. Primary transactional anchor for the trading domain encompassing all instrument types including virtual transactions and congestion hedges.' .

ind:TradeLeg rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Trading ;
    rdfs:label 'Trade Leg' ;
    rdfs:comment 'Individual delivery leg or settlement leg of a multi-leg trade or structured product, existing as a first-class entity because each leg has independent delivery terms, settlement cycles, and confirmation status. Captures leg sequence, commodity, volume, price, delivery period, delivery point, buy/sell indicator, settlement currency, leg-level confirmation status, and leg-specific scheduling/nomination data. Supports complex instruments such as heat rate options, spark spread trades, basis swaps, tolling agreements, and multi-period PPAs where each leg settles independently and may have different counterparty credit treatment.' .

ind:Portfolio rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Trading ;
    rdfs:label 'Portfolio' ;
    rdfs:comment 'Master record defining trading books and portfolios used to organize positions, attribute P&L, and enforce risk governance. Captures portfolio name, portfolio type (generation hedge, load hedge, proprietary, ancillary, fuel), commodity scope, responsible trader/desk, regulatory classification (merchant vs. utility), mark-to-market methodology, approved risk limits (VaR limit, open position limit, stop-loss limit, tenor limit, credit exposure limit), limit breach actions (alert, block, escalate), current limit utilization, board approval date, and ETRM system book ID. Serves as the organizational unit for position aggregation, risk limit enforcement, and P&L attribution.' .

ind:Position rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Trading ;
    rdfs:label 'Position' ;
    rdfs:comment 'Daily snapshot of the net open trading position for a given portfolio, commodity, delivery period, and delivery point as of a specific valuation date. Captures long/short volume (MWh/MCF/RECs/MW), average price, mark-to-market value, unrealized P&L, delta equivalent, position source (physical, financial, net), capacity obligations (for capacity commodity type), REC inventory balances (for REC commodity type), and position change from prior day. Updated daily from the ETRM position management module. Supports risk reporting, regulatory position disclosure, RPS compliance planning, and resource adequacy tracking.' .

ind:PpaContract rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Trading ;
    rdfs:label 'Ppa Contract' ;
    rdfs:comment 'Master record for Power Purchase Agreements (PPAs) including long-term bilateral contracts for renewable and conventional generation. Captures PPA contract number, counterparty, resource type (solar, wind, hydro, gas), contracted capacity (MW), energy volume (MWh), contract term start/end, pricing structure (fixed, indexed, tolling), delivery point, REC inclusion flag, curtailment provisions, force majeure terms, FERC filing reference, and contract status. Distinct from short-term wholesale trades.' .

ind:MarketBid rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Trading ;
    rdfs:label 'Market Bid' ;
    rdfs:comment 'Record of energy bids and offers submitted to ISO/RTO day-ahead (DAM) and real-time (RTM) markets. Captures bid ID, market (MISO, PJM, CAISO, SPP), market type (DAM/RTM), operating day, hour/interval, resource ID, bid type (energy, capacity, ancillary), bid price ($/MWh), bid quantity (MW), bid curve segments, acceptance status, cleared quantity, and cleared price. Sourced from ISO market interface and ETRM system.' .

ind:LmpPrice rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Trading ;
    rdfs:label 'Lmp Price' ;
    rdfs:comment 'Market price records covering both spot Locational Marginal Prices (LMP) and forward price curves for all relevant pricing nodes, hubs, and zones across ISO/RTO markets. For spot prices: captures pricing node ID/name, node type (generator bus, load zone, hub, interface, trading hub), market (MISO/PJM/CAISO/SPP), market interval (hourly/5-min), operating date/hour, LMP ($/MWh), energy/congestion/loss components, and market type (DAM/RTM). For forward curves: captures curve date, commodity (power, gas, RECs, capacity, FTRs), delivery hub, tenor, forward price, curve source (ICE, CME, broker, internal), and confidence interval. Also serves as the master reference for pricing node identity (node ID, name, type, ISO, voltage level, geographic coordinates). Unified reference price source for trade settlement, MTM valuation, FTR valuation, and hedging analysis.' .

ind:Settlement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Trading ;
    rdfs:label 'Settlement' ;
    rdfs:comment 'Financial settlement record for completed trades, market transactions, and PPA deliveries. Captures settlement ID, settlement period, trade/contract reference, counterparty, commodity, settled volume, settlement price, gross settlement amount, netting adjustments, collateral applied, net payable/receivable, settlement status (preliminary, final, disputed), and payment due date. Integrates with SAP FI for accounts payable/receivable posting.' .

ind:MtmValuation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Trading ;
    rdfs:label 'Mtm Valuation' ;
    rdfs:comment 'Mark-to-market (MTM) valuation record capturing the fair value of open trading positions as of a specific valuation date. Captures valuation date, portfolio, commodity, delivery period, delivery point, open volume, forward price used, contract price, MTM value ($/MWh and total $), unrealized gain/loss, valuation methodology (forward curve, model), and curve source. Supports daily risk reporting, financial disclosure under ASC 815, and FERC market-based rate compliance.' .

ind:RiskLimit rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Trading ;
    rdfs:label 'Risk Limit' ;
    rdfs:comment 'Approved risk limit records defining maximum allowable exposure thresholds that are monitored independently of the portfolios they govern. Captures limit type (VaR, open position, stop-loss, credit exposure, tenor, Greeks), portfolio/desk/trader scope, commodity, limit value, limit currency, effective date, expiry date, approval authority (board, CRO, desk head), breach action (alert, block, escalate), current utilization percentage, breach history, and regulatory mandate reference (FERC, state PUC). Distinct from trading_portfolio because limits have their own approval lifecycle, can span multiple portfolios, and require independent audit trail for regulatory examination.' .

ind:HedgeProgram rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Trading ;
    rdfs:label 'Hedge Program' ;
    rdfs:comment 'Master record for formal hedging programs defining the utility\'s hedging strategy for generation output, fuel procurement, and load obligations. Captures program name, hedge type (generation output hedge, fuel cost hedge, load hedge, basis hedge), commodity, hedge ratio target (%), hedge horizon (months), approved volume range, instrument types allowed (swap, option, forward, futures), board approval date, and ASC 815 hedge designation (cash flow hedge, fair value hedge). Governs hedge execution and accounting treatment.' .

ind:RecTransaction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Trading ;
    rdfs:label 'Rec Transaction' ;
    rdfs:comment 'Renewable Energy Certificate (REC) transaction record capturing purchases, sales, retirements, and transfers of RECs. Captures REC transaction ID, transaction type (purchase, sale, retirement, transfer), REC vintage year, technology type (solar, wind, hydro, biomass), generation facility, state registry (WREGIS, NEPOOL-GIS, PJM-GATS), certificate serial numbers, quantity (MWh), price ($/REC), counterparty, transaction date, compliance program (RPS, voluntary), and retirement reason. Supports renewable portfolio standard (RPS) compliance tracking.' .

ind:AncillaryAward rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Trading ;
    rdfs:label 'Ancillary Award' ;
    rdfs:comment 'ISO/RTO ancillary services award record for capacity cleared in regulation, spinning reserve, non-spinning reserve, and voltage support markets. Captures award ID, market, operating day, hour/interval, service type (regulation up/down, spinning reserve, non-spin, reactive), resource ID, awarded MW, clearing price ($/MW), obligation start/end, performance score, and settlement amount. Supports ancillary revenue tracking and NERC reliability compliance.' .

ind:CreditExposure rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Trading ;
    rdfs:label 'Credit Exposure' ;
    rdfs:comment 'Time-series counterparty credit exposure record tracking daily current and potential future credit exposure calculations, distinct from the static credit profile on counterparty. Captures exposure date, counterparty, credit rating snapshot (S&P/Moodys as of date), approved credit limit, current mark-to-market exposure, potential future exposure (PFE) using Monte Carlo or parametric methods, collateral posted (cash/LC) and received, net exposure after collateral, credit utilization percentage, margin call threshold, days to margin call, and credit status (normal, watch, restricted, suspended). Serves as the time-series audit trail for credit decisions while counterparty holds the static credit profile.' .

ind:Meter rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Metering ;
    rdfs:label 'Meter' ;
    rdfs:comment 'Master record for every physical meter device deployed across the service territory, covering both electric (AMI/AMR) and gas meters. Stores device identity, manufacturer, model, firmware version, communication module type, meter form factor, voltage class, CT/PT ratios, dial multiplier, number of dials, seal number, AMI endpoint ID, communication protocol (ANSI C12.18/C12.19), installation status, and lifecycle state. Sourced from Oracle Utilities MDM and Maximo EAM. SSOT for meter asset identity in the metering domain.' .

ind:MeterConfiguration rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Metering ;
    rdfs:label 'Meter Configuration' ;
    rdfs:comment 'AMI device configuration record defining the programmed settings for each meter, including measurement channels, register configuration, TOU schedule assignment, demand interval length (15/30/60 min), load profile recording settings, outage detection thresholds, tamper detection flags, remote connect/disconnect capability flag, firmware version deployed, and last configuration push timestamp. Tracks the active configuration profile applied to a meter at any point in time. Supports TOU, RTP, and CPP rate structure configurations.' .

ind:MeterPremise rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Metering ;
    rdfs:label 'Meter Premise' ;
    rdfs:comment 'Time-bounded association record establishing which meter is installed at which metering service point, including NEM bidirectional metering configuration flags and net metering register indicators for customers with on-site generation' .

ind:MeteringServicePoint rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Metering ;
    rdfs:label 'Metering Service Point' ;
    rdfs:comment 'Master record for each utility service delivery point representing the fixed physical location where energy measurement occurs. Stores service point identifier, service address, GPS coordinates, premise type (residential/commercial/industrial), service voltage level, phase configuration (single/three-phase), distribution transformer reference, feeder reference, gas pressure zone, service type (electric/gas), NEM eligibility flag, and AMI communication attributes (endpoint serial, comm technology, signal strength, last communication timestamp). Unlike meter_premise which tracks which meter is installed where over time, this entity represents the permanent location itself. The SSOT for service point identity and AMI connectivity status within the metering domain.' .

ind:Register rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Metering ;
    rdfs:label 'Register' ;
    rdfs:comment 'Master record for each physical or logical register within a meter, representing a specific measurement channel (e.g., kWh delivered, kWh received, kVAR, kW demand, MCF, Therms). Stores register number, unit of measure (kWh/MCF/Therm/kW/kVAR), register type (energy/demand/reactive), TOU tier assignment, multiplier, number of digits, rollover value, and read sequence. A single meter may have multiple registers for bi-directional or multi-commodity measurement.' .

ind:RegisterRead rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Metering ;
    rdfs:label 'Register Read' ;
    rdfs:comment 'Transactional record capturing each physical or remote register reading event, including read date, read time, raw reading value, previous reading value, consumption calculated, read type (actual/estimated/customer-submitted/remote AMI), read source (field technician/AMI head-end/IVR), read quality code, and multiplier applied. Feeds billing with validated consumption quantities. Supports both electric (kWh, kW demand) and gas (MCF, Therms) register reads. Sourced from Oracle Utilities MDM.' .

ind:IntervalRead rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Metering ;
    rdfs:label 'Interval Read' ;
    rdfs:comment 'High-frequency interval energy measurement record captured by AMI meters at configured intervals (typically 15, 30, or 60 minutes). Stores energy delivered (kWh), energy received (kWh for NEM/DER customers), reactive energy (kVAR), demand (kW), gas volume (MCF/Therms), interval start timestamp, interval end timestamp, interval duration, channel number, raw measured value, and initial quality code before VEE processing. This is the foundational time-series dataset for TOU, RTP, and CPP rate calculations, load research, and demand analytics. Sourced from AMI head-end systems via OSIsoft PI Historian and loaded into Oracle Utilities MDM. Each record represents one measurement interval for one channel on one meter.' .

ind:VeeResult rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Metering ;
    rdfs:label 'Vee Result' ;
    rdfs:comment 'Validation, Estimation, and Editing (VEE) processing outcome record and the domain\'s consolidated data quality management entity. Each record represents a VEE processing result for an interval or register read, storing: original raw value, VEE rule applied, validation outcome (pass/fail/estimated/edited), estimation algorithm used (weather-based/similar-day/linear interpolation), edited value, processing timestamp, and override reason code. Also serves as the SSOT for all data quality issue tracking within the metering domain: captures issue type (spike/gap/negative/rollover/communication failure/anomalous consumption/missing reads), affected date range, number of affected intervals, assigned analyst, investigation notes, resolution status, resolution action taken, root cause classification, and escalation history. Supports both automated VEE pipeline outcomes and manual data quality investigation workflows. Core to Oracle Utilities MDM VEE processing, regulatory reporting on estimated bill percentages, and SLA compliance for data completeness.' .

ind:VeeRule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Metering ;
    rdfs:label 'Vee Rule' ;
    rdfs:comment 'Reference master for VEE validation and estimation rules configured in Oracle Utilities MDM. Stores rule name, rule type (validation/estimation/editing), rule category (spike/gap/negative/rollover/sum-check), threshold parameters, estimation method, applicable commodity (electric/gas), applicable rate class, effective date range, priority order, and active status. Governs the automated data quality processing pipeline for all interval and register read data.' .

ind:MeterEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Metering ;
    rdfs:label 'Meter Event' ;
    rdfs:comment 'Transactional record of operational events reported by AMI meters and head-end systems. Captures tamper alerts, power outage/restoration events, reverse energy flow detection, low battery alerts, communication failures, remote connect/disconnect commands and outcomes, meter state changes (installation/removal/in-service/retired), demand threshold alarms, and meter programming events. Stores event type code, event timestamp, event severity, meter ID, raw event payload, processing status, and resolution outcome. Serves as the consolidated event log for all meter-originated signals. Feeds OMS outage detection, CIP security monitoring, and meter lifecycle audit trail.' .

ind:MeterReadSchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Metering ;
    rdfs:label 'Meter Read Schedule' ;
    rdfs:comment 'Master record defining the scheduled meter reading cycle for each service point, including read cycle code, scheduled read date, read frequency (monthly/bi-monthly/daily AMI), read method (AMI remote/field walk/drive-by), route code and territory assignment, estimated read window, last actual read date, and route sequence for field operations. Governs both AMI polling schedules and manual field reading operations. Supports billing cycle alignment, read route optimization, and ClickSoftware WFM dispatch for remaining manual meter reading routes.' .

ind:TouSchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Metering ;
    rdfs:label 'Tou Schedule' ;
    rdfs:comment 'Reference master defining Time-of-Use (TOU) rate period schedules including season definitions (summer/winter/shoulder), day type classifications (weekday/weekend/holiday), on-peak and off-peak time windows, critical peak pricing (CPP) event eligibility windows, and real-time pricing (RTP) interval mappings. Stores schedule code, effective date range, applicable rate class, season start/end months, and tier period definitions. Governs how interval reads are bucketed into TOU tiers for billing determinant calculation.' .

ind:MeterTest rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Metering ;
    rdfs:label 'Meter Test' ;
    rdfs:comment 'Transactional record capturing the results of meter accuracy testing performed in the field or at a meter shop, including test type (in-service/shop/complaint-driven), test date, test technician, test equipment used, accuracy percentage at full load, accuracy at light load, power factor test result, pass/fail determination, ANSI standard applied (ANSI C12.1), error percentage, and corrective action taken. Required for regulatory compliance with PUC meter accuracy standards and customer dispute resolution.' .

ind:Line rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Line' ;
    rdfs:comment 'Master record for each high-voltage bulk electric system (BES) transmission line segment owned or operated by the utility. Captures line identifier, voltage class (kV), circuit designation, conductor type and size, thermal rating (MVA), length (miles), in-service date, NERC BES classification, FERC jurisdiction flag, RTO/ISO region, GIS route geometry, ownership percentage, and operational status. Serves as the SSOT for transmission line identity and physical characteristics. Referenced by topology, line_rating, outage, protection_relay, right_of_way, and contingency products.' .

ind:TransmissionSubstation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Transmission Substation' ;
    rdfs:comment 'Master record for each transmission-level substation facility including high-side and low-side voltage levels, substation type (switching, transformer, converter), GPS coordinates, GIS polygon reference, NERC CIP classification (high/medium/low impact), FERC facility ID, RTO/ISO node identifier, installed transformer capacity (MVA), number of bays, in-service date, and operational status. Serves as the SSOT for substation identity and topology within the transmission domain.' .

ind:TransmissionTransformer rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Transmission Transformer' ;
    rdfs:comment 'Master record for each power transformer installed at a transmission substation. Captures transformer tag number, manufacturer, model, MVA rating (normal/emergency), primary and secondary voltage (kV), impedance (%), cooling type (ONAN/ONAF/OFAF), oil volume, tap changer type, NERC BES flag, in-service date, last test date, and condition rating. Linked to substation and Maximo EAM asset record. Distinct from distribution transformers owned by the distribution domain.' .

ind:Topology rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Topology' ;
    rdfs:comment 'Represents the network connectivity model (bus-branch model) of the bulk electric system used by EMS, power flow solvers, and state estimation. Each record defines a directed branch (from-bus to to-bus) with associated transmission line or transformer, impedance parameters (R, X, B in per-unit), line charging, transformer tap ratio, and topology version effective date. Includes time-stamped power flow solution snapshots capturing system MW, MVAR, losses, convergence status, and interchange conditions for post-event analysis and NERC reliability assessments. Supports SCADA-driven real-time network model updates, RTO/ISO contingency analysis, and IRP planning inputs. Sourced from GE PowerOn EMS and OSIsoft PI Historian.' .

ind:Bus rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Bus' ;
    rdfs:comment 'Master record for each electrical bus node in the transmission network model. Captures bus name, bus number (EMS/SCADA identifier), substation association, nominal voltage (kV), bus type (PQ, PV, slack/reference), area and zone assignment, RTO/ISO pricing node (pnode) identifier for LMP settlement, and active status. Forms the node set of the bus-branch topology model used in power flow, state estimation, and contingency analysis. Each bus maps to a physical location within a substation. Sourced from GE PowerOn EMS.' .

ind:LineRating rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Line Rating' ;
    rdfs:comment 'Stores seasonal, static, and dynamic thermal ratings for each transmission line segment expressed in MVA and amperes. Captures rating type (normal, long-time emergency, short-time emergency), season or ambient temperature band, conductor temperature limit, wind speed and solar assumptions, rating effective date range, rating methodology (static vs. dynamic line rating — DLR via sensors or weather models), and issuing authority. Supports real-time congestion management, N-1 contingency analysis, FERC Order 881 ambient-adjusted ratings compliance, and capacity allocation for transmission service requests.' .

ind:TransmissionOutage rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Transmission Outage' ;
    rdfs:comment 'Transactional record of each planned or forced outage event on a transmission facility (line, transformer, bus, or substation). Captures outage request number, facility affected, outage type (planned maintenance, forced/unplanned, emergency), cause code, NERC outage cause category, requested start/end datetime, actual start/end datetime, MW/MVA impact, affected RTO/ISO market window, NERC OE-417 reportability flag, and restoration details. Sourced from GE PowerOn OMS and coordinated with RTO/ISO outage scheduling.' .

ind:PowerFlowSnapshot rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Power Flow Snapshot' ;
    rdfs:comment 'Time-stamped operational snapshot of power flow conditions across the transmission network captured from the EMS/SCADA state estimator. Each record represents a solved power flow case at a specific timestamp including system MW load, system MVAR, total generation dispatch, interchange schedules, transmission losses, and convergence status. Supports post-event analysis, NERC reliability assessments, and IRP planning inputs. Sourced from OSIsoft PI Historian via GE PowerOn EMS.' .

ind:InterchangeSchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Interchange Schedule' ;
    rdfs:comment 'Records of energy interchange transactions scheduled across the transmission system between control areas, RTO/ISO markets, and neighboring utilities. Captures schedule ID, counterparty control area, direction (import/export), scheduled MW profile by hour, energy type (firm/non-firm), FERC tariff service type (network, point-to-point), contract path, e-Tag reference number, market (DAM/RTM), and settlement period. Supports FERC tariff compliance and RTO/ISO scheduling coordination.' .

ind:ServiceRequest rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Service Request' ;
    rdfs:comment 'Records of transmission service requests filed under the FERC Open Access Transmission Tariff (OATT) and their full lifecycle from request through scheduled interchange. Captures request ID, requesting entity, service type (network integration, firm/non-firm point-to-point), points of receipt/delivery, requested capacity (MW), FERC queue position, study statuses, and approval decision. For approved requests, also captures scheduled interchange transactions including counterparty control area, direction (import/export), MW profile by hour, energy type (firm/non-firm), e-Tag reference number, market type (DAM/RTM), contract path, and settlement period. Supports FERC tariff compliance, RTO/ISO scheduling coordination, transmission service lifecycle tracking, and interchange accounting.' .

ind:Tariff rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Tariff' ;
    rdfs:comment 'Master record for each FERC-approved transmission tariff schedule and rate on file. Captures tariff name, FERC tariff number, tariff type (OATT, OASIS, wheeling), service category, rate zone, transmission rate ($/kW-month or $/MWh), ancillary service charges, effective date, expiration date, FERC docket number, and approval status. Serves as the SSOT for transmission tariff rates used in billing, LMP settlement, and FERC compliance reporting.' .

ind:InterconnectionAgreement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Interconnection Agreement' ;
    rdfs:comment 'Master record for each generator or large customer interconnection agreement executed under FERC interconnection procedures. Captures agreement ID, interconnecting party name, FERC queue number, interconnection type (generator, load, network upgrade), point of interconnection (substation and voltage), interconnection capacity (MW), network upgrades required, cost responsibility allocation, agreement execution date, FERC acceptance date, and commercial operation date. Distinct from energy trading PPAs owned by the trading domain.' .

ind:Contingency rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Contingency' ;
    rdfs:comment 'Master record for each defined N-1 or N-2 contingency scenario used in transmission planning and real-time security assessment. Captures contingency name, type (single, double, common mode), elements removed, NERC TPL category, planning horizon, violation thresholds, and last study date. Includes violation detail records from analysis runs capturing thermal overloads, voltage deviations, or stability limit violations with violated element, pre/post-contingency loading (% of rating), violation severity, EMS case identifier, and recommended corrective action. Supports NERC TPL compliance documentation, real-time operator alerts, and corrective action plan tracking.' .

ind:ContingencyViolation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Contingency Violation' ;
    rdfs:comment 'Transactional record of each thermal, voltage, or stability violation identified during contingency analysis runs (real-time or study mode). Captures contingency reference, violated element, violation type (thermal overload, voltage deviation, stability limit), pre-contingency and post-contingency loading (% of rating), violation severity, analysis run timestamp, EMS case identifier, and recommended corrective action. Supports NERC TPL compliance documentation and real-time operator alerts.' .

ind:ProtectionRelay rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Protection Relay' ;
    rdfs:comment 'Master record for each protective relay device installed on transmission facilities including full test and maintenance history. Captures relay tag, type (distance, differential, overcurrent, pilot), manufacturer, model, firmware, protected element, zone of protection, trip settings, NERC CIP-007 BES cyber asset classification, and condition status. Includes test event records capturing periodic maintenance, post-trip, and commissioning tests with test date, technician crew, results (pass/fail per function), measured operating time (ms), as-found/as-left settings, NERC PRC-005 compliance interval met flag, and next scheduled test date. Supports NERC PRC-005 maintenance interval compliance and Maximo EAM maintenance workflows.' .

ind:RelayTestEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Relay Test Event' ;
    rdfs:comment 'Transactional record of each protection relay test or maintenance activity performed on a transmission protection relay. Captures test date, test type (periodic maintenance, post-trip, commissioning), technician crew reference, test results (pass/fail per function), measured operating time (ms), as-found and as-left settings, NERC PRC-005 compliance interval met flag, and next scheduled test date. Supports NERC PRC-005 maintenance interval compliance tracking.' .

ind:RightOfWay rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Right Of Way' ;
    rdfs:comment 'Master record for each transmission right-of-way (ROW) corridor including full vegetation management inspection history. Captures ROW identifier, associated transmission line(s), width, acreage, land ownership type, grantor, recorded document reference, GIS polygon, vegetation management zone classification, and encroachment status. Includes inspection detail records for each vegetation survey (aerial, ground, LiDAR) with inspection date, inspector crew, encroachment findings count, critical grow-in and flash-over risk trees identified, NERC FAC-003 compliance status, corrective work order reference, and next inspection due date. Serves as the SSOT for land rights and NERC FAC-003 vegetation management compliance documentation.' .

ind:VegetationInspection rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Vegetation Inspection' ;
    rdfs:comment 'Transactional record of each vegetation management inspection or clearance survey conducted along a transmission ROW. Captures inspection date, ROW segment inspected, inspection method (aerial, ground, LiDAR), inspector crew reference, number of encroachment findings, critical grow-in risk trees identified, flash-over risk trees identified, NERC FAC-003 compliance status, corrective work order reference, and next inspection due date. Supports NERC FAC-003 annual compliance documentation.' .

ind:PlanningStudy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Planning Study' ;
    rdfs:comment 'Master record for each transmission planning study conducted to assess system adequacy, reliability, or interconnection impacts. Captures study name, study type (NERC TPL, IRP, interconnection feasibility, system impact, facilities), study year, planning horizon (years), study scope (regional, local, BES), software tool used (PSS/E, PowerWorld), key assumptions (load forecast, generation mix), study findings summary, NERC TPL category addressed, and approval status. Supports IRP filings and FERC interconnection queue management.' .

ind:TransmissionSwitchingOrder rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Transmission Switching Order' ;
    rdfs:comment 'Transactional record of each switching order issued to field operators for reconfiguring the transmission network topology (opening/closing breakers, disconnects, or switches). Captures switching order number, issuing control center operator, associated outage or maintenance work order, sequence of switching steps, each step\'s device tag and action (open/close), safety clearance reference, pre-switching and post-switching topology state, execution start/end timestamp, and completion status. Sourced from GE PowerOn DMS/OMS.' .

ind:CustomerAccount rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Customer ;
    rdfs:label 'Customer Account' ;
    rdfs:comment 'Core master entity representing a customer account in Oracle CC&B (CIS). Serves as the SSOT for all customer account identities and relationships across residential, commercial, and industrial (RCI) segments. Captures account type (electric, gas, dual-fuel), account status lifecycle (active, pending, suspended, closed, written-off), credit class, account open/close dates, CIS account number, Salesforce account ID, and billing address of record. The primary anchor entity for billing, metering, service delivery, and collections relationships. Supports account status history tracking for regulatory audit trails required by state PUC rules.' .

ind:Person rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Customer ;
    rdfs:label 'Person' ;
    rdfs:comment 'Master identity record for individual persons associated with customer accounts, including residential customers, authorized contacts, and guarantors. Captures legal name, date of birth, government ID type and masked number, language preference, and identity verification status. Distinct from the account entity — a single person may hold multiple accounts. Sourced from Oracle CC&B and Salesforce CRM.' .

ind:BusinessEntity rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Customer ;
    rdfs:label 'Business Entity' ;
    rdfs:comment 'Master record for commercial and industrial (C&I) customer organizations including corporations, LLCs, government agencies, and non-profits. Captures legal business name, DBA name, federal tax ID (EIN), NAICS industry code, business type, Dun & Bradstreet number, Salesforce account ID, and credit rating. Supports large commercial and key account management workflows distinct from residential person records.' .

ind:Premise rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Customer ;
    rdfs:label 'Premise' ;
    rdfs:comment 'Physical location (property) at which utility service is delivered. Represents the geographic and structural unit of service delivery — a building, parcel, or metered location. Captures street address, city, state, ZIP+4, county, census tract, GIS coordinates (latitude/longitude), premise type (residential, commercial, industrial, agricultural), construction type, lot size, number of dwelling units, and ArcGIS feature ID. Serves as the SSOT for service location geography shared with the distribution and metering domains. Supports service territory eligibility validation and regulatory reporting by geographic boundary.' .

ind:CustomerServicePoint rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Customer ;
    rdfs:label 'Customer Service Point' ;
    rdfs:comment 'Logical utility service delivery point at a premise representing the connection between the distribution network and the customer. Each service point is associated with a commodity type (electric or gas), service voltage class, load profile type, and distribution circuit. Links the premise to the meter and to the rate schedule. Sourced from Oracle CC&B and GE PowerOn DMS. Distinct from the meter device itself — a service point may have multiple meters over its lifetime. The anchor entity for usage measurement and service delivery at a specific physical connection.' .

ind:ServiceAgreement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Customer ;
    rdfs:label 'Service Agreement' ;
    rdfs:comment 'Active contractual relationship between a customer account and a utility service at a specific service point under a defined rate schedule. Captures service agreement start and end dates, commodity type (electric/gas), rate schedule code, billing cycle, deposit amount, service agreement status (active, pending, stopped), and CIS service agreement ID. Represents the enrollment instance — the binding of account + service point + rate. Distinct from the rate schedule catalog owned by the product domain.' .

ind:Contact rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Customer ;
    rdfs:label 'Contact' ;
    rdfs:comment 'Master record for individuals associated with a customer account or business entity, encompassing identity, contact methods, communication preferences, and consent management. Captures contact role (primary holder, co-applicant, authorized representative, emergency contact), preferred contact method, phone numbers, email address, mailing address, preferred language, and Salesforce contact ID. Includes per-channel communication preferences and opt-in/opt-out consent flags for each notification category (bill ready, outage alert, payment confirmation, DR event, regulatory notice) across channels (email, SMS, IVR, paper mail, mobile push), with consent timestamps. Supports TCPA compliance, PUC-mandated customer notification requirements, and CRM-driven outreach.' .

ind:Enrollment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Customer ;
    rdfs:label 'Enrollment' ;
    rdfs:comment 'Unified transactional and master record capturing a customer\'s enrollment, participation, and disenrollment lifecycle in any utility program, tariff rider, or special service offering. Program types include: NEM (Net Energy Metering) with interconnection attributes (system capacity kW-DC, inverter type, export limit, NEM version, true-up period, annual true-up date); DR (Demand Response) with dispatch attributes (enrolled load kW, curtailment obligation, control method, notification lead time, ISO/RTO registration reference); budget billing with levelized payment attributes (monthly amount, true-up balance, review date, calculation basis); TOU, CPP, auto-pay, paperless billing, CARE/FERA, and LIHEAP assistance programs. Core attributes across all types: enrollment date, effective date, program code, program type discriminator, enrollment channel (web, call center, field), enrollment status lifecycle, cancellation reason, and associated service agreement reference. Distinct from the program catalog owned by the product domain. Supports polymorphic conditional attributes by program type.' .

ind:MoveOrder rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Customer ;
    rdfs:label 'Move Order' ;
    rdfs:comment 'Transactional record representing a customer-initiated move-in, move-out, or transfer-of-service event. Captures requested start/stop date, old and new service point references, move type (move-in, move-out, move-within), order status, final read date, and processing channel. Drives the start/stop service workflow in Oracle CC&B and triggers meter read orders in the MDM system. A key lifecycle event in the customer enrollment process.' .

ind:AccountRelationship rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Customer ;
    rdfs:label 'Account Relationship' ;
    rdfs:comment 'Association entity capturing structured relationships between customer accounts and persons or business entities, including account holder, co-applicant, guarantor, third-party notification, landlord-tenant (with reversion terms and blanket deposit waiver), and authorized representative relationships. Captures relationship type, effective start and end dates, authorization level, notification preferences, and relationship-specific attributes (e.g., landlord reversion date, deposit waiver flag). Supports complex household hierarchies, commercial account structures, and multi-family property management workflows. Carries its own business attributes beyond a simple FK, justifying standalone entity status.' .

ind:Segment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Customer ;
    rdfs:label 'Segment' ;
    rdfs:comment 'Classification entity defining the market segmentation taxonomy applied to customer accounts for rate design, demand-side management targeting, and regulatory reporting. Captures segment code, segment name, segment tier (RCI: residential, commercial, industrial), sub-segment (e.g., small commercial, large industrial, agricultural), load profile class, AMI eligibility flag, and DR program eligibility. Used by billing, product, and engagement domains for targeted program delivery.' .

ind:CommunicationPreference rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Customer ;
    rdfs:label 'Communication Preference' ;
    rdfs:comment 'Master record of a customer\'s explicit communication channel preferences and consent flags for each notification category. Captures preferred language, preferred channel per notification type (bill ready, outage alert, payment confirmation, DR event notification, regulatory notice), opt-in/opt-out status per channel (email, SMS, IVR, paper mail, mobile app push), and consent timestamp. Supports TCPA compliance and PUC-mandated customer notification requirements.' .

ind:CreditProfile rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Customer ;
    rdfs:label 'Credit Profile' ;
    rdfs:comment 'Master record of a customer\'s credit standing and deposit management data as maintained in Oracle CC&B. Captures credit class, credit score band, deposit amount on file, deposit type (cash, surety bond, letter of credit), deposit waiver reason, credit review date, payment history score, and collections status flag. Supports credit risk assessment for new service applications and annual deposit review workflows mandated by state PUC tariff rules.' .

ind:MedicalBaseline rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Customer ;
    rdfs:label 'Medical Baseline' ;
    rdfs:comment 'Master record tracking customers enrolled in medical baseline or life support programs that entitle them to reduced rates or special service protections under state PUC rules. Captures program type (medical baseline allowance, life support equipment, serious illness), certification date, recertification due date, physician certification flag, equipment type (oxygen concentrator, dialysis, etc.), and disconnection protection status. Critical for regulatory compliance with PUC disconnection moratorium rules.' .

ind:ThirdPartyAccess rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Customer ;
    rdfs:label 'Third Party Access' ;
    rdfs:comment 'Master record governing authorized third-party access to customer account data and usage information, including energy advisors, solar installers, EV charging providers, DERMS aggregators, and retail energy marketers. Captures third-party entity name, authorization scope (usage data, billing data, account data), data sharing start and end dates, customer consent timestamp, consent channel, and revocation status. Supports Green Button Connect My Data (CMD) and FERC Order 2222 DER aggregator access requirements.' .

ind:NemAgreement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Customer ;
    rdfs:label 'Nem Agreement' ;
    rdfs:comment 'Master record for Net Energy Metering (NEM) interconnection agreements between the utility and customers with customer-sited generation (rooftop solar, small wind, fuel cells). Captures NEM program version (NEM 1.0, NEM 2.0, NEM 3.0/NEM-ST), interconnection application date, approval date, system capacity (kW-DC), inverter type, export limit (kW), true-up period, annual true-up date, and interconnection agreement status. Distinct from the general enrollment entity — NEM carries unique interconnection and export attributes.' .

ind:DrEnrollment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Customer ;
    rdfs:label 'Dr Enrollment' ;
    rdfs:comment 'Master record for a customer\'s active enrollment in a Demand Response (DR) or load management program, including interruptible service, direct load control, automated demand response (Auto-DR), and virtual power plant (VPP) participation. Captures DR program code, enrolled load (kW), curtailment obligation (kW), notification lead time (minutes), control method (direct switch, smart thermostat, customer-controlled), enrollment effective date, and ISO/RTO registration reference. Distinct from the general enrollment entity due to operational dispatch attributes.' .

ind:BudgetBillingPlan rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Customer ;
    rdfs:label 'Budget Billing Plan' ;
    rdfs:comment 'Master record for customers enrolled in a budget billing (levelized payment) plan that smooths monthly bill amounts over a 12-month period. Captures monthly budget amount, plan start date, plan review date, cumulative true-up balance (over/under), true-up month, plan status (active, suspended, cancelled), and the calculation basis (prior 12-month average usage). Supports billing domain workflows and customer financial assistance program tracking.' .

ind:ServiceTerritory rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Customer ;
    rdfs:label 'Service Territory' ;
    rdfs:comment 'Reference entity defining the utility\'s certificated service territory boundaries including electric and gas franchise areas, county and municipal boundaries, rate zone designations, and regulatory jurisdiction assignments. Captures territory code, territory name, commodity type (electric/gas), state jurisdiction, PUC/PSC docket reference, effective date, and GIS polygon reference. Used for customer enrollment eligibility validation, service application processing, and regulatory reporting boundary definitions. Domain ownership under review — may relocate to shared reference domain in future iterations.' .

ind:Bill rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Bill' ;
    rdfs:comment 'Core billing document representing the periodic invoice issued to a residential or commercial customer for energy consumption (kWh, MCF, Therm) and applicable charges. Captures billing period, due date, total amount due, bill type (regular, final, corrected), bill status, and source system reference from Oracle CC&B. Serves as the SSOT for all customer-facing billing documents and is the anchor entity for revenue recognition per FASB ASC 980.' .

ind:BillLineItem rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Bill Line Item' ;
    rdfs:comment 'Individual charge or credit line on a customer bill, representing a specific rate component application with its calculated billing determinant. Captures charge type, rate schedule code, rate component reference, determinant type, quantity (kWh, MCF, Therm, kW demand), unit rate, extended amount, TOU period classification, estimation flag, read start/end dates, and number of billing days. Supports granular revenue decomposition, GRC rate case analysis, and bridges validated meter data to billed amounts.' .

ind:Payment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Payment' ;
    rdfs:comment 'Record of a customer payment transaction applied against outstanding bill balances. Captures payment date, payment method (check, ACH, credit card, cash, auto-pay), payment amount, tender type, payment source channel (web, IVR, walk-in, lockbox), and posting status. Integrates with SAP FI/CO for revenue posting and Oracle CC&B for balance application. SSOT for all customer payment events.' .

ind:PaymentArrangement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Payment Arrangement' ;
    rdfs:comment 'Formal installment plan, deferred payment agreement, or budget billing (levelized billing) plan established for customers. Captures arrangement type (installment plan, deferred payment agreement, budget billing), scheduled amounts, due dates, total deferred or levelized balance, arrangement status, default/breach tracking, and for budget billing: estimated annual usage, monthly budget amount, true-up frequency, true-up date, and cumulative variance. Supports collections workflow, customer hardship program management, and residential affordability through payment smoothing.' .

ind:BillingAccount rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Billing Account' ;
    rdfs:comment 'Financial account entity representing the billable customer relationship for energy service delivery. Captures account number, account class (residential, commercial, industrial), billing cycle assignment, budget billing enrollment, paperless billing preference, auto-pay enrollment, credit score, deposit balance, current account balance, and current arrears balance. Serves as the SSOT for customer account balance and arrears tracking — all monetary movements (bills, payments, adjustments, deposits) update this entity\'s balance fields. Anchor for all billing transactions and the billing-domain counterpart to the customer master. One customer may have multiple billing accounts across service locations.' .

ind:BillingRateComponent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Billing Rate Component' ;
    rdfs:comment 'Individual pricing component within a rate schedule, defining the specific charge calculation rules for energy (kWh), demand (kW), gas (MCF/Therm), fixed customer charges, taxes, and riders. Captures component type, unit of measure, block tier thresholds, seasonal applicability, rate amount, calculation algorithm reference, and TOU period classification (period name, season, day type, start/end times for on-peak, mid-peak, off-peak, super-peak, critical peak). Enables granular bill calculation, TOU/CPP/RTP interval billing, and rate case modeling.' .

ind:Cycle rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Cycle' ;
    rdfs:comment 'Definition and execution history of a billing cycle group that governs the schedule for meter reading, bill generation, and due date calculation for a set of accounts. Captures cycle code, cycle name, read frequency (monthly, bi-monthly), scheduled read date, bill generation date, bill due date offset (days), number of accounts in cycle, and batch run execution history (run date, accounts processed, bills generated, errors, run status). Used to orchestrate mass billing runs, manage billing workload distribution, and provide operational audit trail of billing execution.' .

ind:Adjustment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Adjustment' ;
    rdfs:comment 'Financial adjustment, write-off, or credit applied to a customer billing account to correct errors, apply credits, process bad debt write-offs, issue goodwill credits, or record rebates. Captures adjustment type (credit, debit, write-off, rebate, goodwill, bad_debt), reason code, amount, affected billing period, approval status, approver, and for write-offs: write-off date, delinquency age, prior collection actions taken, recovery status, and SAP FI/CO bad debt expense posting reference. Supports revenue correction workflows, bad debt reserve calculations for GRC filings, and FASB ASC 980 revenue recognition adjustments. Serves as the SSOT for all balance corrections including uncollectable account write-offs.' .

ind:Deposit rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Deposit' ;
    rdfs:comment 'Security deposit held by the utility against a customer account to mitigate credit risk. Captures deposit amount, deposit type (cash, surety bond, letter of credit), deposit date, interest accrual rate, interest accrual method, refund eligibility date, refund status, and regulatory basis (PUC deposit rules). Tracks the full lifecycle from collection through interest posting to refund or application against final bill.' .

ind:Dispute rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Dispute' ;
    rdfs:comment 'Formal customer billing dispute record tracking a customer\'s challenge to a billed amount, rate application, or meter read. Captures dispute type, disputed bill reference, disputed amount, dispute reason, dispute open date, resolution date, resolution type (upheld, denied, partial credit), resolution amount, and regulatory escalation flag (PUC complaint). Supports customer dispute resolution workflow and regulatory complaint tracking.' .

ind:CollectionAction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Collection Action' ;
    rdfs:comment 'Record of a collections action taken against a delinquent customer billing account, including dunning notices, disconnect warnings, field disconnect orders, payment arrangement offers, and agency referrals. Captures action type (dunning letter, disconnect notice, field order, agency referral, service termination), action date, delinquent amount at action time, days past due, response received flag, next action scheduled date, and regulatory compliance flags (winter moratorium, medical certificate hold, COVID protection). Supports the end-to-end collections lifecycle, regulatory disconnect moratorium compliance, and bad debt forecasting.' .

ind:Assistance rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Assistance' ;
    rdfs:comment 'Customer enrollment record in a utility assistance program (LIHEAP, CARE, FERA, medical baseline, or utility-specific hardship programs). Captures program code, program name, eligibility criteria reference, enrollment date, expiration date, recertification due date, benefit type (percentage discount, fixed credit, arrears forgiveness), benefit amount or discount rate, enrollment status, income verification status, household size, and program-specific eligibility documentation flags. Tracks active participation of individual billing accounts in assistance programs, drives automated bill credit application, and supports PUC-mandated program participation reporting.' .

ind:Vendor rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Vendor' ;
    rdfs:comment 'Master record for all suppliers, contractors, and service providers in the utility supply chain. Captures vendor identity, classification (fuel supplier, equipment OEM, contractor, MRO distributor), tax identifiers, remittance details, diversity certifications (MBE/WBE/SBE), bonding and insurance status, and FERC/NERC compliance flags. Encompasses the full vendor lifecycle including pre-qualification assessment, approved vendor list (AVL) management, qualification status, commodity categories approved, safety record, financial stability rating, insurance certificate expiry, bonding limit, NERC CIP compliance status, diversity classification, and qualification review scheduling. Serves as the SSOT for vendor identity, qualification, and approved-supplier status within the supply domain.' .

ind:MaterialMaster rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Material Master' ;
    rdfs:comment 'Authoritative catalog of all materials, spare parts, equipment components, and consumables managed in the utility supply chain. Captures material number, description, material group, unit of measure, plant-specific data, MRP type, valuation class, hazardous material flags, and UNSPSC commodity code. Covers MRO parts, generation fuel materials, T&D equipment components, and storm restoration inventory items. Serves as the single reference for material identity, classification, and planning parameters across procurement, inventory, and maintenance processes.' .

ind:PurchaseOrder rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Purchase Order' ;
    rdfs:comment 'Core procurement transaction representing a formal commitment to a vendor for materials, equipment, fuel, or services. Encompasses header-level data (PO number, type, vendor, plant, purchasing organization, total value, currency, payment terms, approval status) and all line-level detail (line number, material, quantity ordered, unit price, delivery date, account assignment to cost center/WBS element/asset, plant, storage location, goods receipt indicator). Supports standard, blanket, framework, and service PO types. Covers CAPEX project material procurement, fuel supply, O&M materials, and contractor services. Links to requisition as upstream demand signal and to goods_receipt/invoice_verification for downstream fulfillment and three-way match.' .

ind:PoLineItem rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Po Line Item' ;
    rdfs:comment 'Individual line-level detail of a purchase order, representing a specific material or service being procured. Captures line number, material number, quantity ordered, unit price, delivery date, account assignment (cost center, WBS element, asset), plant, storage location, and goods receipt indicator. Enables line-level tracking of CAPEX material staging, fuel deliveries, and MRO parts procurement.' .

ind:GoodsReceipt rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Goods Receipt' ;
    rdfs:comment 'Records the physical receipt and acceptance of all materials, equipment, fuel deliveries, and contractor services against purchase orders at utility plants, warehouses, and staging yards. Captures document number, posting date, receipt type, quantity received, unit of measure, storage location, plant, movement type, and quality inspection status. For generation fuel deliveries: captures fuel type, BTU content, sulfur/ash content (coal), calorific value, supplier, carrier, pipeline nomination confirmation, and EIA-923 reporting fields. For nuclear fuel: captures fuel assembly serial numbers and NRC chain-of-custody documentation. Triggers inventory update and three-way match for invoice verification. Serves as the single source of truth for ALL receipt events across the utility — MRO parts, CAPEX equipment, fuel delivery confirmation at generation plants, and contractor service acceptance.' .

ind:InventoryStock rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Inventory Stock' ;
    rdfs:comment 'Real-time and period-end inventory stock positions for materials across all utility plants, warehouses, substations, and staging yards. Captures material, plant, storage location, stock type (unrestricted, quality inspection, blocked, in-transit, storm reserve), quantity on hand, unit of measure, valuation amount, price control method (standard vs. moving average), current unit price, reorder point, safety stock level, and last physical count date/variance. Supports storm restoration readiness (including designated reserve quantities and replenishment triggers), CAPEX project material staging visibility, generation fuel inventory management, and regulatory asset base reporting.' .

ind:StockMovement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Stock Movement' ;
    rdfs:comment 'Transactional log of all material movements within and between utility storage locations including goods issues, transfers, returns, scrapping, and physical inventory count adjustments. Captures movement type, material, quantity, source and destination plant/storage location, posting date, reference document, cost center, WBS element, and count variance details for inventory reconciliation postings. Provides full audit trail for inventory changes supporting O&M cost tracking, CAPEX project material consumption, annual inventory reconciliation, and storm restoration readiness audits.' .

ind:ProcurementContract rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Procurement Contract' ;
    rdfs:comment 'Long-term supply agreements and framework contracts with vendors covering fuel supply (coal, natural gas, uranium), equipment, and services. Captures contract number, contract type (value contract, quantity contract, scheduling agreement), vendor, validity period, total contract value, commodity, pricing conditions, renewal terms, and regulatory filing references (e.g., FERC-jurisdictional gas supply contracts). Distinct from trading PPAs which are owned by the trading domain.' .

ind:FuelSupplySchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Fuel Supply Schedule' ;
    rdfs:comment 'Planned and confirmed delivery schedules for generation fuels (coal, natural gas, uranium/nuclear fuel) from suppliers to generation plants. Captures schedule number, fuel type, supplier, generation plant, scheduled delivery date, quantity (tons, MCF, or fuel assemblies), transportation mode, pipeline/rail/barge carrier, and confirmation status. Supports generation dispatch planning and IRP fuel cost modeling.' .

ind:FuelReceipt rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Fuel Receipt' ;
    rdfs:comment 'Records actual delivery and receipt of generation fuels at plant gate including coal yard receipts, natural gas pipeline nominations confirmed, and nuclear fuel assembly deliveries. Captures receipt date, fuel type, quantity received (tons, MCF, MWh equivalent), BTU content, sulfur content, ash content (coal quality), calorific value, supplier, carrier, and EIA-923 reporting fields. Feeds generation cost accounting and regulatory fuel cost reporting.' .

ind:Requisition rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Requisition' ;
    rdfs:comment 'Internal purchase requisition initiated by utility departments (generation, T&D, asset management, workforce) requesting procurement of materials or services. Captures requisition number, requester, department, cost center, WBS element, material or service description, quantity, estimated value, required delivery date, and approval workflow status. Precedes and triggers purchase order creation. Supports both planned procurement (maintenance schedules, project material lists) and unplanned/emergency requests (storm restoration, equipment failure).' .

ind:Rfq rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Rfq' ;
    rdfs:comment 'Manages the full competitive sourcing lifecycle from Request for Quotation issuance through vendor bid submission, evaluation, and award. Captures RFQ number, commodity description, issuing purchasing organization, bid submission deadline, evaluation criteria, invited vendors, and status. Encompasses all vendor-submitted quotations as child records including quotation number, line-item pricing, validity period, delivery lead time, payment terms, and technical compliance scoring. Enables price comparison, vendor selection, and least-cost procurement analysis for rate case filings. Supports competitive procurement for major CAPEX equipment, fuel supply contracts, and storm restoration services.' .

ind:VendorQuotation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Vendor Quotation' ;
    rdfs:comment 'Vendor-submitted price quotation in response to an RFQ. Captures quotation number, vendor, RFQ reference, line-item pricing, validity period, delivery lead time, payment terms, and technical compliance notes. Enables price comparison and vendor selection for procurement awards. Supports least-cost procurement analysis for rate case filings.' .

ind:VendorPerformance rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Vendor Performance' ;
    rdfs:comment 'Periodic supplier performance evaluation records tracking delivery reliability, quality, pricing compliance, and service levels for utility vendors. Captures evaluation period, vendor, commodity category, on-time delivery rate, quality rejection rate, invoice accuracy rate, safety incident count, overall score, and corrective action status. Supports vendor qualification, contract renewal decisions, and supply chain risk management.' .

ind:InvoiceVerification rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Invoice Verification' ;
    rdfs:comment 'Logistics invoice verification records matching vendor invoices against purchase orders and goods receipts (three-way match). Captures invoice document number, vendor, invoice date, PO reference, GR reference, invoiced amount, tax amount, payment block status, discrepancy type, and posting status. Enables automated and manual matching for payment release. Distinct from financial AP invoices owned by the finance domain — this product owns the procurement-side matching logic and discrepancy resolution.' .

ind:Warehouse rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Warehouse' ;
    rdfs:comment 'Master record for utility warehouses, storerooms, laydown yards, staging areas, and mobile storm trailers where materials and equipment are stored. Captures warehouse number, description, location (plant, address, GIS coordinates), warehouse type (central, field, mobile), capacity, climate control flag, hazmat storage certification, responsible cost center, and granular storage locations within (bins, racks, yards with capacity and utilization tracking). Supports inventory positioning for storm restoration, CAPEX project staging, and generation plant fuel storage areas.' .

ind:Shipment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Shipment' ;
    rdfs:comment 'Inbound and outbound logistics shipment records tracking the physical movement of materials and equipment to/from utility facilities. Captures shipment number, carrier, origin, destination, ship date, expected arrival, actual arrival, freight cost, transportation mode (truck, rail, barge, pipeline), tracking number, and hazmat placard requirements. Supports fuel delivery logistics and CAPEX equipment delivery tracking.' .

ind:ServiceEntrySheet rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Service Entry Sheet' ;
    rdfs:comment 'Confirmation of services rendered by contractors and service vendors against a service purchase order. Captures entry sheet number, service PO reference, vendor, service description, quantity of service units performed, acceptance status, approver, and posting date. Required for contractor payment processing. Covers field construction services, vegetation management, meter installation, and storm restoration labor.' .

ind:VendorQualification rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Vendor Qualification' ;
    rdfs:comment 'Vendor pre-qualification and approved vendor list (AVL) records capturing the formal assessment of a vendor\'s capability to supply materials or services to the utility. Captures qualification status, commodity categories approved, safety record, financial stability rating, insurance certificate expiry, bonding limit, NERC CIP compliance status, diversity classification, and qualification review date.' .

ind:RateSchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Product ;
    rdfs:label 'Rate Schedule' ;
    rdfs:comment 'Master catalog of all electric and gas rate schedules filed with state PUCs. Each record defines a tariff code (e.g., RS-1, GS-2, TOU-D), service type (electric/gas), customer class (residential, commercial, industrial), effective and expiration dates, regulatory approval status, and the PUC docket reference. Serves as the SSOT for rate code definitions consumed by the billing rate engine and customer enrollment systems.' .

ind:ProductTariffRider rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Product ;
    rdfs:label 'Product Tariff Rider' ;
    rdfs:comment 'Catalog of all tariff riders and surcharges that supplement base rate schedules, including fuel adjustment clauses (FAC), renewable portfolio standard (RPS) riders, infrastructure surcharges, low-income assistance riders, and transmission cost adjustment riders. Tracks rider code, description, applicable rate schedules, calculation method (per-kWh, per-therm, fixed), effective dates, and PUC filing reference. Riders are additive to base rates and must be versioned independently.' .

ind:ProductRateComponent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Product ;
    rdfs:label 'Product Rate Component' ;
    rdfs:comment 'Granular decomposition of a rate schedule into its individual charge components: customer charge, energy charge (per kWh or therm), demand charge (per kW), distribution charge, transmission charge, taxes, and fees. Each component record specifies the component type, unit of measure, charge basis, and whether it applies to on-peak, off-peak, or all periods. Enables the billing engine to calculate line-item charges from interval meter data.' .

ind:TouPeriod rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Product ;
    rdfs:label 'Tou Period' ;
    rdfs:comment 'Defines Time-of-Use (TOU) pricing period windows for rate schedules implementing time-differentiated pricing. Each record specifies period name (on-peak, mid-peak, off-peak, super-off-peak, critical-peak), applicable day types (weekday, weekend, holiday), start and end clock times, season assignment via rate_season_calendar, and the parent rate schedule. Supports TOU, CPP (Critical Peak Pricing), and RTP (Real-Time Pricing) tariff structures. Referenced by rate components to apply period-specific energy and demand charges.' .

ind:RateTier rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Product ;
    rdfs:label 'Rate Tier' ;
    rdfs:comment 'Tiered (inclining or declining block) rate structure definitions subordinate to a rate component. Each tier specifies a consumption block boundary (e.g., first 500 kWh, 501-1000 kWh, above 1000 kWh), the unit price for that block, the baseline allocation method (territory average, household size), season applicability, and CARE/FERA discount tier indicators. Supports California-style baseline allowance structures, conservation-incentive pricing, and declining-block industrial rates. Contains 8+ business attributes: tier_number, lower_bound_kwh, upper_bound_kwh, unit_price, baseline_method, season_code, discount_indicator, effective_date, and price_unit. Subordinate to rate_component — accessed via parent FK for billing engine tier resolution.' .

ind:EligibilityRule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Product ;
    rdfs:label 'Eligibility Rule' ;
    rdfs:comment 'Business rules governing customer qualification, applicability, and territory assignment for rate schedules, tariff riders, and utility programs. Each rule defines criteria including customer class, service territory, voltage level, load profile type, demand threshold (kW), annual consumption range, premise type, geographic zone, and special conditions (medical baseline, EV ownership, solar interconnection, income level). Also maps rate schedules to applicable service territories, voltage levels, and customer classes — specifying whether assignment is mandatory or optional. Rules are composable with AND/OR logic. Consumed by CIS enrollment validation, self-service portal eligibility checks, CSR rate recommendation tools, and territory-specific rate lookups. Serves as the single source of truth for all \'who qualifies for what\' and \'where does this rate apply\' logic in the product catalog.' .

ind:ServicePlan rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Product ;
    rdfs:label 'Service Plan' ;
    rdfs:comment 'Commercial and industrial bundled service plan catalog for large commercial, key account, and municipal customers. Each plan defines a named offering combining a base rate schedule, optional tariff riders, demand response participation terms, value-added services (energy audits, sustainability reporting, power quality monitoring), contract term structure, pricing methodology (fixed, indexed, blended, custom), minimum demand threshold, and account management tier. Plans are versioned and may require PUC approval for non-standard terms. Feeds Salesforce CPQ for commercial quoting and Oracle CC&B for enrollment.' .

ind:EeMeasure rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Product ;
    rdfs:label 'Ee Measure' ;
    rdfs:comment 'Catalog of individual energy efficiency measures eligible for rebates or incentives within EE programs. Each measure record specifies the measure name (e.g., LED lighting, smart thermostat, HVAC upgrade, EV charger), measure category, eligible customer class, baseline efficiency standard, minimum qualifying specification, incentive amount ($/unit or $/kWh saved), estimated annual energy savings (kWh), estimated demand reduction (kW), and measure life (years). Sourced from PUC-approved deemed savings databases.' .

ind:RateScheduleVersion rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Product ;
    rdfs:label 'Rate Schedule Version' ;
    rdfs:comment 'Version history of rate schedule changes over time, capturing each filed revision as a distinct record. Each version record stores the version number, filing date, PUC docket number, effective date, expiration date, change description, approval status (filed, approved, rejected, withdrawn), and the rate schedule it amends. Enables point-in-time rate lookups for billing corrections, regulatory audits, and historical rate analysis. Critical for FERC and PUC compliance.' .

ind:RateScheduleApplicability rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Product ;
    rdfs:label 'Rate Schedule Applicability' ;
    rdfs:comment 'Association entity mapping rate schedules to the service territories, voltage levels, and customer classes where they are applicable. Each record specifies the rate schedule, applicable service territory (by utility division or geographic zone), voltage level (residential secondary, commercial primary, transmission), customer class (residential, small commercial, large commercial, industrial, agricultural), and whether the assignment is mandatory or optional. Enables enrollment validation and territory-specific rate lookups.' .

ind:SpecialContract rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Product ;
    rdfs:label 'Special Contract' ;
    rdfs:comment 'Individually negotiated service agreements with large industrial, municipal, or economic development customers that deviate from standard published tariff rates. Each record captures contract number, customer account reference, negotiated rate terms (demand charges, energy charges, ratchet provisions), contract duration, minimum annual revenue guarantee, interruptibility obligations, curtailment compensation, economic development incentive basis (job creation, capital investment thresholds), PUC approval docket, and renewal/termination provisions. These bespoke agreements require separate regulatory authorization and are tracked independently from standard rate schedules for revenue assurance and regulatory audit purposes.' .

ind:Filing rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Regulatory ;
    rdfs:label 'Filing' ;
    rdfs:comment 'Master record for every regulatory filing or submission made by the utility to any regulatory body (FERC, NERC, state PUCs, EPA, PHMSA, DOE, EIA). Encompasses rate case filings, IRP submissions, CPCN applications, NERC CIP self-certifications, environmental permit applications, FERC Forms (1, 2, 714), EIA surveys (860, 861, 923), and all other mandatory or voluntary regulatory submissions. Captures filing type, form number, docket reference, filing date, regulatory body, filing status, submission method, responsible organizational unit, reporting period, key reported metrics, financial data summaries, IRP planning horizon and resource mix details, and amendment history. Discriminated by filing_type (FERC_FORM, EIA_SURVEY, IRP, RATE_CASE_FILING, CPCN, CIP_CERTIFICATION, ENVIRONMENTAL, OTHER) to support form-specific attributes. Serves as the SSOT for all regulatory submission events and their lifecycle from draft through final disposition.' .

ind:Docket rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Regulatory ;
    rdfs:label 'Docket' ;
    rdfs:comment 'Master record for a regulatory docket or proceeding opened by a regulatory body (FERC, state PUC, NERC, EPA), including all formal correspondence and communications within the proceeding and participating party tracking. Tracks the docket number, proceeding type (GRC, CPCN, rate case, enforcement, rulemaking, complaint), assigned regulatory body, presiding officer/ALJ, open date, expected decision date, current status, and participating parties (intervenors, commission staff, consumer advocates, industry groups) with their roles and positions. Captures the complete correspondence audit trail: data requests, information requests (IRs), deficiency letters, comment letters, protest filings, settlement communications, direction (inbound/outbound), response due dates, actual response dates, and responsible regulatory affairs staff. SSOT for the complete proceeding record, participant roster, and regulatory communication history.' .

ind:RateCase rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Regulatory ;
    rdfs:label 'Rate Case' ;
    rdfs:comment 'Master record for a General Rate Case (GRC) or rate proceeding filed with a state PUC or FERC, including all associated testimony and evidentiary records. Captures the test year, rate case type (electric, gas, combined), requested and authorized revenue requirement, ROE requested vs. authorized, RAB value, filing date, interim rate effective date, final order date, and rate case outcome. Also tracks expert witness testimony: testimony type (direct, rebuttal, surrebuttal), witness name and affiliation, subject area (revenue requirement, cost of capital, depreciation, rate design), filing date, and exhibit numbers. SSOT for approved revenue requirements, rate case history, and the evidentiary record of rate proceedings.' .

ind:TariffSchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Regulatory ;
    rdfs:label 'Tariff Schedule' ;
    rdfs:comment 'Approved tariff schedule or rate schedule as authorized by a regulatory body, with full rate design structure and temporal versioning. Captures tariff name, tariff code, service type (electric/gas distribution, transmission), customer class, effective date, expiration/superseded date, version number, base rate components, demand charge, energy charge, fixed customer charge, and jurisdiction. Includes rate design details: rate structure type (flat, TOU, CPP, RTP, tiered/inclining block, demand-based), rate component tiers, time-of-use periods, revenue allocation percentages by class, and the authorizing rate case. Supports version history to track rate changes over time. SSOT for approved rates and rate structures used by the billing domain.' .

ind:RegulatoryTariffRider rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Regulatory ;
    rdfs:label 'Regulatory Tariff Rider' ;
    rdfs:comment 'Supplemental tariff rider or surcharge mechanism attached to a base tariff schedule, as approved by a regulatory body. Captures rider name, rider code, rider type (fuel adjustment, infrastructure surcharge, renewable portfolio standard, demand response, low-income assistance), calculation methodology, rate per unit, effective date, sunset date, and the parent tariff schedule it modifies. Riders are distinct regulatory instruments with their own approval lifecycle.' .

ind:CommissionOrder rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Regulatory ;
    rdfs:label 'Commission Order' ;
    rdfs:comment 'Formal order, decision, or ruling issued by a regulatory body (FERC, PUC, NERC, EPA) in response to a filing or proceeding. Captures the order number, issuing body, order type (final order, interim order, show cause, consent decree, compliance order), issue date, effective date, compliance deadline, order summary, and the docket it belongs to. Tracks the utility\'s obligations arising from each regulatory order.' .

ind:ComplianceObligation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Regulatory ;
    rdfs:label 'Compliance Obligation' ;
    rdfs:comment 'Master record for every compliance obligation imposed on the utility by regulatory orders, rules, standards, or statutes — together with the complete evidence portfolio and audit/examination history. Encompasses NERC CIP requirements, RPS obligations, EPA/PHMSA safety mandates, and all other regulatory mandates. Captures obligation description, source regulation or order, regulatory body, obligation type, due date, responsible business unit, completion status, penalty exposure, and compliance gap analysis. Evidence tracking: evidence type (document, test result, inspection, attestation, log), evidence title, collection date, submission date, submitting party, evidence status (draft, submitted, accepted, rejected), and document reference. Audit tracking: audit type, conducting body, audit scope, audit period, on-site dates, findings count, violations identified, overall outcome, and audit readiness posture. SSOT for the complete compliance lifecycle from obligation creation through evidence collection, audit verification, and closure.' .

ind:ComplianceEvidence rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Regulatory ;
    rdfs:label 'Compliance Evidence' ;
    rdfs:comment 'Evidence record submitted or maintained to demonstrate fulfillment of a specific compliance obligation. Captures the evidence type (document, test result, inspection record, attestation, log file), evidence title, collection date, submission date, submitting party, associated obligation, regulatory body, evidence status (draft, submitted, accepted, rejected), and document reference. Supports NERC CIP, FERC, EPA, and PUC audit readiness.' .

ind:CipStandard rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Regulatory ;
    rdfs:label 'Cip Standard' ;
    rdfs:comment 'NERC Critical Infrastructure Protection (CIP) standard master record with associated BES Cyber System and asset impact classifications. Captures the standard identifier (CIP-002 through CIP-014), standard title, version, effective date, requirement count, applicability criteria, and compliance category. Includes BES asset impact classifications: asset identifier, asset type (substation, control center, generation facility, transmission line), assigned impact level (high, medium, low), classification rationale, classification date, review cycle, and responsible engineer. Drives which CIP requirements apply to each BES asset and maps to compliance obligations. SSOT for NERC CIP standard applicability and asset-level impact determinations.' .

ind:CipAssetClassification rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Regulatory ;
    rdfs:label 'Cip Asset Classification' ;
    rdfs:comment 'NERC CIP BES Cyber System and BES asset classification record assigning impact level (high, medium, low) to specific operational assets per CIP-002 requirements. Captures the asset identifier, asset type (substation, control center, generation facility, transmission line), assigned impact level, classification rationale, classification date, review cycle, and responsible engineer. Drives which CIP standards apply to each asset.' .

ind:IrpSubmission rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Regulatory ;
    rdfs:label 'Irp Submission' ;
    rdfs:comment 'Integrated Resource Plan (IRP) submission record filed with the state PUC or DOE. Captures the IRP cycle year, planning horizon (years), filing date, regulatory body, total projected load (MW), planned capacity additions by resource type (fossil, nuclear, renewable, storage, DR), planned retirements, preferred portfolio description, alternative scenarios evaluated, and IRP approval status. SSOT for long-range resource planning regulatory submissions.' .

ind:CpcnApplication rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Regulatory ;
    rdfs:label 'Cpcn Application' ;
    rdfs:comment 'Certificate of Public Convenience and Necessity (CPCN) application filed with a state PUC for approval of a new capital project, facility, or service territory expansion. Captures the project name, project type (generation, transmission line, substation, gas pipeline, distribution extension), applied MW or capacity, estimated CAPEX, service territory affected, filing date, hearing date, certificate issuance date, and conditions of approval.' .

ind:RabAsset rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Regulatory ;
    rdfs:label 'Rab Asset' ;
    rdfs:comment 'Regulatory asset or regulatory liability recorded under FASB ASC 980 (Regulated Operations) on the utility\'s balance sheet. Captures the regulatory asset name, asset type (deferred fuel costs, storm restoration costs, pension obligations, environmental remediation, plant abandonment, deferred rate case expenses, securitized costs), originating regulatory order, authorized recovery amount, amortization period, amortization start date, remaining unamortized balance, annual amortization amount, and associated rate case. Supports both regulatory assets (future recovery authorized) and regulatory liabilities (future obligations to customers). SSOT for all regulatory assets and liabilities tracked for revenue requirement and balance sheet purposes.' .

ind:EnvironmentalPermit rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Regulatory ;
    rdfs:label 'Environmental Permit' ;
    rdfs:comment 'Environmental operating permit and emission allowance/credit master record for the utility. Covers permits issued by EPA, state environmental agencies, or PHMSA: permit number, permit type (air quality, water discharge, hazardous waste, pipeline safety, stormwater), issuing agency, facility covered, issue/expiration dates, renewal status, emission limits, and compliance monitoring requirements. Also tracks emission allowances and credits under cap-and-trade programs (CSAPR, RGGI, state carbon): allowance type, program name, vintage year, quantity (tons), serial number range, acquisition method (allocated, purchased, auctioned), acquisition date, acquisition cost, current holding status (active, surrendered, banked, transferred), transfer history, and associated facility. SSOT for all environmental operating authorizations and the utility\'s complete emission compliance inventory.' .

ind:EmissionAllowance rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Regulatory ;
    rdfs:label 'Emission Allowance' ;
    rdfs:comment 'Emission allowance or credit held by the utility under EPA cap-and-trade programs (e.g., SO2, NOx, CO2). Captures the allowance type, program name (CSAPR, RGGI, state carbon program), vintage year, quantity (tons), acquisition method (allocated, purchased, auctioned), acquisition date, acquisition cost, current holding status (active, surrendered, banked, transferred), and associated facility. Tracks the utility\'s emission compliance inventory.' .

ind:RecInventory rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Regulatory ;
    rdfs:label 'Rec Inventory' ;
    rdfs:comment 'Renewable energy compliance master tracking the utility\'s complete RPS position: RECs held, generated, purchased, retired, or transferred, together with RPS obligation positions by compliance year and jurisdiction. Captures REC serial numbers, generation source (solar, wind, hydro, biomass), generating facility, vintage, registry platform (WREGIS, NEPOOL GIS, PJM-EIS), acquisition/retirement dates, and compliance year assignment. RPS obligation tracking: total retail sales (MWh), RPS percentage requirement by tier (Tier 1, Tier 2, solar carve-out), required RECs, RECs retired to date, compliance gap or surplus, alternative compliance payment (ACP) rate and amounts, compliance filing date, and compliance status by jurisdiction. SSOT for the utility\'s complete renewable portfolio standard compliance position including both the certificate inventory and the obligation calculus.' .

ind:RpsObligation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Regulatory ;
    rdfs:label 'Rps Obligation' ;
    rdfs:comment 'Renewable Portfolio Standard (RPS) compliance obligation record for each compliance year and jurisdiction. Captures the compliance year, state jurisdiction, total retail sales (MWh), RPS percentage requirement, required RECs (MWh), RECs retired to date, compliance gap or surplus, alternative compliance payment (ACP) rate, ACP amount paid, and compliance status. Tracks the utility\'s annual RPS compliance position.' .

ind:Correspondence rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Regulatory ;
    rdfs:label 'Correspondence' ;
    rdfs:comment 'Formal correspondence record between the utility and a regulatory body, including data requests, information requests (IRs), deficiency letters, comment letters, protest filings, and settlement communications. Captures the correspondence type, direction (inbound/outbound), regulatory body, docket reference, subject, date sent/received, response due date, response date, and responsible regulatory affairs staff. Maintains the complete regulatory communication audit trail.' .

ind:RateCaseTestimony rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Regulatory ;
    rdfs:label 'Rate Case Testimony' ;
    rdfs:comment 'Expert witness testimony or workpaper submitted as part of a rate case or regulatory proceeding. Captures the testimony type (direct, rebuttal, surrebuttal), witness name, witness affiliation (utility, intervenor, commission staff), testimony subject area (revenue requirement, cost of capital, depreciation, rate design), filing date, exhibit numbers, and associated rate case or docket. Tracks the evidentiary record of rate proceedings.' .

ind:Body rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Regulatory ;
    rdfs:label 'Body' ;
    rdfs:comment 'Reference master for regulatory bodies and agencies that have jurisdiction over the utility\'s operations. Captures the agency name, agency acronym (FERC, NERC, PUC, EPA, PHMSA, DOE, OSHA), jurisdiction type (federal, state, regional), regulatory scope (electric, gas, environmental, safety, financial), primary contact information, filing portal URL, and applicable states or regions. Used across all regulatory filings and compliance records.' .

ind:ViolationNotice rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Regulatory ;
    rdfs:label 'Violation Notice' ;
    rdfs:comment 'Notice of violation (NOV), alleged violation (NAV), or enforcement action received from a regulatory body, together with the full mitigation plan and corrective action lifecycle through resolution. Captures violation type, issuing regulatory body, standard or rule violated, violation date, discovery date, severity classification, penalty amount proposed/assessed, and resolution status. Includes the complete corrective response: mitigation plan title, root cause analysis, corrective actions list with individual action status, responsible parties, implementation milestones, target and actual completion dates, regulatory body approval of mitigation plan, effectiveness verification method, plan closure date, and lessons learned. SSOT for the full enforcement-to-resolution lifecycle including all remediation commitments and their verification.' .

ind:MitigationPlan rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Regulatory ;
    rdfs:label 'Mitigation Plan' ;
    rdfs:comment 'Mitigation plan or corrective action plan (CAP) developed in response to a regulatory violation notice or compliance gap. Captures the plan title, associated violation or obligation, root cause description, corrective actions list, responsible parties, implementation milestones, target completion date, actual completion date, regulatory body approval status, and effectiveness verification method. Tracks the utility\'s remediation commitments to regulators.' .

ind:FercForm rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Regulatory ;
    rdfs:label 'Ferc Form' ;
    rdfs:comment 'FERC annual or periodic regulatory report form submission record (e.g., FERC Form 1 for electric utilities, FERC Form 2 for gas utilities, FERC Form 714 for transmission planning). Captures the form number, form title, reporting year, submission date, filing status, total pages, financial data summary (revenues, expenses, plant in service), and any amendments filed. SSOT for FERC mandatory financial and operational reporting submissions.' .

ind:EiaReport rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Regulatory ;
    rdfs:label 'Eia Report' ;
    rdfs:comment 'U.S. Energy Information Administration (EIA) mandatory survey or report submission record (e.g., EIA-860 Annual Electric Generator Report, EIA-861 Annual Electric Power Industry Report, EIA-923 Power Plant Operations Report). Captures the form number, reporting period, submission date, filing status, key reported metrics (capacity MW, generation MWh, fuel consumption, customers served), and amendment history. SSOT for EIA mandatory reporting compliance.' .

ind:RegulatoryAudit rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Regulatory ;
    rdfs:label 'Regulatory Audit' ;
    rdfs:comment 'Regulatory audit or compliance review conducted by or on behalf of a regulatory body (NERC audit, FERC audit, PUC management audit, EPA inspection). Captures the audit type, conducting body, audit scope, audit period, on-site start date, on-site end date, preliminary findings date, final report date, number of findings, number of violations identified, and overall audit outcome. Tracks the utility\'s regulatory examination history and audit readiness posture.' .

ind:Resource rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Der ;
    rdfs:label 'Resource' ;
    rdfs:comment 'Master record for each distributed energy resource (DER) asset — customer-sited or utility-owned — including rooftop solar PV, battery storage (BESS), EV charging stations, fuel cells, small wind, and backup generators. Captures nameplate capacity (kW/kWh), technology type, manufacturer/model, installation address, GPS coordinates, commissioning date, operational status, interconnection point (POI), serving circuit/feeder, DERMS asset ID, IEEE 1547 category, and complete technical configuration: inverter settings (Volt-VAR curve, Volt-Watt curve, frequency-watt response), export/import limits (kW), ramp rate limits (kW/min), communication protocol (IEEE 2030.5, OpenADR, OCPP, Modbus), DERMS device ID, firmware version, last configuration push timestamp, and configuration approval status. Serves as the single source of truth for all DER physical assets, their DERMS-registered configurations, and IEEE 1547-2018 advanced inverter function compliance within the utility service territory.' .

ind:InterconnectionRequest rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Der ;
    rdfs:label 'Interconnection Request' ;
    rdfs:comment 'Tracks the full lifecycle of a customer or third-party application to interconnect a DER to the utility distribution grid, from initial application through technical studies to executed interconnection agreement. Captures application date, applicant identity, proposed DER type and capacity (kW), point of interconnection (POI), study queue position, technical review phases (feasibility, system impact, facilities — with findings, costs, and engineer assignments), approval milestones, permit tracking (permit type, issuing authority, submission/approval dates, conditions), inspection records (inspection type, date, inspector, pass/fail, deficiency notes), and the executed interconnection agreement details (execution date, maximum export capacity, protection/control requirements, metering requirements, insurance obligations, indemnification terms, termination conditions). Aligns with FERC Order 2222 and state PUC interconnection tariff requirements. Single product owns the complete interconnection queue lifecycle from application through executed agreement.' .

ind:NemAccount rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Der ;
    rdfs:label 'Nem Account' ;
    rdfs:comment 'Master record for each customer enrolled in a Net Energy Metering (NEM) program. Captures NEM program version (NEM 1.0, NEM 2.0, NEM 3.0/NEM-A), enrollment date, export compensation rate structure, annual true-up date, banking period, cumulative net kWh banked, associated service account, and applicable tariff schedule. Serves as the SSOT for NEM program participation and export credit entitlements.' .

ind:NemTrueUp rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Der ;
    rdfs:label 'Nem True Up' ;
    rdfs:comment 'Annual or periodic NEM true-up settlement record reconciling a customer\'s net energy exports against imports over the NEM banking period. Captures true-up period start/end dates, total kWh exported, total kWh imported, net kWh balance, export credit value applied, any remaining balance owed or credited, and settlement amount. Feeds into billing domain for final invoice generation.' .

ind:DerProgramEnrollment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Der ;
    rdfs:label 'Der Program Enrollment' ;
    rdfs:comment 'Records a DER asset\'s enrollment into a specific utility program such as demand response (DR), virtual power plant (VPP), grid services, or incentive programs. Captures enrollment date, program type, enrolled capacity (kW), aggregator identity if applicable, enrollment status, opt-out date, and contractual obligations. Distinct from NEM enrollment — covers operational grid services and incentive programs.' .

ind:AggregationGroup rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Der ;
    rdfs:label 'Aggregation Group' ;
    rdfs:comment 'Defines a logical grouping of DER assets aggregated for collective dispatch, VPP coordination, or wholesale market participation under FERC Order 2222. Captures aggregation name, managing aggregator entity, total enrolled capacity (MW), resource mix composition (solar %, storage %, EV %), geographic boundary, RTO/ISO market registration ID, market products authorized (energy, capacity, ancillary services), minimum/maximum dispatch range, and aggregation status (forming, active, suspended, retired). Enables fleet-level visibility, dispatch optimization, and market settlement in DERMS.' .

ind:DispatchEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Der ;
    rdfs:label 'Dispatch Event' ;
    rdfs:comment 'Captures each dispatch instruction, activation, or market schedule — whether DERMS-initiated, operator-initiated, aggregator-submitted, or RTO/ISO market-scheduled (DAM/RTM) — sent to an individual DER resource or aggregation group. Covers demand response activation, VPP market dispatch, frequency regulation, peak shaving, emergency curtailment, day-ahead schedules, and real-time market intervals. Records dispatch timestamp, schedule date, target resource or aggregation group, requested setpoint (kW/MW), dispatch duration, market interval (hourly/sub-hourly), market product type (energy, capacity, ancillary services), dispatch reason, bid/offer price, LMP reference, schedule confirmation status, actual response delivered, performance score, and settlement status. Unified SSOT for all DER dispatch activity and VPP market schedules within the utility and wholesale market context.' .

ind:InterconnectionStudy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Der ;
    rdfs:label 'Interconnection Study' ;
    rdfs:comment 'Technical study record associated with an interconnection request or hosting capacity assessment, covering feasibility study, system impact study, facilities study, and hosting capacity analysis phases. Captures study type, study start/end dates, assigned engineer, circuit/feeder under study, study methodology (deterministic, probabilistic), existing DER penetration (kW), proposed additional capacity (kW), hosting capacity limit (kW), identified grid upgrade requirements, estimated upgrade cost ($), voltage and thermal impact findings, protection coordination requirements, identified constraints, recommended upgrades, study validity period, and study approval status. Supports interconnection queue management, DER siting decisions, cost allocation, and distribution planning. Single source of truth for all DER-related grid studies.' .

ind:BessOperation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Der ;
    rdfs:label 'Bess Operation' ;
    rdfs:comment 'Operational record for battery energy storage system (BESS) charge and discharge cycles. Captures cycle timestamp, BESS asset ID, operation mode (charge, discharge, idle, frequency regulation), power setpoint (kW), energy throughput (kWh), state of charge at start and end (%), cycle depth, round-trip efficiency, and triggering dispatch event reference. Supports BESS lifecycle management, warranty tracking, and degradation analysis.' .

ind:EvChargingSession rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Der ;
    rdfs:label 'Ev Charging Session' ;
    rdfs:comment 'Records each EV charging session at a utility-managed or utility-enrolled EV charging station. Captures session start/end timestamp, charger asset ID, vehicle identifier (anonymized or fleet ID), energy delivered (kWh), peak demand (kW), charging level (L1/L2/DCFC), TOU period, session cost, demand response curtailment flag, and smart charging program participation. Supports managed charging programs and grid impact analysis.' .

ind:Microgrid rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Der ;
    rdfs:label 'Microgrid' ;
    rdfs:comment 'Master record and complete operational history for each microgrid system within the utility service territory — utility-owned, customer-owned, or community microgrids. Captures microgrid name, geographic boundary, total generation capacity (kW), storage capacity (kWh), critical load served (kW), grid-connected vs islanded capability, point of common coupling (PCC), control system type, islanding protection scheme, operational status, and full mode transition event log: event timestamps, transition types (grid-connected to islanded, resynchronization, planned test), trigger causes (utility outage, scheduled test, operator command), island duration, load served during island (kW), generation sources active during island, and resynchronization outcomes. Supports resilience planning, SAIDI/SAIFI impact assessment, reliability reporting, and DERMS integration. Single source of truth for microgrid assets and their operational events.' .

ind:PerformanceSummary rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Der ;
    rdfs:label 'Performance Summary' ;
    rdfs:comment 'Periodic (daily/monthly) performance, availability, and curtailment record for each DER asset. Captures performance period, expected vs actual output (kWh/kW), performance ratio (%), availability factor (%), capacity factor, and all curtailment events within the period: curtailment start/end timestamps, reason codes (voltage violation, thermal overload, overgeneration, operator-directed), curtailment authority (utility, ISO/RTO, DERMS auto), curtailed energy (kWh), and compensation eligibility flag. Supports program compliance verification, CAISO Rule 21 curtailment reporting, FERC Order 2222 compliance, incentive payment calculations, and DER fleet performance analytics. Single source of truth for DER operational performance and curtailment history.' .

ind:DerProgram rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Der ;
    rdfs:label 'Der Program' ;
    rdfs:comment 'Reference catalog of utility DER programs available for customer enrollment including demand response, virtual power plant (VPP), battery storage incentives (SGIP), EV managed charging, community solar, and grid services programs. Captures program name, program type, eligibility criteria (customer segment, DER technology, capacity limits), incentive structure and rates, program capacity limit (MW), current enrollment count, enrollment open/close dates, regulatory approval reference, and program status. Excludes NEM programs which are administered through nem_account. Authoritative program catalog for all DER-specific operational offerings.' .

ind:Aggregator rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Der ;
    rdfs:label 'Aggregator' ;
    rdfs:comment 'Master record for third-party DER aggregators authorized to aggregate customer DER assets for wholesale market participation or utility program delivery under FERC Order 2222. Captures aggregator legal name, FERC registration ID, state PUC authorization number, authorized market products (energy, capacity, ancillary services), service territory coverage, total enrolled capacity (MW), contract start/end dates, and compliance status. Distinct from the utility\'s own VPP aggregation groups.' .

ind:CommunitySolarSubscription rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Der ;
    rdfs:label 'Community Solar Subscription' ;
    rdfs:comment 'Customer subscription record for a community solar (shared renewables) project, representing a customer\'s allocated share of a remote solar facility\'s output. Captures subscription date, customer account reference, project ID, subscribed capacity (kW), allocated energy share (%), monthly bill credit rate ($/kWh), subscription term, subscription status, and transfer/cancellation history. Supports community solar program administration and billing credit pass-through.' .

ind:Feeder rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Feeder' ;
    rdfs:comment 'Master record for each medium-voltage distribution feeder (circuit) emanating from a substation bus. Captures feeder identifier, nominal voltage (kV), rated capacity (MVA), feeder type (overhead/underground/mixed), operating territory, associated substation, protective device configuration, GIS feeder route geometry reference, SCADA tag, commissioning date, and operational status. Serves as the backbone topology anchor for the distribution network in GE PowerOn DMS and Esri ArcGIS.' .

ind:DistributionSubstation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Distribution Substation' ;
    rdfs:comment 'Master record for each distribution-level substation (distinct from bulk transmission substations owned by the transmission domain). Captures substation name, NERC location identifier, address, GPS coordinates, service territory, voltage transformation levels (e.g., 69kV/12.47kV), installed transformer capacity (MVA), number of feeder bays, bus configuration (single bus/double bus/ring), SCADA connectivity status, GIS polygon reference, and commissioning date. SSOT for distribution substation identity and topology anchor within the distribution domain; serves as the root node for feeder-level network traversal. Transmission substations are owned by the transmission domain.' .

ind:DistributionServicePoint rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Distribution Service Point' ;
    rdfs:comment 'Master record representing the physical point of delivery where the utility\'s distribution network connects to a customer\'s premises. Captures service point identifier (SPID), service address, GPS coordinates, service voltage class (120V/240V/277V/480V), phase configuration (1Φ/3Φ), load class (residential/commercial/industrial), associated feeder, transformer, and pole/vault reference, meter socket type, NEM eligibility flag, and connection status. SSOT for the physical delivery point; distinct from the customer account (owned by customer domain) and the meter device (owned by metering domain).' .

ind:DistributionTransformer rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Distribution Transformer' ;
    rdfs:comment 'Master record for each pad-mount, pole-mount, or vault distribution transformer on the medium-to-low voltage network. Captures transformer identifier, kVA rating, primary/secondary voltage, phase configuration, cooling type (ONAN/ONAF), installation type (overhead/underground), GIS location coordinates, pole or structure reference, feeder assignment, manufacturer, model, serial number, installation date, and operational status. Distinct from transmission transformers (owned by transmission domain) and the enterprise asset record (owned by asset domain); this record captures distribution-network topology context.' .

ind:Pole rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Pole' ;
    rdfs:comment 'Master record for each utility-owned distribution structure supporting overhead and underground infrastructure, including poles, vaults, manholes, and pedestals. Captures structure identifier, structure type (pole/vault/manhole/pedestal/riser), GIS coordinates, pole class (ANSI class 1–7 for poles), height (ft), material (wood/steel/concrete/composite/fiberglass), owner (utility/joint-use/third-party), installation year, last inspection date, condition rating, loading capacity (%), number of attachments, associated feeder, and municipality. Supports joint-use attachment management, storm damage assessment, underground access point tracking, and serves as the node element in the distribution network topology (conductor spans connect between structures).' .

ind:ProtectiveDevice rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Protective Device' ;
    rdfs:comment 'Master record for distribution-level protective and switching devices including reclosers, sectionalizers, fuses, automated switches, and capacitor banks. Captures device identifier, device type/subtype (protective/switching/reactive compensation), manufacturer, model, rated interrupting current (kA) or rated kVAR, rated voltage (kV), number of steps (for capacitor banks), control mode (fixed/automatic/SCADA-controlled), SCADA-controllable flag, remote/manual operation mode, GIS location, associated feeder segment, upstream/downstream connectivity references, installation date, last test/maintenance date, switching operations count, and operational status. Critical for fault isolation modeling, FLISR automation in GE PowerOn DMS, volt/VAR optimization (VVO), and SAIDI/SAIFI improvement through automated switching.' .

ind:GasMain rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Gas Main' ;
    rdfs:comment 'Master record for natural gas distribution main pipeline segments. Captures main identifier, GIS line geometry reference, pipe material (steel/PE/cast iron), nominal diameter (inches), operating pressure class (LP/MP/HP), installation year, coating type, cathodic protection zone, leak survey class, associated pressure district, municipality, and operational status. SSOT for gas distribution pipeline topology; supports PHMSA integrity management and leak survey scheduling.' .

ind:GasServiceLine rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Gas Service Line' ;
    rdfs:comment 'Master record for individual natural gas service lines connecting the gas main to a customer\'s meter set. Captures service line identifier, GIS geometry, pipe material, diameter (inches), operating pressure (psig), service line length (ft), associated gas main, service point reference, meter set assembly reference, installation year, and operational status. Supports PHMSA leak survey, pressure testing records, and customer connection management.' .

ind:DistributionOutageEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Distribution Outage Event' ;
    rdfs:comment 'Transactional record for each discrete electric distribution outage event (planned or unplanned) managed in GE PowerOn OMS. Captures outage event identifier, outage type (planned/unplanned/momentary), cause code (weather/equipment failure/animal/vegetation/third-party/unknown), affected feeder(s), protective device that operated, estimated and actual customers affected, outage start and restoration timestamps, outage duration (minutes), crew dispatch reference, customer notification status, associated work order reference, SAIDI/SAIFI/CAIDI contribution values (customer minutes interrupted per event), IEEE 1366 major event day exclusion flag, and storm event association. Includes detail-level affected customer/service point records with individual customer minutes interrupted (CMI). Primary source for calculating SAIDI/SAIFI/CAIDI reliability indices, PUC reliability reporting, storm restoration performance tracking, and customer outage history. Retains all raw data needed for IEEE 1366 reliability index computation.' .

ind:DistributionSwitchingOrder rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Distribution Switching Order' ;
    rdfs:comment 'Transactional record for planned or emergency switching operations executed on the distribution network. Captures switching order number, order type (planned/emergency/FLISR), initiating work order reference, issuing operator, approved-by operator, planned execution window, actual start/end timestamps, list of switching steps (device tag, operation type open/close, sequence number), safety clearance reference, affected feeder(s), estimated customer impact, and completion status. Sourced from GE PowerOn DMS switching order module; critical for safe switching compliance and outage coordination.' .

ind:GasPressureDistrict rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Gas Pressure District' ;
    rdfs:comment 'Master record defining a gas pressure district — a contiguous section of the gas distribution network operating at a common pressure level, bounded by pressure regulating stations (PRS). Captures district identifier, district name, operating pressure range (psig), pressure class (LP/MP/HP), associated regulating station identifiers and locations, geographic boundary (GIS polygon), number of customers served, total main miles, and operational status. SSOT for gas network pressure zone topology; supports PHMSA integrity management, pressure monitoring compliance, and emergency isolation planning.' .

ind:GasLeakSurvey rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Gas Leak Survey' ;
    rdfs:comment 'Transactional record for scheduled and ad-hoc gas leak survey activities conducted on gas mains and service lines per PHMSA requirements. Captures survey identifier, survey date, survey type (bar-hole/CGI/walking/mobile/aerial), surveyed gas main or service line reference, survey crew reference, instrument type, leak indications found (count), leak classification (Grade 1/2/3 per GPTC), follow-up action required flag, and survey completion status. SSOT for PHMSA-mandated leak survey records; supports DOT annual reporting and integrity management program (IMP).' .

ind:GasLeak rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Gas Leak' ;
    rdfs:comment 'Master record for each identified natural gas leak on the distribution system. Captures leak identifier, discovery date, discovery method (survey/customer report/third-party damage), associated gas main or service line, GIS location coordinates, leak grade (Grade 1 immediate/Grade 2 scheduled/Grade 3 monitored), leak size estimate (MCF/day), repair priority, assigned crew reference, repair date, repair method, and closure status. SSOT for gas leak lifecycle management; supports PHMSA incident reporting and IMP compliance.' .

ind:ServiceConnectionOrder rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Service Connection Order' ;
    rdfs:comment 'Transactional record for new service connection, upgrade, or disconnection orders for electric or gas distribution service. Captures order identifier, order type (new connect/upgrade/downgrade/disconnect/reconnect), energy commodity (electric/gas), service point reference, customer account reference, requested service date, scheduled date, completion date, required infrastructure work (transformer upgrade/main extension/service line installation), design engineer reference, permit number, inspection status, and order status. Bridges the customer domain (account enrollment) and distribution operations (physical network connection work).' .

ind:CiAccount rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Engagement ;
    rdfs:label 'Ci Account' ;
    rdfs:comment 'Master record for commercial and industrial (C&I) customer accounts managed through the utilitys commercial engagement program. Represents the primary business entity for large commercial, industrial, and key account customers. Captures account classification (C&I segment, key account tier, strategic account flag), assigned key account manager, SIC/NAICS industry code, peak demand (kW), annual energy consumption (MWh/MCF), credit rating, preferred contact method, account status, and external system account identifier. Serves as the SSOT for C&I account identity within the engagement domain, complementing the customer domains residential/general customer master.' .

ind:KeyAccountManager rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Engagement ;
    rdfs:label 'Key Account Manager' ;
    rdfs:comment 'Master record for utility Key Account Managers (KAMs) and commercial account representatives assigned to manage C&I customer relationships. Captures employee reference (linked to workforce domain), territory assignment, assigned account portfolio size, specialization (electric, gas, industrial, municipal), certification level, system user identifier, active status, performance tier, and maximum account capacity. Serves as the SSOT for KAM identity and portfolio assignments within the engagement domain.' .

ind:Opportunity rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Engagement ;
    rdfs:label 'Opportunity' ;
    rdfs:comment 'Commercial opportunity record tracking sales and program enrollment opportunities for C&I customers through the full pipeline lifecycle from prospecting through close. Captures opportunity name, type (new service, rate change, DR enrollment, DER program, VPP participation, energy efficiency upgrade, NEM application, TOU migration), stage (prospecting, qualification, proposal, negotiation, closed-won, closed-lost), estimated annual revenue impact, estimated load impact (kW/kWh), probability of close, expected close date, opportunity source, assigned KAM, and external system opportunity identifier. Includes proposal-stage attributes: proposal type, version, proposed solution description, estimated savings ($/year), estimated demand reduction (kW), estimated energy savings (kWh/year), proposed incentive amount ($), proposal status (draft, submitted, under review, accepted, rejected, expired), and expiration date. Core entity for commercial pipeline management, load management program recruitment, KAM performance tracking, and contract negotiation workflow.' .

ind:EnergyAudit rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Engagement ;
    rdfs:label 'Energy Audit' ;
    rdfs:comment 'Record of energy audits conducted for C&I customers as part of demand-side management (DSM) and energy efficiency programs. Captures audit type (walk-through, investment-grade, virtual/remote), audit date, auditor name, facility address, baseline annual consumption (kWh/MCF), identified energy savings potential (kWh/MCF/year), estimated demand reduction (kW), recommended measures, estimated implementation cost, simple payback period (years), audit status (scheduled, in-progress, completed, report-delivered), and associated DSM program. Supports IRP and DSM portfolio planning.' .

ind:DsmProgram rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Engagement ;
    rdfs:label 'Dsm Program' ;
    rdfs:comment 'Master catalog of demand-side management (DSM) programs offered by the utility including energy efficiency, demand response (DR), load management, DER incentive, NEM, TOU/CPP/RTP rate programs, and VPP participation programs. Captures program name, program code, program type (EE, DR, DER, NEM, TOU, VPP), target customer segment (residential, C&I, industrial), program status (active, suspended, closed), PUC-approved budget, incentive structure, enrollment capacity (MW or customer count), program start/end dates, FERC/PUC filing reference, and LCOE impact. Serves as the SSOT for DSM/DR program definitions within the engagement domain, complementing the product domain\'s rate schedule catalog.' .

ind:DrEventParticipation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Engagement ;
    rdfs:label 'Dr Event Participation' ;
    rdfs:comment 'Transactional record capturing a C&I customers actual participation in a specific demand response (DR) or VPP dispatch event. Captures DR event reference (linked to gridops domain), enrollment ID, event notification timestamp, customer acknowledgment timestamp, baseline load (kW), actual load during event (kW), measured curtailment (kW), curtailment performance percentage, performance status (compliant, non-compliant, excused, no-show), incentive earned ($), and penalty assessed ($). Supports DR performance settlement, NERC compliance reporting, VPP performance tracking, and wholesale market settlement verification.' .

ind:VppAgreement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Engagement ;
    rdfs:label 'Vpp Agreement' ;
    rdfs:comment 'Virtual Power Plant (VPP) participation agreement master record for C&I customers and DER aggregators enrolled in the utility\'s VPP program. Captures agreement type (direct customer, aggregator-mediated), aggregator name (if applicable), total committed capacity (kW), DER asset types included (battery storage, backup generation, HVAC load, EV charging), dispatch protocol (automated DERMS, manual notification), response time requirement (minutes), agreement term, compensation structure (capacity payment $/kW-month, energy payment $/kWh), FERC/PUC filing reference, and agreement status. Supports DERMS integration and wholesale market participation.' .

ind:LargeCustomerContract rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Engagement ;
    rdfs:label 'Large Customer Contract' ;
    rdfs:comment 'Master record for negotiated large customer service contracts and special contracts for C&I customers including economic development rates, interruptible service agreements, standby service contracts, and co-generation interconnection agreements. Captures contract type, negotiated rate schedule reference, contract term (start/end dates), minimum bill commitment, demand charge structure, energy charge structure, special conditions, PUC approval status, FERC filing reference (if applicable), contract value ($), and assigned KAM. Distinct from standard tariff service — these are individually negotiated agreements requiring regulatory approval.' .

ind:CrmInteraction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Engagement ;
    rdfs:label 'Crm Interaction' ;
    rdfs:comment 'Interaction log capturing all touchpoints between utility commercial staff and C&I customers. Captures interaction type (site visit, phone call, email, webinar, trade show, executive briefing, field inspection), interaction date/time, channel, subject, summary notes, follow-up actions required, follow-up due date, interaction outcome, associated opportunity ID, associated program ID, system activity identifier, and KAM ID. For site visit interactions, additionally captures visit location, facility area inspected, and site conditions noted. Supports relationship management, account planning, and customer satisfaction tracking for the C&I segment.' .

ind:SatisfactionSurvey rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Engagement ;
    rdfs:label 'Satisfaction Survey' ;
    rdfs:comment 'Customer satisfaction survey record capturing structured feedback from C&I customers on utility service quality, account management effectiveness, and program satisfaction. Captures survey type (annual key account survey, post-interaction survey, post-outage survey, program exit survey), survey date, delivery channel (email, phone, online portal), overall satisfaction score (1-10), NPS score, service reliability rating, billing accuracy rating, KAM responsiveness rating, program value rating, verbatim comments, and follow-up action required flag. Supports J.D. Power benchmarking and PUC service quality reporting.' .

ind:EngagementAccountPlan rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Engagement ;
    rdfs:label 'Engagement Account Plan' ;
    rdfs:comment 'Annual or multi-year strategic account plan developed by KAMs for key C&I accounts. Captures plan year, account tier, strategic objectives, revenue retention target ($), load growth/reduction target (kW), program enrollment targets (DR, EE, DER), identified risks, competitive threats (retail choice markets), planned touchpoints, capital investment opportunities, and plan approval status. Supports key account management discipline and commercial strategy execution for the C&I segment.' .

ind:DsmIncentivePayment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Engagement ;
    rdfs:label 'Dsm Incentive Payment' ;
    rdfs:comment 'Transactional record of incentive payments issued to C&I customers for participation in DSM programs including energy efficiency rebates, DR performance payments, DER installation incentives, and VPP capacity payments. Captures payment type (rebate, performance incentive, capacity payment, installation incentive), associated program, associated enrollment or audit record, payment calculation basis (kWh saved, kW curtailed, $/kW-month), calculated incentive amount ($), payment status (pending, approved, issued, reversed), payment method (bill credit, check, ACH), and payment date. Supports DSM cost recovery and PUC program reporting.' .

ind:OutreachCampaign rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Engagement ;
    rdfs:label 'Outreach Campaign' ;
    rdfs:comment 'Commercial customer outreach campaign record managing targeted engagement campaigns for C&I customer segments. Captures campaign name, campaign type (DR recruitment, EE program launch, TOU migration, VPP enrollment, rate change notification, executive briefing series), target segment criteria, campaign channel (email, direct mail, phone, event, digital), campaign start/end dates, target account count, contacted account count, response count, enrollment conversions, campaign budget ($), actual spend ($), and campaign status. Includes account-level response tracking: response date, response type (interested, declined, enrolled, no-response), follow-up disposition, and conversion outcome. Supports DSM program recruitment, campaign ROI measurement, and commercial engagement strategy.' .

ind:Incident rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Safety ;
    rdfs:label 'Incident' ;
    rdfs:comment 'OSHA recordable incidents, near-misses, first-aid events, unsafe conditions, and fatalities occurring across all utility operations (generation, T&D, gas, field crews). Captures incident type, severity classification (near-miss, first-aid, medical treatment, restricted duty, lost time, fatality), OSHA recordability determination, location, involved personnel, root cause category, days away/restricted/transferred (DART), medical case management details, and regulatory notification requirements. Serves as the authoritative SSOT for all occupational safety events including near-miss reports and OSHA 300 Log recordable case data. Sourced from Maximo EAM safety module and SAP EHS.' .

ind:SafetyProgram rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Safety ;
    rdfs:label 'Safety Program' ;
    rdfs:comment 'Master catalog of occupational safety, environmental health, and process safety programs administered by the utility, including OSHA PSM (Process Safety Management), NERC CIP physical security, PHMSA pipeline integrity management, lockout/tagout (LOTO), confined space entry, arc flash, fall protection, emergency response, and respiratory protection programs. Defines program scope, regulatory mandate (with specific CFR/standard citation), responsible owner, review cycle, program effectiveness metrics, and active/inactive status. Serves as the reference master that incidents, audits, training, and drills link to for program-level compliance tracking.' .

ind:Observation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Safety ;
    rdfs:label 'Observation' ;
    rdfs:comment 'Behavioral safety observations and field-level safety walks conducted by supervisors, safety officers, and peer observers as part of behavior-based safety (BBS) programs. Captures observation date, observer identity, crew/work group observed, work activity, observation type (safe act, at-risk behavior, safe condition, unsafe condition), specific behavior or condition noted, immediate corrective coaching provided, and follow-up required flag. Supports leading indicator dashboards, safety culture metrics, and proactive hazard identification programs.' .

ind:SafetyAudit rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Safety ;
    rdfs:label 'Safety Audit' ;
    rdfs:comment 'Formal safety audits, inspections, and regulatory examinations conducted internally or by external regulators (OSHA, PSC, PHMSA, NERC), including all associated findings, violations, and observations as line-level detail. Header level captures audit type (scheduled, unannounced, regulatory), scope, audit team composition, schedule, compliance rating, and overall disposition. Finding/line level captures individual deficiencies with finding ID, severity classification (critical, major, minor, observation), regulatory citation (e.g., OSHA 29 CFR 1910.147), violation determination, penalty assessment, required corrective action, responsible party, due date, closure status, and evidence of remediation. Serves as the authoritative SSOT for the complete audit execution lifecycle from planning through finding closure and regulatory response management. No separate finding-level product exists — all finding data lives here.' .

ind:AuditFinding rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Safety ;
    rdfs:label 'Audit Finding' ;
    rdfs:comment 'Individual findings, violations, and observations identified during a safety audit or regulatory inspection. Each finding has its own severity classification (critical, major, minor, observation), regulatory citation (e.g., OSHA 29 CFR 1910.147), required corrective action, due date, and closure status. Supports corrective action tracking and regulatory response management.' .

ind:CorrectiveAction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Safety ;
    rdfs:label 'Corrective Action' ;
    rdfs:comment 'Corrective and preventive actions (CAPAs) generated from incidents, near-misses, audit findings, and safety observations. Tracks action description, responsible party, target completion date, actual completion date, verification method, and effectiveness review. Serves as the SSOT for all safety-related corrective action tracking across OSHA, PHMSA, NERC CIP, and EPA compliance programs.' .

ind:HazmatInventory rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Safety ;
    rdfs:label 'Hazmat Inventory' ;
    rdfs:comment 'Hazardous materials lifecycle management covering chemical inventory, storage, and reportable release/spill events at utility facilities (generation plants, substations, gas compressor stations, service centers). For inventory: tracks chemical name, CAS number, maximum/average quantity on hand, storage location, SDS reference, SARA Title III Tier II reporting status, and EPA RMP applicability. For releases/spills: captures release type (spill, leak, atmospheric emission), substance, quantity released, release point, environmental media affected (air, water, soil), regulatory notification timeline and status (EPA NRC, state agency, local LEPC), containment and remediation actions, and root cause. Serves as the SSOT for all hazardous material records from cradle-to-grave including OSHA HazCom, EPA EPCRA Tier II reporting, PHMSA compliance, and emergency spill response management.' .

ind:HazmatRelease rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Safety ;
    rdfs:label 'Hazmat Release' ;
    rdfs:comment 'Reportable releases, spills, and emissions events involving hazardous materials, chemicals, or gases at utility facilities or during field operations. Captures release type (spill, leak, atmospheric emission), substance released, quantity, release point, environmental media affected (air, water, soil), regulatory notification status (EPA NRC, state agency), and remediation actions initiated.' .

ind:Training rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Safety ;
    rdfs:label 'Training' ;
    rdfs:comment 'Safety training course completions and certifications for utility employees and contractors. Tracks training course name, regulatory requirement (OSHA, NERC CIP, PHMSA, DOT), completion date, expiration date, training provider, pass/fail status, and recertification due date. Supports OSHA training compliance, NERC CIP personnel training requirements, and workforce safety readiness.' .

ind:JobHazardAnalysis rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Safety ;
    rdfs:label 'Job Hazard Analysis' ;
    rdfs:comment 'Job Hazard Analyses (JHAs) and Job Safety Analyses (JSAs) developed for utility work tasks including energized electrical work, confined space entry, gas pipeline maintenance, and tree trimming. Captures task steps, identified hazards per step, required controls and PPE, approval authority, and revision history. Serves as the pre-work safety planning SSOT for field operations.' .

ind:PermitToWork rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Safety ;
    rdfs:label 'Permit To Work' ;
    rdfs:comment 'Permit-to-work (PTW) records authorizing high-risk utility work activities including energized electrical work (NFPA 70E), confined space entry, hot work, excavation, and gas line work. Captures permit type, work location, authorized personnel, hazard controls verified, issuing authority, permit validity window, and closure confirmation. Supports OSHA lockout/tagout (LOTO) and confined space compliance.' .

ind:EnvironmentalEmission rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Safety ;
    rdfs:label 'Environmental Emission' ;
    rdfs:comment 'Air emissions monitoring and reporting records for utility generation facilities subject to EPA Clean Air Act (CAA) Title V permits, including SO2, NOx, CO2, mercury, and particulate matter. Captures emission source unit, pollutant type, measured emission rate, regulatory limit, compliance status, and EIA/EPA reporting period. Supports EPA continuous emissions monitoring system (CEMS) data and annual emissions inventory reporting.' .

ind:EnvironmentalCompliance rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Safety ;
    rdfs:label 'Environmental Compliance' ;
    rdfs:comment 'Environmental compliance management records encompassing operating permits (EPA Title V air, NPDES water discharge, RCRA hazardous waste, state agency permits), air emissions monitoring and reporting (SO2, NOx, CO2, mercury, PM under CAA Title V including CEMS continuous data and annual emissions inventory), water discharge monitoring (effluent limits, DMR reporting), and periodic environmental sampling (groundwater, stormwater, soil). Tracks permit conditions, emission source units, measured emission rates vs. regulatory limits, monitoring station results, exceedance flags and notifications, compliance status, and EPA/EIA reporting period data. Serves as the SSOT for all environmental regulatory compliance obligations, monitoring evidence, and emissions reporting. No separate emissions product exists — all emissions data lives here.' .

ind:PipelineIntegrityAssessment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Safety ;
    rdfs:label 'Pipeline Integrity Assessment' ;
    rdfs:comment 'PHMSA-mandated pipeline integrity management assessments for natural gas transmission and distribution pipelines. Captures assessment method (ILI inline inspection, pressure test, direct assessment), pipeline segment assessed, assessment date, defects identified, repair priority classification, and regulatory due date compliance. Supports PHMSA 49 CFR Part 192/195 integrity management program (IMP) requirements.' .

ind:CipComplianceRecord rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Safety ;
    rdfs:label 'Cip Compliance Record' ;
    rdfs:comment 'NERC CIP (Critical Infrastructure Protection) compliance evidence records for bulk electric system (BES) cyber and physical security standards. Tracks CIP standard and requirement (CIP-002 through CIP-014), applicable BES Cyber System or physical asset, evidence type (policy, procedure, log, screenshot, attestation), evidence collection date, compliance period, responsible entity and compliance owner, RSAW (Reliability Standard Audit Worksheet) mapping, and self-certification or audit disposition status. Supports NERC CIP annual self-certification filings, FERC/NERC audit readiness, and internal compliance monitoring programs.' .

ind:IntercompanyTransaction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Intercompany Transaction' ;
    rdfs:comment 'Records of financial transactions between affiliated legal entities within the utility holding company structure, including shared service charges, fuel transfers, capacity payments, and management fees. Tracks sender/receiver company codes, elimination entries, and PUC affiliate transaction compliance. Supports consolidated financial statement preparation and state PUC affiliate transaction audit requirements.' .

ind:BankAccount rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Bank Account' ;
    rdfs:comment 'Treasury master data for utility bank accounts including operating accounts, debt service reserve funds, nuclear decommissioning trust accounts, storm reserve funds, and escrow accounts. Tracks bank, account number, account type, authorized signers, balance positions, and sweep arrangements. Supports cash positioning, bank reconciliation, and debt covenant compliance monitoring.' .

ind:ProductProgram rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Product ;
    rdfs:label 'Product Program' ;
    rdfs:comment 'Unified master catalog of all utility-sponsored customer programs including Demand Response (DR), Net Energy Metering (NEM), Energy Efficiency (EE), low-income assistance (CARE/FERA/LIHEAP), electric vehicle (EV) charging, and voluntary green tariff programs. Each record specifies program name, program category (DR/NEM/EE/low-income/EV/green), target customer segment, enrollment capacity, incentive structure summary, PUC authorization reference, program administrator, budget cycle, effective and expiration dates, and current program status. Category-specific attributes (e.g., load reduction targets for DR, system size caps for NEM, savings goals for EE) are stored as structured metadata. Serves as the SSOT for all program definitions consumed by customer enrollment and billing systems.' .

ind:ProgramMeasure rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Product ;
    rdfs:label 'Program Measure' ;
    rdfs:comment 'Catalog of eligible measures, technologies, or qualifying equipment within any utility program type. For EE programs: rebate-eligible measures (LED lighting, HVAC upgrades, smart thermostats, insulation) with deemed savings values (kWh/year), demand reduction (kW), measure life (years), and incentive amounts ($/unit or $/kWh saved) sourced from PUC-approved deemed savings databases. For NEM programs: eligible generation technologies (solar PV, wind, fuel cell) with system size caps. For DR programs: qualifying load control devices and communication protocols. For EV programs: eligible charging equipment (Level 1/2/DCFC) with make/model qualification. Each record specifies measure name, category, parent program, qualifying specifications, baseline efficiency standard, minimum qualifying specification, incentive method, estimated savings/capacity, measure life, and PUC-approved status.' .

ind:RateSeasonCalendar rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Product ;
    rdfs:label 'Rate Season Calendar' ;
    rdfs:comment 'Defines the seasonal and day-type calendar used by rate schedules to determine which pricing periods, tiers, and components apply on any given date and time. Each record specifies the calendar name, season definitions (summer/winter/shoulder with start and end dates), day-type classifications (weekday, weekend, holiday), holiday list, and the rate schedules that reference this calendar. Critical for TOU rate application where the billing engine must determine the correct season and day-type for each meter interval.' .

ind:StartupShutdownEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Generation ;
    rdfs:label 'Startup Shutdown Event' ;
    rdfs:comment 'Transactional records for each generating unit startup and shutdown event capturing event type (hot start, warm start, cold start, normal shutdown, emergency trip), initiating cause, start/end timestamps, fuel consumed during startup (MMBtu), startup cost ($), ramp rate achieved (MW/min), emissions during startup, associated dispatch instruction reference, and unit status transitions. Supports startup cost allocation for LCOE, emissions reporting during non-steady-state operation, and unit commitment optimization. Critical for FERC Form 1 O&M cost allocation and EPA startup/shutdown exemption tracking.' .

ind:FinanceLease rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Finance Lease' ;
    rdfs:comment 'ASC 842 lease accounting records for operating and finance leases including generation facility PPAs classified as leases, fleet vehicle leases, office space leases, and equipment leases. Tracks right-of-use asset, lease liability, payment schedule, lease term, discount rate, and lease classification. Supports FERC Form 1 reporting of lease obligations and rate case treatment of lease expense vs. capital lease amortization.' .

ind:ConductorSpan rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Conductor Span' ;
    rdfs:comment 'Master record for each discrete overhead or underground conductor segment (span) connecting two distribution structures (pole-to-pole, pole-to-device, or vault-to-vault). Captures span identifier, conductor type (ACSR/AAC/copper/XLPE/EPR), gauge (AWG/kcmil), phase configuration (A/B/C/N), length (ft), rated ampacity, installation year, sag at design temperature, associated feeder, from-structure reference (pole/vault), to-structure reference (pole/vault), GIS line geometry, and operational status. Fundamental topology element for GIS-based network modeling, storm damage assessment (broken spans), vegetation management targeting, capacity analysis, and outage extent determination.' .

ind:EmergencyDrill rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Safety ;
    rdfs:label 'Emergency Drill' ;
    rdfs:comment 'Emergency drill and exercise records documenting planned and executed emergency response exercises required by OSHA 1910.38 (emergency action plans), PHMSA 49 CFR 192.615 (gas pipeline emergency response), NRC emergency preparedness (nuclear), and state/local fire marshal requirements. Captures drill type (tabletop, functional, full-scale), scenario description, participating personnel and agencies, drill date, performance objectives, after-action findings, improvement items, and regulatory compliance status. Supports annual drill compliance tracking, mutual aid coordination documentation, and emergency preparedness program effectiveness measurement.' .

ind:Interaction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Customer ;
    rdfs:label 'Interaction' ;
    rdfs:comment 'Customer service interaction record capturing inbound and outbound contacts across all channels (phone, web, IVR, chat, in-person) with resolution tracking' .

ind:Complaint rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Customer ;
    rdfs:label 'Complaint' ;
    rdfs:comment 'Formal customer complaint record filed through PUC, internal channels, or regulatory bodies requiring tracking, investigation, and resolution within mandated timeframes' .

ind:WeatherForecast rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Gridops ;
    rdfs:label 'Weather Forecast' ;
    rdfs:comment 'Weather forecast data integrated into grid operations for load forecasting, storm preparation, and renewable generation prediction including temperature, wind speed, cloud cover, and precipitation' .

ind:Parcel rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Property ;
    rdfs:label 'Parcel' ;
    rdfs:comment 'Master record for each land parcel owned, leased, or otherwise held by the utility. Captures assessor parcel number (APN), legal description, acreage, zoning classification, land use designation, acquisition date, acquisition cost, current market value, county/jurisdiction, GIS polygon reference, title status, and encumbrance flags. Serves as the SSOT for all utility-owned and utility-controlled land parcels distinct from infrastructure asset locations.' .

ind:Facility rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Property ;
    rdfs:label 'Facility' ;
    rdfs:comment 'Master record for each utility-owned or utility-operated building and facility structure including administrative offices, operations centers, control buildings, maintenance shops, warehouses, substations buildings, and visitor centers. Captures facility name, facility type (office, operations, warehouse, control room), address, gross square footage, construction year, occupancy capacity, building condition rating, lease vs. owned flag, and facility manager. Distinct from infrastructure assets (poles, transformers) which are owned by the asset domain.' .

ind:Easement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Property ;
    rdfs:label 'Easement' ;
    rdfs:comment 'Master record for each utility easement, right-of-entry, or access agreement held by the utility over third-party land. Captures easement type (transmission ROW, distribution corridor, pipeline corridor, access road, drainage), grantor name, grantor parcel APN, easement width (feet), centerline length, recorded document number, county recorder book/page, recording date, expiration date (if term easement), compensation paid, and current status (active, expired, disputed, vacated). Serves as SSOT for all utility land rights over non-owned property.' .

ind:LandRight rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Property ;
    rdfs:label 'Land Right' ;
    rdfs:comment 'Master record for all other utility land rights beyond easements, including licenses, permits-to-enter, temporary construction licenses, franchise agreements with municipalities, and surface use agreements. Captures right type, grantor/licensor, affected parcel or corridor, term start/end dates, annual fee, renewal terms, governing document reference, and right status. Complements the easement entity by covering non-easement land access instruments.' .

ind:Site rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Property ;
    rdfs:label 'Site' ;
    rdfs:comment 'Master record for each distinct physical site or geographic location managed by the utility as a property unit, including generation plant sites, substation sites, service center yards, laydown areas, and environmental remediation sites. Captures site name, site type, GIS coordinates (centroid lat/long), site boundary polygon reference, total acreage, site status (active, inactive, remediation, decommissioned), associated facility IDs, and environmental classification. Acts as the geographic anchor linking parcels, facilities, and infrastructure.' .

ind:PropertyLease rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Property ;
    rdfs:label 'Property Lease' ;
    rdfs:comment 'Master record for real property leases where the utility is either the lessor (leasing utility-owned property to third parties) or lessee (leasing property from third-party owners for utility use). Captures lease type (ground lease, building lease, tower lease, cell antenna lease), counterparty name, leased premises description, lease term start/end, base rent amount, rent escalation schedule, renewal options, security deposit, and lease status. Distinct from ASC 842 finance/operating lease accounting records owned by the finance domain.' .

ind:Acquisition rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Property ;
    rdfs:label 'Acquisition' ;
    rdfs:comment 'Transactional record for each real property acquisition event including fee simple purchases, condemnation proceedings (eminent domain), donation/dedication, and tax deed acquisitions. Captures acquisition type, seller/grantor name, purchase price, appraisal value, closing date, title company, escrow number, deed type, recording information, associated parcel IDs, and acquisition purpose (generation siting, T&D corridor, service center, environmental mitigation). Tracks the full lifecycle from offer through closing and title recording.' .

ind:Disposition rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Property ;
    rdfs:label 'Disposition' ;
    rdfs:comment 'Transactional record for each real property disposition event including fee simple sales, quitclaim deeds, abandonments, dedications to public agencies, and exchanges. Captures disposition type, buyer/grantee name, sale price, appraisal value, closing date, deed type, recording information, associated parcel IDs, regulatory approval reference (CPUC/FERC approval if required), and gain/loss on sale. Tracks the full lifecycle from listing/approval through closing.' .

ind:Encroachment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Property ;
    rdfs:label 'Encroachment' ;
    rdfs:comment 'Transactional record for each identified encroachment on utility-owned land or easement corridors by third parties. Captures encroachment type (structure, fence, vegetation, fill, excavation), encroaching party name and contact, affected parcel or easement ID, discovery date, GIS location, encroachment severity (minor, moderate, major), resolution status (open, notice issued, resolved, legal action), resolution date, and resolution method. Supports ROW protection and legal enforcement workflows.' .

ind:Permit rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Property ;
    rdfs:label 'Permit' ;
    rdfs:comment 'Master record for all land use, building, grading, and environmental permits obtained by the utility for property development, construction, and operations. Captures permit type (building, grading, encroachment, conditional use, variance, special use), issuing agency, permit number, issue date, expiration date, permitted activity description, associated site or parcel, permit conditions, inspection requirements, and permit status. Distinct from environmental operating permits (owned by regulatory domain) and generation environmental permits (owned by generation domain).' .

ind:TitleRecord rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Property ;
    rdfs:label 'Title Record' ;
    rdfs:comment 'Master record for the chain of title and title insurance documentation for each utility-owned parcel. Captures title insurance policy number, title company, policy effective date, policy amount, title exceptions and encumbrances listed, title search date, vesting deed reference, and title status (clear, clouded, disputed, under examination). Supports title curative work, financing, and regulatory property filings.' .

ind:Appraisal rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Property ;
    rdfs:label 'Appraisal' ;
    rdfs:comment 'Transactional record for each formal real property appraisal or valuation conducted for utility-owned or target-acquisition parcels. Captures appraisal type (fee appraisal, review appraisal, condemnation appraisal, insurance replacement cost), appraiser name and certification, appraisal date, appraised value, valuation methodology (sales comparison, income, cost), associated parcel or easement ID, appraisal purpose (acquisition, disposition, rate base, condemnation), and report reference. Supports rate base valuation and eminent domain proceedings.' .

ind:EnvironmentalCondition rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Property ;
    rdfs:label 'Environmental Condition' ;
    rdfs:comment 'Master record for known environmental conditions, contamination findings, and remediation obligations associated with utility-owned or operated sites and parcels. Captures condition type (soil contamination, groundwater contamination, PCB, asbestos, lead paint, underground storage tank), discovery date, regulatory agency notification status, regulatory case number, remediation status (assessment, active remediation, monitoring, closed), responsible party designation, and estimated remediation cost. Supports environmental liability tracking and rate base regulatory asset filings.' .

ind:RemediationActivity rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Property ;
    rdfs:label 'Remediation Activity' ;
    rdfs:comment 'Transactional record for each discrete remediation or environmental cleanup activity performed at a contaminated utility site. Captures activity type (soil excavation, groundwater pump-and-treat, vapor extraction, monitoring well sampling, cap installation), activity date, contractor name, volume of material removed, analytical results summary, regulatory agency approval reference, cost incurred, and activity status. Links to environmental_condition as the parent record and supports CERCLA/RCRA compliance tracking.' .

ind:SpaceAllocation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Property ;
    rdfs:label 'Space Allocation' ;
    rdfs:comment 'Master record tracking the allocation and assignment of interior space within utility facilities to organizational units, departments, and functions. Captures facility ID, floor/wing/room identifier, allocated square footage, assigned department or cost center, occupancy start date, occupancy end date, space type (office, lab, operations floor, storage, common area), and allocation status. Supports facility space planning, chargeback cost allocation, and real estate portfolio optimization.' .

ind:FacilityInspection rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Property ;
    rdfs:label 'Facility Inspection' ;
    rdfs:comment 'Transactional record for each formal inspection of a utility facility or building including fire safety inspections, ADA compliance inspections, structural inspections, HVAC inspections, and regulatory building inspections. Captures inspection type, inspection date, inspector name and affiliation (internal, third-party, regulatory), facility ID, inspection findings summary, deficiency count, deficiency severity, corrective action required flag, and inspection outcome (pass, conditional pass, fail). Distinct from infrastructure asset inspections owned by the asset domain.' .

ind:LeasePayment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Property ;
    rdfs:label 'Lease Payment' ;
    rdfs:comment 'Transactional record for each rent or lease payment made or received under a property lease agreement. Captures payment direction (inbound from tenant, outbound to landlord), payment date, payment amount, payment period covered, payment method, associated property_lease ID, invoice or remittance reference, and payment status (scheduled, paid, overdue, disputed). Supports lease portfolio cash flow tracking and AP/AR reconciliation with the finance domain.' .

ind:CondemnationProceeding rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Property ;
    rdfs:label 'Condemnation Proceeding' ;
    rdfs:comment 'Transactional record for each eminent domain or condemnation proceeding initiated by the utility to acquire property rights for infrastructure projects. Captures proceeding type (quick-take, standard condemnation, inverse condemnation defense), affected parcel or easement, property owner name, filing date, court case number, just compensation offer amount, final award amount, settlement date, legal counsel, and proceeding status (pre-filing, filed, negotiation, trial, settled, closed). Supports legal and regulatory compliance for utility infrastructure expansion.' .

ind:GisBoundary rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Property ;
    rdfs:label 'Gis Boundary' ;
    rdfs:comment 'Master record for the GIS spatial boundary definitions associated with utility property assets including parcel polygons, easement corridors, site boundaries, and ROW centerlines. Captures geometry type (polygon, polyline, point), coordinate reference system (CRS/EPSG code), GIS layer name, source system (Esri ArcGIS, GIS platform), last survey date, survey accuracy class, associated property entity type and ID, and boundary status (current, superseded, under revision). Serves as the spatial geometry SSOT for the property domain.' .

ind:Survey rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Property ;
    rdfs:label 'Survey' ;
    rdfs:comment 'Transactional record for each land survey conducted on utility-owned or target parcels and easement corridors. Captures survey type (boundary survey, ALTA/NSPS survey, topographic survey, as-built survey, route survey), licensed surveyor name and license number, survey date, survey firm, associated parcel or easement ID, survey drawing reference, legal description produced, and survey status. Supports title insurance, condemnation, and infrastructure siting workflows.' .

ind:TaxRecord rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Property ;
    rdfs:label 'Tax Record' ;
    rdfs:comment 'Master record for annual property tax assessments and payments for each utility-owned parcel. Captures tax year, county assessor parcel number (APN), assessed land value, assessed improvement value, total assessed value, tax rate area, annual tax amount, tax bill number, payment due dates, payment status, and any exemption or abatement applied (utility property tax exemptions vary by state). Supports property tax expense tracking, rate base filings, and tax appeal management.' .

ind:LicenseAgreement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Property ;
    rdfs:label 'License Agreement' ;
    rdfs:comment 'Master record for license agreements where the utility grants third parties the right to use utility-owned property for compatible uses such as cell tower colocation, fiber optic attachments, billboard placements, agricultural licenses, and pipeline crossings. Captures licensee name, license type, licensed area description, associated parcel or easement ID, license term, annual license fee, revenue share terms, insurance requirements, and license status. Supports utility property revenue generation and ROW compatibility management.' .

ind:ZoningClassification rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Property ;
    rdfs:label 'Zoning Classification' ;
    rdfs:comment 'Reference master for land use zoning classifications and designations applicable to utility-owned parcels and project sites. Captures jurisdiction name, zoning code, zoning category (residential, commercial, industrial, agricultural, open space, special use), permitted uses, conditional uses, utility infrastructure compatibility flag, setback requirements, height limits, and effective date. Supports siting studies, permitting workflows, and land use planning for utility infrastructure projects.' .

ind:Document rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Property ;
    rdfs:label 'Document' ;
    rdfs:comment 'Master record for all legal and administrative documents associated with utility property assets including deeds, recorded easements, title policies, survey plats, environmental reports, lease agreements, and permit documents. Captures document type, document title, recording date, recording number, county recorder jurisdiction, associated property entity type and ID, document storage reference (document management system path), and document status (current, superseded, archived). Serves as the document registry for the property domain.' .

ind:ItAsset rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Technology ;
    rdfs:label 'It Asset' ;
    rdfs:comment 'Master record for every IT hardware and software asset owned or managed by the utility, including servers, workstations, laptops, network devices, storage arrays, and licensed software. Captures asset tag, serial number, manufacturer, model, asset class (hardware/software/virtual), lifecycle state (ordered, deployed, in-service, retired), assigned cost center, physical location, and warranty expiration. Serves as the SSOT for IT asset inventory distinct from the operational technology (OT) asset registry in the asset domain.' .

ind:OtAsset rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Technology ;
    rdfs:label 'Ot Asset' ;
    rdfs:comment 'Master record for operational technology (OT) assets managed under the IT/OT convergence program, including SCADA servers, RTUs, PLCs, IEDs, historian servers, DCS controllers, and HMI workstations. Captures OT asset identifier, asset type, firmware version, communication protocol (DNP3, Modbus, IEC 61850), associated control system, NERC CIP impact classification, network zone, and lifecycle state. Complements the physical infrastructure records in the asset domain by focusing on the OT device identity and cybersecurity posture.' .

ind:Application rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Technology ;
    rdfs:label 'Application' ;
    rdfs:comment 'Master record for every enterprise application in the utility\'s application portfolio, covering both commercial off-the-shelf (COTS) and custom-developed systems. Captures application name, vendor, version, deployment model (on-premise, cloud SaaS, hybrid), business capability supported, application tier (presentation, business logic, data), hosting environment, lifecycle status (active, sunset, decommissioned), business owner, IT owner, and integration dependencies. Serves as the SSOT for application portfolio management (APM).' .

ind:NetworkDevice rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Technology ;
    rdfs:label 'Network Device' ;
    rdfs:comment 'Master record for all network infrastructure devices including routers, switches, firewalls, load balancers, wireless access points, and SD-WAN appliances deployed across the utility\'s IT and OT networks. Captures device hostname, IP address, MAC address, network zone (corporate LAN, OT DMZ, control network, field network), VLAN assignments, firmware version, management protocol, physical location, and network segment classification. Distinct from OT assets in that these are pure network infrastructure elements.' .

ind:ItService rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Technology ;
    rdfs:label 'It Service' ;
    rdfs:comment 'Master catalog of IT and OT services delivered by the technology organization to internal business units and field operations. Captures service name, service category (infrastructure, application, security, communications, OT support), service tier (critical, standard, basic), service owner, SLA tier, supported business processes, and service status. Serves as the SSOT for the IT service catalog used in ITSM workflows and service request routing.' .

ind:IncidentTicket rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Technology ;
    rdfs:label 'Incident Ticket' ;
    rdfs:comment 'ITSM incident record capturing every IT and OT service disruption, outage, or degradation reported by utility staff or detected by monitoring systems. Captures ticket number, incident category (network, server, application, OT/SCADA, cybersecurity), priority (P1–P4), affected service, affected business unit, reported datetime, acknowledged datetime, resolved datetime, root cause category, resolution description, and SLA breach flag. Distinct from safety incidents (owned by safety domain) and grid outage events (owned by gridops domain).' .

ind:ChangeRequest rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Technology ;
    rdfs:label 'Change Request' ;
    rdfs:comment 'IT change management record for all planned changes to IT and OT infrastructure, applications, and configurations. Captures change request number, change type (standard, normal, emergency), change category (infrastructure, application, OT/SCADA, security), risk level, affected systems, change window start/end, approver, implementation status, rollback plan, and post-implementation review outcome. Supports NERC CIP change management requirements for BES Cyber Systems.' .

ind:ServiceRequestTicket rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Technology ;
    rdfs:label 'Service Request Ticket' ;
    rdfs:comment 'ITSM service request record for standard, pre-approved IT service fulfillment activities initiated by utility employees and contractors. Captures request number, request category (access provisioning, hardware request, software install, account management, OT support), requester, assigned technician, fulfillment SLA, requested datetime, fulfilled datetime, and fulfillment status. Distinct from incident_ticket (unplanned disruptions) and change_request (infrastructure changes).' .

ind:TechProject rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Technology ;
    rdfs:label 'Tech Project' ;
    rdfs:comment 'Master record for technology project delivery initiatives including IT infrastructure upgrades, OT modernization programs, AMI deployments, SCADA/EMS upgrades, cybersecurity programs, and digital platform implementations. Captures project name, project type (infrastructure, OT/SCADA, cybersecurity, digital, application), project phase (initiation, planning, execution, closeout), budget, actual spend, planned start/end dates, actual start/end dates, project manager, sponsoring business unit, and strategic program alignment. Distinct from capital expenditure projects in the finance domain.' .

ind:ProjectMilestone rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Technology ;
    rdfs:label 'Project Milestone' ;
    rdfs:comment 'Transactional record for each planned and completed milestone within a technology project. Captures milestone name, milestone type (gate review, go-live, cutover, testing complete, regulatory submission), planned date, actual date, milestone status (pending, achieved, missed, deferred), accountable owner, and associated deliverable description. Enables project schedule tracking and earned value management for technology delivery programs.' .

ind:CyberVulnerability rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Technology ;
    rdfs:label 'Cyber Vulnerability' ;
    rdfs:comment 'Master record for cybersecurity vulnerabilities identified across IT and OT assets through vulnerability scanning, penetration testing, threat intelligence feeds, and vendor advisories. Captures CVE identifier, vulnerability name, CVSS score, severity (critical, high, medium, low), affected asset type, affected software/firmware version, discovery method, discovery date, remediation status, remediation due date, and NERC CIP applicability flag. Serves as the SSOT for vulnerability management program tracking.' .

ind:CyberIncident rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Technology ;
    rdfs:label 'Cyber Incident' ;
    rdfs:comment 'Cybersecurity incident record capturing confirmed or suspected security events including malware infections, unauthorized access attempts, phishing attacks, ransomware events, OT/SCADA intrusion attempts, and data breaches. Captures incident identifier, incident type, attack vector, affected systems, detection source (SIEM, IDS, user report), detection datetime, containment datetime, eradication datetime, recovery datetime, NERC CIP reportability flag, regulatory notification status, and lessons learned. Distinct from IT service incidents (incident_ticket) which cover non-security disruptions.' .

ind:AccessEntitlement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Technology ;
    rdfs:label 'Access Entitlement' ;
    rdfs:comment 'Master record for logical access entitlements granted to utility employees, contractors, and service accounts across IT systems, OT networks, and critical infrastructure platforms. Captures entitlement identifier, user or service account, system or application, access role or permission level, access type (read, write, admin, privileged), grant date, expiration date, approver, business justification, and NERC CIP Electronic Access Control applicability. Supports identity and access management (IAM) governance and NERC CIP-006/CIP-007 compliance.' .

ind:AccessReview rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Technology ;
    rdfs:label 'Access Review' ;
    rdfs:comment 'Periodic access certification and recertification review record for logical access entitlements. Captures review cycle identifier, review period, reviewer (manager or system owner), entitlement reviewed, review decision (certified, revoked, modified), review completion date, and compliance status. Supports quarterly and annual access recertification requirements under NERC CIP and SOX IT general controls.' .

ind:ScadaSystem rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Technology ;
    rdfs:label 'Scada System' ;
    rdfs:comment 'Master record for each SCADA, EMS, DMS, GMS, or OT control system platform deployed by the utility. Captures system name, system type (EMS, SCADA, DMS, GMS, OMS, AMI head-end, DERMS), vendor, version, deployment environment (production, DR, test), primary function, geographic coverage area, communication architecture, redundancy configuration, NERC CIP BES Cyber System classification, and lifecycle status. Serves as the SSOT for OT control system inventory distinct from individual OT device records.' .

ind:ScadaConfiguration rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Technology ;
    rdfs:label 'Scada Configuration' ;
    rdfs:comment 'Configuration baseline record for SCADA, EMS, and OT control system platforms capturing approved software versions, patch levels, enabled services, communication port configurations, and security settings. Captures configuration snapshot date, system identifier, configuration item type, approved baseline value, current value, deviation flag, and last verified date. Supports NERC CIP-010 configuration change management and baseline monitoring requirements.' .

ind:PatchDeployment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Technology ;
    rdfs:label 'Patch Deployment' ;
    rdfs:comment 'Transactional record for each software or firmware patch deployment applied to IT and OT assets. Captures patch identifier, CVE references addressed, target asset, patch source (vendor advisory, CISA KEV, internal), deployment method (automated, manual), deployment datetime, deployment status (scheduled, applied, failed, deferred), deferral justification, and NERC CIP patch management applicability. Supports NERC CIP-007 security patch management compliance tracking.' .

ind:SoftwareLicense rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Technology ;
    rdfs:label 'Software License' ;
    rdfs:comment 'Master record for software license entitlements held by the utility covering enterprise agreements, perpetual licenses, subscription licenses, and open-source usage. Captures license identifier, software product name, vendor, license type (perpetual, subscription, concurrent, named user, site), licensed quantity, deployed quantity, license start/end dates, annual cost, contract reference, and compliance status. Supports software asset management (SAM) and audit readiness.' .

ind:TelecomCircuit rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Technology ;
    rdfs:label 'Telecom Circuit' ;
    rdfs:comment 'Master record for telecommunications circuits and wide-area network (WAN) connections used by the utility for operational communications, SCADA telemetry, AMI backhaul, and corporate connectivity. Captures circuit identifier, circuit type (fiber, microwave, cellular, leased line, MPLS, satellite), carrier, bandwidth, endpoints (substation, plant, office, data center), service class (operational critical, business, backup), monthly cost, contract term, and operational status. Covers both IT WAN circuits and OT communication links.' .

ind:DisasterRecoveryPlan rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Technology ;
    rdfs:label 'Disaster Recovery Plan' ;
    rdfs:comment 'Master record for IT and OT disaster recovery plans (DRPs) and business continuity plans (BCPs) covering critical utility systems. Captures plan name, plan type (IT DRP, OT/SCADA DRP, BCP), covered systems, recovery time objective (RTO), recovery point objective (RPO), primary recovery site, alternate recovery site, plan owner, last tested date, last updated date, test result status, and regulatory requirement reference (NERC CIP-009). Supports resilience planning for critical infrastructure.' .

ind:DrTestEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Technology ;
    rdfs:label 'Dr Test Event' ;
    rdfs:comment 'Transactional record for each disaster recovery or business continuity test exercise conducted for IT and OT systems. Captures test event identifier, associated DR plan, test type (tabletop, functional, full failover), test date, systems tested, RTO achieved, RPO achieved, test outcome (pass, partial pass, fail), gaps identified, and corrective actions required. Supports NERC CIP-009 R3 recovery plan testing and documentation requirements.' .

ind:TechVendor rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Technology ;
    rdfs:label 'Tech Vendor' ;
    rdfs:comment 'Master record for technology vendors, managed service providers (MSPs), and IT/OT contractors providing technology products and services to the utility. Captures vendor name, vendor type (hardware OEM, software vendor, MSP, systems integrator, telecom carrier, OT/SCADA vendor), primary contact, contract status, security assessment status, NERC CIP supply chain risk management (SCRM) classification, and approved vendor list status. Distinct from the supply domain\'s vendor master which focuses on fuel and materials procurement.' .

ind:SupplyChainRisk rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Technology ;
    rdfs:label 'Supply Chain Risk' ;
    rdfs:comment 'NERC CIP-013 supply chain cyber security risk management record for technology vendors and software/hardware components used in BES Cyber Systems. Captures risk assessment identifier, vendor or component assessed, risk category (software integrity, hardware authenticity, remote access, vendor notification), risk rating, identified threats, mitigating controls, assessment date, and remediation status. Supports the utility\'s NERC CIP-013 supply chain risk management plan.' .

ind:ItSla rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Technology ;
    rdfs:label 'It Sla' ;
    rdfs:comment 'Master record for IT and OT service level agreements defining performance commitments between the technology organization and internal business unit customers. Captures SLA identifier, associated IT service, SLA metric type (availability %, MTTR, response time, resolution time), target value, measurement period, reporting frequency, escalation thresholds, and business unit covered. Provides the reference baseline against which SLA performance is measured from incident and service request data.' .

ind:DigitalPlatform rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Technology ;
    rdfs:label 'Digital Platform' ;
    rdfs:comment 'Master record for digital customer and operational platforms managed by the technology organization including customer self-service portals, mobile apps, AMI data platforms, DERMS platforms, and grid analytics platforms. Captures platform name, platform type (customer portal, mobile app, data platform, analytics platform, integration platform), deployment model, supported business capabilities, active user count, release version, vendor or in-house development flag, and lifecycle status. Supports digital transformation portfolio management.' .

ind:PlatformRelease rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Technology ;
    rdfs:label 'Platform Release' ;
    rdfs:comment 'Transactional record for each software release, deployment, or version update for digital platforms and enterprise applications. Captures release identifier, associated application or platform, release version, release type (major, minor, patch, hotfix), planned deployment date, actual deployment date, deployment environment (dev, test, staging, production), release notes summary, change request reference, deployment status, and post-deployment validation outcome. Supports application lifecycle management and release governance.' .

ind:TechSpend rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Technology ;
    rdfs:label 'Tech Spend' ;
    rdfs:comment 'Technology expenditure record tracking actual IT and OT spending by category, cost center, and project for internal technology financial management. Captures spend record identifier, spend category (hardware, software licenses, telecom, managed services, professional services, cloud), vendor, invoice reference, amount, currency, spend period, associated tech project or application, cost center, and capitalization flag (CAPEX vs OPEX). Supports technology total cost of ownership (TCO) analysis and IT budget management distinct from the finance domain\'s general ledger.' .

ind:Employee rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Employee' ;
    rdfs:comment 'Master reference table for employee. ' .

ind:Allocation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Generation ;
    rdfs:label 'Allocation' ;
    rdfs:comment 'Represents the contractual allocation of electricity generation capacity from a plant to a metering service point. Each record captures the percentage of output allocated, the governing contract, and the effective start and end dates of the allocation.. Existence Justification: A generation plant can allocate portions of its output to multiple service points, and a service point can receive electricity from multiple plants. These allocations are managed through contracts that record allocation percentages, contract identifiers, and effective dates. The relationship is actively created, updated, and deleted by business users as part of the power distribution planning process.' .

ind:AuditPlantAssignment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Generation ;
    rdfs:label 'Audit Plant Assignment' ;
    rdfs:comment 'Represents the assignment of a safety audit to a generation plant. Each record links one plant to one safety audit and captures the audit\'s timing, type, and status as they apply to that specific plant.. Existence Justification: Safety audits in the utility can be conducted across multiple generation plants, and each plant may be subject to many audits over its lifecycle. The audit process is managed as a distinct activity that references the plants it covers, and the relationship is actively created and maintained by safety teams.' .

ind:LineCrewAssignment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Line Crew Assignment' ;
    rdfs:comment 'Represents the assignment of a field crew to a transmission line. Each record captures the crew, the line, the assignment start and end dates, and the crew\'s role for that assignment.. Existence Justification: A transmission line can be serviced by many field crews over its lifecycle, and a crew can be dispatched to work on many different transmission lines. The utility actively creates, updates, and deletes assignment records that capture which crew is assigned to which line, with start/end dates and role information.' .

ind:LineProjectAssignment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Line Project Assignment' ;
    rdfs:comment 'Represents the assignment of transmission line segments to capital expenditure projects, capturing the allocated budget and schedule for each line within a project.. Existence Justification: A capital expenditure project can involve multiple transmission line segments, and a single transmission line can be part of multiple projects over its lifecycle (e.g., upgrades, replacements). The utility actively creates, updates, and deletes these line-project assignments, tracking budget and schedule per line within each project. This operational process makes the relationship a true many-to-many entity.' .

ind:RightOfWayAgreement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Right Of Way Agreement' ;
    rdfs:comment 'Represents the contractual relationship between a transmission line and a land parcel for right-of-way usage. Each record links one line to one parcel and stores the length of the line segment within the parcel and the compensation amount paid to the landowner.. Existence Justification: A transmission line can cross multiple land parcels, and a single parcel can contain sections of multiple transmission lines. The utility actively records each line-parcel crossing to calculate compensation and track right-of-way usage, which is required for regulatory reporting and land-owner settlements.' .

ind:FeederCrewAssignment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Feeder Crew Assignment' ;
    rdfs:comment 'Represents the assignment of a workforce crew to a distribution feeder. Each record captures when the crew started and ended work on the feeder and the role the crew performed (e.g., maintenance, restoration).. Existence Justification: Crews are dispatched to maintain distribution feeders, and a single feeder may be serviced by multiple crews over time. The utility records each assignment with start/end timestamps and the crew\'s role, and crews regularly work on many different feeders.' .

ind:DispatchParticipation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Gridops ;
    rdfs:label 'Dispatch Participation' ;
    rdfs:comment 'This association product represents the participation of meters in demand-response dispatch events. Each record links one dr_dispatch_event to one meter and captures attributes that exist only in the context of this relationship.. Existence Justification: A demand-response dispatch event can involve many meters, and a given meter can be dispatched in many events over time. The utility records each participation with status, actual reduction, and response timestamp, which are attributes of the participation itself. This relationship is actively managed by grid operations and is a distinct business entity.' .

ind:ProgramZoneAssignment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Der ;
    rdfs:label 'Program Zone Assignment' ;
    rdfs:comment 'Represents the assignment of a DER program to a control zone, capturing the period of effectiveness and current status. Each record links one control zone to one program with attributes that exist only in the context of this relationship.. Existence Justification: DER programs are deployed to electrical control zones. Each control zone can host multiple DER programs simultaneously, and each DER program can be offered in multiple control zones. The utility records the effective start and end dates and the status of each zone-program assignment.' .

ind:MeterWorkOrderAssignment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Metering ;
    rdfs:label 'Meter Work Order Assignment' ;
    rdfs:comment 'Represents the assignment of a work order to a specific meter. Each record captures task-specific details (type, labor, cost, priority) that exist only in the context of this work order-meter relationship.. Existence Justification: A work order can involve maintenance on multiple meters, and each meter can be serviced by many work orders over its lifecycle. The utility records each work order-meter pairing with specific task details such as labor hours, cost, and task type. This many-to-many relationship is actively managed by field crews and dispatch planners.' .

ind:MeteringEnrollment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Metering ;
    rdfs:label 'Metering Enrollment' ;
    rdfs:comment 'This association product represents the enrollment relationship between a meter and a DSM program. It captures when a meter enrolls in a program, the incentive amount awarded, and the current enrollment status.. Existence Justification: Meters can be enrolled in multiple DSM programs and each DSM program can have many meters enrolled. The enrollment itself is managed as a distinct business entity with attributes such as enrollment date, incentive amount, and status.' .

ind:SwitchingOrderMaterialAllocation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Gridops ;
    rdfs:label 'Switching Order Material Allocation' ;
    rdfs:comment 'Association table that records which material items are allocated to each grid operations switching order, including the quantity, unit of measure, and line status for each material requirement.. Existence Justification: A switching order often requires several spare parts or equipment items, and each material can be used in many different switching orders. The utility tracks the quantity, unit of measure, and status of each material assigned to a specific order, creating a distinct record for every order-material pair.' .

ind:CustomerAccountPlan rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Customer ;
    rdfs:label 'Customer Account Plan' ;
    rdfs:comment 'This association product represents the strategic planning relationship between a customer_account and a ci_account. It captures planning attributes such as targets, budgets, risk assessments, and effective dates that belong to the plan itself, not to either account individually.. Existence Justification: A corporate C&I account (ci_account) can be linked to multiple individual customer accounts for strategic planning, and a single customer account may participate in multiple plans over time. The link is actively managed as an Account Plan and carries its own attributes such as targets, budgets, risk ratings, and effective dates.' .

ind:BillingProgramEnrollment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Billing Program Enrollment' ;
    rdfs:comment 'This association captures the enrollment of a billing account in a safety program. Each record links one billing account to one safety program and stores attributes that are specific to the enrollment such as the start date and compliance status.. Existence Justification: A billing account (representing a customer’s service location) can be enrolled in multiple safety programs, and each safety program can be applied to many billing accounts. The enrollment is actively managed by safety staff, with start dates and compliance status tracked for each account-program pair.' .

ind:AssetTechnicianAuthorization rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Asset Technician Authorization' ;
    rdfs:comment 'Represents the authorization of field technicians to work on specific utility assets. Each record links one asset registry entry to one technician and stores attributes that belong only to the authorization relationship.. Existence Justification: Technicians are authorized to work on specific utility assets for safety, compliance, and scheduling. An asset can have multiple authorized technicians, and a technician can be authorized on many assets. Each authorization record captures dates, certification level, and status, making the relationship a managed business entity.' .

ind:ParcelAllocation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Asset ;
    rdfs:label 'Parcel Allocation' ;
    rdfs:comment 'Represents the allocation of a physical utility asset to one or more land parcels, capturing ownership and cost split, network role, and operational flags for each allocation.. Existence Justification: An asset can occupy multiple parcels and a parcel can contain multiple assets. The utility actively tracks which portion of an asset resides on each parcel, including ownership and cost allocation percentages, and the role of the asset in the network topology. This relationship is managed as a distinct business entity.' .

ind:StormParcelImpact rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Storm Parcel Impact' ;
    rdfs:comment 'Represents the operational link between a storm event and a utility-owned parcel. Each record captures the damage assessment status and restoration timing for that specific parcel during the storm.. Existence Justification: Each storm event can affect many land parcels, and a single parcel can be impacted by multiple storm events over time. The utility creates and maintains a record for each storm-parcel pair that captures damage assessment status and restoration timestamps, which are operational data managed by crews.' .

ind:JobPlan rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Asset ;
    rdfs:label 'Job Plan' ;
    rdfs:comment 'Master reference table for job_plan. Referenced by job_plan_id.' .

ind:Vault rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Vault' ;
    rdfs:comment 'Master reference table for vault. Referenced by vault_id.' .

ind:LoadProfile rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Load Profile' ;
    rdfs:comment 'Master reference table for load_profile. Referenced by load_profile_id.' .

ind:EmergencyResponsePlan rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Safety ;
    rdfs:label 'Emergency Response Plan' ;
    rdfs:comment 'Master reference table for emergency_response_plan. Referenced by emergency_response_plan_id.' .

ind:GasNetworkNode rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Gas Network Node' ;
    rdfs:comment 'Master reference table for gas_network_node. Referenced by start_node_id.' .

ind:MeterSet rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Meter Set' ;
    rdfs:comment 'Master reference table for meter_set. Referenced by meter_set_id.' .

ind:Structure rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Structure' ;
    rdfs:comment 'Master reference table for structure. Referenced by from_structure_id.' .

ind:ProfitCenter rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Profit Center' ;
    rdfs:comment 'Master reference table for profit_center. Referenced by profit_center_id.' .

ind:Fund rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Fund' ;
    rdfs:comment 'Master reference table for fund. Referenced by fund_id.' .

ind:DepreciationArea rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Depreciation Area' ;
    rdfs:comment 'Master reference table for depreciation_area. Referenced by depreciation_area_id.' .

ind:LegalEntity rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Legal Entity' ;
    rdfs:comment 'Master reference table for legal_entity. Referenced by sender_legal_entity_id.' .

ind:LoadProfile rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Metering ;
    rdfs:label 'Load Profile' ;
    rdfs:comment 'Master reference table for load_profile. Referenced by load_profile_id.' .

ind:Market rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Trading ;
    rdfs:label 'Market' ;
    rdfs:comment 'Master reference table for market. Referenced by market_id.' .

ind:PricingNode rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Trading ;
    rdfs:label 'Pricing Node' ;
    rdfs:comment 'Master reference table for pricing_node. Referenced by pricing_node_id.' .

ind:ControlCenter rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Gridops ;
    rdfs:label 'Control Center' ;
    rdfs:comment 'Master reference table for control_center. Referenced by control_center_id.' .

ind:PayrollPeriod rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Payroll Period' ;
    rdfs:comment 'Master reference table for payroll_period. Referenced by payroll_period_id.' .

ind:Vehicle rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Vehicle' ;
    rdfs:comment 'Master reference table for vehicle. Referenced by vehicle_id.' .

ind:DispatchZone rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Dispatch Zone' ;
    rdfs:comment 'Master reference table for dispatch_zone. Referenced by dispatch_zone_id.' .

ind:Depot rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Depot' ;
    rdfs:comment 'Master reference table for depot. Referenced by home_depot_id.' .

# --- Attribute Properties ---
ind:assetCapexProjectId rdf:type rdf:Property ;
    rdfs:label 'Asset Capex Project Id' ;
    rdfs:comment 'Unique identifier for the capital expenditure project record. Primary key.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AssetCapexProject .

ind:classificationId rdf:type rdf:Property ;
    rdfs:label 'Classification Id' ;
    rdfs:comment 'Foreign key linking to asset.classification. Business justification: Capex project is associated with an asset class; replace free-text asset_class with FK to classification for consistency.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Classification .

ind:costCenterId rdf:type rdf:Property ;
    rdfs:label 'Cost Center Id' ;
    rdfs:comment 'Cost center identifier for the organizational unit responsible for the capital project budget and expenditures.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CostCenter .

ind:facilityId rdf:type rdf:Property ;
    rdfs:label 'Facility Id' ;
    rdfs:comment 'Foreign key linking to property.facility. Business justification: CAPITAL PLANNING: Projects are tied to a specific facility for budgeting, regulatory approval, and cost allocation.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Facility .

ind:procurementContractId rdf:type rdf:Property ;
    rdfs:label 'Procurement Contract Id' ;
    rdfs:comment 'Foreign key linking to supply.procurement_contract. Business justification: Capital Project Procurement Link; associates a capex project with its procurement contract, required for contract compliance, milestone reporting, and audit of project expenditures.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProcurementContract .

ind:projectManagerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Project Manager Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Capital project management requires linking each capex project to its responsible employee manager for budgeting, reporting, and regulatory compliance.' ;
    rdfs:domain ind:AssetCapexProject ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:siteId rdf:type rdf:Property ;
    rdfs:label 'Site Id' ;
    rdfs:comment 'Foreign key linking to property.site. Business justification: CAPITAL PLANNING: Large projects (e.g., new generation site) require site linkage for environmental permits and reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Site .

ind:wbsElementId rdf:type rdf:Property ;
    rdfs:label 'Wbs Element Id' ;
    rdfs:comment 'SAP Work Breakdown Structure element identifier linking the capital project to the financial and project management hierarchy.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WbsElement .

ind:actualSpendToDateAmount rdf:type rdf:Property ;
    rdfs:label 'Actual Spend To Date Amount' ;
    rdfs:comment 'Cumulative actual capital expenditure incurred on the project as of the current reporting period, expressed in USD.' ;
    rdfs:domain ind:AssetCapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:budgetVarianceAmount rdf:type rdf:Property ;
    rdfs:label 'Budget Variance Amount' ;
    rdfs:comment 'Difference between the total authorized budget and the forecast at completion, indicating over or under budget status, expressed in USD.' ;
    rdfs:domain ind:AssetCapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contingencyReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Contingency Reserve Amount' ;
    rdfs:comment 'Contingency reserve budget allocated for unforeseen risks and changes during project execution, expressed in USD.' ;
    rdfs:domain ind:AssetCapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cpcnNumber rdf:type rdf:Property ;
    rdfs:label 'Cpcn Number' ;
    rdfs:comment 'Certificate number issued by the state Public Utility Commission (PUC) or Public Service Commission (PSC) authorizing the utility to construct or acquire major capital assets.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:createdTimestamp rdf:type rdf:Property ;
    rdfs:label 'Created Timestamp' ;
    rdfs:comment 'Timestamp when the capital project record was first created in the system.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:depreciationMethod rdf:type rdf:Property ;
    rdfs:label 'Depreciation Method' ;
    rdfs:comment 'Depreciation method to be applied to the capital asset once placed in service (e.g., Straight-Line, Declining Balance, Units of Production).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:environmentalPermitNumber rdf:type rdf:Property ;
    rdfs:label 'Environmental Permit Number' ;
    rdfs:comment 'Reference number for the environmental permit or approval obtained for the capital project.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:environmentalPermitRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Environmental Permit Required Flag' ;
    rdfs:comment 'Indicates whether the capital project requires environmental permits or assessments from EPA or state environmental agencies.' ;
    rdfs:domain ind:AssetCapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fercAccountCode rdf:type rdf:Property ;
    rdfs:label 'Ferc Account Code' ;
    rdfs:comment 'FERC Uniform System of Accounts code for the capital asset classification, used for regulatory reporting and rate base determination.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forecastAtCompletionAmount rdf:type rdf:Property ;
    rdfs:label 'Forecast At Completion Amount' ;
    rdfs:comment 'Projected total capital expenditure at project completion based on current actuals and remaining estimates, expressed in USD.' ;
    rdfs:domain ind:AssetCapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fundingSource rdf:type rdf:Property ;
    rdfs:label 'Funding Source' ;
    rdfs:comment 'Source of capital funding for the project, such as rate base recovery, debt financing, equity, grants, or customer contributions.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographicRegion rdf:type rdf:Property ;
    rdfs:label 'Geographic Region' ;
    rdfs:comment 'Geographic region or service territory where the capital project is located (e.g., Northern Region, Southern Region, Metro Area).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inServiceDateActual rdf:type rdf:Property ;
    rdfs:label 'In Service Date Actual' ;
    rdfs:comment 'Actual date when the capital asset or system was placed into operational service, triggering depreciation and rate base inclusion.' ;
    rdfs:domain ind:AssetCapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:inServiceDateTarget rdf:type rdf:Property ;
    rdfs:label 'In Service Date Target' ;
    rdfs:comment 'Target date when the capital asset or system is planned to be placed into operational service and begin depreciation.' ;
    rdfs:domain ind:AssetCapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:irpAlignmentFlag rdf:type rdf:Property ;
    rdfs:label 'Irp Alignment Flag' ;
    rdfs:comment 'Indicates whether the capital project is aligned with and included in the utility\'s approved Integrated Resource Plan (IRP).' ;
    rdfs:domain ind:AssetCapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastModifiedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Modified Timestamp' ;
    rdfs:comment 'Timestamp when the capital project record was last updated or modified.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:planningHorizon rdf:type rdf:Property ;
    rdfs:label 'Planning Horizon' ;
    rdfs:comment 'Time horizon category for capital planning purposes: 1-year (near-term), 5-year (mid-term), or 10-year (long-term) planning cycle.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Project Completion Date' ;
    rdfs:comment 'Date when the capital project was officially closed and all deliverables were completed.' ;
    rdfs:domain ind:AssetCapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:projectDescription rdf:type rdf:Property ;
    rdfs:label 'Project Description' ;
    rdfs:comment 'Detailed narrative description of the capital project scope, objectives, deliverables, and business justification.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectName rdf:type rdf:Property ;
    rdfs:label 'Project Name' ;
    rdfs:comment 'Descriptive name of the capital project for human identification and reporting purposes.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectNumber rdf:type rdf:Property ;
    rdfs:label 'Project Number' ;
    rdfs:comment 'Business identifier for the CAPEX project, typically the SAP Work Breakdown Structure (WBS) element or project code used across financial and project management systems.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectStartDate rdf:type rdf:Property ;
    rdfs:label 'Project Start Date' ;
    rdfs:comment 'Date when the capital project officially commenced, marking the beginning of planning or execution activities.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:projectStatus rdf:type rdf:Property ;
    rdfs:label 'Project Status' ;
    rdfs:comment 'Current lifecycle phase of the capital project: planning, design, procurement, construction, commissioning, or closed.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectType rdf:type rdf:Property ;
    rdfs:label 'Project Type' ;
    rdfs:comment 'Classification of the capital project by its primary purpose: new construction, asset replacement, system upgrade, compliance-driven investment, capacity expansion, or technology modernization.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rabInclusionFlag rdf:type rdf:Property ;
    rdfs:label 'Rab Inclusion Flag' ;
    rdfs:comment 'Indicates whether the capital project is included in the Regulatory Asset Base (RAB) for rate-making purposes.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rateCaseReference rdf:type rdf:Property ;
    rdfs:label 'Rate Case Reference' ;
    rdfs:comment 'Reference identifier for the General Rate Case (GRC) filing in which the capital project is included for cost recovery.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryApprovalReference rdf:type rdf:Property ;
    rdfs:label 'Regulatory Approval Reference' ;
    rdfs:comment 'Reference number or identifier for the regulatory approval or Certificate of Public Convenience and Necessity (CPCN) authorizing the capital investment.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:replacementDriver rdf:type rdf:Property ;
    rdfs:label 'Replacement Driver' ;
    rdfs:comment 'Primary business or technical reason driving the asset replacement or capital investment: end-of-life, condition-based assessment, regulatory compliance, capacity constraints, or technology obsolescence.' ;
    rdfs:domain ind:AssetCapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:replacementPriorityScore rdf:type rdf:Property ;
    rdfs:label 'Replacement Priority Score' ;
    rdfs:comment 'Numerical score representing the relative priority of the replacement project based on risk, condition, criticality, and business impact assessment.' ;
    rdfs:domain ind:AssetCapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:safetyClassification rdf:type rdf:Property ;
    rdfs:label 'Safety Classification' ;
    rdfs:comment 'Safety risk classification of the capital project based on OSHA and internal safety standards (e.g., High Risk, Medium Risk, Low Risk).' ;
    rdfs:domain ind:AssetCapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceTerritoryCode rdf:type rdf:Property ;
    rdfs:label 'Service Territory Code' ;
    rdfs:comment 'Code identifying the specific service territory or operating area where the capital project is deployed.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sponsoringBusinessUnit rdf:type rdf:Property ;
    rdfs:label 'Sponsoring Business Unit' ;
    rdfs:comment 'The organizational division or business unit responsible for sponsoring and owning the capital project (e.g., Generation, Transmission, Distribution, Gas Operations).' ;
    rdfs:domain ind:AssetCapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalAuthorizedBudgetAmount rdf:type rdf:Property ;
    rdfs:label 'Total Authorized Budget Amount' ;
    rdfs:comment 'Total capital expenditure budget authorized for the project by executive management or board approval, expressed in USD.' ;
    rdfs:domain ind:AssetCapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:usefulLifeYears rdf:type rdf:Property ;
    rdfs:label 'Useful Life Years' ;
    rdfs:comment 'Expected useful life of the capital asset in years, used for depreciation calculation and asset management planning.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentAssetClassClassificationId rdf:type rdf:Property ;
    rdfs:label 'Parent Asset Class Classification Id' ;
    rdfs:comment 'Reference to the parent asset class in a hierarchical taxonomy structure, enabling multi-level classification (e.g., \'Distribution Equipment\' as parent of \'Distribution Transformer\'). Null if this is a top-level class.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Classification .

ind:activeStatus rdf:type rdf:Property ;
    rdfs:label 'Active Status' ;
    rdfs:comment 'Current lifecycle status of the asset class definition: active (in use for new assets), inactive (no longer used but historical data exists), deprecated (being phased out), or pending approval (awaiting classification committee review).' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvalDate rdf:type rdf:Property ;
    rdfs:label 'Approval Date' ;
    rdfs:comment 'Date when this asset class definition was formally approved by the asset classification governance committee. Format: yyyy-MM-dd.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvedBy rdf:type rdf:Property ;
    rdfs:label 'Approved By' ;
    rdfs:comment 'Name or identifier of the user or governance committee that approved this asset class definition for use in the enterprise asset taxonomy.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetCategory rdf:type rdf:Property ;
    rdfs:label 'Asset Category' ;
    rdfs:comment 'High-level categorization of the asset class by operational domain: generation (power plants, turbines), transmission (high-voltage lines, towers), distribution (poles, transformers, feeders), gas (pipelines, regulators), substation (breakers, relays), metering (AMI meters, MDM devices), fleet (vehicles, mobile equipment), IT/OT (SCADA systems, servers), facilities (buildings, warehouses), or other. [ENUM-REF-CANDIDATE: generation|transmission|distribution|gas|substation|metering|fleet|it_ot|facilities|other — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetClassCode rdf:type rdf:Property ;
    rdfs:label 'Asset Class Code' ;
    rdfs:comment 'Standardized alphanumeric code uniquely identifying the asset class within the utility\'s asset taxonomy. Used as the business identifier for asset classification across all systems.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetClassDescription rdf:type rdf:Property ;
    rdfs:label 'Asset Class Description' ;
    rdfs:comment 'Detailed textual description of the asset class, including typical use cases, technical characteristics, and operational context within the utility\'s infrastructure.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetClassLevel rdf:type rdf:Property ;
    rdfs:label 'Asset Class Level' ;
    rdfs:comment 'Numeric level in the asset classification hierarchy, with 1 representing top-level categories and higher numbers representing more granular sub-classifications.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assetClassName rdf:type rdf:Property ;
    rdfs:label 'Asset Class Name' ;
    rdfs:comment 'Full descriptive name of the asset class (e.g., \'Distribution Transformer\', \'Transmission Tower\', \'Gas Regulator Station\').' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetCriticalityRating rdf:type rdf:Property ;
    rdfs:label 'Asset Criticality Rating' ;
    rdfs:comment 'Default criticality classification for assets in this class based on impact to grid reliability, safety, and regulatory compliance. Used for prioritizing maintenance and capital investment.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:averageUnitCost rdf:type rdf:Property ;
    rdfs:label 'Average Unit Cost' ;
    rdfs:comment 'Average acquisition or installation cost per unit for assets in this class, used for budgeting and capital expenditure (CAPEX) planning. Updated periodically based on procurement history.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:averageUnitCostCurrency rdf:type rdf:Property ;
    rdfs:label 'Average Unit Cost Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the average unit cost (e.g., USD, CAD).' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capitalizationThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Capitalization Threshold Amount' ;
    rdfs:comment 'Minimum dollar value required for an asset in this class to be capitalized as a fixed asset rather than expensed. Aligns with FASB ASC 980 and internal CAPEX policies.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capitalizationThresholdCurrency rdf:type rdf:Property ;
    rdfs:label 'Capitalization Threshold Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the capitalization threshold amount (e.g., USD, CAD).' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectiveEndDate rdf:type rdf:Property ;
    rdfs:label 'Effective End Date' ;
    rdfs:comment 'Date when this asset class definition was retired or superseded. Null if currently active. Format: yyyy-MM-dd.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectiveStartDate rdf:type rdf:Property ;
    rdfs:label 'Effective Start Date' ;
    rdfs:comment 'Date when this asset class definition became effective for use in asset registration and accounting. Format: yyyy-MM-dd.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:environmentalComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Environmental Compliance Flag' ;
    rdfs:comment 'Indicates whether assets in this class are subject to Environmental Protection Agency (EPA) or state environmental regulations (e.g., emissions monitoring, hazardous materials handling, spill prevention). True if environmental compliance tracking is required.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fercAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Ferc Account Number' ;
    rdfs:comment 'FERC Uniform System of Accounts number for regulatory accounting classification. Maps asset class to the appropriate plant account for rate base and depreciation reporting (e.g., 364 for Poles and Fixtures, 365 for Overhead Conductors).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gisTrackableFlag rdf:type rdf:Property ;
    rdfs:label 'Gis Trackable Flag' ;
    rdfs:comment 'Indicates whether assets in this class are spatially tracked in the Esri ArcGIS system with geospatial coordinates. True if GIS location tracking is required for operational and planning purposes.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:insuranceRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Insurance Required Flag' ;
    rdfs:comment 'Indicates whether assets in this class must be covered by property insurance policies. True if insurance coverage is mandatory for risk management and regulatory compliance.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maintenanceStrategy rdf:type rdf:Property ;
    rdfs:label 'Maintenance Strategy' ;
    rdfs:comment 'Standard maintenance approach for assets in this class: reactive (repair on failure), preventive (scheduled maintenance), predictive (sensor-driven), condition-based (inspection-driven), reliability-centered (RCM), or run-to-failure (no maintenance).' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:manufacturerAgnosticFlag rdf:type rdf:Property ;
    rdfs:label 'Manufacturer Agnostic Flag' ;
    rdfs:comment 'Indicates whether this asset class is defined independently of manufacturer or vendor (true) or is specific to a particular manufacturer\'s product line (false).' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mobileAssetFlag rdf:type rdf:Property ;
    rdfs:label 'Mobile Asset Flag' ;
    rdfs:comment 'Indicates whether assets in this class are mobile (e.g., fleet vehicles, portable generators, mobile substations) rather than fixed infrastructure. True if the asset class represents mobile equipment.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nercCipApplicableFlag rdf:type rdf:Property ;
    rdfs:label 'Nerc Cip Applicable Flag' ;
    rdfs:comment 'Indicates whether assets in this class are subject to NERC CIP cybersecurity and physical security standards for Bulk Electric System (BES) protection. True if CIP standards apply, false otherwise.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:notes rdf:type rdf:Property ;
    rdfs:label 'Notes' ;
    rdfs:comment 'Free-form text field for additional notes, special instructions, or clarifications regarding the asset class definition and usage.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:replacementCycleYears rdf:type rdf:Property ;
    rdfs:label 'Replacement Cycle Years' ;
    rdfs:comment 'Typical replacement or refresh cycle for assets in this class, used for long-term capital planning and Integrated Resource Plan (IRP) forecasting. May differ from depreciation life.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:safetyInspectionRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Safety Inspection Required Flag' ;
    rdfs:comment 'Indicates whether assets in this class require periodic safety inspections per Occupational Safety and Health Administration (OSHA) or utility safety standards. True if mandatory safety inspections apply.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:salvageValuePercentage rdf:type rdf:Property ;
    rdfs:label 'Salvage Value Percentage' ;
    rdfs:comment 'Expected residual value of assets in this class at end of useful life, expressed as a percentage of original cost. Used in depreciation calculations per FERC and FASB ASC 980 requirements.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:serializedAssetFlag rdf:type rdf:Property ;
    rdfs:label 'Serialized Asset Flag' ;
    rdfs:comment 'Indicates whether individual assets in this class are tracked by unique serial numbers or asset tags. True if serialization is required for inventory and lifecycle management.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:standardUnitOfMeasure rdf:type rdf:Property ;
    rdfs:label 'Standard Unit Of Measure' ;
    rdfs:comment 'Standard unit used to quantify assets in this class for inventory and planning purposes (e.g., \'each\', \'mile\', \'meter\', \'MVA\', \'MCF\'). Aligns with industry measurement standards.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:standardUsefulLifeYears rdf:type rdf:Property ;
    rdfs:label 'Standard Useful Life Years' ;
    rdfs:comment 'Expected service life of assets in this class, measured in years, as approved by the Public Utility Commission (PUC) for depreciation rate calculation and Regulatory Asset Base (RAB) reporting.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:warrantyTrackingRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Warranty Tracking Required Flag' ;
    rdfs:comment 'Indicates whether assets in this class require warranty period and warranty claim tracking. True if warranty management is applicable for this asset class.' ;
    rdfs:domain ind:Classification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complianceDocumentId rdf:type rdf:Property ;
    rdfs:label 'Compliance Document Id' ;
    rdfs:comment 'Primary key for compliance_document' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:UtilityCompany .

ind:assetRegistryId rdf:type rdf:Property ;
    rdfs:label 'Asset Registry Id' ;
    rdfs:comment 'Reference to the physical asset or equipment to which this compliance document or permit applies. Links to the asset registry in Maximo EAM.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Registry .

ind:glAccountId rdf:type rdf:Property ;
    rdfs:label 'Gl Account Id' ;
    rdfs:comment 'Foreign key linking to finance.gl_account. Business justification: GL account on permit documents records expense posting for compliance fees.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GlAccount .

ind:registryId rdf:type rdf:Property ;
    rdfs:label 'Registry Id' ;
    rdfs:comment 'Reference to the physical asset or equipment to which this compliance document or permit applies. Links to the asset registry in Maximo EAM.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Registry .

ind:supersededByDocumentComplianceDocumentId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Document Compliance Document Id' ;
    rdfs:comment 'Reference to the compliance document that supersedes or replaces this document. Used to track document revision chains and ensure field crews access the latest version.' ;
    rdfs:domain ind:ComplianceDocument ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ComplianceDocument .

ind:accessRestrictionFlag rdf:type rdf:Property ;
    rdfs:label 'Access Restriction Flag' ;
    rdfs:comment 'Indicates whether access to this document is restricted to specific roles or individuals due to security, safety, or regulatory requirements.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:activeFlag rdf:type rdf:Property ;
    rdfs:label 'Active Flag' ;
    rdfs:comment 'Indicates whether this compliance document or permit is currently active and in force. Inactive records represent superseded, expired, or cancelled documents retained for historical reference.' ;
    rdfs:domain ind:ComplianceDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complianceConditions rdf:type rdf:Property ;
    rdfs:label 'Compliance Conditions' ;
    rdfs:comment 'Detailed text describing the specific conditions, requirements, or restrictions imposed by the regulatory authority as part of the permit or license. May include operational limits, reporting requirements, or environmental mitigation measures.' ;
    rdfs:domain ind:ComplianceDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceStatus rdf:type rdf:Property ;
    rdfs:label 'Compliance Status' ;
    rdfs:comment 'Current compliance state of the permit or document. Indicates whether the utility is meeting all conditions and requirements associated with this regulatory document.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confidentialityLevel rdf:type rdf:Property ;
    rdfs:label 'Confidentiality Level' ;
    rdfs:comment 'The data classification level of the document content. Determines access controls and distribution restrictions. Critical Infrastructure Protection (CIP) documents may be restricted.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactEmail rdf:type rdf:Property ;
    rdfs:label 'Contact Email' ;
    rdfs:comment 'The email address of the responsible party or document owner for inquiries and compliance coordination.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactPhone rdf:type rdf:Property ;
    rdfs:label 'Contact Phone' ;
    rdfs:comment 'The phone number of the responsible party or document owner for urgent compliance matters.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dmsReference rdf:type rdf:Property ;
    rdfs:label 'Dms Reference' ;
    rdfs:comment 'The unique identifier or URL reference to the document in the enterprise document management system. Enables direct access to the digital document file.' ;
    rdfs:domain ind:ComplianceDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentCategory rdf:type rdf:Property ;
    rdfs:label 'Document Category' ;
    rdfs:comment 'High-level classification of the document by its primary business function. Used for organizing and filtering documents in the document management system.' ;
    rdfs:domain ind:ComplianceDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentDescription rdf:type rdf:Property ;
    rdfs:label 'Document Description' ;
    rdfs:comment 'Detailed narrative description of the compliance document or permit, including its scope, purpose, and any special conditions or requirements.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentNumber rdf:type rdf:Property ;
    rdfs:label 'Document Number' ;
    rdfs:comment 'The externally-known unique identifier or permit number assigned by the issuing authority or document management system. Examples include construction permit number, operating license number, environmental permit number, or engineering drawing number.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentOriginator rdf:type rdf:Property ;
    rdfs:label 'Document Originator' ;
    rdfs:comment 'The person, department, or external contractor who created or authored the document. Relevant for engineering drawings, test reports, and operational manuals.' ;
    rdfs:domain ind:ComplianceDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentSizeMb rdf:type rdf:Property ;
    rdfs:label 'Document Size Mb' ;
    rdfs:comment 'The file size of the digital document in megabytes. Used for storage planning and mobile data transfer optimization.' ;
    rdfs:domain ind:ComplianceDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:documentTitle rdf:type rdf:Property ;
    rdfs:label 'Document Title' ;
    rdfs:comment 'The full descriptive title or name of the compliance document or permit as it appears on the official record.' ;
    rdfs:domain ind:ComplianceDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentType rdf:type rdf:Property ;
    rdfs:label 'Document Type' ;
    rdfs:comment 'Classification of the compliance document or permit. Indicates the nature and purpose of the document within the regulatory and operational framework. [ENUM-REF-CANDIDATE: construction_permit|operating_license|environmental_permit|right_of_way|easement|engineering_drawing|as_built_drawing|test_report|om_manual|relay_setting_sheet|inspection_certificate|compliance_certificate|safety_certificate|other — 14 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectiveDate rdf:type rdf:Property ;
    rdfs:label 'Effective Date' ;
    rdfs:comment 'The date on which the permit or document becomes legally binding or operationally effective. May differ from issue date for permits with future start dates.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:expirationDate rdf:type rdf:Property ;
    rdfs:label 'Expiration Date' ;
    rdfs:comment 'The date on which the permit or license expires and must be renewed. Null for documents without expiration such as as-built drawings or permanent easements.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fileFormat rdf:type rdf:Property ;
    rdfs:label 'File Format' ;
    rdfs:comment 'The digital file format of the stored document. Important for determining accessibility and compatibility with field crew mobile devices and engineering software. [ENUM-REF-CANDIDATE: pdf|dwg|dxf|docx|xlsx|tiff|jpg|other — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gisReference rdf:type rdf:Property ;
    rdfs:label 'Gis Reference' ;
    rdfs:comment 'The unique identifier linking this document to a geographic feature or asset location in Esri ArcGIS. Enables spatial analysis and map-based document retrieval.' ;
    rdfs:domain ind:ComplianceDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Inspection Required Flag' ;
    rdfs:comment 'Indicates whether this permit or document requires periodic inspections or audits to maintain compliance.' ;
    rdfs:domain ind:ComplianceDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:issueDate rdf:type rdf:Property ;
    rdfs:label 'Issue Date' ;
    rdfs:comment 'The date on which the permit was issued by the regulatory authority or the document was officially released. Represents the principal business event timestamp for this compliance record.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:issuingAuthority rdf:type rdf:Property ;
    rdfs:label 'Issuing Authority' ;
    rdfs:comment 'The regulatory body, government agency, or organization that issued the permit or created the document. Examples include FERC, state PUC, EPA, local municipality, or internal engineering department.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdiction rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction' ;
    rdfs:comment 'The geographic or regulatory jurisdiction under which this document or permit applies. May be federal, state, county, or municipal level.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastUpdatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Updated Timestamp' ;
    rdfs:comment 'The date and time when this compliance document record was most recently modified. Audit trail for change tracking and data quality monitoring.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:nextInspectionDate rdf:type rdf:Property ;
    rdfs:label 'Next Inspection Date' ;
    rdfs:comment 'The scheduled date for the next required inspection or compliance audit associated with this permit or document.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:permitCostAmount rdf:type rdf:Property ;
    rdfs:label 'Permit Cost Amount' ;
    rdfs:comment 'The total cost incurred to obtain or maintain this permit or license, including application fees, legal costs, and consulting expenses. Used for rate case documentation and regulatory asset base (RAB) reporting.' ;
    rdfs:domain ind:ComplianceDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:permitCostCurrency rdf:type rdf:Property ;
    rdfs:label 'Permit Cost Currency' ;
    rdfs:comment 'The currency in which permit costs are denominated. Standardized to USD for this utility.' ;
    rdfs:domain ind:ComplianceDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryFramework rdf:type rdf:Property ;
    rdfs:label 'Regulatory Framework' ;
    rdfs:comment 'The specific regulatory program, statute, or framework under which this permit or document was issued. Examples include Clean Air Act, NERC CIP standards, FERC transmission tariff, or state-specific utility regulations.' ;
    rdfs:domain ind:ComplianceDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalDate rdf:type rdf:Property ;
    rdfs:label 'Renewal Date' ;
    rdfs:comment 'The date by which the permit or license must be renewed to maintain compliance. Used for tracking renewal cycles and compliance deadlines.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalStatus rdf:type rdf:Property ;
    rdfs:label 'Renewal Status' ;
    rdfs:comment 'Current state of the permit or license renewal process. Tracks whether the document is current, requires renewal action, or has expired.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsibleParty rdf:type rdf:Property ;
    rdfs:label 'Responsible Party' ;
    rdfs:comment 'The name or identifier of the individual, department, or contractor responsible for maintaining compliance with this document or permit. Used for accountability and workflow routing.' ;
    rdfs:domain ind:ComplianceDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revisionNumber rdf:type rdf:Property ;
    rdfs:label 'Revision Number' ;
    rdfs:comment 'The version or revision identifier for the document. Tracks changes and updates to engineering drawings, permits, and operational documents over time.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:storageLocation rdf:type rdf:Property ;
    rdfs:label 'Storage Location' ;
    rdfs:comment 'The physical or digital location where the original or official copy of the document is stored. May include document management system reference, file path, cabinet location, or external repository identifier.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionAssessmentId rdf:type rdf:Property ;
    rdfs:label 'Condition Assessment Id' ;
    rdfs:comment 'Primary key for condition_assessment' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:employeeId rdf:type rdf:Property ;
    rdfs:label 'Employee Id' ;
    rdfs:comment 'Reference to the technician or inspector who performed the assessment. Links to workforce technician registry.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:generatingUnitId rdf:type rdf:Property ;
    rdfs:label 'Generating Unit Id' ;
    rdfs:comment 'Foreign key linking to generation.generating_unit. Business justification: Condition assessments are performed on individual generating units; linking them supports reliability analysis and predictive maintenance.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GeneratingUnit .

ind:gisLocationId rdf:type rdf:Property ;
    rdfs:label 'Gis Location Id' ;
    rdfs:comment 'Esri ArcGIS location identifier for geospatial tracking of the asset being assessed. Enables spatial analysis of asset condition patterns.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Location .

ind:scadaPointId rdf:type rdf:Property ;
    rdfs:label 'Scada Point Id' ;
    rdfs:comment 'Reference to the SCADA point or PI Historian tag that provided the operational reading data for automated measurements.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ScadaPoint .

ind:technicianId rdf:type rdf:Property ;
    rdfs:label 'Technician Id' ;
    rdfs:comment 'Reference to the technician or inspector who performed the assessment. Links to workforce technician registry.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Technician .

ind:workOrderId rdf:type rdf:Property ;
    rdfs:label 'Work Order Id' ;
    rdfs:comment 'Reference to the Maximo work order that initiated or resulted from this condition assessment. Links inspection findings to maintenance execution.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WorkOrder .

ind:ambientTemperatureC rdf:type rdf:Property ;
    rdfs:label 'Ambient Temperature C' ;
    rdfs:comment 'Ambient air temperature in degrees Celsius at the time of assessment. Contextual data for interpreting thermal and electrical measurements.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assessmentCost rdf:type rdf:Property ;
    rdfs:label 'Assessment Cost' ;
    rdfs:comment 'Total cost incurred for performing the condition assessment including labor, equipment, and contractor fees. Supports O&M (Operations and Maintenance) cost tracking.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assessmentMethod rdf:type rdf:Property ;
    rdfs:label 'Assessment Method' ;
    rdfs:comment 'Technical method used to assess asset condition: visual inspection, thermographic imaging, ultrasonic testing, oil sample analysis, vibration analysis, dissolved gas analysis (DGA), or insulation resistance testing. [ENUM-REF-CANDIDATE: visual|thermographic|ultrasonic|oil_sample|vibration|dga|insulation_test — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentSource rdf:type rdf:Property ;
    rdfs:label 'Assessment Source' ;
    rdfs:comment 'Origin of the condition assessment data: field inspection by utility crews, automated SCADA reading, PI Historian data feed, manual data entry, or third-party contractor assessment.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentStatus rdf:type rdf:Property ;
    rdfs:label 'Assessment Status' ;
    rdfs:comment 'Current lifecycle status of the condition assessment activity.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Assessment Timestamp' ;
    rdfs:comment 'Date and time when the condition assessment was performed or measurement was captured. Primary business event timestamp for the assessment.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:assessmentType rdf:type rdf:Property ;
    rdfs:label 'Assessment Type' ;
    rdfs:comment 'Category of condition assessment record: inspection event, condition score evaluation, or operational reading measurement. [ENUM-REF-CANDIDATE: inspection|condition_score|operational_reading|thermographic|structural|environmental|regulatory — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionIndex rdf:type rdf:Property ;
    rdfs:label 'Condition Index' ;
    rdfs:comment 'Calculated condition index score (0-100 scale) representing overall asset health based on multiple assessment factors.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:conditionScore rdf:type rdf:Property ;
    rdfs:label 'Condition Score' ;
    rdfs:comment 'Numeric condition grade on a 1-5 scale where 5 is excellent/new condition and 1 is poor/end-of-life. Used for asset health index calculations.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deficiencyCount rdf:type rdf:Property ;
    rdfs:label 'Deficiency Count' ;
    rdfs:comment 'Number of deficiencies or issues identified during the inspection.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dgaPpm rdf:type rdf:Property ;
    rdfs:label 'Dga Ppm' ;
    rdfs:comment 'Concentration of dissolved gases in transformer oil measured in parts per million. Used to detect incipient faults in oil-filled electrical equipment.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:failureProbabilityRating rdf:type rdf:Property ;
    rdfs:label 'Failure Probability Rating' ;
    rdfs:comment 'Assessed likelihood of asset failure within the planning horizon. Used for risk-based maintenance prioritization.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:findingsSummary rdf:type rdf:Property ;
    rdfs:label 'Findings Summary' ;
    rdfs:comment 'Narrative summary of inspection findings, observations, and deficiencies identified during the assessment.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gasPressurePsi rdf:type rdf:Property ;
    rdfs:label 'Gas Pressure Psi' ;
    rdfs:comment 'Measured natural gas pipeline pressure in pounds per square inch. Critical safety and operational parameter for gas distribution systems.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inspectionResult rdf:type rdf:Property ;
    rdfs:label 'Inspection Result' ;
    rdfs:comment 'Overall outcome of the inspection: pass (no issues), fail (critical deficiencies), conditional (minor issues noted), or requires follow-up investigation.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionType rdf:type rdf:Property ;
    rdfs:label 'Inspection Type' ;
    rdfs:comment 'Specific type of inspection conducted for inspection assessment records. Includes routine patrol, thermographic imaging, structural integrity, environmental compliance, NERC CIP (Critical Infrastructure Protection) security, and PHMSA (Pipeline and Hazardous Materials Safety Administration) pipeline inspections.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectorCertification rdf:type rdf:Property ;
    rdfs:label 'Inspector Certification' ;
    rdfs:comment 'Professional certification or qualification held by the inspector conducting the assessment (e.g., Level II Thermographer, NACE Corrosion Specialist, API 510 Pressure Vessel Inspector).' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insulationResistanceMohm rdf:type rdf:Property ;
    rdfs:label 'Insulation Resistance Mohm' ;
    rdfs:comment 'Measured insulation resistance in megaohms for cables and electrical equipment. Indicates insulation integrity and moisture ingress.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:measurementParameter rdf:type rdf:Property ;
    rdfs:label 'Measurement Parameter' ;
    rdfs:comment 'Name of the operational parameter being measured for operational reading records (e.g., transformer loading, oil temperature, gas pressure, insulation resistance).' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measurementUnit rdf:type rdf:Property ;
    rdfs:label 'Measurement Unit' ;
    rdfs:comment 'Unit of measure for the operational reading (e.g., %, °C, PSI, MΩ, ppm, Hz, kV).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measurementValue rdf:type rdf:Property ;
    rdfs:label 'Measurement Value' ;
    rdfs:comment 'Quantitative measurement value captured from SCADA/PI Historian or field instruments for operational readings.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:modifiedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Modified Timestamp' ;
    rdfs:comment 'Timestamp when this condition assessment record was last modified. Audit trail for data lineage and change tracking.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:nextAssessmentDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Assessment Due Date' ;
    rdfs:comment 'Scheduled date for the next required condition assessment based on regulatory requirements, manufacturer recommendations, or risk-based maintenance intervals.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:oilTemperatureC rdf:type rdf:Property ;
    rdfs:label 'Oil Temperature C' ;
    rdfs:comment 'Measured oil temperature in degrees Celsius for oil-filled transformers and circuit breakers. Key indicator of thermal stress and cooling system performance.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:photoAttachmentCount rdf:type rdf:Property ;
    rdfs:label 'Photo Attachment Count' ;
    rdfs:comment 'Number of digital photographs or thermal images attached to the assessment record for documentation purposes.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:recommendedAction rdf:type rdf:Property ;
    rdfs:label 'Recommended Action' ;
    rdfs:comment 'Recommended remediation action based on condition assessment: continue monitoring, schedule routine maintenance, perform corrective maintenance, major repair, or asset replacement.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryProgram rdf:type rdf:Property ;
    rdfs:label 'Regulatory Program' ;
    rdfs:comment 'Name of the regulatory compliance program associated with this assessment (e.g., NERC CIP-006, PHMSA Integrity Management, EPA Environmental Inspection).' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remainingUsefulLifeYears rdf:type rdf:Property ;
    rdfs:label 'Remaining Useful Life Years' ;
    rdfs:comment 'Estimated remaining useful life of the asset in years based on current condition assessment. Supports CAPEX planning and replacement scheduling.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:thirdPartyContractor rdf:type rdf:Property ;
    rdfs:label 'Third Party Contractor' ;
    rdfs:comment 'Name of the third-party inspection contractor or vendor if assessment was performed by external party.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thresholdBreachFlag rdf:type rdf:Property ;
    rdfs:label 'Threshold Breach Flag' ;
    rdfs:comment 'Indicates whether the measured value exceeded acceptable threshold limits (true) or remained within normal operating range (false).' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:thresholdMax rdf:type rdf:Property ;
    rdfs:label 'Threshold Max' ;
    rdfs:comment 'Maximum acceptable threshold value for the operational parameter. Values above this trigger alerts.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:thresholdMin rdf:type rdf:Property ;
    rdfs:label 'Threshold Min' ;
    rdfs:comment 'Minimum acceptable threshold value for the operational parameter. Values below this trigger alerts.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transformerLoadingPct rdf:type rdf:Property ;
    rdfs:label 'Transformer Loading Pct' ;
    rdfs:comment 'Current loading percentage of transformer capacity for transformer assets. Critical operational metric for transmission and distribution transformers.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vibrationLevelMmS rdf:type rdf:Property ;
    rdfs:label 'Vibration Level Mm S' ;
    rdfs:comment 'Measured vibration velocity in millimeters per second for rotating equipment (generators, turbines, motors). Indicates mechanical condition and bearing health.' ;
    rdfs:domain ind:ConditionAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:weatherConditions rdf:type rdf:Property ;
    rdfs:label 'Weather Conditions' ;
    rdfs:comment 'Weather conditions at the time of field inspection (e.g., clear, rain, snow, high wind) that may affect assessment accuracy or asset condition.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depreciationScheduleId rdf:type rdf:Property ;
    rdfs:label 'Depreciation Schedule Id' ;
    rdfs:comment 'Unique identifier for the depreciation schedule record. Primary key for the depreciation schedule entity.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DepreciationSchedule .

ind:accumulatedDepreciation rdf:type rdf:Property ;
    rdfs:label 'Accumulated Depreciation' ;
    rdfs:comment 'The total depreciation expense recognized to date since the asset was placed in service. Represents the cumulative reduction in the asset\'s book value. Expressed in USD.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:annualDepreciationExpense rdf:type rdf:Property ;
    rdfs:label 'Annual Depreciation Expense' ;
    rdfs:comment 'The calculated annual depreciation expense for this asset based on the depreciation method and remaining life. Used for financial reporting and rate case filings. Expressed in USD.' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assetLocationCode rdf:type rdf:Property ;
    rdfs:label 'Asset Location Code' ;
    rdfs:comment 'Geographic or functional location code for the asset. May reference GIS coordinates, substation ID, service territory, or facility code.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bookReservePercentage rdf:type rdf:Property ;
    rdfs:label 'Book Reserve Percentage' ;
    rdfs:comment 'The accumulated depreciation expressed as a percentage of the original cost. Used in depreciation studies to assess the adequacy of depreciation rates. Also known as reserve ratio.' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bookTaxTimingDifference rdf:type rdf:Property ;
    rdfs:label 'Book Tax Timing Difference' ;
    rdfs:comment 'The cumulative difference between book depreciation and tax depreciation, creating deferred tax assets or liabilities. Important for regulatory accounting and rate-making. Expressed in USD.' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depreciableCostBasis rdf:type rdf:Property ;
    rdfs:label 'Depreciable Cost Basis' ;
    rdfs:comment 'The original cost basis of the asset subject to depreciation, net of any salvage value. Represents the total amount to be depreciated over the asset\'s useful life. Expressed in USD.' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depreciationRatePercentage rdf:type rdf:Property ;
    rdfs:label 'Depreciation Rate Percentage' ;
    rdfs:comment 'The annual depreciation rate expressed as a percentage of the depreciable cost basis. Calculated based on depreciation method and useful life. Used in regulatory reporting.' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depreciationStatus rdf:type rdf:Property ;
    rdfs:label 'Depreciation Status' ;
    rdfs:comment 'Current status of the depreciation schedule. Active schedules accrue depreciation expense; suspended schedules are temporarily paused; fully depreciated assets have zero net book value; retired assets are no longer in service.' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depreciationStudyReference rdf:type rdf:Property ;
    rdfs:label 'Depreciation Study Reference' ;
    rdfs:comment 'Reference identifier or citation to the depreciation study that established the depreciation parameters for this asset class. Depreciation studies are typically conducted every 5-10 years and filed with regulatory commissions.' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:impairmentIndicatorFlag rdf:type rdf:Property ;
    rdfs:label 'Impairment Indicator Flag' ;
    rdfs:comment 'Indicates whether this asset has been flagged for potential impairment testing due to events such as obsolescence, damage, regulatory disallowance, or changes in market conditions.' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:impairmentLossAmount rdf:type rdf:Property ;
    rdfs:label 'Impairment Loss Amount' ;
    rdfs:comment 'The cumulative impairment loss recognized for this asset if its carrying value exceeds its recoverable amount. Expressed in USD. Null if no impairment has been recorded.' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inServiceDate rdf:type rdf:Property ;
    rdfs:label 'In Service Date' ;
    rdfs:comment 'The date the asset was placed into service and began being depreciated. Critical for calculating accumulated depreciation and remaining life.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastDepreciationRunDate rdf:type rdf:Property ;
    rdfs:label 'Last Depreciation Run Date' ;
    rdfs:comment 'The date of the most recent depreciation calculation run that updated accumulated depreciation and net book value for this asset. Typically monthly or quarterly.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:modifiedByUser rdf:type rdf:Property ;
    rdfs:label 'Modified By User' ;
    rdfs:comment 'The user ID or name of the person who last modified this depreciation schedule record. Used for audit trail and accountability.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netBookValue rdf:type rdf:Property ;
    rdfs:label 'Net Book Value' ;
    rdfs:comment 'The current book value of the asset calculated as depreciable cost basis minus accumulated depreciation. Represents the undepreciated value remaining on the balance sheet. Expressed in USD.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nextDepreciationRunDate rdf:type rdf:Property ;
    rdfs:label 'Next Depreciation Run Date' ;
    rdfs:comment 'The scheduled date for the next depreciation calculation run. Used for planning and ensuring timely financial close.' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:originalUsefulLifeYears rdf:type rdf:Property ;
    rdfs:label 'Original Useful Life Years' ;
    rdfs:comment 'The estimated useful life of the asset in years as determined at the time of initial capitalization or most recent depreciation study. Used to calculate annual depreciation rates.' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateBaseEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Rate Base Eligible Flag' ;
    rdfs:comment 'Indicates whether this asset is eligible for inclusion in the Regulatory Asset Base (RAB) for rate-making purposes. True for used and useful assets; false for assets not yet in service or disallowed by regulators.' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Regulatory Jurisdiction' ;
    rdfs:comment 'The regulatory authority governing the depreciation treatment of this asset. Federal jurisdiction applies to interstate transmission assets under FERC; state jurisdiction applies to distribution and generation assets under state PUCs.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retirementDate rdf:type rdf:Property ;
    rdfs:label 'Retirement Date' ;
    rdfs:comment 'The date the asset was retired from service and depreciation ceased. Null for assets still in service.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:salvageValue rdf:type rdf:Property ;
    rdfs:label 'Salvage Value' ;
    rdfs:comment 'The estimated residual value of the asset at the end of its useful life. Subtracted from original cost to determine depreciable cost basis. May be zero for many utility assets. Expressed in USD.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scheduleEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Schedule Effective Date' ;
    rdfs:comment 'The date when this depreciation schedule becomes effective for the asset. Typically the asset in-service date or the date of a depreciation study revision.' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:taxDepreciationLifeYears rdf:type rdf:Property ;
    rdfs:label 'Tax Depreciation Life Years' ;
    rdfs:comment 'The useful life used for tax depreciation purposes, which may differ from book depreciation life. Determined by IRS asset class and recovery period tables.' ;
    rdfs:domain ind:DepreciationSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxDepreciationMethod rdf:type rdf:Property ;
    rdfs:label 'Tax Depreciation Method' ;
    rdfs:comment 'The depreciation method used for income tax purposes, which may differ from book depreciation. MACRS (Modified Accelerated Cost Recovery System) is most common for tax purposes.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wbsElement rdf:type rdf:Property ;
    rdfs:label 'Wbs Element' ;
    rdfs:comment 'The project WBS element if this asset was capitalized as part of a capital project. Links to SAP PS project structure for CAPEX tracking and reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failureEventId rdf:type rdf:Property ;
    rdfs:label 'Failure Event Id' ;
    rdfs:comment 'Unique identifier for the asset failure event record. Primary key for the failure event entity.' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:parcelId rdf:type rdf:Property ;
    rdfs:label 'Parcel Id' ;
    rdfs:comment 'Foreign key linking to property.parcel. Business justification: OUTAGE ANALYSIS: Failure events are reported by parcel to assess customer impact and regulatory outage metrics.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Parcel .

ind:assetAgeYears rdf:type rdf:Property ;
    rdfs:label 'Asset Age Years' ;
    rdfs:comment 'Age of the asset in years at the time of failure. Calculated from asset installation date to failure date. Used for age-based reliability analysis and replacement prioritization.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assetCriticalityTier rdf:type rdf:Property ;
    rdfs:label 'Asset Criticality Tier' ;
    rdfs:comment 'Business criticality classification of the failed asset based on customer impact, system reliability importance, and replacement cost. Tier 1 assets receive highest priority for reliability investment.' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:causeCode rdf:type rdf:Property ;
    rdfs:label 'Cause Code' ;
    rdfs:comment 'Standardized code identifying the root cause category of the failure. Format: XX-NNN where XX is cause category and NNN is specific cause. Aligns with NERC GADS cause code taxonomy.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:causeDescription rdf:type rdf:Property ;
    rdfs:label 'Cause Description' ;
    rdfs:comment 'Detailed narrative description of the root cause analysis findings, contributing factors, and conditions that led to the asset failure. Captured from engineering investigation reports.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:componentFailed rdf:type rdf:Property ;
    rdfs:label 'Component Failed' ;
    rdfs:comment 'Specific component, sub-assembly, or part of the asset that experienced the failure. Examples: transformer winding, circuit breaker contact, turbine blade, valve actuator, insulator string.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctiveActionPlan rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Plan' ;
    rdfs:comment 'Description of long-term corrective actions planned or implemented to prevent recurrence of similar failures. May include design changes, maintenance program updates, or asset replacement decisions.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crewArrivalTimestamp rdf:type rdf:Property ;
    rdfs:label 'Crew Arrival Timestamp' ;
    rdfs:comment 'Date and time when the response crew arrived on site at the failed asset location. Used to calculate travel time and overall response time metrics.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:customersAffected rdf:type rdf:Property ;
    rdfs:label 'Customers Affected' ;
    rdfs:comment 'Number of customer accounts that experienced service interruption as a result of this failure event. Critical input for SAIFI and CAIDI calculations.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:detectionMethod rdf:type rdf:Property ;
    rdfs:label 'Detection Method' ;
    rdfs:comment 'Method by which the failure was initially detected. Indicates whether failure was caught by automated systems, operator vigilance, or customer impact.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:energyNotSuppliedMwh rdf:type rdf:Property ;
    rdfs:label 'Energy Not Supplied Mwh' ;
    rdfs:comment 'Total energy in megawatt-hours (MWh) that could not be delivered to customers during the outage period. Calculated as load lost multiplied by outage duration.' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedRevenueLossAmount rdf:type rdf:Property ;
    rdfs:label 'Estimated Revenue Loss Amount' ;
    rdfs:comment 'Estimated revenue loss in USD due to energy not supplied during the outage period. Calculated using average retail rates and energy not supplied volume.' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:failureDate rdf:type rdf:Property ;
    rdfs:label 'Failure Date' ;
    rdfs:comment 'Calendar date when the asset failure occurred. Used for reliability trending and MTBF calculations.' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:failureEventNumber rdf:type rdf:Property ;
    rdfs:label 'Failure Event Number' ;
    rdfs:comment 'Business identifier for the failure event used in operational communications and reporting. Format: FE-XXXXXXXXXX.' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failureMode rdf:type rdf:Property ;
    rdfs:label 'Failure Mode' ;
    rdfs:comment 'Classification of the physical mechanism or mode by which the asset failed. Examples include insulation breakdown, mechanical wear, corrosion, overload, lightning strike, short circuit, thermal fatigue, vibration damage. [ENUM-REF-CANDIDATE: insulation_breakdown|mechanical_wear|corrosion|overload|lightning_strike|short_circuit|thermal_fatigue|vibration_damage|contamination|fatigue_crack|seal_failure|bearing_failure — promote to reference product]' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failureNotificationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Failure Notification Timestamp' ;
    rdfs:comment 'Date and time when the failure was first reported or logged in the outage management system. Used to measure detection and response time performance.' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:failureSeverity rdf:type rdf:Property ;
    rdfs:label 'Failure Severity' ;
    rdfs:comment 'Business impact classification of the failure event based on customer impact, safety risk, and system reliability. Critical failures require immediate response and executive notification.' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failureTimestamp rdf:type rdf:Property ;
    rdfs:label 'Failure Timestamp' ;
    rdfs:comment 'Precise date and time when the asset failure was detected or occurred. Captured from SCADA alarm systems or operator logs.' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:failureType rdf:type rdf:Property ;
    rdfs:label 'Failure Type' ;
    rdfs:comment 'High-level categorization of the failure event distinguishing between forced outages, unplanned derates, equipment malfunctions, protective relay trips, cascading failures, and external events.' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forcedOutageFlag rdf:type rdf:Property ;
    rdfs:label 'Forced Outage Flag' ;
    rdfs:comment 'Indicates whether this failure resulted in a forced (unplanned) outage requiring immediate removal of the asset from service. True for forced outages, False for failures that did not require immediate outage.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:insuranceClaimNumber rdf:type rdf:Property ;
    rdfs:label 'Insurance Claim Number' ;
    rdfs:comment 'Insurance claim reference number if a claim was filed for this failure event. Format: INS-XXXXXXXX. Used to track insurance recovery for major equipment failures.' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuranceClaimStatus rdf:type rdf:Property ;
    rdfs:label 'Insurance Claim Status' ;
    rdfs:comment 'Current status of the insurance claim associated with this failure event. Tracks claim lifecycle from filing through payment.' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loadLostMw rdf:type rdf:Property ;
    rdfs:label 'Load Lost Mw' ;
    rdfs:comment 'Amount of electrical load in megawatts (MW) that was lost or interrupted due to the failure event. Used for transmission and generation reliability reporting.' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:majorEventDayFlag rdf:type rdf:Property ;
    rdfs:label 'Major Event Day Flag' ;
    rdfs:comment 'Indicates whether this failure occurred during a major event day as defined by IEEE 1366 beta method. Major event days may be excluded from reliability performance metrics per regulatory rules.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mtbfContributionHours rdf:type rdf:Property ;
    rdfs:label 'Mtbf Contribution Hours' ;
    rdfs:comment 'Operating hours accumulated by the asset since the previous failure event. Used to calculate fleet-level MTBF statistics for asset class reliability benchmarking.' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:operatingVoltageKv rdf:type rdf:Property ;
    rdfs:label 'Operating Voltage Kv' ;
    rdfs:comment 'Nominal operating voltage in kilovolts (kV) of the asset or system where the failure occurred. Used for failure rate analysis by voltage class.' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outageDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Outage Duration Minutes' ;
    rdfs:comment 'Total duration in minutes that the asset was out of service due to the failure event. Used for SAIDI, SAIFI, and CAIDI reliability metric calculations.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryReportNumber rdf:type rdf:Property ;
    rdfs:label 'Regulatory Report Number' ;
    rdfs:comment 'Reference number assigned to the regulatory report filed for this failure event. Format: REG-XXXX-NNNNNN where XXXX is agency code. Links to compliance documentation.' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryReportableFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reportable Flag' ;
    rdfs:comment 'Indicates whether this failure event meets thresholds requiring mandatory reporting to regulatory bodies such as FERC, NERC, state PUC, or OSHA. True if reportable, False otherwise.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:repairActionTaken rdf:type rdf:Property ;
    rdfs:label 'Repair Action Taken' ;
    rdfs:comment 'Description of the corrective maintenance actions performed to restore the asset to service. Includes parts replaced, repairs completed, and temporary vs permanent fixes.' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:repairCostAmount rdf:type rdf:Property ;
    rdfs:label 'Repair Cost Amount' ;
    rdfs:comment 'Total cost in USD incurred to repair the failed asset including labor, materials, contractor services, and equipment rental. Sourced from work order actuals in Maximo and SAP.' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:replacementRecommendedFlag rdf:type rdf:Property ;
    rdfs:label 'Replacement Recommended Flag' ;
    rdfs:comment 'Indicates whether engineering analysis recommends full asset replacement rather than continued repair. Used to prioritize capital investment and asset replacement programs.' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:responseCrewDispatchedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Response Crew Dispatched Timestamp' ;
    rdfs:comment 'Date and time when field crew was dispatched to respond to the failure event. Used to calculate dispatch time and crew response performance metrics.' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:restorationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Restoration Timestamp' ;
    rdfs:comment 'Date and time when the asset was successfully returned to service following repair actions. Used to calculate mean time to repair (MTTR).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:rootCauseAnalysisCompletedFlag rdf:type rdf:Property ;
    rdfs:label 'Root Cause Analysis Completed Flag' ;
    rdfs:comment 'Indicates whether a formal root cause analysis investigation has been completed for this failure event. RCA is typically required for critical and major severity failures.' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:safetyIncidentFlag rdf:type rdf:Property ;
    rdfs:label 'Safety Incident Flag' ;
    rdfs:comment 'Indicates whether the failure event resulted in or contributed to a worker or public safety incident requiring OSHA reporting or internal safety investigation.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:timeSinceLastMaintenanceDays rdf:type rdf:Property ;
    rdfs:label 'Time Since Last Maintenance Days' ;
    rdfs:comment 'Number of days elapsed between the last preventive maintenance activity and this failure event. Used to evaluate maintenance program effectiveness.' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:weatherCondition rdf:type rdf:Property ;
    rdfs:label 'Weather Condition' ;
    rdfs:comment 'Specific weather condition present at the time of failure if weather-related. Used for correlation analysis and major event day classification. [ENUM-REF-CANDIDATE: lightning|high_wind|ice_storm|flooding|extreme_heat|extreme_cold|normal — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:weatherRelatedFlag rdf:type rdf:Property ;
    rdfs:label 'Weather Related Flag' ;
    rdfs:comment 'Indicates whether the failure was caused by or contributed to by weather conditions such as lightning, wind, ice, temperature extremes, or flooding. Used for major event day (MED) exclusions in reliability reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hierarchyId rdf:type rdf:Property ;
    rdfs:label 'Hierarchy Id' ;
    rdfs:comment 'Primary key for hierarchy' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:childAssetAssetRegistryId rdf:type rdf:Property ;
    rdfs:label 'Child Asset Asset Registry Id' ;
    rdfs:comment 'Identifier of the child asset in the hierarchy structure. References the subordinate asset in the parent-child relationship.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Registry .

ind:childAssetRegistryId rdf:type rdf:Property ;
    rdfs:label 'Child Asset Registry Id' ;
    rdfs:comment 'Identifier of the child asset in the hierarchy structure. References the subordinate asset in the parent-child relationship.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Registry .

ind:hierarchyAssetRegistryId rdf:type rdf:Property ;
    rdfs:label 'Hierarchy Asset Registry Id' ;
    rdfs:comment 'Identifier of the parent asset in the hierarchy structure. References the superior asset in the parent-child relationship.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Registry .

ind:costAllocationPercentage rdf:type rdf:Property ;
    rdfs:label 'Cost Allocation Percentage' ;
    rdfs:comment 'Percentage of child asset costs (Operations and Maintenance, depreciation, CAPEX) allocated to the parent asset for financial roll-up and rate base reporting. May differ from ownership percentage in regulated utility accounting. Value between 0.00 and 100.00.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:criticalityInheritanceFlag rdf:type rdf:Property ;
    rdfs:label 'Criticality Inheritance Flag' ;
    rdfs:comment 'Indicates whether the child asset inherits criticality classification from the parent asset. True means child criticality is derived from parent, false means child has independent criticality assessment.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataQualityScore rdf:type rdf:Property ;
    rdfs:label 'Data Quality Score' ;
    rdfs:comment 'Automated data quality score for the hierarchy relationship record based on completeness, consistency, and validation rules. Value between 0.00 and 1.00 where 1.00 represents perfect quality.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:geographicContainmentFlag rdf:type rdf:Property ;
    rdfs:label 'Geographic Containment Flag' ;
    rdfs:comment 'Indicates whether the child asset is physically contained within the geographic boundaries of the parent asset. True for spatial containment (e.g., transformer inside substation), false for logical relationships without physical containment.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gisFeatureRelationshipCode rdf:type rdf:Property ;
    rdfs:label 'Gis Feature Relationship Code' ;
    rdfs:comment 'External identifier linking this hierarchy relationship to the corresponding feature relationship in Esri ArcGIS. Enables synchronization between EAM and GIS systems for geospatial asset tracking.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hierarchyDescription rdf:type rdf:Property ;
    rdfs:label 'Hierarchy Description' ;
    rdfs:comment 'Free-text description explaining the nature and business purpose of the parent-child relationship. Provides context for non-standard or complex hierarchical arrangements.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hierarchyLevel rdf:type rdf:Property ;
    rdfs:label 'Hierarchy Level' ;
    rdfs:comment 'Numeric level in the hierarchy tree structure where level 1 is the root and higher numbers represent deeper nesting. Used for roll-up calculations and tree traversal.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:hierarchyType rdf:type rdf:Property ;
    rdfs:label 'Hierarchy Type' ;
    rdfs:comment 'Classification of the hierarchy relationship type. Functional represents operational groupings, spatial represents physical location containment, accounting represents financial roll-up structures, network represents electrical or gas connectivity, organizational represents ownership or responsibility structures, and maintenance represents work planning groupings.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastModifiedBy rdf:type rdf:Property ;
    rdfs:label 'Last Modified By' ;
    rdfs:comment 'User identifier or system account that last modified the hierarchy relationship record. Used for audit trail and change tracking.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maintenanceResponsibilityCode rdf:type rdf:Property ;
    rdfs:label 'Maintenance Responsibility Code' ;
    rdfs:comment 'Code identifying the organizational unit or crew responsible for maintaining the child asset within this hierarchy context. Used for work order routing and maintenance planning.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maximoRelationshipCode rdf:type rdf:Property ;
    rdfs:label 'Maximo Relationship Code' ;
    rdfs:comment 'External identifier from Maximo EAM system representing the source asset relationship record. Used for data lineage and bidirectional synchronization with the operational EAM system.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:networkTopologyRole rdf:type rdf:Property ;
    rdfs:label 'Network Topology Role' ;
    rdfs:comment 'Role of the child asset relative to the parent in electrical or gas network topology. Upstream indicates the child feeds the parent, downstream indicates the parent feeds the child, parallel indicates side-by-side configuration, redundant indicates backup relationship, and isolated indicates no active flow relationship.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outagePropagationFlag rdf:type rdf:Property ;
    rdfs:label 'Outage Propagation Flag' ;
    rdfs:comment 'Indicates whether an outage of the parent asset automatically causes an outage of the child asset. True for dependent assets where parent failure cascades to children, false for independent operation. Used in Outage Management System (OMS) impact analysis.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ownershipPercentage rdf:type rdf:Property ;
    rdfs:label 'Ownership Percentage' ;
    rdfs:comment 'Percentage of the child asset owned or allocated to the parent asset in joint ownership or shared asset scenarios. Used for proportional CAPEX allocation and Regulatory Asset Base (RAB) calculations. Value between 0.00 and 100.00.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:path rdf:type rdf:Property ;
    rdfs:label 'Path' ;
    rdfs:comment 'Full hierarchical path from root to child asset represented as a delimited string of asset identifiers. Enables efficient ancestor and descendant queries. Format example: /1/45/892/3421.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryHierarchyFlag rdf:type rdf:Property ;
    rdfs:label 'Primary Hierarchy Flag' ;
    rdfs:comment 'Indicates whether this is the primary hierarchy relationship for the child asset when multiple hierarchy types exist. True designates the authoritative parent-child relationship for default reporting and CAPEX roll-up.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rabAllocationMethod rdf:type rdf:Property ;
    rdfs:label 'Rab Allocation Method' ;
    rdfs:comment 'Method used to allocate child asset value to parent for Regulatory Asset Base reporting. Direct assigns full value to parent, proportional uses ownership percentage, shared distributes across multiple parents, and excluded removes from RAB roll-up.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relationshipEstablishedDate rdf:type rdf:Property ;
    rdfs:label 'Relationship Established Date' ;
    rdfs:comment 'Date when the hierarchy relationship was first created in the system. Distinct from effective start date; represents the administrative creation date for audit purposes.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:relationshipStatus rdf:type rdf:Property ;
    rdfs:label 'Relationship Status' ;
    rdfs:comment 'Current lifecycle status of the hierarchy relationship. Active indicates the relationship is currently in effect, inactive indicates it has been terminated, pending indicates it is scheduled for future activation, and superseded indicates it has been replaced by a newer relationship.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relationshipTerminatedDate rdf:type rdf:Property ;
    rdfs:label 'Relationship Terminated Date' ;
    rdfs:comment 'Date when the hierarchy relationship was administratively terminated or removed from the system. Used for audit trail and historical analysis of asset reorganizations.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Sequence Number' ;
    rdfs:comment 'Ordering sequence of the child asset among its siblings within the same parent. Used for display ordering and operational sequencing in maintenance routes and inspection plans.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sourceSystem rdf:type rdf:Property ;
    rdfs:label 'Source System' ;
    rdfs:comment 'System of origin for the hierarchy relationship record. Maximo indicates EAM system, ArcGIS indicates geospatial system, SAP PM indicates plant maintenance module, manual indicates user-entered data, and migration indicates legacy system conversion.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:terminationReasonCode rdf:type rdf:Property ;
    rdfs:label 'Termination Reason Code' ;
    rdfs:comment 'Code indicating the reason for terminating the hierarchy relationship. Asset retired indicates child asset decommissioned, asset transferred indicates ownership change, reorganization indicates structural change, error correction indicates data quality fix, asset replaced indicates equipment upgrade, and consolidation indicates merger of asset records.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationStatus rdf:type rdf:Property ;
    rdfs:label 'Validation Status' ;
    rdfs:comment 'Status of data quality validation for the hierarchy relationship. Validated indicates passed all business rules, pending review indicates flagged for manual inspection, failed indicates rule violations detected, and not validated indicates validation not yet performed.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Validation Timestamp' ;
    rdfs:comment 'Timestamp when the most recent data quality validation was performed on the hierarchy relationship record.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:createdBy rdf:type rdf:Property ;
    rdfs:label 'Created By' ;
    rdfs:comment 'User identifier or system account that created the hierarchy relationship record. Used for audit trail and data governance.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionId rdf:type rdf:Property ;
    rdfs:label 'Inspection Id' ;
    rdfs:comment 'Unique identifier for the inspection event record. Primary key.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Inspection .

ind:inspectionFollowUpWorkOrderId rdf:type rdf:Property ;
    rdfs:label 'Inspection Follow Up Work Order Id' ;
    rdfs:comment 'Reference to the corrective or remedial work order generated as a result of inspection findings, if applicable. Links to Maximo work order.' ;
    rdfs:domain ind:Inspection ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WorkOrder .

ind:inspectionWorkOrderId rdf:type rdf:Property ;
    rdfs:label 'Inspection Work Order Id' ;
    rdfs:comment 'Reference to the work order under which this inspection was performed, if applicable. Links to Maximo EAM work order.' ;
    rdfs:domain ind:Inspection ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WorkOrder .

ind:inspectorTechnicianId rdf:type rdf:Property ;
    rdfs:label 'Inspector Technician Id' ;
    rdfs:comment 'Reference to the technician or crew member who performed the inspection. Links to workforce technician master.' ;
    rdfs:domain ind:Inspection ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Technician .

ind:reportDocumentId rdf:type rdf:Property ;
    rdfs:label 'Report Document Id' ;
    rdfs:comment 'Reference identifier or URI to the formal inspection report document stored in the enterprise document management system or Maximo attachments.' ;
    rdfs:domain ind:Inspection ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Document .

ind:ambientTemperatureF rdf:type rdf:Property ;
    rdfs:label 'Ambient Temperature F' ;
    rdfs:comment 'Ambient air temperature in degrees Fahrenheit at the time of inspection, relevant for thermographic inspections and equipment performance assessment.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approvalTimestamp rdf:type rdf:Property ;
    rdfs:label 'Approval Timestamp' ;
    rdfs:comment 'Date and time when the inspection results were formally approved by the supervisor or engineering authority.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:approvedBySupervisorFlag rdf:type rdf:Property ;
    rdfs:label 'Approved By Supervisor Flag' ;
    rdfs:comment 'Boolean indicator of whether the inspection results have been reviewed and approved by a supervisor or engineering authority (True = approved, False = pending approval).' ;
    rdfs:domain ind:Inspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:assetConditionScore rdf:type rdf:Property ;
    rdfs:label 'Asset Condition Score' ;
    rdfs:comment 'Quantitative condition score or health index assigned to the asset as a result of this inspection, typically on a 0-100 scale or utility-defined rating system. This is the inspection-derived score that may feed into the asset_condition product.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:correctiveActionRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Required Flag' ;
    rdfs:comment 'Boolean indicator of whether corrective action or remediation work is required as a result of this inspection (True = action required, False = no action required).' ;
    rdfs:domain ind:Inspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cost rdf:type rdf:Property ;
    rdfs:label 'Cost' ;
    rdfs:comment 'Total cost incurred for this inspection activity, including labor, equipment, contractor fees, and materials. Captured in USD.' ;
    rdfs:domain ind:Inspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:criticalDeficiencyCount rdf:type rdf:Property ;
    rdfs:label 'Critical Deficiency Count' ;
    rdfs:comment 'Number of critical or high-severity deficiencies identified that pose immediate safety, reliability, or compliance risk and require urgent corrective action.' ;
    rdfs:domain ind:Inspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:durationHours rdf:type rdf:Property ;
    rdfs:label 'Duration Hours' ;
    rdfs:comment 'Total duration of the inspection activity in hours, calculated from start to end timestamp or manually recorded.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:endTimestamp rdf:type rdf:Property ;
    rdfs:label 'End Timestamp' ;
    rdfs:comment 'Precise date and time when the inspection activity was completed.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:frequencyCode rdf:type rdf:Property ;
    rdfs:label 'Frequency Code' ;
    rdfs:comment 'Planned frequency or cadence for this type of inspection: annual, semi-annual, quarterly, monthly, weekly, daily, on-demand, event-driven (triggered by alarm or incident), or regulatory-mandated interval. [ENUM-REF-CANDIDATE: annual|semi_annual|quarterly|monthly|weekly|daily|on_demand|event_driven|regulatory_mandated — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Inspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gisLatitude rdf:type rdf:Property ;
    rdfs:label 'Gis Latitude' ;
    rdfs:comment 'Geographic latitude coordinate (decimal degrees) of the inspection location, captured from mobile field systems or GIS.' ;
    rdfs:domain ind:Inspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gisLongitude rdf:type rdf:Property ;
    rdfs:label 'Gis Longitude' ;
    rdfs:comment 'Geographic longitude coordinate (decimal degrees) of the inspection location, captured from mobile field systems or GIS.' ;
    rdfs:domain ind:Inspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inspectionDate rdf:type rdf:Property ;
    rdfs:label 'Inspection Date' ;
    rdfs:comment 'The calendar date on which the inspection was conducted in the field.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionMethod rdf:type rdf:Property ;
    rdfs:label 'Inspection Method' ;
    rdfs:comment 'Technical method or technology used to perform the inspection: visual observation, thermographic (infrared), ultrasonic testing, radiographic testing, magnetic particle, dye penetrant, eddy current, acoustic monitoring, vibration analysis, oil analysis, electrical testing, pressure testing, leak detection, drone aerial survey, or LiDAR scanning. [ENUM-REF-CANDIDATE: visual|thermographic|ultrasonic|radiographic|magnetic_particle|dye_penetrant|eddy_current|acoustic|vibration_analysis|oil_analysis|electrical_testing|pressure_testing|leak_detection|drone_survey|lidar_scan — 15 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionNumber rdf:type rdf:Property ;
    rdfs:label 'Inspection Number' ;
    rdfs:comment 'Business-facing unique identifier or tracking number for the inspection event, often generated by field systems or Maximo.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionScope rdf:type rdf:Property ;
    rdfs:label 'Inspection Scope' ;
    rdfs:comment 'Description of the scope or extent of the inspection activity, including specific components, systems, or areas covered (e.g., all bushings and insulators, primary and secondary windings, foundation and structural supports).' ;
    rdfs:domain ind:Inspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionStatus rdf:type rdf:Property ;
    rdfs:label 'Inspection Status' ;
    rdfs:comment 'Current lifecycle status of the inspection event: scheduled, in progress, completed, cancelled, deferred to future date, or under review by supervisor or engineering.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectorCertificationNumber rdf:type rdf:Property ;
    rdfs:label 'Inspector Certification Number' ;
    rdfs:comment 'Professional certification or license number of the inspector (e.g., thermography Level II, NACE corrosion specialist, API pipeline inspector, electrical relay technician certification).' ;
    rdfs:domain ind:Inspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectorName rdf:type rdf:Property ;
    rdfs:label 'Inspector Name' ;
    rdfs:comment 'Full name of the individual who conducted the inspection. May be internal utility crew member, contractor, or third-party auditor.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectorOrganization rdf:type rdf:Property ;
    rdfs:label 'Inspector Organization' ;
    rdfs:comment 'Type of organization that performed the inspection: internal utility staff, external contractor, third-party auditor, or regulatory agency inspector.' ;
    rdfs:domain ind:Inspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationDescription rdf:type rdf:Property ;
    rdfs:label 'Location Description' ;
    rdfs:comment 'Textual description of the physical location where the inspection was performed (e.g., Substation 42 Bay 3, Transmission Line 765kV Mile Marker 12.5, Gas Pipeline Segment 4A Valve Station).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextInspectionDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Inspection Due Date' ;
    rdfs:comment 'Calculated or scheduled date for the next required inspection of this asset, based on inspection frequency, regulatory requirements, and current condition assessment.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:photoCount rdf:type rdf:Property ;
    rdfs:label 'Photo Count' ;
    rdfs:comment 'Number of photographs or images captured during the inspection and attached to the inspection record for documentation and evidence.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priority rdf:type rdf:Property ;
    rdfs:label 'Priority' ;
    rdfs:comment 'Priority level assigned to the inspection based on asset criticality, regulatory mandate, or risk assessment: critical, high, medium, low, or routine.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordCreatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Record Created Timestamp' ;
    rdfs:comment 'Date and time when this inspection record was first created in the source system or data platform.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:recordUpdatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Record Updated Timestamp' ;
    rdfs:comment 'Date and time when this inspection record was last modified or updated in the source system or data platform.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:regulatoryRequirementReference rdf:type rdf:Property ;
    rdfs:label 'Regulatory Requirement Reference' ;
    rdfs:comment 'Specific citation or reference to the regulatory standard, code section, or compliance requirement that mandates this inspection (e.g., NERC CIP-006-6 R1.5, PHMSA §192.465, NESC Rule 218).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskLevel rdf:type rdf:Property ;
    rdfs:label 'Risk Level' ;
    rdfs:comment 'Risk level assessment based on inspection findings, considering probability of failure and consequence of failure: critical, high, medium, low, or negligible.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemRecordCode rdf:type rdf:Property ;
    rdfs:label 'Source System Record Code' ;
    rdfs:comment 'Unique identifier or primary key of this inspection record in the source operational system, used for data lineage and reconciliation.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:startTimestamp rdf:type rdf:Property ;
    rdfs:label 'Start Timestamp' ;
    rdfs:comment 'Precise date and time when the inspection activity began, captured from field systems or mobile workforce applications.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:supervisorName rdf:type rdf:Property ;
    rdfs:label 'Supervisor Name' ;
    rdfs:comment 'Full name of the supervisor or engineering authority who reviewed and approved the inspection results.' ;
    rdfs:domain ind:Inspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lifecycleEventId rdf:type rdf:Property ;
    rdfs:label 'Lifecycle Event Id' ;
    rdfs:comment 'Primary key for lifecycle_event' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:approvedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Approved By Employee Id' ;
    rdfs:comment 'Identifier of the employee who approved the event.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:filingId rdf:type rdf:Property ;
    rdfs:label 'Filing Id' ;
    rdfs:comment 'Identifier of the regulatory report generated for this event, if applicable.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Filing .

ind:primaryLifecycleAssetRegistryId rdf:type rdf:Property ;
    rdfs:label 'Primary Lifecycle Asset Registry Id' ;
    rdfs:comment 'Unique identifier of the physical asset to which the lifecycle event applies.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Registry .

ind:primaryLifecycleTechnicianId rdf:type rdf:Property ;
    rdfs:label 'Primary Lifecycle Technician Id' ;
    rdfs:comment 'Identifier of the employee or contractor who authorized the lifecycle event.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Technician .

ind:approvalStatus rdf:type rdf:Property ;
    rdfs:label 'Approval Status' ;
    rdfs:comment 'Current approval state of the event.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetConditionAfter rdf:type rdf:Property ;
    rdfs:label 'Asset Condition After' ;
    rdfs:comment 'Condition rating of the asset after the event.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetConditionBefore rdf:type rdf:Property ;
    rdfs:label 'Asset Condition Before' ;
    rdfs:comment 'Condition rating of the asset prior to the event.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetSerialNumber rdf:type rdf:Property ;
    rdfs:label 'Asset Serial Number' ;
    rdfs:comment 'Manufacturer-assigned serial number of the asset.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetTagNumber rdf:type rdf:Property ;
    rdfs:label 'Asset Tag Number' ;
    rdfs:comment 'Physical tag number affixed to the asset.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capitalExpenditureFlag rdf:type rdf:Property ;
    rdfs:label 'Capital Expenditure Flag' ;
    rdfs:comment 'True if the event is classified as a capital expenditure.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:costAmount rdf:type rdf:Property ;
    rdfs:label 'Cost Amount' ;
    rdfs:comment 'Monetary cost directly attributable to the lifecycle event.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currencyCode rdf:type rdf:Property ;
    rdfs:label 'Currency Code' ;
    rdfs:comment 'Three-letter ISO currency code for the cost amount.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depreciationImpactAmount rdf:type rdf:Property ;
    rdfs:label 'Depreciation Impact Amount' ;
    rdfs:comment 'Change to the asset\'s depreciation schedule caused by the event.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depreciationImpactType rdf:type rdf:Property ;
    rdfs:label 'Depreciation Impact Type' ;
    rdfs:comment 'Nature of the depreciation impact.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emissionsChangeTonsCo2e rdf:type rdf:Property ;
    rdfs:label 'Emissions Change Tons Co2e' ;
    rdfs:comment 'Net change in CO₂-equivalent emissions attributable to the event, expressed in metric tons.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:environmentalImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Environmental Impact Flag' ;
    rdfs:comment 'True if the event has a measurable environmental impact (e.g., emissions change).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:eventCategory rdf:type rdf:Property ;
    rdfs:label 'Event Category' ;
    rdfs:comment 'High-level classification of the lifecycle event.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventDocumentReference rdf:type rdf:Property ;
    rdfs:label 'Event Document Reference' ;
    rdfs:comment 'Reference (e.g., URL or file ID) to supporting documentation for the event.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Event Effective Date' ;
    rdfs:comment 'Date on which the new status becomes effective.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:eventExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Event Expiration Date' ;
    rdfs:comment 'Date on which the event\'s effect expires, if applicable.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:eventLocationLatitude rdf:type rdf:Property ;
    rdfs:label 'Event Location Latitude' ;
    rdfs:comment 'Latitude coordinate of the asset at the time of the event.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eventLocationLongitude rdf:type rdf:Property ;
    rdfs:label 'Event Location Longitude' ;
    rdfs:comment 'Longitude coordinate of the asset at the time of the event.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eventNotes rdf:type rdf:Property ;
    rdfs:label 'Event Notes' ;
    rdfs:comment 'Free-text notes providing additional context or justification for the event.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventSequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Event Sequence Number' ;
    rdfs:comment 'Sequential number of the event for the given asset, starting at 1.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:eventSourceType rdf:type rdf:Property ;
    rdfs:label 'Event Source Type' ;
    rdfs:comment 'Indicates whether the event originated from an automated system or manual entry.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventTimestamp rdf:type rdf:Property ;
    rdfs:label 'Event Timestamp' ;
    rdfs:comment 'Date and time when the lifecycle event occurred, recorded in UTC.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:eventType rdf:type rdf:Property ;
    rdfs:label 'Event Type' ;
    rdfs:comment 'Type of lifecycle transition (e.g., commissioned, transferred, modified, refurbished, retired, disposed, written-off).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:impactOnRabFlag rdf:type rdf:Property ;
    rdfs:label 'Impact On Rab Flag' ;
    rdfs:comment 'True if the event changes the asset\'s contribution to the Regulatory Asset Base.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isManualEntry rdf:type rdf:Property ;
    rdfs:label 'Is Manual Entry' ;
    rdfs:comment 'True if the event was entered manually rather than generated by a system.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:newStatus rdf:type rdf:Property ;
    rdfs:label 'New Status' ;
    rdfs:comment 'Asset status code after the event was applied.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:opexExpenditureFlag rdf:type rdf:Property ;
    rdfs:label 'Opex Expenditure Flag' ;
    rdfs:comment 'True if the event is classified as an operating expense.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:previousStatus rdf:type rdf:Property ;
    rdfs:label 'Previous Status' ;
    rdfs:comment 'Asset status code before the event was applied.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectReference rdf:type rdf:Property ;
    rdfs:label 'Project Reference' ;
    rdfs:comment 'Identifier of the capital project associated with the event, if any.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryReportingFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reporting Flag' ;
    rdfs:comment 'True if the event must be reported to a regulatory body.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:warrantyStatusAfter rdf:type rdf:Property ;
    rdfs:label 'Warranty Status After' ;
    rdfs:comment 'Warranty coverage status after the event.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:warrantyStatusBefore rdf:type rdf:Property ;
    rdfs:label 'Warranty Status Before' ;
    rdfs:comment 'Warranty coverage status before the event.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationId rdf:type rdf:Property ;
    rdfs:label 'Location Id' ;
    rdfs:comment 'Primary key for location' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Location .

ind:landParcelId rdf:type rdf:Property ;
    rdfs:label 'Land Parcel Id' ;
    rdfs:comment 'Tax parcel or land parcel identifier from county assessor records, used for property rights and easement management.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Parcel .

ind:networkDeviceId rdf:type rdf:Property ;
    rdfs:label 'Network Device Id' ;
    rdfs:comment 'Foreign key linking to technology.network_device. Business justification: Network Device Mapping: link GIS location to network device for outage management and field crew dispatch (Network Outage Response Plan).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:NetworkDevice .

ind:warehouseId rdf:type rdf:Property ;
    rdfs:label 'Warehouse Id' ;
    rdfs:comment 'Foreign key linking to supply.warehouse. Business justification: Spare Parts Logistics; linking asset locations (e.g., substations) to the serving warehouse supports inventory allocation, delivery planning, and regulatory logistics reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Warehouse .

ind:accessRestrictions rdf:type rdf:Property ;
    rdfs:label 'Access Restrictions' ;
    rdfs:comment 'Description of any access restrictions or special requirements for field crews to reach the location (e.g., locked gate, private property, permit required).' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:city rdf:type rdf:Property ;
    rdfs:label 'City' ;
    rdfs:comment 'City or municipality name where the location is situated.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:countryCode rdf:type rdf:Property ;
    rdfs:label 'Country Code' ;
    rdfs:comment 'Three-letter ISO country code where the location is situated.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:county rdf:type rdf:Property ;
    rdfs:label 'County' ;
    rdfs:comment 'County jurisdiction where the location resides, used for regulatory territory reporting and permitting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Data Source System' ;
    rdfs:comment 'Source system of record from which this location data originated (e.g., Esri ArcGIS, Maximo EAM, manual survey).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:decommissionDate rdf:type rdf:Property ;
    rdfs:label 'Decommission Date' ;
    rdfs:comment 'Date when the location was decommissioned or retired from active service, if applicable.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:elevationFt rdf:type rdf:Property ;
    rdfs:label 'Elevation Ft' ;
    rdfs:comment 'Elevation above sea level in feet, used for engineering calculations and flood risk assessment.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gisFeatureClass rdf:type rdf:Property ;
    rdfs:label 'Gis Feature Class' ;
    rdfs:comment 'GIS feature class identifier from Esri ArcGIS system used for spatial data management and mapping.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gisObjectCode rdf:type rdf:Property ;
    rdfs:label 'Gis Object Code' ;
    rdfs:comment 'Unique object identifier within the GIS system for cross-system integration and spatial query operations.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gpsAccuracyMeters rdf:type rdf:Property ;
    rdfs:label 'Gps Accuracy Meters' ;
    rdfs:comment 'Estimated accuracy of the GPS coordinates in meters, indicating the precision of the geospatial data.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hazardClassification rdf:type rdf:Property ;
    rdfs:label 'Hazard Classification' ;
    rdfs:comment 'Environmental or safety hazard classification for the location used for risk assessment and crew safety planning.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:installationDate rdf:type rdf:Property ;
    rdfs:label 'Installation Date' ;
    rdfs:comment 'Date when the location was first established or commissioned for utility operations.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isCriticalInfrastructure rdf:type rdf:Property ;
    rdfs:label 'Is Critical Infrastructure' ;
    rdfs:comment 'Indicates whether this location is designated as critical infrastructure under NERC Critical Infrastructure Protection (CIP) standards requiring enhanced security and monitoring.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRemoteAccessible rdf:type rdf:Property ;
    rdfs:label 'Is Remote Accessible' ;
    rdfs:comment 'Indicates whether the location can be accessed or monitored remotely via SCADA or other telemetry systems.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastInspectionDate rdf:type rdf:Property ;
    rdfs:label 'Last Inspection Date' ;
    rdfs:comment 'Date of the most recent physical inspection or site survey conducted at this location.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:latitude rdf:type rdf:Property ;
    rdfs:label 'Latitude' ;
    rdfs:comment 'Geographic latitude coordinate in decimal degrees format (WGS84 datum) for precise geospatial positioning.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:locationCode rdf:type rdf:Property ;
    rdfs:label 'Location Code' ;
    rdfs:comment 'Business identifier for the location, used for external reference and integration with Geographic Information System (GIS) and Enterprise Asset Management (EAM) systems.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationName rdf:type rdf:Property ;
    rdfs:label 'Location Name' ;
    rdfs:comment 'Human-readable name or description of the location (e.g., substation name, pole identifier, vault reference).' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationStatus rdf:type rdf:Property ;
    rdfs:label 'Location Status' ;
    rdfs:comment 'Current lifecycle status of the location indicating operational availability and readiness.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationType rdf:type rdf:Property ;
    rdfs:label 'Location Type' ;
    rdfs:comment 'Classification of the location type within the utility infrastructure (e.g., substation, transmission tower, distribution pole, underground vault, generation facility). [ENUM-REF-CANDIDATE: substation|transmission_tower|distribution_pole|underground_vault|generation_facility|service_center|meter_location|switching_station — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:longitude rdf:type rdf:Property ;
    rdfs:label 'Longitude' ;
    rdfs:comment 'Geographic longitude coordinate in decimal degrees format (WGS84 datum) for precise geospatial positioning.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nercRegion rdf:type rdf:Property ;
    rdfs:label 'Nerc Region' ;
    rdfs:comment 'NERC regional entity jurisdiction for reliability compliance and reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operatingRegion rdf:type rdf:Property ;
    rdfs:label 'Operating Region' ;
    rdfs:comment 'Higher-level operating region or division responsible for this location, used for organizational reporting.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownershipType rdf:type rdf:Property ;
    rdfs:label 'Ownership Type' ;
    rdfs:comment 'Type of land or property ownership arrangement for the location (e.g., utility-owned, leased, easement, right-of-way).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:poleNumber rdf:type rdf:Property ;
    rdfs:label 'Pole Number' ;
    rdfs:comment 'Unique pole or structure number for overhead distribution and transmission assets, used for field identification.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postalCode rdf:type rdf:Property ;
    rdfs:label 'Postal Code' ;
    rdfs:comment 'Postal ZIP code for the location address.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rtoIsoTerritory rdf:type rdf:Property ;
    rdfs:label 'Rto Iso Territory' ;
    rdfs:comment 'RTO or ISO territory jurisdiction for locations within transmission grid, used for market operations and compliance reporting.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceTerritoryZone rdf:type rdf:Property ;
    rdfs:label 'Service Territory Zone' ;
    rdfs:comment 'Service territory zone identifier indicating the operational service area or district for resource allocation and planning.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateProvince rdf:type rdf:Property ;
    rdfs:label 'State Province' ;
    rdfs:comment 'Two-letter state or province code where the location is situated.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:streetAddress rdf:type rdf:Property ;
    rdfs:label 'Street Address' ;
    rdfs:comment 'Physical street address of the location where applicable, used for field crew navigation and permitting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:substationName rdf:type rdf:Property ;
    rdfs:label 'Substation Name' ;
    rdfs:comment 'Name of the associated substation if the location is within or connected to a substation facility.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vaultReference rdf:type rdf:Property ;
    rdfs:label 'Vault Reference' ;
    rdfs:comment 'Reference identifier for underground vault or manhole where underground assets are located.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operationalReadingId rdf:type rdf:Property ;
    rdfs:label 'Operational Reading Id' ;
    rdfs:comment 'Primary key for operational_reading' ;
    rdfs:domain ind:OperationalReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:alarmSeverityLevel rdf:type rdf:Property ;
    rdfs:label 'Alarm Severity Level' ;
    rdfs:comment 'Severity classification of the alarm or alert triggered by this measurement if a threshold breach occurred (normal, low, medium, high, critical). Used for prioritizing maintenance and operational response.' ;
    rdfs:domain ind:OperationalReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ambientTemperature rdf:type rdf:Property ;
    rdfs:label 'Ambient Temperature' ;
    rdfs:comment 'The ambient environmental temperature in degrees Celsius at the time of measurement, used for temperature-dependent asset performance analysis.' ;
    rdfs:domain ind:OperationalReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:calibrationDueDate rdf:type rdf:Property ;
    rdfs:label 'Calibration Due Date' ;
    rdfs:comment 'The date by which the measurement instrument must be recalibrated to ensure accuracy and compliance with operational standards.' ;
    rdfs:domain ind:OperationalReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:complianceThresholdExceededFlag rdf:type rdf:Property ;
    rdfs:label 'Compliance Threshold Exceeded Flag' ;
    rdfs:comment 'Boolean indicator (True/False) denoting whether this measurement exceeded a regulatory compliance threshold, requiring notification or corrective action per NERC, FERC, or state PUC requirements.' ;
    rdfs:domain ind:OperationalReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataLineageCode rdf:type rdf:Property ;
    rdfs:label 'Data Lineage Code' ;
    rdfs:comment 'Unique identifier for tracking the data lineage and transformation history of this operational reading from source system through integration and analytics layers.' ;
    rdfs:domain ind:OperationalReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataValidationStatus rdf:type rdf:Property ;
    rdfs:label 'Data Validation Status' ;
    rdfs:comment 'Status of the data validation process for this operational reading (pending validation, validated and approved, rejected as erroneous, under review by engineering).' ;
    rdfs:domain ind:OperationalReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:instrumentTagCode rdf:type rdf:Property ;
    rdfs:label 'Instrument Tag Code' ;
    rdfs:comment 'Unique identifier or tag number of the measurement instrument or sensor that recorded this reading. Used for traceability and calibration tracking.' ;
    rdfs:domain ind:OperationalReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastCalibrationDate rdf:type rdf:Property ;
    rdfs:label 'Last Calibration Date' ;
    rdfs:comment 'The date when the measurement instrument was last calibrated, ensuring the reading accuracy and reliability.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:measurementLocationDescription rdf:type rdf:Property ;
    rdfs:label 'Measurement Location Description' ;
    rdfs:comment 'Textual description of the specific physical location or component on the asset where the measurement was taken (e.g., top oil temperature sensor, phase A bushing, inlet valve, bearing housing).' ;
    rdfs:domain ind:OperationalReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measurementMethodCode rdf:type rdf:Property ;
    rdfs:label 'Measurement Method Code' ;
    rdfs:comment 'The method or frequency by which this measurement is captured (continuous real-time monitoring, periodic manual reading, scheduled automated collection, on-demand measurement, condition-based trigger).' ;
    rdfs:domain ind:OperationalReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measurementNotes rdf:type rdf:Property ;
    rdfs:label 'Measurement Notes' ;
    rdfs:comment 'Free-text field for technician or system comments regarding the measurement, including observations, anomalies, or contextual information relevant to interpretation.' ;
    rdfs:domain ind:OperationalReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measurementQualityCode rdf:type rdf:Property ;
    rdfs:label 'Measurement Quality Code' ;
    rdfs:comment 'Quality indicator for the operational reading reflecting data integrity, sensor health, and reliability of the measurement (good, questionable, bad, substituted value, estimated value, calibration required).' ;
    rdfs:domain ind:OperationalReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measurementSource rdf:type rdf:Property ;
    rdfs:label 'Measurement Source' ;
    rdfs:comment 'The system or method by which the operational reading was captured (SCADA system, OSIsoft PI Historian, manual field reading by technician, laboratory analysis, Distribution Management System, Energy Management System, IoT sensor, portable field instrument). [ENUM-REF-CANDIDATE: SCADA|PI_HISTORIAN|MANUAL_FIELD|LAB_ANALYSIS|DMS|EMS|SENSOR_IOT|PORTABLE_INSTRUMENT — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measurementTimestamp rdf:type rdf:Property ;
    rdfs:label 'Measurement Timestamp' ;
    rdfs:comment 'The precise date and time when the operational measurement was recorded or observed in the field or by the monitoring system.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:measurementTypeCode rdf:type rdf:Property ;
    rdfs:label 'Measurement Type Code' ;
    rdfs:comment 'Standardized code identifying the type of operational measurement being recorded (transformer loading percentage, oil temperature, dissolved gas analysis parts per million, cable insulation resistance megaohms, gas pipeline pressure pounds per square inch, vibration level, battery state-of-charge, voltage, current, power factor, frequency, flow rate). [ENUM-REF-CANDIDATE: XFMR_LOAD_PCT|OIL_TEMP|DGA_PPM|CABLE_INSUL_RESIST|GAS_PRESSURE|VIBRATION|BATTERY_SOC|VOLTAGE|CURRENT|POWER_FACTOR|FREQUENCY|FLOW_RATE — 12 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:OperationalReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operatingConditionCode rdf:type rdf:Property ;
    rdfs:label 'Operating Condition Code' ;
    rdfs:comment 'Code describing the operational state or load condition of the asset at the time the measurement was taken (normal load, peak load, off-peak, startup, shutdown, maintenance mode, emergency operation, testing). [ENUM-REF-CANDIDATE: NORMAL_LOAD|PEAK_LOAD|OFF_PEAK|STARTUP|SHUTDOWN|MAINTENANCE|EMERGENCY|TESTING — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:OperationalReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:piTagName rdf:type rdf:Property ;
    rdfs:label 'Pi Tag Name' ;
    rdfs:comment 'The OSIsoft PI Historian tag name associated with this operational reading, used for time-series data retrieval and historian integration.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readingSequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Reading Sequence Number' ;
    rdfs:comment 'Sequential order number of this reading within a series of measurements for the same asset and measurement type, used for time-series analysis and trend detection.' ;
    rdfs:domain ind:OperationalReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sourceSystemCode rdf:type rdf:Property ;
    rdfs:label 'Source System Code' ;
    rdfs:comment 'Code identifying the originating system of record for this operational reading (Maximo EAM, OSIsoft PI Historian, SCADA, Esri ArcGIS, GE PowerOn DMS, EMS, manual field entry). [ENUM-REF-CANDIDATE: MAXIMO|PI_HISTORIAN|SCADA|GIS|DMS|EMS|MANUAL_ENTRY — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thresholdLowerLimit rdf:type rdf:Property ;
    rdfs:label 'Threshold Lower Limit' ;
    rdfs:comment 'The minimum acceptable value for this measurement type. Values below this threshold may indicate asset degradation or operational risk.' ;
    rdfs:domain ind:OperationalReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:thresholdUpperLimit rdf:type rdf:Property ;
    rdfs:label 'Threshold Upper Limit' ;
    rdfs:comment 'The maximum acceptable value for this measurement type. Values above this threshold may indicate asset stress, overload, or failure risk.' ;
    rdfs:domain ind:OperationalReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:trendDirectionCode rdf:type rdf:Property ;
    rdfs:label 'Trend Direction Code' ;
    rdfs:comment 'Indicator of the trend direction for this measurement type over recent readings (improving, stable, degrading, critical decline). Supports predictive maintenance and early warning systems.' ;
    rdfs:domain ind:OperationalReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unitOfMeasure rdf:type rdf:Property ;
    rdfs:label 'Unit Of Measure' ;
    rdfs:comment 'The unit in which the measurement value is expressed (percent, degrees Celsius, degrees Fahrenheit, parts per million, megaohms, pounds per square inch, millimeters per second, kilovolts, amperes, megawatts, megavolt-amperes reactive, hertz, gallons per minute, cubic feet per minute, bar). [ENUM-REF-CANDIDATE: PCT|DEGC|DEGF|PPM|MOHM|PSI|MMS|KV|AMP|MW|MVAR|HZ|GPM|CFM|BAR — 15 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:weatherConditionCode rdf:type rdf:Property ;
    rdfs:label 'Weather Condition Code' ;
    rdfs:comment 'Weather condition at the time of measurement, relevant for outdoor assets where environmental factors impact performance and readings (clear, rain, snow, wind, extreme heat, extreme cold, storm, fog). [ENUM-REF-CANDIDATE: CLEAR|RAIN|SNOW|WIND|EXTREME_HEAT|EXTREME_COLD|STORM|FOG — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:OperationalReading ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pmScheduleId rdf:type rdf:Property ;
    rdfs:label 'Pm Schedule Id' ;
    rdfs:comment 'Unique identifier for the preventive maintenance schedule record. Primary key.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PmSchedule .

ind:jobPlanId rdf:type rdf:Property ;
    rdfs:label 'Job Plan Id' ;
    rdfs:comment 'Reference to the job plan template that defines the detailed tasks, labor, materials, and procedures for this PM schedule. Links to the Maximo job plan master.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:JobPlan .

ind:annualOpexBudgetAllocation rdf:type rdf:Property ;
    rdfs:label 'Annual Opex Budget Allocation' ;
    rdfs:comment 'Annual Operations and Maintenance (O&M) budget allocated for this PM program, including labor, materials, and contractor costs. Used for O&M budget forecasting and variance analysis.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:autoGenerateWoFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Generate Wo Flag' ;
    rdfs:comment 'Indicates whether work orders should be automatically generated by Maximo when the next due date is reached (true) or require manual creation (false).' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complianceMandatoryFlag rdf:type rdf:Property ;
    rdfs:label 'Compliance Mandatory Flag' ;
    rdfs:comment 'Indicates whether this PM schedule is mandated by regulatory compliance requirements (true) or is a voluntary best-practice program (false).' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:conditionMonitoringRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Condition Monitoring Required Flag' ;
    rdfs:comment 'Indicates whether this PM schedule requires condition monitoring data (e.g., oil analysis, thermography, vibration analysis) to be collected and evaluated as part of the maintenance work.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:conditionThresholdUnit rdf:type rdf:Property ;
    rdfs:label 'Condition Threshold Unit' ;
    rdfs:comment 'Unit of measure for the condition threshold value (e.g., \'kV\', \'inches/second\', \'ppm\', \'degrees C\', \'percent\').' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionThresholdValue rdf:type rdf:Property ;
    rdfs:label 'Condition Threshold Value' ;
    rdfs:comment 'Numeric threshold value that triggers PM work when exceeded (e.g., oil dielectric strength below 30 kV, vibration above 0.5 inches/second). Applicable only for condition-based maintenance strategies.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:crewTypeRequired rdf:type rdf:Property ;
    rdfs:label 'Crew Type Required' ;
    rdfs:comment 'Type of maintenance crew or skill set required to perform this PM work (e.g., \'Substation Electrician\', \'Transmission Line Crew\', \'Gas Technician\', \'Relay Technician\').' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criticalityTier rdf:type rdf:Property ;
    rdfs:label 'Criticality Tier' ;
    rdfs:comment 'Criticality classification of the asset or asset class for this PM schedule: 1 (critical - immediate impact on grid reliability or safety), 2 (essential - significant operational impact), 3 (standard - routine maintenance).' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:estimatedDurationHours rdf:type rdf:Property ;
    rdfs:label 'Estimated Duration Hours' ;
    rdfs:comment 'Estimated labor hours required to complete the PM work, used for workforce scheduling and capacity planning.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedOutageDurationHours rdf:type rdf:Property ;
    rdfs:label 'Estimated Outage Duration Hours' ;
    rdfs:comment 'Estimated duration in hours that the asset will be out of service if an outage is required for this PM work. Used for outage scheduling and customer impact analysis.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:failureModeAddressed rdf:type rdf:Property ;
    rdfs:label 'Failure Mode Addressed' ;
    rdfs:comment 'Primary failure mode or degradation mechanism that this PM schedule is designed to prevent or detect (e.g., \'Insulation Breakdown\', \'Bearing Wear\', \'Corrosion\', \'Contact Erosion\').' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:frequencyInterval rdf:type rdf:Property ;
    rdfs:label 'Frequency Interval' ;
    rdfs:comment 'Numeric interval value for the PM schedule (e.g., 90 for 90 days, 500 for 500 operating hours). Interpretation depends on frequency_type.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:frequencyType rdf:type rdf:Property ;
    rdfs:label 'Frequency Type' ;
    rdfs:comment 'The basis for scheduling PM work: calendar days (fixed interval), operating hours (runtime-based), meter reading (usage-based), condition trigger (sensor/inspection-based), or event-based (after specific events).' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:frequencyUnit rdf:type rdf:Property ;
    rdfs:label 'Frequency Unit' ;
    rdfs:comment 'Unit of measure for the frequency interval (days, weeks, months, years, operating hours, cycles, or events). [ENUM-REF-CANDIDATE: days|weeks|months|years|hours|cycles|events — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Last Completion Date' ;
    rdfs:comment 'Date when the most recent PM work order generated from this schedule was completed. Used to calculate next due date.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastReviewDate rdf:type rdf:Property ;
    rdfs:label 'Last Review Date' ;
    rdfs:comment 'Date when this PM schedule was last reviewed and validated by maintenance planning or asset management personnel.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:leadTimeDays rdf:type rdf:Property ;
    rdfs:label 'Lead Time Days' ;
    rdfs:comment 'Number of days before the next due date that the work order should be generated to allow for planning, scheduling, and resource allocation.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maintenanceStrategyType rdf:type rdf:Property ;
    rdfs:label 'Maintenance Strategy Type' ;
    rdfs:comment 'The strategic maintenance approach applied to this PM schedule: time-based (calendar or meter), condition-based (triggered by asset condition), reliability-centered maintenance (RCM), risk-based, predictive (using analytics), or run-to-failure.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meanTimeBetweenMaintenanceHours rdf:type rdf:Property ;
    rdfs:label 'Mean Time Between Maintenance Hours' ;
    rdfs:comment 'Target mean time between maintenance interventions for this PM schedule, used to optimize maintenance intervals and balance reliability with cost.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:modifiedBy rdf:type rdf:Property ;
    rdfs:label 'Modified By' ;
    rdfs:comment 'User ID or name of the person who last modified this PM schedule record.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Due Date' ;
    rdfs:comment 'Calculated date when the next PM work order should be generated based on frequency interval and last completion date. Drives automatic work order creation in Maximo.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextReviewDate rdf:type rdf:Property ;
    rdfs:label 'Next Review Date' ;
    rdfs:comment 'Scheduled date for the next review of this PM schedule to assess effectiveness and make necessary adjustments.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:outageRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Outage Required Flag' ;
    rdfs:comment 'Indicates whether this PM work requires taking the asset out of service (true) or can be performed while the asset is energized/operational (false). Critical for outage planning and grid reliability.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:planReviewCycleMonths rdf:type rdf:Property ;
    rdfs:label 'Plan Review Cycle Months' ;
    rdfs:comment 'Frequency in months at which this PM schedule should be reviewed and updated to ensure continued effectiveness and alignment with asset performance and regulatory requirements.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pmNumber rdf:type rdf:Property ;
    rdfs:label 'Pm Number' ;
    rdfs:comment 'Business identifier for the PM schedule, externally visible and used in work order generation and maintenance reporting. Equivalent to Maximo PM record number.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorityCode rdf:type rdf:Property ;
    rdfs:label 'Priority Code' ;
    rdfs:comment 'Work priority classification for PM work orders generated from this schedule: emergency (immediate), urgent (within 24 hours), high (within 1 week), medium (within 1 month), low (routine scheduling).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programName rdf:type rdf:Property ;
    rdfs:label 'Program Name' ;
    rdfs:comment 'Descriptive name of the preventive maintenance program (e.g., \'Transformer Annual Inspection\', \'Substation Breaker Quarterly Maintenance\').' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryDriver rdf:type rdf:Property ;
    rdfs:label 'Regulatory Driver' ;
    rdfs:comment 'Regulatory requirement or standard that mandates or influences this PM schedule (e.g., NERC CIP-007, PHMSA Part 192, PUC Order 12345). Multiple drivers separated by semicolons.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiredInspectionFrequency rdf:type rdf:Property ;
    rdfs:label 'Required Inspection Frequency' ;
    rdfs:comment 'Minimum number of inspections or PM executions required per year to maintain regulatory compliance and asset reliability targets.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:safetyPermitRequired rdf:type rdf:Property ;
    rdfs:label 'Safety Permit Required' ;
    rdfs:comment 'Type of safety permit or clearance required for this PM work (e.g., \'Hot Work Permit\', \'Confined Space Entry\', \'Energized Work Permit\', \'Switching Order\'). Multiple permits separated by semicolons.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleStatus rdf:type rdf:Property ;
    rdfs:label 'Schedule Status' ;
    rdfs:comment 'Current lifecycle status of the PM schedule: active (generating work orders), inactive (not generating work orders), suspended (temporarily paused), under_review (being evaluated for changes), retired (no longer in use).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seasonalRestrictionFlag rdf:type rdf:Property ;
    rdfs:label 'Seasonal Restriction Flag' ;
    rdfs:comment 'Indicates whether this PM schedule has seasonal restrictions (true) that limit when work can be performed (e.g., transmission line work restricted during peak demand periods).' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:seasonalRestrictionNotes rdf:type rdf:Property ;
    rdfs:label 'Seasonal Restriction Notes' ;
    rdfs:comment 'Detailed description of seasonal or operational restrictions on when this PM work can be performed (e.g., \'No work during summer peak June-August\', \'Winter access only\').' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:strategyRationale rdf:type rdf:Property ;
    rdfs:label 'Strategy Rationale' ;
    rdfs:comment 'Business justification and reasoning for the selected maintenance strategy, documenting why this approach was chosen for this asset or asset class.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workType rdf:type rdf:Property ;
    rdfs:label 'Work Type' ;
    rdfs:comment 'Primary type of maintenance work performed under this PM schedule: inspection, testing, calibration, lubrication, cleaning, adjustment, component replacement, or major overhaul. [ENUM-REF-CANDIDATE: inspection|testing|calibration|lubrication|cleaning|adjustment|replacement|overhaul — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:balancingAreaId rdf:type rdf:Property ;
    rdfs:label 'Balancing Area Id' ;
    rdfs:comment 'Foreign key linking to gridops.balancing_area. Business justification: Needed for Market Participation and NERC reporting; assets must be assigned to a balancing area to aggregate generation/load and calculate settlements.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BalancingArea .

ind:chartOfAccountsId rdf:type rdf:Property ;
    rdfs:label 'Chart Of Accounts Id' ;
    rdfs:comment 'Foreign key linking to finance.chart_of_accounts. Business justification: Required for financial reporting: each asset must be assigned a Chart of Accounts to post capital expenditures and depreciation in the General Ledger.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ChartOfAccounts .

ind:controlZoneId rdf:type rdf:Property ;
    rdfs:label 'Control Zone Id' ;
    rdfs:comment 'Foreign key linking to gridops.control_zone. Business justification: Operational dispatch and outage coordination require each asset to be mapped to its control zone for SCADA/EMS visibility and reliability analysis.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ControlZone .

ind:dsmProgramId rdf:type rdf:Property ;
    rdfs:label 'Dsm Program Id' ;
    rdfs:comment 'Foreign key linking to engagement.dsm_program. Business justification: REQUIRED: DSM enrollment tracks which assets (e.g., smart meters) participate in each DSM program for incentive calculation.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DsmProgram .

ind:itAssetId rdf:type rdf:Property ;
    rdfs:label 'It Asset Id' ;
    rdfs:comment 'Foreign key linking to technology.it_asset. Business justification: IT Asset Management: link physical asset to IT inventory for depreciation, cost allocation, and compliance reporting (Asset Capitalization Report).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ItAsset .

ind:materialMasterId rdf:type rdf:Property ;
    rdfs:label 'Material Master Id' ;
    rdfs:comment 'Reference to the material master record in the supply chain domain defining technical specifications, procurement details, and material composition for this asset type.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MaterialMaster .

ind:materialMasterId rdf:type rdf:Property ;
    rdfs:label 'Material Material Master Id' ;
    rdfs:comment 'Reference to the material master record in the supply chain domain defining technical specifications, procurement details, and material composition for this asset type.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MaterialMaster .

ind:otAssetId rdf:type rdf:Property ;
    rdfs:label 'Ot Asset Id' ;
    rdfs:comment 'Foreign key linking to technology.ot_asset. Business justification: OT Asset Integration: associate OT device record with master asset registry for lifecycle, compliance, and outage impact analysis (OT Asset Compliance Audit).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OtAsset .

ind:parentAssetRegistryId rdf:type rdf:Property ;
    rdfs:label 'Parent Asset Registry Id' ;
    rdfs:comment 'Reference to the parent asset in a hierarchical asset structure (e.g., a transformer within a substation, a meter on a service point). Nullable for top-level assets.' ;
    rdfs:domain ind:Registry ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Registry .

ind:productProgramId rdf:type rdf:Property ;
    rdfs:label 'Product Program Id' ;
    rdfs:comment 'Foreign key linking to product.product_program. Business justification: Required for the Program Enrollment Tracking report, which records which physical assets participate in incentive programs; utilities need this for regulatory compliance and incentive accounting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProductProgram .

ind:scadaSystemId rdf:type rdf:Property ;
    rdfs:label 'Scada System Id' ;
    rdfs:comment 'Foreign key linking to technology.scada_system. Business justification: SCADA Assignment: each major asset (e.g., substation) is monitored by a specific SCADA system, required for operational monitoring and NERC CIP reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ScadaSystem .

ind:techProjectId rdf:type rdf:Property ;
    rdfs:label 'Tech Project Id' ;
    rdfs:comment 'Foreign key linking to technology.tech_project. Business justification: Technology Project Planning: associate physical assets with technology projects for budgeting, regulatory filing, and portfolio reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TechProject .

ind:vendorId rdf:type rdf:Property ;
    rdfs:label 'Vendor Id' ;
    rdfs:comment 'Foreign key linking to supply.vendor. Business justification: Required for Asset Procurement & Warranty Management; linking each asset to its original supplying vendor enables warranty claim tracking and regulatory reporting of vendor-specific compliance.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:vppAgreementId rdf:type rdf:Property ;
    rdfs:label 'Vpp Agreement Id' ;
    rdfs:comment 'Foreign key linking to engagement.vpp_agreement. Business justification: REQUIRED: VPP operations need to map each DER asset to its VPP agreement for dispatch scheduling and settlement reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:VppAgreement .

ind:acquisitionCost rdf:type rdf:Property ;
    rdfs:label 'Acquisition Cost' ;
    rdfs:comment 'Original acquisition or construction cost of the asset in USD. Forms the basis for depreciation calculations and regulatory asset base reporting to state PUCs.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assetName rdf:type rdf:Property ;
    rdfs:label 'Asset Name' ;
    rdfs:comment 'Human-readable name or title of the asset for identification and reporting purposes.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetTag rdf:type rdf:Property ;
    rdfs:label 'Asset Tag' ;
    rdfs:comment 'Externally-known unique asset identification tag or number assigned to the physical infrastructure asset. Used for field identification and tracking.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetType rdf:type rdf:Property ;
    rdfs:label 'Asset Type' ;
    rdfs:comment 'High-level categorization of the asset type within the utility infrastructure. [ENUM-REF-CANDIDATE: generation_equipment|transmission_line|transmission_tower|distribution_line|distribution_pole|substation_equipment|transformer|circuit_breaker|capacitor_bank|gas_pipeline|gas_regulator|gas_meter|electric_meter|scada_device|protection_relay|switch|recloser|sectionalizer|conductor|cable|other — 21 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capacityUnit rdf:type rdf:Property ;
    rdfs:label 'Capacity Unit' ;
    rdfs:comment 'Unit of measure for the rated capacity value (Megawatt, Megavolt-Ampere, Thousand Cubic Feet, etc.). [ENUM-REF-CANDIDATE: MW|MVA|kVA|kW|MCF|MMCF|GPM|PSI — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Registry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissioningDate rdf:type rdf:Property ;
    rdfs:label 'Commissioning Date' ;
    rdfs:comment 'Date when the asset was commissioned and placed into active service. Marks the start of the operational lifecycle and depreciation period for RAB reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:conditionRating rdf:type rdf:Property ;
    rdfs:label 'Condition Rating' ;
    rdfs:comment 'Qualitative condition rating based on inspection findings and condition score. Used for executive reporting and risk assessment.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criticalityRating rdf:type rdf:Property ;
    rdfs:label 'Criticality Rating' ;
    rdfs:comment 'Business criticality rating indicating the impact of asset failure on operations, customer service, and safety. Drives maintenance prioritization and spare parts inventory.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currentBookValue rdf:type rdf:Property ;
    rdfs:label 'Current Book Value' ;
    rdfs:comment 'Current net book value of the asset after accumulated depreciation. Updated through periodic depreciation runs and used for financial statement reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disposalDate rdf:type rdf:Property ;
    rdfs:label 'Disposal Date' ;
    rdfs:comment 'Date when the retired asset was physically disposed of, sold, or scrapped. Final step in asset lifecycle for accounting closure.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:expectedUsefulLifeYears rdf:type rdf:Property ;
    rdfs:label 'Expected Useful Life Years' ;
    rdfs:comment 'Expected useful life of the asset in years as defined by engineering standards and regulatory depreciation schedules. Used for CAPEX planning and depreciation calculations.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gisFeatureCode rdf:type rdf:Property ;
    rdfs:label 'Gis Feature Code' ;
    rdfs:comment 'Unique identifier in the Esri ArcGIS system linking this asset record to its geospatial feature representation for mapping and spatial analysis.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lifecycleStatus rdf:type rdf:Property ;
    rdfs:label 'Lifecycle Status' ;
    rdfs:comment 'Current state of the asset in its lifecycle from planning through disposal. Critical for operational readiness and maintenance planning. [ENUM-REF-CANDIDATE: planned|ordered|in_transit|installed|commissioned|in_service|standby|out_of_service|retired|disposed — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:manufacturerName rdf:type rdf:Property ;
    rdfs:label 'Manufacturer Name' ;
    rdfs:comment 'Name of the company that manufactured the asset. Critical for warranty tracking and parts procurement.' ;
    rdfs:domain ind:Registry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maximoAssetNumber rdf:type rdf:Property ;
    rdfs:label 'Maximo Asset Number' ;
    rdfs:comment 'Asset number in the Maximo Enterprise Asset Management system. Used for integration and work order management.' ;
    rdfs:domain ind:Registry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelNumber rdf:type rdf:Property ;
    rdfs:label 'Model Number' ;
    rdfs:comment 'Manufacturer model number or designation for the asset. Used for technical specifications lookup and parts compatibility.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operationalStatus rdf:type rdf:Property ;
    rdfs:label 'Operational Status' ;
    rdfs:comment 'Current operational state indicating whether the asset is actively functioning and available for service.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryVoltageKv rdf:type rdf:Property ;
    rdfs:label 'Primary Voltage Kv' ;
    rdfs:comment 'Primary side voltage in kilovolts for transformers and voltage conversion equipment.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ratedCapacity rdf:type rdf:Property ;
    rdfs:label 'Rated Capacity' ;
    rdfs:comment 'Nameplate rated capacity of the asset in its primary unit of measure (MW for generation, MVA for transformers, MCF for gas pipelines, etc.). Critical for load planning and grid operations.' ;
    rdfs:domain ind:Registry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riskScore rdf:type rdf:Property ;
    rdfs:label 'Risk Score' ;
    rdfs:comment 'Quantitative risk score combining probability of failure (condition) and consequence of failure (criticality). Used for asset investment prioritization.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scadaMonitoredFlag rdf:type rdf:Property ;
    rdfs:label 'Scada Monitored Flag' ;
    rdfs:comment 'Indicates whether this asset is monitored by the SCADA system for real-time operational data collection and remote control.' ;
    rdfs:domain ind:Registry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:secondaryVoltageKv rdf:type rdf:Property ;
    rdfs:label 'Secondary Voltage Kv' ;
    rdfs:comment 'Secondary side voltage in kilovolts for transformers and voltage conversion equipment.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:serialNumber rdf:type rdf:Property ;
    rdfs:label 'Serial Number' ;
    rdfs:comment 'Unique serial number assigned by the manufacturer to this specific asset unit. Critical for warranty claims and asset tracking.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:voltageClassKv rdf:type rdf:Property ;
    rdfs:label 'Voltage Class Kv' ;
    rdfs:comment 'Nominal voltage class of the asset in kilovolts. Applicable to electrical assets (transmission lines, transformers, substations). Critical for grid operations and safety compliance.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:warrantyExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Warranty Expiration Date' ;
    rdfs:comment 'Date when the manufacturer warranty coverage expires. Used for maintenance planning and cost forecasting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:riskAssessmentId rdf:type rdf:Property ;
    rdfs:label 'Risk Assessment Id' ;
    rdfs:comment 'Primary key for risk_assessment' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RiskAssessment .

ind:assessorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Assessor Employee Id' ;
    rdfs:comment 'Employee identifier of the person who performed the risk assessment, linking to SAP HR records.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:mitigationWorkOrderId rdf:type rdf:Property ;
    rdfs:label 'Mitigation Work Order Id' ;
    rdfs:comment 'Reference to the Maximo work order created to execute the risk mitigation action, if applicable.' ;
    rdfs:domain ind:RiskAssessment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WorkOrder .

ind:rateCaseFilingId rdf:type rdf:Property ;
    rdfs:label 'Rate Case Filing Id' ;
    rdfs:comment 'Reference identifier for the General Rate Case (GRC) or other regulatory filing that includes this asset risk assessment as justification for capital investment.' ;
    rdfs:domain ind:RiskAssessment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Filing .

ind:regulatoryRateCaseId rdf:type rdf:Property ;
    rdfs:label 'Regulatory Rate Case Id' ;
    rdfs:comment 'Reference identifier for the General Rate Case (GRC) or other regulatory filing that includes this asset risk assessment as justification for capital investment.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RateCase .

ind:assessmentDate rdf:type rdf:Property ;
    rdfs:label 'Assessment Date' ;
    rdfs:comment 'Date when the risk assessment was performed or last updated.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assessmentNotes rdf:type rdf:Property ;
    rdfs:label 'Assessment Notes' ;
    rdfs:comment 'Free-text notes providing additional context, assumptions, data sources, or special considerations for the risk assessment.' ;
    rdfs:domain ind:RiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessorName rdf:type rdf:Property ;
    rdfs:label 'Assessor Name' ;
    rdfs:comment 'Name of the engineer or analyst who performed the risk assessment.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetConditionIndex rdf:type rdf:Property ;
    rdfs:label 'Asset Condition Index' ;
    rdfs:comment 'Numerical index representing the current physical condition of the asset based on inspection findings, test results, and maintenance history. Typically scaled 0-100 where higher values indicate better condition.' ;
    rdfs:domain ind:RiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assetHealthScore rdf:type rdf:Property ;
    rdfs:label 'Asset Health Score' ;
    rdfs:comment 'Overall health score combining condition, performance, and reliability metrics. Used as input to probability of failure calculations.' ;
    rdfs:domain ind:RiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:compositeRiskIndex rdf:type rdf:Property ;
    rdfs:label 'Composite Risk Index' ;
    rdfs:comment 'Overall risk score calculated by combining probability of failure and consequence of failure scores. Typically computed as POF × (weighted sum of COF components). Used for asset prioritization and CAPEX planning.' ;
    rdfs:domain ind:RiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:consequenceOfFailureEnvironmentalScore rdf:type rdf:Property ;
    rdfs:label 'Consequence Of Failure Environmental Score' ;
    rdfs:comment 'Score quantifying the environmental impact if the asset fails, including potential for spills, emissions, contamination, and EPA compliance violations.' ;
    rdfs:domain ind:RiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:consequenceOfFailureFinancialScore rdf:type rdf:Property ;
    rdfs:label 'Consequence Of Failure Financial Score' ;
    rdfs:comment 'Score quantifying the direct and indirect financial impact if the asset fails, including replacement cost, lost revenue, regulatory fines, and emergency response costs.' ;
    rdfs:domain ind:RiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:consequenceOfFailureReliabilityScore rdf:type rdf:Property ;
    rdfs:label 'Consequence Of Failure Reliability Score' ;
    rdfs:comment 'Score quantifying the reliability and service continuity impact if the asset fails, including effects on SAIDI, SAIFI, and customer interruptions.' ;
    rdfs:domain ind:RiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:consequenceOfFailureSafetyScore rdf:type rdf:Property ;
    rdfs:label 'Consequence Of Failure Safety Score' ;
    rdfs:comment 'Score quantifying the safety impact if the asset fails, including risk to personnel, public safety, and OSHA compliance exposure.' ;
    rdfs:domain ind:RiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:criticalityScore rdf:type rdf:Property ;
    rdfs:label 'Criticality Score' ;
    rdfs:comment 'Score representing the importance of the asset to system operations, based on number of customers served, load magnitude, redundancy availability, and strategic importance.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customersAtRiskCount rdf:type rdf:Property ;
    rdfs:label 'Customers At Risk Count' ;
    rdfs:comment 'Number of customers who would be affected by failure of this asset. Key input to consequence of failure reliability scoring and regulatory reporting.' ;
    rdfs:domain ind:RiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:estimatedFailureCostUsd rdf:type rdf:Property ;
    rdfs:label 'Estimated Failure Cost Usd' ;
    rdfs:comment 'Estimated total cost in USD if the asset fails, including emergency response, lost revenue, regulatory fines, customer compensation, and reputational damage.' ;
    rdfs:domain ind:RiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedReplacementCostUsd rdf:type rdf:Property ;
    rdfs:label 'Estimated Replacement Cost Usd' ;
    rdfs:comment 'Estimated cost in USD to replace the asset with equivalent functionality, including equipment, labor, engineering, and project management. Used for consequence of failure financial scoring and CAPEX planning.' ;
    rdfs:domain ind:RiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:loadAtRiskMw rdf:type rdf:Property ;
    rdfs:label 'Load At Risk Mw' ;
    rdfs:comment 'Total electrical load in megawatts that would be interrupted if this asset fails. Used for consequence of failure reliability calculations.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:loadingFactorPercent rdf:type rdf:Property ;
    rdfs:label 'Loading Factor Percent' ;
    rdfs:comment 'Percentage of rated capacity at which the asset is currently operating. High loading accelerates aging and increases failure probability.' ;
    rdfs:domain ind:RiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mitigationActionRecommended rdf:type rdf:Property ;
    rdfs:label 'Mitigation Action Recommended' ;
    rdfs:comment 'Recommended action to mitigate the identified risk, such as accelerated replacement, enhanced monitoring, load transfer, preventive maintenance upgrade, or operational restrictions.' ;
    rdfs:domain ind:RiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mitigationPriority rdf:type rdf:Property ;
    rdfs:label 'Mitigation Priority' ;
    rdfs:comment 'Priority level for executing the recommended mitigation action based on risk tier, asset criticality, and available resources.' ;
    rdfs:domain ind:RiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mitigationStatus rdf:type rdf:Property ;
    rdfs:label 'Mitigation Status' ;
    rdfs:comment 'Current status of the risk mitigation action execution.' ;
    rdfs:domain ind:RiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:probabilityOfFailureScore rdf:type rdf:Property ;
    rdfs:label 'Probability Of Failure Score' ;
    rdfs:comment 'Numerical score representing the likelihood that the asset will fail within a defined time horizon. Typically scaled 0-100 or 0-10 depending on methodology.' ;
    rdfs:domain ind:RiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryJustificationFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Justification Flag' ;
    rdfs:comment 'Indicates whether this risk assessment is being used to justify capital investment in a rate case filing with the PUC or other regulatory body.' ;
    rdfs:domain ind:RiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reviewDate rdf:type rdf:Property ;
    rdfs:label 'Review Date' ;
    rdfs:comment 'Date when the risk assessment was reviewed and approved by management or engineering leadership.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:riskDriverPrimary rdf:type rdf:Property ;
    rdfs:label 'Risk Driver Primary' ;
    rdfs:comment 'The dominant factor contributing to the asset\'s risk profile (asset age, physical condition, operational loading, environmental exposure, criticality of served load, or technological obsolescence).' ;
    rdfs:domain ind:RiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskDriverSecondary rdf:type rdf:Property ;
    rdfs:label 'Risk Driver Secondary' ;
    rdfs:comment 'The secondary factor contributing to the asset\'s risk profile. Provides additional context for risk mitigation planning.' ;
    rdfs:domain ind:RiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskTier rdf:type rdf:Property ;
    rdfs:label 'Risk Tier' ;
    rdfs:comment 'Categorical classification of the asset risk level based on the composite risk index. Used to prioritize maintenance, replacement, and capital investment decisions.' ;
    rdfs:domain ind:RiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetMitigationDate rdf:type rdf:Property ;
    rdfs:label 'Target Mitigation Date' ;
    rdfs:comment 'Target date by which the recommended mitigation action should be completed to reduce risk to acceptable levels.' ;
    rdfs:domain ind:RiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:billingAccountId rdf:type rdf:Property ;
    rdfs:label 'Billing Account Id' ;
    rdfs:comment 'Foreign key linking to billing.billing_account. Business justification: Work orders for customer-initiated service are billed to the customer’s account; linking enables invoice generation and revenue recognition per work order.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BillingAccount .

ind:ciAccountId rdf:type rdf:Property ;
    rdfs:label 'Ci Account Id' ;
    rdfs:comment 'Foreign key linking to engagement.ci_account. Business justification: REQUIRED: Service Order Management ties each work order to the customer account for billing, SLA tracking, and the Service Order Report.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CiAccount .

ind:closedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Closed By Employee Id' ;
    rdfs:comment 'Foreign key reference to the user who closed the work order. Indicates final review and acceptance of completed work.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:itServiceId rdf:type rdf:Property ;
    rdfs:label 'It Service Id' ;
    rdfs:comment 'Foreign key linking to technology.it_service. Business justification: IT Service Work Orders: track work orders that pertain to IT services, needed for ITSM KPI and SLA reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ItService .

ind:parentWorkOrderId rdf:type rdf:Property ;
    rdfs:label 'Parent Work Order Id' ;
    rdfs:comment 'Foreign key reference to the parent work order if this is a child or sub-task work order. Supports hierarchical project breakdown for capital projects.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WorkOrder .

ind:primaryWorkTechnicianId rdf:type rdf:Property ;
    rdfs:label 'Primary Work Technician Id' ;
    rdfs:comment 'Foreign key reference to the supervisor or foreman responsible for overseeing work order execution. Links to workforce management system.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Technician .

ind:safetyProgramId rdf:type rdf:Property ;
    rdfs:label 'Safety Program Id' ;
    rdfs:comment 'Foreign key linking to safety.safety_program. Business justification: Work orders must reference the applicable safety program (e.g., lockout/tagout) to ensure required safety procedures are followed and documented.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SafetyProgram .

ind:tertiaryWorkClosedByTechnicianId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Work Closed By Technician Id' ;
    rdfs:comment 'Foreign key reference to the user who closed the work order. Indicates final review and acceptance of completed work.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Technician .

ind:actualFinishTimestamp rdf:type rdf:Property ;
    rdfs:label 'Actual Finish Timestamp' ;
    rdfs:comment 'Actual date and time when work order execution was completed. Used to calculate actual duration and labor hours for cost accounting.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:actualLaborHours rdf:type rdf:Property ;
    rdfs:label 'Actual Labor Hours' ;
    rdfs:comment 'Total labor hours actually expended on the work order. Captured from time entry system for cost accounting and productivity analysis.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualMaterialCost rdf:type rdf:Property ;
    rdfs:label 'Actual Material Cost' ;
    rdfs:comment 'Total cost of materials and parts actually consumed on the work order. Captured from inventory transactions in SAP MM for cost accounting.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Actual Start Timestamp' ;
    rdfs:comment 'Actual date and time when work order execution began. Captured from crew mobile device or workforce management system for labor tracking.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:actualTotalCost rdf:type rdf:Property ;
    rdfs:label 'Actual Total Cost' ;
    rdfs:comment 'Total cost actually incurred for the work order. Captured from SAP ERP for financial reporting and Regulatory Asset Base (RAB) reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approvedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Approved Timestamp' ;
    rdfs:comment 'Date and time when the work order was approved for execution. Marks transition from draft to scheduled status in workflow.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:capitalizedFlag rdf:type rdf:Property ;
    rdfs:label 'Capitalized Flag' ;
    rdfs:comment 'Indicates whether work order costs are capitalized to the Regulatory Asset Base (RAB) or expensed as Operations and Maintenance (O&M). Determines financial accounting treatment.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:closedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Closed Timestamp' ;
    rdfs:comment 'Date and time when the work order was closed. Marks completion of all work and administrative tasks for cost accounting finalization.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:estimatedLaborHours rdf:type rdf:Property ;
    rdfs:label 'Estimated Labor Hours' ;
    rdfs:comment 'Planned total labor hours required to complete the work order. Used for crew scheduling and OPEX budget planning.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedMaterialCost rdf:type rdf:Property ;
    rdfs:label 'Estimated Material Cost' ;
    rdfs:comment 'Planned total cost of materials and parts required for the work order. Used for supply chain requisition and budget planning.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedTotalCost rdf:type rdf:Property ;
    rdfs:label 'Estimated Total Cost' ;
    rdfs:comment 'Planned total cost of the work order including labor, materials, equipment, and contractor costs. Used for budget authorization and CAPEX/OPEX planning.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:failureCode rdf:type rdf:Property ;
    rdfs:label 'Failure Code' ;
    rdfs:comment 'Standardized code identifying the type of asset failure or condition that triggered corrective maintenance. Used for reliability analysis and failure mode tracking.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originatingSource rdf:type rdf:Property ;
    rdfs:label 'Originating Source' ;
    rdfs:comment 'System or business process that initiated the work order. Identifies root cause trigger for maintenance activity and supports reliability analysis.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:permitRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Permit Required Flag' ;
    rdfs:comment 'Indicates whether regulatory or municipal permits are required before work can begin. Triggers permit acquisition workflow.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:plannedFinishDate rdf:type rdf:Property ;
    rdfs:label 'Planned Finish Date' ;
    rdfs:comment 'Scheduled date when work order execution is planned to be completed. Used for outage duration planning and customer communication.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:plannedStartDate rdf:type rdf:Property ;
    rdfs:label 'Planned Start Date' ;
    rdfs:comment 'Scheduled date when work order execution is planned to begin. Used for resource planning and outage coordination.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:problemDescription rdf:type rdf:Property ;
    rdfs:label 'Problem Description' ;
    rdfs:comment 'Detailed description of the asset problem or condition observed. Captured from inspection findings, SCADA alarms, or customer complaints.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Compliance Flag' ;
    rdfs:comment 'Indicates whether this work order is required for regulatory compliance (NERC CIP, FERC, PUC mandates). Used for compliance reporting and audit trails.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:resolutionDescription rdf:type rdf:Property ;
    rdfs:label 'Resolution Description' ;
    rdfs:comment 'Detailed description of the corrective actions taken and work performed. Captured by crew upon work order completion for maintenance history.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:safetyPlanRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Safety Plan Required Flag' ;
    rdfs:comment 'Indicates whether a formal safety plan is required for work order execution. Triggers safety review and OSHA compliance documentation.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:workOrderDescription rdf:type rdf:Property ;
    rdfs:label 'Work Order Description' ;
    rdfs:comment 'Detailed narrative description of the work to be performed. Includes scope, safety considerations, and special instructions for crew execution.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Work Order Number' ;
    rdfs:comment 'Externally-known business identifier for the work order. Human-readable unique number assigned by Maximo for tracking and reference across systems.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workOrderStatus rdf:type rdf:Property ;
    rdfs:label 'Work Order Status' ;
    rdfs:comment 'Current lifecycle state of the work order in the Maximo workflow. Tracks progression from creation through execution to closure. [ENUM-REF-CANDIDATE: draft|approved|scheduled|in_progress|on_hold|completed|closed|cancelled — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workOrderTaskId rdf:type rdf:Property ;
    rdfs:label 'Work Order Task Id' ;
    rdfs:comment 'Unique identifier for the work order task. Primary key.' ;
    rdfs:domain ind:WorkOrderTask ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:crewId rdf:type rdf:Property ;
    rdfs:label 'Crew Id' ;
    rdfs:comment 'Foreign key reference to the crew assigned to this task. Null if task is assigned to an individual technician rather than a crew.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Crew .

ind:actualCost rdf:type rdf:Property ;
    rdfs:label 'Actual Cost' ;
    rdfs:comment 'Actual total cost incurred for this task. Calculated from time entries, material issues, and equipment charges. Used for Regulatory Asset Base (RAB) reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualDurationHours rdf:type rdf:Property ;
    rdfs:label 'Actual Duration Hours' ;
    rdfs:comment 'Actual elapsed time (clock hours) from task start to completion. Used for schedule performance analysis.' ;
    rdfs:domain ind:WorkOrderTask ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:completionDate rdf:type rdf:Property ;
    rdfs:label 'Completion Date' ;
    rdfs:comment 'Date when the task was marked as completed in the system. May differ from actual_finish_timestamp if there is a delay in system update.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:completionNotes rdf:type rdf:Property ;
    rdfs:label 'Completion Notes' ;
    rdfs:comment 'Summary notes documenting task completion status, results, or any deviations from the planned procedure. Used for audit trail and knowledge management.' ;
    rdfs:domain ind:WorkOrderTask ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:craftCode rdf:type rdf:Property ;
    rdfs:label 'Craft Code' ;
    rdfs:comment 'Code identifying the skilled trade or craft required to perform this task (e.g., ELEC for electrician, MECH for mechanic, LINEMAN for line worker, RELAY for relay technician).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedCost rdf:type rdf:Property ;
    rdfs:label 'Estimated Cost' ;
    rdfs:comment 'Estimated total cost for this task including labor, materials, and equipment. Used for budget planning and Capital Expenditure (CAPEX) tracking.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isMandatory rdf:type rdf:Property ;
    rdfs:label 'Is Mandatory' ;
    rdfs:comment 'Indicates whether this task must be completed for the work order to be considered complete. True for mandatory tasks, false for optional tasks.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSafetyCritical rdf:type rdf:Property ;
    rdfs:label 'Is Safety Critical' ;
    rdfs:comment 'Indicates whether this task involves safety-critical procedures requiring special permits, lockout/tagout, or safety oversight. True for safety-critical tasks.' ;
    rdfs:domain ind:WorkOrderTask ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outageRequired rdf:type rdf:Property ;
    rdfs:label 'Outage Required' ;
    rdfs:comment 'Indicates whether this task requires taking equipment or circuits out of service. True for tasks requiring planned outages.' ;
    rdfs:domain ind:WorkOrderTask ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:permitNumber rdf:type rdf:Property ;
    rdfs:label 'Permit Number' ;
    rdfs:comment 'Reference number of the work permit associated with this task. Null if no permit is required.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:permitRequired rdf:type rdf:Property ;
    rdfs:label 'Permit Required' ;
    rdfs:comment 'Indicates whether a work permit (e.g., hot work permit, confined space permit, switching permit) is required before this task can begin.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scheduledFinishDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Finish Date' ;
    rdfs:comment 'Planned date when this task is scheduled to be completed. Used for project planning and outage coordination.' ;
    rdfs:domain ind:WorkOrderTask ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:scheduledStartDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Start Date' ;
    rdfs:comment 'Planned date when this task is scheduled to begin. Used for workforce planning and resource allocation.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:skillLevel rdf:type rdf:Property ;
    rdfs:label 'Skill Level' ;
    rdfs:comment 'Required skill or certification level for the craft performing this task. Ensures qualified personnel are assigned.' ;
    rdfs:domain ind:WorkOrderTask ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taskDescription rdf:type rdf:Property ;
    rdfs:label 'Task Description' ;
    rdfs:comment 'Detailed description of the work to be performed in this task. May include specific instructions, safety requirements, or procedural steps (e.g., \'Perform transformer oil sampling and analysis\', \'Test relay protection settings\').' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taskNumber rdf:type rdf:Property ;
    rdfs:label 'Task Number' ;
    rdfs:comment 'Business identifier for the task within the work order. Often formatted as a sequence or step number (e.g., 10, 20, 30 or 1.1, 1.2).' ;
    rdfs:domain ind:WorkOrderTask ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taskSequence rdf:type rdf:Property ;
    rdfs:label 'Task Sequence' ;
    rdfs:comment 'Numeric ordering of the task within the work order. Determines the execution order of tasks in multi-step maintenance procedures.' ;
    rdfs:domain ind:WorkOrderTask ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:taskStatus rdf:type rdf:Property ;
    rdfs:label 'Task Status' ;
    rdfs:comment 'Current lifecycle status of the task. Tracks progression through the task workflow.' ;
    rdfs:domain ind:WorkOrderTask ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taskType rdf:type rdf:Property ;
    rdfs:label 'Task Type' ;
    rdfs:comment 'Classification of the task by work type. Determines the nature of the work activity.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:technicianNotes rdf:type rdf:Property ;
    rdfs:label 'Technician Notes' ;
    rdfs:comment 'Free-text notes entered by the technician during or after task completion. May include observations, issues encountered, or recommendations for future work.' ;
    rdfs:domain ind:WorkOrderTask ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adjustmentId rdf:type rdf:Property ;
    rdfs:label 'Adjustment Id' ;
    rdfs:comment 'System-generated unique identifier for the adjustment transaction.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Adjustment .

ind:customerAccountId rdf:type rdf:Property ;
    rdfs:label 'Customer Account Id' ;
    rdfs:comment 'Identifier of the customer account to which the adjustment applies.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CustomerAccount .

ind:customerAccountId rdf:type rdf:Property ;
    rdfs:label 'Customer Customer Account Id' ;
    rdfs:comment 'Identifier of the customer account to which the adjustment applies.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CustomerAccount .

ind:incidentId rdf:type rdf:Property ;
    rdfs:label 'Incident Id' ;
    rdfs:comment 'Foreign key linking to safety.incident. Business justification: Billing adjustments often arise from safety incidents (damage compensation); linking adjustment to incident enables traceability for audit and regulatory reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Incident .

ind:personId rdf:type rdf:Property ;
    rdfs:label 'Person Id' ;
    rdfs:comment 'Identifier of the employee who approved the adjustment.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Person .

ind:relatedBillCycleBillingCycleId rdf:type rdf:Property ;
    rdfs:label 'Related Bill Cycle Billing Cycle Id' ;
    rdfs:comment 'Identifier of the billing cycle to which the adjustment belongs.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Cycle .

ind:relatedBillCycleId rdf:type rdf:Property ;
    rdfs:label 'Related Bill Cycle Id' ;
    rdfs:comment 'Identifier of the billing cycle to which the adjustment belongs.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Cycle .

ind:relatedBillId rdf:type rdf:Property ;
    rdfs:label 'Related Bill Id' ;
    rdfs:comment 'Identifier of the invoice that the adjustment offsets.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Bill .

ind:relatedInvoiceBillId rdf:type rdf:Property ;
    rdfs:label 'Related Invoice Bill Id' ;
    rdfs:comment 'Identifier of the invoice that the adjustment offsets.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Bill .

ind:reliabilityEventId rdf:type rdf:Property ;
    rdfs:label 'Reliability Event Id' ;
    rdfs:comment 'Foreign key linking to gridops.reliability_event. Business justification: Reliability Event Settlement Adjustment: adjustments recorded on bills to reflect penalties or credits from reliability events per NERC reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ReliabilityEvent .

ind:transmissionOutageId rdf:type rdf:Property ;
    rdfs:label 'Transmission Outage Id' ;
    rdfs:comment 'Foreign key linking to transmission.transmission_outage. Business justification: Outage Compensation Adjustments: adjustments are created to credit customers for transmission outages, requiring a link to the specific outage event.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TransmissionOutage .

ind:adjustmentCategory rdf:type rdf:Property ;
    rdfs:label 'Adjustment Category' ;
    rdfs:comment 'High-level category such as regulatory, customer service, or accounting.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adjustmentNumber rdf:type rdf:Property ;
    rdfs:label 'Adjustment Number' ;
    rdfs:comment 'Business-visible adjustment number assigned by the billing system.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adjustmentStatus rdf:type rdf:Property ;
