    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reliabilitySaidi rdf:type rdf:Property ;
    rdfs:label 'Reliability Saidi' ;
    rdfs:comment 'System Average Interruption Duration Index for the service point (hours).' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reliabilitySaifi rdf:type rdf:Property ;
    rdfs:label 'Reliability Saifi' ;
    rdfs:comment 'System Average Interruption Frequency Index for the service point (interruptions per year).' ;
