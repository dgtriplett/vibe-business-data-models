ind:nercBesClassification rdf:type rdf:Property ;
    rdfs:label 'Nerc Bes Classification' ;
    rdfs:comment 'Indicates whether the line is part of the Bulk Electric System as defined by NERC.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outOfServiceDate rdf:type rdf:Property ;
    rdfs:label 'Out Of Service Date' ;
    rdfs:comment 'Date the line was retired or taken out of service (null if still active).' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rightOfWayType rdf:type rdf:Property ;
    rdfs:label 'Right Of Way Type' ;
    rdfs:comment 'Legal type of the corridor in which the line is situated.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thermalRatingMva rdf:type rdf:Property ;
    rdfs:label 'Thermal Rating Mva' ;
    rdfs:comment 'Maximum continuous thermal rating of the line in megavolt-amperes.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lineRatingId rdf:type rdf:Property ;
    rdfs:label 'Line Rating Id' ;
    rdfs:comment 'System-generated unique identifier for each line rating record.' ;
