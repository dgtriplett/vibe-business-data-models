    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capacityMva rdf:type rdf:Property ;
    rdfs:label 'Capacity Mva' ;
    rdfs:comment 'Maximum apparent power the feeder can carry, expressed in megavolt-amps.' ;
