    rdfs:comment 'First day of the NEM banking period covered by this true-up.' ;
    rdfs:domain ind:NemTrueUp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:performanceSummaryId rdf:type rdf:Property ;
    rdfs:label 'Performance Summary Id' ;
