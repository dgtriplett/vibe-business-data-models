ind:ratingMva rdf:type rdf:Property ;
    rdfs:label 'Rating Mva' ;
    rdfs:comment 'Maximum apparent power the line can carry under the specified conditions, expressed in megavolt-amperes.' ;
    rdfs:domain ind:LineRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ratingType rdf:type rdf:Property ;
    rdfs:label 'Rating Type' ;
