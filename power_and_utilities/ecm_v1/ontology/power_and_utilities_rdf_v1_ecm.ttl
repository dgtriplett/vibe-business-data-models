    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratingAmps rdf:type rdf:Property ;
    rdfs:label 'Rating Amps' ;
    rdfs:comment 'Maximum current the line can carry under the specified conditions, expressed in amperes.' ;
