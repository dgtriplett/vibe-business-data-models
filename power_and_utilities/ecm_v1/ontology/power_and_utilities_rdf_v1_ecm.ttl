ind:ieee1366ExclusionFlag rdf:type rdf:Property ;
    rdfs:label 'Ieee 1366 Exclusion Flag' ;
    rdfs:comment 'True if the event is excluded from IEEE 1366 reliability calculations (e.g., major event day).' ;
