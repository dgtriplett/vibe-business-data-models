    rdfs:comment 'Total electricity retail sales in megawatt-hours for the jurisdiction and year.' ;
    rdfs:domain ind:RpsObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:supersededByScheduleTariffScheduleId rdf:type rdf:Property ;
