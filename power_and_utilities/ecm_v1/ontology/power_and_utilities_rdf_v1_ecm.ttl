    rdfs:range xsd:date .

ind:discoveryMethod rdf:type rdf:Property ;
    rdfs:label 'Discovery Method' ;
    rdfs:comment 'How the leak was found: routine survey, customer report, third-party damage, or automated sensor detection.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emergencyResponseRequired rdf:type rdf:Property ;
    rdfs:label 'Emergency Response Required' ;
    rdfs:comment 'True when the leak triggered an emergency response action.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:estimatedRepairCostUsd rdf:type rdf:Property ;
    rdfs:label 'Estimated Repair Cost Usd' ;
    rdfs:comment 'Projected financial cost for leak remediation.' ;
    rdfs:domain ind:GasLeak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedTotalReleaseMcf rdf:type rdf:Property ;
    rdfs:label 'Estimated Total Release Mcf' ;
    rdfs:comment 'Projected cumulative gas volume released before repair.' ;
    rdfs:domain ind:GasLeak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fieldNotes rdf:type rdf:Property ;
    rdfs:label 'Field Notes' ;
    rdfs:comment 'Free-form text capturing observations, challenges, or additional actions taken.' ;
    rdfs:domain ind:GasLeak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gasLeakStatus rdf:type rdf:Property ;
    rdfs:label 'Gas Leak Status' ;
    rdfs:comment 'Current operational status of the leak.' ;
    rdfs:domain ind:GasLeak ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:impactedCustomersCount rdf:type rdf:Property ;
