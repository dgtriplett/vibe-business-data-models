ind:fatalityFlag rdf:type rdf:Property ;
    rdfs:label 'Fatality Flag' ;
    rdfs:comment 'True if the incident resulted in a fatality.' ;
    rdfs:domain ind:Incident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fedNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Fed Notification Date' ;
    rdfs:comment 'Date of notification to the federal regulatory agency.' ;
    rdfs:domain ind:Incident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:incidentCategory rdf:type rdf:Property ;
    rdfs:label 'Incident Category' ;
    rdfs:comment 'Broad category describing the nature of the incident.' ;
    rdfs:domain ind:Incident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentNumber rdf:type rdf:Property ;
    rdfs:label 'Incident Number' ;
    rdfs:comment 'Business-visible identifier assigned to the incident (e.g., INC-2023-000123).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentStatus rdf:type rdf:Property ;
    rdfs:label 'Incident Status' ;
    rdfs:comment 'Current workflow status of the incident record.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Incident Timestamp' ;
    rdfs:comment 'Date and time when the incident actually occurred.' ;
    rdfs:domain ind:Incident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:incidentType rdf:type rdf:Property ;
    rdfs:label 'Incident Type' ;
    rdfs:comment 'Classification of the incident (e.g., slip, equipment failure, chemical release).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:injuryBodyPart rdf:type rdf:Property ;
    rdfs:label 'Injury Body Part' ;
    rdfs:comment 'Body part(s) affected by the injury.' ;
    rdfs:domain ind:Incident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:injurySeverity rdf:type rdf:Property ;
    rdfs:label 'Injury Severity' ;
    rdfs:comment 'Severity rating of the injury based on medical assessment.' ;
    rdfs:domain ind:Incident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:injuryType rdf:type rdf:Property ;
    rdfs:label 'Injury Type' ;
    rdfs:comment 'Classification of injury severity for the affected individual.' ;
    rdfs:domain ind:Incident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investigationCompleteDate rdf:type rdf:Property ;
    rdfs:label 'Investigation Complete Date' ;
    rdfs:comment 'Date when the investigation was formally closed.' ;
    rdfs:domain ind:Incident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:investigationStatus rdf:type rdf:Property ;
    rdfs:label 'Investigation Status' ;
    rdfs:comment 'Current status of the incident investigation.' ;
    rdfs:domain ind:Incident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isOshaRecordable rdf:type rdf:Property ;
    rdfs:label 'Is Osha Recordable' ;
    rdfs:comment 'Indicates whether the incident meets OSHA recordability criteria.' ;
    rdfs:domain ind:Incident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isReportedToFed rdf:type rdf:Property ;
    rdfs:label 'Is Reported To Fed' ;
    rdfs:comment 'Indicates if the incident was reported to a federal regulator (e.g., FERC, NERC).' ;
    rdfs:domain ind:Incident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isReportedToPuc rdf:type rdf:Property ;
    rdfs:label 'Is Reported To Puc' ;
    rdfs:comment 'Indicates if the incident was reported to the Public Utility Commission.' ;
    rdfs:domain ind:Incident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lostTimeDays rdf:type rdf:Property ;
    rdfs:label 'Lost Time Days' ;
    rdfs:comment 'Number of workdays lost due to the injury.' ;
    rdfs:domain ind:Incident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:medicalTreatmentRequired rdf:type rdf:Property ;
    rdfs:label 'Medical Treatment Required' ;
    rdfs:comment 'True if medical treatment beyond first aid was required.' ;
    rdfs:domain ind:Incident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nearMissFlag rdf:type rdf:Property ;
    rdfs:label 'Near Miss Flag' ;
    rdfs:comment 'True if the event was a near miss (no injury but potential for harm).' ;
    rdfs:domain ind:Incident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:notificationSentDate rdf:type rdf:Property ;
    rdfs:label 'Notification Sent Date' ;
    rdfs:comment 'Date when required regulatory notification was sent.' ;
    rdfs:domain ind:Incident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:pucNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Puc Notification Date' ;
    rdfs:comment 'Date of notification to the Public Utility Commission.' ;
    rdfs:domain ind:Incident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryNotificationRequired rdf:type rdf:Property ;
    rdfs:label 'Regulatory Notification Required' ;
    rdfs:comment 'Indicates if the incident must be reported to a regulatory agency.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reportTimestamp rdf:type rdf:Property ;
    rdfs:label 'Report Timestamp' ;
    rdfs:comment 'Date and time when the incident was first recorded in the system.' ;
    rdfs:domain ind:Incident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:restrictedDutyDays rdf:type rdf:Property ;
    rdfs:label 'Restricted Duty Days' ;
    rdfs:comment 'Number of days the employee performed restricted duty.' ;
    rdfs:domain ind:Incident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rootCauseSubcategory rdf:type rdf:Property ;
    rdfs:label 'Root Cause Subcategory' ;
    rdfs:comment 'More detailed subcategory describing the specific root cause.' ;
    rdfs:domain ind:Incident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shift rdf:type rdf:Property ;
    rdfs:label 'Shift' ;
    rdfs:comment 'Work shift during which the incident occurred.' ;
    rdfs:domain ind:Incident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:witnessCount rdf:type rdf:Property ;
    rdfs:label 'Witness Count' ;
    rdfs:comment 'Number of witnesses who observed the incident.' ;
    rdfs:domain ind:Incident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:jobHazardAnalysisId rdf:type rdf:Property ;
    rdfs:label 'Job Hazard Analysis Id' ;
    rdfs:comment 'Unique identifier for the job hazard analysis record.' ;
    rdfs:domain ind:JobHazardAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:analystEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Analyst Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: JHA documents are authored by a safety analyst employee; the JHA Analyst Register stores analyst_employee_id.' ;
    rdfs:domain ind:JobHazardAnalysis ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:analysisType rdf:type rdf:Property ;
    rdfs:label 'Analysis Type' ;
    rdfs:comment 'Specifies whether the analysis follows Job Hazard Analysis (JHA) or Job Safety Analysis (JSA) methodology.' ;
    rdfs:domain ind:JobHazardAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approverName rdf:type rdf:Property ;
    rdfs:label 'Approver Name' ;
    rdfs:comment 'Name of the employee who approved the hazard analysis.' ;
    rdfs:domain ind:JobHazardAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorName rdf:type rdf:Property ;
    rdfs:label 'Author Name' ;
    rdfs:comment 'Name of the employee who authored the hazard analysis.' ;
    rdfs:domain ind:Safety ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:controlMeasures rdf:type rdf:Property ;
    rdfs:label 'Control Measures' ;
    rdfs:comment 'Description of engineering or administrative controls to mitigate the hazard.' ;
    rdfs:domain ind:JobHazardAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:department rdf:type rdf:Property ;
    rdfs:label 'Department' ;
    rdfs:comment 'Organizational department responsible for the analysis.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentVersion rdf:type rdf:Property ;
    rdfs:label 'Document Version' ;
    rdfs:comment 'Version identifier of the document (e.g., v1.2).' ;
    rdfs:domain ind:JobHazardAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emergencyProcedure rdf:type rdf:Property ;
    rdfs:label 'Emergency Procedure' ;
    rdfs:comment 'Emergency response procedure applicable to the hazard.' ;
    rdfs:domain ind:JobHazardAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hazardIdentifiedDate rdf:type rdf:Property ;
    rdfs:label 'Hazard Identified Date' ;
    rdfs:comment 'Date when the hazard was initially identified.' ;
    rdfs:domain ind:JobHazardAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:jhaNumber rdf:type rdf:Property ;
    rdfs:label 'Jha Number' ;
    rdfs:comment 'External reference number for the hazard analysis as used in safety documentation.' ;
    rdfs:domain ind:JobHazardAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jobHazardAnalysisStatus rdf:type rdf:Property ;
    rdfs:label 'Job Hazard Analysis Status' ;
    rdfs:comment 'Current lifecycle status of the hazard analysis.' ;
    rdfs:domain ind:JobHazardAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lockoutTagoutRequired rdf:type rdf:Property ;
    rdfs:label 'Lockout Tagout Required' ;
    rdfs:comment 'Indicates if lockout/tagout procedures are required.' ;
    rdfs:domain ind:Safety ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:revisionDate rdf:type rdf:Property ;
    rdfs:label 'Revision Date' ;
    rdfs:comment 'Date of the current revision.' ;
    rdfs:domain ind:JobHazardAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:riskLikelihood rdf:type rdf:Property ;
    rdfs:label 'Risk Likelihood' ;
    rdfs:comment 'Likelihood rating of the hazard occurrence.' ;
    rdfs:domain ind:JobHazardAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskSeverity rdf:type rdf:Property ;
    rdfs:label 'Risk Severity' ;
    rdfs:comment 'Severity rating of the hazard.' ;
    rdfs:domain ind:JobHazardAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:safetyAuditFlag rdf:type rdf:Property ;
    rdfs:label 'Safety Audit Flag' ;
    rdfs:comment 'Flag indicating if the analysis has been audited for safety compliance.' ;
    rdfs:domain ind:JobHazardAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:taskDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Task Duration Minutes' ;
    rdfs:comment 'Estimated duration of the task in minutes.' ;
    rdfs:domain ind:JobHazardAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:taskFrequencyPerYear rdf:type rdf:Property ;
    rdfs:label 'Task Frequency Per Year' ;
    rdfs:comment 'Number of times the task is performed annually.' ;
    rdfs:domain ind:JobHazardAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:trainingRequired rdf:type rdf:Property ;
    rdfs:label 'Training Required' ;
    rdfs:comment 'Indicates if specific training is required for personnel.' ;
    rdfs:domain ind:Safety ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:permitToWorkId rdf:type rdf:Property ;
    rdfs:label 'Permit To Work Id' ;
    rdfs:comment 'System-generated unique identifier for each permit-to-work record.' ;
    rdfs:domain ind:PermitToWork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:authorizedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Authorized By Employee Id' ;
    rdfs:comment 'Identifier of the person who provided final authorization for the work.' ;
    rdfs:domain ind:PermitToWork ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:issuerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Issuer Employee Id' ;
    rdfs:comment 'Identifier of the authorized individual who issued the permit.' ;
    rdfs:domain ind:PermitToWork ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:primaryPermitEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Primary Permit Employee Id' ;
    rdfs:comment 'Identifier of the employee or contractor who requested the permit.' ;
    rdfs:domain ind:PermitToWork ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:tertiaryPermitAuthorizedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Permit Authorized By Employee Id' ;
    rdfs:comment 'Identifier of the person who provided final authorization for the work.' ;
    rdfs:domain ind:PermitToWork ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:areaCode rdf:type rdf:Property ;
    rdfs:label 'Area Code' ;
    rdfs:comment 'Utility service area or grid zone code where the work is located.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceChecklist rdf:type rdf:Property ;
    rdfs:label 'Compliance Checklist' ;
    rdfs:comment 'Serialized list of checklist items completed to satisfy regulatory compliance.' ;
    rdfs:domain ind:PermitToWork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confinedSpaceRequired rdf:type rdf:Property ;
    rdfs:label 'Confined Space Required' ;
    rdfs:comment 'True when the work involves entry into a confined space, triggering additional safety checks.' ;
    rdfs:domain ind:PermitToWork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:equipmentTag rdf:type rdf:Property ;
    rdfs:label 'Equipment Tag' ;
    rdfs:comment 'Asset tag or identifier of equipment involved in the work (e.g., transformer T-1234).' ;
    rdfs:domain ind:PermitToWork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedCostAmount rdf:type rdf:Property ;
    rdfs:label 'Estimated Cost Amount' ;
    rdfs:comment 'Projected monetary cost of the work authorized by the permit.' ;
    rdfs:domain ind:PermitToWork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hazardControls rdf:type rdf:Property ;
    rdfs:label 'Hazard Controls' ;
    rdfs:comment 'List of engineering and administrative controls applied to mitigate identified hazards.' ;
    rdfs:domain ind:PermitToWork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:permitClosureConfirmation rdf:type rdf:Property ;
    rdfs:label 'Permit Closure Confirmation' ;
    rdfs:comment 'Indicates whether the closure was verified by the authorized supervisor.' ;
    rdfs:domain ind:PermitToWork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:permitClosureTimestamp rdf:type rdf:Property ;
    rdfs:label 'Permit Closure Timestamp' ;
    rdfs:comment 'Timestamp when the permit was officially closed after work completion.' ;
    rdfs:domain ind:PermitToWork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:permitToWorkStatus rdf:type rdf:Property ;
    rdfs:label 'Permit To Work Status' ;
    rdfs:comment 'Current lifecycle state of the permit.' ;
    rdfs:domain ind:PermitToWork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:permitValidFrom rdf:type rdf:Property ;
    rdfs:label 'Permit Valid From' ;
    rdfs:comment 'Date and time when the permit becomes effective and work may commence.' ;
    rdfs:domain ind:PermitToWork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:permitValidUntil rdf:type rdf:Property ;
    rdfs:label 'Permit Valid Until' ;
    rdfs:comment 'Date and time after which the permit expires if work has not started.' ;
    rdfs:domain ind:PermitToWork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:safetyMeasures rdf:type rdf:Property ;
    rdfs:label 'Safety Measures' ;
    rdfs:comment 'Specific safety procedures (e.g., PPE, LOTO) required for the work.' ;
    rdfs:domain ind:PermitToWork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workLocation rdf:type rdf:Property ;
    rdfs:label 'Work Location' ;
    rdfs:comment 'Physical location where the permitted work will be performed, e.g., substation name or GPS coordinate.' ;
    rdfs:domain ind:PermitToWork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workRiskLevel rdf:type rdf:Property ;
    rdfs:label 'Work Risk Level' ;
    rdfs:comment 'Risk classification based on hazard analysis for the permitted activity.' ;
    rdfs:domain ind:PermitToWork ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pipelineIntegrityAssessmentId rdf:type rdf:Property ;
    rdfs:label 'Pipeline Integrity Assessment Id' ;
    rdfs:comment 'Unique surrogate key for each pipeline integrity assessment record.' ;
    rdfs:domain ind:PipelineIntegrityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assessmentName rdf:type rdf:Property ;
    rdfs:label 'Assessment Name' ;
    rdfs:comment 'Human-readable name or title for the assessment, often combining segment ID and date.' ;
    rdfs:domain ind:PipelineIntegrityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentNumber rdf:type rdf:Property ;
    rdfs:label 'Assessment Number' ;
    rdfs:comment 'External business identifier assigned to the assessment, used in regulatory filings and internal tracking.' ;
    rdfs:domain ind:PipelineIntegrityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceDueDate rdf:type rdf:Property ;
    rdfs:label 'Compliance Due Date' ;
    rdfs:comment 'Regulatory deadline by which the required repair or mitigation must be completed.' ;
    rdfs:domain ind:PipelineIntegrityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:defectLengthMm rdf:type rdf:Property ;
    rdfs:label 'Defect Length Mm' ;
    rdfs:comment 'Measured length of the defect in millimetres.' ;
    rdfs:domain ind:PipelineIntegrityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:defectSeverity rdf:type rdf:Property ;
    rdfs:label 'Defect Severity' ;
    rdfs:comment 'Severity rating assigned to the defect based on potential impact.' ;
    rdfs:domain ind:PipelineIntegrityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:defectType rdf:type rdf:Property ;
    rdfs:label 'Defect Type' ;
    rdfs:comment 'Category of defect identified during the assessment.' ;
    rdfs:domain ind:PipelineIntegrityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentEndMile rdf:type rdf:Property ;
    rdfs:label 'Segment End Mile' ;
    rdfs:comment 'Ending milepost of the assessed segment.' ;
    rdfs:domain ind:PipelineIntegrityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:segmentStartMile rdf:type rdf:Property ;
    rdfs:label 'Segment Start Mile' ;
    rdfs:comment 'Starting milepost of the assessed segment measured from the pipeline\'s origin.' ;
    rdfs:domain ind:PipelineIntegrityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalDefectLengthMm rdf:type rdf:Property ;
    rdfs:label 'Total Defect Length Mm' ;
    rdfs:comment 'Aggregate length of all defects in the segment, expressed in millimetres.' ;
    rdfs:domain ind:PipelineIntegrityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalDefects rdf:type rdf:Property ;
    rdfs:label 'Total Defects' ;
    rdfs:comment 'Count of distinct defects recorded for the segment during this assessment.' ;
    rdfs:domain ind:PipelineIntegrityAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:complianceRating rdf:type rdf:Property ;
    rdfs:label 'Compliance Rating' ;
    rdfs:comment 'Overall rating indicating the level of compliance identified during the audit.' ;
    rdfs:domain ind:SafetyAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:findingsCritical rdf:type rdf:Property ;
    rdfs:label 'Findings Critical' ;
    rdfs:comment 'Number of findings classified as critical severity.' ;
    rdfs:domain ind:SafetyAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:findingsMajor rdf:type rdf:Property ;
    rdfs:label 'Findings Major' ;
    rdfs:comment 'Number of findings classified as major severity.' ;
    rdfs:domain ind:SafetyAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:findingsMinor rdf:type rdf:Property ;
    rdfs:label 'Findings Minor' ;
    rdfs:comment 'Number of findings classified as minor severity.' ;
    rdfs:domain ind:SafetyAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:findingsObservation rdf:type rdf:Property ;
    rdfs:label 'Findings Observation' ;
    rdfs:comment 'Number of findings classified as observation (non-deficiency).' ;
    rdfs:domain ind:SafetyAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:findingsTotal rdf:type rdf:Property ;
    rdfs:label 'Findings Total' ;
    rdfs:comment 'Total number of findings recorded for the audit.' ;
    rdfs:domain ind:SafetyAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:overallDisposition rdf:type rdf:Property ;
    rdfs:label 'Overall Disposition' ;
    rdfs:comment 'Final disposition of the audit after findings are addressed.' ;
    rdfs:domain ind:SafetyAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:team rdf:type rdf:Property ;
    rdfs:label 'Team' ;
    rdfs:comment 'Names or identifiers of the internal/external auditors who performed the audit.' ;
    rdfs:domain ind:SafetyAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalPenaltyAmount rdf:type rdf:Property ;
    rdfs:label 'Total Penalty Amount' ;
    rdfs:comment 'Aggregate monetary penalties assessed for all findings, expressed in US dollars.' ;
    rdfs:domain ind:SafetyAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:observationId rdf:type rdf:Property ;
    rdfs:label 'Observation Id' ;
    rdfs:comment 'Unique identifier for the safety observation record.' ;
    rdfs:domain ind:Observation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:behaviorDescription rdf:type rdf:Property ;
    rdfs:label 'Behavior Description' ;
    rdfs:comment 'Narrative describing the specific behavior observed.' ;
    rdfs:domain ind:Observation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:observationStatus rdf:type rdf:Property ;
    rdfs:label 'Observation Status' ;
    rdfs:comment 'Current lifecycle status of the observation record.' ;
    rdfs:domain ind:Observation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:observationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Observation Timestamp' ;
    rdfs:comment 'Date and time when the safety observation was made.' ;
    rdfs:domain ind:Observation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:observationType rdf:type rdf:Property ;
    rdfs:label 'Observation Type' ;
    rdfs:comment 'Classification of the observation: safe act, at-risk behavior, safe condition, or unsafe condition.' ;
    rdfs:domain ind:Observation ;
    rdf:type owl:DatatypeProperty ;
