    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tariffScheduleDescription rdf:type rdf:Property ;
    rdfs:label 'Tariff Schedule Description' ;
    rdfs:comment 'Narrative description of the tariff schedule and its purpose.' ;
    rdfs:domain ind:TariffSchedule ;
