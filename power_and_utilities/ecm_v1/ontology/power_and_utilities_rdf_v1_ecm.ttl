ind:leakGrade rdf:type rdf:Property ;
    rdfs:label 'Leak Grade' ;
    rdfs:comment 'Classification of leak severity: Grade 1 (immediate repair), Grade 2 (scheduled), Grade 3 (monitored).' ;
