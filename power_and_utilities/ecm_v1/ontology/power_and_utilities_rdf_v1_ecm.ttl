ind:maintenanceCrewId rdf:type rdf:Property ;
    rdfs:label 'Maintenance Crew Id' ;
    rdfs:comment 'Foreign key linking to workforce.crew. Business justification: Gas-main maintenance is crew-based; crew_id enables work-order assignment, safety tracking, and PHMSA reporting.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Crew .

ind:startNodeId rdf:type rdf:Property ;
    rdfs:label 'Start Node Id' ;
