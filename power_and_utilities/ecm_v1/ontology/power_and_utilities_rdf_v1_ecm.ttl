    rdfs:comment 'Current status of any ongoing maintenance work.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextInspectionDue rdf:type rdf:Property ;
    rdfs:label 'Next Inspection Due' ;
