ind:designPressurePsi rdf:type rdf:Property ;
    rdfs:label 'Design Pressure Psi' ;
    rdfs:comment 'Maximum pressure the pipe was designed to safely contain.' ;
    rdfs:domain ind:GasMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:endNodeCode rdf:type rdf:Property ;
    rdfs:label 'End Node Code' ;
    rdfs:comment 'Identifier of the downstream network node where the gas main terminates.' ;
    rdfs:domain ind:GasMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:gasMainName rdf:type rdf:Property ;
    rdfs:label 'Gas Main Name' ;
    rdfs:comment 'Human-readable name or label for the gas main segment.' ;
    rdfs:domain ind:GasMain ;
    rdf:type owl:DatatypeProperty ;
