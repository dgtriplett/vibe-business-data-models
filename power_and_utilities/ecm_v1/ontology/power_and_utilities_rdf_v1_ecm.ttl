    rdfs:comment 'System-generated unique identifier for the tariff rider record.' ;
    rdfs:domain ind:RegulatoryTariffRider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:parentTariffScheduleId rdf:type rdf:Property ;
