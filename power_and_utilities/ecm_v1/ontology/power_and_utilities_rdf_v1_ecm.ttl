    rdfs:range xsd:string .

ind:tariffScheduleStatus rdf:type rdf:Property ;
    rdfs:label 'Tariff Schedule Status' ;
    rdfs:comment 'Current lifecycle status of the tariff schedule.' ;
    rdfs:domain ind:TariffSchedule ;
