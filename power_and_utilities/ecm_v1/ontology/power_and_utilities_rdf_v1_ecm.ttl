    rdfs:comment 'Chronological log of amendments to the zoning classification, stored as JSON text.' ;
    rdfs:domain ind:ZoningClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zoningClassificationDescription rdf:type rdf:Property ;
    rdfs:label 'Zoning Classification Description' ;
    rdfs:comment 'Narrative description of the zoning classification, including intent and typical applications.' ;
    rdfs:domain ind:ZoningClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zoningClassificationStatus rdf:type rdf:Property ;
    rdfs:label 'Zoning Classification Status' ;
    rdfs:comment 'Current lifecycle status of the zoning classification.' ;
    rdfs:domain ind:ZoningClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryAuditId rdf:type rdf:Property ;
    rdfs:label 'Regulatory Audit Id' ;
    rdfs:comment 'Unique identifier for the regulatory audit record.' ;
    rdfs:domain ind:RegulatoryAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:createdByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Created By Employee Id' ;
    rdfs:comment 'Foreign key linking to workforce.employee. Business justification: Regulatory audits record which employee created the audit entry; this supports audit trail and internal control reporting.' ;
    rdfs:domain ind:RegulatoryAudit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:primaryRegulatoryDocketId rdf:type rdf:Property ;
    rdfs:label 'Primary Regulatory Docket Id' ;
    rdfs:comment 'Identifier of the regulatory docket associated with the audit.' ;
    rdfs:domain ind:RegulatoryAudit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Docket .

ind:primaryRegulatoryFilingId rdf:type rdf:Property ;
    rdfs:label 'Primary Regulatory Filing Id' ;
    rdfs:comment 'Identifier of the regulatory filing tied to the audit.' ;
    rdfs:domain ind:RegulatoryAudit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Filing .

ind:auditCategory rdf:type rdf:Property ;
    rdfs:label 'Audit Category' ;
    rdfs:comment 'Broad classification of the audit focus area.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditScope rdf:type rdf:Property ;
    rdfs:label 'Audit Scope' ;
    rdfs:comment 'Narrative description of the audit scope, including systems, processes, and facilities examined.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceGapSummary rdf:type rdf:Property ;
    rdfs:label 'Compliance Gap Summary' ;
    rdfs:comment 'Summary of identified compliance gaps.' ;
    rdfs:domain ind:RegulatoryAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conductingBody rdf:type rdf:Property ;
    rdfs:label 'Conducting Body' ;
    rdfs:comment 'Organization or agency that performed the audit.' ;
    rdfs:domain ind:RegulatoryAudit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evidenceCount rdf:type rdf:Property ;
    rdfs:label 'Evidence Count' ;
    rdfs:comment 'Number of evidence items attached to the audit.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:finalReportDate rdf:type rdf:Property ;
    rdfs:label 'Final Report Date' ;
    rdfs:comment 'Date the final audit report was released.' ;
