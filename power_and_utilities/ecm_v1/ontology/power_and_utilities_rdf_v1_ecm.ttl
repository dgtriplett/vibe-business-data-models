ind:maintenanceTechnicianId rdf:type rdf:Property ;
    rdfs:label 'Maintenance Technician Id' ;
    rdfs:comment 'Foreign key linking to workforce.technician. Business justification: Routine service-point maintenance is assigned to a specific technician; required for maintenance work orders and reliability KPI tracking.' ;
    rdfs:domain ind:Distribution ;
