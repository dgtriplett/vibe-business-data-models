    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:distributionSwitchingOrderStatus rdf:type rdf:Property ;
    rdfs:label 'Distribution Switching Order Status' ;
    rdfs:comment 'Current lifecycle status of the switching order.' ;
    rdfs:domain ind:DistributionSwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedOutageDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Estimated Outage Duration Minutes' ;
    rdfs:comment 'Projected total outage duration in minutes for the affected customers.' ;
    rdfs:domain ind:DistributionSwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastUpdateTimestamp rdf:type rdf:Property ;
