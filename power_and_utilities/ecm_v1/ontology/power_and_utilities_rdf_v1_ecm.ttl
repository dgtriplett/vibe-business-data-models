    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leakSizeMcfPerDay rdf:type rdf:Property ;
    rdfs:label 'Leak Size Mcf Per Day' ;
    rdfs:comment 'Estimated gas release rate expressed in thousand cubic feet per day.' ;
