ind:sunsetDate rdf:type rdf:Property ;
    rdfs:label 'Sunset Date' ;
    rdfs:comment 'Date on which the rider expires or is scheduled for termination.' ;
    rdfs:domain ind:RegulatoryTariffRider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rpsObligationId rdf:type rdf:Property ;
    rdfs:label 'Rps Obligation Id' ;
    rdfs:comment 'Unique surrogate key for the RPS obligation record.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RpsObligation .

ind:acpAmountPaid rdf:type rdf:Property ;
    rdfs:label 'Acp Amount Paid' ;
    rdfs:comment 'Total dollar amount paid under the alternative compliance payment mechanism for the year.' ;
