    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:distributionOutageEventStatus rdf:type rdf:Property ;
    rdfs:label 'Distribution Outage Event Status' ;
    rdfs:comment 'Current lifecycle status of the outage event.' ;
    rdfs:domain ind:DistributionOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedCustomersAffected rdf:type rdf:Property ;
