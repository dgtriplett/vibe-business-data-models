    rdfs:comment 'Identifier of the downstream structure (pole, vault, etc.) where the span terminates.' ;
    rdfs:domain ind:ConductorSpan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:distributionOutageEventId rdf:type rdf:Property ;
    rdfs:label 'Distribution Outage Event Id' ;
    rdfs:comment 'System-generated unique identifier for the outage event record.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DistributionOutageEvent .

ind:docketId rdf:type rdf:Property ;
    rdfs:label 'Docket Id' ;
    rdfs:comment 'Foreign key linking to regulatory.docket. Business justification: Major outage events are reported in regulatory dockets; linkage enables automated docket creation and status tracking.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Docket .

ind:generationOutageId rdf:type rdf:Property ;
    rdfs:label 'Generation Outage Id' ;
    rdfs:comment 'Foreign key linking to generation.generation_outage. Business justification: Supports Distribution Outage Impact Attribution report, linking each outage event to the upstream generation outage that caused it for regulatory reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GenerationOutage .

ind:incidentTicketId rdf:type rdf:Property ;
    rdfs:label 'Incident Ticket Id' ;
    rdfs:comment 'Foreign key linking to technology.incident_ticket. Business justification: Outage events generate IT incident tickets for resolution tracking and service level reporting.' ;
    rdfs:domain ind:UtilityCompany ;
