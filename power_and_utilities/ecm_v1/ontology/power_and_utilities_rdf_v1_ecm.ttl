ind:executionDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Execution Duration Minutes' ;
    rdfs:comment 'Total elapsed minutes between execution start and end timestamps.' ;
    rdfs:domain ind:TransmissionSwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:executionEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Execution End Timestamp' ;
    rdfs:comment 'Timestamp when the switching order was completed or terminated.' ;
    rdfs:domain ind:TransmissionSwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:executionStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Execution Start Timestamp' ;
    rdfs:comment 'Timestamp when field operators began executing the switching steps.' ;
    rdfs:domain ind:TransmissionSwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:expectedMwChange rdf:type rdf:Property ;
    rdfs:label 'Expected Mw Change' ;
    rdfs:comment 'Projected net change in megawatt load resulting from the switching actions.' ;
    rdfs:domain ind:TransmissionSwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:issuedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Issued Timestamp' ;
    rdfs:comment 'Timestamp when the switching order was formally issued to field operators.' ;
    rdfs:domain ind:TransmissionSwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lastStepExecuted rdf:type rdf:Property ;
    rdfs:label 'Last Step Executed' ;
    rdfs:comment 'Sequence number of the most recent step successfully completed.' ;
    rdfs:domain ind:TransmissionSwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:postTopologyState rdf:type rdf:Property ;
    rdfs:label 'Post Topology State' ;
    rdfs:comment 'Serialized representation of the transmission network topology after execution.' ;
    rdfs:domain ind:TransmissionSwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preTopologyState rdf:type rdf:Property ;
    rdfs:label 'Pre Topology State' ;
    rdfs:comment 'Serialized representation of the transmission network topology before execution.' ;
    rdfs:domain ind:TransmissionSwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:safetyClearanceStatus rdf:type rdf:Property ;
    rdfs:label 'Safety Clearance Status' ;
    rdfs:comment 'Current status of the safety clearance process for the order.' ;
    rdfs:domain ind:TransmissionSwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stepsSequence rdf:type rdf:Property ;
    rdfs:label 'Steps Sequence' ;
    rdfs:comment 'Ordered list of device tags and actions (open/close) encoded as JSON or delimited string.' ;
    rdfs:domain ind:TransmissionSwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalSteps rdf:type rdf:Property ;
    rdfs:label 'Total Steps' ;
    rdfs:comment 'Count of individual switching actions defined in the order.' ;
    rdfs:domain ind:TransmissionSwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:designType rdf:type rdf:Property ;
    rdfs:label 'Design Type' ;
    rdfs:comment 'Indicates whether the transformer follows a standard design, a custom specification, or is a prototype.' ;
    rdfs:domain ind:TransmissionTransformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hasBushingInspection rdf:type rdf:Property ;
    rdfs:label 'Has Bushing Inspection' ;
    rdfs:comment 'Indicates whether the transformer has a documented bushing inspection program (yes/no).' ;
    rdfs:domain ind:TransmissionTransformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:impedancePercent rdf:type rdf:Property ;
    rdfs:label 'Impedance Percent' ;
    rdfs:comment 'Percent impedance of the transformer, representing voltage drop under load.' ;
    rdfs:domain ind:TransmissionTransformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lossesWatts rdf:type rdf:Property ;
    rdfs:label 'Losses Watts' ;
    rdfs:comment 'Typical iron and copper losses under rated load, measured in watts.' ;
    rdfs:domain ind:TransmissionTransformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maintenanceIntervalMonths rdf:type rdf:Property ;
    rdfs:label 'Maintenance Interval Months' ;
    rdfs:comment 'Planned interval between routine maintenance activities, expressed in months.' ;
    rdfs:domain ind:TransmissionTransformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:manufacturerPartNumber rdf:type rdf:Property ;
    rdfs:label 'Manufacturer Part Number' ;
    rdfs:comment 'Part number used by the manufacturer for ordering and warranty.' ;
    rdfs:domain ind:TransmissionTransformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mvaRatingEmergency rdf:type rdf:Property ;
    rdfs:label 'Mva Rating Emergency' ;
    rdfs:comment 'Short-term emergency power rating of the transformer in megavolt-amperes.' ;
    rdfs:domain ind:TransmissionTransformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mvaRatingNormal rdf:type rdf:Property ;
    rdfs:label 'Mva Rating Normal' ;
    rdfs:comment 'Continuous power rating of the transformer in megavolt-amperes under normal operating conditions.' ;
    rdfs:domain ind:TransmissionTransformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nercBesFlag rdf:type rdf:Property ;
    rdfs:label 'Nerc Bes Flag' ;
    rdfs:comment 'Indicates whether the transformer is part of the NERC-defined Bulk Electric System (yes/no).' ;
    rdfs:domain ind:TransmissionTransformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:oilVolumeLiters rdf:type rdf:Property ;
    rdfs:label 'Oil Volume Liters' ;
    rdfs:comment 'Total volume of insulating oil contained in the transformer, measured in liters.' ;
    rdfs:domain ind:TransmissionTransformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ratedShortCircuitCurrentKa rdf:type rdf:Property ;
    rdfs:label 'Rated Short Circuit Current Ka' ;
    rdfs:comment 'Maximum short-circuit current the transformer can safely withstand, expressed in kilo-amperes.' ;
    rdfs:domain ind:TransmissionTransformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tagNumber rdf:type rdf:Property ;
    rdfs:label 'Tag Number' ;
    rdfs:comment 'Unique alphanumeric tag assigned to the transformer for field identification.' ;
    rdfs:domain ind:TransmissionTransformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tapChangerType rdf:type rdf:Property ;
    rdfs:label 'Tap Changer Type' ;
    rdfs:comment 'Type of tap changer installed (step-up, step-down, automatic, regulating).' ;
    rdfs:domain ind:TransmissionTransformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transmissionTransformerStatus rdf:type rdf:Property ;
    rdfs:label 'Transmission Transformer Status' ;
    rdfs:comment 'Current operational status of the transformer.' ;
    rdfs:domain ind:TransmissionTransformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vegetationInspectionId rdf:type rdf:Property ;
    rdfs:label 'Vegetation Inspection Id' ;
    rdfs:comment 'Unique identifier for the vegetation inspection record.' ;
    rdfs:domain ind:VegetationInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:correctiveWorkOrderId rdf:type rdf:Property ;
    rdfs:label 'Corrective Work Order Id' ;
    rdfs:comment 'Reference to the work order created to address findings.' ;
    rdfs:domain ind:VegetationInspection ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WorkOrder .

ind:crewReference rdf:type rdf:Property ;
    rdfs:label 'Crew Reference' ;
    rdfs:comment 'Reference code for the inspection crew.' ;
    rdfs:domain ind:VegetationInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criticalGrowInTrees rdf:type rdf:Property ;
    rdfs:label 'Critical Grow In Trees' ;
    rdfs:comment 'Number of trees identified with high grow-in risk.' ;
    rdfs:domain ind:VegetationInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:flashOverRiskTrees rdf:type rdf:Property ;
    rdfs:label 'Flash Over Risk Trees' ;
    rdfs:comment 'Number of trees posing flash-over risk to transmission lines.' ;
    rdfs:domain ind:VegetationInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lidarDataAvailable rdf:type rdf:Property ;
    rdfs:label 'Lidar Data Available' ;
    rdfs:comment 'Indicates if LiDAR data was captured for this inspection.' ;
    rdfs:domain ind:VegetationInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:numberOfEncroachments rdf:type rdf:Property ;
    rdfs:label 'Number Of Encroachments' ;
    rdfs:comment 'Count of vegetation encroachments found during inspection.' ;
    rdfs:domain ind:VegetationInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:vegetationInspectionStatus rdf:type rdf:Property ;
    rdfs:label 'Vegetation Inspection Status' ;
    rdfs:comment 'Current lifecycle status of the inspection.' ;
    rdfs:domain ind:VegetationInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vegetationType rdf:type rdf:Property ;
    rdfs:label 'Vegetation Type' ;
    rdfs:comment 'Primary type of vegetation observed (e.g., trees, shrubs, grass).' ;
    rdfs:domain ind:VegetationInspection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:absenceId rdf:type rdf:Property ;
    rdfs:label 'Absence Id' ;
    rdfs:comment 'Unique identifier for the workforce absence record. Primary key.' ;
    rdfs:domain ind:Absence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:absenceEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Absence Employee Id' ;
    rdfs:comment 'Identifier of the employee who is absent. Links to the employee master record in SAP HR.' ;
    rdfs:domain ind:Absence ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:absenceReplacementEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Absence Replacement Employee Id' ;
    rdfs:comment 'Identifier of the employee assigned to cover the absent employee\'s shifts or work assignments. Nullable if no replacement assigned.' ;
    rdfs:domain ind:Absence ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:absenceReplacementEmployeeTechnicianId rdf:type rdf:Property ;
    rdfs:label 'Absence Replacement Employee Technician Id' ;
    rdfs:comment 'Identifier of the employee assigned to cover the absent employee\'s shifts or work assignments. Nullable if no replacement assigned.' ;
    rdfs:domain ind:Absence ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Technician .

ind:absenceTechnicianId rdf:type rdf:Property ;
    rdfs:label 'Absence Technician Id' ;
    rdfs:comment 'Identifier of the employee who is absent. Links to the employee master record in SAP HR.' ;
    rdfs:domain ind:Absence ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Technician .

ind:approverTechnicianId rdf:type rdf:Property ;
    rdfs:label 'Approver Technician Id' ;
    rdfs:comment 'Identifier of the supervisor or manager who approved or rejected the absence request.' ;
    rdfs:domain ind:Absence ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Technician .

ind:payrollPeriodId rdf:type rdf:Property ;
    rdfs:label 'Payroll Period Id' ;
    rdfs:comment 'Identifier of the payroll period in which this absence was processed for payment or deduction.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PayrollPeriod .

ind:absenceCategory rdf:type rdf:Property ;
    rdfs:label 'Absence Category' ;
    rdfs:comment 'Classification of the absence as planned (scheduled in advance), unplanned (short-notice or same-day), or emergency (critical unplanned absence requiring immediate coverage).' ;
    rdfs:domain ind:Absence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accrualDeductionHours rdf:type rdf:Property ;
    rdfs:label 'Accrual Deduction Hours' ;
    rdfs:comment 'Number of hours deducted from the employee\'s leave accrual balance (e.g., vacation bank, sick leave bank) for this absence.' ;
    rdfs:domain ind:Absence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:durationDays rdf:type rdf:Property ;
    rdfs:label 'Duration Days' ;
    rdfs:comment 'Total duration of the absence measured in calendar days or working days depending on absence type configuration.' ;
    rdfs:domain ind:Absence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fmlaCaseNumber rdf:type rdf:Property ;
    rdfs:label 'Fmla Case Number' ;
    rdfs:comment 'Case number assigned to FMLA leave requests for tracking compliance with the Family Medical Leave Act. Populated only for FMLA absence types.' ;
    rdfs:domain ind:Absence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:impactOnCrewCoverage rdf:type rdf:Property ;
    rdfs:label 'Impact On Crew Coverage' ;
    rdfs:comment 'Assessment of the operational impact of this absence on crew coverage and service delivery. Critical indicates absence jeopardizes minimum crew requirements or emergency response capability.' ;
    rdfs:domain ind:Absence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:intermittentLeaveFlag rdf:type rdf:Property ;
    rdfs:label 'Intermittent Leave Flag' ;
    rdfs:comment 'Indicates whether this absence is part of an approved intermittent leave arrangement (e.g., recurring FMLA leave taken in separate blocks rather than continuously).' ;
    rdfs:domain ind:Absence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicalCertificationDate rdf:type rdf:Property ;
    rdfs:label 'Medical Certification Date' ;
    rdfs:comment 'The date when medical certification documentation was received and validated.' ;
    rdfs:domain ind:Absence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:medicalCertificationReceivedFlag rdf:type rdf:Property ;
    rdfs:label 'Medical Certification Received Flag' ;
    rdfs:comment 'Indicates whether required medical certification documentation has been received for absences requiring medical justification (e.g., FMLA, extended sick leave, workers compensation).' ;
    rdfs:domain ind:Absence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paidFlag rdf:type rdf:Property ;
    rdfs:label 'Paid Flag' ;
    rdfs:comment 'Indicates whether the absence is paid (true) or unpaid (false). Determines payroll treatment.' ;
    rdfs:domain ind:Absence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:payrollProcessedFlag rdf:type rdf:Property ;
    rdfs:label 'Payroll Processed Flag' ;
    rdfs:comment 'Indicates whether the absence has been processed in payroll for wage deduction or paid leave disbursement.' ;
    rdfs:domain ind:Absence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:replacementRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Replacement Required Flag' ;
    rdfs:comment 'Indicates whether a replacement worker must be scheduled to cover the absent employee\'s duties. True for critical roles or minimum crew requirements.' ;
    rdfs:domain ind:Absence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:returnToWorkClearanceFlag rdf:type rdf:Property ;
    rdfs:label 'Return To Work Clearance Flag' ;
    rdfs:comment 'Indicates whether the employee received medical or safety clearance to return to work following injury, illness, or extended absence. Required for workers compensation and FMLA cases.' ;
    rdfs:domain ind:Absence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:returnToWorkDate rdf:type rdf:Property ;
    rdfs:label 'Return To Work Date' ;
    rdfs:comment 'The actual date when the employee returned to active work status following the absence. May differ from planned end_date.' ;
    rdfs:domain ind:Absence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:scheduledShiftEndTime rdf:type rdf:Property ;
    rdfs:label 'Scheduled Shift End Time' ;
    rdfs:comment 'The originally scheduled end time of the shift or work assignment that the employee missed due to the absence.' ;
    rdfs:domain ind:Absence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:scheduledShiftStartTime rdf:type rdf:Property ;
    rdfs:label 'Scheduled Shift Start Time' ;
    rdfs:comment 'The originally scheduled start time of the shift or work assignment that the employee missed due to the absence.' ;
    rdfs:domain ind:Absence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:stormResponseFlag rdf:type rdf:Property ;
    rdfs:label 'Storm Response Flag' ;
    rdfs:comment 'Indicates whether this absence occurred during a declared storm or emergency response period, impacting crew availability for critical restoration work.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:typeCode rdf:type rdf:Property ;
    rdfs:label 'Type Code' ;
    rdfs:comment 'Code representing the type of absence (e.g., VAC for vacation, SICK for sick leave, FMLA for Family Medical Leave Act, UNION for union leave, JURY for jury duty, MIL for military leave, WC for workers compensation leave, UNPAID for unpaid leave).' ;
    rdfs:domain ind:Absence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:typeName rdf:type rdf:Property ;
    rdfs:label 'Type Name' ;
    rdfs:comment 'Human-readable name of the absence type (e.g., Vacation, Sick Leave, FMLA Leave, Union Business, Jury Duty, Military Leave, Workers Compensation, Unpaid Leave).' ;
    rdfs:domain ind:Absence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unionCode rdf:type rdf:Property ;
    rdfs:label 'Union Code' ;
    rdfs:comment 'Code identifying the labor union to which the employee belongs. Relevant for union leave types and collective bargaining agreement compliance.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workersCompClaimNumber rdf:type rdf:Property ;
    rdfs:label 'Workers Comp Claim Number' ;
    rdfs:comment 'Claim number assigned to workers compensation leave for tracking occupational injury or illness cases. Populated only for workers compensation absence types.' ;
    rdfs:domain ind:Absence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:homeDepotId rdf:type rdf:Property ;
    rdfs:label 'Home Depot Id' ;
    rdfs:comment 'Reference to the facility (depot, garage, or service center) where this crew is based and from which it is typically dispatched. Used for travel-time optimization, vehicle assignment, and storm staging logistics in ClickSoftware WFM.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Depot .

ind:laborRateId rdf:type rdf:Property ;
    rdfs:label 'Labor Rate Id' ;
    rdfs:comment 'Foreign key linking to workforce.labor_rate. Business justification: Crew\'s labor rates are defined in labor_rate table; linking provides accurate rate lookup and removes code column.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LaborRate .

ind:leadEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Lead Employee Id' ;
    rdfs:comment 'Reference to the SAP HR employee record of the designated crew lead (foreman or lead technician) responsible for supervising field operations, safety compliance, and work order sign-off for this crew.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:unionAgreementId rdf:type rdf:Property ;
    rdfs:label 'Union Agreement Id' ;
    rdfs:comment 'Foreign key linking to workforce.union_agreement. Business justification: Crew belongs to a union agreement; linking enables enforcement of labor rules and eliminates redundant code column.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:UnionAgreement .

ind:arcFlashRatingCalCm2 rdf:type rdf:Property ;
    rdfs:label 'Arc Flash Rating Cal Cm2' ;
    rdfs:comment 'Maximum arc flash incident energy rating in calories per square centimeter (cal/cm²) for which this crew\'s PPE is rated. Determines the maximum voltage class and equipment the crew can safely work on. Required for NFPA 70E and OSHA electrical safety compliance.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:avgJobsPerShift rdf:type rdf:Property ;
    rdfs:label 'Avg Jobs Per Shift' ;
    rdfs:comment 'Historical average number of work orders completed by this crew per shift, calculated over a rolling period. Used by ClickSoftware WFM capacity planning and scheduling optimization to set realistic daily job load targets.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:crewCode rdf:type rdf:Property ;
    rdfs:label 'Crew Code' ;
    rdfs:comment 'Externally-known alphanumeric business identifier for the crew unit as assigned in ClickSoftware WFM and referenced in dispatch orders, work orders, and SAP PM. Serves as the BUSINESS_IDENTIFIER for this MASTER_RESOURCE entity.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crewName rdf:type rdf:Property ;
    rdfs:label 'Crew Name' ;
    rdfs:comment 'Human-readable display name of the crew unit (e.g., \'North District Line Crew 4\', \'Gas Distribution Crew 12\'). Serves as the IDENTITY_LABEL for this MASTER_RESOURCE entity. Used in dispatch screens, scheduling boards, and operational reports.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gasOperatorQualified rdf:type rdf:Property ;
    rdfs:label 'Gas Operator Qualified' ;
    rdfs:comment 'Indicates whether this crew holds Operator Qualification (OQ) certification required by PHMSA for performing covered tasks on natural gas distribution and transmission pipelines. True = OQ-certified for gas work.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gisRegionCode rdf:type rdf:Property ;
    rdfs:label 'Gis Region Code' ;
    rdfs:comment 'Esri ArcGIS region code identifying the geographic service territory region where this crew primarily operates. Enables spatial analysis of crew coverage, outage response mapping, and T&D asset maintenance territory alignment.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isEmergencyQualified rdf:type rdf:Property ;
    rdfs:label 'Is Emergency Qualified' ;
    rdfs:comment 'Indicates whether this crew is certified and pre-qualified for emergency storm response and mutual aid dispatch under NERC reliability standards and state PUC emergency response plans. True = eligible for emergency activation.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isMutualAidEligible rdf:type rdf:Property ;
    rdfs:label 'Is Mutual Aid Eligible' ;
    rdfs:comment 'Indicates whether this crew can be deployed to assist other utilities under mutual aid agreements (e.g., EEI Mutual Assistance Program). Distinct from internal emergency qualification — mutual aid requires additional credentialing and travel authorization.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastSafetyAuditDate rdf:type rdf:Property ;
    rdfs:label 'Last Safety Audit Date' ;
    rdfs:comment 'Date of the most recent safety audit or field safety observation conducted for this crew. Used to track compliance with internal safety management programs and OSHA recordkeeping requirements.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:maxTravelRadiusMiles rdf:type rdf:Property ;
    rdfs:label 'Max Travel Radius Miles' ;
    rdfs:comment 'Maximum distance in miles this crew is authorized or contractually permitted to travel from their home depot for a standard (non-emergency) dispatch. Used by ClickSoftware WFM routing engine to filter eligible crews for a given work order location.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:oshaSafetyTrainingExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Osha Safety Training Expiry Date' ;
    rdfs:comment 'Date on which the crew\'s current OSHA-mandated safety training certification expires. Crews with expired certifications must be blocked from dispatch until recertification is completed. Supports OSHA 29 CFR 1910.269 compliance tracking.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:overtimeEligible rdf:type rdf:Property ;
    rdfs:label 'Overtime Eligible' ;
    rdfs:comment 'Indicates whether members of this crew are eligible for overtime pay under the applicable union CBA and FLSA regulations. Drives overtime cost calculations in SAP HR payroll and ClickSoftware WFM scheduling.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ppeComplianceStatus rdf:type rdf:Property ;
    rdfs:label 'Ppe Compliance Status' ;
    rdfs:comment 'Current status of the crew\'s Personal Protective Equipment (PPE) compliance as verified during the most recent safety inspection. Non-compliant crews must be blocked from energized work dispatch per OSHA 29 CFR 1910.269.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:safetyIncidentCountYtd rdf:type rdf:Property ;
    rdfs:label 'Safety Incident Count Ytd' ;
    rdfs:comment 'Count of OSHA-recordable safety incidents attributed to this crew in the current calendar year. Used for safety performance monitoring, crew risk scoring, and OSHA 300 log compliance. Reset annually.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sapHrOrgUnitCode rdf:type rdf:Property ;
    rdfs:label 'Sap Hr Org Unit Code' ;
    rdfs:comment 'SAP HR organizational unit identifier to which this crew is mapped in the HR hierarchy. Enables linkage between field crew operational data and HR cost reporting, headcount planning, and payroll processing.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shiftType rdf:type rdf:Property ;
    rdfs:label 'Shift Type' ;
    rdfs:comment 'Standard shift schedule assigned to this crew. Drives scheduling windows in ClickSoftware WFM, overtime eligibility calculations, and union CBA compliance for shift differentials.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:size rdf:type rdf:Property ;
    rdfs:label 'Size' ;
    rdfs:comment 'Authorized headcount (number of personnel) assigned to this crew unit. Serves as the principal MEASUREMENT_OR_VALUE for this MASTER_RESOURCE entity. Used for capacity planning, dispatch feasibility, and OSHA minimum crew-size compliance checks.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:specialtyCertifications rdf:type rdf:Property ;
    rdfs:label 'Specialty Certifications' ;
    rdfs:comment 'Comma-delimited list of specialty certifications held by the crew as a unit (e.g., \'CDL,HazMat,Gas_Leak_Response,Confined_Space\'). Drives advanced dispatch eligibility filtering for specialized work orders in ClickSoftware WFM.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:standardEndTime rdf:type rdf:Property ;
    rdfs:label 'Standard End Time' ;
    rdfs:comment 'Scheduled end time (HH:MM, 24-hour format) for this crew\'s standard shift. Used alongside standard_start_time to define the crew\'s available dispatch window and calculate daily labor hours.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:standardStartTime rdf:type rdf:Property ;
    rdfs:label 'Standard Start Time' ;
    rdfs:comment 'Scheduled start time (HH:MM, 24-hour format) for this crew\'s standard shift. Used by ClickSoftware WFM for automated scheduling, dispatch window calculation, and overtime threshold monitoring.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:stormPriorityTier rdf:type rdf:Property ;
    rdfs:label 'Storm Priority Tier' ;
    rdfs:comment 'Integer priority tier (1 = highest priority) assigned to this crew for storm restoration dispatch sequencing. Tier 1 crews are activated first during major outage events. Used by the OMS storm management module to optimize SAIDI/SAIFI restoration performance.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:vehicleId rdf:type rdf:Property ;
    rdfs:label 'Vehicle Id' ;
    rdfs:comment 'Reference to the primary fleet vehicle (bucket truck, digger derrick, service van, etc.) assigned to this crew for field operations. Sourced from the fleet/asset management system and linked to Maximo EAM vehicle records.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vehicle .

ind:wfmCrewExternalCode rdf:type rdf:Property ;
    rdfs:label 'Wfm Crew External Code' ;
    rdfs:comment 'Native crew identifier as stored in ClickSoftware WFM. Preserved for cross-system reconciliation, data lineage tracing, and integration with WFM dispatch APIs. Distinct from the surrogate crew_id used in the lakehouse.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workFunction rdf:type rdf:Property ;
    rdfs:label 'Work Function' ;
    rdfs:comment 'Primary operational function this crew is configured to perform. Distinguishes T&D construction crews from O&M maintenance crews, storm restoration crews, and gas operations crews. Used for work order routing and resource planning. [ENUM-REF-CANDIDATE: construction|maintenance|inspection|storm_restoration|gas_ops|metering|emergency — promote to reference product]' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:apprenticeProgramYear rdf:type rdf:Property ;
    rdfs:label 'Apprentice Program Year' ;
    rdfs:comment 'For workers with crew_role of \'apprentice\', indicates the current year of the apprenticeship program (1 through 5 for IBEW lineworker apprenticeships). Determines eligible task scope, supervision ratio requirements, and applicable wage step per the CBA.' ;
    rdfs:domain ind:CrewMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assignmentType rdf:type rdf:Property ;
    rdfs:label 'Assignment Type' ;
    rdfs:comment 'Classifies the nature of the crew membership assignment. Permanent assignments reflect standard roster composition. Storm assignments are activated during emergency response events. Mutual aid assignments reflect workers deployed from or received by other utilities under mutual assistance agreements.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:availabilityEndTime rdf:type rdf:Property ;
    rdfs:label 'Availability End Time' ;
    rdfs:comment 'The timestamp at which this crew member\'s availability for dispatch ends for their shift. Used by ClickSoftware WFM to prevent over-scheduling and to manage fatigue rule compliance during extended storm restoration events.' ;
    rdfs:domain ind:CrewMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:availabilityStartTime rdf:type rdf:Property ;
    rdfs:label 'Availability Start Time' ;
    rdfs:comment 'The timestamp at which this crew member becomes available for dispatch at the start of their shift for this assignment. Used by ClickSoftware WFM scheduling engine for real-time crew availability and OMS outage restoration crew dispatch.' ;
    rdfs:domain ind:CrewMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:backgroundCheckDate rdf:type rdf:Property ;
    rdfs:label 'Background Check Date' ;
    rdfs:comment 'The date on which the most recent background check was completed for this crew member. Required for NERC CIP-004 compliance for workers with CIP access, and for contractor qualification per state PUC requirements.' ;
    rdfs:domain ind:CrewMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cdlExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Cdl Expiration Date' ;
    rdfs:comment 'The expiration date of the worker\'s Commercial Driver\'s License. Used to trigger renewal alerts and prevent dispatch of workers with expired CDLs to vehicle-operating roles. Integrated with ClickSoftware WFM compliance checks.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cdlLicenseNumber rdf:type rdf:Property ;
    rdfs:label 'Cdl License Number' ;
    rdfs:comment 'The state-issued Commercial Driver\'s License number for this worker, required when cdl_required_flag is true. Stored for DOT compliance verification and pre-dispatch validation. Classified as confidential PII per FMCSA regulations.' ;
    rdfs:domain ind:CrewMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cdlRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Cdl Required Flag' ;
    rdfs:comment 'Indicates whether this crew member role requires a valid Commercial Driver\'s License (CDL) for operating heavy utility vehicles, bucket trucks, or digger derricks assigned to this crew. Drives pre-dispatch license verification checks.' ;
    rdfs:domain ind:CrewMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cipAccessFlag rdf:type rdf:Property ;
    rdfs:label 'Cip Access Flag' ;
    rdfs:comment 'Indicates whether this crew member has been granted access to NERC CIP-defined Critical Infrastructure Protection facilities (e.g., substations, control rooms, communication nodes). Requires background check and personnel risk assessment per NERC CIP-004.' ;
    rdfs:domain ind:CrewMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contractorPoNumber rdf:type rdf:Property ;
    rdfs:label 'Contractor Po Number' ;
    rdfs:comment 'The SAP MM purchase order number governing the contract under which this contractor crew member is engaged. Links workforce deployment to financial commitments for CAPEX/OPEX cost tracking and accounts payable reconciliation.' ;
    rdfs:domain ind:CrewMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crewLeadFlag rdf:type rdf:Property ;
    rdfs:label 'Crew Lead Flag' ;
    rdfs:comment 'Indicates whether this worker is designated as the crew lead or foreman for this crew assignment. A crew may have only one active lead at a time. Used for supervisory accountability, safety briefing responsibility, and OSHA incident reporting chain of command.' ;
    rdfs:domain ind:CrewMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:crewRole rdf:type rdf:Property ;
    rdfs:label 'Crew Role' ;
    rdfs:comment 'The functional role of the worker within the crew hierarchy. Determines supervisory authority, task eligibility, and pay rate applicability. Lead and foreman roles carry supervisory responsibility; apprentice and helper roles require journeyman oversight per union agreement and OSHA safety standards.' ;
    rdfs:domain ind:CrewMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispatchZone rdf:type rdf:Property ;
    rdfs:label 'Dispatch Zone' ;
    rdfs:comment 'The geographic dispatch zone or service territory code within which this crew member is authorized and expected to respond. Used by GE PowerOn DMS/OMS for crew dispatch during outage restoration and by ClickSoftware WFM for field service scheduling.' ;
    rdfs:domain ind:CrewMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fatigueHoursWorked rdf:type rdf:Property ;
    rdfs:label 'Fatigue Hours Worked' ;
    rdfs:comment 'Cumulative hours worked by this crew member in the current fatigue management window (typically 16-hour or 24-hour rolling period). Used to enforce NERC FAC-002 fatigue management rules and DOT hours-of-service limits during storm restoration.' ;
    rdfs:domain ind:CrewMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastSafetyBriefingDate rdf:type rdf:Property ;
    rdfs:label 'Last Safety Briefing Date' ;
    rdfs:comment 'The date of the most recent safety tailgate briefing attended by this crew member. Required for OSHA 29 CFR 1910.269 pre-job briefing compliance documentation and safety audit trails.' ;
    rdfs:domain ind:CrewMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:membershipStatus rdf:type rdf:Property ;
    rdfs:label 'Membership Status' ;
    rdfs:comment 'Current lifecycle status of the worker\'s crew membership. Active indicates the worker is currently rostered on the crew. Suspended may reflect a safety hold or disciplinary action. Pending indicates a future-dated assignment awaiting activation.' ;
    rdfs:domain ind:CrewMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mobileDeviceCode rdf:type rdf:Property ;
    rdfs:label 'Mobile Device Code' ;
    rdfs:comment 'The identifier of the mobile device (tablet or smartphone) issued to this crew member for ClickSoftware WFM field app access, work order receipt, and real-time status updates. Used for device management and field connectivity troubleshooting.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mutualAidUtility rdf:type rdf:Property ;
    rdfs:label 'Mutual Aid Utility' ;
    rdfs:comment 'For storm augmentation or mutual aid assignments, identifies the name of the external utility company that deployed this worker. Null for internal employees. Required for mutual aid cost recovery billing and EEI mutual assistance program reporting.' ;
    rdfs:domain ind:CrewMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nercQualifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Nerc Qualified Flag' ;
    rdfs:comment 'Indicates whether this crew member holds current NERC PER-005 qualification for performing switching operations on the Bulk Electric System (BES). Required for crew members assigned to transmission switching, substation operations, or SCADA-controlled switching tasks.' ;
    rdfs:domain ind:CrewMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:oshaQualifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Osha Qualified Flag' ;
    rdfs:comment 'Indicates whether this worker meets OSHA\'s definition of a \'qualified person\' for electrical work on energized lines and equipment as required by 29 CFR 1910.269 and 1926.950. Must be true for workers assigned to live-line T&D construction and maintenance tasks.' ;
    rdfs:domain ind:CrewMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overtimeEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Overtime Eligible Flag' ;
    rdfs:comment 'Indicates whether this crew member is eligible for overtime compensation under the applicable CBA or FLSA provisions for this crew assignment. Drives overtime cost forecasting during storm response and extended outage restoration events.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:perDiemEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Per Diem Eligible Flag' ;
    rdfs:comment 'Indicates whether this crew member is entitled to per diem allowances (meals, lodging) for this assignment, typically applicable to storm mutual aid deployments or out-of-territory assignments. Drives travel expense accruals and FEMA cost recovery documentation.' ;
    rdfs:domain ind:CrewMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ppeKitAssigned rdf:type rdf:Property ;
    rdfs:label 'Ppe Kit Assigned' ;
    rdfs:comment 'Identifier or description of the Personal Protective Equipment kit assigned to this crew member for this assignment (e.g., arc flash PPE category, rubber glove class). Required for OSHA 29 CFR 1910.269 PPE compliance tracking and safety audit trails.' ;
    rdfs:domain ind:CrewMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryWorkCenter rdf:type rdf:Property ;
    rdfs:label 'Primary Work Center' ;
    rdfs:comment 'The SAP PM/HR work center or service territory to which this crew member is primarily assigned. Determines geographic dispatch zone, vehicle assignment, and T&D operational area responsibility.' ;
    rdfs:domain ind:CrewMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:safetyTrainingCurrentFlag rdf:type rdf:Property ;
    rdfs:label 'Safety Training Current Flag' ;
    rdfs:comment 'Indicates whether the worker\'s mandatory OSHA safety training certifications are current and not expired as of the effective_start_date of this crew assignment. A false value should prevent dispatch to hazardous work orders per OSHA compliance controls.' ;
    rdfs:domain ind:CrewMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scheduledHours rdf:type rdf:Property ;
    rdfs:label 'Scheduled Hours' ;
    rdfs:comment 'The number of labor hours this crew member is scheduled to work on this crew assignment for the current scheduling period. Used by ClickSoftware WFM for capacity planning and by SAP HR time management for shift scheduling.' ;
    rdfs:domain ind:CrewMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unionClassification rdf:type rdf:Property ;
    rdfs:label 'Union Classification' ;
    rdfs:comment 'The union job classification code applicable to this worker in this crew assignment (e.g., IBEW Journeyman Lineman, IBEW Apprentice Lineman, UWUA Gas Technician). Governs applicable wage rates, work rules, overtime eligibility, and jurisdictional work boundaries per the collective bargaining agreement. [ENUM-REF-CANDIDATE: IBEW_journeyman_lineman|IBEW_apprentice_lineman|UWUA_gas_tech|IBEW_foreman|non_union|contractor — promote to reference product]' ;
    rdfs:domain ind:CrewMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unionLocalNumber rdf:type rdf:Property ;
    rdfs:label 'Union Local Number' ;
    rdfs:comment 'The specific union local chapter number to which the worker belongs (e.g., IBEW Local 1245, UWUA Local 132). Required for labor relations reporting, grievance tracking, and CBA compliance verification.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vehicleCode rdf:type rdf:Property ;
    rdfs:label 'Vehicle Code' ;
    rdfs:comment 'Reference to the utility vehicle (bucket truck, service van, digger derrick) assigned to this crew member for this assignment period. Supports fleet utilization tracking and DOT vehicle inspection compliance.' ;
    rdfs:domain ind:CrewMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:workerType rdf:type rdf:Property ;
    rdfs:label 'Worker Type' ;
    rdfs:comment 'Categorizes the worker\'s employment relationship with the utility. Distinguishes regular employees from contractors, temporary hires, seasonal workers, and storm augmentation personnel. Drives payroll treatment, benefits eligibility, and OSHA recordkeeping obligations.' ;
    rdfs:domain ind:CrewMember ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:burdenPercentage rdf:type rdf:Property ;
    rdfs:label 'Burden Percentage' ;
    rdfs:comment 'Percentage markup applied to direct labor rate to account for benefits, payroll taxes, insurance, and other overhead costs. Used for fully-loaded labor cost calculations in work order costing and rate case filings.' ;
    rdfs:domain ind:LaborRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costCenterDefault rdf:type rdf:Property ;
    rdfs:label 'Cost Center Default' ;
    rdfs:comment 'Default SAP cost center for charging labor costs associated with this craft classification. Used for work order cost allocation and financial reporting.' ;
    rdfs:domain ind:LaborRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:craftClassificationCode rdf:type rdf:Property ;
    rdfs:label 'Craft Classification Code' ;
    rdfs:comment 'Standardized code identifying the craft or trade classification (e.g., lineworker, electrician, meter technician, substation operator). Aligns with union job classifications and SAP HR organizational assignment codes.' ;
    rdfs:domain ind:LaborRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:craftClassificationName rdf:type rdf:Property ;
    rdfs:label 'Craft Classification Name' ;
    rdfs:comment 'Full descriptive name of the craft or trade classification (e.g., Journeyman Lineworker, Senior Substation Electrician, Advanced Meter Technician).' ;
    rdfs:domain ind:LaborRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:doubleTimeRate rdf:type rdf:Property ;
    rdfs:label 'Double Time Rate' ;
    rdfs:comment 'Hourly labor rate for double-time hours (typically 2x straight time rate). Applied for holidays, Sundays, or extended overtime per union agreement.' ;
    rdfs:domain ind:LaborRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:employeeClass rdf:type rdf:Property ;
    rdfs:label 'Employee Class' ;
    rdfs:comment 'Broad classification of employee role (field workforce, office staff, technical specialist, supervisory, executive). Used for workforce planning and cost allocation.' ;
    rdfs:domain ind:LaborRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flsaStatus rdf:type rdf:Property ;
    rdfs:label 'Flsa Status' ;
    rdfs:comment 'FLSA classification determining overtime eligibility. Non-exempt employees are entitled to overtime pay; exempt employees are not.' ;
    rdfs:domain ind:LaborRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:glAccountDefault rdf:type rdf:Property ;
    rdfs:label 'Gl Account Default' ;
    rdfs:comment 'Default general ledger account code for posting labor expenses. Aligns with FERC Uniform System of Accounts for regulated utility accounting.' ;
    rdfs:domain ind:LaborRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:onCallRate rdf:type rdf:Property ;
    rdfs:label 'On Call Rate' ;
    rdfs:comment 'Hourly or daily rate paid to employees on standby/on-call status, available for emergency dispatch. May be a flat rate or percentage of straight time rate.' ;
    rdfs:domain ind:LaborRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overheadPercentage rdf:type rdf:Property ;
    rdfs:label 'Overhead Percentage' ;
    rdfs:comment 'Percentage markup for indirect overhead costs (supervision, facilities, administrative support) allocated to labor. Used in CAPEX/OPEX cost allocation and regulatory reporting.' ;
    rdfs:domain ind:LaborRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overtimeRate rdf:type rdf:Property ;
    rdfs:label 'Overtime Rate' ;
    rdfs:comment 'Hourly labor rate for overtime hours (typically 1.5x straight time rate). Applied for hours worked beyond standard shift or weekly threshold per union agreement and FLSA regulations.' ;
    rdfs:domain ind:LaborRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:payGrade rdf:type rdf:Property ;
    rdfs:label 'Pay Grade' ;
    rdfs:comment 'Pay grade or step level within the craft classification (e.g., Grade 1, Grade 2, Step A, Step B). Determines base compensation level per union agreement or company pay structure.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateApprovalAuthority rdf:type rdf:Property ;
    rdfs:label 'Rate Approval Authority' ;
    rdfs:comment 'Entity or individual who approved the labor rate (e.g., HR Director, Union Negotiating Committee, Public Utility Commission).' ;
    rdfs:domain ind:LaborRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Rate Approval Date' ;
    rdfs:comment 'Date when the labor rate was formally approved by management, union ratification, or regulatory authority.' ;
    rdfs:domain ind:LaborRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rateSource rdf:type rdf:Property ;
    rdfs:label 'Rate Source' ;
    rdfs:comment 'Source authority for the labor rate (union collective bargaining agreement, company compensation policy, market survey, contractor agreement, regulatory mandate).' ;
    rdfs:domain ind:LaborRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateStatus rdf:type rdf:Property ;
    rdfs:label 'Rate Status' ;
    rdfs:comment 'Current lifecycle status of the labor rate record (active and in use, pending approval, expired, superseded by newer rate, suspended).' ;
    rdfs:domain ind:LaborRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shiftDifferentialRate rdf:type rdf:Property ;
    rdfs:label 'Shift Differential Rate' ;
    rdfs:comment 'Additional hourly premium for non-standard shifts (evening, night, weekend shifts). Added to base straight time rate.' ;
    rdfs:domain ind:LaborRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stormEmergencyRate rdf:type rdf:Property ;
    rdfs:label 'Storm Emergency Rate' ;
    rdfs:comment 'Premium hourly rate applied during declared storm or emergency restoration events. Typically higher than standard overtime to incentivize rapid response for grid restoration.' ;
    rdfs:domain ind:LaborRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:straightTimeRate rdf:type rdf:Property ;
    rdfs:label 'Straight Time Rate' ;
    rdfs:comment 'Standard hourly labor rate for regular working hours (typically Monday-Friday, standard shift). Expressed in USD per hour.' ;
    rdfs:domain ind:LaborRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:workLocationType rdf:type rdf:Property ;
    rdfs:label 'Work Location Type' ;
    rdfs:comment 'Primary work location type for this labor classification (field-based, office-based, hybrid, remote). Impacts travel time allowances and expense policies.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:onCallRotationId rdf:type rdf:Property ;
    rdfs:label 'On Call Rotation Id' ;
    rdfs:comment 'Unique identifier for the on-call rotation schedule record.' ;
    rdfs:domain ind:OnCallRotation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dispatchZoneId rdf:type rdf:Property ;
    rdfs:label 'Dispatch Zone Id' ;
    rdfs:comment 'Dispatch zone within the service territory for this on-call rotation.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DispatchZone .

ind:primaryOnTechnicianId rdf:type rdf:Property ;
    rdfs:label 'Primary On Technician Id' ;
    rdfs:comment 'Primary technician assigned to this on-call rotation period.' ;
    rdfs:domain ind:OnCallRotation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Technician .

ind:sapHrShiftId rdf:type rdf:Property ;
    rdfs:label 'Sap Hr Shift Id' ;
    rdfs:comment 'SAP HR shift plan identifier linked to this on-call rotation for payroll integration.' ;
    rdfs:domain ind:OnCallRotation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Shift .

ind:actualCalloutsCount rdf:type rdf:Property ;
    rdfs:label 'Actual Callouts Count' ;
    rdfs:comment 'Number of emergency callouts that occurred during this rotation period.' ;
    rdfs:domain ind:OnCallRotation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:avgResponseTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Avg Response Time Minutes' ;
    rdfs:comment 'Average response time in minutes for callouts during this rotation period.' ;
    rdfs:domain ind:OnCallRotation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:backupContactPhone rdf:type rdf:Property ;
    rdfs:label 'Backup Contact Phone' ;
    rdfs:comment 'Phone number to reach the backup technician during this rotation period.' ;
    rdfs:domain ind:OnCallRotation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:calloutMinimumHours rdf:type rdf:Property ;
    rdfs:label 'Callout Minimum Hours' ;
    rdfs:comment 'Minimum billable hours guaranteed per union agreement when technician is called out (e.g., 4-hour minimum per CBA).' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:calloutRadiusMiles rdf:type rdf:Property ;
    rdfs:label 'Callout Radius Miles' ;
    rdfs:comment 'Maximum distance in miles from technician home location or depot for emergency callout coverage.' ;
    rdfs:domain ind:OnCallRotation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cdlRequired rdf:type rdf:Property ;
    rdfs:label 'Cdl Required' ;
    rdfs:comment 'Indicates whether a valid CDL is required for this on-call rotation.' ;
    rdfs:domain ind:OnCallRotation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:clicksoftwareRotationCode rdf:type rdf:Property ;
    rdfs:label 'Clicksoftware Rotation Code' ;
    rdfs:comment 'External identifier for this on-call rotation in the ClickSoftware Workforce Management system.' ;
    rdfs:domain ind:OnCallRotation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispatchCenterCode rdf:type rdf:Property ;
    rdfs:label 'Dispatch Center Code' ;
    rdfs:comment 'Code identifying the dispatch center responsible for activating this on-call rotation.' ;
    rdfs:domain ind:OnCallRotation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emergencyTypeCoverage rdf:type rdf:Property ;
    rdfs:label 'Emergency Type Coverage' ;
    rdfs:comment 'Comma-separated list of emergency incident types covered by this rotation (e.g., outage, gas leak, downed wire, transformer failure).' ;
    rdfs:domain ind:OnCallRotation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gasOperatorQualifiedRequired rdf:type rdf:Property ;
    rdfs:label 'Gas Operator Qualified Required' ;
    rdfs:comment 'Indicates whether DOT Pipeline and Hazardous Materials Safety Administration (PHMSA) gas operator qualification is required for this rotation.' ;
    rdfs:domain ind:OnCallRotation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mutualAidEligible rdf:type rdf:Property ;
    rdfs:label 'Mutual Aid Eligible' ;
    rdfs:comment 'Indicates whether technician/crew in this rotation can be deployed for mutual aid to other utilities during major events.' ;
    rdfs:domain ind:OnCallRotation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nercCipRequired rdf:type rdf:Property ;
    rdfs:label 'Nerc Cip Required' ;
    rdfs:comment 'Indicates whether NERC CIP security clearance is required for this on-call rotation due to critical infrastructure access.' ;
    rdfs:domain ind:OnCallRotation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:onCallPayProvision rdf:type rdf:Property ;
    rdfs:label 'On Call Pay Provision' ;
    rdfs:comment 'Specific union CBA clause or company policy defining on-call compensation (e.g., standby pay rate, minimum call-in hours, overtime multiplier).' ;
    rdfs:domain ind:OnCallRotation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:onCallPayRate rdf:type rdf:Property ;
    rdfs:label 'On Call Pay Rate' ;
    rdfs:comment 'Hourly or daily standby pay rate for being on-call during this rotation period.' ;
    rdfs:domain ind:OnCallRotation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:oshaQualificationRequired rdf:type rdf:Property ;
    rdfs:label 'Osha Qualification Required' ;
    rdfs:comment 'OSHA safety qualifications required for technicians in this rotation (e.g., OSHA 10, OSHA 30, confined space, arc flash).' ;
    rdfs:domain ind:OnCallRotation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overtimeMultiplier rdf:type rdf:Property ;
    rdfs:label 'Overtime Multiplier' ;
    rdfs:comment 'Overtime pay multiplier applied to callout work during on-call rotation (e.g., 1.5x, 2.0x for weekend/holiday).' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorityTier rdf:type rdf:Property ;
    rdfs:label 'Priority Tier' ;
    rdfs:comment 'Priority tier for emergency dispatch escalation (Tier 1 = first responder, Tier 2 = backup, Tier 3 = management escalation).' ;
    rdfs:domain ind:OnCallRotation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseTimeSlaMinutes rdf:type rdf:Property ;
    rdfs:label 'Response Time Sla Minutes' ;
    rdfs:comment 'Maximum number of minutes allowed for technician to respond to emergency callout during this rotation (e.g., 30-minute callout SLA).' ;
    rdfs:domain ind:OnCallRotation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rotationEndDatetime rdf:type rdf:Property ;
    rdfs:label 'Rotation End Datetime' ;
    rdfs:comment 'Date and time when the on-call rotation period ends.' ;
    rdfs:domain ind:OnCallRotation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:rotationName rdf:type rdf:Property ;
    rdfs:label 'Rotation Name' ;
    rdfs:comment 'Descriptive name for the on-call rotation schedule (e.g., Week 1 Gas Emergency, Storm Response Rotation A).' ;
    rdfs:domain ind:OnCallRotation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rotationStartDatetime rdf:type rdf:Property ;
    rdfs:label 'Rotation Start Datetime' ;
    rdfs:comment 'Date and time when the on-call rotation period begins.' ;
    rdfs:domain ind:OnCallRotation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:rotationStatus rdf:type rdf:Property ;
    rdfs:label 'Rotation Status' ;
    rdfs:comment 'Current lifecycle status of the on-call rotation schedule.' ;
    rdfs:domain ind:OnCallRotation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rotationType rdf:type rdf:Property ;
    rdfs:label 'Rotation Type' ;
    rdfs:comment 'Frequency pattern of the on-call rotation schedule.' ;
    rdfs:domain ind:OnCallRotation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaComplianceRate rdf:type rdf:Property ;
    rdfs:label 'Sla Compliance Rate' ;
    rdfs:comment 'Percentage of callouts during this rotation that met the response time SLA.' ;
    rdfs:domain ind:OnCallRotation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stormResponseEligible rdf:type rdf:Property ;
    rdfs:label 'Storm Response Eligible' ;
    rdfs:comment 'Indicates whether this rotation is eligible for storm emergency response activation.' ;
    rdfs:domain ind:OnCallRotation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:unionAgreementCode rdf:type rdf:Property ;
    rdfs:label 'Union Agreement Code' ;
    rdfs:comment 'Collective Bargaining Agreement (CBA) code governing on-call pay provisions and work rules for this rotation.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:voltageClassCoverage rdf:type rdf:Property ;
    rdfs:label 'Voltage Class Coverage' ;
    rdfs:comment 'Voltage classes this on-call rotation is qualified to handle (e.g., low voltage, medium voltage, high voltage, transmission).' ;
    rdfs:domain ind:OnCallRotation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualificationId rdf:type rdf:Property ;
    rdfs:label 'Qualification Id' ;
    rdfs:comment 'Unique identifier for the workforce qualification record. Primary key.' ;
    rdfs:domain ind:Qualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supersededByQualificationId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Qualification Id' ;
    rdfs:comment 'Reference to the qualification_id that supersedes this qualification if it has been replaced by a newer version or updated standard. Null if not superseded.' ;
    rdfs:domain ind:Qualification ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Qualification .

ind:costPerWorkerUsd rdf:type rdf:Property ;
    rdfs:label 'Cost Per Worker Usd' ;
    rdfs:comment 'Standard cost in US dollars to obtain or renew this qualification per worker, including training fees, examination fees, and certification fees. Used for workforce development budgeting.' ;
    rdfs:domain ind:Qualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:examinationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Examination Required Flag' ;
    rdfs:comment 'Indicates whether an examination or assessment is required to obtain this qualification (True) or if completion of training alone is sufficient (False).' ;
    rdfs:domain ind:Qualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:externalTrainingProvider rdf:type rdf:Property ;
    rdfs:label 'External Training Provider' ;
    rdfs:comment 'Name of the primary external training provider or vendor if internal training is not available. Null if training is provided internally.' ;
    rdfs:domain ind:Qualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internalTrainingAvailableFlag rdf:type rdf:Property ;
    rdfs:label 'Internal Training Available Flag' ;
    rdfs:comment 'Indicates whether the utility offers internal training programs for this qualification (True) or if workers must obtain it through external providers (False).' ;
    rdfs:domain ind:Qualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:issuingAuthorityType rdf:type rdf:Property ;
    rdfs:label 'Issuing Authority Type' ;
    rdfs:comment 'Classification of the issuing authority: government agency (OSHA, DMV), industry association (NFPA, IEEE), internal utility training program, third-party certification body, or professional organization.' ;
    rdfs:domain ind:Qualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jobRoleApplicability rdf:type rdf:Property ;
    rdfs:label 'Job Role Applicability' ;
    rdfs:comment 'Comma-separated list of job roles or positions for which this qualification is applicable or required (e.g., Lineworker, Substation Technician, Gas Service Technician, Meter Reader, Crew Chief).' ;
    rdfs:domain ind:Qualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumExperienceMonths rdf:type rdf:Property ;
    rdfs:label 'Minimum Experience Months' ;
    rdfs:comment 'Minimum months of relevant work experience required before a worker can pursue this qualification. Null if no experience requirement.' ;
    rdfs:domain ind:Qualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:nercCipRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Nerc Cip Required Flag' ;
    rdfs:comment 'Indicates whether this qualification is required under North American Electric Reliability Corporation Critical Infrastructure Protection standards for personnel with access to Bulk Electric System cyber or physical assets.' ;
    rdfs:domain ind:Qualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:practicalDemonstrationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Practical Demonstration Required Flag' ;
    rdfs:comment 'Indicates whether a hands-on practical demonstration or field evaluation is required to obtain this qualification (True) or not (False).' ;
    rdfs:domain ind:Qualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:prerequisiteQualifications rdf:type rdf:Property ;
    rdfs:label 'Prerequisite Qualifications' ;
    rdfs:comment 'Comma-separated list of qualification codes that are prerequisites for obtaining this qualification. Null if no prerequisites exist.' ;
    rdfs:domain ind:Qualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualificationCategory rdf:type rdf:Property ;
    rdfs:label 'Qualification Category' ;
    rdfs:comment 'Broad functional category grouping qualifications by purpose: safety (OSHA, Arc Flash), technical (CDL, equipment operation), operational (switching authorization), regulatory (gas operator qualification), leadership (crew chief), or specialized (confined space entry).' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualificationCode rdf:type rdf:Property ;
    rdfs:label 'Qualification Code' ;
    rdfs:comment 'Unique business identifier code for the qualification (e.g., CDL-A, OSHA-30, NFPA70E). Used for external reference and system integration.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualificationDescription rdf:type rdf:Property ;
    rdfs:label 'Qualification Description' ;
    rdfs:comment 'Detailed description of the qualification including scope, purpose, and what competencies or knowledge it represents.' ;
    rdfs:domain ind:Qualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualificationName rdf:type rdf:Property ;
    rdfs:label 'Qualification Name' ;
    rdfs:comment 'Full descriptive name of the qualification (e.g., Commercial Driver License Class A, OSHA 30-Hour Construction Safety, NFPA 70E Arc Flash Safety Training).' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryAuthority rdf:type rdf:Property ;
    rdfs:label 'Regulatory Authority' ;
    rdfs:comment 'Name of the regulatory body that mandates this qualification if regulatory_mandate_flag is True (e.g., OSHA, PHMSA, NERC, State Public Utility Commission). Null if not regulatory-mandated.' ;
    rdfs:domain ind:Qualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryMandateFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Mandate Flag' ;
    rdfs:comment 'Indicates whether this qualification is mandated by federal, state, or local regulation (True) or is voluntary/internal best practice (False). Regulatory-mandated qualifications have compliance implications.' ;
    rdfs:domain ind:Qualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:renewalMethod rdf:type rdf:Property ;
    rdfs:label 'Renewal Method' ;
    rdfs:comment 'Method by which the qualification must be renewed: retraining course, examination, continuing education credits, practical demonstration, administrative review, or not applicable if no renewal required.' ;
    rdfs:domain ind:Qualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Renewal Required Flag' ;
    rdfs:comment 'Indicates whether this qualification requires periodic renewal (True) or is valid indefinitely once obtained (False).' ;
    rdfs:domain ind:Qualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:safetyCriticalFlag rdf:type rdf:Property ;
    rdfs:label 'Safety Critical Flag' ;
    rdfs:comment 'Indicates whether this qualification is designated as safety-critical (True), meaning its absence creates immediate safety risk to workers or the public. Used for compliance monitoring and workforce planning.' ;
    rdfs:domain ind:Qualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:trainingDurationHours rdf:type rdf:Property ;
    rdfs:label 'Training Duration Hours' ;
    rdfs:comment 'Standard duration in hours of the training or course required to obtain this qualification. Null if not applicable (e.g., for licenses obtained through examination without formal training).' ;
    rdfs:domain ind:Qualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unionAgreementReference rdf:type rdf:Property ;
    rdfs:label 'Union Agreement Reference' ;
    rdfs:comment 'Reference to the collective bargaining agreement or union contract section that governs this qualification if applicable. Null if not covered by union agreement.' ;
    rdfs:domain ind:Qualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validityPeriodMonths rdf:type rdf:Property ;
    rdfs:label 'Validity Period Months' ;
    rdfs:comment 'Standard validity period for this qualification in months from date of issuance. Null if the qualification does not expire (e.g., some licenses are perpetual until revoked).' ;
    rdfs:domain ind:Qualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:workTypeApplicability rdf:type rdf:Property ;
    rdfs:label 'Work Type Applicability' ;
    rdfs:comment 'Comma-separated list of work types or activities for which this qualification is required (e.g., Overhead Line Construction, Underground Cable Splicing, Substation Switching, Gas Main Repair, Confined Space Entry, Energized Work).' ;
    rdfs:domain ind:Qualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleId rdf:type rdf:Property ;
    rdfs:label 'Schedule Id' ;
    rdfs:comment 'Unique identifier for the workforce schedule record. Primary key.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:modifiedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Modified By User Employee Id' ;
    rdfs:comment 'User ID of the workforce planner or system user who last modified this schedule record.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:workAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Work Assignment Id' ;
    rdfs:comment 'Reference to the planned work assignment or work order associated with this schedule. Nullable for general availability schedules.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WorkOrderAssignment .

ind:breakDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Break Duration Minutes' ;
    rdfs:comment 'Total scheduled break time in minutes (lunch, rest breaks). Required for labor law compliance and union contract adherence.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:certificationRequired rdf:type rdf:Property ;
    rdfs:label 'Certification Required' ;
    rdfs:comment 'Specific certifications or licenses required for this schedule (e.g., CDL Class A, NERC CIP training, confined space entry). Pipe-separated list if multiple.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consecutiveDaysWorked rdf:type rdf:Property ;
    rdfs:label 'Consecutive Days Worked' ;
    rdfs:comment 'Number of consecutive days the technician is scheduled to work without a rest day. Used for union contract compliance (maximum consecutive days rules).' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:mutualAssistanceFlag rdf:type rdf:Property ;
    rdfs:label 'Mutual Assistance Flag' ;
    rdfs:comment 'Indicates whether this schedule involves mutual assistance deployment to another utility service territory during emergency response.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:onCallFlag rdf:type rdf:Property ;
    rdfs:label 'On Call Flag' ;
    rdfs:comment 'Indicates whether this schedule includes on-call duty for emergency response. True if technician is on standby for outage or emergency dispatch.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:optimizationScore rdf:type rdf:Property ;
    rdfs:label 'Optimization Score' ;
    rdfs:comment 'Score generated by ClickSoftware WFM optimization engine indicating schedule quality (0-100). Higher scores indicate better resource utilization and constraint satisfaction.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:publishedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Published Timestamp' ;
    rdfs:comment 'Timestamp when the schedule was published and communicated to the technician. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:restPeriodHours rdf:type rdf:Property ;
    rdfs:label 'Rest Period Hours' ;
    rdfs:comment 'Minimum rest period in hours between shifts. Required for OSHA safety compliance and union contract adherence.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:shiftDurationHours rdf:type rdf:Property ;
    rdfs:label 'Shift Duration Hours' ;
    rdfs:comment 'Total duration of the scheduled shift in hours, including breaks. Used for labor capacity planning and union contract compliance.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:shiftEndTime rdf:type rdf:Property ;
    rdfs:label 'Shift End Time' ;
    rdfs:comment 'Timestamp when the scheduled shift ends. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:shiftPatternCode rdf:type rdf:Property ;
    rdfs:label 'Shift Pattern Code' ;
    rdfs:comment 'Code representing the shift rotation pattern (e.g., 4x10, 5x8, 12HR-ROTATING). Used for union contract compliance and workforce planning.' ;
    rdfs:domain ind:Schedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shiftStartTime rdf:type rdf:Property ;
    rdfs:label 'Shift Start Time' ;
    rdfs:comment 'Timestamp when the scheduled shift begins. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:skillRequirementCode rdf:type rdf:Property ;
    rdfs:label 'Skill Requirement Code' ;
    rdfs:comment 'Primary skill or certification required for this schedule (e.g., LINEWORKER_JOURNEYMAN, METER_TECH_L2, SUBSTATION_OPERATOR). Used for qualification matching.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:travelTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Travel Time Minutes' ;
    rdfs:comment 'Estimated travel time in minutes from work location to service territory or first job site. Used for schedule optimization and capacity planning.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:callOutEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Call Out Eligible Flag' ;
    rdfs:comment 'Indicates whether crew members on this shift are eligible for emergency call-out outside their regular shift hours. True if call-out provisions apply per union agreement, false if shift is exempt from call-out duty.' ;
    rdfs:domain ind:Shift ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:consecutiveShiftLimit rdf:type rdf:Property ;
    rdfs:label 'Consecutive Shift Limit' ;
    rdfs:comment 'Maximum number of consecutive shifts of this type that can be worked before mandatory rest period is required. Enforces OSHA fatigue management and union agreement provisions to prevent worker exhaustion and safety incidents.' ;
    rdfs:domain ind:Shift ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:crewSizeMaximum rdf:type rdf:Property ;
    rdfs:label 'Crew Size Maximum' ;
    rdfs:comment 'Maximum number of personnel that can be assigned to this shift based on operational capacity, equipment availability, and budget constraints.' ;
    rdfs:domain ind:Shift ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:crewSizeMinimum rdf:type rdf:Property ;
    rdfs:label 'Crew Size Minimum' ;
    rdfs:comment 'Minimum number of qualified personnel required to staff this shift to meet operational and safety requirements. Based on work type, equipment requirements, and OSHA safety regulations for field operations.' ;
    rdfs:domain ind:Shift ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:emergencyResponseFlag rdf:type rdf:Property ;
    rdfs:label 'Emergency Response Flag' ;
    rdfs:comment 'Indicates whether this shift is designated for emergency response and storm restoration work. True for shifts that can be mobilized for outage management system (OMS) dispatch and critical infrastructure protection (CIP) incidents.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fatigueRiskScore rdf:type rdf:Property ;
    rdfs:label 'Fatigue Risk Score' ;
    rdfs:comment 'Calculated risk score (0-100) assessing fatigue-related safety risk based on shift duration, time of day, consecutive shifts, and rest periods. Higher scores indicate greater fatigue risk requiring additional monitoring and mitigation measures per OSHA fatigue management guidelines.' ;
    rdfs:domain ind:Shift ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:geographicServiceArea rdf:type rdf:Property ;
    rdfs:label 'Geographic Service Area' ;
    rdfs:comment 'Geographic territory or service area covered by this shift (e.g., North Region, Metro District, Coastal Zone). Used for crew dispatch optimization and emergency response coordination.' ;
    rdfs:domain ind:Shift ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hazardLevel rdf:type rdf:Property ;
    rdfs:label 'Hazard Level' ;
    rdfs:comment 'Risk classification of the shift based on work activities and safety hazards. Low hazard shifts involve minimal risk (office work), moderate hazard shifts include routine field operations, high hazard shifts involve energized equipment or elevated work, and critical hazard shifts require specialized safety protocols (e.g., high-voltage transmission work, confined space entry).' ;
    rdfs:domain ind:Shift ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:holidayWorkFlag rdf:type rdf:Property ;
    rdfs:label 'Holiday Work Flag' ;
    rdfs:comment 'Indicates whether this shift may be scheduled on recognized holidays. True if holiday work is permitted, false if holidays are excluded. Affects premium pay calculations and holiday compensation per union agreements.' ;
    rdfs:domain ind:Shift ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minimumRestHours rdf:type rdf:Property ;
    rdfs:label 'Minimum Rest Hours' ;
    rdfs:comment 'Minimum number of hours of rest required between the end of this shift and the start of the next shift for the same crew member. Ensures compliance with OSHA fatigue management guidelines and union rest period provisions.' ;
    rdfs:domain ind:Shift ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overtimeThresholdHours rdf:type rdf:Property ;
    rdfs:label 'Overtime Threshold Hours' ;
    rdfs:comment 'Number of hours after which overtime compensation begins for this shift type. Typically 8 hours per day or 40 hours per week under FLSA, but may vary based on union agreements and state regulations.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paidBreakMinutes rdf:type rdf:Property ;
    rdfs:label 'Paid Break Minutes' ;
    rdfs:comment 'Total minutes of paid break time included within the shift duration. Paid breaks are compensated time and count toward total hours worked for overtime calculations.' ;
    rdfs:domain ind:Shift ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:premiumPayMultiplier rdf:type rdf:Property ;
    rdfs:label 'Premium Pay Multiplier' ;
    rdfs:comment 'Multiplier applied to base hourly rate for premium compensation (e.g., 1.5 for time-and-a-half, 2.0 for double-time). Used for night differential, weekend premium, holiday pay, or emergency call-out compensation as defined in union agreements.' ;
    rdfs:domain ind:Shift ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:qualificationRequirementCodes rdf:type rdf:Property ;
    rdfs:label 'Qualification Requirement Codes' ;
    rdfs:comment 'Comma-separated list of qualification codes required for personnel assigned to this shift (e.g., LINEWORKER_JOURNEYMAN, CDL_CLASS_A, CONFINED_SPACE_ENTRY, FIRST_AID_CPR). Used to match crew members with appropriate certifications and training to shift requirements.' ;
    rdfs:domain ind:Shift ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingLocation rdf:type rdf:Property ;
    rdfs:label 'Reporting Location' ;
    rdfs:comment 'Physical location where crew members report at shift start (e.g., Operations Center, Service Yard, Substation). May include address or facility identifier for dispatch and timekeeping purposes.' ;
    rdfs:domain ind:Shift ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rotationCycleDays rdf:type rdf:Property ;
    rdfs:label 'Rotation Cycle Days' ;
    rdfs:comment 'Total number of days in one complete rotation cycle before the pattern repeats. Used for long-term crew scheduling and labor planning.' ;
    rdfs:domain ind:Shift ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rotationPattern rdf:type rdf:Property ;
    rdfs:label 'Rotation Pattern' ;
    rdfs:comment 'Description of the rotation schedule for rotating shifts (e.g., 4-on-3-off, 2-2-3 Panama, 5-2 weekly). Defines the repeating pattern of work days and rest days for crew scheduling.' ;
    rdfs:domain ind:Shift ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:schedulingPriority rdf:type rdf:Property ;
    rdfs:label 'Scheduling Priority' ;
    rdfs:comment 'Numeric priority ranking (1-100) used by ClickSoftware WFM to optimize crew assignments. Higher values indicate higher priority for staffing. Emergency and critical infrastructure shifts receive highest priority.' ;
    rdfs:domain ind:Shift ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:shiftCategory rdf:type rdf:Property ;
    rdfs:label 'Shift Category' ;
    rdfs:comment 'Operational category of the shift indicating the primary work purpose. Regular shifts support standard operations and maintenance (O&M), emergency shifts respond to unplanned outages, storm shifts mobilize for weather-related restoration, maintenance shifts focus on preventive and corrective asset maintenance, construction shifts support transmission and distribution (T&D) infrastructure projects, and inspection shifts perform regulatory compliance and safety inspections.' ;
    rdfs:domain ind:Shift ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shiftCode rdf:type rdf:Property ;
    rdfs:label 'Shift Code' ;
    rdfs:comment 'Business identifier code for the shift used in scheduling systems and crew assignments. Typically follows organizational naming conventions (e.g., DAY-A, NIGHT-B, ROT-1).' ;
    rdfs:domain ind:Shift ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shiftName rdf:type rdf:Property ;
    rdfs:label 'Shift Name' ;
    rdfs:comment 'Human-readable name of the shift for display and reporting purposes (e.g., Day Shift - A Crew, Night Shift - Emergency Response).' ;
    rdfs:domain ind:Shift ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shiftStatus rdf:type rdf:Property ;
    rdfs:label 'Shift Status' ;
    rdfs:comment 'Current lifecycle status of the shift definition. Active shifts are available for crew scheduling, inactive shifts are temporarily disabled, suspended shifts are on hold pending review, and archived shifts are retained for historical reference only.' ;
    rdfs:domain ind:Shift ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unpaidBreakMinutes rdf:type rdf:Property ;
    rdfs:label 'Unpaid Break Minutes' ;
    rdfs:comment 'Total minutes of unpaid break time (typically meal breaks) within the shift. Unpaid breaks do not count toward compensable hours and are excluded from overtime calculations.' ;
    rdfs:domain ind:Shift ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:weekendWorkFlag rdf:type rdf:Property ;
    rdfs:label 'Weekend Work Flag' ;
    rdfs:comment 'Indicates whether this shift regularly includes weekend work (Saturday/Sunday). True if shift pattern includes weekend days, false if Monday-Friday only. Used for premium pay calculations and work-life balance planning.' ;
    rdfs:domain ind:Shift ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:workOrderTypeDefault rdf:type rdf:Property ;
    rdfs:label 'Work Order Type Default' ;
    rdfs:comment 'Default work order type code from Maximo Enterprise Asset Management (EAM) for work performed during this shift (e.g., PM for preventive maintenance, CM for corrective maintenance, EM for emergency, PROJ for capital projects). Used to pre-populate work order creation and labor tracking.' ;
    rdfs:domain ind:Shift ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stormAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Storm Assignment Id' ;
    rdfs:comment 'Unique identifier for the storm assignment record. Primary key.' ;
    rdfs:domain ind:StormAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assignmentEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Assignment End Timestamp' ;
    rdfs:comment 'Date and time when the storm assignment officially ended. May differ from demobilization timestamp due to administrative closeout activities.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:assignmentNotes rdf:type rdf:Property ;
    rdfs:label 'Assignment Notes' ;
    rdfs:comment 'Free-text notes and comments about the storm assignment. May include special instructions, coordination details, or post-assignment observations from supervisors or crew leads.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentNumber rdf:type rdf:Property ;
    rdfs:label 'Assignment Number' ;
    rdfs:comment 'Business identifier for the storm assignment. Format: SA-XXXXXXXXXX where X is numeric. Used for tracking and reporting in workforce management systems.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentRole rdf:type rdf:Property ;
    rdfs:label 'Assignment Role' ;
    rdfs:comment 'Functional role assigned to the crew or technician during the storm event. Determines work scope, safety protocols, and pay classification under International Brotherhood of Electrical Workers (IBEW) storm pay provisions. [ENUM-REF-CANDIDATE: restoration|damage_assessment|wire_guard|tree_removal|substation_repair|switching_operations|customer_liaison|logistics_support — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:StormAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Assignment Start Timestamp' ;
    rdfs:comment 'Date and time when the storm assignment officially begins. Marks the start of storm pay eligibility and labor cost tracking for the assignment.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:assignmentStatus rdf:type rdf:Property ;
    rdfs:label 'Assignment Status' ;
    rdfs:comment 'Current lifecycle status of the storm assignment. Tracks progression from initial assignment through mobilization, active work, and demobilization phases.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:demobilizationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Demobilization Timestamp' ;
    rdfs:comment 'Date and time when the crew or technician was released from storm duty and demobilized. Marks the end of storm pay period and triggers final labor cost calculation.' ;
    rdfs:domain ind:StormAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dispatchZoneCode rdf:type rdf:Property ;
    rdfs:label 'Dispatch Zone Code' ;
    rdfs:comment 'Reference to the geographic dispatch zone where the crew or technician is assigned to work during the storm. Used for territory management and resource allocation optimization.' ;
    rdfs:domain ind:StormAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:doubleTimeHours rdf:type rdf:Property ;
    rdfs:label 'Double Time Hours' ;
    rdfs:comment 'Number of hours worked at double-time pay rate during the storm assignment. Applied for extended shifts or specific high-priority restoration work under union agreements.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedDailyCost rdf:type rdf:Property ;
    rdfs:label 'Estimated Daily Cost' ;
    rdfs:comment 'Estimated daily cost for the storm assignment including labor, equipment, lodging, and meals. Used for budget tracking and cost recovery planning. For mutual aid crews, based on EEI reimbursement rates.' ;
    rdfs:domain ind:StormAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isMutualAidCrew rdf:type rdf:Property ;
    rdfs:label 'Is Mutual Aid Crew' ;
    rdfs:comment 'Flag indicating whether this assignment is for a mutual aid crew from another utility under Edison Electric Institute (EEI) mutual aid agreements. True for external crews, False for internal utility crews.' ;
    rdfs:domain ind:StormAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lodgingLocation rdf:type rdf:Property ;
    rdfs:label 'Lodging Location' ;
    rdfs:comment 'Name and address of the hotel or facility where lodging was provided. Used for expense tracking and mutual aid cost reimbursement.' ;
    rdfs:domain ind:StormAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lodgingProvided rdf:type rdf:Property ;
    rdfs:label 'Lodging Provided' ;
    rdfs:comment 'Flag indicating whether lodging accommodations were provided for the crew or technician during the storm assignment. Relevant for mutual aid crews and extended storm response operations.' ;
    rdfs:domain ind:StormAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mealsProvidedCount rdf:type rdf:Property ;
    rdfs:label 'Meals Provided Count' ;
    rdfs:comment 'Total number of meals provided to the crew or technician during the storm assignment. Used for per diem calculation and mutual aid cost reimbursement under EEI agreements.' ;
    rdfs:domain ind:StormAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:mobilizationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Mobilization Timestamp' ;
    rdfs:comment 'Date and time when the crew or technician physically mobilized to the storm response area. Distinct from assignment start; captures actual deployment time for logistics tracking.' ;
    rdfs:domain ind:StormAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:mutualAidCrewSize rdf:type rdf:Property ;
    rdfs:label 'Mutual Aid Crew Size' ;
    rdfs:comment 'Number of personnel in the mutual aid crew. Used for lodging, meals, and logistics planning. Populated only for mutual aid assignments.' ;
    rdfs:domain ind:StormAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:mutualAidEquipmentDescription rdf:type rdf:Property ;
    rdfs:label 'Mutual Aid Equipment Description' ;
    rdfs:comment 'Description of equipment and vehicles brought by the mutual aid crew (e.g., bucket trucks, digger derricks, wire trailers). Used for asset tracking and cost reimbursement.' ;
    rdfs:domain ind:StormAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originatingUtilityCode rdf:type rdf:Property ;
    rdfs:label 'Originating Utility Code' ;
    rdfs:comment 'Standard utility identifier code for the mutual aid provider. Follows EEI utility coding standards for mutual aid coordination and billing.' ;
    rdfs:domain ind:StormAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originatingUtilityName rdf:type rdf:Property ;
    rdfs:label 'Originating Utility Name' ;
    rdfs:comment 'Name of the utility company that provided the mutual aid crew. Populated only for mutual aid assignments. Used for cost reimbursement tracking and EEI mutual aid billing.' ;
    rdfs:domain ind:StormAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overtimeHours rdf:type rdf:Property ;
    rdfs:label 'Overtime Hours' ;
    rdfs:comment 'Number of hours worked at overtime pay rate during the storm assignment. Typically hours beyond standard shift under IBEW storm pay provisions.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regularHours rdf:type rdf:Property ;
    rdfs:label 'Regular Hours' ;
    rdfs:comment 'Number of hours worked at regular pay rate during the storm assignment. Component of total hours worked for payroll and cost allocation.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reportingDepotCode rdf:type rdf:Property ;
    rdfs:label 'Reporting Depot Code' ;
    rdfs:comment 'Reference to the operations depot or staging area where the crew or technician reports for storm duty. Used for logistics coordination and resource deployment planning.' ;
    rdfs:domain ind:StormAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:safetyIncidentDescription rdf:type rdf:Property ;
    rdfs:label 'Safety Incident Description' ;
    rdfs:comment 'Detailed description of any safety incident that occurred during the storm assignment. Populated only if safety_incident_flag is True. Used for OSHA reporting and safety analysis.' ;
    rdfs:domain ind:StormAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sapHrAssignmentCode rdf:type rdf:Property ;
    rdfs:label 'Sap Hr Assignment Code' ;
    rdfs:comment 'Assignment identifier from SAP HR system used for payroll processing and labor cost accounting. Links storm assignment to SAP HR time recording and payroll modules.' ;
    rdfs:domain ind:StormAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stormPayMultiplier rdf:type rdf:Property ;
    rdfs:label 'Storm Pay Multiplier' ;
    rdfs:comment 'Pay rate multiplier applied for storm duty under union agreement provisions. Typically ranges from 1.5x to 2.5x regular rate depending on conditions and duration. Used for payroll calculation.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalHoursWorked rdf:type rdf:Property ;
    rdfs:label 'Total Hours Worked' ;
    rdfs:comment 'Total number of hours worked during the storm assignment period. Used for storm pay calculation under IBEW provisions and cost recovery filings with Public Utility Commission (PUC).' ;
    rdfs:domain ind:StormAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:wfmAssignmentExternalCode rdf:type rdf:Property ;
    rdfs:label 'Wfm Assignment External Code' ;
    rdfs:comment 'External identifier from the source Workforce Management system (ClickSoftware). Used for data integration and reconciliation between lakehouse and operational WFM system.' ;
    rdfs:domain ind:StormAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentCommanderEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Incident Commander Employee Id' ;
    rdfs:comment 'Employee identifier of the designated Incident Commander responsible for overall storm response coordination and decision-making authority.' ;
    rdfs:domain ind:StormEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:actualRestorationCostUsd rdf:type rdf:Property ;
    rdfs:label 'Actual Restoration Cost Usd' ;
    rdfs:comment 'Final actual cost in US dollars incurred for storm restoration activities. Captured after event closure for regulatory rate case filing and insurance claims.' ;
    rdfs:domain ind:StormEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualRestorationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Actual Restoration Timestamp' ;
    rdfs:comment 'Actual date and time when full service restoration was completed and all customers were restored to service.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:affectedCustomerCount rdf:type rdf:Property ;
    rdfs:label 'Affected Customer Count' ;
    rdfs:comment 'Total number of customers who experienced service interruption during the storm event. Used for SAIDI/SAIFI reliability metric calculations and regulatory reporting.' ;
    rdfs:domain ind:StormEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:affectedServiceTerritory rdf:type rdf:Property ;
    rdfs:label 'Affected Service Territory' ;
    rdfs:comment 'Geographic description of the service territory areas impacted by the storm event. May include multiple regions, districts, or the entire service territory.' ;
    rdfs:domain ind:StormEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closureNotes rdf:type rdf:Property ;
    rdfs:label 'Closure Notes' ;
    rdfs:comment 'Free-text summary of final storm event outcomes, lessons learned, and any outstanding follow-up actions required. Used for after-action review and continuous improvement.' ;
    rdfs:domain ind:StormEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractorCrewCount rdf:type rdf:Property ;
    rdfs:label 'Contractor Crew Count' ;
    rdfs:comment 'Total number of contractor crews engaged for storm restoration work under existing or emergency procurement agreements.' ;
    rdfs:domain ind:StormEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:damageAssessmentCompletedFlag rdf:type rdf:Property ;
    rdfs:label 'Damage Assessment Completed Flag' ;
    rdfs:comment 'Indicates whether comprehensive damage assessment of transmission and distribution infrastructure has been completed following the storm event.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:damageAssessmentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Damage Assessment Timestamp' ;
    rdfs:comment 'Date and time when the initial comprehensive damage assessment was completed, enabling accurate restoration time estimates.' ;
    rdfs:domain ind:StormEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:declarationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Declaration Timestamp' ;
    rdfs:comment 'Date and time when the storm event was officially declared by operations leadership, triggering emergency workforce mobilization protocols and mutual aid activation.' ;
    rdfs:domain ind:StormEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:emergencyOperationsCenterLocation rdf:type rdf:Property ;
    rdfs:label 'Emergency Operations Center Location' ;
    rdfs:comment 'Physical location or facility name where the Emergency Operations Center was established for storm event coordination.' ;
    rdfs:domain ind:StormEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedRestorationCostUsd rdf:type rdf:Property ;
    rdfs:label 'Estimated Restoration Cost Usd' ;
    rdfs:comment 'Projected total cost in US dollars for storm restoration activities including labor, materials, equipment, and mutual aid expenses. Updated as event progresses.' ;
    rdfs:domain ind:StormEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:femaDeclarationFlag rdf:type rdf:Property ;
    rdfs:label 'Fema Declaration Flag' ;
    rdfs:comment 'Indicates whether the storm event resulted in a federal disaster declaration by FEMA, enabling potential federal assistance and cost recovery.' ;
    rdfs:domain ind:StormEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:femaDeclarationNumber rdf:type rdf:Property ;
    rdfs:label 'Fema Declaration Number' ;
    rdfs:comment 'Official FEMA disaster declaration number assigned to the event if federally declared. Used for tracking federal assistance and reimbursement claims.' ;
    rdfs:domain ind:StormEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentCommandActivatedFlag rdf:type rdf:Property ;
    rdfs:label 'Incident Command Activated Flag' ;
    rdfs:comment 'Indicates whether formal Incident Command System (ICS) structure was activated for coordinated emergency response management.' ;
    rdfs:domain ind:StormEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:internalCrewCount rdf:type rdf:Property ;
    rdfs:label 'Internal Crew Count' ;
    rdfs:comment 'Total number of internal utility crews mobilized for storm response and restoration activities.' ;
    rdfs:domain ind:StormEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:mediaInquiriesCount rdf:type rdf:Property ;
    rdfs:label 'Media Inquiries Count' ;
    rdfs:comment 'Total number of media inquiries received from news organizations during the storm event, indicating public and media attention level.' ;
    rdfs:domain ind:StormEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:mutualAidActivatedFlag rdf:type rdf:Property ;
    rdfs:label 'Mutual Aid Activated Flag' ;
    rdfs:comment 'Indicates whether mutual aid resources from other utilities were requested and activated for this storm event. True when external crews are mobilized.' ;
    rdfs:domain ind:StormEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mutualAidCrewCount rdf:type rdf:Property ;
    rdfs:label 'Mutual Aid Crew Count' ;
    rdfs:comment 'Total number of external mutual aid crews deployed to support restoration efforts during the storm event.' ;
    rdfs:domain ind:StormEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:omsEventExternalCode rdf:type rdf:Property ;
    rdfs:label 'Oms Event External Code' ;
    rdfs:comment 'External system identifier from GE PowerOn Advanced OMS for linking storm event to outage records and restoration tracking.' ;
    rdfs:domain ind:StormEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:peakOutageCount rdf:type rdf:Property ;
    rdfs:label 'Peak Outage Count' ;
    rdfs:comment 'Maximum number of customers simultaneously without service at any point during the storm event. Key metric for assessing storm impact severity.' ;
    rdfs:domain ind:StormEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:publicCommunicationsIssuedCount rdf:type rdf:Property ;
    rdfs:label 'Public Communications Issued Count' ;
    rdfs:comment 'Total number of public communications (press releases, social media updates, customer notifications) issued during the storm event for customer and stakeholder awareness.' ;
    rdfs:domain ind:StormEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:regulatoryReportDueDate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Report Due Date' ;
    rdfs:comment 'Deadline date by which post-storm regulatory reports must be submitted to the Public Utility Commission per regulatory requirements.' ;
    rdfs:domain ind:StormEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryReportSubmittedFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Report Submitted Flag' ;
    rdfs:comment 'Indicates whether required post-storm regulatory reports have been submitted to the Public Utility Commission or other regulatory authorities.' ;
    rdfs:domain ind:StormEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:saidiExclusionEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Saidi Exclusion Eligible Flag' ;
    rdfs:comment 'Indicates whether this storm event qualifies for exclusion from SAIDI reliability metric calculations under IEEE 1366 major event day (MED) criteria or regulatory commission rules.' ;
    rdfs:domain ind:StormEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:saifiExclusionEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Saifi Exclusion Eligible Flag' ;
    rdfs:comment 'Indicates whether this storm event qualifies for exclusion from SAIFI reliability metric calculations under IEEE 1366 major event day (MED) criteria or regulatory commission rules.' ;
    rdfs:domain ind:StormEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stateEmergencyDeclarationFlag rdf:type rdf:Property ;
    rdfs:label 'State Emergency Declaration Flag' ;
    rdfs:comment 'Indicates whether the state governor declared a state of emergency for this storm event, which may trigger regulatory reporting requirements and cost recovery provisions.' ;
    rdfs:domain ind:StormEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stormEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Storm End Timestamp' ;
    rdfs:comment 'Actual or forecasted date and time when the storm conditions ended or are expected to end in the service territory.' ;
    rdfs:domain ind:StormEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:stormEventCode rdf:type rdf:Property ;
    rdfs:label 'Storm Event Code' ;
    rdfs:comment 'Business identifier code assigned to the storm event for external reference and communication with mutual aid partners, regulatory agencies, and internal systems.' ;
    rdfs:domain ind:StormEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stormSeverityLevel rdf:type rdf:Property ;
    rdfs:label 'Storm Severity Level' ;
    rdfs:comment 'Numeric severity classification from 1 (minor) to 5 (catastrophic) that determines the scale of workforce mobilization, mutual aid activation, and executive escalation. Aligns with company emergency response plan tiers.' ;
    rdfs:domain ind:StormEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:stormStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Storm Start Timestamp' ;
    rdfs:comment 'Actual or forecasted date and time when the storm conditions began or are expected to begin impacting the service territory.' ;
    rdfs:domain ind:StormEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:stormStatus rdf:type rdf:Property ;
    rdfs:label 'Storm Status' ;
    rdfs:comment 'Current lifecycle status of the storm event indicating the phase of emergency response and workforce mobilization.' ;
    rdfs:domain ind:StormEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stormType rdf:type rdf:Property ;
    rdfs:label 'Storm Type' ;
    rdfs:comment 'Classification of the storm or emergency event type that determines response protocols and resource mobilization strategies. [ENUM-REF-CANDIDATE: hurricane|tropical_storm|ice_storm|winter_storm|thunderstorm|tornado|derecho|noreaster|flood|wildfire|earthquake|other — 12 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:StormEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalCrewHours rdf:type rdf:Property ;
    rdfs:label 'Total Crew Hours' ;
    rdfs:comment 'Cumulative labor hours worked by all crews (internal, mutual aid, and contractor) during the storm event. Used for cost tracking and resource utilization analysis.' ;
    rdfs:domain ind:StormEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:weatherForecastSource rdf:type rdf:Property ;
    rdfs:label 'Weather Forecast Source' ;
    rdfs:comment 'Name of the meteorological service or vendor providing weather forecasting data for storm event planning and response (e.g., National Weather Service, DTN, Weather Company).' ;
    rdfs:domain ind:StormEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wfmStormEventExternalCode rdf:type rdf:Property ;
    rdfs:label 'Wfm Storm Event External Code' ;
    rdfs:comment 'External system identifier from ClickSoftware Workforce Management system for cross-system reconciliation and integration.' ;
    rdfs:domain ind:StormEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:baseLocationCode rdf:type rdf:Property ;
    rdfs:label 'Base Location Code' ;
    rdfs:comment 'The code identifying the technician\'s primary assigned service center, depot, or yard from which they are dispatched. Used for crew scheduling, travel time calculations, and storm response staging. Sourced from ClickSoftware WFM and SAP HR Infotype 0001 (Organizational Assignment).' ;
    rdfs:domain ind:Technician ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cdlLicenseClass rdf:type rdf:Property ;
    rdfs:label 'Cdl License Class' ;
    rdfs:comment 'The class of Commercial Driver\'s License (CDL) held by the technician, if any. Required for operating heavy utility vehicles, bucket trucks, and line equipment. Class A covers combination vehicles; Class B covers single heavy vehicles; Class C covers smaller commercial vehicles. Sourced from SAP HR.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clicksoftwareResourceCode rdf:type rdf:Property ;
    rdfs:label 'Clicksoftware Resource Code' ;
    rdfs:comment 'The resource identifier assigned to the technician in ClickSoftware Workforce Management (WFM). Used for scheduling, dispatch, and mobile workforce coordination. Enables bi-directional synchronization between the Silver Layer and the WFM system.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:craftType rdf:type rdf:Property ;
    rdfs:label 'Craft Type' ;
    rdfs:comment 'The skilled trade or craft classification of the field technician, defining the type of work they are qualified to perform (e.g., Lineworker, Meter Reader, Gas Technician, T&D Construction, Field Service Technician, Substation Technician). Sourced from SAP HR and ClickSoftware WFM resource profile. [ENUM-REF-CANDIDATE: lineworker|meter_reader|gas_technician|td_construction|field_service|substation_technician|cable_splicer|relay_technician — promote to reference product]' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispatchEligible rdf:type rdf:Property ;
    rdfs:label 'Dispatch Eligible' ;
    rdfs:comment 'Indicates whether the technician is currently eligible to be dispatched for field work assignments. Set to False when the technician is on leave, suspended, lacks required active certifications, or has a safety hold. Evaluated by ClickSoftware WFM during scheduling.' ;
    rdfs:domain ind:Technician ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:drugTestDate rdf:type rdf:Property ;
    rdfs:label 'Drug Test Date' ;
    rdfs:comment 'The date the technician\'s most recent drug and alcohol test was administered. Used to enforce testing frequency requirements for safety-sensitive roles under DOT and PHMSA regulations.' ;
    rdfs:domain ind:Technician ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:drugTestStatus rdf:type rdf:Property ;
    rdfs:label 'Drug Test Status' ;
    rdfs:comment 'The current status of the technician\'s most recent DOT or company-mandated drug and alcohol test. Required for safety-sensitive positions operating heavy equipment or working on energized electrical infrastructure. Sourced from SAP HR or third-party testing system.' ;
    rdfs:domain ind:Technician ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employmentStatus rdf:type rdf:Property ;
    rdfs:label 'Employment Status' ;
    rdfs:comment 'Current lifecycle status of the technician\'s employment relationship with the utility. Drives eligibility for dispatch, scheduling, and access to operational systems. Sourced from SAP HR Infotype 0000 (Actions).' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employmentType rdf:type rdf:Property ;
    rdfs:label 'Employment Type' ;
    rdfs:comment 'Classification of the technician\'s employment arrangement with the utility. Determines eligibility for union agreements, overtime rules, and benefit entitlements. Sourced from SAP HR Infotype 0001.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ethnicityCode rdf:type rdf:Property ;
    rdfs:label 'Ethnicity Code' ;
    rdfs:comment 'The self-reported ethnicity classification of the technician per EEO-1 reporting categories. Used for federal EEO regulatory reporting and workforce diversity analytics. Sourced from SAP HR. [ENUM-REF-CANDIDATE: white|black_african_american|hispanic_latino|asian|native_american|pacific_islander|two_or_more|not_disclosed — promote to reference product]' ;
    rdfs:domain ind:Technician ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hourlyRate rdf:type rdf:Property ;
    rdfs:label 'Hourly Rate' ;
    rdfs:comment 'The technician\'s current base hourly wage rate in USD. Used for labor cost allocation to work orders, CAPEX vs OPEX labor tracking, and regulatory rate case (GRC) labor cost filings. Sourced from SAP HR Infotype 0008. Classified as confidential.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastOshaTrainingDate rdf:type rdf:Property ;
    rdfs:label 'Last Osha Training Date' ;
    rdfs:comment 'The date the technician most recently completed required OSHA safety training (e.g., OSHA 10, OSHA 30, or utility-specific electrical safety training per 29 CFR 1910.269). Used to enforce training currency requirements and trigger recertification workflows.' ;
    rdfs:domain ind:Technician ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nercCipAccessLevel rdf:type rdf:Property ;
    rdfs:label 'Nerc Cip Access Level' ;
    rdfs:comment 'The level of NERC CIP-authorized access granted to the technician for Bulk Electric System (BES) critical infrastructure. Determines eligibility for work assignments at substations and control facilities subject to NERC CIP-004 personnel risk assessment requirements.' ;
    rdfs:domain ind:Technician ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nercCipBackgroundCheckDate rdf:type rdf:Property ;
    rdfs:label 'Nerc Cip Background Check Date' ;
    rdfs:comment 'The date the technician\'s most recent NERC CIP-004 personnel risk assessment (background check) was completed. Required for access to BES critical cyber assets and physical security perimeters. Must be renewed per NERC CIP-004 requirements.' ;
    rdfs:domain ind:Technician ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:orgUnitCode rdf:type rdf:Property ;
    rdfs:label 'Org Unit Code' ;
    rdfs:comment 'The SAP HR organizational unit (department or work group) to which the technician belongs. Defines the reporting hierarchy for workforce planning, headcount reporting, and regulatory labor filings. Sourced from SAP HR Infotype 0001.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:oshaQualified rdf:type rdf:Property ;
    rdfs:label 'Osha Qualified' ;
    rdfs:comment 'Indicates whether the technician holds current OSHA qualification status required for field work on electrical or gas infrastructure. Derived from active OSHA training certifications. Critical gate for dispatch eligibility on T&D and O&M work orders.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:oshaTrainingExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Osha Training Expiration Date' ;
    rdfs:comment 'The date on which the technician\'s current OSHA safety training certification expires. When this date is reached, dispatch_eligible is set to False until recertification is completed. Critical for OSHA 29 CFR 1910.269 compliance.' ;
    rdfs:domain ind:Technician ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:primarySkillCode rdf:type rdf:Property ;
    rdfs:label 'Primary Skill Code' ;
    rdfs:comment 'The primary technical skill code assigned to the technician in ClickSoftware WFM, used as the dominant matching criterion for work order assignment and crew scheduling. Aligns with the WFM skill catalog (e.g., OH_LINE_CONSTRUCTION, UG_CABLE_SPLICE, GAS_MAIN_REPAIR, AMI_METER_INSTALL). Sourced from ClickSoftware WFM resource profile.' ;
    rdfs:domain ind:Technician ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sapPersonnelNumber rdf:type rdf:Property ;
    rdfs:label 'Sap Personnel Number' ;
    rdfs:comment 'The unique personnel number assigned to the technician in SAP HR (Infotype 0000). This is the authoritative source-system identifier used to cross-reference payroll, benefits, and HR master data in SAP ERP. Distinct from the surrogate technician_id.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:secondarySkillCodes rdf:type rdf:Property ;
    rdfs:label 'Secondary Skill Codes' ;
    rdfs:comment 'Comma-separated list of secondary skill codes from the ClickSoftware WFM skill catalog that the technician is qualified to perform beyond their primary skill. Enables flexible multi-skill dispatch during storm response and peak demand periods. Sourced from ClickSoftware WFM.' ;
    rdfs:domain ind:Technician ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stormResponseTier rdf:type rdf:Property ;
    rdfs:label 'Storm Response Tier' ;
    rdfs:comment 'The emergency storm response mobilization tier assigned to the technician, defining their priority and role during major outage events. Tier 1 = immediate first responders; Tier 2 = secondary wave; Tier 3 = support/logistics; Exempt = not required for storm duty. Used by OMS and ClickSoftware WFM for emergency staffing.' ;
    rdfs:domain ind:Technician ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supervisorPersonnelNumber rdf:type rdf:Property ;
    rdfs:label 'Supervisor Personnel Number' ;
    rdfs:comment 'The SAP personnel number of the technician\'s direct supervisor or crew foreman. Used for approval workflows, OSHA incident reporting chain of command, and dispatch escalation. Sourced from SAP HR Infotype 0001 (Organizational Assignment).' ;
    rdfs:domain ind:Technician ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:travelRadiusMiles rdf:type rdf:Property ;
    rdfs:label 'Travel Radius Miles' ;
    rdfs:comment 'The maximum travel radius in miles from the technician\'s base location that they are contractually or operationally authorized to travel for work assignments under normal (non-storm) conditions. Used by ClickSoftware WFM for geographic dispatch optimization.' ;
    rdfs:domain ind:Technician ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unionAffiliation rdf:type rdf:Property ;
    rdfs:label 'Union Affiliation' ;
    rdfs:comment 'The labor union to which the technician belongs, if any. Drives application of collective bargaining agreement (CBA) rules for scheduling, overtime, dispatch priority, and grievance management. Common affiliations include IBEW (International Brotherhood of Electrical Workers) and UWUA (Utility Workers Union of America). Sourced from SAP HR Infotype 0011.' ;
    rdfs:domain ind:Technician ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vehicleAssignmentCode rdf:type rdf:Property ;
    rdfs:label 'Vehicle Assignment Code' ;
    rdfs:comment 'The fleet asset code of the utility vehicle (bucket truck, service van, digger derrick, etc.) currently assigned to the technician for field operations. Used for fleet management, GPS tracking integration, and work order costing. Sourced from Maximo EAM or fleet management system.' ;
    rdfs:domain ind:Technician ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workScheduleCode rdf:type rdf:Property ;
    rdfs:label 'Work Schedule Code' ;
    rdfs:comment 'The SAP HR work schedule rule code defining the technician\'s standard shift pattern (e.g., 4x10, 5x8, rotating shift, on-call). Drives ClickSoftware WFM availability windows, overtime eligibility, and CBA compliance for scheduling. Sourced from SAP HR Infotype 0007.' ;
    rdfs:domain ind:Technician ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workerClassification rdf:type rdf:Property ;
    rdfs:label 'Worker Classification' ;
    rdfs:comment 'The hierarchical skill and responsibility classification of the technician within their craft. Determines pay grade, work assignment eligibility, and supervisory authority on crew dispatches. Sourced from SAP HR Infotype 0001 and union agreement tables.' ;
    rdfs:domain ind:Technician ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:technicianQualificationId rdf:type rdf:Property ;
    rdfs:label 'Technician Qualification Id' ;
    rdfs:comment 'Unique identifier for the technician qualification record. Primary key.' ;
    rdfs:domain ind:TechnicianQualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assessmentScore rdf:type rdf:Property ;
    rdfs:label 'Assessment Score' ;
    rdfs:comment 'Numeric score or percentage achieved on the qualification assessment or examination. Null if no scored assessment was required.' ;
    rdfs:domain ind:TechnicianQualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:certificateNumber rdf:type rdf:Property ;
    rdfs:label 'Certificate Number' ;
    rdfs:comment 'Unique certificate or credential number assigned by the certifying body. Used for verification and audit purposes.' ;
    rdfs:domain ind:TechnicianQualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certifyingBody rdf:type rdf:Property ;
    rdfs:label 'Certifying Body' ;
    rdfs:comment 'Name of the organization, agency, or institution that issued the qualification (e.g., OSHA, NERC, PHMSA, state licensing board, equipment manufacturer, internal training department).' ;
    rdfs:domain ind:TechnicianQualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:continuingEducationCredits rdf:type rdf:Property ;
    rdfs:label 'Continuing Education Credits' ;
    rdfs:comment 'Number of continuing education units (CEUs) or professional development hours earned through this qualification. Used for license maintenance and career development tracking.' ;
    rdfs:domain ind:TechnicianQualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Cost Currency Code' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the qualification cost. Defaults to USD for domestic operations.' ;
    rdfs:domain ind:TechnicianQualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispatchEligibilityFlag rdf:type rdf:Property ;
    rdfs:label 'Dispatch Eligibility Flag' ;
    rdfs:comment 'Indicates whether this qualification enables the technician to be dispatched for specific work order types in ClickSoftware. True if qualification is used for skill-based dispatch matching.' ;
    rdfs:domain ind:TechnicianQualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:equipmentAuthorization rdf:type rdf:Property ;
    rdfs:label 'Equipment Authorization' ;
    rdfs:comment 'Description of specialized equipment, tools, or vehicles the technician is authorized to operate based on this qualification (e.g., bucket truck, directional drill, live-line tools).' ;
    rdfs:domain ind:TechnicianQualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:instructorName rdf:type rdf:Property ;
    rdfs:label 'Instructor Name' ;
    rdfs:comment 'Name of the primary instructor or trainer who delivered the qualification training. Used for training quality assessment and instructor evaluation.' ;
    rdfs:domain ind:TechnicianQualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastRenewalDate rdf:type rdf:Property ;
    rdfs:label 'Last Renewal Date' ;
    rdfs:comment 'Most recent date on which the qualification was renewed or recertified. Null if never renewed since original issue.' ;
    rdfs:domain ind:TechnicianQualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextRenewalDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Renewal Due Date' ;
    rdfs:comment 'Scheduled date by which the qualification must be renewed to maintain compliance. Used to trigger proactive renewal workflows and alerts.' ;
    rdfs:domain ind:TechnicianQualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:passingScoreThreshold rdf:type rdf:Property ;
    rdfs:label 'Passing Score Threshold' ;
    rdfs:comment 'Minimum score required to pass the qualification assessment. Used to validate qualification attainment.' ;
    rdfs:domain ind:TechnicianQualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:proficiencyLevel rdf:type rdf:Property ;
    rdfs:label 'Proficiency Level' ;
    rdfs:comment 'Assessed skill level or proficiency tier for this qualification, used for work assignment complexity matching and career development planning.' ;
    rdfs:domain ind:TechnicianQualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryRequirementFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Requirement Flag' ;
    rdfs:comment 'Indicates whether this qualification is mandated by federal, state, or industry regulatory bodies (OSHA, NERC CIP, PHMSA OQ, PUC requirements). True for mandatory qualifications.' ;
    rdfs:domain ind:TechnicianQualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:renewalNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Renewal Notification Date' ;
    rdfs:comment 'Date on which the renewal reminder notification was sent. Null if no notification has been sent.' ;
    rdfs:domain ind:TechnicianQualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:renewalNotificationSentFlag rdf:type rdf:Property ;
    rdfs:label 'Renewal Notification Sent Flag' ;
    rdfs:comment 'Indicates whether a renewal reminder notification has been sent to the technician and their supervisor. True once notification is dispatched.' ;
    rdfs:domain ind:TechnicianQualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:trainingCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Training Completion Date' ;
    rdfs:comment 'Date on which the technician completed the required training or assessment for this qualification. May precede the issue date.' ;
    rdfs:domain ind:TechnicianQualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:trainingHours rdf:type rdf:Property ;
    rdfs:label 'Training Hours' ;
    rdfs:comment 'Total number of training hours completed to earn this qualification. Used for continuing education tracking and regulatory reporting.' ;
    rdfs:domain ind:TechnicianQualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:trainingLocation rdf:type rdf:Property ;
    rdfs:label 'Training Location' ;
    rdfs:comment 'Physical or virtual location where the qualification training was conducted (facility name, city, or online platform).' ;
    rdfs:domain ind:TechnicianQualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trainingProvider rdf:type rdf:Property ;
    rdfs:label 'Training Provider' ;
    rdfs:comment 'Name of the organization or vendor that delivered the training or assessment leading to this qualification (may differ from certifying body).' ;
    rdfs:domain ind:TechnicianQualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unionRequirementFlag rdf:type rdf:Property ;
    rdfs:label 'Union Requirement Flag' ;
    rdfs:comment 'Indicates whether this qualification is required by collective bargaining agreement or union contract provisions. True for union-mandated qualifications.' ;
    rdfs:domain ind:TechnicianQualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:verifiedBy rdf:type rdf:Property ;
    rdfs:label 'Verified By' ;
    rdfs:comment 'Name or identifier of the person or system that verified the authenticity and validity of this qualification record.' ;
    rdfs:domain ind:TechnicianQualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workTypeAuthorization rdf:type rdf:Property ;
    rdfs:label 'Work Type Authorization' ;
    rdfs:comment 'Comma-separated list or description of work order types, task categories, or job classifications that this qualification authorizes the technician to perform (e.g., high-voltage switching, gas main repair, confined space entry).' ;
    rdfs:domain ind:TechnicianQualification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timeEntryId rdf:type rdf:Property ;
    rdfs:label 'Time Entry Id' ;
    rdfs:comment 'Unique identifier for the time entry record. Primary key.' ;
    rdfs:domain ind:TimeEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:approvingUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Approving User Employee Id' ;
    rdfs:comment 'Identifier of the user (supervisor or timekeeper) who approved the time entry.' ;
    rdfs:domain ind:TimeEntry ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:primaryTimeTechnicianId rdf:type rdf:Property ;
    rdfs:label 'Primary Time Technician Id' ;
    rdfs:comment 'Identifier of the technician or field worker who performed the work. Links to workforce personnel master data.' ;
    rdfs:domain ind:TimeEntry ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Technician .

ind:tertiaryTimeApprovingUserTechnicianId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Time Approving User Technician Id' ;
    rdfs:comment 'Identifier of the user (supervisor or timekeeper) who approved the time entry.' ;
    rdfs:domain ind:TimeEntry ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Technician .

ind:authorizationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Authorization Timestamp' ;
    rdfs:comment 'Date and time when overtime authorization was granted by the supervisor.' ;
    rdfs:domain ind:TimeEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:estimatedHours rdf:type rdf:Property ;
    rdfs:label 'Estimated Hours' ;
    rdfs:comment 'Estimated hours submitted during overtime pre-authorization request, used for variance analysis against actual hours.' ;
    rdfs:domain ind:TimeEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:geographicLocationCode rdf:type rdf:Property ;
    rdfs:label 'Geographic Location Code' ;
    rdfs:comment 'Code identifying the geographic location or service territory where the work was performed, used for regional cost allocation.' ;
    rdfs:domain ind:TimeEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:laborCostClassification rdf:type rdf:Property ;
    rdfs:label 'Labor Cost Classification' ;
    rdfs:comment 'Classification of labor cost as CAPEX (capital expenditure for new construction), OPEX (operating expenditure for maintenance), or specific categories like emergency or storm response.' ;
    rdfs:domain ind:TimeEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mobileCaptureFlag rdf:type rdf:Property ;
    rdfs:label 'Mobile Capture Flag' ;
    rdfs:comment 'Indicates whether the time entry was captured via mobile device in the field using ClickSoftware mobile workforce application.' ;
    rdfs:domain ind:TimeEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:onCallHours rdf:type rdf:Property ;
    rdfs:label 'On Call Hours' ;
    rdfs:comment 'Number of hours in on-call status, available for emergency dispatch with on-call premium pay per union agreement.' ;
    rdfs:domain ind:TimeEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overtimeAuthorizationRequired rdf:type rdf:Property ;
    rdfs:label 'Overtime Authorization Required' ;
    rdfs:comment 'Indicates whether pre-authorization was required for overtime hours per company policy or union agreement.' ;
    rdfs:domain ind:TimeEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overtimeAuthorizationStatus rdf:type rdf:Property ;
    rdfs:label 'Overtime Authorization Status' ;
    rdfs:comment 'Status of overtime pre-authorization: not required, pending approval, approved, denied, or retroactively authorized.' ;
    rdfs:domain ind:TimeEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payCode rdf:type rdf:Property ;
    rdfs:label 'Pay Code' ;
    rdfs:comment 'Payroll code indicating the type of time and applicable pay rate (e.g., REG for regular, OT for overtime, DT for double-time, TRV for travel).' ;
    rdfs:domain ind:TimeEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payrollPeriod rdf:type rdf:Property ;
    rdfs:label 'Payroll Period' ;
    rdfs:comment 'Payroll period identifier (e.g., 2024-03-W2 for week 2 of March 2024) to which this time entry belongs for wage calculation.' ;
    rdfs:domain ind:TimeEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payrollPostingDate rdf:type rdf:Property ;
    rdfs:label 'Payroll Posting Date' ;
    rdfs:comment 'Date when the time entry was posted to payroll for wage calculation and payment processing.' ;
    rdfs:domain ind:TimeEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:standbyHours rdf:type rdf:Property ;
    rdfs:label 'Standby Hours' ;
    rdfs:comment 'Number of hours on standby or ready-to-respond status, typically for emergency response crews with standby pay provisions.' ;
    rdfs:domain ind:TimeEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:timeEntryNumber rdf:type rdf:Property ;
    rdfs:label 'Time Entry Number' ;
    rdfs:comment 'Human-readable business identifier for the time entry, typically system-generated for reference and audit purposes.' ;
    rdfs:domain ind:TimeEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timeEntryStatus rdf:type rdf:Property ;
    rdfs:label 'Time Entry Status' ;
    rdfs:comment 'Current lifecycle status of the time entry: draft (not submitted), submitted (pending approval), approved, rejected, posted (to payroll), or cancelled.' ;
    rdfs:domain ind:TimeEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timeType rdf:type rdf:Property ;
    rdfs:label 'Time Type' ;
    rdfs:comment 'Classification of time entry as productive (direct work), non-productive (downtime), indirect (support), administrative, or training.' ;
    rdfs:domain ind:TimeEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalHours rdf:type rdf:Property ;
    rdfs:label 'Total Hours' ;
    rdfs:comment 'Total hours recorded across all time categories (regular, overtime, double-time, travel, standby, on-call) for the time entry.' ;
    rdfs:domain ind:TimeEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:travelHours rdf:type rdf:Property ;
    rdfs:label 'Travel Hours' ;
    rdfs:comment 'Number of hours spent traveling to and from work sites, compensable per union agreement or company policy.' ;
    rdfs:domain ind:TimeEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:workActivityCode rdf:type rdf:Property ;
    rdfs:label 'Work Activity Code' ;
    rdfs:comment 'Code identifying the specific type of work activity performed (e.g., line repair, meter installation, vegetation management, substation maintenance).' ;
    rdfs:domain ind:TimeEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workDate rdf:type rdf:Property ;
    rdfs:label 'Work Date' ;
    rdfs:comment 'The calendar date on which the work was performed. Used for payroll period determination and labor cost allocation.' ;
    rdfs:domain ind:TimeEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:agreementName rdf:type rdf:Property ;
    rdfs:label 'Agreement Name' ;
    rdfs:comment 'Full legal name of the collective bargaining agreement, typically including union name and jurisdiction.' ;
    rdfs:domain ind:UnionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:arbitrationProvisionFlag rdf:type rdf:Property ;
    rdfs:label 'Arbitration Provision Flag' ;
    rdfs:comment 'Indicates whether the agreement includes binding arbitration as the final step in grievance resolution. True if arbitration is included, False otherwise.' ;
    rdfs:domain ind:UnionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bargainingUnit rdf:type rdf:Property ;
    rdfs:label 'Bargaining Unit' ;
    rdfs:comment 'Description of the employee group covered by this agreement, such as field technicians, lineworkers, meter readers, or substation operators.' ;
    rdfs:domain ind:UnionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:baseWageIncreasePct rdf:type rdf:Property ;
    rdfs:label 'Base Wage Increase Pct' ;
    rdfs:comment 'Percentage increase in base wages negotiated in this agreement, expressed as a decimal (e.g., 3.50 for 3.5% increase).' ;
    rdfs:domain ind:UnionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:calloutResponseTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Callout Response Time Minutes' ;
    rdfs:comment 'Maximum number of minutes within which an employee must respond to a call-out notification, as specified in the agreement.' ;
    rdfs:domain ind:UnionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:coveredEmployeeCount rdf:type rdf:Property ;
    rdfs:label 'Covered Employee Count' ;
    rdfs:comment 'Number of employees covered under this collective bargaining agreement at the time of ratification or most recent count.' ;
    rdfs:domain ind:UnionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:documentReferenceUrl rdf:type rdf:Property ;
    rdfs:label 'Document Reference Url' ;
    rdfs:comment 'URL or file path to the full legal text of the collective bargaining agreement document stored in the document management system.' ;
    rdfs:domain ind:UnionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:duesCheckoffFlag rdf:type rdf:Property ;
    rdfs:label 'Dues Checkoff Flag' ;
    rdfs:comment 'Indicates whether the employer agrees to deduct union dues from employee paychecks and remit to the union. True if dues checkoff is authorized, False otherwise.' ;
    rdfs:domain ind:UnionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:grievanceProcedureSteps rdf:type rdf:Property ;
    rdfs:label 'Grievance Procedure Steps' ;
    rdfs:comment 'Detailed description of the formal grievance resolution process defined in the agreement, including escalation steps, timelines, and arbitration provisions.' ;
    rdfs:domain ind:UnionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:healthBenefitsSummary rdf:type rdf:Property ;
    rdfs:label 'Health Benefits Summary' ;
    rdfs:comment 'Summary of health insurance, medical benefits, and wellness programs provided under this agreement, including employer contribution levels and coverage tiers.' ;
    rdfs:domain ind:UnionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdictionDescription rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Description' ;
    rdfs:comment 'Geographic or operational scope defining where this agreement applies, such as specific service territories, facilities, or operational divisions.' ;
    rdfs:domain ind:UnionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:layoffRecallProvisions rdf:type rdf:Property ;
    rdfs:label 'Layoff Recall Provisions' ;
    rdfs:comment 'Detailed provisions governing workforce reductions, layoff procedures, bumping rights, and recall procedures based on seniority and qualifications.' ;
    rdfs:domain ind:UnionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:managementRightsClause rdf:type rdf:Property ;
    rdfs:label 'Management Rights Clause' ;
    rdfs:comment 'Statement of rights reserved to management that are not subject to collective bargaining, such as operational decisions, technology adoption, and business strategy.' ;
    rdfs:domain ind:UnionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:negotiatingTeamLead rdf:type rdf:Property ;
    rdfs:label 'Negotiating Team Lead' ;
    rdfs:comment 'Name of the primary management representative who led negotiations for this agreement.' ;
    rdfs:domain ind:UnionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:negotiationEndDate rdf:type rdf:Property ;
    rdfs:label 'Negotiation End Date' ;
    rdfs:comment 'Date when formal negotiations concluded with agreement reached or impasse declared.' ;
    rdfs:domain ind:UnionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:negotiationStartDate rdf:type rdf:Property ;
    rdfs:label 'Negotiation Start Date' ;
    rdfs:comment 'Date when formal negotiations for this agreement began between management and union representatives.' ;
    rdfs:domain ind:UnionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:noStrikeClauseFlag rdf:type rdf:Property ;
    rdfs:label 'No Strike Clause Flag' ;
    rdfs:comment 'Indicates whether the agreement includes a no-strike provision prohibiting work stoppages during the term of the agreement. True if no-strike clause exists, False otherwise.' ;
    rdfs:domain ind:UnionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pensionContributionPct rdf:type rdf:Property ;
    rdfs:label 'Pension Contribution Pct' ;
    rdfs:comment 'Percentage of wages contributed by employer to pension or retirement plan on behalf of covered employees, as specified in the agreement.' ;
    rdfs:domain ind:UnionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ratificationDate rdf:type rdf:Property ;
    rdfs:label 'Ratification Date' ;
    rdfs:comment 'Date when union membership voted to approve and ratify the collective bargaining agreement.' ;
    rdfs:domain ind:UnionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:safetyTrainingRequirements rdf:type rdf:Property ;
    rdfs:label 'Safety Training Requirements' ;
    rdfs:comment 'Mandatory safety training and certification requirements specified in the agreement for covered employees, aligned with OSHA and NERC standards.' ;
    rdfs:domain ind:UnionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seniorityRules rdf:type rdf:Property ;
    rdfs:label 'Seniority Rules' ;
    rdfs:comment 'Description of how seniority is calculated, applied, and used for purposes such as shift bidding, layoff order, recall rights, and vacation scheduling.' ;
    rdfs:domain ind:UnionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shiftDifferentialPct rdf:type rdf:Property ;
    rdfs:label 'Shift Differential Pct' ;
    rdfs:comment 'Percentage premium added to base wage for non-standard shifts such as evening, night, or weekend shifts.' ;
    rdfs:domain ind:UnionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sickLeaveAccrualRate rdf:type rdf:Property ;
    rdfs:label 'Sick Leave Accrual Rate' ;
    rdfs:comment 'Rate at which sick leave accrues for covered employees, typically expressed as hours per pay period or days per year.' ;
    rdfs:domain ind:UnionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stormPayTriggerConditions rdf:type rdf:Property ;
    rdfs:label 'Storm Pay Trigger Conditions' ;
    rdfs:comment 'Specific conditions or criteria that must be met to activate storm pay provisions, such as declaration of emergency by management or threshold of outages.' ;
    rdfs:domain ind:UnionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subcontractingRestrictions rdf:type rdf:Property ;
    rdfs:label 'Subcontracting Restrictions' ;
    rdfs:comment 'Limitations or conditions on the company\'s ability to subcontract work normally performed by bargaining unit members, including notification and consultation requirements.' ;
    rdfs:domain ind:UnionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unionAgreementStatus rdf:type rdf:Property ;
    rdfs:label 'Union Agreement Status' ;
    rdfs:comment 'Current lifecycle state of the collective bargaining agreement: draft (being prepared), active (in force), expired (past end date), terminated (ended early), under_negotiation (being renegotiated), or ratified (approved but not yet effective).' ;
    rdfs:domain ind:UnionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unionName rdf:type rdf:Property ;
    rdfs:label 'Union Name' ;
    rdfs:comment 'Full name of the labor union or trade organization party to this agreement, such as International Brotherhood of Electrical Workers (IBEW).' ;
    rdfs:domain ind:UnionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unionRepresentativeName rdf:type rdf:Property ;
    rdfs:label 'Union Representative Name' ;
    rdfs:comment 'Name of the primary union representative or business agent who led negotiations on behalf of the union.' ;
    rdfs:domain ind:UnionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unionSecurityClause rdf:type rdf:Property ;
    rdfs:label 'Union Security Clause' ;
    rdfs:comment 'Type of union membership or dues requirement for employees in the bargaining unit: open_shop (voluntary), union_shop (must join), agency_shop (must pay fees), closed_shop (must be member before hire), or right_to_work (no requirement).' ;
    rdfs:domain ind:UnionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vacationAccrualRate rdf:type rdf:Property ;
    rdfs:label 'Vacation Accrual Rate' ;
    rdfs:comment 'Rate at which vacation time accrues for covered employees, typically expressed as hours per pay period or days per year based on seniority.' ;
    rdfs:domain ind:UnionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:wageScaleStructure rdf:type rdf:Property ;
    rdfs:label 'Wage Scale Structure' ;
    rdfs:comment 'Description of the wage classification system and pay scales defined in the agreement, including job classifications, step progressions, and rate tables.' ;
    rdfs:domain ind:UnionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workRulesSummary rdf:type rdf:Property ;
    rdfs:label 'Work Rules Summary' ;
    rdfs:comment 'Summary of key work rules and operational provisions defined in the agreement, including jurisdictional boundaries, crew composition requirements, and work assignment protocols.' ;
    rdfs:domain ind:UnionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workOrderAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Work Order Assignment Id' ;
    rdfs:comment 'Unique identifier for the work order assignment record. Primary key for this transactional dispatch entity linking workforce resources to work execution tasks.' ;
    rdfs:domain ind:WorkOrderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actualArrivalTimestamp rdf:type rdf:Property ;
    rdfs:label 'Actual Arrival Timestamp' ;
    rdfs:comment 'Actual date and time when the technician or crew arrived at the work site, typically captured via mobile device GPS or manual check-in. Used for SLA compliance tracking and labor costing.' ;
    rdfs:domain ind:WorkOrderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:actualDepartureTimestamp rdf:type rdf:Property ;
    rdfs:label 'Actual Departure Timestamp' ;
    rdfs:comment 'Actual date and time when the technician or crew departed the work site, typically captured via mobile device. Used for travel time calculation and next-assignment routing.' ;
    rdfs:domain ind:WorkOrderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:cancellationReasonCode rdf:type rdf:Property ;
    rdfs:label 'Cancellation Reason Code' ;
    rdfs:comment 'Code identifying the reason for assignment cancellation when status is cancelled. Used for operational analysis and process improvement. Nullable when assignment is not cancelled. [ENUM-REF-CANDIDATE: customer_cancelled|weather|equipment_unavailable|crew_unavailable|duplicate|work_completed_by_other — promote to reference product]' ;
    rdfs:domain ind:WorkOrderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Certification Required Flag' ;
    rdfs:comment 'Indicates whether specific certifications or qualifications are required for this assignment (e.g., OSHA safety training, CDL, confined space entry). True when certifications are mandatory, False otherwise.' ;
    rdfs:domain ind:WorkOrderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:customerAppointmentFlag rdf:type rdf:Property ;
    rdfs:label 'Customer Appointment Flag' ;
    rdfs:comment 'Indicates whether this assignment requires a scheduled customer appointment or access to customer premises. True when customer coordination is required, False for utility-side work. Used for appointment window tracking and customer communication.' ;
    rdfs:domain ind:WorkOrderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:equipmentRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Equipment Required Flag' ;
    rdfs:comment 'Indicates whether specialized equipment or vehicles are required for this assignment (e.g., bucket truck, digger derrick, cable splicer). True when special equipment is needed, False for standard assignments.' ;
    rdfs:domain ind:WorkOrderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mobileAcknowledgmentFlag rdf:type rdf:Property ;
    rdfs:label 'Mobile Acknowledgment Flag' ;
    rdfs:comment 'Indicates whether the technician acknowledged receipt of the assignment via mobile device. True when acknowledged, False when not yet acknowledged. Used for dispatch confirmation and communication tracking.' ;
    rdfs:domain ind:WorkOrderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mobileAcknowledgmentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Mobile Acknowledgment Timestamp' ;
    rdfs:comment 'Date and time when the technician acknowledged the assignment via mobile device. Used for response time tracking and dispatcher confirmation.' ;
    rdfs:domain ind:WorkOrderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:onSiteDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'On Site Duration Minutes' ;
    rdfs:comment 'Total time in minutes spent on site from arrival to departure. Calculated as the difference between actual departure and actual arrival timestamps. Used for labor costing and productivity metrics.' ;
    rdfs:domain ind:WorkOrderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outageRelatedFlag rdf:type rdf:Property ;
    rdfs:label 'Outage Related Flag' ;
    rdfs:comment 'Indicates whether this assignment is related to a customer outage or service interruption. True for outage restoration work, False for non-outage work. Used for reliability metrics (SAIDI, SAIFI, CAIDI) and priority dispatch.' ;
    rdfs:domain ind:WorkOrderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reassignmentCount rdf:type rdf:Property ;
    rdfs:label 'Reassignment Count' ;
    rdfs:comment 'Number of times this work order has been reassigned to different technicians or crews. Used for dispatch efficiency analysis and work order complexity assessment. Zero for first-time assignments.' ;
    rdfs:domain ind:WorkOrderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:safetyHazardCode rdf:type rdf:Property ;
    rdfs:label 'Safety Hazard Code' ;
    rdfs:comment 'Code identifying known safety hazards at the work site (e.g., energized equipment, confined space, traffic hazard, hazardous materials). Used for crew safety briefings and OSHA compliance. [ENUM-REF-CANDIDATE: energized_equipment|confined_space|traffic_hazard|hazmat|fall_hazard|excavation|overhead_lines — promote to reference product]' ;
    rdfs:domain ind:WorkOrderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Work Duration Minutes' ;
    rdfs:comment 'Actual productive work time in minutes, calculated as the difference between actual start and actual end timestamps. Excludes setup, breaks, and non-productive time. Used for labor costing and efficiency analysis.' ;
    rdfs:domain ind:WorkOrderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:workLocationAddress rdf:type rdf:Property ;
    rdfs:label 'Work Location Address' ;
    rdfs:comment 'Street address or location description of the work site. Used for crew navigation, customer communication, and operational reporting. May include customer premises or utility infrastructure locations.' ;
    rdfs:domain ind:WorkOrderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workLocationLatitude rdf:type rdf:Property ;
    rdfs:label 'Work Location Latitude' ;
    rdfs:comment 'Geographic latitude coordinate of the work site in decimal degrees. Used for mobile navigation, crew routing, and geospatial analysis. Sourced from GIS or mobile device GPS.' ;
    rdfs:domain ind:WorkOrderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:workLocationLongitude rdf:type rdf:Property ;
    rdfs:label 'Work Location Longitude' ;
    rdfs:comment 'Geographic longitude coordinate of the work site in decimal degrees. Used for mobile navigation, crew routing, and geospatial analysis. Sourced from GIS or mobile device GPS.' ;
    rdfs:domain ind:WorkOrderAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:supervisorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Supervisor Employee Id' ;
    rdfs:comment 'Employee ID of the direct supervisor.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:birthDate rdf:type rdf:Property ;
    rdfs:label 'Birth Date' ;
    rdfs:comment 'Employee\'s date of birth.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:employeeNumber rdf:type rdf:Property ;
    rdfs:label 'Employee Number' ;
    rdfs:comment 'Internal employee identifier used across corporate systems.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employeeType rdf:type rdf:Property ;
    rdfs:label 'Employee Type' ;
    rdfs:comment 'Classification of employment relationship.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:genderCode rdf:type rdf:Property ;
    rdfs:label 'Gender Code' ;
    rdfs:comment 'Gender of the employee.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jobTitle rdf:type rdf:Property ;
    rdfs:label 'Job Title' ;
    rdfs:comment 'Official job title of the employee.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastSafetyTrainingDate rdf:type rdf:Property ;
    rdfs:label 'Last Safety Training Date' ;
    rdfs:comment 'Date of the most recent safety training completed by the employee.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:payCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Pay Currency Code' ;
    rdfs:comment 'ISO currency code for the employee\'s compensation.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:socialSecurityNumber rdf:type rdf:Property ;
    rdfs:label 'Social Security Number' ;
    rdfs:comment 'Government-issued identifier for the employee.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unionAffiliationCode rdf:type rdf:Property ;
    rdfs:label 'Union Affiliation Code' ;
    rdfs:comment 'Code representing the employee\'s union affiliation.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationId rdf:type rdf:Property ;
    rdfs:label 'Allocation Id' ;
    rdfs:comment 'Primary key for the generation_allocation association' ;
    rdfs:domain ind:Allocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:percent rdf:type rdf:Property ;
    rdfs:label 'Percent' ;
    rdfs:comment 'Percentage of the plant\'s output allocated to the service point' ;
    rdfs:domain ind:Allocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:auditPlantAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Audit Plant Assignment Id' ;
    rdfs:comment 'Primary key for the audit_plant_assignment association' ;
    rdfs:domain ind:AuditPlantAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lineCrewAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Line Crew Assignment Id' ;
    rdfs:comment 'Primary key for the LineCrewAssignment association' ;
    rdfs:domain ind:LineCrewAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assignmentEndDate rdf:type rdf:Property ;
    rdfs:label 'Assignment End Date' ;
    rdfs:comment 'Date the crew assignment to the line ends' ;
    rdfs:domain ind:LineCrewAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assignmentStartDate rdf:type rdf:Property ;
    rdfs:label 'Assignment Start Date' ;
    rdfs:comment 'Date the crew assignment to the line begins' ;
    rdfs:domain ind:LineCrewAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:role rdf:type rdf:Property ;
    rdfs:label 'Role' ;
    rdfs:comment 'Role of the crew for this assignment (e.g., construction, maintenance, emergency)' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lineProjectAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Line Project Assignment Id' ;
    rdfs:comment 'Primary key for the LineProjectAssignment association' ;
    rdfs:domain ind:LineProjectAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:allocatedBudgetAmount rdf:type rdf:Property ;
    rdfs:label 'Allocated Budget Amount' ;
    rdfs:comment 'Budget amount allocated to this line within the project' ;
    rdfs:domain ind:LineProjectAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:projectEndDate rdf:type rdf:Property ;
    rdfs:label 'Project End Date' ;
    rdfs:comment 'Planned end/completion date for work on this line under the project' ;
    rdfs:domain ind:LineProjectAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rightOfWayAgreementId rdf:type rdf:Property ;
    rdfs:label 'Right Of Way Agreement Id' ;
    rdfs:comment 'Primary key for the right_of_way_agreement association' ;
    rdfs:domain ind:RightOfWayAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:segmentLengthMiles rdf:type rdf:Property ;
    rdfs:label 'Segment Length Miles' ;
    rdfs:comment 'Length of the transmission line segment that lies within the parcel' ;
    rdfs:domain ind:RightOfWayAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:feederCrewAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Feeder Crew Assignment Id' ;
    rdfs:comment 'Primary key for the feeder_crew_assignment association' ;
