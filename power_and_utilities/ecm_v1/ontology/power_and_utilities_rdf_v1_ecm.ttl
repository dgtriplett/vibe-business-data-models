    rdfs:domain ind:CommissionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceEvidenceId rdf:type rdf:Property ;
    rdfs:label 'Compliance Evidence Id' ;
    rdfs:comment 'System-generated unique identifier for the compliance evidence record.' ;
    rdfs:domain ind:ComplianceEvidence ;
