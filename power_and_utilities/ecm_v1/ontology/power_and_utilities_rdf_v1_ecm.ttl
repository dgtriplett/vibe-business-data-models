    rdfs:range xsd:date .

ind:equipmentCalibrationDueDate rdf:type rdf:Property ;
    rdfs:label 'Equipment Calibration Due Date' ;
    rdfs:comment 'Next scheduled calibration date for the test equipment.' ;
    rdfs:domain ind:MeterTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:errorPercentage rdf:type rdf:Property ;
    rdfs:label 'Error Percentage' ;
    rdfs:comment 'Overall error percentage observed during the test.' ;
    rdfs:domain ind:MeterTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:testConditions rdf:type rdf:Property ;
    rdfs:label 'Test Conditions' ;
    rdfs:comment 'Narrative description of test conditions (e.g., voltage, load profile).' ;
    rdfs:domain ind:MeterTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Test Duration Minutes' ;
    rdfs:comment 'Total duration of the test in minutes.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testMethod rdf:type rdf:Property ;
    rdfs:label 'Test Method' ;
    rdfs:comment 'Method used to conduct the test: field, laboratory, or simulation.' ;
    rdfs:domain ind:MeterTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testNumber rdf:type rdf:Property ;
    rdfs:label 'Test Number' ;
    rdfs:comment 'Business identifier assigned to the test, often used in regulatory filings and work orders.' ;
    rdfs:domain ind:MeterTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testResultSummary rdf:type rdf:Property ;
    rdfs:label 'Test Result Summary' ;
    rdfs:comment 'Concise textual summary of the test outcome and key metrics.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testStatus rdf:type rdf:Property ;
    rdfs:label 'Test Status' ;
    rdfs:comment 'Result of the test: pass, fail, or pending review.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testTimestamp rdf:type rdf:Property ;
    rdfs:label 'Test Timestamp' ;
    rdfs:comment 'Date and time when the meter accuracy test was performed.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:testType rdf:type rdf:Property ;
    rdfs:label 'Test Type' ;
    rdfs:comment 'Category of the accuracy test: in-service (field), shop (lab), or complaint-driven.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryMeterId rdf:type rdf:Property ;
    rdfs:label 'Primary Meter Id' ;
    rdfs:comment 'Identifier of the currently active meter serving the point.' ;
    rdfs:domain ind:MeteringServicePoint ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Meter .

ind:rateSeasonCalendarId rdf:type rdf:Property ;
    rdfs:label 'Rate Season Calendar Id' ;
    rdfs:comment 'Foreign key linking to product.rate_season_calendar. Business justification: Seasonal calendar determines seasonal rate applicability for a service point; required for seasonal pricing compliance and reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RateSeasonCalendar .

ind:amiCommunicationTechnology rdf:type rdf:Property ;
    rdfs:label 'Ami Communication Technology' ;
    rdfs:comment 'Technology used for AMI data transmission.' ;
    rdfs:domain ind:MeteringServicePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amiEndpointSerial rdf:type rdf:Property ;
    rdfs:label 'Ami Endpoint Serial' ;
    rdfs:comment 'Serial number of the AMI communication endpoint installed at the point.' ;
    rdfs:domain ind:MeteringServicePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amiSignalStrength rdf:type rdf:Property ;
    rdfs:label 'Ami Signal Strength' ;
    rdfs:comment 'Measured signal strength (dBm) of the AMI device at last contact.' ;
    rdfs:domain ind:MeteringServicePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dataQualityStatus rdf:type rdf:Property ;
    rdfs:label 'Data Quality Status' ;
    rdfs:comment 'Categorical assessment of data quality.' ;
    rdfs:domain ind:MeteringServicePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedAnnualGasMcf rdf:type rdf:Property ;
    rdfs:label 'Estimated Annual Gas Mcf' ;
    rdfs:comment 'Projected yearly natural-gas usage in thousand cubic feet.' ;
    rdfs:domain ind:MeteringServicePoint ;
    rdf:type owl:DatatypeProperty ;
