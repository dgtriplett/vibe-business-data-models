ind:amountGross rdf:type rdf:Property ;
    rdfs:label 'Amount Gross' ;
    rdfs:comment 'Total monetary amount of the adjustment before taxes, fees, or other deductions.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:amountNet rdf:type rdf:Property ;
    rdfs:label 'Amount Net' ;
    rdfs:comment 'Net monetary amount after taxes and fees; the amount that impacts the customer balance.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:amountTax rdf:type rdf:Property ;
    rdfs:label 'Amount Tax' ;
    rdfs:comment 'Tax component associated with the adjustment, if applicable.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:delinquencyAge rdf:type rdf:Property ;
    rdfs:label 'Delinquency Age' ;
    rdfs:comment 'Number of days the account was delinquent at the time of write-off.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priorCollectionActions rdf:type rdf:Property ;
    rdfs:label 'Prior Collection Actions' ;
    rdfs:comment 'Summary of collection activities performed before the write-off.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reasonCode rdf:type rdf:Property ;
    rdfs:label 'Reason Code' ;
    rdfs:comment 'Standardized code representing the business reason for the adjustment.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reasonDescription rdf:type rdf:Property ;
    rdfs:label 'Reason Description' ;
    rdfs:comment 'Free-text description of why the adjustment was applied.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoveryStatus rdf:type rdf:Property ;
    rdfs:label 'Recovery Status' ;
    rdfs:comment 'Indicates whether any amount was recovered after the write-off.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sapBadDebtReference rdf:type rdf:Property ;
    rdfs:label 'Sap Bad Debt Reference' ;
    rdfs:comment 'Reference key to the SAP FI/CO bad-debt expense posting.' ;
    rdfs:domain ind:Adjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:updatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Updated Timestamp' ;
    rdfs:comment 'Timestamp of the most recent modification to the adjustment record.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:writeOffDate rdf:type rdf:Property ;
    rdfs:label 'Write Off Date' ;
    rdfs:comment 'Date on which a bad-debt write-off was recorded.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assistanceId rdf:type rdf:Property ;
    rdfs:label 'Assistance Id' ;
    rdfs:comment 'Primary key for assistance' ;
    rdfs:domain ind:Assistance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assistanceType rdf:type rdf:Property ;
    rdfs:label 'Assistance Type' ;
    rdfs:comment 'Classification of the assistance offering (e.g., percentage discount, fixed credit, arrears forgiveness).' ;
    rdfs:domain ind:Assistance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benefitAmount rdf:type rdf:Property ;
    rdfs:label 'Benefit Amount' ;
    rdfs:comment 'Monetary value of the benefit applied to the customer\'s bill.' ;
    rdfs:domain ind:Assistance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:benefitType rdf:type rdf:Property ;
    rdfs:label 'Benefit Type' ;
    rdfs:comment 'Category of benefit applied (e.g., discount, credit, payment forgiveness).' ;
    rdfs:domain ind:Assistance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discountRate rdf:type rdf:Property ;
    rdfs:label 'Discount Rate' ;
    rdfs:comment 'Percentage discount applied to the bill (e.g., 15.00 for 15%).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:documentationSubmitted rdf:type rdf:Property ;
    rdfs:label 'Documentation Submitted' ;
    rdfs:comment 'Indicates whether required eligibility documentation has been submitted.' ;
    rdfs:domain ind:Assistance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:eligibilityCriteriaDescription rdf:type rdf:Property ;
    rdfs:label 'Eligibility Criteria Description' ;
    rdfs:comment 'Human-readable description of the eligibility rules for the program.' ;
    rdfs:domain ind:Assistance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityCriteriaReference rdf:type rdf:Property ;
    rdfs:label 'Eligibility Criteria Reference' ;
    rdfs:comment 'Reference code to the set of eligibility rules applied to this enrollment.' ;
    rdfs:domain ind:Assistance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enrollmentDate rdf:type rdf:Property ;
    rdfs:label 'Enrollment Date' ;
    rdfs:comment 'Date the customer was enrolled in the assistance program.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:enrollmentStatus rdf:type rdf:Property ;
    rdfs:label 'Enrollment Status' ;
    rdfs:comment 'Current lifecycle status of the enrollment.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:householdSize rdf:type rdf:Property ;
    rdfs:label 'Household Size' ;
    rdfs:comment 'Number of individuals in the customer\'s household used for eligibility calculations.' ;
    rdfs:domain ind:Assistance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:incomeVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Income Verification Date' ;
    rdfs:comment 'Date the income verification was completed.' ;
    rdfs:domain ind:Assistance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:incomeVerificationStatus rdf:type rdf:Property ;
    rdfs:label 'Income Verification Status' ;
    rdfs:comment 'Status of income verification for the enrollment.' ;
    rdfs:domain ind:Assistance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recertificationDueDate rdf:type rdf:Property ;
    rdfs:label 'Recertification Due Date' ;
    rdfs:comment 'Date by which the enrollment must be recertified to remain active.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:recertificationStatus rdf:type rdf:Property ;
    rdfs:label 'Recertification Status' ;
    rdfs:comment 'Current status of the recertification requirement.' ;
    rdfs:domain ind:Assistance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billId rdf:type rdf:Property ;
    rdfs:label 'Bill Id' ;
    rdfs:comment 'System-generated unique identifier for the bill record.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Bill .

ind:derNemAccountId rdf:type rdf:Property ;
    rdfs:label 'Der Nem Account Id' ;
    rdfs:comment 'Foreign key linking to der.nem_account. Business justification: REQUIRED: NEM customer bills need to be tied to the corresponding NEM account for settlement, export credit tracking, and regulatory filing.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:NemAccount .

ind:derProgramEnrollmentId rdf:type rdf:Property ;
    rdfs:label 'Der Program Enrollment Id' ;
    rdfs:comment 'Foreign key linking to der.program_enrollment. Business justification: REQUIRED: Bills that include incentive credits must reference the specific DER program enrollment to calculate and report incentive amounts.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DerProgramEnrollment .

ind:gridopsOutageEventId rdf:type rdf:Property ;
    rdfs:label 'Gridops Outage Event Id' ;
    rdfs:comment 'Foreign key linking to gridops.gridops_outage_event. Business justification: Outage Compensation Billing Adjustment: credits applied to a bill based on recorded outage events, required for regulatory compliance and customer fairness.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GridopsOutageEvent .

ind:meterId rdf:type rdf:Property ;
    rdfs:label 'Meter Id' ;
    rdfs:comment 'FK to metering.meter.meter_id — Bills are generated from meter readings. This FK enables bill-to-meter traceability for billing disputes and meter accuracy investigations.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Meter .

ind:opportunityId rdf:type rdf:Property ;
    rdfs:label 'Opportunity Id' ;
    rdfs:comment 'Foreign key linking to engagement.opportunity. Business justification: Supports Opportunity Revenue Attribution report, tying generated bills back to the sales opportunity that created the contract.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Opportunity .

ind:productRateScheduleId rdf:type rdf:Property ;
    rdfs:label 'Product Rate Schedule Id' ;
    rdfs:comment 'Foreign key linking to product.rate_schedule. Business justification: Regulatory bill generation requires linking each bill to the exact rate schedule applied, enabling audit of rates per billing period.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RateSchedule .

ind:serviceAgreementId rdf:type rdf:Property ;
    rdfs:label 'Service Agreement Id' ;
    rdfs:comment 'Foreign key linking to customer.service_agreement. Business justification: Bills are generated based on a specific service agreement; linking enables audit of charges against contract terms required for compliance reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ServiceAgreement .

ind:settlementId rdf:type rdf:Property ;
    rdfs:label 'Settlement Id' ;
    rdfs:comment 'Foreign key linking to trading.settlement. Business justification: Regulatory settlement allocation report requires linking each retail bill to the wholesale settlement that funded the electricity supply.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Settlement .

ind:tariffScheduleId rdf:type rdf:Property ;
    rdfs:label 'Tariff Schedule Id' ;
    rdfs:comment 'Foreign key linking to regulatory.tariff_schedule. Business justification: Bills reference the tariff schedule that defines rates and fees; linking supports audit of rate applicability and regulatory compliance.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TariffSchedule .

ind:adjustmentAmount rdf:type rdf:Property ;
    rdfs:label 'Adjustment Amount' ;
    rdfs:comment 'Monetary adjustment applied to the bill (e.g., billing error correction).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:arrearsBalance rdf:type rdf:Property ;
    rdfs:label 'Arrears Balance' ;
    rdfs:comment 'Outstanding balance carried forward from previous billing periods.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:billNumber rdf:type rdf:Property ;
    rdfs:label 'Bill Number' ;
    rdfs:comment 'Business-visible invoice number assigned by the billing system.' ;
    rdfs:domain ind:Bill ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billStatus rdf:type rdf:Property ;
    rdfs:label 'Bill Status' ;
    rdfs:comment 'Current lifecycle status of the bill.' ;
    rdfs:domain ind:Bill ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billType rdf:type rdf:Property ;
    rdfs:label 'Bill Type' ;
    rdfs:comment 'Classification of the bill (e.g., regular, final, corrected, adjustment).' ;
    rdfs:domain ind:Bill ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingPeriodEnd rdf:type rdf:Property ;
    rdfs:label 'Billing Period End' ;
    rdfs:comment 'Last day of the consumption period covered by the bill.' ;
    rdfs:domain ind:Bill ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:billingPeriodStart rdf:type rdf:Property ;
    rdfs:label 'Billing Period Start' ;
    rdfs:comment 'First day of the consumption period covered by the bill.' ;
    rdfs:domain ind:Bill ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:collectionStatus rdf:type rdf:Property ;
    rdfs:label 'Collection Status' ;
    rdfs:comment 'Current status of the collection process for unpaid bills.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cycle rdf:type rdf:Property ;
    rdfs:label 'Cycle' ;
    rdfs:comment 'Frequency of the billing cycle.' ;
    rdfs:domain ind:Bill ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:demandCharge rdf:type rdf:Property ;
    rdfs:label 'Demand Charge' ;
    rdfs:comment 'Charge based on peak demand during the billing period.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:discountAmount rdf:type rdf:Property ;
    rdfs:label 'Discount Amount' ;
    rdfs:comment 'Total discount granted on the bill.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disputeCloseDate rdf:type rdf:Property ;
    rdfs:label 'Dispute Close Date' ;
    rdfs:comment 'Date when the dispute was resolved or closed.' ;
    rdfs:domain ind:Bill ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:disputeFlag rdf:type rdf:Property ;
    rdfs:label 'Dispute Flag' ;
    rdfs:comment 'Indicates whether the bill is under a customer dispute.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disputeOpenDate rdf:type rdf:Property ;
    rdfs:label 'Dispute Open Date' ;
    rdfs:comment 'Date when the dispute was opened.' ;
    rdfs:domain ind:Bill ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:disputeReason rdf:type rdf:Property ;
    rdfs:label 'Dispute Reason' ;
    rdfs:comment 'Reason provided by the customer for disputing the bill.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dueDate rdf:type rdf:Property ;
    rdfs:label 'Due Date' ;
    rdfs:comment 'Date by which payment is required.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:energyCharge rdf:type rdf:Property ;
    rdfs:label 'Energy Charge' ;
    rdfs:comment 'Charge for energy consumption based on the applicable rate.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isReconciled rdf:type rdf:Property ;
    rdfs:label 'Is Reconciled' ;
    rdfs:comment 'Indicates whether the bill has been reconciled in the finance system.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:issueTimestamp rdf:type rdf:Property ;
    rdfs:label 'Issue Timestamp' ;
    rdfs:comment 'Date and time when the bill was generated and issued to the customer.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lateFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Late Fee Amount' ;
    rdfs:comment 'Fee charged for late payment, if applicable.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lateFeeApplied rdf:type rdf:Property ;
    rdfs:label 'Late Fee Applied' ;
    rdfs:comment 'Indicates whether a late fee has been applied to the bill.' ;
    rdfs:domain ind:Bill ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:netAmount rdf:type rdf:Property ;
    rdfs:label 'Net Amount' ;
    rdfs:comment 'Final amount due after taxes, discounts, and adjustments.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentDate rdf:type rdf:Property ;
    rdfs:label 'Payment Date' ;
    rdfs:comment 'Date on which the payment was received.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentMethod rdf:type rdf:Property ;
    rdfs:label 'Payment Method' ;
    rdfs:comment 'Method used by the customer to pay the bill.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentStatus rdf:type rdf:Property ;
    rdfs:label 'Payment Status' ;
    rdfs:comment 'Current status of payment for the bill.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratePlanName rdf:type rdf:Property ;
    rdfs:label 'Rate Plan Name' ;
    rdfs:comment 'Descriptive name of the rate plan used for billing.' ;
    rdfs:domain ind:Bill ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reconciliationDate rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Date' ;
    rdfs:comment 'Date on which the bill was reconciled.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Regulatory Fee Amount' ;
    rdfs:comment 'Amount of regulatory fees imposed by governing bodies.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:revenueRecognitionAmount rdf:type rdf:Property ;
    rdfs:label 'Revenue Recognition Amount' ;
    rdfs:comment 'Amount of revenue recognized for this bill.' ;
    rdfs:domain ind:Bill ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:revenueRecognitionDate rdf:type rdf:Property ;
    rdfs:label 'Revenue Recognition Date' ;
    rdfs:comment 'Date on which the bill revenue is recognized per FASB ASC 980.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:taxAmount rdf:type rdf:Property ;
    rdfs:label 'Tax Amount' ;
    rdfs:comment 'Total tax applied to the bill.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxExemptFlag rdf:type rdf:Property ;
    rdfs:label 'Tax Exempt Flag' ;
    rdfs:comment 'Indicates whether the bill is exempt from tax.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:totalAmount rdf:type rdf:Property ;
    rdfs:label 'Total Amount' ;
    rdfs:comment 'Gross amount before discounts, taxes, and adjustments.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalKwh rdf:type rdf:Property ;
    rdfs:label 'Total Kwh' ;
    rdfs:comment 'Total electricity consumption in kilowatt-hours for the billing period.' ;
    rdfs:domain ind:Bill ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalMcf rdf:type rdf:Property ;
    rdfs:label 'Total Mcf' ;
    rdfs:comment 'Total natural gas consumption in thousand cubic feet for the billing period.' ;
    rdfs:domain ind:Bill ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:usageType rdf:type rdf:Property ;
    rdfs:label 'Usage Type' ;
    rdfs:comment 'Customer classification for usage (e.g., residential, commercial).' ;
    rdfs:domain ind:Bill ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billLineItemId rdf:type rdf:Property ;
    rdfs:label 'Bill Line Item Id' ;
    rdfs:comment 'System-generated unique identifier for each bill line item record.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BillLineItem .

ind:billingRateComponentId rdf:type rdf:Property ;
    rdfs:label 'Billing Rate Component Id' ;
    rdfs:comment 'Identifier of the specific rate component (e.g., energy, demand, service) applied.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BillingRateComponent .

ind:drDispatchEventId rdf:type rdf:Property ;
    rdfs:label 'Dr Dispatch Event Id' ;
    rdfs:comment 'Foreign key linking to gridops.dr_dispatch_event. Business justification: Demand-Response Settlement: line items need to reference the DR dispatch event that generated the DR credit or charge for accurate settlement.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DrDispatchEvent .

ind:meteringServicePointId rdf:type rdf:Property ;
    rdfs:label 'Metering Service Point Id' ;
    rdfs:comment 'Foreign key linking to metering.metering_service_point. Business justification: Regulatory NEM eligibility and detailed consumption reporting require each bill line item to reference the metering service point that supplied the meter data.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MeteringServicePoint .

ind:productTouPeriodId rdf:type rdf:Property ;
    rdfs:label 'Product Tou Period Id' ;
    rdfs:comment 'Foreign key linking to product.tou_period. Business justification: Each line item’s time-of-use period must reference the defined TOU period for accurate rate application and compliance reporting.' ;
    rdfs:domain ind:BillLineItem ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TouPeriod .

ind:rateScheduleId rdf:type rdf:Property ;
    rdfs:label 'Rate Schedule Id' ;
    rdfs:comment 'FK to product.rate_schedule.rate_schedule_id — Each bill line item is calculated under a specific rate schedule. This FK enables billing-to-rate-catalog joins for rate validation and revenue analysis.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RateSchedule .

ind:resourceId rdf:type rdf:Property ;
    rdfs:label 'Resource Id' ;
    rdfs:comment 'Foreign key linking to der.der_resource. Business justification: REQUIRED: Export-credit line items must reference the specific DER unit; used in net-metering settlement reports and incentive calculations.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Resource .

ind:tariffRiderId rdf:type rdf:Property ;
    rdfs:label 'Tariff Rider Id' ;
    rdfs:comment 'FK to regulatory.tariff_rider.tariff_rider_id — Bill line items applying tariff riders must reference the regulatory-approved rider. With billing.tariff_rider not present as a separate entity, this FK to regulatory.tariff_rider enables rider charge' ;
    rdfs:domain ind:BillLineItem ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProductTariffRider .

ind:tradeLegId rdf:type rdf:Property ;
    rdfs:label 'Trade Leg Id' ;
    rdfs:comment 'Foreign key linking to trading.trade_leg. Business justification: Detailed compliance reporting links line items to specific trade legs for accurate cost breakdown.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TradeLeg .

ind:transmissionLineId rdf:type rdf:Property ;
    rdfs:label 'Transmission Line Id' ;
    rdfs:comment 'Foreign key linking to transmission.line. Business justification: Transmission Service Charge line items are tied to a specific transmission line, enabling accurate line-usage billing and compliance with NERC reporting.' ;
    rdfs:domain ind:UtilityCompany ;
