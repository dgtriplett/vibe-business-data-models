    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maxReadValue rdf:type rdf:Property ;
    rdfs:label 'Max Read Value' ;
    rdfs:comment 'Maximum observed reading value for the register.' ;
    rdfs:domain ind:Register ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:measurementMultiplier rdf:type rdf:Property ;
    rdfs:label 'Measurement Multiplier' ;
    rdfs:comment 'Factor applied to raw readings to convert to the unit of measure.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:measurementPrecision rdf:type rdf:Property ;
    rdfs:label 'Measurement Precision' ;
    rdfs:comment 'Number of decimal places stored for register readings.' ;
    rdfs:domain ind:Register ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minReadValue rdf:type rdf:Property ;
    rdfs:label 'Min Read Value' ;
    rdfs:comment 'Minimum observed reading value for the register.' ;
    rdfs:domain ind:Register ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:registerDescription rdf:type rdf:Property ;
    rdfs:label 'Register Description' ;
    rdfs:comment 'Free-form description providing additional context about the register.' ;
    rdfs:domain ind:Register ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registerName rdf:type rdf:Property ;
    rdfs:label 'Register Name' ;
    rdfs:comment 'Descriptive name for the register, often indicating its purpose or location on the meter.' ;
    rdfs:domain ind:Register ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registerNumber rdf:type rdf:Property ;
    rdfs:label 'Register Number' ;
    rdfs:comment 'Human-readable identifier assigned to the register (e.g., 1, 2, A).' ;
    rdfs:domain ind:Register ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registerStatus rdf:type rdf:Property ;
    rdfs:label 'Register Status' ;
    rdfs:comment 'Current lifecycle status of the register.' ;
    rdfs:domain ind:Register ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rolloverFlag rdf:type rdf:Property ;
    rdfs:label 'Rollover Flag' ;
    rdfs:comment 'Indicates whether the register is configured to rollover at its maximum value.' ;
    rdfs:domain ind:Register ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rolloverValue rdf:type rdf:Property ;
    rdfs:label 'Rollover Value' ;
    rdfs:comment 'Maximum value before the register rolls over to zero.' ;
    rdfs:domain ind:Register ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:touTier rdf:type rdf:Property ;
    rdfs:label 'Tou Tier' ;
    rdfs:comment 'TOU tier assignment for the register (e.g., peak, off-peak).' ;
    rdfs:domain ind:Register ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registerReadId rdf:type rdf:Property ;
    rdfs:label 'Register Read Id' ;
    rdfs:comment 'System-generated unique identifier for each register read event.' ;
    rdfs:domain ind:RegisterRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:consumptionQuantity rdf:type rdf:Property ;
    rdfs:label 'Consumption Quantity' ;
    rdfs:comment 'Calculated consumption for the interval (e.g., kWh, MCF, Therms).' ;
    rdfs:domain ind:RegisterRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:demandUnit rdf:type rdf:Property ;
    rdfs:label 'Demand Unit' ;
    rdfs:comment 'Unit of the demand measurement (kilowatt).' ;
    rdfs:domain ind:RegisterRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:demandValue rdf:type rdf:Property ;
    rdfs:label 'Demand Value' ;
    rdfs:comment 'Peak demand recorded during the interval (e.g., kW for electric meters).' ;
    rdfs:domain ind:RegisterRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:editTimestamp rdf:type rdf:Property ;
    rdfs:label 'Edit Timestamp' ;
    rdfs:comment 'Date and time when a manual edit was applied to the read.' ;
    rdfs:domain ind:RegisterRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:editedBy rdf:type rdf:Property ;
    rdfs:label 'Edited By' ;
    rdfs:comment 'Identifier of the user who performed the manual edit.' ;
    rdfs:domain ind:RegisterRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:editedFlag rdf:type rdf:Property ;
    rdfs:label 'Edited Flag' ;
    rdfs:comment 'Indicates whether the read has been manually edited after initial capture.' ;
    rdfs:domain ind:RegisterRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:previousReadValue rdf:type rdf:Property ;
    rdfs:label 'Previous Read Value' ;
    rdfs:comment 'The reading value from the immediately preceding interval, used for consumption calculation.' ;
    rdfs:domain ind:RegisterRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rawReadValue rdf:type rdf:Property ;
    rdfs:label 'Raw Read Value' ;
    rdfs:comment 'Unadjusted numeric value reported by the meter before any multipliers or estimations.' ;
    rdfs:domain ind:RegisterRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:readQualityCode rdf:type rdf:Property ;
    rdfs:label 'Read Quality Code' ;
    rdfs:comment 'Code indicating the quality of the read (e.g., good, suspect, estimated). [ENUM-REF-CANDIDATE: good|suspect|estimated|invalid|manual|other — promote to reference product]' ;
    rdfs:domain ind:RegisterRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readReason rdf:type rdf:Property ;
    rdfs:label 'Read Reason' ;
    rdfs:comment 'Free-text explanation for why a particular read type or source was used (e.g., meter replacement, outage).' ;
    rdfs:domain ind:RegisterRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readSource rdf:type rdf:Property ;
    rdfs:label 'Read Source' ;
    rdfs:comment 'Origin of the read data – field technician, AMI head-end system, or IVR.' ;
    rdfs:domain ind:RegisterRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readStatus rdf:type rdf:Property ;
    rdfs:label 'Read Status' ;
    rdfs:comment 'Current processing status of the read record.' ;
    rdfs:domain ind:RegisterRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readTimestamp rdf:type rdf:Property ;
    rdfs:label 'Read Timestamp' ;
    rdfs:comment 'Date and time when the register reading was captured.' ;
    rdfs:domain ind:RegisterRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:applicableMeterType rdf:type rdf:Property ;
    rdfs:label 'Applicable Meter Type' ;
    rdfs:comment 'Meter technology type that the schedule can be applied to.' ;
    rdfs:domain ind:TouSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cppEventEligible rdf:type rdf:Property ;
    rdfs:label 'Cpp Event Eligible' ;
    rdfs:comment 'Flag indicating whether the schedule can be used for Critical Peak Pricing events.' ;
    rdfs:domain ind:TouSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isDefault rdf:type rdf:Property ;
    rdfs:label 'Is Default' ;
    rdfs:comment 'Indicates whether this schedule is the default for its rate class.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:offpeakWindowEndTime rdf:type rdf:Property ;
    rdfs:label 'Offpeak Window End Time' ;
    rdfs:comment 'End time of the off-peak window (HH:MM, 24-hour).' ;
    rdfs:domain ind:TouSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:offpeakWindowStartTime rdf:type rdf:Property ;
    rdfs:label 'Offpeak Window Start Time' ;
    rdfs:comment 'Start time of the off-peak window (HH:MM, 24-hour).' ;
    rdfs:domain ind:TouSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:peakWindowEndTime rdf:type rdf:Property ;
    rdfs:label 'Peak Window End Time' ;
    rdfs:comment 'End time of the on-peak window (HH:MM, 24-hour).' ;
    rdfs:domain ind:TouSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:peakWindowStartTime rdf:type rdf:Property ;
    rdfs:label 'Peak Window Start Time' ;
    rdfs:comment 'Start time of the on-peak window (HH:MM, 24-hour).' ;
    rdfs:domain ind:TouSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:priceMultiplier rdf:type rdf:Property ;
    rdfs:label 'Price Multiplier' ;
    rdfs:comment 'Factor applied to the base rate for this schedule (e.g., 1.000 for standard, >1 for premium).' ;
    rdfs:domain ind:TouSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateClass rdf:type rdf:Property ;
    rdfs:label 'Rate Class' ;
    rdfs:comment 'Customer rate class to which the schedule applies.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rtpIntervalMapping rdf:type rdf:Property ;
    rdfs:label 'Rtp Interval Mapping' ;
    rdfs:comment 'Length of real-time pricing intervals that the schedule aligns with.' ;
    rdfs:domain ind:TouSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tierDefinitions rdf:type rdf:Property ;
    rdfs:label 'Tier Definitions' ;
    rdfs:comment 'JSON-encoded definition of tier periods, start/end times and associated rates within the schedule.' ;
    rdfs:domain ind:TouSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:touScheduleDescription rdf:type rdf:Property ;
    rdfs:label 'Tou Schedule Description' ;
    rdfs:comment 'Free-form text describing the purpose and characteristics of the schedule.' ;
    rdfs:domain ind:TouSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:touScheduleStatus rdf:type rdf:Property ;
    rdfs:label 'Tou Schedule Status' ;
    rdfs:comment 'Current lifecycle status of the schedule.' ;
    rdfs:domain ind:TouSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:veeResultId rdf:type rdf:Property ;
    rdfs:label 'Vee Result Id' ;
    rdfs:comment 'Unique surrogate key for each Validation, Estimation, and Editing (VEE) processing result record.' ;
    rdfs:domain ind:VeeResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:veeRuleId rdf:type rdf:Property ;
    rdfs:label 'Vee Rule Id' ;
    rdfs:comment 'Foreign key linking to metering.vee_rule. Business justification: vee_result should reference the governing VEE rule via a foreign key; the existing string column is replaced with vee_rule_id.' ;
    rdfs:domain ind:Metering ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:VeeRule .

ind:affectedIntervalCount rdf:type rdf:Property ;
    rdfs:label 'Affected Interval Count' ;
    rdfs:comment 'Number of consecutive intervals impacted by the issue.' ;
    rdfs:domain ind:VeeResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:escalationLevel rdf:type rdf:Property ;
    rdfs:label 'Escalation Level' ;
    rdfs:comment 'Severity level used to determine if the issue requires escalation to higher-level support.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimationAlgorithm rdf:type rdf:Property ;
    rdfs:label 'Estimation Algorithm' ;
    rdfs:comment 'Algorithm used when the outcome is estimated, describing the method applied.' ;
    rdfs:domain ind:VeeResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investigationNotes rdf:type rdf:Property ;
    rdfs:label 'Investigation Notes' ;
    rdfs:comment 'Free-form notes captured by the analyst during issue investigation.' ;
    rdfs:domain ind:VeeResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issueEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Issue End Timestamp' ;
    rdfs:comment 'Timestamp of the last interval affected by the identified issue.' ;
    rdfs:domain ind:VeeResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:issueStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Issue Start Timestamp' ;
    rdfs:comment 'Timestamp of the first interval affected by the identified issue.' ;
    rdfs:domain ind:VeeResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:issueType rdf:type rdf:Property ;
    rdfs:label 'Issue Type' ;
    rdfs:comment 'Classification of the data quality problem detected for the interval.' ;
    rdfs:domain ind:VeeResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overrideReasonCode rdf:type rdf:Property ;
    rdfs:label 'Override Reason Code' ;
    rdfs:comment 'Code indicating why a manual override or edit was applied to the reading.' ;
    rdfs:domain ind:VeeResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:processedValue rdf:type rdf:Property ;
    rdfs:label 'Processed Value' ;
    rdfs:comment 'Final value after validation, estimation, or editing (may equal raw_value if outcome is pass).' ;
    rdfs:domain ind:VeeResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rawValue rdf:type rdf:Property ;
    rdfs:label 'Raw Value' ;
    rdfs:comment 'Original unprocessed value reported by the meter for the interval.' ;
    rdfs:domain ind:VeeResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:resolutionAction rdf:type rdf:Property ;
    rdfs:label 'Resolution Action' ;
    rdfs:comment 'Action taken to resolve the data quality issue (e.g., manual edit, algorithmic correction).' ;
    rdfs:domain ind:VeeResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rootCauseClassification rdf:type rdf:Property ;
