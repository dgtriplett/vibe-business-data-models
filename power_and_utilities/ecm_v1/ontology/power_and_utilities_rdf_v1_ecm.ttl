    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lineRatingDescription rdf:type rdf:Property ;
    rdfs:label 'Line Rating Description' ;
    rdfs:comment 'Free-form text describing assumptions, methodology, or special notes for the rating.' ;
