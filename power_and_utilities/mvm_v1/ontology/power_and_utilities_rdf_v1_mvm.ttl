# RDFS Schema for Business: Power and Utilities

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix ind: <http://datamodel.lakehouse.org/business/power_and_utilities#> .

# --- Root Business Class ---
ind:Business rdf:type rdfs:Class ;
    rdfs:label 'Business' ;
    rdfs:comment 'Root class for all business entities' .

# --- Specific Business: Power and Utilities ---
ind:UtilityCompany rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Business ;
    rdfs:label 'Power and Utilities' ;
    rdfs:comment 'I am an electric and gas utility with energy generation, transmission, and distribution to serve residential and commercial customers' .

# --- Domain Classes ---
ind:Generation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UtilityCompany ;
    rdfs:label 'Generation' ;
    rdfs:comment 'Owns all data related to energy generation assets and operations — fossil fuel, nuclear, and renewable power plant operations including unit dispatch, fuel management, capacity planning, heat rate optimization, emissions monitoring, and generation output (MWh). Serves as the SSOT for generation facility master data, real-time EMS/SCADA telemetry, and plant performance metrics. Supports IRP, RPS compliance, and PPA tracking.' .

ind:Transmission rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UtilityCompany ;
    rdfs:label 'Transmission' ;
    rdfs:comment 'Governs high-voltage bulk electric system (BES) infrastructure for power transport across the grid — transmission lines, substations, transformers, and switching equipment. Manages grid topology, OATT compliance, RTO/ISO interchange scheduling, LMP data, transmission capacity, congestion, and interconnection requests. Critical for NERC CIP compliance and FERC jurisdictional reporting.' .

ind:Distribution rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UtilityCompany ;
    rdfs:label 'Distribution' ;
    rdfs:comment 'Manages last-mile electric and gas delivery infrastructure to end-use customers — distribution feeders, poles, service transformers, gas mains, service laterals, and associated GIS network topology. Serves as the SSOT for OMS/DMS outage events, SAIDI/SAIFI/CAIDI reliability indices, NEM interconnections, DER/DERMS integration, voltage regulation, and gas pipeline safety data under PHMSA.' .

ind:Metering rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UtilityCompany ;
    rdfs:label 'Metering' ;
    rdfs:comment 'Owns all AMI/AMR meter asset records, smart meter deployment data, interval read collection, and meter data validation/estimation/editing (VEE) workflows. Serves as the SSOT for meter inventory, meter-to-premise associations, interval energy consumption data (kWh, MCF), and demand readings (kW/MW). Integrates with MDMS (Oracle Utilities MDMS / Itron Analytics) and feeds billing and demand response domains.' .

ind:Asset rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UtilityCompany ;
    rdfs:label 'Asset' ;
    rdfs:comment 'Serves as the enterprise SSOT for all physical asset lifecycle data across generation, T&D, and gas infrastructure — asset master records, preventive and corrective maintenance work orders, inspection records, failure history, and capital project tracking (CAPEX/OPEX, AFUDC, WIP). Integrates with EAM (Oracle WAM / IBM Maximo) and GIS (ESRI ArcGIS) for spatial asset management. Supports regulatory asset base reporting and depreciation schedules for rate cases.' .

ind:Customer rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UtilityCompany ;
    rdfs:label 'Customer' ;
    rdfs:comment 'Single source of truth for all residential, commercial, and industrial customer identity, accounts, service agreements, and enrollment. Manages customer profiles, premise information, move-in/move-out processes, account hierarchy, customer segmentation, and contact information. Integrates with CIS platforms (Oracle CC&B / SAP IS-U) and CRM (Salesforce Energy & Utilities Cloud). Supports regulatory customer-of-record requirements for PUC reporting.' .

ind:Billing rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UtilityCompany ;
    rdfs:label 'Billing' ;
    rdfs:comment 'Authoritative source for the full revenue cycle — rate schedule application (TOU, CPP, tiered), invoice generation, payment processing, collections, dispute resolution, and revenue recognition for electric and gas services. Owns charge calculations incorporating FAC, CIAC adjustments, and regulatory riders. Integrates with CIS (Oracle CC&B / SAP IS-U) and ERP for GAAP revenue reporting.' .

ind:Market rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UtilityCompany ;
    rdfs:label 'Market' ;
    rdfs:comment 'Manages participation in wholesale energy markets including day-ahead market (DAM) and real-time market (RTM) bids and schedules, LMP settlement, capacity market obligations, ancillary services, REC tracking, and PPA contract positions. Serves as the SSOT for wholesale energy procurement and sale transactions with RTOs/ISOs. Supports FERC market-based rate authority and IRP resource adequacy analysis.' .

ind:Supply rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UtilityCompany ;
    rdfs:label 'Supply' ;
    rdfs:comment 'Governs procurement of materials, equipment, fuel, and services for utility operations. Manages vendor/contractor master records, purchase orders, contracts, inventory management, warehousing, and logistics for generation fuel, T&D equipment, and O&M supplies. Integrates with ERP (SAP S/4HANA) for procurement-to-pay and supports CAPEX project material management and storm restoration logistics.' .

ind:Regulatory rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UtilityCompany ;
    rdfs:label 'Regulatory' ;
    rdfs:comment 'Manages all compliance obligations, tariff filings, rate cases, CPCN applications, IRP submissions, and regulatory reporting to PUCs, FERC, NERC, and EPA. Tracks dockets, testimony, prudency reviews, performance-based ratemaking (PBR), GHG/emissions compliance records, and cost recovery mechanisms including FAC and AFUDC. Ensures adherence to all jurisdictional requirements.' .

ind:Finance rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UtilityCompany ;
    rdfs:label 'Finance' ;
    rdfs:comment 'Manages financial planning, general ledger, cost accounting, budgeting, and financial reporting. Tracks CAPEX and OPEX, ROE and ROI metrics, EBITDA, depreciation, and regulatory accounting per FERC Uniform System of Accounts. Supports rate case cost-of-service studies, SOX compliance, and GAAP financial statement preparation.' .

ind:Workforce rdf:type rdfs:Class ;
    rdfs:subClassOf ind:UtilityCompany ;
    rdfs:label 'Workforce' ;
    rdfs:comment 'Workforce domain (auto-created for table employee)' .

# --- Data Product Classes (Tables) ---
ind:WholesaleCounterparty rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Market ;
    rdfs:label 'Wholesale Counterparty' ;
    rdfs:comment 'Master record for all wholesale market counterparties with whom the utility transacts in DAM, RTM, capacity markets, and bilateral PPA arrangements. Captures RTO/ISO membership, FERC market-based rate authorization status, credit ratings, DUNS numbers, and counterparty classification (generator, load-serving entity, marketer, financial participant). Serves as the SSOT for wholesale trading partner identity within the market domain.' .

ind:PpaContract rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Market ;
    rdfs:label 'Ppa Contract' ;
    rdfs:comment 'Master record for Power Purchase Agreements governing long-term wholesale energy procurement and sale. Captures contract type (fixed-price, index-linked, tolling), contracted capacity (MW), energy volume (MWh), delivery point, term dates, REC bundling provisions, curtailment rights, force majeure clauses, and FERC filing status. Supports IRP resource adequacy analysis and long-term supply portfolio management.' .

ind:CapacityObligation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Market ;
    rdfs:label 'Capacity Obligation' ;
    rdfs:comment 'Master record for capacity market obligations and commitments registered with an RTO/ISO (e.g., PJM RPM, MISO Planning Resource Auction, ISO-NE FCM). Tracks obligation period, committed MW, resource type, zone, auction clearing price ($/MW-day), performance penalty thresholds, and compliance status. Essential for resource adequacy planning and FERC capacity market reporting.' .

ind:EnergyBid rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Market ;
    rdfs:label 'Energy Bid' ;
    rdfs:comment 'Transactional record capturing individual energy bids and offers submitted to RTO/ISO day-ahead market (DAM) and real-time market (RTM). Stores bid type (energy, ancillary), resource ID, pricing node reference, bid interval (hourly or sub-hourly), bid price ($/MWh), bid quantity (MW), bid curve segments, market (DAM/RTM), submission timestamp, and acceptance/rejection status from the RTO/ISO. Core operational record for wholesale market participation. Note: virtual transactions (INCs/DECs/UTCs) may be captured here as a bid type in MVM scope but warrant a dedicated product at ECM scope for distinct lifecycle and settlement treatment.' .

ind:DispatchAward rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Market ;
    rdfs:label 'Dispatch Award' ;
    rdfs:comment 'Transactional record for generation unit dispatch schedules and commitment instructions awarded by the RTO/ISO following DAM and RTM market clearing. Captures scheduled MW by interval (5-minute or hourly), operating point (economic minimum/maximum), ramp rate limits, unit commitment status (committed, decommitted, self-scheduled), start-up cost ($), no-load cost ($/hr), associated LMP pricing node, and dispatch instruction timestamp. Links generation assets to their awarded market schedules and supports real-time operations coordination with SCADA/EMS for dispatch execution.' .

ind:LmpPrice rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Market ;
    rdfs:label 'Lmp Price' ;
    rdfs:comment 'Transactional record storing Locational Marginal Prices (LMP) published by the RTO/ISO for each pricing node (pnode) and settlement interval. Captures LMP components: energy component, congestion component, and loss component (all in $/MWh), market type (DAM/RTM), interval start/end timestamps, and pnode identifier. Foundational for settlement calculations, hedging analysis, and transmission congestion management.' .

ind:SettlementStatement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Market ;
    rdfs:label 'Settlement Statement' ;
    rdfs:comment 'Header-level transactional record for wholesale market settlement statements issued by the RTO/ISO covering DAM, RTM, capacity, and ancillary service charges and credits. Captures settlement run type (initial, resettlement, true-up, final), billing period, statement version number, total charges ($), total credits ($), net settlement amount, market participant ID, RTO/ISO identifier, payment due date, and statement publication date. Individual charge and credit details are decomposed in settlement_line_item. Serves as the SSOT for wholesale market financial settlement reconciliation and supports FERC EQR and Form 1 reporting.' .

ind:AncillaryServiceAward rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Market ;
    rdfs:label 'Ancillary Service Award' ;
    rdfs:comment 'Transactional record for ancillary service awards received from the RTO/ISO, covering regulation (up/down), spinning reserve, non-spinning reserve, and voltage support. Captures service type, awarded MW, clearing price ($/MW), performance score, deployment events, and associated settlement amounts. Supports NERC reliability compliance and ancillary service revenue tracking.' .

ind:RecInventory rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Market ;
    rdfs:label 'Rec Inventory' ;
    rdfs:comment 'Master record tracking Renewable Energy Certificate (REC) inventory positions. Captures REC vintage year, fuel type (solar, wind, hydro, biomass), generating unit ID, state of issuance, registry account (WREGIS, NEPOOL GIS, PJM-GATS), REC status (available, retired, transferred, reserved), quantity (MWh), and RPS compliance program association. Supports state RPS compliance and voluntary renewable procurement reporting.' .

ind:RecTransaction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Market ;
    rdfs:label 'Rec Transaction' ;
    rdfs:comment 'Transactional record for REC transfers, retirements, and purchases. Captures transaction type (transfer, retirement, purchase, sale), transaction date, quantity (MWh), counterparty, registry transfer confirmation number, price ($/REC), compliance program (RPS, voluntary), and associated PPA contract reference. Provides audit trail for RPS compliance filings with state PUCs.' .

ind:TransmissionRight rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Market ;
    rdfs:label 'Transmission Right' ;
    rdfs:comment 'Master record for financial transmission rights (FTRs) and transmission congestion contracts (TCCs) held by the utility for congestion hedging. Captures right type (FTR obligation, FTR option, TCC, ARR/auction revenue right), source pricing node, sink pricing node, MW quantity, path direction, auction round, term (monthly, seasonal, annual, long-term), acquisition cost ($), current mark-to-market value ($), and expiration date. Each FTR references source and sink pricing nodes for path definition. Used to hedge transmission congestion costs between generation and load delivery points and manage LMP basis spread exposure in the wholesale market portfolio.' .

ind:PricingNode rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Market ;
    rdfs:label 'Pricing Node' ;
    rdfs:comment 'Reference master for all RTO/ISO pricing nodes (pnodes), aggregated pricing nodes (APnodes), load zones, and hub nodes relevant to the utility\'s market participation. Captures pnode ID, pnode name, pnode type (generator bus, load zone, hub, interface), RTO/ISO affiliation, associated substation or bus, effective date range, and geographic coordinates. Foundational reference for LMP price lookups, FTR path definitions, and bid location mapping.' .

ind:ParticipantRegistration rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Market ;
    rdfs:label 'Participant Registration' ;
    rdfs:comment 'Reference master for the utility\'s own registered market participant identities across multiple RTOs/ISOs. Captures participant ID assigned by each RTO/ISO, market registration type (load-serving entity, generator owner, transmission owner, marketer), FERC market-based rate docket number, registration effective date, and active market products authorized (energy, capacity, ancillary services, FTR). Supports FERC compliance and multi-RTO market operations.' .

ind:Docket rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Regulatory ;
    rdfs:label 'Docket' ;
    rdfs:comment 'Master record for each regulatory docket or proceeding filed with or assigned by a jurisdictional authority (PUC, FERC, NERC, EPA, PHMSA). Captures docket number, proceeding type (rate case, CPCN, tariff filing, IRP, rulemaking, complaint, prudency review, compliance investigation), filing jurisdiction, assigned regulatory body, docket status (open, active, suspended, closed), open/close dates, lead attorney, associated case manager, and key milestone dates. Serves as the SSOT anchor for all regulatory proceedings — the central hub to which rate cases, filings, orders, CPCN applications, IRP submissions, and prudency reviews connect.' .

ind:RateCase rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Regulatory ;
    rdfs:label 'Rate Case' ;
    rdfs:comment 'Master record for each general rate case or rate proceeding filed with a state PUC or FERC. Tracks test year, filing date, requested revenue requirement, allowed ROE, rate base, capital structure, final approved rates, effective date, and interim rate/true-up adjustments. For proceedings with Performance-Based Ratemaking (PBR) components, captures PBR metric definitions (SAIDI, SAIFI, CAIDI, customer satisfaction, renewable integration %, EE savings, DR curtailment), approved target values, measurement periods, actual performance values, variance calculations, and earned incentive or assessed penalty amounts per measurement period. Links to parent docket. Serves as the SSOT for the complete rate case lifecycle from filing through final order, including all PBR performance tracking and incentive/penalty calculations. Critical for revenue requirement management, cost recovery authorization, and regulatory performance reporting.' .

ind:TariffSchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Regulatory ;
    rdfs:label 'Tariff Schedule' ;
    rdfs:comment 'Master record for each approved tariff schedule, rate schedule, or tariff sheet on file with a regulatory authority. Captures tariff number, schedule type (electric residential, commercial TOU, CPP, gas distribution, OATT, NEM), effective date, superseded date, jurisdiction, approval order reference, and rate components (energy charge, demand charge, customer charge, FAC rider). Serves as the regulatory SSOT for approved tariff structures distinct from the billing domain\'s operational rate application.' .

ind:Filing rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Regulatory ;
    rdfs:label 'Filing' ;
    rdfs:comment 'Transactional record of each formal document or submission filed with a regulatory body (PUC, FERC, NERC, EPA, DOE, PHMSA). Captures filing type (initial application, testimony, exhibit, compliance filing, annual report, NERC reliability standard filing, EPA emissions report), filing date, filer name, filing status (draft, submitted, accepted, rejected, superseded), regulatory body, associated docket, document reference number, and confidentiality designation. For testimony filings (direct, rebuttal, surrebuttal, errata), additionally captures witness name, witness affiliation (utility, intervenor, PUC staff, independent expert), testimony subject matter (revenue requirement, rate design, capital structure, depreciation, demand forecast), exhibit list, and cross-examination schedule. Links to parent docket. Serves as the SSOT for all documents submitted to regulatory authorities, including the complete evidentiary testimony record for rate cases and contested proceedings.' .

ind:CpcnApplication rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Regulatory ;
    rdfs:label 'Cpcn Application' ;
    rdfs:comment 'Master record for each Certificate of Public Convenience and Necessity (CPCN) application filed for new generation, transmission, or distribution infrastructure. Tracks project name, applied capacity (MW or miles), fuel/technology type, service territory, filing date, environmental review status, PUC/FERC approval status, certificate issuance date, conditions of approval, and associated capital project reference. Essential for tracking regulatory authorization of major capital investments.' .

ind:IrpSubmission rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Regulatory ;
    rdfs:label 'Irp Submission' ;
    rdfs:comment 'Master record for each Integrated Resource Plan (IRP) submission filed with the state PUC or energy authority. Captures plan cycle year, planning horizon (years), total forecasted peak demand (MW), resource portfolio mix (fossil, nuclear, renewable, DR, EE), RPS compliance percentage, preferred resource plan description, alternative scenarios evaluated, filing date, PUC acknowledgment date, and next update due date. Tracks the utility\'s long-range resource adequacy planning obligations.' .

ind:ComplianceObligation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Regulatory ;
    rdfs:label 'Compliance Obligation' ;
    rdfs:comment 'Master record for each ongoing regulatory compliance obligation the utility must fulfill — including NERC reliability standards (CIP, FAC, MOD, PRC), EPA emissions regulations (Clean Air Act, GHG reporting rule), PHMSA pipeline safety rules (49 CFR 192), PUC service quality standards (SAIDI, SAIFI, CAIDI targets), and FERC OATT requirements. Captures standard/rule identifier, governing body, obligation type, compliance frequency (annual, quarterly, event-driven, continuous), responsible business unit, current compliance status (compliant, non-compliant, under review), evidence retention requirements, next due date, and escalation contacts. Serves as the compliance obligation registry — the authoritative list of everything the utility must comply with and when.' .

ind:ComplianceEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Regulatory ;
    rdfs:label 'Compliance Event' ;
    rdfs:comment 'Transactional record of each compliance activity, evidence submission, or violation event associated with a regulatory compliance obligation. Captures event type (evidence submission, self-report, violation notice, corrective action, audit finding, penalty assessment), event date, obligation reference, responsible party, compliance status (compliant, deficient, remediated), penalty amount if applicable, and corrective action plan reference. Provides the audit trail for demonstrating compliance to NERC, EPA, PUC, and FERC.' .

ind:EmissionsReport rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Regulatory ;
    rdfs:label 'Emissions Report' ;
    rdfs:comment 'Transactional record of GHG and criteria pollutant emissions reported per generation unit or facility per reporting period. Captures facility/unit identifier, reporting period, pollutant type (CO2, NOx, SO2, CH4, particulates), emissions quantity (tons), emissions intensity (lbs/MWh), measurement methodology (CEMS, fuel-factor), EPA facility ID, REC retirement linkage, and submission status to EPA or state air quality agency. Supports GHG compliance, RPS tracking, and environmental regulatory reporting obligations.' .

ind:PrudencyReview rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Regulatory ;
    rdfs:label 'Prudency Review' ;
    rdfs:comment 'Master record for each prudency review or management audit initiated by a PUC or FERC to evaluate the reasonableness of utility expenditures for cost recovery. Captures review type (capital project prudency, O&M prudency, fuel cost prudency, storm cost recovery), triggering docket, review scope description, total expenditure under review (CAPEX/OPEX), reviewer identity (PUC staff, independent auditor), preliminary finding, final determination (prudent/imprudent/partial), disallowed amount, and effective date of determination.' .

ind:CostRecoveryMechanism rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Regulatory ;
    rdfs:label 'Cost Recovery Mechanism' ;
    rdfs:comment 'Master record for each approved regulatory cost recovery mechanism or rider in effect for the utility. Covers FAC (Fuel Adjustment Clause), AFUDC (Allowance for Funds Used During Construction), CIAC (Contribution in Aid of Construction), infrastructure riders, storm cost recovery trackers, and DSM/EE program cost recovery mechanisms. Captures mechanism type, regulatory approval reference, recovery period, rate base treatment, annual cap (if any), current balance, and true-up frequency. Distinct from billing rate schedules — this is the regulatory authorization record.' .

ind:CommissionOrder rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Regulatory ;
    rdfs:label 'Commission Order' ;
    rdfs:comment 'Transactional record of each final order, decision, or ruling issued by a regulatory authority (PUC, FERC, NERC, EPA) in connection with a docket or proceeding. Captures order number, issuing authority, order date, order type (final order, interim order, consent order, show cause order, penalty notice), summary of decision, approved revenue requirement or rate change, compliance deadline, appeal period, and appeal status. Serves as the authoritative record of regulatory decisions binding on the utility.' .

ind:CostCenter rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Cost Center' ;
    rdfs:comment 'Master record for organizational cost centers used to allocate and track OPEX and CAPEX across the utility\'s functional units (generation, transmission, distribution, gas, corporate). Aligned with SAP S/4HANA cost center master and FERC Uniform System of Accounts (USoA) organizational hierarchy. Captures cost center code, description, responsible manager, functional area, plant/location assignment, and active status. Serves as the foundational dimension for all financial reporting and cost-of-service studies.' .

ind:GlAccount rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Gl Account' ;
    rdfs:comment 'General ledger account master aligned to the FERC Uniform System of Accounts (USoA) chart of accounts for regulated electric and gas utilities. Captures account number, account name, FERC account code (e.g., Account 101 – Electric Plant in Service, Account 303 – Miscellaneous Intangible Plant), account type (asset, liability, equity, revenue, expense), normal balance indicator, and GAAP classification. Serves as the SSOT for all ledger postings, rate case cost-of-service studies, and FERC Form 1/2 regulatory filings. Sourced from SAP S/4HANA or Oracle ERP Cloud chart of accounts module.' .

ind:JournalEntry rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Journal Entry' ;
    rdfs:comment 'Header record for every general ledger posting made in the utilitys ERP system (SAP S/4HANA or Oracle ERP Cloud). Captures journal entry number, posting date, fiscal period, fiscal year, document type (standard, accrual, reversal, intercompany, recurring, statistical), posting key, total debit amount, total credit amount, currency, reference document, source module (FI, CO, MM, PM, SD), posting user, approval status, and reversal indicator. Supports GAAP financial statement preparation, SOX internal controls (segregation of duties audit trail, dual-approval enforcement), and FERC regulatory accounting. Each journal entry header links to one or more line items captured in journal_entry_line. Balanced entry validation (total debits = total credits) is enforced at this level.' .

ind:JournalEntryLine rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Journal Entry Line' ;
    rdfs:comment 'Line-item detail for each general ledger journal entry posting. Captures line number, GL account, cost center, WBS element, functional area, debit/credit indicator, amount in transaction currency, amount in company code currency, tax code, profit center, segment, and business area. Enables granular cost allocation, FERC account-level reporting, and SOX-compliant audit trails at the individual posting level. One-to-many relationship with journal_entry header.' .

ind:CapexProject rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Capex Project' ;
    rdfs:comment 'Master record for capital expenditure projects tracked under the utilitys capital program. Captures WBS (Work Breakdown Structure) element, project number, project description, asset class, FERC plant account (e.g., Account 101 Electric Plant in Service, Account 107 Construction Work in Progress), project type (transmission, distribution, generation, gas, IT, environmental/compliance), authorized capital budget, AFUDC (Allowance for Funds Used During Construction) eligibility flag and accrual rate, CIAC (Contribution in Aid of Construction) indicator and amount, project manager, in-service date target, actual in-service date, project status (planned, approved, in-progress, complete, closed, cancelled), and blanket vs. specific project indicator. Supports CAPEX tracking, rate base calculations, CWIP balance reporting, regulatory plant additions reporting, and capital program prioritization. Blanket projects represent recurring capital programs (e.g., annual pole replacement) while specific projects represent discrete capital investments.' .

ind:CapexExpenditure rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Capex Expenditure' ;
    rdfs:comment 'Transactional record of actual capital expenditures charged to a CAPEX project or WBS element. Captures expenditure date, amount, expenditure type (labor, materials, contractor, overhead, AFUDC accrual), purchase order reference, vendor, cost center, GL account, FERC plant account, capitalization status (WIP vs. placed-in-service), and approval reference. Enables tracking of spend against authorized capital budget, supports CWIP (Construction Work in Progress) balance reporting, and feeds the fixed asset capitalization process upon project completion.' .

ind:Budget rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Budget' ;
    rdfs:comment 'Annual and multi-year financial budget record for the utility, organized by cost center, GL account, functional area, and fiscal period. Captures budget version (original, revised, forecast, long-range plan), budget type (OPEX/O&M, CAPEX, revenue), fiscal year, period-level budget amounts, total approved budget amount, variance threshold percentage, budget owner, and approval status. Supports monthly budget-vs-actual variance reporting, financial planning cycles, rate case cost-of-service test year development, PBR (Performance-Based Ratemaking) target-setting, and board-level capital program approval. Each budget record represents a unique combination of version, type, cost center, and GL account for a fiscal year. Sourced from SAP S/4HANA Controlling (CO-PA) or Oracle ERP Cloud Budgetary Control module.' .

ind:FixedAsset rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Fixed Asset' ;
    rdfs:comment 'Master record for capitalized utility plant assets tracked in the fixed asset subledger, aligned to FERC Uniform System of Accounts plant accounts. Captures asset number, asset description, FERC plant account (e.g., 101 Electric Plant in Service, 303 Miscellaneous Intangible Plant, 376 Distribution Mains — Gas), asset class, vintage year, acquisition date, in-service date, original cost, accumulated depreciation, net book value, depreciation method (straight-line, group/composite), useful life, net salvage rate (including negative salvage/cost of removal), retirement date, retirement type (normal, abnormal, extraordinary), asset location, and CWIP-to-plant transfer reference. Serves as the financial SSOT for utility plant valuation, depreciation studies, rate base calculations, and FERC Form 1 plant schedules (Schedules 204-207). Complements the operational asset record in the asset domain. Vintage year and net salvage rate are critical for group/composite depreciation studies unique to the utility industry.' .

ind:DepreciationRun rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Depreciation Run' ;
    rdfs:comment 'Transactional record of periodic depreciation calculation runs executed against the fixed asset subledger. Captures run date, fiscal period, fiscal year, depreciation area (book/GAAP, federal tax, state tax, regulatory/FERC, AMT, group/composite), total depreciation amount posted, number of assets processed, run status (planned, simulated, posted, reversed), posting document reference, run initiator, and depreciation method applied (straight-line, group/composite, sum-of-years-digits, declining balance, units-of-production). Supports GAAP straight-line and group/composite depreciation methods commonly used by utilities, regulatory depreciation per PUC-approved depreciation study rates (including interim and final rates), tax depreciation (MACRS with bonus depreciation), and FERC Form 1 depreciation reporting (Schedule 336 — Depreciation and Amortization of Electric Plant). Enables audit trail for SOX compliance over the depreciation posting process, supports depreciation study true-up analysis, and provides the depreciation expense input for rate case cost-of-service calculations.' .

ind:OpexTransaction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Opex Transaction' ;
    rdfs:comment 'Transactional record capturing operating expenditures (O&M costs) posted to the general ledger, including labor, materials, contractor services, fuel costs (FAC-eligible), and overhead allocations. Captures transaction date, amount, FERC O&M account (e.g., Account 500-series for Electric Operation, Account 800-series for Gas Operation), cost center, functional area, expense category, purchase order reference, vendor, and approval status. Supports OPEX tracking against budget, rate case O&M cost-of-service studies, and FERC Form 1/2 O&M expense reporting.' .

ind:ProfitCenter rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Profit Center' ;
    rdfs:comment 'Master record for profit centers representing the utility\'s business segments used for internal profitability reporting and regulatory segment reporting. Captures profit center code, description, responsible manager, business segment (electric generation, electric transmission, electric distribution, gas distribution, unregulated), company code, controlling area, and active status. Supports FERC-required segment reporting, ROE (Return on Equity) and ROI analysis by business unit, and EBITDA reporting by segment. Sourced from SAP S/4HANA Controlling (CO-PCA) module.' .

ind:RateCaseCostStudy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Rate Case Cost Study' ;
    rdfs:comment 'Master record for cost-of-service studies prepared in support of rate case filings with state PUCs or FERC. Captures rate case identifier, filing jurisdiction (PUC state, FERC), test year, rate case type (general rate case, transmission rate case, gas rate case), total revenue requirement, rate base amount, authorized ROE, WACC, O&M expense allocation, depreciation expense, taxes, and filing status. Links to supporting GL accounts, cost centers, and CAPEX projects. Supports CPCN applications, IRP cost justifications, and PBR performance target derivation.' .

ind:FinancialPeriod rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Financial Period' ;
    rdfs:comment 'Reference master for fiscal periods and fiscal years used across the utilitys financial reporting calendar. Captures fiscal period number (1-12 plus adjustment periods 13-16), fiscal year, calendar month start and end dates, period status (open, closed, locked, future), period type (regular, adjustment, year-end closing, special), and controlling area. Governs which periods are open for journal entry posting, controls period-end and year-end close workflows, ensures consistent fiscal period alignment across GL, asset accounting, cost controlling, and regulatory reporting modules. Critical for SOX compliance — period lock controls prevent unauthorized postings to closed periods. Sourced from SAP S/4HANA FI fiscal year variant configuration or Oracle ERP Cloud accounting calendar.' .

ind:Line rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Line' ;
    rdfs:comment 'Master record for high-voltage bulk electric system (BES) transmission lines owned and operated by the utility. Captures line identifier, voltage class (kV), circuit configuration (single/double), conductor type, rated thermal capacity (MVA), line length (miles), in-service date, NERC BES classification, FERC jurisdiction flag, RTO/ISO region, GIS route reference, operating status, and ownership percentage. Serves as the SSOT for transmission line infrastructure identity and physical characteristics. Source system: ESRI ArcGIS and Oracle WAM/IBM Maximo.' .

ind:TransmissionSubstation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Transmission Substation' ;
    rdfs:comment 'Master record for transmission substations including switching stations and transformer banks at the bulk electric system level. Captures substation name, NERC node ID, voltage levels served (kV high/low), substation type (switching, step-down, converter), installed transformer capacity (MVA), bus configuration, SCADA point reference, GIS coordinates, NERC CIP classification (high/medium/low impact), in-service date, and operating status. SSOT for substation identity across the transmission network. Source system: ESRI ArcGIS, OSIsoft PI/GE Proficy, ABB/GE EMS.' .

ind:Transformer rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Transformer' ;
    rdfs:comment 'Master record for bulk transmission power transformers and autotransformers installed at BES substations. Captures transformer nameplate data (MVA rating, HV/LV/TV kV, impedance %), manufacturer, serial number, installation date, cooling class (ONAN/ONAF/OFAF), tap changer type (LTC/fixed), dissolved gas analysis (DGA) baseline, NERC CIP asset classification, and current operational status. Distinct from distribution transformers owned by the distribution domain. Source system: Oracle WAM/IBM Maximo.' .

ind:GridTopology rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Grid Topology' ;
    rdfs:comment 'Represents versioned snapshots of the logical network topology model of the bulk electric system — the bus-branch or node-breaker connectivity model that defines how transmission elements (lines, transformers, buses, breakers, switches) are electrically interconnected. Each record captures a single topology model version with effective date/time, network island identifier, base case flag, contingency scenario reference (N-1/N-2/N-k), EMS/SCADA model synchronization status, state estimator solution status (converged/diverged), and model change reason (switching operation, new construction, seasonal configuration). Topology versions are created when switching operations, construction activities, or seasonal reconfigurations alter the electrical connectivity. Used for real-time state estimation, power flow studies, contingency analysis, and outage coordination. SSOT for the logical electrical connectivity model of the transmission network. Source system: ABB/GE Energy Management System (EMS), PSS/E or PSLF study models.' .

ind:TransferCapability rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Transfer Capability' ;
    rdfs:comment 'Tracks available transfer capability (ATC), total transfer capability (TTC), transmission reliability margin (TRM), and capacity benefit margin (CBM) for transmission paths and flowgates on the BES. Each record represents a single ATC calculation for a specific path/flowgate, direction, and time horizon. Captures path/flowgate identifier, direction (forward/reverse), TTC (MW), TRM (MW), CBM (MW), ATC (MW) calculated per NERC MOD-028/029/030 methodology, posted date/time, study horizon (hourly/daily/weekly/monthly), OATT OASIS posting reference, and recalculation trigger (topology change/schedule update/TLR event). ATC = TTC - TRM - CBM - existing commitments - pending commitments. Required for FERC OATT compliance, OASIS posting obligations under 18 CFR §37, and NERC MOD standard compliance. Source system: ABB/GE EMS, OASIS portal, internal ATC calculation engine.' .

ind:InterchangeSchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Interchange Schedule' ;
    rdfs:comment 'Records energy interchange schedules between the utility\'s balancing authority area and RTO/ISO markets or neighboring balancing authorities. Each record represents a single scheduled interchange for a specific hourly or sub-hourly time interval. Captures schedule ID, counterparty BA identifier, RTO/ISO name, schedule type (import/export/wheel-through/dynamic transfer), energy amount (MW), ramp rate (MW/min), start/end datetime, e-Tag reference number, NERC e-Tag ID, curtailment flag, curtailment priority, checkout status (confirmed/denied/pending), and settlement status. Supports day-ahead market (DAM), real-time market (RTM), and bilateral transaction scheduling. Critical for NERC BAL-006 (Inadvertent Interchange) compliance, NERC INT standards (INT-004, INT-006, INT-009, INT-010), and FERC EQR (Electric Quarterly Report) reporting. Source system: ABB/GE EMS, NERC e-Tag system (OATI webTrans), RTO scheduling portals.' .

ind:ServiceRequest rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Service Request' ;
    rdfs:comment 'Tracks requests for transmission service under the OATT — including point-to-point (PTP) and network integration transmission service (NITS) requests from eligible customers and third parties. Captures request ID, service type (firm/non-firm, PTP/NITS), requesting entity, point of receipt, point of delivery, requested capacity (MW), requested start/end date, OASIS queue number, feasibility study status, system impact study status, facilities study status, and service agreement reference. Required for FERC OATT compliance. Source system: OASIS portal, internal transmission planning systems.' .

ind:InterconnectionRequest rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Interconnection Request' ;
    rdfs:comment 'Manages generator and large-load interconnection requests submitted under FERC Order 2003/2006 (LGIP/SGIP) processes. Captures request ID, applicant entity, project type (generation/load), technology type (thermal/wind/solar/storage), requested capacity (MW), proposed point of interconnection (POI), queue position, study phase (feasibility/system impact/facilities), estimated upgrade cost ($), commercial operation date (COD) target, and request status. SSOT for interconnection queue management. Source system: Transmission planning and interconnection management systems.' .

ind:CongestionEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Congestion Event' ;
    rdfs:comment 'Records transmission congestion events on the BES — instances where physical or economic constraints limit power flow on a transmission path, flowgate, or monitored element. Each record represents a single binding or near-binding constraint event. Captures event ID, constrained element reference (line/transformer/flowgate), constraint type (thermal/voltage/stability/contractual), start/end datetime, duration (hours), binding constraint flag, shadow price ($/MWh), congestion cost ($), curtailed MW, TLR level (if applicable), RTO/ISO constraint name, associated LMP congestion component reference, and resolution action taken (redispatch/TLR/switching/load shed). Used for congestion cost tracking, FTR/ARR hedging analysis, transmission upgrade economic justification, and NERC TPL compliance. Source system: ABB/GE EMS, RTO/ISO constraint and LMP data feeds.' .

ind:Outage rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Outage' ;
    rdfs:comment 'Records planned, forced, and maintenance outages of BES transmission elements (lines, transformers, substations, buses, switching equipment) for maintenance, construction, emergency restoration, or third-party accommodation. Captures outage ID, element type and ID, outage type (planned/forced/maintenance), outage cause (weather/equipment failure/human error/vegetation), start/end datetime, outage duration (hours), MW load impact, affected customers count, NERC outage cause code, RTO/ISO notification reference, NERC TADS reporting flag, associated switching order reference, crew assignment, and restoration status. Feeds NERC TADS (Transmission Availability Data System) reporting, SAIDI/SAIFI reliability metrics, and RTO/ISO outage coordination. Source system: Schneider/GE OMS, Oracle WAM/IBM Maximo, ABB/GE EMS.' .

ind:NercCipAsset rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Nerc Cip Asset' ;
    rdfs:comment 'Master record for NERC CIP (Critical Infrastructure Protection) regulated BES cyber systems and associated cyber assets at transmission facilities. Each record represents a distinct BES cyber system (e.g., EMS, SCADA RTU, relay communication processor) within a CIP-regulated substation or control center. Captures asset ID, associated substation or control center, BES cyber system identifier, impact rating (high/medium/low per CIP-002-5.1a), applicable CIP standard requirements (CIP-002 through CIP-014), electronic security perimeter (ESP) membership, physical security perimeter (PSP) membership, responsible entity, last vulnerability assessment date, last CIP audit date, evidence artifact reference, compliance status, remediation plan reference, and next assessment due date. SSOT for NERC CIP asset inventory within the transmission domain — critical for CIP-002 categorization, CIP-005 ESP management, CIP-010 configuration management, and CIP-014 physical security assessments. Source system: NERC CIP compliance management systems (e.g., RSA Archer, ServiceNow GRC).' .

ind:TariffRate rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Tariff Rate' ;
    rdfs:comment 'Reference master for FERC-approved transmission tariff rates and rate schedules applicable under the OATT. Captures rate schedule ID, rate type (network/point-to-point/ancillary service), service class (firm/non-firm), rate zone, demand charge ($/kW-month), energy charge ($/MWh), ancillary service component rates, FERC docket reference, effective date, expiration date, and PUC/FERC approval status. Used for transmission service billing and OATT compliance. Source system: SAP IS-U/Oracle CC&B, FERC eTariff.' .

ind:Feeder rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Feeder' ;
    rdfs:comment 'Master record for electric distribution feeders — the primary medium-voltage circuits (typically 4kV–35kV) emanating from distribution substations to deliver electricity to end-use customers. Captures feeder identifier, nominal voltage, circuit configuration (radial/loop/networked), rated capacity (MVA), peak load, substation source bus, feeder length (miles), conductor type, phase configuration, GIS network topology reference, SCADA point ID, operational status, and service territory. SSOT for feeder-level reliability metrics (SAIDI, SAIFI, CAIDI) and OMS/DMS circuit topology. Sourced from ESRI ArcGIS and Schneider Electric AMS/GE PowerOn.' .

ind:ServiceTransformer rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Service Transformer' ;
    rdfs:comment 'Master record for distribution service transformers — pad-mounted, pole-mounted, or vault transformers that step down medium-voltage feeder voltage to utilization voltage (120/240V residential; 277/480V commercial) for last-mile delivery. Captures transformer ID, kVA rating, primary/secondary voltage, phase configuration (single/three-phase), installation type, GPS coordinates, feeder association, pole/structure number, manufacturer, model, serial number, installation date, oil/dry type, load factor, and operational status. Critical for load balancing, outage isolation, and asset lifecycle management. Sourced from ESRI ArcGIS and Oracle WAM/IBM Maximo.' .

ind:DistributionSubstation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Distribution Substation' ;
    rdfs:comment 'Master record for distribution substations — facilities that receive bulk power from the transmission system and step down voltage for distribution feeder circuits. Captures substation ID, name, location (GPS/GIS), service territory, nominal primary voltage (transmission side), secondary voltage (distribution side), total installed transformer capacity (MVA), number of distribution feeders served, SCADA integration point, ownership type, commissioning date, and operational status. Distinct from transmission substations (owned by the transmission domain). Sourced from ESRI ArcGIS and Schneider Electric AMS/GE PowerOn.' .

ind:ServicePoint rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Service Point' ;
    rdfs:comment 'Master record for electric and gas service delivery points — the physical location where utility service is delivered to an end-use customer premise. Captures service point ID, service address, GPS coordinates, GIS parcel reference, service type (electric/gas/dual), premise type (residential/commercial/industrial), meter socket ID, feeder or gas main association, transformer association, service lateral details, load classification, NEM eligibility flag, DER interconnection flag, and active/inactive status. Serves as the geographic and physical SSOT linking the distribution network topology to customer accounts and metering infrastructure. Each service point represents one service delivery of a given type at a premise — a dual-service premise has separate electric and gas service points. Sourced from ESRI ArcGIS and Oracle CC&B/SAP IS-U.' .

ind:GasMain rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Gas Main' ;
    rdfs:comment 'Master record for gas distribution mains — the pressurized pipeline segments that transport natural gas from city gate stations through the distribution network to service laterals and end-use customers. Captures main ID, pipe material (steel/PE/cast iron), nominal diameter (inches), operating pressure (PSIG), MAOP (Maximum Allowable Operating Pressure), installation year, coating type, cathodic protection status, GIS route geometry, district/pressure zone, leak survey date, PHMSA class location, and operational status. SSOT for PHMSA pipeline safety compliance and gas distribution network topology. Sourced from ESRI ArcGIS.' .

ind:DistributionOutageEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Distribution Outage Event' ;
    rdfs:comment 'Transactional record for electric distribution outage events — unplanned or planned interruptions to customer electric service tracked through the OMS/DMS. Captures outage event ID, outage type (unplanned/planned/momentary), cause code (weather/equipment failure/animal/vegetation/etc.), affected feeder, affected transformer, estimated customers affected, actual customers affected, outage start timestamp, restoration timestamp, outage duration (minutes), crew dispatch reference, SAIDI contribution (minutes), SAIFI contribution (count), CAIDI calculation, IEEE 1366 exclusion flag, and restoration method. Primary source for SAIDI/SAIFI/CAIDI reliability index calculations reported to PUCs. Sourced from Schneider Electric AMS/GE PowerOn OMS.' .

ind:ReliabilityIndex rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Reliability Index' ;
    rdfs:comment 'Periodic transactional record capturing computed SAIDI, SAIFI, and CAIDI reliability indices at the feeder, substation, and system level for regulatory reporting periods (monthly, annual). Captures index record ID, reporting period (month/year), reporting level (system/substation/feeder), associated feeder or substation reference (nullable based on reporting level), SAIDI value (minutes), SAIFI value (interruptions per customer), CAIDI value (minutes per interruption), MAIFI (momentary average interruption frequency), total customer-minutes interrupted, total customers served, IEEE 1366 major event day exclusion flag, excluded SAIDI, and PUC reporting status. SSOT for regulatory reliability performance reporting to state PUCs and NERC. Distinct from raw outage_event records — this is the aggregated index record. FK references to feeder or distribution_substation are nullable depending on reporting_level discriminator (system-level records have no parent entity FK).' .

ind:DerInterconnection rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Der Interconnection' ;
    rdfs:comment 'Master record for Distributed Energy Resource (DER) interconnections on the distribution network — rooftop solar, battery storage, small wind, CHP, and EV charging installations that connect to the distribution grid at the customer premise. Captures interconnection ID, DER type (solar PV/battery/wind/CHP/EV charger), installed capacity (kW-DC/kW-AC), inverter type, IEEE 1547 compliance status, NEM enrollment flag, NEM tariff type, service point reference, feeder association, transformer association, interconnection agreement date, commissioning date, anti-islanding protection type, export capability (kW), DERMS integration flag, and operational status. SSOT for NEM/DER program management and DERMS integration. Sourced from Oracle CC&B/SAP IS-U and DERMS platform.' .

ind:VoltageRegulationDevice rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Voltage Regulation Device' ;
    rdfs:comment 'Master record for voltage regulation equipment deployed on distribution feeders — voltage regulators, capacitor banks, and line reactors used to maintain voltage within ANSI C84.1 service voltage standards along distribution circuits. Captures device ID, device type (voltage regulator/capacitor bank/reactor), feeder location (circuit mile marker), rated kVAR or kVA, control mode (automatic/manual/SCADA), voltage setpoint, bandwidth setting, time delay, installation date, GIS coordinates, SCADA point ID, last tap position, VOLT/VAR optimization (VVO) program enrollment, and operational status. Essential for voltage profile management, power quality, conservation voltage reduction (CVR), and DER integration on feeders with high penetration of rooftop solar.' .

ind:SwitchingOperation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Switching Operation' ;
    rdfs:comment 'Transactional record for distribution switching operations — planned or emergency switching actions performed on distribution network devices (reclosers, sectionalizers, switches, breakers) to isolate faults, restore service, reconfigure circuits, or enable planned maintenance. Captures switching operation ID, operation type (planned/emergency/restoration), switching order number, device operated (switch/recloser/sectionalizer/breaker), feeder affected, operation timestamp, operator ID, authorization reference, pre-switch configuration, post-switch configuration, customers affected, outage event association, tag/lockout status, safety clearance reference, and completion status. Sourced from Schneider Electric AMS/GE PowerOn DMS and SCADA. Supports OSHA lockout/tagout compliance and switching safety audit trails.' .

ind:GasLeakSurvey rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Gas Leak Survey' ;
    rdfs:comment 'Transactional record for PHMSA-mandated gas leak surveys and leak investigations on gas distribution mains, service laterals, and associated facilities. Captures survey ID, survey type (leak survey/leak investigation/follow-up), survey date, surveyor ID, pipeline segment surveyed (gas main reference), survey method (bar-hole/CGI/flame ionization), leak grade (Grade 1 hazardous/Grade 2 non-hazardous/Grade 3 non-hazardous), leak location (GPS), leak size estimate (MCF/day), repair priority, repair due date, repair completion date, and regulatory reporting status. SSOT for PHMSA 49 CFR Part 192 pipeline safety compliance and AGA leak survey reporting.' .

ind:LoadProfile rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Load Profile' ;
    rdfs:comment 'Transactional record capturing aggregated interval-level load measurements and demand readings at the feeder, substation, and service transformer level for distribution planning, capacity analysis, hosting capacity studies, and demand response program management. Captures load profile ID, measurement point (feeder/substation/transformer), measurement interval (15-min/30-min/60-min), timestamp, real power (kW), reactive power (kVAR), apparent power (kVA), power factor, peak demand (kW), load factor, temperature-adjusted demand, data source (SCADA/AMI aggregation), and data quality flag. Supports DER hosting capacity analysis by providing baseline load data for feeder-level solar/storage impact modeling. Represents aggregated network-level load data for distribution operations — distinct from raw SCADA telemetry points and AMI meter interval reads (owned by metering domain). Granularity is one record per measurement point per interval. Sourced from OSIsoft PI/GE Proficy SCADA historian.' .

ind:DemandResponseEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Demand Response Event' ;
    rdfs:comment 'Transactional record for demand response (DR) and load management curtailment events dispatched through the distribution network — peak shaving, direct load control, and DSM program activations targeting distribution-connected load. Captures DR event ID, event type (peak shaving/direct load control/voluntary curtailment/CPP activation), program name, triggering condition (system peak/grid emergency/price signal), event start timestamp, event end timestamp, target feeder or zone, target load reduction (kW), actual load reduction achieved (kW), number of customers notified, number of customers responding, curtailment compliance rate, and event outcome status. Scoped to the distribution-network dispatch and measurement perspective — DR program enrollment and customer participation records are owned by the customer domain; wholesale market DR bidding is owned by the market domain. Sourced from DERMS and Oracle CC&B/SAP IS-U DR program modules.' .

ind:Meter rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Metering ;
    rdfs:label 'Meter' ;
    rdfs:comment 'Master record for every physical meter asset deployed across the AMI/AMR network — electric and gas. Captures meter serial number, manufacturer, model, meter type (AMI/AMR/electromechanical), fuel type (electric/gas), form factor, voltage class, current rating, multiplier, number of dials, communication module type (RF/PLC/cellular), firmware version, ownership (utility-owned vs customer-owned), installation status, and lifecycle state. Serves as the SSOT for meter inventory within the metering domain, sourced from Oracle Utilities MDMS / Itron Analytics and cross-referenced with the enterprise asset register in the asset domain.' .

ind:MeterPremise rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Metering ;
    rdfs:label 'Meter Premise' ;
    rdfs:comment 'Authoritative association record linking a meter to a service premise (service point / delivery point) for a defined effective date range. Tracks meter-to-premise installation date, removal date, meter position (main/sub/check), seal number, initial and final register reads at install/removal, and the technician work order reference. Supports move-in/move-out workflows and ensures billing domain can resolve which meter served a premise during any billing period. Sourced from Oracle Utilities MDMS and Oracle CC&B / SAP IS-U service point records.' .

ind:AmiEndpoint rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Metering ;
    rdfs:label 'Ami Endpoint' ;
    rdfs:comment 'Master record for each AMI communication endpoint (smart meter head-end registration) within the Advanced Metering Infrastructure network. Captures endpoint EUI/MAC address, communication module serial, head-end system identifier, network type (RF mesh / PLC / cellular), firmware version, signal strength baseline, last successful communication timestamp, communication status, and assigned collector/concentrator node. Distinct from the physical meter record — one meter may have one endpoint; this entity tracks the network-layer identity managed by the AMI head-end system (Itron Analytics / Oracle Utilities MDMS).' .

ind:IntervalRead rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Metering ;
    rdfs:label 'Interval Read' ;
    rdfs:comment 'High-volume transactional table storing raw and validated interval energy consumption readings collected from AMI/AMR meters. Each record represents one interval period (typically 15-min or 60-min) for one meter channel, capturing: meter identifier, channel number, read timestamp (interval start/end), interval duration in minutes, raw kWh or MCF value, demand kW value (where applicable), read quality code (actual/estimated/substituted), VEE status flag, data source (AMI head-end / manual / estimated), and collection timestamp. This is the foundational dataset for billing interval data, TOU rate application, demand response baselines, and load research. Sourced from Oracle Utilities MDMS / Itron Analytics.' .

ind:RegisterRead rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Metering ;
    rdfs:label 'Register Read' ;
    rdfs:comment 'Transactional record of scalar (cumulative) meter register reads captured at scheduled read cycles or on-demand. Stores meter identifier, register number, read date, read time, read type (scheduled/on-demand/move-in/move-out/special), read method (AMR/AMI/manual/estimated), raw register value, unit of measure (kWh/MCF/Therm/kW), multiplier-applied consumption value, previous read value, consumption delta, and read quality indicator. Feeds billing domain for non-interval rate schedules and serves as the fallback read source when interval data is unavailable. Sourced from Oracle Utilities MDMS and Oracle CC&B / SAP IS-U.' .

ind:VeeEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Metering ;
    rdfs:label 'Vee Event' ;
    rdfs:comment 'Transactional record capturing each Validation, Estimation, and Editing (VEE) action applied to interval or register read data within the MDMS. Records the affected meter, read period, VEE rule triggered (spike/dropout/missing/negative/sum-check), original raw value, corrected/estimated value, estimation algorithm used (regression/weather-normalized/profile-based), VEE status (validated/estimated/edited/rejected), analyst override flag, override justification, and processing timestamp. Provides the full audit trail for read quality assurance required for regulatory billing accuracy compliance and MDMS data governance. Sourced from Oracle Utilities MDMS / Itron Analytics VEE engine.' .

ind:MeterEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Metering ;
    rdfs:label 'Meter Event' ;
    rdfs:comment 'Transactional log of operational events and alarms reported by AMI smart meters and endpoints to the head-end system. Captures event type (tamper/outage/restoration/power-quality/low-battery/reverse-flow/tilt/cover-removal/communication-loss), event timestamp, meter identifier, endpoint identifier, event severity, raw event code from the device, acknowledgment status, and downstream notification flag (e.g., forwarded to OMS for outage correlation). Supports outage detection, theft/tamper investigation, power quality monitoring, and field crew dispatch. Sourced from Itron Analytics / Oracle Utilities MDMS event stream.' .

ind:ReadCycle rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Metering ;
    rdfs:label 'Read Cycle' ;
    rdfs:comment 'Master reference entity defining scheduled meter reading cycles used to organize meter reads for billing and data collection. Captures cycle code, cycle name, read frequency (monthly/bi-monthly/daily/on-demand), scheduled read day-of-month, billing cycle alignment, geographic route grouping, AMI collection window start/end times, and active status. Drives the scheduling of both AMI automated collection jobs and manual meter reading routes. Referenced by register_read and interval_read to associate reads with their originating cycle. Managed within Oracle Utilities MDMS and Oracle CC&B / SAP IS-U.' .

ind:MeterProgramEnrollment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Metering ;
    rdfs:label 'Meter Program Enrollment' ;
    rdfs:comment 'Transactional record tracking a meter\'s enrollment in utility programs that require metering configuration changes or special data collection — including TOU (Time-of-Use), CPP (Critical Peak Pricing), NEM (Net Energy Metering), DR (Demand Response), EV charging programs, and EE (Energy Efficiency) interval monitoring programs. Captures meter identifier, program code, enrollment effective date, end date, program-specific meter configuration requirements (e.g., TOU rate schedule, demand threshold, export channel activation), enrollment status, and the triggering customer account reference. This entity owns the metering-domain impact of program enrollment — the meter configuration changes, channel activations, and data collection requirements. Customer-level program participation and billing rate application are owned by the customer and billing domains respectively. Managed within Oracle Utilities MDMS and coordinated with Oracle CC&B / SAP IS-U.' .

ind:RemoteServiceAction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Metering ;
    rdfs:label 'Remote Service Action' ;
    rdfs:comment 'Transactional record of remote connect/disconnect and load control commands issued to AMI-capable meters via the head-end system. Captures action type (connect/disconnect/load-limit/ping/on-demand-read/firmware-update), initiating system (CIS/billing/field-ops), command timestamp, execution timestamp, result status (success/failed/pending/timeout), failure reason code, meter identifier, endpoint identifier, authorized user or automated process reference, and regulatory compliance flag (e.g., disconnection moratorium override). Supports billing collections workflows, safety disconnections, and demand response load control. Sourced from Itron Analytics / Oracle Utilities MDMS remote command log.' .

ind:MeterTest rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Metering ;
    rdfs:label 'Meter Test' ;
    rdfs:comment 'Transactional record of accuracy and performance tests conducted on meters — both in-field and in-laboratory settings. Captures test type (in-service/shop/acceptance/complaint-driven), test date, test location (field/lab), meter identifier, test standard applied (ANSI C12.20 accuracy class for North American deployments; IEC 62052-11/62053-series for international compliance), test result (pass/fail/adjusted), percentage error at full load and light load, power factor test result, demand register accuracy, as-found and as-left accuracy readings, technician identifier, and corrective action taken (adjusted/replaced/condemned). Supports regulatory accuracy compliance reporting to PUCs (state commissions) and drives meter replacement decisions. Sourced from Oracle WAM / IBM Maximo meter test records.' .

ind:DailyUsageSummary rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Metering ;
    rdfs:label 'Daily Usage Summary' ;
    rdfs:comment 'Derived daily-level consumption summary aggregated from validated interval reads for each meter, providing a billing-ready and analytics-ready daily kWh, MCF, or Therm total per meter per day. This is a computed/derived entity — not a source-of-truth transactional record — generated by the MDMS daily aggregation process. Captures meter identifier, summary date, total consumption value, unit of measure, peak demand kW (for demand-metered accounts), on-peak/off-peak/super-off-peak consumption buckets (for TOU meters), data completeness percentage (ratio of valid intervals to expected intervals), and summary generation timestamp. Serves as the primary feed to the billing domain for monthly bill calculation and to the demand response domain for baseline computation. Sourced from Oracle Utilities MDMS daily aggregation process.' .

ind:MeterConfiguration rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Metering ;
    rdfs:label 'Meter Configuration' ;
    rdfs:comment 'Master record capturing the active and historical programmed configurations of a meter as deployed in the field — distinct from the physical meter asset record and versioned over time as configurations change. Stores meter identifier, configuration effective date, configuration end date, number of channels, multiplier (CT/PT ratio), demand interval length (minutes), demand reset day, TOU schedule programmed into the meter, loss compensation factor, transformer-loss-corrected flag, net metering export channel flag, and configuration version. Note: individual channel definitions (type, UOM, direction, multiplier per channel) are owned by the meter_channel entity — this entity captures the meter-level configuration envelope and versioning. Each configuration change (e.g., adding NEM export channel, changing TOU schedule) creates a new version. Critical for ensuring MDMS reads are correctly scaled and interpreted for billing — the active configuration at the time of a read determines how raw pulse counts translate to engineering units. Managed within Oracle Utilities MDMS / Itron Analytics device configuration module.' .

ind:Master rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Asset ;
    rdfs:label 'Master' ;
    rdfs:comment 'Enterprise SSOT for all physical utility assets across generation, transmission, distribution, and gas infrastructure. Captures the full asset master record including asset class (generation unit, transmission line, distribution transformer, gas main, meter), asset type, manufacturer, model, serial number, installation date, in-service date, retirement date, asset status (active, retired, decommissioned), rated capacity (MW, kV, MCF), and FERC/NARUC account code. Includes full geospatial and network location attributes: GIS feature class, GIS object ID, latitude, longitude, elevation, address, municipality, county, state, utility service territory, electric circuit/feeder ID, substation name, voltage level (kV), gas pressure zone, pipeline segment ID, land parcel reference, easement reference, and location accuracy class (GPS-surveyed, as-built, estimated). Also captures regulatory asset base inclusion flag, depreciation method, useful life, and salvage value. Integrates with Oracle WAM / IBM Maximo as the EAM system of record and ESRI ArcGIS as the authoritative spatial record. Serves as the anchor entity for all maintenance, inspection, failure, condition, warranty, and capital project records in the asset domain.' .

ind:Hierarchy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Asset ;
    rdfs:label 'Hierarchy' ;
    rdfs:comment 'Defines the parent-child structural hierarchy of utility assets — from functional location (plant, substation, feeder) down to individual component (circuit breaker, transformer winding, valve assembly). Captures hierarchy level, hierarchy type (functional location, asset assembly, network segment, linear reference), parent asset reference, child asset reference, position/slot within parent, sort order, and effective/expiration dates for temporal hierarchy changes. Supports drill-down from bulk electric system (BES) transmission topology to individual field devices, and from gas transmission pipeline systems to individual valve stations. Used by EAM (Oracle WAM / Maximo) for work order scoping and cost roll-up, by GIS (ESRI ArcGIS) for network connectivity modeling, and by outage management systems for upstream/downstream asset identification during fault isolation.' .

ind:WorkOrder rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Asset ;
    rdfs:label 'Work Order' ;
    rdfs:comment 'Core transactional record for all preventive maintenance (PM), corrective maintenance (CM), and emergency work performed on utility assets. Captures work order number, work order type (PM, CM, emergency, inspection, capital), priority, originating asset, work description, craft/trade required, estimated and actual labor hours, estimated and actual material cost, estimated and actual total cost (OPEX vs CAPEX classification), work order status (created, planned, scheduled, in-progress, completed, closed), scheduled start/finish dates, actual start/finish dates, crew assignment, outage required flag, outage duration, safety permit references, and completion notes. Sourced from Oracle WAM / IBM Maximo WMS. Feeds regulatory O&M cost reporting and rate case OPEX/CAPEX substantiation.' .

ind:PmSchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Asset ;
    rdfs:label 'Pm Schedule' ;
    rdfs:comment 'Preventive maintenance schedule master defining the recurring maintenance plans applied to asset classes and individual assets. Captures PM plan name, associated asset class or specific asset, maintenance task description, frequency type (calendar-based, meter-based, condition-based), frequency interval (e.g., 90 days, 10,000 operating hours), last performed date, next due date, estimated duration, required craft, required materials, regulatory compliance driver (NERC FAC, PHMSA pipeline integrity, OSHA), and schedule status (active, suspended, retired). Integrates with Oracle WAM / Maximo PM module to auto-generate work orders on schedule trigger. Supports NERC reliability standard compliance and PHMSA pipeline safety program documentation.' .

ind:InspectionRecord rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Asset ;
    rdfs:label 'Inspection Record' ;
    rdfs:comment 'Captures individual point-in-time field inspection events performed on utility assets including routine patrol inspections, regulatory compliance inspections, and targeted diagnostic assessments. Distinct from asset_condition in that inspection_record is the raw event record of a specific inspection occurrence, while asset_condition represents the derived, aggregated health state over time. Records inspection date, inspector ID, asset inspected, inspection type (aerial patrol, ground patrol, thermographic, ultrasonic, pipeline integrity, transformer oil analysis), inspection findings (pass/fail/conditional), deficiency severity rating, deficiencies identified, recommended corrective actions, follow-up work order reference, regulatory inspection program reference (NERC FAC-003, PHMSA 49 CFR 192, PUC General Order 165), and next inspection due date. Supports NERC transmission inspection compliance, PHMSA pipeline integrity management program (IMP), and PUC-mandated distribution inspection programs.' .

ind:FailureEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Asset ;
    rdfs:label 'Failure Event' ;
    rdfs:comment 'Records asset failure events including equipment failures, forced outages, and unplanned interruptions. Captures failure date/time, failed asset, failure mode (insulation breakdown, mechanical failure, corrosion, overload, lightning strike, third-party damage), failure cause category, failure severity (minor, major, catastrophic), associated outage event reference, customers affected count, outage duration (minutes), SAIDI/SAIFI contribution, corrective work order reference, root cause analysis (RCA) findings, failure cost (repair + consequential), and whether failure triggered a regulatory reportable event (NERC, PUC). Feeds reliability indices (SAIDI, SAIFI, CAIDI) and supports asset health scoring and replacement prioritization.' .

ind:Condition rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Asset ;
    rdfs:label 'Condition' ;
    rdfs:comment 'Stores the current and historical condition assessments of utility assets, providing a longitudinal health record used for asset replacement prioritization and risk-based maintenance planning. Distinct from inspection_record in that asset_condition represents the derived, aggregated health state of an asset (potentially synthesized from multiple inspections, diagnostic tests, and operational data), while inspection_record captures individual point-in-time field inspection events. Captures assessment date, asset reference, condition assessment method (visual inspection, diagnostic testing, oil analysis, thermography, LiDAR scan), overall condition score (1-5 or health index), individual condition attribute scores (insulation condition, mechanical condition, corrosion level, loading history), remaining useful life estimate, replacement urgency rating (immediate, 1-3 years, 3-7 years, 7+ years), assessed by (inspector/contractor), source inspection reference(s), and next assessment due date. Feeds asset investment planning (AIP) models and supports PUC rate case justification for capital replacement programs.' .

ind:WorkOrderMaterial rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Asset ;
    rdfs:label 'Work Order Material' ;
    rdfs:comment 'Line-item transactional record of materials, spare parts, and consumables consumed, reserved, or returned against a maintenance or capital work order. This is a high-volume transactional entity with its own lifecycle (requested → issued → consumed/returned → costed) independent of the parent work order. Captures work order reference, material/part number (cross-referenced to storeroom catalog), material description, storeroom location, quantity requested, quantity issued, quantity returned, unit of measure, unit cost, total material cost, issue date, return date, material source (storeroom issue, direct purchase, contractor-supplied), and lot/serial number for traceable components (e.g., transformer bushings, SF6 gas cylinders). Supports O&M material cost tracking per work order, storeroom inventory consumption reporting, critical spare depletion alerts, and OPEX cost substantiation for regulatory filings. Integrates with SAP MM Materials Management or Oracle ERP Supply Chain for inventory depletion and reorder point triggers.' .

ind:Plant rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Generation ;
    rdfs:label 'Plant' ;
    rdfs:comment 'Master record for each power generation facility operated by the utility — fossil fuel (CT, CC, coal), nuclear, and renewable (solar, wind, hydro). Captures plant name, NERC plant code, fuel type, technology type (combined cycle, combustion turbine, steam, photovoltaic, wind turbine, hydro), ISO/RTO interconnection region, nameplate capacity (MW), commercial operation date, retirement date, FERC plant ID, state/county location, GIS coordinates, regulatory jurisdiction (PUC, FERC), plant status (operating, mothballed, retired, under construction), and ownership percentage. Serves as the SSOT for generation facility master data and the anchor entity for all generation domain products. Sourced from ABB/GE Energy Management System and SAP S/4HANA asset registry.' .

ind:GeneratingUnit rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Generation ;
    rdfs:label 'Generating Unit' ;
    rdfs:comment 'Individual generating unit (boiler-turbine set, nuclear reactor unit, wind turbine, solar inverter block, hydro unit) within a plant. Tracks unit name, unit type, prime mover code (ST, GT, IC, HY, PV, WT per EIA-860), fuel primary/secondary, installed capacity (MW), net summer capacity (MW), net winter capacity (MW), heat rate (BTU/kWh), minimum stable load (MW), ramp rate (MW/min), unit status (available, forced outage, planned outage, derated, retired), synchronization date, and NERC unit ID. Enables unit-level dispatch, heat rate optimization, and capacity reporting. Sourced from ABB/GE EMS and NERC GADS submissions.' .

ind:DispatchSchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Generation ;
    rdfs:label 'Dispatch Schedule' ;
    rdfs:comment 'Day-ahead and real-time generation dispatch schedule for each generating unit, produced by the ABB/GE Energy Management System (EMS) in coordination with the RTO/ISO. Records schedule date, operating hour, scheduled MW output, economic dispatch MW, must-run flag, dispatch type (economic, reliability, emergency), fuel burn forecast (MMBTU), associated LMP node, RTO/ISO control area, and schedule version. Supports unit commitment optimization, fuel procurement planning, and RTO settlement reconciliation. Distinct from unit_output which captures actual generation — this product captures the planned/scheduled generation that drives commitment decisions. Sourced from ABB/GE EMS dispatch engine.' .

ind:UnitOutput rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Generation ;
    rdfs:label 'Unit Output' ;
    rdfs:comment 'Actual real-time and interval generation output telemetry for each generating unit, collected via OSIsoft PI / GE Proficy SCADA historian at sub-hourly intervals (typically 5-minute or 15-minute). Captures interval timestamp, gross generation (MWh), net generation (MWh), auxiliary load (MWh), reactive power (MVAR), frequency, voltage, capacity factor (%), heat rate actual (BTU/kWh), steam flow, and data quality flag. Serves as the SSOT for actual MWh production used in RTO settlement, RPS compliance, and plant performance benchmarking. Sourced from OSIsoft PI historian.' .

ind:GenerationOutageEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Generation ;
    rdfs:label 'Generation Outage Event' ;
    rdfs:comment 'Planned and forced outage records for generating units, aligned with NERC GADS (Generating Availability Data System) reporting requirements. Captures outage type (planned, forced, maintenance, extension, startup failure, shutdown), outage cause code (NERC GADS cause code), outage start timestamp, return-to-service timestamp, derated capacity (MW), equivalent forced outage rate (EFOR) contribution, responsible crew, outage notification to RTO/ISO, and regulatory reporting flag. Also covers unit startup and shutdown events that result in capacity unavailability. Supports NERC GADS submissions, generation reliability metrics (EFOR, EAF, capacity factor impact), and maintenance planning. Sourced from Oracle WAM / IBM Maximo work management and ABB/GE EMS.' .

ind:FuelInventory rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Generation ;
    rdfs:label 'Fuel Inventory' ;
    rdfs:comment 'Fuel stock inventory records for thermal and nuclear generation facilities — coal tonnage, natural gas in storage (MCF/BCF), nuclear fuel assemblies (uranium enrichment batches), oil (barrels), and biomass. Tracks fuel type, storage location (coal pile, tank farm, gas holder), quantity on hand, unit of measure, inventory date, minimum operating reserve level, maximum storage capacity, fuel quality parameters (BTU content, sulfur content, ash content, moisture content), days of burn remaining at current consumption rate, and supplier contract reference. Supports fuel procurement planning, FAC (Fuel Adjustment Clause) cost tracking, burn forecast modeling, and environmental compliance (GHG, SO2, NOx). Sourced from SAP S/4HANA materials management and plant fuel management systems.' .

ind:FuelConsumption rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Generation ;
    rdfs:label 'Fuel Consumption' ;
    rdfs:comment 'Actual fuel consumed per generating unit per operating period, used for heat rate calculation, FAC cost recovery, and EPA emissions reporting. Records consumption date, fuel type, quantity consumed (MMBTU, MCF, tons, barrels), heat content (BTU/unit), cost per unit, total fuel cost ($), associated generation output (MWh), calculated heat rate (BTU/kWh), and emissions factors applied (CO2, SO2, NOx, CH4 lbs/MMBTU). Supports EIA Form 923 monthly fuel consumption reporting, EPA CEMS reconciliation, and IRP fuel cost modeling. Sourced from plant DCS/SCADA and SAP S/4HANA.' .

ind:EmissionsRecord rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Generation ;
    rdfs:label 'Emissions Record' ;
    rdfs:comment 'Continuous emissions monitoring (CEMS) and calculated emissions data per generating unit per reporting period, required for EPA compliance under Clean Air Act Title IV and Title V. Captures pollutant type (CO2, SO2, NOx, Hg, PM2.5, CH4), measurement method (CEMS, fuel-factor, mass balance), hourly/daily/monthly emission quantity (tons), emission rate (lbs/MMBTU), allowance consumption, CEMS monitor status, data substitution flag, and EPA ECMPS submission status. Supports EPA ECMPS reporting, GHG inventory, RPS compliance, and carbon accounting. Sourced from plant CEMS and OSIsoft PI.' .

ind:CapacityResource rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Generation ;
    rdfs:label 'Capacity Resource' ;
    rdfs:comment 'Capacity resource registration and accreditation records for each generating unit participating in RTO/ISO capacity markets (e.g., PJM Capacity Performance, MISO Planning Resource Auction, SPP, CAISO RA). Captures resource ID, accredited capacity (MW), unforced capacity (UCAP), installed capacity (ICAP), capacity zone, performance obligation (MW), capacity market product type (base capacity, capacity performance, must-offer), accreditation period (planning year), RTO/ISO registration status, capacity auction clearing price ($/MW-day), non-performance charge rate, and bonus payment eligibility. Supports IRP capacity planning, RTO capacity market revenue tracking, capacity performance penalty/bonus accounting, and FERC Order 841 compliance. Sourced from ABB/GE EMS and RTO market portals.' .

ind:FuelContract rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Generation ;
    rdfs:label 'Fuel Contract' ;
    rdfs:comment 'Fuel supply contract master records for coal, natural gas, nuclear fuel, and oil procurement agreements with fuel suppliers. Captures supplier name, fuel type, contract type (firm, interruptible, spot), contracted volume (tons/MCF/MMBTU per period), delivery point (plant-specific), pricing mechanism (fixed, index, cost-plus), contract start/end date, minimum take obligation, force majeure provisions, fuel quality specifications (BTU content, sulfur limit, ash limit), transportation arrangement (pipeline, rail, barge), and contract status. This product is the generation domains SSOT for fuel procurement terms — distinct from the supply domains general vendor contracts, which cover non-fuel materials and services. Supports FAC fuel cost recovery filings, fuel procurement planning, burn forecast modeling, and supply chain risk management. Sourced from SAP S/4HANA contract management.' .

ind:Vendor rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Vendor' ;
    rdfs:comment 'Master record for all vendors, suppliers, and contractors engaged by the utility for procurement of materials, equipment, fuel, and services. Captures vendor identity, classification (material supplier, fuel supplier, T&D contractor, generation services, professional services, IT vendor), tax identifiers (EIN/TIN), remittance addresses, payment terms (Net 30/45/60), preferred currency, bank details for EFT, diversity classification (MBE/WBE/SBE/SDVOB), OSHA safety rating (EMR), insurance certificate status and expiration, bonding capacity, prequalification status, and SAP S/4HANA vendor master number (LFA1). Serves as the SSOT for vendor identity across procurement-to-pay workflows, contractor safety management, and supplier diversity reporting.' .

ind:MaterialMaster rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Material Master' ;
    rdfs:comment 'Enterprise catalog of all procurable materials, equipment, and spare parts used across generation, T&D, and gas infrastructure operations. Captures material number, description, material group, unit of measure, hazardous material classification, UNSPSC commodity code, lead time, reorder point, safety stock level, standard cost, and storage class. Aligned with SAP MM material master (MARA/MARC) and supports CAPEX project BOM management and storm restoration kitting. Distinct from the asset domain\'s physical asset records — this is the catalog definition, not the installed asset instance.' .

ind:PurchaseOrder rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Purchase Order' ;
    rdfs:comment 'Authoritative transactional record for all purchase orders issued to vendors for materials, equipment, fuel, and services. Captures PO number, PO type (standard, blanket, framework, service), vendor reference, plant/delivery location, requested delivery date, total PO value, currency, payment terms, incoterms, approval status, SAP S/4HANA document number, and associated cost object (WBS element for CAPEX, cost center for OPEX). Supports procurement-to-pay cycle from requisition through goods receipt and invoice verification.' .

ind:PoLineItem rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Po Line Item' ;
    rdfs:comment 'Individual line-item detail within a purchase order, representing a specific material, equipment item, or service quantity and price. Captures line number, material reference (linked to material_master for stock items), ordered quantity, unit of measure, unit price, net value, delivery schedule date, account assignment category (cost center for OPEX, WBS element for CAPEX, asset number for direct capitalization), goods receipt indicator, and service entry sheet flag for service POs. Enables granular tracking of multi-line POs for T&D equipment procurement, generation fuel orders, and O&M supply requisitions. Supports three-way match at line level and CAPEX/OPEX cost allocation.' .

ind:GoodsReceipt rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Goods Receipt' ;
    rdfs:comment 'Transactional record capturing the physical receipt of materials and equipment at a utility warehouse, storeroom, or project site against a purchase order. Records GR document number, posting date, PO reference, PO line item reference, delivery note number, vendor packing slip reference, received quantity, unit of measure, receiving storage location (linked to warehouse), movement type (101 standard receipt to unrestricted stock, 103 GR to blocked/quality inspection stock, 105 release from quality inspection), quality inspection required flag, inspection outcome (accepted, rejected, partially accepted), batch/lot number for traceable materials, and receiving plant. Triggers inventory stock position update and initiates the three-way match process (PO–GR–invoice) in SAP S/4HANA. Critical for CAPEX project material tracking, storm restoration supply chain verification, and inventory valuation posting.' .

ind:ProcurementContract rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Procurement Contract' ;
    rdfs:comment 'Master record for long-term supply agreements, blanket purchase agreements, fuel supply contracts, and framework contracts with vendors. Captures contract number, contract type (quantity contract, value contract, fuel PPA, service agreement), validity period, total contract value, minimum/maximum quantity commitments, price escalation clauses, fuel index linkage (e.g., Henry Hub for gas), renewal terms, and SAP outline agreement document number. Distinct from regulatory contracts (owned by regulatory domain) and customer service agreements (owned by customer domain).' .

ind:InventoryStock rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Inventory Stock' ;
    rdfs:comment 'Real-time and period-end inventory stock position for materials held at utility warehouses, field storerooms, and generation plant stores. Tracks material reference (linked to material_master), storage location (linked to warehouse), unrestricted stock quantity, quality inspection stock, blocked stock, in-transit stock, reserved quantity (backed by material_reservation transactions), issued quantity (backed by goods_issue transactions), consignment stock, reorder point breach flag, safety stock breach flag, last physical inventory count date, and inventory valuation amount at standard or moving average cost. Supports O&M spare parts availability, storm restoration pre-positioning, CAPEX project material staging, and year-end physical inventory reconciliation. Sourced from SAP S/4HANA MM inventory management (MARD/MSKU/MBEW). Stock position is updated by goods_receipt (increase), goods_issue (decrease), stock_transfer (rebalance), and material_reservation (commitment).' .

ind:Warehouse rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Warehouse' ;
    rdfs:comment 'Master record for all utility warehouse facilities, field storerooms, and generation plant stores used for material storage and distribution. Captures warehouse number, warehouse name, facility type (central warehouse, field storeroom, generation plant store, mobile storm unit), physical address, GIS coordinates, storage capacity (sq ft, pallet positions), climate control capability, hazmat storage certification, responsible plant code, and operational status. Supports logistics planning for T&D equipment staging and storm restoration pre-positioning.' .

ind:StockTransfer rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Stock Transfer' ;
    rdfs:comment 'Transactional record for inter-plant and inter-warehouse material movements within the utility\'s supply network. Covers transfers between central warehouse and field storerooms, storm restoration emergency stock pre-positioning and deployment, generation plant consumable replenishment, and mutual aid material loans to/from neighboring utilities during major events. Captures transfer order number, sending warehouse (FK to warehouse), receiving warehouse (FK to warehouse), material reference (FK to material_master), transfer quantity, unit of measure, movement type (301 plant-to-plant transfer, 311 storage-location-to-storage-location transfer, 303 plant-to-plant in two steps), transport mode (company truck, common carrier, emergency helicopter), carrier name, requested transfer date, actual shipment date, actual receipt date, completion status (open, in-transit, received, cancelled), and mutual aid tracking reference for inter-utility loans. Enables real-time visibility into material logistics across the utility service territory and supports FEMA reimbursement documentation for storm restoration material movements.' .

ind:PurchaseRequisition rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Purchase Requisition' ;
    rdfs:comment 'Internal request document initiating the procurement process for materials, equipment, or services before a purchase order is issued. Captures requisition number, requisition type (standard material, service, fuel, emergency/storm), requested material reference (linked to material_master for cataloged items) or free-text description for non-catalog items, quantity, unit of measure, required delivery date, estimated unit price and total value, requesting cost center (OPEX) or WBS element (CAPEX), approval workflow status (created, pending approval, approved, rejected, converted to PO), assigned buyer/purchasing group, priority indicator (normal, urgent, emergency), and conversion-to-PO reference. Supports the procure-to-pay process from demand identification through PO creation in SAP S/4HANA. Originated by field operations, maintenance planners, project managers, and generation plant staff.' .

ind:VendorInvoice rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Vendor Invoice' ;
    rdfs:comment 'Transactional record for vendor invoices received for materials, equipment, fuel, and services procured by the utility. Captures invoice number, vendor reference, invoice date, posting date, gross invoice amount, tax amount, currency, payment due date, three-way match status (PO–GR–invoice), payment block reason, and SAP FI document number. Drives accounts payable processing and supports CAPEX/OPEX cost allocation. Distinct from customer-facing invoices owned by the billing domain.' .

ind:FuelDelivery rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Fuel Delivery' ;
    rdfs:comment 'Transactional record capturing physical delivery of generation fuel (natural gas, coal, oil, nuclear fuel) to generation plant sites. Records delivery ticket number, fuel type, delivery date and time, delivered quantity (MCF for gas, tons for coal, barrels for oil), unit of measure, BTU content or heat rate, delivery point (plant and tank/pipeline tie-in), carrier/transporter, contract reference, and quality certificate number. Supports fuel inventory management, heat rate calculations, and FAC (Fuel Adjustment Clause) regulatory reporting.' .

ind:VendorPerformance rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Vendor Performance' ;
    rdfs:comment 'Periodic evaluation record tracking vendor and contractor performance against delivery, quality, safety, and compliance KPIs over a defined assessment period. Captures evaluation period (quarterly, annual, or per-project), vendor reference, evaluating buyer or contract manager, on-time delivery rate, material rejection rate, invoice accuracy rate, OSHA recordable incident rate and Experience Modification Rate (EMR) for contractor field crews, safety compliance score, environmental compliance incidents, diversity spend percentage, overall weighted performance rating (1-5 scale with configurable weighting: 30% delivery, 25% quality, 25% safety, 10% invoice accuracy, 10% diversity), corrective action plan status, and preferred vendor list eligibility flag. Supports vendor qualification decisions, contract renewal negotiations, bid evaluation scoring, and supplier diversity program reporting. Evaluated quarterly for strategic suppliers and per-project for major T&D construction and generation outage contractors. Distinct from vendor master (which captures static identity and classification) — this product captures time-series performance measurement.' .

ind:Party rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Customer ;
    rdfs:label 'Party' ;
    rdfs:comment 'Master record for any legal entity (person or organization) that interacts with the utility as a customer, co-applicant, or authorized representative. Serves as the enterprise SSOT for customer identity — stores legal name, tax ID / SSN (masked), date of birth, entity type (residential individual, commercial business, industrial corporation, government), language preference, credit class, and identity verification status. Sourced from Oracle CC&B / SAP IS-U customer master and Salesforce Energy & Utilities Cloud Account object. Supports PUC customer-of-record requirements and SOX identity controls.' .

ind:Account rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Customer ;
    rdfs:label 'Account' ;
    rdfs:comment 'Utility service account representing the contractual relationship between a party and the utility for receiving and paying for energy services. Tracks account number (CC&B / SAP IS-U account ID), account type (residential, small commercial, large commercial, industrial, street lighting, unmetered), account status (active, inactive, pending, final, closed, written-off), credit rating, life-support/medical baseline flag, budget billing enrollment flag, paperless billing flag, auto-pay enrollment, account open date, close date, and final bill date. One party may hold multiple accounts; one account may have multiple service agreements. SSOT for account-level identity, billing eligibility, and collections status. Deposit tracking is managed by the credit_deposit product. Integrates with Oracle CC&B and Salesforce E&U Cloud Account object.' .

ind:Premise rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Customer ;
    rdfs:label 'Premise' ;
    rdfs:comment 'Physical service location (premise) where energy is delivered — the geographic and infrastructure anchor for all utility services. Stores premise address (street, city, state, ZIP), GIS coordinates (latitude/longitude from ESRI ArcGIS), premise type (residential, commercial, industrial, multi-family unit), electric service territory, gas service territory, distribution feeder ID, transformer bank ID, gas main segment ID, premise classification (single-family, multi-family, MDU unit), and premise status (serviceable, non-serviceable, demolished). SSOT for service location identity shared across metering, distribution, and billing domains.' .

ind:CustomerServiceAgreement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Customer ;
    rdfs:label 'Customer Service Agreement' ;
    rdfs:comment 'Active service agreement (SA) linking an account to a premise for a specific commodity and rate schedule — the utility\'s contractual obligation to deliver electric or gas service. Captures commodity type (electric, gas), rate schedule code (e.g., RS-1, GS-2, TOU-D, CPP), SA start and end dates, SA status (active, pending start, pending stop, stopped), NEM enrollment flag, demand response program enrollment, and applicable tariff version. Sourced from Oracle CC&B Service Agreement / SAP IS-U Contract. Core entity linking customer, metering, and billing domains.' .

ind:Contact rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Customer ;
    rdfs:label 'Contact' ;
    rdfs:comment 'Contact record for individuals associated with a party or account — including primary account holders, co-applicants, authorized third parties, landlords, and property managers. Stores contact name, relationship type (self, spouse, property manager, third-party authorized, emergency contact), preferred contact method (phone, email, SMS, mail), phone numbers, email address, mailing address (if different from premise), and do-not-contact flags. Distinct from party (which owns legal identity) — contact owns reachability and relationship context for a person in a specific role on an account. Sourced from Salesforce E&U Cloud Contact object and CC&B Person entity. Supports outage notification, collections contact, and regulatory communication requirements.' .

ind:Enrollment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Customer ;
    rdfs:label 'Enrollment' ;
    rdfs:comment 'Transactional record capturing a customer\'s enrollment or disenrollment in a utility program, tariff option, or demand-side management offering. Programs include demand response (DR) curtailment programs, energy efficiency (EE) rebate programs, budget billing plan, paperless billing, auto-pay, NEM/solar interconnection, EV charging rate programs, medical baseline allowance, CARE/FERA low-income assistance, green pricing programs, and DSM programs. Tracks program code, enrollment status (pending, active, suspended, cancelled, waitlisted), enrollment date, effective date, expiration date, opt-out date, enrollment channel (web, IVR, agent, field), and eligibility verification status. SSOT for all program participation — preference product handles communication channel choices only. Supports DSM program tracking, CARE/FERA income verification workflows, and PUC regulatory reporting on program participation rates.' .

ind:MoveOrder rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Customer ;
    rdfs:label 'Move Order' ;
    rdfs:comment 'Transactional record representing a customer move-in, move-out, or transfer-of-service request — the primary workflow event driving account lifecycle transitions. Captures move type (move-in, move-out, transfer, name change), requested and actual effective dates, move order status (pending, scheduled, in-progress, completed, cancelled, rejected), stop reason code (moved, deceased, foreclosure, non-pay disconnect, demolition), associated premise IDs (current and new for transfers), final read indicator, overlapping service check result, and processing channel (web self-service, call center, field, third-party notification). Drives meter read scheduling, final bill generation, deposit lifecycle events, and premise occupancy status updates. Sourced from CC&B Start/Stop workflow and SAP IS-U move-in/move-out transactions.' .

ind:Interaction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Customer ;
    rdfs:label 'Interaction' ;
    rdfs:comment 'Record of a customer interaction or engagement event with the utility — including inbound calls, web portal sessions, chat sessions, field visits, outage notifications, and written correspondence. Captures interaction channel (phone, web, mobile app, IVR, email, chat, in-person), interaction type (billing inquiry, outage report, service request, complaint, payment arrangement, general inquiry), interaction date/time, agent ID, case reference, resolution status, and interaction duration. Sourced from Salesforce Energy & Utilities Cloud Case and Activity objects. Supports customer experience analytics, regulatory complaint tracking, and PUC customer service reporting.' .

ind:Segment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Customer ;
    rdfs:label 'Segment' ;
    rdfs:comment 'Customer segmentation classification record assigning a party or account to one or more business-defined segments for targeting, rate design analysis, and program eligibility determination. Segment dimensions include rate class (residential, small commercial, large commercial, industrial), load profile group, income tier (CARE-eligible, FERA-eligible, standard), customer value tier, DER adoption flags (solar, battery storage, EV), demand response eligibility tier, AMI smart meter deployment cohort, and life-support/medical baseline flag. Segment assignments are versioned with effective and expiration dates to support historical trend analysis and regulatory rate case testimony. Used by regulatory affairs for rate case cost-of-service studies, by DSM teams for program targeting, and by load forecasting for IRP class-level projections.' .

ind:AccountHierarchy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Customer ;
    rdfs:label 'Account Hierarchy' ;
    rdfs:comment 'Hierarchical relationship structure linking parent and child accounts for commercial and industrial customers with complex organizational structures — including multi-site enterprises, property management companies, municipal accounts, and master-metered MDU (multi-dwelling unit) complexes. Stores parent account ID, child account ID, hierarchy type (consolidated billing, master-metered, corporate umbrella), hierarchy level, effective date, and end date. Enables consolidated billing statements, enterprise-level usage reporting, and key account management workflows in Salesforce Energy & Utilities Cloud. Supports large commercial and industrial (C&I) account management and PUC reporting on large customer classes.' .

ind:Preference rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Customer ;
    rdfs:label 'Preference' ;
    rdfs:comment 'Customer communication and service preference record capturing opt-in/opt-out settings and notification channel choices at the party or account level. Stores preference category (outage alert, demand response event notification, planned outage notification, billing statement ready, payment confirmation, payment reminder, marketing communication), preferred delivery channel (email, SMS, push notification, mail, IVR), preferred language, preferred contact time window, and preference effective/expiration dates. Does NOT track program enrollments (see enrollment product) or legally binding consents (see consent product). Sourced from Salesforce Energy & Utilities Cloud and CC&B notification preferences. Supports TCPA compliance for automated contact channel selection and CAN-SPAM opt-out requirements.' .

ind:RateSchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Rate Schedule' ;
    rdfs:comment 'Authoritative master catalog of all tariff rate schedules applicable to electric and gas service — TOU, CPP, tiered residential, commercial demand, and special contract rates. Defines rate code, commodity type (electric/gas), customer class (residential/commercial/industrial), effective and expiration dates, regulatory approval reference, rate structure type, and base rate values per tier/period. References applicable rider_charge records for surcharges layered on top of base rates. Sourced from PUC-approved tariff filings and maintained in Oracle CC&B / SAP IS-U rate engine. SSOT for all base rate definitions used in charge calculation. Distinct from rider_charge, which defines regulatory surcharges approved separately from base tariff rates.' .

ind:Invoice rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Invoice' ;
    rdfs:comment 'Core billing document representing a single billing cycle statement issued to a customer account for electric and/or gas service. Captures bill period start/end dates, due date, total amount due, prior balance, current charges, taxes, regulatory riders, and net amount. Tracks invoice status (generated, mailed, paid, disputed, written-off). Links to the rate schedule applied, service agreement, and meter read period. Generated from Oracle CC&B / SAP IS-U billing engine and posted to SAP S/4HANA or Oracle ERP for GAAP revenue recognition. SSOT for all customer billing documents.' .

ind:InvoiceLine rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Invoice Line' ;
    rdfs:comment 'Itemized charge line within a customer invoice representing a single billable component — energy consumption charges (kWh, MCF, Therm), demand charges (kW), fixed customer charges, distribution rider, FAC adjustment, CIAC recovery, RPS surcharge, taxes, or credits. Captures charge type code, unit of measure, quantity, unit rate, extended amount, and applicable rate schedule tier or TOU period. Enables granular revenue decomposition by charge category for regulatory reporting and customer dispute resolution. Sourced from Oracle CC&B / SAP IS-U charge calculation engine.' .

ind:Payment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Payment' ;
    rdfs:comment 'Record of a financial payment transaction applied against a customer account balance — check, ACH/EFT, credit card, cash, auto-pay, budget billing installment, or third-party agency payment. Captures payment date, amount, payment method type, tender type, confirmation number, processing status (received, posted, returned/NSF, reversed), and source channel (web portal, IVR, walk-in, lockbox). Integrates with SAP S/4HANA or Oracle ERP for cash receipts posting and GAAP revenue recognition. SSOT for all customer payment transactions.' .

ind:PaymentArrangement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Payment Arrangement' ;
    rdfs:comment 'Formal deferred payment plan or installment agreement established for a customer account with past-due balance — budget billing plan, levelized payment plan, low-income assistance plan, or collections payment arrangement. Captures arrangement type, total deferred amount, number of installments, installment amount, start date, end date, down payment amount, arrangement status (active, broken, completed, cancelled), and associated collections action. Tracks compliance with arrangement terms to support collections workflow in Oracle CC&B / SAP IS-U. Distinct from a single payment transaction — represents an ongoing multi-period commitment.' .

ind:CollectionsCase rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Collections Case' ;
    rdfs:comment 'Operational record tracking the full collections lifecycle for a delinquent customer account — from initial past-due notice through final write-off or debt recovery. Captures collections stage (dunning notice, disconnect warning, field disconnect order, collections agency referral, write-off, bankruptcy), days past due, past-due amount, collections action dates, assigned collections agent or agency, and resolution outcome. Integrates with Oracle CC&B / SAP IS-U collections process and SAP S/4HANA for bad debt accounting. SSOT for all collections activity against customer accounts.' .

ind:BillDispute rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Bill Dispute' ;
    rdfs:comment 'Customer-initiated formal dispute or inquiry against a specific invoice or charge — billing error claim, rate misapplication complaint, estimated read dispute, or regulatory complaint escalation. Captures dispute type, disputed invoice reference, disputed amount, dispute open date, resolution date, resolution type (credit issued, bill upheld, rate correction, re-read ordered), assigned analyst, and PUC complaint flag. Tracks SLA compliance for dispute resolution per regulatory requirements. Managed within Oracle CC&B / SAP IS-U case management or Salesforce Energy & Utilities Cloud.' .

ind:CreditAdjustment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Credit Adjustment' ;
    rdfs:comment 'Financial adjustment record applied to a customer account post-billing to correct errors, issue service credits, apply regulatory refunds, or process write-offs. Includes rate correction credits, outage performance credits (SAIDI/SAIFI), low-income program discounts (LIHEAP, PIPP), returned payment fees, late payment charges, deposit interest credits, and bad debt write-offs. Captures adjustment type, amount (positive credit or negative debit), reason code, authorization level, approving user, effective date, GL posting status, and originating dispute or collections case reference. Distinct from a payment (no cash received) and from an invoice line (post-bill correction applied after invoice finalization). Sourced from Oracle CC&B / SAP IS-U adjustment processing.' .

ind:BillingServiceAgreement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Billing Service Agreement' ;
    rdfs:comment 'Active contractual service agreement between the utility and a customer for delivery of electric or gas service at a specific premise under a specific rate schedule — the billing contract that governs charge calculation. Captures commodity type (electric/gas), service point identifier, rate schedule code, contract start and end dates, customer class, demand contract level (kW for commercial/industrial), NEM enrollment flag, budget billing enrollment flag, and agreement status (active, pending, final, cancelled). The billing domain\'s view of the service agreement — the customer domain owns the customer identity; this entity owns the rate and billing terms. Sourced from Oracle CC&B / SAP IS-U service agreement.' .

ind:BillCycle rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Bill Cycle' ;
    rdfs:comment 'Master definition of billing cycle schedules governing when customer accounts are meter-read and billed — monthly, bi-monthly, quarterly, and special cycles for large C&I accounts. Captures cycle code, cycle description, scheduled meter read window (start day, end day), bill generation date offset from read completion, payment due date offset from bill date, estimated account count per cycle, cycle territory/route grouping, and active/inactive status. Drives batch scheduling of meter reads, bill calculation runs, and payment due date assignment across the billing engine. Referenced by service agreements to assign billing cadence and by invoices to record which cycle generated the bill. Sourced from Oracle CC&B / SAP IS-U billing cycle configuration.' .

ind:RiderCharge rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Regulatory ;
    rdfs:label 'Rider Charge' ;
    rdfs:comment 'Regulatory rider and surcharge master defining all PUC-approved cost-recovery mechanisms applied to customer bills as separate line items beyond base tariff rates — Fuel Adjustment Clause (FAC), Renewable Portfolio Standard (RPS) surcharge, CIAC recovery rider, infrastructure investment rider, low-income program rider, demand response program charge, and environmental compliance surcharge. Captures rider code, rider name, regulatory approval order reference, applicable customer classes, charge basis (per kWh, per MCF, per Therm, per kW, fixed monthly), effective date, expiration date, and current rate value. Each rider has its own regulatory approval lifecycle independent of base rate schedule changes. Sourced from PUC-approved tariff riders and maintained in Oracle CC&B / SAP IS-U rate engine. SSOT for all regulatory surcharges — distinct from rate_schedule, which owns base tariff rate definitions.' .

ind:MaterialReservation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Material Reservation' ;
    rdfs:comment 'Transactional record reserving specific materials from inventory stock against a planned work order, CAPEX project WBS element, or maintenance activity. Captures reservation number, material number, required quantity, reserved quantity, movement type (261 goods issue for order), requesting cost center or WBS element, requirement date, reservation status (open, partially issued, fully issued, cancelled), issuing storage location, and SAP reservation document number. Ensures material availability planning for planned maintenance outages, T&D construction projects, and storm restoration pre-staging. Drives the reserved quantity in inventory_stock and prevents over-commitment of critical spare parts.' .

ind:MeterChannel rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Metering ;
    rdfs:label 'Meter Channel' ;
    rdfs:comment 'Master record defining each measurement channel configured on a meter — the fundamental unit of metered data collection. Each channel represents a distinct quantity being measured (e.g., delivered kWh, received kWh, reactive kVAR, demand kW, gas MCF). Captures meter identifier, channel number, channel type (energy/demand/reactive/power-factor/voltage/current), direction (delivered/received/net), unit of measure (kWh/kW/kVAR/MCF/Therm), multiplier (CT/PT ratio applied to this channel), demand interval length (for demand channels), pulse weight, register multiplier, cumulative vs interval collection mode, TOU applicability flag, and active status. Serves as the master reference for interval_read and register_read records, ensuring each read can be traced to a defined measurement channel with known UOM and scaling. Essential for net energy metering (NEM) where delivered and received channels must be tracked separately. Managed within Oracle Utilities MDMS / Itron Analytics device configuration.' .

ind:SettlementLineItem rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Market ;
    rdfs:label 'Settlement Line Item' ;
    rdfs:comment 'Transactional detail record for individual charge and credit line items within an RTO/ISO wholesale market settlement statement. Captures charge type (energy, capacity, ancillary service, uplift, OATT, revenue sufficiency guarantee, make-whole payment), charge code, billing determinant (MW, MWh), rate ($/MWh or $/MW-day), line amount ($), pricing node, settlement interval, market product, and GL account mapping. Each line item references its parent settlement statement. Essential for shadow settlement verification, dispute resolution, FERC Form 1 Schedule 2 reporting, and granular GL posting of wholesale market costs and revenues.' .

ind:Pole rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Pole' ;
    rdfs:comment 'Master record for distribution poles and structures — wood, steel, concrete, or composite vertical structures that support overhead electric distribution conductors, transformers, switches, and communication attachments. Captures pole ID, material type (wood/steel/concrete/composite), height (feet), class rating, installation year, GPS coordinates, GIS structure number, feeder association, joint-use attachment count, pole loading percentage, inspection date, inspection result (pass/fail/remediate), treatment type (CCA/penta), ground-line condition, ownership type (utility-owned/joint-use/third-party), FCC pole attachment compliance status, and operational status. Critical for pole loading analysis, joint-use attachment management, storm damage assessment, and vegetation management targeting. Sourced from ESRI ArcGIS and Oracle WAM/IBM Maximo.' .

ind:GasServiceLateral rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Gas Service Lateral' ;
    rdfs:comment 'Master record for gas service laterals — the pipeline segments connecting gas distribution mains to individual customer meters at the service point. Captures lateral ID, associated gas main reference, service point reference, pipe material (steel/PE/copper), nominal diameter (inches), operating pressure (PSIG), installation year, length (feet), excess flow valve (EFV) presence, cathodic protection status, GPS route geometry, PHMSA class location, last leak survey date, and operational status. Distinct from gas mains — laterals are individually regulated assets under PHMSA 49 CFR Part 192 with their own inspection, leak survey, and replacement schedules. SSOT for gas service lateral integrity management and PHMSA compliance. Sourced from ESRI ArcGIS.' .

ind:ComplianceCalendar rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Regulatory ;
    rdfs:label 'Compliance Calendar' ;
    rdfs:comment 'Master record for each regulatory deadline, milestone, or scheduled event the utility must track across all jurisdictions and regulatory bodies. Captures deadline type (filing due date, compliance evidence submission, rate case milestone, IRP update cycle, annual report due date, NERC audit window, EPA reporting deadline, PHMSA inspection window), associated docket or compliance obligation reference, jurisdiction, regulatory body, responsible internal party, original due date, extended due date (if granted), completion status, days-to-deadline alert threshold, and escalation contact. Links to docket for proceeding-related deadlines and to compliance_obligation for compliance-driven deadlines. Serves as the centralized deadline management registry that regulatory affairs teams use daily to ensure no filing or compliance deadline is missed — the operational heartbeat of the regulatory department.' .

ind:EnvironmentalPermit rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Generation ;
    rdfs:label 'Environmental Permit' ;
    rdfs:comment 'Master record for environmental permits and compliance authorizations held by each generation facility — Title V air operating permits, NPDES water discharge permits (including 316(b) cooling water intake structure requirements), state air quality construction permits, PSD (Prevention of Significant Deterioration) permits, and hazardous waste permits. Captures permit type, issuing agency (EPA, state DEQ), permit number, issuance date, expiration date, renewal date, permitted emission limits (tons/year by pollutant), permitted water discharge limits (temperature, flow, chemical concentrations), cooling water intake flow limits (316(b)), compliance status, permit conditions/stipulations, and associated generating units. Supports environmental compliance tracking, permit renewal management, and regulatory audit readiness. Distinct from emissions_record which captures actual measured emissions — this product captures the permitted limits and regulatory authorizations. Sourced from state DEQ permit databases and internal environmental compliance systems.' .

ind:TaxProvision rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Tax Provision' ;
    rdfs:comment 'Periodic record for income tax provisions, deferred income tax calculations, and Accumulated Deferred Income Taxes (ADIT) balances for the utility. Captures tax provision period, fiscal year, current federal tax expense, current state tax expense, deferred federal tax expense, deferred state tax expense, ADIT balance by timing difference category (accelerated depreciation, regulatory liabilities, pension obligations, storm cost deferrals, excess deferred income taxes — EDIT), federal vs. state tax jurisdiction, effective tax rate, statutory tax rate, permanent and temporary difference reconciliation items, and ITC (Investment Tax Credit) amortization. Supports FERC Form 1 Schedule 272 (Accumulated Deferred Income Taxes), rate base ADIT offset calculations per IRS normalization rules, GAAP ASC 740 income tax accounting, rate case test year tax expense normalization, and Tax Cuts and Jobs Act (TCJA) excess ADIT amortization tracking. Essential for regulatory accounting where ADIT directly reduces rate base.' .

ind:RegulatoryDeferral rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Regulatory Deferral' ;
    rdfs:comment 'Master record for regulatory assets and regulatory liabilities recognized under ASC 980 (Regulated Operations) that represent costs or revenues deferred for future rate recovery or refund. Captures deferral type (regulatory asset or regulatory liability), deferral category (storm cost, pension/OPEB, fuel adjustment clause under/over-recovery, environmental remediation, rate case expense, EDIT — Excess Deferred Income Taxes), authorized deferral amount, amortization method, amortization period, remaining unamortized balance, PUC/FERC authorization reference, and deferral status. Supports FERC Form 1 Schedules 232 (Regulatory Assets) and 254 (Regulatory Liabilities), rate case revenue requirement calculations, and GAAP balance sheet presentation under ASC 980.' .

ind:Warranty rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Asset ;
    rdfs:label 'Warranty' ;
    rdfs:comment 'Tracks manufacturer and contractor warranties and guarantees associated with utility assets and capital project installations. Captures warranty type (manufacturer equipment warranty, contractor workmanship warranty, extended service agreement, performance guarantee), warranted asset reference, warranty provider (manufacturer, contractor, third-party insurer), warranty start date, warranty expiration date, warranty terms and conditions summary, coverage scope (parts only, parts and labor, full replacement), maximum claim value, deductible amount, claims filed count, claims approved amount, claims denied amount, warranty status (active, expired, claimed, voided), and associated purchase order or capital project reference. Supports warranty cost recovery when assets fail within warranty period — reducing O&M and capital replacement costs charged to ratepayers. Integrates with work_order and failure_event records to trigger warranty claim workflows and with capital_project for installation warranty tracking.' .

ind:SwitchingOrder rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Switching Order' ;
    rdfs:comment 'Records switching orders (also called clearance orders or tagout orders) that authorize the opening/closing of breakers, disconnects, and switches on the BES to isolate or energize transmission elements. Captures order ID, requesting operator, authorizing operator, associated transmission element(s), switching sequence steps, clearance tag references, safety ground placement, planned start/end datetime, actual execution datetime, order status (draft/approved/in-progress/completed/cancelled), associated outage reference, and NERC IRO compliance flag. SSOT for all switching operations on the transmission system — the primary daily operational workflow for transmission dispatchers and field crews. Source system: ABB/GE EMS, Schneider/GE OMS.' .

ind:ProtectionSystem rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Protection System' ;
    rdfs:comment 'Master record for protective relay systems and protection schemes installed on BES transmission elements (lines, transformers, buses). Captures protection system ID, associated transmission element, relay type (distance/differential/overcurrent/pilot), relay manufacturer and model, CT/PT ratios, protection zone, trip settings, coordination study reference, firmware version, last calibration date, NERC PRC compliance status, and operational status. Required for NERC PRC (Protection and Control) standard compliance, fault analysis, and misoperation tracking. Source system: SEL/GE/ABB relay management systems, Oracle WAM/IBM Maximo.' .

ind:CreditDeposit rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Customer ;
    rdfs:label 'Credit Deposit' ;
    rdfs:comment 'Transactional record tracking the lifecycle of a customer security deposit — from initial assessment at move-in or credit evaluation through refund or application to final bill. Captures deposit amount, type, status, and associated consent/authorization records.' .

ind:GoodsIssue rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Supply ;
    rdfs:label 'Goods Issue' ;
    rdfs:comment 'Transactional record capturing the physical issuance and consumption of materials from inventory stock against a work order, CAPEX project, cost center, or material reservation. Records goods issue document number, posting date, material reference (linked to material_master), issuing storage location (linked to warehouse), reservation reference (linked to material_reservation), receiving cost object (work order, WBS element, cost center, or asset number), issued quantity, unit of measure, movement type (261 goods issue for order, 262 reversal of goods issue, 201 goods issue for cost center, 281 goods issue for network/project), batch/lot number for traceable materials, issuing warehouse clerk, and SAP material document number. Triggers inventory stock position reduction and drives actual material cost posting to work orders and CAPEX projects. Critical for closing the inventory movement lifecycle (goods_receipt IN → material_reservation COMMIT → goods_issue OUT), supporting three-way match completion, work order costing, storm restoration material consumption tracking, and FERC/PUC cost reporting for rate case filings.' .

ind:RegulatoryAssetEntry rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Regulatory Asset Entry' ;
    rdfs:comment 'Tracks regulatory assets and liabilities in the regulatory asset base (RAB) as reported to PUCs and FERC for rate case proceedings, capturing asset-in-service values, CWIP, and accumulated depreciation by FERC account.' .

ind:Location rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Asset ;
    rdfs:label 'Location' ;
    rdfs:comment 'Master record for the physical or functional location where utility assets are installed — substations, plants, poles, vaults, manholes, and right-of-way segments. Provides the spatial anchor for asset hierarchy and work order dispatching, linking assets to GIS coordinates and jurisdictional boundaries.' .

ind:DerDispatch rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Der Dispatch' ;
    rdfs:comment 'This association product represents the operational dispatch of Distributed Energy Resources (DER) in response to demand response events. It captures the participation of individual DER interconnections in specific DR events, including dispatch instructions, actual response performance, compliance measurement, and incentive settlement. Each record links one DER interconnection to one demand response event with attributes that exist only in the context of this dispatch relationship — response capacity committed, actual load reduction delivered, baseline calculation, compliance status, and financial settlement. This is the SSOT for DERMS dispatch operations and DR program settlement.. Existence Justification: In utility DERMS operations, a single DER interconnection (rooftop solar, battery storage, EV charger) participates in multiple demand response events over time — each summer peak event, grid emergency, or price-responsive curtailment dispatches the same DER asset. Conversely, a single demand response event dispatches hundreds or thousands of DER assets simultaneously across a feeder or zone. The business actively manages each dispatch as an operational transaction with performance measurement, compliance tracking, and financial settlement.' .

ind:ServicePointDrParticipation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Service Point Dr Participation' ;
    rdfs:comment 'This association product represents the operational participation record between a service point and a demand response event. It captures the enrollment status, notification delivery, customer response behavior, load curtailment performance, and incentive settlement for each service point\'s participation in each DR event. Each record links one service point to one demand response event with attributes that exist only in the context of this specific participation instance — including notification timestamps, baseline load calculations, actual curtailment achieved, compliance status, and earned incentives. This is the operational SSOT for DR program dispatch, customer response measurement, and settlement processing.. Existence Justification: In utility demand response operations, a service point (customer premise) can participate in multiple DR events over time, and each DR event dispatches to multiple service points simultaneously. The business actively manages each participation instance as an operational record — tracking notification delivery, measuring load curtailment performance against baseline, assessing compliance, and calculating incentive payments. This is not an analytical correlation; it is the operational transaction record for DR dispatch and settlement.' .

ind:Inspector rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Asset ;
    rdfs:label 'Inspector' ;
    rdfs:comment 'Master reference table for inspector. Referenced by inspector_id.' .

ind:InspectionCrew rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Asset ;
    rdfs:label 'Inspection Crew' ;
    rdfs:comment 'Master reference table for inspection_crew. Referenced by inspection_crew_id.' .

ind:CollectionsAction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Billing ;
    rdfs:label 'Collections Action' ;
    rdfs:comment 'Master reference table for collections_action. Referenced by associated_collections_action_id.' .

ind:Bus rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Bus' ;
    rdfs:comment 'Master reference table for bus. Referenced by source_bus_id.' .

ind:CityGateStation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'City Gate Station' ;
    rdfs:comment 'Master reference table for city_gate_station. Referenced by city_gate_station_id.' .

ind:GasNetworkNode rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Gas Network Node' ;
    rdfs:comment 'Master reference table for gas_network_node. Referenced by from_node_id.' .

ind:CrewDispatch rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Crew Dispatch' ;
    rdfs:comment 'Master reference table for crew_dispatch. Referenced by crew_dispatch_id.' .

ind:ProtectiveDevice rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Protective Device' ;
    rdfs:comment 'Master reference table for protective_device. Referenced by protective_device_id.' .

ind:DepreciationStudy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Depreciation Study' ;
    rdfs:comment 'Master reference table for depreciation_study. Referenced by depreciation_study_id.' .

ind:JournalEntryTemplate rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Journal Entry Template' ;
    rdfs:comment 'Master reference table for journal_entry_template. Referenced by recurring_template_id.' .

ind:WbsElement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Wbs Element' ;
    rdfs:comment 'Master reference table for wbs_element. Referenced by wbs_element_id.' .

ind:Employee rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Employee' ;
    rdfs:comment 'Master reference table for employee. Referenced by contract_owner_employee_id.' .

ind:RtoIso rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Market ;
    rdfs:label 'Rto Iso' ;
    rdfs:comment 'Master reference table for rto_iso. Referenced by rto_iso_id.' .

ind:CapacityMarketAuction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Market ;
    rdfs:label 'Capacity Market Auction' ;
    rdfs:comment 'Master reference table for capacity_market_auction. Referenced by capacity_market_auction_id.' .

ind:MarketZone rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Market ;
    rdfs:label 'Market Zone' ;
    rdfs:comment 'Master reference table for market_zone. Referenced by zone_id.' .

ind:CapacityTransferAgreement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Market ;
    rdfs:label 'Capacity Transfer Agreement' ;
    rdfs:comment 'Master reference table for capacity_transfer_agreement. Referenced by transfer_agreement_id.' .

ind:DemandResponseProgram rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Market ;
    rdfs:label 'Demand Response Program' ;
    rdfs:comment 'Master reference table for demand_response_program. Referenced by demand_response_program_id.' .

ind:IrpPortfolio rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Regulatory ;
    rdfs:label 'Irp Portfolio' ;
    rdfs:comment 'Master reference table for irp_portfolio. Referenced by irp_portfolio_id.' .

ind:RpsProgram rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Regulatory ;
    rdfs:label 'Rps Program' ;
    rdfs:comment 'Master reference table for rps_program. Referenced by rps_program_id.' .

ind:TransmissionRightsPortfolio rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Market ;
    rdfs:label 'Transmission Rights Portfolio' ;
    rdfs:comment 'Master reference table for transmission_rights_portfolio. Referenced by portfolio_id.' .

ind:TouSchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Metering ;
    rdfs:label 'Tou Schedule' ;
    rdfs:comment 'Master reference table for tou_schedule. Referenced by tou_schedule_id.' .

ind:VeeRuleSet rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Metering ;
    rdfs:label 'Vee Rule Set' ;
    rdfs:comment 'Master reference table for vee_rule_set. Referenced by vee_rule_set_id.' .

ind:CorrectiveActionPlan rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Regulatory ;
    rdfs:label 'Corrective Action Plan' ;
    rdfs:comment 'Master reference table for corrective_action_plan. Referenced by corrective_action_plan_id.' .

ind:Facility rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Asset ;
    rdfs:label 'Facility' ;
    rdfs:comment 'Master reference table for facility. Referenced by facility_id.' .

ind:ConstrainedElement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Constrained Element' ;
    rdfs:comment 'Master reference table for constrained_element. Referenced by constrained_element_id.' .

ind:Flowgate rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Flowgate' ;
    rdfs:comment 'Master reference table for flowgate. Referenced by flowgate_id.' .

ind:ContingencyScenario rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Contingency Scenario' ;
    rdfs:comment 'Master reference table for contingency_scenario. Referenced by contingency_scenario_id.' .

ind:ControlArea rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Control Area' ;
    rdfs:comment 'Master reference table for control_area. Referenced by control_area_id.' .

ind:BalancingAuthority rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Balancing Authority' ;
    rdfs:comment 'Master reference table for balancing_authority. Referenced by counterparty_ba_id.' .

ind:ControlCenter rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Control Center' ;
    rdfs:comment 'Master reference table for control_center. Referenced by control_center_id.' .

ind:Bus rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Bus' ;
    rdfs:comment 'Master reference table for bus. Referenced by from_bus_id.' .

ind:Operator rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Operator' ;
    rdfs:comment 'Master reference table for operator. Referenced by authorizing_operator_id.' .

ind:Crew rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Transmission ;
    rdfs:label 'Crew' ;
    rdfs:comment 'Master reference table for crew. Referenced by executing_crew_id.' .

ind:Zone rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Zone' ;
    rdfs:comment 'Master reference table for zone. Referenced by zone_id.' .

ind:ServiceArea rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Service Area' ;
    rdfs:comment 'Master reference table for service_area. Referenced by service_area_id.' .

ind:District rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'District' ;
    rdfs:comment 'Master reference table for district. Referenced by district_id.' .

ind:NetworkModel rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Network Model' ;
    rdfs:comment 'Master reference table for network_model. Referenced by network_model_id.' .

ind:ServiceTerritory rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Distribution ;
    rdfs:label 'Service Territory' ;
    rdfs:comment 'Master reference table for service_territory. Referenced by service_territory_id.' .

ind:Organization rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Finance ;
    rdfs:label 'Organization' ;
    rdfs:comment 'Master reference table for organization. Referenced by responsible_organization_id.' .

ind:Violation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Regulatory ;
    rdfs:label 'Violation' ;
    rdfs:comment 'Master reference table for violation. Referenced by violation_id.' .

ind:Department rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Workforce ;
    rdfs:label 'Department' ;
    rdfs:comment 'Master reference table for department. Referenced by department_id.' .

# --- Attribute Properties ---
ind:conditionId rdf:type rdf:Property ;
    rdfs:label 'Condition Id' ;
    rdfs:comment 'Unique identifier for the asset condition assessment record. Primary key for the asset_condition data product.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:masterId rdf:type rdf:Property ;
    rdfs:label 'Master Id' ;
    rdfs:comment 'Reference to the utility asset being assessed. Links to the asset master record in the asset management system (Oracle WAM or IBM Maximo).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Master .

ind:sourceInspectionRecordId rdf:type rdf:Property ;
    rdfs:label 'Source Inspection Record Id' ;
    rdfs:comment 'Foreign key linking to asset.inspection_record. Business justification: Condition assessments are often produced by inspection activities. The existing source_inspection_reference (STRING) is a weak reference that should be replaced with a proper FK to inspection_record. ' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InspectionRecord .

ind:assessedBy rdf:type rdf:Property ;
    rdfs:label 'Assessed By' ;
    rdfs:comment 'Name or identifier of the inspector, technician, or contractor who performed the condition assessment. May reference internal workforce or external service provider.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentCost rdf:type rdf:Property ;
    rdfs:label 'Assessment Cost' ;
    rdfs:comment 'Total cost incurred to perform the condition assessment, including labor, equipment, and contractor fees. Used for O&M (Operations and Maintenance) expense tracking.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assessmentDate rdf:type rdf:Property ;
    rdfs:label 'Assessment Date' ;
    rdfs:comment 'Date when the condition assessment was performed. Represents the point-in-time snapshot of asset health.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assessmentMethod rdf:type rdf:Property ;
    rdfs:label 'Assessment Method' ;
    rdfs:comment 'Method or technique used to assess the asset condition. Includes visual inspection, diagnostic testing, oil analysis, thermography, LiDAR (Light Detection and Ranging) scan, ultrasonic testing, and partial discharge testing for electrical equipment. [ENUM-REF-CANDIDATE: visual_inspection|diagnostic_testing|oil_analysis|thermography|lidar_scan|ultrasonic_testing|partial_discharge_testing — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentNotes rdf:type rdf:Property ;
    rdfs:label 'Assessment Notes' ;
    rdfs:comment 'Additional free-text notes or observations from the condition assessment. Captures context, environmental factors, or anomalies not covered by structured fields.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentStatus rdf:type rdf:Property ;
    rdfs:label 'Assessment Status' ;
    rdfs:comment 'Lifecycle status of the condition assessment record. Draft assessments are under review; approved assessments are the current authoritative condition state; superseded assessments have been replaced by newer evaluations.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessorOrganization rdf:type rdf:Property ;
    rdfs:label 'Assessor Organization' ;
    rdfs:comment 'Organization or company that performed the assessment (internal utility workforce, contracted inspection firm, OEM service provider).' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:corrosionLevel rdf:type rdf:Property ;
    rdfs:label 'Corrosion Level' ;
    rdfs:comment 'Assessment of corrosion severity on metal components of the asset. Critical for gas pipelines, transmission towers, and substation structures.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:createdTimestamp rdf:type rdf:Property ;
    rdfs:label 'Created Timestamp' ;
    rdfs:comment 'Timestamp when this condition assessment record was first created in the system. Follows format yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:failureModeIndicators rdf:type rdf:Property ;
    rdfs:label 'Failure Mode Indicators' ;
    rdfs:comment 'Observed indicators or symptoms of specific failure modes (e.g., overheating, vibration, oil contamination, partial discharge activity). Free-text field capturing diagnostic findings.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:healthIndex rdf:type rdf:Property ;
    rdfs:label 'Health Index' ;
    rdfs:comment 'Normalized health index score (0-100) representing the asset\'s current condition relative to its expected lifecycle. Higher values indicate better health. Used for asset replacement prioritization and risk-based maintenance planning.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:insulationConditionScore rdf:type rdf:Property ;
    rdfs:label 'Insulation Condition Score' ;
    rdfs:comment 'Condition score specific to the insulation integrity of electrical assets (transformers, cables, switchgear). Scale of 1.0 to 5.0, where lower scores indicate degraded insulation requiring attention.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastModifiedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Modified Timestamp' ;
    rdfs:comment 'Timestamp of the most recent update to this condition assessment record. Follows format yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:loadingHistoryFactor rdf:type rdf:Property ;
    rdfs:label 'Loading History Factor' ;
    rdfs:comment 'Factor representing the cumulative impact of historical loading patterns on asset degradation. Values above 1.0 indicate the asset has been operated above nameplate capacity, accelerating wear.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maintenanceRecommendation rdf:type rdf:Property ;
    rdfs:label 'Maintenance Recommendation' ;
    rdfs:comment 'Recommended maintenance actions based on the condition assessment (e.g., continue monitoring, schedule preventive maintenance, perform corrective repair, replace asset). Feeds work order generation in EAM system.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mechanicalConditionScore rdf:type rdf:Property ;
    rdfs:label 'Mechanical Condition Score' ;
    rdfs:comment 'Condition score for mechanical components of the asset (bearings, gears, valves, actuators, structural integrity). Scale of 1.0 to 5.0.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nextAssessmentDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Assessment Due Date' ;
    rdfs:comment 'Scheduled date for the next condition assessment. Driven by regulatory requirements, manufacturer recommendations, or risk-based inspection intervals.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:overallConditionScore rdf:type rdf:Property ;
    rdfs:label 'Overall Condition Score' ;
    rdfs:comment 'Aggregated health score representing the overall condition of the asset on a scale of 1.0 to 5.0, where 1.0 indicates critical/failed condition and 5.0 indicates excellent/new condition. This score synthesizes multiple condition attributes and inspection findings.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Compliance Flag' ;
    rdfs:comment 'Boolean indicator (True/False) denoting whether this assessment was performed to satisfy a regulatory compliance obligation (NERC, FERC, PUC, PHMSA requirements).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:remainingUsefulLifeYears rdf:type rdf:Property ;
    rdfs:label 'Remaining Useful Life Years' ;
    rdfs:comment 'Estimated remaining useful life of the asset in years, based on current condition, loading history, and expected degradation rate. Used for capital planning and replacement scheduling.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:replacementUrgency rdf:type rdf:Property ;
    rdfs:label 'Replacement Urgency' ;
    rdfs:comment 'Categorization of replacement urgency based on condition assessment and risk analysis. Drives capital investment prioritization and rate case justification for asset replacement programs.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskScore rdf:type rdf:Property ;
    rdfs:label 'Risk Score' ;
    rdfs:comment 'Composite risk score combining probability of failure (derived from condition) and consequence of failure (impact on reliability, safety, and customer service). Used for risk-based maintenance prioritization.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:trend rdf:type rdf:Property ;
    rdfs:label 'Trend' ;
    rdfs:comment 'Trend direction of asset condition based on comparison with previous assessments. Rapidly degrading assets require accelerated intervention.' ;
    rdfs:domain ind:Condition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hierarchyId rdf:type rdf:Property ;
    rdfs:label 'Hierarchy Id' ;
    rdfs:comment 'Unique identifier for the asset hierarchy relationship record. Primary key for the asset hierarchy product.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:childAssetAssetMasterId rdf:type rdf:Property ;
    rdfs:label 'Child Asset Asset Master Id' ;
    rdfs:comment 'Identifier of the child asset in the hierarchy structure. References the subordinate asset in the parent-child relationship (e.g., transformer as child of substation, circuit breaker as child of feeder).' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Master .

ind:connectivityRole rdf:type rdf:Property ;
    rdfs:label 'Connectivity Role' ;
    rdfs:comment 'Electrical or operational connectivity role of the child asset relative to the parent in network topology. Upstream indicates the child is electrically upstream (source side) of the parent. Downstream indicates the child is electrically downstream (load side). Parallel indicates the child operates in parallel with siblings. Redundant indicates the child provides backup capacity. Backup indicates standby configuration. Isolated indicates the child is electrically isolated. Used by OMS for fault isolation and upstream/downstream asset identification during outage events.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costRollupEnabled rdf:type rdf:Property ;
    rdfs:label 'Cost Rollup Enabled' ;
    rdfs:comment 'Boolean flag indicating whether maintenance and capital costs (CAPEX/OPEX) for the child asset should be rolled up and aggregated to the parent asset for financial reporting. True enables cost aggregation for rate case cost studies, depreciation schedules, and regulatory asset base reporting. False isolates child costs for separate tracking. Used by EAM (Oracle WAM/Maximo) for work order cost allocation and AFUDC calculation.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:criticalityInheritance rdf:type rdf:Property ;
    rdfs:label 'Criticality Inheritance' ;
    rdfs:comment 'Rule governing how asset criticality rating is inherited or calculated within the hierarchy. Inherit from parent means the child adopts the parent\'s criticality. Override independent means the child has its own criticality rating. Aggregate children means the parent\'s criticality is calculated from child criticalities. Highest in branch means the criticality is the maximum value in the hierarchy branch. Used for risk-based maintenance prioritization and regulatory compliance (NERC CIP asset identification).' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectiveDate rdf:type rdf:Property ;
    rdfs:label 'Effective Date' ;
    rdfs:comment 'Date when the parent-child hierarchical relationship became or will become active. Used for temporal hierarchy tracking to support asset configuration changes, capital project commissioning (CPCN), and regulatory asset base reporting. Supports point-in-time hierarchy reconstruction for rate case cost studies and depreciation schedule audits.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:expirationDate rdf:type rdf:Property ;
    rdfs:label 'Expiration Date' ;
    rdfs:comment 'Date when the parent-child hierarchical relationship ended or will end. Null for currently active relationships. Populated when assets are relocated, reconfigured, or retired. Used for temporal hierarchy tracking to support asset lifecycle analysis, work order cost roll-up accuracy, and regulatory depreciation reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:hierarchyLevel rdf:type rdf:Property ;
    rdfs:label 'Hierarchy Level' ;
    rdfs:comment 'Numeric depth level of the child asset within the overall hierarchy tree. Level 1 represents top-level assets (e.g., power plant, transmission substation), with increasing numbers representing deeper nesting (e.g., level 5 might be individual relay components). Used for drill-down navigation and cost roll-up aggregation in EAM systems.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:hierarchyType rdf:type rdf:Property ;
    rdfs:label 'Hierarchy Type' ;
    rdfs:comment 'Classification of the hierarchical relationship type. Functional location represents geographic or operational location hierarchy (plant > substation > bay). Asset assembly represents physical component breakdown (transformer > winding > bushing). Network segment represents electrical connectivity (transmission line > circuit > segment). Linear reference represents distance-based positioning along linear assets (pipeline > mile marker). System subsystem represents logical grouping (generation system > turbine subsystem). Spatial containment represents GIS-based geographic containment.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isPrimaryParent rdf:type rdf:Property ;
    rdfs:label 'Is Primary Parent' ;
    rdfs:comment 'Boolean flag indicating whether this parent represents the primary hierarchical relationship for the child asset. True when this is the authoritative parent for cost roll-up, work order scoping, and regulatory reporting. False for secondary or reference-only parent relationships. An asset may have multiple parents in different hierarchy types (functional location vs. network segment), but only one primary parent per type.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:linearMeasureFrom rdf:type rdf:Property ;
    rdfs:label 'Linear Measure From' ;
    rdfs:comment 'Starting linear distance measure along the parent linear asset (transmission line, gas pipeline) where the child asset begins. Measured in the unit specified by linear measure unit (typically miles, kilometers, or feet). Used for linear referencing systems to position assets along network segments. Supports GIS linear referencing and pipeline integrity management (PHMSA compliance).' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:linearMeasureTo rdf:type rdf:Property ;
    rdfs:label 'Linear Measure To' ;
    rdfs:comment 'Ending linear distance measure along the parent linear asset (transmission line, gas pipeline) where the child asset ends. Measured in the unit specified by linear measure unit (typically miles, kilometers, or feet). Used for linear referencing systems to define asset span or coverage. Supports GIS linear referencing and pipeline integrity management (PHMSA compliance).' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:linearMeasureUnit rdf:type rdf:Property ;
    rdfs:label 'Linear Measure Unit' ;
    rdfs:comment 'Unit of measure for linear distance measurements (linear measure from and linear measure to) along linear assets. Miles and feet are common in US utilities. Kilometers and meters are common internationally. Used for linear referencing systems in GIS and pipeline integrity management.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modifiedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Modified Timestamp' ;
    rdfs:comment 'Timestamp when the asset hierarchy relationship record was last modified. Updated whenever any attribute of the relationship changes. Used for change tracking, audit trail, and data synchronization between EAM (Oracle WAM/Maximo) and GIS (ESRI ArcGIS) systems.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:positionSlot rdf:type rdf:Property ;
    rdfs:label 'Position Slot' ;
    rdfs:comment 'Physical or logical position identifier of the child asset within the parent assembly. Examples include bay number within substation (Bay-A, Bay-B), slot number in control panel (Slot-03), phase designation (Phase-A, Phase-B, Phase-C), or valve station milepost (MP-45.2). Used for spatial asset management and maintenance work order scoping.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relationshipDescription rdf:type rdf:Property ;
    rdfs:label 'Relationship Description' ;
    rdfs:comment 'Free-text description providing additional context about the parent-child hierarchical relationship. May include physical connection details, functional dependency notes, or special configuration information relevant to maintenance planning, outage management, or network analysis.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relationshipStatus rdf:type rdf:Property ;
    rdfs:label 'Relationship Status' ;
    rdfs:comment 'Current lifecycle status of the parent-child hierarchical relationship. Active indicates the relationship is currently in effect. Inactive indicates the relationship has been superseded but retained for historical reference. Planned indicates a future relationship for capital projects (CAPEX) or asset additions. Decommissioned indicates the relationship ended due to asset retirement. Temporary indicates a short-term relationship for construction or maintenance activities.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sortOrder rdf:type rdf:Property ;
    rdfs:label 'Sort Order' ;
    rdfs:comment 'Numeric sequence for ordering child assets within the same parent and hierarchy level. Used to control display order in EAM work order hierarchies, GIS network trace results, and asset drill-down reports. Lower numbers appear first.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:spatialReferenceSystem rdf:type rdf:Property ;
    rdfs:label 'Spatial Reference System' ;
    rdfs:comment 'Geographic coordinate system or spatial reference identifier used for GIS-based hierarchy positioning. Examples include EPSG codes (e.g., EPSG:4326 for WGS84, EPSG:3857 for Web Mercator) or state plane coordinate systems. Used by ESRI ArcGIS for spatial asset management, network connectivity modeling, and linear referencing along transmission lines and gas pipelines.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationId rdf:type rdf:Property ;
    rdfs:label 'Location Id' ;
    rdfs:comment 'Unique identifier for the asset location record. Primary key for the asset location entity.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Location .

ind:parentLocationId rdf:type rdf:Property ;
    rdfs:label 'Parent Location Id' ;
    rdfs:comment 'Reference to the parent location in a hierarchical location structure, enabling nested location relationships such as a pole within a circuit or a bay within a substation.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Location .

ind:premiseId rdf:type rdf:Property ;
    rdfs:label 'Premise Id' ;
    rdfs:comment 'Foreign key linking to customer.premise. Business justification: Asset locations often coincide with customer premises (pad-mount transformers, meters, service equipment at property). Supports spatial analysis, service territory planning, and asset-to-customer mapp' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Premise .

ind:accessRestrictions rdf:type rdf:Property ;
    rdfs:label 'Access Restrictions' ;
    rdfs:comment 'Description of any physical or regulatory restrictions on accessing the asset location, such as locked gates, permit requirements, or hazardous conditions.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:city rdf:type rdf:Property ;
    rdfs:label 'City' ;
    rdfs:comment 'City or municipality where the asset location is situated.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coordinateAccuracyClass rdf:type rdf:Property ;
    rdfs:label 'Coordinate Accuracy Class' ;
    rdfs:comment 'Classification of the spatial coordinate accuracy for the asset location, indicating the precision and reliability of latitude and longitude data.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:countryCode rdf:type rdf:Property ;
    rdfs:label 'Country Code' ;
    rdfs:comment 'Three-letter ISO country code where the asset location is situated.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:county rdf:type rdf:Property ;
    rdfs:label 'County' ;
    rdfs:comment 'County or parish jurisdiction where the asset location resides, used for regulatory compliance and tax reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criticalityRating rdf:type rdf:Property ;
    rdfs:label 'Criticality Rating' ;
    rdfs:comment 'Business criticality classification of the asset location based on customer impact, system reliability, and operational importance. Drives maintenance prioritization and emergency response.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eamSystemReference rdf:type rdf:Property ;
    rdfs:label 'Eam System Reference' ;
    rdfs:comment 'Unique identifier for this asset location in the source Enterprise Asset Management system (Oracle WAM or IBM Maximo), used for cross-system reconciliation.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:easementReference rdf:type rdf:Property ;
    rdfs:label 'Easement Reference' ;
    rdfs:comment 'Reference identifier for the utility easement or right-of-way agreement granting access to this location, critical for legal compliance and asset access rights.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:elevationFt rdf:type rdf:Property ;
    rdfs:label 'Elevation Ft' ;
    rdfs:comment 'Elevation of the asset location above sea level in feet, relevant for transmission line clearance calculations and flood risk assessment.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:environmentalZone rdf:type rdf:Property ;
    rdfs:label 'Environmental Zone' ;
    rdfs:comment 'Environmental classification or sensitive area designation for the location, such as wetland, floodplain, or protected habitat, used for environmental compliance.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gasPressureZone rdf:type rdf:Property ;
    rdfs:label 'Gas Pressure Zone' ;
    rdfs:comment 'Natural gas pressure zone designation for locations on the gas distribution network, used for pipeline safety and operational planning.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gisFeatureClass rdf:type rdf:Property ;
    rdfs:label 'Gis Feature Class' ;
    rdfs:comment 'GIS feature class or layer name in the ESRI ArcGIS system where this location is represented, enabling integration with spatial asset management.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gisObjectReference rdf:type rdf:Property ;
    rdfs:label 'Gis Object Reference' ;
    rdfs:comment 'Unique object identifier in the GIS system for this asset location, used for cross-system integration between Enterprise Asset Management (EAM) and GIS platforms.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inServiceDate rdf:type rdf:Property ;
    rdfs:label 'In Service Date' ;
    rdfs:comment 'Date when the asset location became operational and available for asset installation and service delivery.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:installationDate rdf:type rdf:Property ;
    rdfs:label 'Installation Date' ;
    rdfs:comment 'Date when the asset location was first established or commissioned for utility operations.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:landParcelReference rdf:type rdf:Property ;
    rdfs:label 'Land Parcel Reference' ;
    rdfs:comment 'Tax parcel identifier or legal land description for the property where the asset location resides, used for easement management and property tax reporting.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:latitude rdf:type rdf:Property ;
    rdfs:label 'Latitude' ;
    rdfs:comment 'Geographic latitude coordinate of the asset location in decimal degrees, used for Geographic Information System (GIS) integration and spatial analysis.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:locationCode rdf:type rdf:Property ;
    rdfs:label 'Location Code' ;
    rdfs:comment 'Business identifier code for the asset location, used for operational reference and work order dispatching. Typically follows utility-specific naming conventions for substations, plants, poles, vaults, and other infrastructure locations.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationDescription rdf:type rdf:Property ;
    rdfs:label 'Location Description' ;
    rdfs:comment 'Detailed textual description of the asset location, including landmarks, access instructions, and physical characteristics to aid field crews in locating the site.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationName rdf:type rdf:Property ;
    rdfs:label 'Location Name' ;
    rdfs:comment 'Human-readable name or designation of the asset location, such as substation name, plant name, or pole identifier.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationStatus rdf:type rdf:Property ;
    rdfs:label 'Location Status' ;
    rdfs:comment 'Current operational status of the asset location in its lifecycle. Indicates whether the location is available for asset installation and operational use.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationType rdf:type rdf:Property ;
    rdfs:label 'Location Type' ;
    rdfs:comment 'Classification of the physical or functional location type where utility assets are installed. Determines the spatial and operational characteristics of the location. [ENUM-REF-CANDIDATE: substation|generating_plant|transmission_tower|distribution_pole|vault|manhole|right_of_way — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:longitude rdf:type rdf:Property ;
    rdfs:label 'Longitude' ;
    rdfs:comment 'Geographic longitude coordinate of the asset location in decimal degrees, used for Geographic Information System (GIS) integration and spatial analysis.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:modifiedBy rdf:type rdf:Property ;
    rdfs:label 'Modified By' ;
    rdfs:comment 'User identifier or system account that last modified this asset location record, supporting audit and data governance requirements.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operatingCenter rdf:type rdf:Property ;
    rdfs:label 'Operating Center' ;
    rdfs:comment 'Operational control center or district responsible for managing assets at this location, used for crew dispatching and maintenance planning.' ;
    rdfs:domain ind:Location ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownershipType rdf:type rdf:Property ;
    rdfs:label 'Ownership Type' ;
    rdfs:comment 'Classification of the ownership or control arrangement for the asset location, indicating whether it is utility-owned, customer-owned, or under easement.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postalCode rdf:type rdf:Property ;
    rdfs:label 'Postal Code' ;
    rdfs:comment 'Postal or ZIP code for the asset location address.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Regulatory Jurisdiction' ;
    rdfs:comment 'Public Utility Commission (PUC) or regulatory body with jurisdiction over this asset location, used for compliance reporting and rate case preparation.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retirementDate rdf:type rdf:Property ;
    rdfs:label 'Retirement Date' ;
    rdfs:comment 'Date when the asset location was decommissioned or retired from active service, used for regulatory asset base reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:serviceTerritory rdf:type rdf:Property ;
    rdfs:label 'Service Territory' ;
    rdfs:comment 'Geographic service territory or operating region where the asset location resides, used for jurisdictional and regulatory reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:state rdf:type rdf:Property ;
    rdfs:label 'State' ;
    rdfs:comment 'State or province where the asset location is located, critical for Public Utility Commission (PUC) jurisdictional reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:streetAddress rdf:type rdf:Property ;
    rdfs:label 'Street Address' ;
    rdfs:comment 'Physical street address of the asset location, including street number and name. Used for emergency response, crew dispatching, and regulatory reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:substationName rdf:type rdf:Property ;
    rdfs:label 'Substation Name' ;
    rdfs:comment 'Name of the substation where this location resides, applicable for locations within substation boundaries. Used for operational coordination and outage management.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:voltageLevelKv rdf:type rdf:Property ;
    rdfs:label 'Voltage Level Kv' ;
    rdfs:comment 'Nominal voltage level in kilovolts (kV) at this location, indicating whether it is transmission, sub-transmission, or distribution voltage.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountId rdf:type rdf:Property ;
    rdfs:label 'Account Id' ;
    rdfs:comment 'Foreign key linking to customer.account. Business justification: Customer-specific assets (meters, service equipment) are assigned to accounts for billing, service delivery tracking, and cost allocation. Required for meter-to-bill reconciliation and customer servic' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Account .

ind:costCenterId rdf:type rdf:Property ;
    rdfs:label 'Cost Center Id' ;
    rdfs:comment 'Foreign key linking to finance.cost_center. Business justification: Assets are assigned to cost centers for ownership, responsibility, and budget allocation. Required for asset accounting, depreciation expense allocation, and management reporting by organizational uni' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CostCenter .

ind:assetClass rdf:type rdf:Property ;
    rdfs:label 'Asset Class' ;
    rdfs:comment 'High-level classification of the asset type across generation, transmission, distribution, and gas infrastructure. Determines the applicable maintenance programs, regulatory reporting requirements, and depreciation schedules. [ENUM-REF-CANDIDATE: generation_unit|transmission_line|distribution_transformer|gas_main|substation|meter|capacitor_bank|voltage_regulator — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetStatus rdf:type rdf:Property ;
    rdfs:label 'Asset Status' ;
    rdfs:comment 'Current lifecycle status of the asset. Active assets are in service and generating revenue or providing service. Retired assets are removed from service but not yet decommissioned. Decommissioned assets are permanently removed and disposed. Under construction assets are in the capital project phase (WIP). Standby assets are available but not currently in service. Out of service assets are temporarily unavailable due to maintenance or failure.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetTag rdf:type rdf:Property ;
    rdfs:label 'Asset Tag' ;
    rdfs:comment 'Externally-known unique asset identifier assigned by the utility for physical asset tracking and field identification. Typically affixed to the physical asset as a barcode or RFID tag. Used by field crews and maintenance personnel for asset lookup.' ;
    rdfs:domain ind:Master ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetType rdf:type rdf:Property ;
    rdfs:label 'Asset Type' ;
    rdfs:comment 'Detailed asset type within the asset class. Examples: combustion turbine, combined cycle unit, overhead transmission line, underground distribution cable, steel gas main, AMI electric meter, pad-mounted transformer. Drives specific maintenance procedures and inspection protocols.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capacityUnit rdf:type rdf:Property ;
    rdfs:label 'Capacity Unit' ;
    rdfs:comment 'Unit of measure for the rated capacity field. MW (Megawatt) for generation. kVA or MVA for transformers. MCF (Thousand Cubic Feet) or BCF (Billion Cubic Feet) for gas infrastructure. kV (Kilovolt) for voltage level. [ENUM-REF-CANDIDATE: MW|kW|MVA|kVA|MCF|BCF|kV — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Master ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depreciationMethod rdf:type rdf:Property ;
    rdfs:label 'Depreciation Method' ;
    rdfs:comment 'Accounting depreciation method applied to this asset for financial reporting and rate case preparation. Straight-line is most common for utility assets. Method must be approved by the regulatory commission.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fercAccountCode rdf:type rdf:Property ;
    rdfs:label 'Ferc Account Code' ;
    rdfs:comment 'FERC Uniform System of Accounts code for regulatory asset classification and depreciation tracking. Examples: 311 (Intangible Plant), 314 (Transmission Plant), 360-373 (Distribution Plant), 101 (Gas Plant in Service). Required for rate case filings and regulatory asset base reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationAccuracyClass rdf:type rdf:Property ;
    rdfs:label 'Location Accuracy Class' ;
    rdfs:comment 'Classification of the spatial accuracy of the asset location coordinates. GPS-surveyed: sub-meter accuracy from field GPS survey. As-built: derived from engineering as-built drawings. Estimated: approximate location from design drawings or aerial imagery. Unknown: location accuracy not verified.' ;
    rdfs:domain ind:Master ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:manufacturer rdf:type rdf:Property ;
    rdfs:label 'Manufacturer' ;
    rdfs:comment 'Name of the original equipment manufacturer (OEM) who produced the asset. Used for warranty tracking, parts sourcing, and technical support. Examples: GE, Siemens, ABB, Schneider Electric, Sensus, Itron.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelNumber rdf:type rdf:Property ;
    rdfs:label 'Model Number' ;
    rdfs:comment 'Manufacturer model number or designation for the asset. Used to identify technical specifications, compatible parts, and maintenance procedures specific to this model.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:narucAccountCode rdf:type rdf:Property ;
    rdfs:label 'Naruc Account Code' ;
    rdfs:comment 'NARUC Uniform System of Accounts code for state-level regulatory reporting. May differ from FERC codes for distribution and retail assets under state PUC jurisdiction.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originalCost rdf:type rdf:Property ;
    rdfs:label 'Original Cost' ;
    rdfs:comment 'Original installed cost of the asset including equipment, labor, materials, and capitalized overheads. This is the basis for depreciation and regulatory asset base valuation. Includes AFUDC (Allowance for Funds Used During Construction) if applicable.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ratedCapacity rdf:type rdf:Property ;
    rdfs:label 'Rated Capacity' ;
    rdfs:comment 'Nameplate rated capacity of the asset in the appropriate unit of measure. For generation units: MW. For transformers: kVA or MVA. For gas mains: MCF per day. For transmission lines: MVA. Critical for capacity planning, load balancing, and regulatory reporting.' ;
    rdfs:domain ind:Master ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryAssetBaseFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Asset Base Flag' ;
    rdfs:comment 'Boolean flag indicating whether this asset is included in the regulatory asset base (rate base) for rate case calculations. True if the asset is used and useful in providing utility service and eligible for cost recovery through rates. False if the asset is excluded from rate base (e.g., non-utility use, under construction, retired).' ;
    rdfs:domain ind:Master ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:salvageValue rdf:type rdf:Property ;
    rdfs:label 'Salvage Value' ;
    rdfs:comment 'Estimated residual value of the asset at the end of its useful life. Used in depreciation calculations to determine the depreciable base (original cost minus salvage value). Typically expressed in dollars.' ;
    rdfs:domain ind:Master ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:serialNumber rdf:type rdf:Property ;
    rdfs:label 'Serial Number' ;
    rdfs:comment 'Unique serial number assigned by the manufacturer to this specific asset unit. Used for warranty claims, recall tracking, and precise asset identification.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usefulLifeYears rdf:type rdf:Property ;
    rdfs:label 'Useful Life Years' ;
    rdfs:comment 'Expected useful life of the asset in years for depreciation calculation purposes. Determined by engineering studies and approved by the regulatory commission. Used to calculate annual depreciation expense.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failureEventId rdf:type rdf:Property ;
    rdfs:label 'Failure Event Id' ;
    rdfs:comment 'Unique identifier for the asset failure event record. Primary key for the failure event entity.' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:complianceEventId rdf:type rdf:Property ;
    rdfs:label 'Compliance Event Id' ;
    rdfs:comment 'Foreign key linking to regulatory.compliance_event. Business justification: Reportable failures (NERC Category 1-5, major outages) trigger mandatory compliance event filings. Links asset failures to regulatory reporting obligations. Critical for NERC violation tracking, penal' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ComplianceEvent .

ind:correctiveWorkOrderId rdf:type rdf:Property ;
    rdfs:label 'Corrective Work Order Id' ;
    rdfs:comment 'Foreign key linking to asset.work_order. Business justification: Critical operational link: failure events trigger corrective maintenance work orders. The existing work_order_number (STRING) is a business key reference, not a proper FK. Adding corrective_work_order' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WorkOrder .

ind:distributionOutageEventId rdf:type rdf:Property ;
    rdfs:label 'Distribution Outage Event Id' ;
    rdfs:comment 'Reference to the associated outage event record in the Outage Management System (OMS). Links the failure to customer impact and service restoration activities.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DistributionOutageEvent .

ind:meterId rdf:type rdf:Property ;
    rdfs:label 'Meter Id' ;
    rdfs:comment 'Foreign key linking to metering.meter. Business justification: Asset failures on metering infrastructure (meter socket failures, CT/PT failures, service panel issues) require direct meter linkage for outage correlation, VEE processing of affected intervals, and c' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Meter .

ind:ppaContractId rdf:type rdf:Property ;
    rdfs:label 'Ppa Contract Id' ;
    rdfs:comment 'Foreign key linking to market.ppa_contract. Business justification: Failure events on PPA-contracted generation assets impact contract performance obligations, trigger availability guarantee calculations, determine liquidated damages exposure, and require counterparty' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PpaContract .

ind:assetAgeYears rdf:type rdf:Property ;
    rdfs:label 'Asset Age Years' ;
    rdfs:comment 'Age of the failed asset in years at the time of failure, calculated from installation date to failure date. Used for age-related failure analysis and asset health scoring.' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assetCriticalityRating rdf:type rdf:Property ;
    rdfs:label 'Asset Criticality Rating' ;
    rdfs:comment 'Criticality classification of the failed asset based on customer impact, system reliability importance, and safety considerations. Used for prioritizing corrective actions and replacement investments.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetLocation rdf:type rdf:Property ;
    rdfs:label 'Asset Location' ;
    rdfs:comment 'Physical location description of the failed asset, including substation name, feeder ID, pole number, or street address. Used for geographic failure analysis and crew dispatch.' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consequentialCostAmount rdf:type rdf:Property ;
    rdfs:label 'Consequential Cost Amount' ;
    rdfs:comment 'Indirect costs resulting from the failure, including lost revenue during outage, customer compensation payments, regulatory penalties, and emergency response costs.' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:correctiveActionTaken rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Taken' ;
    rdfs:comment 'Description of the corrective actions taken to restore service and repair or replace the failed asset. Includes temporary repairs, permanent fixes, and preventive measures implemented.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerMinutesInterrupted rdf:type rdf:Property ;
    rdfs:label 'Customer Minutes Interrupted' ;
    rdfs:comment 'Total customer-minutes of interruption, calculated as customers_affected_count multiplied by outage_duration_minutes. Direct input to SAIDI calculation.' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:customersAffectedCount rdf:type rdf:Property ;
    rdfs:label 'Customers Affected Count' ;
    rdfs:comment 'Number of customer accounts that experienced service interruption as a result of this failure. Used for SAIFI calculation and regulatory reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:detectionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Detection Timestamp' ;
    rdfs:comment 'Date and time when the failure was first detected by monitoring systems, SCADA alarms, or customer calls. May differ from actual failure timestamp for latent failures.' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:equipmentType rdf:type rdf:Property ;
    rdfs:label 'Equipment Type' ;
    rdfs:comment 'Classification of the failed equipment type (e.g., transformer, circuit breaker, conductor, pole, underground cable, gas main, meter). Used for failure trend analysis by equipment class.' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failureCauseCategory rdf:type rdf:Property ;
    rdfs:label 'Failure Cause Category' ;
    rdfs:comment 'High-level categorization of the root cause of failure (e.g., equipment defect, environmental conditions, human error, external interference, age-related degradation). Used for trend analysis and preventive maintenance planning.' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failureCostAmount rdf:type rdf:Property ;
    rdfs:label 'Failure Cost Amount' ;
    rdfs:comment 'Total cost of the failure event including direct repair costs, replacement parts, labor, equipment rental, and consequential costs such as lost revenue and customer compensation. Used for asset lifecycle cost analysis and replacement prioritization.' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:failureDescription rdf:type rdf:Property ;
    rdfs:label 'Failure Description' ;
    rdfs:comment 'Detailed narrative description of the failure event, including observed symptoms, field crew observations, and any unusual circumstances. Free-text field for operational context.' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failureMode rdf:type rdf:Property ;
    rdfs:label 'Failure Mode' ;
    rdfs:comment 'Technical classification of how the asset failed. Describes the physical mechanism of failure. [ENUM-REF-CANDIDATE: insulation_breakdown|mechanical_failure|corrosion|overload|lightning_strike|third_party_damage|thermal_degradation|electrical_fault|structural_failure|control_system_failure|communication_failure|software_malfunction — promote to reference product]' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failureNumber rdf:type rdf:Property ;
    rdfs:label 'Failure Number' ;
    rdfs:comment 'Business identifier for the failure event, typically generated by the Outage Management System (OMS) or EAM system. Used for external reporting and cross-system reference.' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failureSeverity rdf:type rdf:Property ;
    rdfs:label 'Failure Severity' ;
    rdfs:comment 'Classification of the failure impact severity. Minor: localized impact, quick restoration. Major: significant customer impact or extended outage. Catastrophic: widespread outage, safety risk, or major asset damage.' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failureTimestamp rdf:type rdf:Property ;
    rdfs:label 'Failure Timestamp' ;
    rdfs:comment 'Date and time when the asset failure occurred. Captured from SCADA alarms, OMS event logs, or field crew reports. Critical for reliability index calculations and root cause analysis.' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:forcedOutageFlag rdf:type rdf:Property ;
    rdfs:label 'Forced Outage Flag' ;
    rdfs:comment 'Indicates whether the failure resulted in a forced (unplanned) outage of the asset. True for unplanned outages, False for failures that did not require immediate service interruption.' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:majorEventDayFlag rdf:type rdf:Property ;
    rdfs:label 'Major Event Day Flag' ;
    rdfs:comment 'Indicates whether this failure occurred during a Major Event Day as defined by IEEE Std 1366. Failures during MEDs are typically excluded from reliability index calculations per regulatory rules.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nercReportableFlag rdf:type rdf:Property ;
    rdfs:label 'Nerc Reportable Flag' ;
    rdfs:comment 'Indicates whether this failure event meets NERC criteria for mandatory reporting as a Bulk Electric System (BES) event or reliability standard violation.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outageDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Outage Duration Minutes' ;
    rdfs:comment 'Total duration of the service interruption in minutes, calculated from failure timestamp to restoration timestamp. Used for SAIDI and CAIDI calculations.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preventiveActionRecommended rdf:type rdf:Property ;
    rdfs:label 'Preventive Action Recommended' ;
    rdfs:comment 'Recommended preventive actions to avoid similar failures in the future, such as design changes, maintenance procedure updates, or asset replacement programs.' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:previousFailureCount rdf:type rdf:Property ;
    rdfs:label 'Previous Failure Count' ;
    rdfs:comment 'Number of previous failure events recorded for this specific asset. Used to identify chronic problem assets and prioritize replacement.' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pucReportableFlag rdf:type rdf:Property ;
    rdfs:label 'Puc Reportable Flag' ;
    rdfs:comment 'Indicates whether this failure event meets state PUC criteria for mandatory reporting, typically based on customer impact thresholds or service quality standards.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rcaCompletedFlag rdf:type rdf:Property ;
    rdfs:label 'Rca Completed Flag' ;
    rdfs:comment 'Indicates whether a formal Root Cause Analysis has been completed for this failure event. True if RCA is complete, False if pending or not required.' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rcaFindings rdf:type rdf:Property ;
    rdfs:label 'Rca Findings' ;
    rdfs:comment 'Summary of the root cause analysis findings, including identified root cause, contributing factors, and recommended corrective actions. Free-text field for detailed engineering analysis.' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryReportableFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reportable Flag' ;
    rdfs:comment 'Indicates whether this failure event meets the threshold for mandatory reporting to regulatory bodies such as NERC, FERC, or state Public Utility Commissions (PUCs). True if reportable, False otherwise.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:repairCostAmount rdf:type rdf:Property ;
    rdfs:label 'Repair Cost Amount' ;
    rdfs:comment 'Direct cost of repairing or replacing the failed asset, including materials, labor, and contractor expenses. Subset of total failure cost.' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:restorationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Restoration Timestamp' ;
    rdfs:comment 'Date and time when service was fully restored following the failure event. Used to calculate outage duration and SAIDI contributions.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:saidiContribution rdf:type rdf:Property ;
    rdfs:label 'Saidi Contribution' ;
    rdfs:comment 'This failure event\'s contribution to the system-wide SAIDI reliability index, measured in minutes per customer. Calculated as customer_minutes_interrupted divided by total customers served.' ;
    rdfs:domain ind:FailureEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:saifiContribution rdf:type rdf:Property ;
    rdfs:label 'Saifi Contribution' ;
    rdfs:comment 'This failure event\'s contribution to the system-wide SAIFI reliability index, measured in interruptions per customer. Calculated as customers_affected_count divided by total customers served.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:updatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Updated Timestamp' ;
    rdfs:comment 'Date and time when this failure event record was last modified. Used for data lineage and audit trail.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:weatherCondition rdf:type rdf:Property ;
    rdfs:label 'Weather Condition' ;
    rdfs:comment 'Weather conditions present at the time of failure. Used to correlate failures with environmental factors and support storm damage analysis. [ENUM-REF-CANDIDATE: clear|rain|snow|ice|wind|lightning|extreme_heat|extreme_cold|fog|tornado|hurricane — promote to reference product]' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionRecordId rdf:type rdf:Property ;
    rdfs:label 'Inspection Record Id' ;
    rdfs:comment 'Unique identifier for the inspection record. Primary key for the inspection_record product.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:complianceObligationId rdf:type rdf:Property ;
    rdfs:label 'Compliance Obligation Id' ;
    rdfs:comment 'Foreign key linking to regulatory.compliance_obligation. Business justification: Inspections fulfill specific regulatory obligations (NERC FAC standards, pipeline integrity rules, substation inspections). Tracks which obligation each inspection satisfies. Removes denormalized regu' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ComplianceObligation .

ind:inspectionCrewId rdf:type rdf:Property ;
    rdfs:label 'Inspection Crew Id' ;
    rdfs:comment 'Identifier of the crew or team that performed the inspection, if applicable. Used when inspections are performed by multi-person teams.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InspectionCrew .

ind:inspectorId rdf:type rdf:Property ;
    rdfs:label 'Inspector Id' ;
    rdfs:comment 'Identifier of the employee or contractor who performed the inspection. Links to workforce or employee master data.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Inspector .

ind:primaryInspectionWorkOrderId rdf:type rdf:Property ;
    rdfs:label 'Primary Inspection Work Order Id' ;
    rdfs:comment 'Reference to the work order under which this inspection was performed, if applicable. Links inspection to maintenance or project work.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WorkOrder .

ind:correctiveActionPriority rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Priority' ;
    rdfs:comment 'Priority level for recommended corrective actions (immediate, urgent, routine, deferred). Determines the timeframe for follow-up work.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctiveActionRecommendation rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Recommendation' ;
    rdfs:comment 'Inspector recommendation for corrective actions to address identified deficiencies. May include repair, replacement, monitoring, or further investigation.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctiveActionRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Required Flag' ;
    rdfs:comment 'Boolean indicator of whether corrective action or follow-up work is required based on inspection findings. True if action required, False otherwise.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deficiencyCount rdf:type rdf:Property ;
    rdfs:label 'Deficiency Count' ;
    rdfs:comment 'Number of distinct deficiencies or issues identified during this inspection. Used for deficiency tracking and trend analysis.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:deficiencyDescription rdf:type rdf:Property ;
    rdfs:label 'Deficiency Description' ;
    rdfs:comment 'Detailed narrative description of the deficiencies, anomalies, or issues identified during the inspection. Includes inspector observations and findings.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deficiencyIdentifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Deficiency Identified Flag' ;
    rdfs:comment 'Boolean indicator of whether any deficiencies, anomalies, or issues were identified during the inspection. True if deficiencies found, False otherwise.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deficiencySeverity rdf:type rdf:Property ;
    rdfs:label 'Deficiency Severity' ;
    rdfs:comment 'Highest severity rating of any deficiency identified during the inspection (critical, high, medium, low, none). Drives prioritization of corrective actions.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionDate rdf:type rdf:Property ;
    rdfs:label 'Inspection Date' ;
    rdfs:comment 'The date on which the field inspection was performed. This is the principal business event timestamp for the inspection occurrence.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:inspectionDocumentReference rdf:type rdf:Property ;
    rdfs:label 'Inspection Document Reference' ;
    rdfs:comment 'Reference identifier or URI to external inspection documentation, photos, test reports, or supporting materials stored in document management system.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionEndTime rdf:type rdf:Property ;
    rdfs:label 'Inspection End Time' ;
    rdfs:comment 'Timestamp when the inspection activity was completed in the field. Used to calculate inspection duration and labor hours.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:inspectionFindings rdf:type rdf:Property ;
    rdfs:label 'Inspection Findings' ;
    rdfs:comment 'Comprehensive narrative of all inspection findings, observations, measurements, and assessments. Serves as the primary inspection documentation record.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionFrequencyDays rdf:type rdf:Property ;
    rdfs:label 'Inspection Frequency Days' ;
    rdfs:comment 'Required inspection frequency in days based on regulatory requirements or internal maintenance standards. Used to calculate next inspection due date.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:inspectionLatitude rdf:type rdf:Property ;
    rdfs:label 'Inspection Latitude' ;
    rdfs:comment 'Geographic latitude coordinate of the inspection location in decimal degrees. Used for spatial analysis and GIS integration.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inspectionLocation rdf:type rdf:Property ;
    rdfs:label 'Inspection Location' ;
    rdfs:comment 'Physical location or site where the inspection was performed. May include substation name, line segment, pole number, or GPS coordinates.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionLongitude rdf:type rdf:Property ;
    rdfs:label 'Inspection Longitude' ;
    rdfs:comment 'Geographic longitude coordinate of the inspection location in decimal degrees. Used for spatial analysis and GIS integration.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inspectionMethod rdf:type rdf:Property ;
    rdfs:label 'Inspection Method' ;
    rdfs:comment 'Detailed description of the inspection methodology, tools, and techniques used. May include equipment model numbers, test procedures, and measurement protocols.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionNotes rdf:type rdf:Property ;
    rdfs:label 'Inspection Notes' ;
    rdfs:comment 'Additional notes, comments, or observations recorded by the inspector. Captures contextual information not covered in structured fields.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionNumber rdf:type rdf:Property ;
    rdfs:label 'Inspection Number' ;
    rdfs:comment 'Business identifier for the inspection event, often a human-readable reference number used in field operations and regulatory reporting.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionPhotosAttachedFlag rdf:type rdf:Property ;
    rdfs:label 'Inspection Photos Attached Flag' ;
    rdfs:comment 'Boolean indicator of whether photographic documentation was captured and attached to this inspection record. True if photos attached, False otherwise.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:inspectionProgram rdf:type rdf:Property ;
    rdfs:label 'Inspection Program' ;
    rdfs:comment 'Name or code of the regulatory or internal inspection program under which this inspection was conducted (e.g., NERC Transmission Vegetation Management, PHMSA Integrity Management Program, PUC General Order 165 compliance).' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionResult rdf:type rdf:Property ;
    rdfs:label 'Inspection Result' ;
    rdfs:comment 'Overall outcome of the inspection (pass, fail, conditional, not applicable). High-level finding that determines whether corrective action is required.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionStartTime rdf:type rdf:Property ;
    rdfs:label 'Inspection Start Time' ;
    rdfs:comment 'Timestamp when the inspection activity began in the field. Used for labor tracking and compliance documentation.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:inspectionStatus rdf:type rdf:Property ;
    rdfs:label 'Inspection Status' ;
    rdfs:comment 'Current lifecycle status of the inspection record (scheduled, in progress, completed, cancelled, deferred). Tracks the inspection workflow state.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionType rdf:type rdf:Property ;
    rdfs:label 'Inspection Type' ;
    rdfs:comment 'Classification of the inspection method or technique used (aerial patrol, ground patrol, thermographic, ultrasonic, pipeline integrity, transformer oil analysis). Determines the inspection protocol and equipment used.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectorName rdf:type rdf:Property ;
    rdfs:label 'Inspector Name' ;
    rdfs:comment 'Full name of the inspector who performed the inspection. Captured for audit trail and regulatory reporting purposes.' ;
    rdfs:domain ind:InspectionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextInspectionDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Inspection Due Date' ;
    rdfs:comment 'Scheduled date for the next inspection of this asset based on inspection frequency requirements and current inspection findings. Used for preventive maintenance scheduling.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:weatherConditions rdf:type rdf:Property ;
    rdfs:label 'Weather Conditions' ;
    rdfs:comment 'Weather conditions at the time of inspection. Relevant for outdoor inspections where weather may affect inspection quality or asset condition assessment.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pmScheduleId rdf:type rdf:Property ;
    rdfs:label 'Pm Schedule Id' ;
    rdfs:comment 'Unique identifier for the preventive maintenance schedule record. Primary key.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PmSchedule .

ind:assetClassCode rdf:type rdf:Property ;
    rdfs:label 'Asset Class Code' ;
    rdfs:comment 'Code identifying the asset class (e.g., \'XFMR-DIST\', \'BREAKER-HV\', \'GAS-REGULATOR\') to which this PM schedule applies. Used when the schedule is applied to all assets of a given type rather than a specific asset.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autoGenerateWorkOrderFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Generate Work Order Flag' ;
    rdfs:comment 'Boolean flag indicating whether work orders should be automatically generated when the schedule triggers (True) or require manual creation (False).' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:effectiveEndDate rdf:type rdf:Property ;
    rdfs:label 'Effective End Date' ;
    rdfs:comment 'Date when this PM schedule expires or is retired. Null for schedules with no planned end date.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:effectiveStartDate rdf:type rdf:Property ;
    rdfs:label 'Effective Start Date' ;
    rdfs:comment 'Date when this PM schedule becomes active and begins generating work orders.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:estimatedDurationHours rdf:type rdf:Property ;
    rdfs:label 'Estimated Duration Hours' ;
    rdfs:comment 'Estimated duration in hours required to complete the preventive maintenance tasks. Used for work planning and resource scheduling.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedOutageDurationHours rdf:type rdf:Property ;
    rdfs:label 'Estimated Outage Duration Hours' ;
    rdfs:comment 'Estimated duration in hours that the asset will be out of service if an outage is required. Used for outage planning and customer impact assessment.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:frequencyInterval rdf:type rdf:Property ;
    rdfs:label 'Frequency Interval' ;
    rdfs:comment 'Numeric interval for the PM schedule frequency (e.g., 90 for 90 days, 10000 for 10,000 operating hours). Interpretation depends on frequency_type and frequency_unit.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:frequencyType rdf:type rdf:Property ;
    rdfs:label 'Frequency Type' ;
    rdfs:comment 'Type of frequency basis for the PM schedule. Calendar-based schedules trigger on time intervals (e.g., every 90 days). Meter-based schedules trigger on usage metrics (e.g., every 10,000 operating hours). Condition-based schedules trigger on asset condition thresholds. Event-based schedules trigger on specific operational events.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:frequencyUnit rdf:type rdf:Property ;
    rdfs:label 'Frequency Unit' ;
    rdfs:comment 'Unit of measure for the frequency interval (e.g., days, weeks, months, years for calendar-based; hours, cycles, starts for meter-based). [ENUM-REF-CANDIDATE: days|weeks|months|years|hours|cycles|starts — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gracePeriodDays rdf:type rdf:Property ;
    rdfs:label 'Grace Period Days' ;
    rdfs:comment 'Number of days after the next due date that the maintenance can be performed without being considered overdue. Provides scheduling flexibility while maintaining compliance.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastModifiedBy rdf:type rdf:Property ;
    rdfs:label 'Last Modified By' ;
    rdfs:comment 'User ID or name of the person who last modified this PM schedule record.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastPerformedDate rdf:type rdf:Property ;
    rdfs:label 'Last Performed Date' ;
    rdfs:comment 'Date when the preventive maintenance was last completed for this schedule. Used to calculate the next due date.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:leadTimeDays rdf:type rdf:Property ;
    rdfs:label 'Lead Time Days' ;
    rdfs:comment 'Number of days before the next due date that the work order should be generated. Allows time for planning, material procurement, and crew scheduling.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maintenanceTaskDescription rdf:type rdf:Property ;
    rdfs:label 'Maintenance Task Description' ;
    rdfs:comment 'Detailed description of the preventive maintenance tasks to be performed (e.g., \'Inspect breaker contacts, test trip mechanism, verify protective relay settings, perform oil dielectric test\').' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Due Date' ;
    rdfs:comment 'Calculated date when the next preventive maintenance is due based on the frequency interval and last performed date. Work orders are typically auto-generated when this date approaches.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:outageRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Outage Required Flag' ;
    rdfs:comment 'Boolean flag indicating whether the maintenance task requires taking the asset out of service (True) or can be performed while the asset is energized/in-service (False).' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pmPlanName rdf:type rdf:Property ;
    rdfs:label 'Pm Plan Name' ;
    rdfs:comment 'Descriptive name of the preventive maintenance plan (e.g., \'Quarterly Transformer Oil Analysis\', \'Annual Substation Breaker Inspection\').' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pmPlanNumber rdf:type rdf:Property ;
    rdfs:label 'Pm Plan Number' ;
    rdfs:comment 'Business identifier for the PM plan, typically assigned by the Enterprise Asset Management (EAM) system (Oracle WAM or IBM Maximo). Used for external reference and reporting.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priority rdf:type rdf:Property ;
    rdfs:label 'Priority' ;
    rdfs:comment 'Priority level for the preventive maintenance schedule. Critical schedules support Bulk Electric System (BES) assets and NERC compliance. High priority schedules support key distribution and transmission infrastructure. Medium and low priority schedules support general asset population.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiredCraft rdf:type rdf:Property ;
    rdfs:label 'Required Craft' ;
    rdfs:comment 'Craft or trade skill required to perform the maintenance (e.g., \'Electrician\', \'Lineman\', \'Instrument Technician\', \'Gas Technician\'). May reference a craft code from the EAM system.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiredCrewSize rdf:type rdf:Property ;
    rdfs:label 'Required Crew Size' ;
    rdfs:comment 'Number of personnel required to perform the maintenance task safely and efficiently.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:requiredMaterials rdf:type rdf:Property ;
    rdfs:label 'Required Materials' ;
    rdfs:comment 'List or description of materials, parts, and consumables required for the maintenance task (e.g., \'Transformer oil, oil filter, gaskets, contact cleaner\').' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:safetyRequirements rdf:type rdf:Property ;
    rdfs:label 'Safety Requirements' ;
    rdfs:comment 'Special safety requirements, permits, or precautions needed for the maintenance task (e.g., \'Confined space entry permit required\', \'High voltage switching procedure\', \'Gas detection required\').' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleStatus rdf:type rdf:Property ;
    rdfs:label 'Schedule Status' ;
    rdfs:comment 'Current lifecycle status of the PM schedule. Active schedules generate work orders on trigger. Suspended schedules are temporarily paused. Retired schedules are no longer in use. Pending schedules are awaiting activation.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seasonalRestriction rdf:type rdf:Property ;
    rdfs:label 'Seasonal Restriction' ;
    rdfs:comment 'Seasonal constraints on when the maintenance can be performed (e.g., \'Avoid peak summer months\', \'Winter only\', \'Spring/Fall preferred\'). Used for maintenance that requires outages during low-demand periods.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workLocationCode rdf:type rdf:Property ;
    rdfs:label 'Work Location Code' ;
    rdfs:comment 'Geographic or organizational location code where the maintenance will be performed. Used for crew dispatch and regional maintenance planning.' ;
    rdfs:domain ind:PmSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workOrderType rdf:type rdf:Property ;
    rdfs:label 'Work Order Type' ;
    rdfs:comment 'Type of work order to be generated when this PM schedule triggers (e.g., \'PM-INSPECTION\', \'PM-SERVICE\', \'PM-TESTING\'). Maps to work order type codes in the EAM system.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:createdBy rdf:type rdf:Property ;
    rdfs:label 'Created By' ;
    rdfs:comment 'User ID or name of the person who created this PM schedule record in the EAM system.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:warrantyId rdf:type rdf:Property ;
    rdfs:label 'Warranty Id' ;
    rdfs:comment 'Unique identifier for the warranty record. Primary key for the warranty product.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:capexProjectId rdf:type rdf:Property ;
    rdfs:label 'Capex Project Id' ;
    rdfs:comment 'Reference to the capital project under which the warranted asset was installed. Links warranty to Work in Progress (WIP) and Allowance for Funds Used During Construction (AFUDC) tracking for regulatory asset base reporting. Critical for rate case cost allocation.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CapexProject .

ind:installationWorkOrderId rdf:type rdf:Property ;
    rdfs:label 'Installation Work Order Id' ;
    rdfs:comment 'Reference to the work order that installed or commissioned the warranted asset. Links warranty to installation contractor and workmanship warranty terms. Used to trigger warranty claim workflows when failure events occur within warranty period.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WorkOrder .

ind:purchaseOrderId rdf:type rdf:Property ;
    rdfs:label 'Purchase Order Id' ;
    rdfs:comment 'Foreign key linking to supply.purchase_order. Business justification: Warranty validation requires linking to originating purchase order for cost verification, vendor accountability, and capital project cost tracking. Utilities must prove warranty coverage through procu' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PurchaseOrder .

ind:vendorId rdf:type rdf:Property ;
    rdfs:label 'Vendor Id' ;
    rdfs:comment 'Foreign key linking to supply.vendor. Business justification: Warranty claims, vendor performance tracking, and insurance certificate validation require formal vendor linkage. Utilities manage warranty providers as vendors for procurement compliance, payment pro' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:claimsApprovedAmount rdf:type rdf:Property ;
    rdfs:label 'Claims Approved Amount' ;
    rdfs:comment 'Total dollar value of warranty claims approved and paid by the warranty provider to date. Represents actual cost recovery achieved, reducing Operations and Maintenance (O&M) expenses charged to ratepayers. Critical for regulatory reporting and rate case cost justification. Expressed in USD.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:claimsDeniedAmount rdf:type rdf:Property ;
    rdfs:label 'Claims Denied Amount' ;
    rdfs:comment 'Total dollar value of warranty claims denied by the warranty provider to date. Denied claims result in costs being charged to utility O&M or CAPEX accounts. High denial rates may indicate warranty term violations, inadequate maintenance documentation, or disputes requiring escalation. Expressed in USD.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:claimsFiledCount rdf:type rdf:Property ;
    rdfs:label 'Claims Filed Count' ;
    rdfs:comment 'Total number of warranty claims filed against this warranty to date. Used to track warranty utilization, identify problematic assets or vendors, and support vendor performance scorecarding. High claim counts may indicate quality issues.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:claimsPendingAmount rdf:type rdf:Property ;
    rdfs:label 'Claims Pending Amount' ;
    rdfs:comment 'Total dollar value of warranty claims currently under review by the warranty provider. Represents potential cost recovery not yet realized. Used for financial forecasting and accrual accounting. Expressed in USD.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coverageScope rdf:type rdf:Property ;
    rdfs:label 'Coverage Scope' ;
    rdfs:comment 'Defines what costs are covered under the warranty. Parts only covers replacement component costs. Parts and labor includes installation and repair labor. Full replacement covers complete asset replacement if repair is not feasible. Performance guarantee covers operational shortfalls. On-site service includes field service technician dispatch.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageTermsSummary rdf:type rdf:Property ;
    rdfs:label 'Coverage Terms Summary' ;
    rdfs:comment 'High-level summary of warranty terms and conditions including coverage limitations, exclusions, maintenance requirements, and claim procedures. Full warranty document reference should be maintained in document management system.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deductibleAmount rdf:type rdf:Property ;
    rdfs:label 'Deductible Amount' ;
    rdfs:comment 'Dollar amount the utility must pay before warranty coverage applies to a claim. Common in extended service agreements and third-party warranty insurance. Zero for most manufacturer standard warranties. Expressed in USD.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:documentReference rdf:type rdf:Property ;
    rdfs:label 'Document Reference' ;
    rdfs:comment 'Reference identifier or URI to the full warranty certificate, agreement, or contract document stored in the enterprise document management system. Provides access to complete warranty terms, conditions, exclusions, and claim procedures.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:durationMonths rdf:type rdf:Property ;
    rdfs:label 'Duration Months' ;
    rdfs:comment 'Length of warranty coverage period expressed in months. Standard manufacturer warranties typically range from 12-60 months. Extended service agreements may provide coverage up to 120+ months. Used for warranty lifecycle planning and asset maintenance scheduling.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maintenanceRequirements rdf:type rdf:Property ;
    rdfs:label 'Maintenance Requirements' ;
    rdfs:comment 'Summary of preventive maintenance activities required to maintain warranty validity. Many manufacturer warranties require adherence to specified maintenance schedules and use of OEM parts. Failure to comply may void warranty coverage. Integrates with PM schedule and inspection record products.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maximumClaimValue rdf:type rdf:Property ;
    rdfs:label 'Maximum Claim Value' ;
    rdfs:comment 'Maximum dollar amount that can be claimed under this warranty over its lifetime. For capital equipment, this may equal or exceed the original asset cost. For performance guarantees, this represents the maximum penalty or credit amount. Expressed in USD.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:notes rdf:type rdf:Property ;
    rdfs:label 'Notes' ;
    rdfs:comment 'Free-form text field for additional warranty information, special conditions, claim history narrative, or vendor negotiation details. Used by asset management and procurement teams for warranty administration and vendor relationship management.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proratedFlag rdf:type rdf:Property ;
    rdfs:label 'Prorated Flag' ;
    rdfs:comment 'Indicates whether warranty coverage value decreases over time on a prorated basis. True if claim reimbursement is reduced based on asset age or usage. False if full coverage applies throughout warranty period. Common in extended warranties for high-value generation equipment.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:startDate rdf:type rdf:Property ;
    rdfs:label 'Start Date' ;
    rdfs:comment 'Date when warranty coverage becomes effective. Typically the asset in-service date or substantial completion date for capital projects. Used to calculate warranty expiration and claim eligibility windows.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:transferableFlag rdf:type rdf:Property ;
    rdfs:label 'Transferable Flag' ;
    rdfs:comment 'Indicates whether warranty coverage transfers if the asset is relocated, sold, or reassigned to a different facility or service territory. True if warranty remains valid after transfer. False if warranty is void upon asset transfer. Important for asset lifecycle management and divestiture transactions.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:warrantyNumber rdf:type rdf:Property ;
    rdfs:label 'Warranty Number' ;
    rdfs:comment 'Externally-known unique warranty certificate or agreement number issued by the manufacturer, contractor, or warranty provider. Used for warranty claim filing and tracking.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:warrantyStatus rdf:type rdf:Property ;
    rdfs:label 'Warranty Status' ;
    rdfs:comment 'Current lifecycle status of the warranty. Active indicates warranty is in force and claims can be filed. Expired indicates warranty period has ended. Claimed indicates a claim has been filed. Voided indicates warranty has been invalidated due to misuse or breach of terms. Supports warranty cost recovery workflows.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:warrantyType rdf:type rdf:Property ;
    rdfs:label 'Warranty Type' ;
    rdfs:comment 'Classification of the warranty coverage type. Manufacturer equipment warranty covers defects in materials and workmanship from OEM. Contractor workmanship warranty covers installation quality. Extended service agreement provides post-standard warranty coverage. Performance guarantee ensures asset meets specified operational parameters.' ;
    rdfs:domain ind:Warranty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workOrderId rdf:type rdf:Property ;
    rdfs:label 'Work Order Id' ;
    rdfs:comment 'Unique identifier for the work order. Primary key for the work order entity.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WorkOrder .

ind:generatingUnitId rdf:type rdf:Property ;
    rdfs:label 'Generating Unit Id' ;
    rdfs:comment 'FK to generation.generating_unit.generating_unit_id — Links maintenance work orders to specific generation assets — required for generation unit availability tracking, NERC GADS reporting, and maintenance cost allocation to generating units.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GeneratingUnit .

ind:actualFinishTimestamp rdf:type rdf:Property ;
    rdfs:label 'Actual Finish Timestamp' ;
    rdfs:comment 'Actual date and time when work was completed, captured from crew check-out or mobile work management system. Used for cycle time analysis and reliability reporting.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:actualLaborHours rdf:type rdf:Property ;
    rdfs:label 'Actual Labor Hours' ;
    rdfs:comment 'Total labor hours actually expended on the work order, captured from crew time sheets and used for cost accounting and productivity analysis.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualMaterialCost rdf:type rdf:Property ;
    rdfs:label 'Actual Material Cost' ;
    rdfs:comment 'Actual cost of materials, parts, and supplies consumed during work order execution, expressed in USD. Captured from inventory withdrawals and purchase orders.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Actual Start Timestamp' ;
    rdfs:comment 'Actual date and time when work commenced, captured from crew check-in or mobile work management system. Used for performance measurement and outage duration calculation.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:actualTotalCost rdf:type rdf:Property ;
    rdfs:label 'Actual Total Cost' ;
    rdfs:comment 'Total actual cost incurred for the work order including all labor, materials, equipment, and overhead charges, expressed in USD. Used for financial reporting and rate case cost substantiation.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:afudcEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Afudc Eligible Flag' ;
    rdfs:comment 'Boolean indicator (True/False) specifying whether the work order costs are eligible for AFUDC capitalization under FERC accounting rules. True indicates AFUDC-eligible capital work; False indicates non-eligible work.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:approvedBy rdf:type rdf:Property ;
    rdfs:label 'Approved By' ;
    rdfs:comment 'User ID or name of the supervisor, manager, or authorized approver who approved the work order for execution. Used for authorization audit trail and compliance verification.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Approved Timestamp' ;
    rdfs:comment 'Date and time when the work order was approved for execution. Used for workflow tracking and authorization audit.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:closedBy rdf:type rdf:Property ;
    rdfs:label 'Closed By' ;
    rdfs:comment 'User ID or name of the individual who closed the work order after verifying completion and approving final costs. Used for accountability and audit trail.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Closed Timestamp' ;
    rdfs:comment 'Date and time when the work order was formally closed and finalized. Used for cycle time measurement and financial period cutoff.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:completionNotes rdf:type rdf:Property ;
    rdfs:label 'Completion Notes' ;
    rdfs:comment 'Free-text field capturing crew observations, work performed, issues encountered, follow-up actions required, and any deviations from the original work plan. Used for knowledge capture and continuous improvement.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costClassification rdf:type rdf:Property ;
    rdfs:label 'Cost Classification' ;
    rdfs:comment 'Accounting classification of the work order cost: OPEX (Operating Expenditure) for routine maintenance and repairs expensed in the current period, or CAPEX (Capital Expenditure) for asset improvements capitalized and depreciated over time. Critical for regulatory rate case reporting and financial statement preparation.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:craftTradeRequired rdf:type rdf:Property ;
    rdfs:label 'Craft Trade Required' ;
    rdfs:comment 'Skilled trade or craft discipline required to perform the work, such as electrician, lineman, mechanic, welder, or instrumentation technician. Used for crew assignment and labor planning.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crewAssignment rdf:type rdf:Property ;
    rdfs:label 'Crew Assignment' ;
    rdfs:comment 'Identifier or name of the crew, team, or individual worker assigned to perform the work order. May reference a crew ID from the workforce management system.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedLaborHours rdf:type rdf:Property ;
    rdfs:label 'Estimated Labor Hours' ;
    rdfs:comment 'Planned total labor hours required to complete the work order, used for resource scheduling and cost estimation.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedMaterialCost rdf:type rdf:Property ;
    rdfs:label 'Estimated Material Cost' ;
    rdfs:comment 'Planned cost of materials, parts, and supplies required for the work order, expressed in USD. Used for budgeting and procurement planning.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedTotalCost rdf:type rdf:Property ;
    rdfs:label 'Estimated Total Cost' ;
    rdfs:comment 'Total planned cost for the work order including labor, materials, equipment, and overhead, expressed in USD. Used for budget authorization and variance analysis.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:failureCode rdf:type rdf:Property ;
    rdfs:label 'Failure Code' ;
    rdfs:comment 'Standardized code identifying the type of failure or defect that triggered the work order (for corrective and emergency work). Used for failure mode analysis, reliability engineering, and predictive maintenance modeling.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:safetyPermitReference rdf:type rdf:Property ;
    rdfs:label 'Safety Permit Reference' ;
    rdfs:comment 'Reference number or identifier for any safety permits, hot work permits, confined space permits, or switching orders required for the work. Ensures compliance with OSHA and internal safety protocols.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduledFinishDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Finish Date' ;
    rdfs:comment 'Planned date when work is scheduled to be completed. Used for resource planning and commitment tracking.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:scheduledStartDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Start Date' ;
    rdfs:comment 'Planned date when work is scheduled to begin. Used for crew scheduling, outage coordination, and customer notification.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:workOrderDescription rdf:type rdf:Property ;
    rdfs:label 'Work Order Description' ;
    rdfs:comment 'Detailed narrative description of the work to be performed, including scope, objectives, and any special instructions or safety considerations.' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Work Order Number' ;
    rdfs:comment 'Externally visible business identifier for the work order, typically generated by the EAM system (Oracle WAM / IBM Maximo). Used for tracking, reporting, and communication with field crews and regulatory bodies.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workOrderStatus rdf:type rdf:Property ;
    rdfs:label 'Work Order Status' ;
    rdfs:comment 'Current lifecycle state of the work order: created (initial entry), planned (resources allocated), scheduled (date/time assigned), in-progress (crew actively working), completed (work finished, pending review), closed (finalized and approved), or cancelled (work not performed). [ENUM-REF-CANDIDATE: created|planned|scheduled|in_progress|completed|closed|cancelled — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:WorkOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workOrderMaterialId rdf:type rdf:Property ;
    rdfs:label 'Work Order Material Id' ;
    rdfs:comment 'Unique identifier for the work order material line item. Primary key for this transactional record of material consumption against a maintenance or capital work order.' ;
    rdfs:domain ind:WorkOrderMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:materialMasterId rdf:type rdf:Property ;
    rdfs:label 'Material Master Id' ;
    rdfs:comment 'Foreign key linking to supply.material_master. Business justification: Work order material consumption requires proper material master linkage for inventory management, MRP planning, cost rollup to work orders, and regulatory reporting of O&M vs capital material usage. M' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MaterialMaster .

ind:costCenter rdf:type rdf:Property ;
    rdfs:label 'Cost Center' ;
    rdfs:comment 'Cost center or organizational unit responsible for this material expense. Used for departmental cost allocation and budget tracking across generation, transmission, distribution, and gas operations.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costType rdf:type rdf:Property ;
    rdfs:label 'Cost Type' ;
    rdfs:comment 'Accounting classification of material cost as either OPEX (Operating Expenditure for maintenance and repairs) or CAPEX (Capital Expenditure for asset improvements and additions). Critical for regulatory rate case cost allocation and financial reporting.' ;
    rdfs:domain ind:WorkOrderMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criticalSpareFlag rdf:type rdf:Property ;
    rdfs:label 'Critical Spare Flag' ;
    rdfs:comment 'Boolean indicator identifying whether this material is classified as a critical spare part. Critical spares are high-value, long-lead-time components essential for maintaining system reliability (e.g., transformer spare parts, large circuit breakers). Used for inventory depletion alerts and strategic spare management.' ;
    rdfs:domain ind:WorkOrderMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:currencyCode rdf:type rdf:Property ;
    rdfs:label 'Currency Code' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for material cost. Typically USD for U.S. utility operations.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:glAccountCode rdf:type rdf:Property ;
    rdfs:label 'Gl Account Code' ;
    rdfs:comment 'General ledger account code to which this material cost is charged. Maps material expense to the appropriate financial account structure for regulatory reporting and internal cost management.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hazmatFlag rdf:type rdf:Property ;
    rdfs:label 'Hazmat Flag' ;
    rdfs:comment 'Boolean indicator identifying whether this material is classified as hazardous (e.g., SF6 gas, PCB-containing oil, asbestos, lead-acid batteries). Triggers special handling, storage, and disposal requirements per EPA and OSHA regulations.' ;
    rdfs:domain ind:WorkOrderMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:issueDate rdf:type rdf:Property ;
    rdfs:label 'Issue Date' ;
    rdfs:comment 'Date when the material was issued from storeroom inventory to the work order. Marks the point at which inventory is decremented and material cost is allocated to the work order.' ;
    rdfs:domain ind:WorkOrderMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:issuedBy rdf:type rdf:Property ;
    rdfs:label 'Issued By' ;
    rdfs:comment 'Name or employee identifier of the storeroom clerk or system user who issued the material to the work order. Supports accountability and audit trail for inventory transactions.' ;
    rdfs:domain ind:WorkOrderMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lineNumber rdf:type rdf:Property ;
    rdfs:label 'Line Number' ;
    rdfs:comment 'Sequential line number of this material item within the parent work order. Used for ordering and referencing specific material lines in work order documentation.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lotNumber rdf:type rdf:Property ;
    rdfs:label 'Lot Number' ;
    rdfs:comment 'Manufacturer lot or batch number for traceable materials and components. Critical for quality control, warranty tracking, and recall management for items such as transformer oil, SF6 gas, cables, and critical spare parts.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:materialSource rdf:type rdf:Property ;
    rdfs:label 'Material Source' ;
    rdfs:comment 'Source from which the material was obtained for the work order. Values include storeroom_issue (issued from utility inventory), direct_purchase (procured directly for this work order), contractor_supplied (provided by contractor), emergency_procurement (expedited purchase), customer_provided (supplied by customer).' ;
    rdfs:domain ind:WorkOrderMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:materialStatus rdf:type rdf:Property ;
    rdfs:label 'Material Status' ;
    rdfs:comment 'Current lifecycle status of this material line item. Values include requested (material need identified), reserved (allocated from inventory), issued (released to work order), consumed (used in work execution), returned (unused material returned to stock), cancelled (request voided).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:purchaseOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Purchase Order Number' ;
    rdfs:comment 'Purchase order number associated with direct material procurement for this work order. Links material transaction to procurement and accounts payable processes. Null for storeroom-issued materials.' ;
    rdfs:domain ind:WorkOrderMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quantityConsumed rdf:type rdf:Property ;
    rdfs:label 'Quantity Consumed' ;
    rdfs:comment 'Actual quantity of material consumed or installed during work order execution. Represents the final material usage after accounting for any returns or adjustments.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:quantityIssued rdf:type rdf:Property ;
    rdfs:label 'Quantity Issued' ;
    rdfs:comment 'Actual quantity of material issued from storeroom inventory to the work order. May differ from quantity requested due to availability constraints or revised work scope.' ;
    rdfs:domain ind:WorkOrderMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:quantityRequested rdf:type rdf:Property ;
    rdfs:label 'Quantity Requested' ;
    rdfs:comment 'Quantity of material originally requested by the work planner or technician for the work order. Represents the planned material requirement before actual issue.' ;
    rdfs:domain ind:WorkOrderMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:quantityReturned rdf:type rdf:Property ;
    rdfs:label 'Quantity Returned' ;
    rdfs:comment 'Quantity of material returned to storeroom inventory after work order completion. Represents unused material that was issued but not consumed during the work activity.' ;
    rdfs:domain ind:WorkOrderMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:receivedBy rdf:type rdf:Property ;
    rdfs:label 'Received By' ;
    rdfs:comment 'Name or employee identifier of the technician or crew member who received the material for work order execution. Confirms material custody transfer from storeroom to field operations.' ;
    rdfs:domain ind:WorkOrderMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordCreatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Record Created Timestamp' ;
    rdfs:comment 'Timestamp when this work order material record was first created in the EAM or ERP system. Supports audit trail and data lineage tracking for material transaction history.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:recordUpdatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Record Updated Timestamp' ;
    rdfs:comment 'Timestamp when this work order material record was last modified in the EAM or ERP system. Tracks changes to material quantities, costs, or status throughout the work order lifecycle.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:returnDate rdf:type rdf:Property ;
    rdfs:label 'Return Date' ;
    rdfs:comment 'Date when unused material was returned to storeroom inventory after work order completion. Null if no material was returned. Used for inventory reconciliation and cost adjustment.' ;
    rdfs:domain ind:WorkOrderMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:storeroomLocation rdf:type rdf:Property ;
    rdfs:label 'Storeroom Location' ;
    rdfs:comment 'Physical storeroom, warehouse, or inventory location code from which the material was issued. Used for inventory tracking and replenishment planning across distributed storeroom network.' ;
    rdfs:domain ind:WorkOrderMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalMaterialCost rdf:type rdf:Property ;
    rdfs:label 'Total Material Cost' ;
    rdfs:comment 'Total cost of material consumed for this line item, calculated as quantity consumed multiplied by unit cost. Aggregates to work order total material cost for O&M expense tracking and rate case substantiation.' ;
    rdfs:domain ind:WorkOrderMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transactionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Transaction Timestamp' ;
    rdfs:comment 'Precise timestamp when this material transaction was recorded in the EAM or ERP system. Represents the business event time for material issue, consumption, or return activity.' ;
    rdfs:domain ind:WorkOrderMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:unitCost rdf:type rdf:Property ;
    rdfs:label 'Unit Cost' ;
    rdfs:comment 'Cost per unit of measure for the material at the time of issue. Used to calculate total material cost for the work order and supports OPEX/CAPEX cost tracking for regulatory reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unitOfMeasure rdf:type rdf:Property ;
    rdfs:label 'Unit Of Measure' ;
    rdfs:comment 'Standard unit of measure for material quantity tracking. Common values include EA (each), FT (feet), GAL (gallons), LB (pounds), KG (kilograms), M (meters), L (liters), BOX, ROLL, DRUM, CYLINDER, SET. [ENUM-REF-CANDIDATE: EA|FT|GAL|LB|KG|M|L|BOX|ROLL|DRUM|CYLINDER|SET — 12 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorName rdf:type rdf:Property ;
    rdfs:label 'Vendor Name' ;
    rdfs:comment 'Name of the vendor or supplier from whom the material was procured. Applicable for direct purchase and emergency procurement transactions. Null for storeroom-issued materials.' ;
    rdfs:domain ind:WorkOrderMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:warrantyFlag rdf:type rdf:Property ;
    rdfs:label 'Warranty Flag' ;
    rdfs:comment 'Boolean indicator identifying whether this material or component is covered under manufacturer or vendor warranty. Used for warranty claim tracking and cost recovery from suppliers for defective parts.' ;
    rdfs:domain ind:WorkOrderMaterial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:billCycleId rdf:type rdf:Property ;
    rdfs:label 'Bill Cycle Id' ;
    rdfs:comment 'Unique identifier for the billing cycle schedule. Primary key for the bill cycle entity.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BillCycle .

ind:supersededByBillCycleId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Bill Cycle Id' ;
    rdfs:comment 'Reference to the billing cycle that replaced this cycle when it was retired or restructured. Null for active cycles. Supports historical lineage tracking.' ;
    rdfs:domain ind:BillCycle ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BillCycle .

ind:tariffScheduleId rdf:type rdf:Property ;
    rdfs:label 'Tariff Schedule Id' ;
    rdfs:comment 'Foreign key linking to regulatory.tariff_schedule. Business justification: Bill cycles are defined in approved tariff schedules with specific meter reading timelines, billing frequencies, and due date rules. Real business process: tariff-mandated billing cycle administration' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TariffSchedule .

ind:autoPayEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Pay Eligible Flag' ;
    rdfs:comment 'Indicates whether accounts in this cycle are eligible for automatic payment enrollment. May be restricted for certain customer classes or cycle types.' ;
    rdfs:domain ind:BillCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:billDate rdf:type rdf:Property ;
    rdfs:label 'Bill Date' ;
    rdfs:comment 'Target day of the month (1-31) when invoices for this cycle are generated and dated. Used for revenue recognition and aging calculations.' ;
    rdfs:domain ind:BillCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:billGenerationOffsetDays rdf:type rdf:Property ;
    rdfs:label 'Bill Generation Offset Days' ;
    rdfs:comment 'Number of days after meter read completion when bill calculation and invoice generation runs are scheduled. Allows time for data validation and rate application.' ;
    rdfs:domain ind:BillCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:budgetBillingEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Budget Billing Eligible Flag' ;
    rdfs:comment 'Indicates whether accounts in this cycle are eligible for budget billing programs, which spread annual costs evenly across monthly payments.' ;
    rdfs:domain ind:BillCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commodityType rdf:type rdf:Property ;
    rdfs:label 'Commodity Type' ;
    rdfs:comment 'Type of utility service covered by this billing cycle: electric, gas, or dual (combined electric and gas).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerClass rdf:type rdf:Property ;
    rdfs:label 'Customer Class' ;
    rdfs:comment 'Customer class or segment served by this billing cycle. Determines rate schedule eligibility and billing complexity.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cycleCode rdf:type rdf:Property ;
    rdfs:label 'Cycle Code' ;
    rdfs:comment 'Short alphanumeric code uniquely identifying the billing cycle within the billing system. Used as the business identifier for cycle assignment and batch scheduling.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cycleDescription rdf:type rdf:Property ;
    rdfs:label 'Cycle Description' ;
    rdfs:comment 'Detailed description of the billing cycle purpose, coverage area, and operational notes. May include territory, route grouping, or special handling instructions.' ;
    rdfs:domain ind:BillCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cycleFrequency rdf:type rdf:Property ;
    rdfs:label 'Cycle Frequency' ;
    rdfs:comment 'Frequency at which accounts in this cycle are billed. Monthly is standard for residential; bi-monthly, quarterly, or special cycles may apply to large Commercial and Industrial (C&I) accounts.' ;
    rdfs:domain ind:BillCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cycleName rdf:type rdf:Property ;
    rdfs:label 'Cycle Name' ;
    rdfs:comment 'Human-readable descriptive name of the billing cycle, such as \'Monthly Residential Cycle 01\' or \'Bi-Monthly Commercial Cycle A\'.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cycleStatus rdf:type rdf:Property ;
    rdfs:label 'Cycle Status' ;
    rdfs:comment 'Current operational status of the billing cycle. Active cycles are used for new account assignments and ongoing billing operations. Inactive cycles are retained for historical reference.' ;
    rdfs:domain ind:BillCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedAccountCount rdf:type rdf:Property ;
    rdfs:label 'Estimated Account Count' ;
    rdfs:comment 'Approximate number of customer accounts assigned to this billing cycle. Used for capacity planning, batch sizing, and workload balancing across cycles.' ;
    rdfs:domain ind:BillCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:estimatedBillingFlag rdf:type rdf:Property ;
    rdfs:label 'Estimated Billing Flag' ;
    rdfs:comment 'Indicates whether estimated billing is permitted for accounts in this cycle when actual meter reads are unavailable. Subject to regulatory limits on consecutive estimated bills.' ;
    rdfs:domain ind:BillCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:meterReadEndDay rdf:type rdf:Property ;
    rdfs:label 'Meter Read End Day' ;
    rdfs:comment 'Day of the month (1-31) when the meter reading window closes for accounts in this cycle. All meter reads must be completed by this day to support timely bill generation.' ;
    rdfs:domain ind:BillCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:meterReadStartDay rdf:type rdf:Property ;
    rdfs:label 'Meter Read Start Day' ;
    rdfs:comment 'Day of the month (1-31) when the meter reading window opens for accounts in this cycle. Drives Advanced Metering Infrastructure (AMI) or Automated Meter Reading (AMR) batch scheduling.' ;
    rdfs:domain ind:BillCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:paperlessBillingEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Paperless Billing Eligible Flag' ;
    rdfs:comment 'Indicates whether accounts in this cycle are eligible for paperless billing and electronic invoice delivery. Supports cost reduction and environmental initiatives.' ;
    rdfs:domain ind:BillCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentDueDay rdf:type rdf:Property ;
    rdfs:label 'Payment Due Day' ;
    rdfs:comment 'Target day of the month (1-31) when payment is due for invoices in this cycle. Calculated as bill_date plus payment_due_offset_days.' ;
    rdfs:domain ind:BillCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:paymentDueOffsetDays rdf:type rdf:Property ;
    rdfs:label 'Payment Due Offset Days' ;
    rdfs:comment 'Number of days after bill date when payment is due. Typically 15-30 days for residential accounts; may vary by customer class and regulatory requirements.' ;
    rdfs:domain ind:BillCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:regulatoryApprovalReference rdf:type rdf:Property ;
    rdfs:label 'Regulatory Approval Reference' ;
    rdfs:comment 'Reference to the Public Utility Commission (PUC) docket, order, or tariff filing that approved this billing cycle configuration. Required for regulatory compliance and audit.' ;
    rdfs:domain ind:BillCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:routeGrouping rdf:type rdf:Property ;
    rdfs:label 'Route Grouping' ;
    rdfs:comment 'Meter reading route or grouping identifier used to organize field meter readers or AMI collection schedules. May represent physical routes or logical batches.' ;
    rdfs:domain ind:BillCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialHandlingFlag rdf:type rdf:Property ;
    rdfs:label 'Special Handling Flag' ;
    rdfs:comment 'Indicates whether this cycle requires special processing, such as manual review, custom rate application, or non-standard billing rules. True for large C&I or wholesale accounts.' ;
    rdfs:domain ind:BillCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tariffBookReference rdf:type rdf:Property ;
    rdfs:label 'Tariff Book Reference' ;
    rdfs:comment 'Reference to the section of the utility tariff book that governs billing cycle assignment and payment terms for this cycle. Used for regulatory compliance and customer dispute resolution.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:territoryCode rdf:type rdf:Property ;
    rdfs:label 'Territory Code' ;
    rdfs:comment 'Geographic territory or service area code associated with this billing cycle. Aligns with Geographic Information System (GIS) boundaries and operational districts.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:versionNumber rdf:type rdf:Property ;
    rdfs:label 'Version Number' ;
    rdfs:comment 'Version number of this billing cycle configuration. Incremented when cycle parameters are modified. Supports change tracking and regulatory audit.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billDisputeId rdf:type rdf:Property ;
    rdfs:label 'Bill Dispute Id' ;
    rdfs:comment 'Unique identifier for the bill dispute record. Primary key for the bill dispute entity.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BillDispute .

ind:billingRateScheduleId rdf:type rdf:Property ;
    rdfs:label 'Billing Rate Schedule Id' ;
    rdfs:comment 'Tariff rate schedule code applied to the disputed bill. Used to verify correct rate application and identify rate misapplication disputes.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RateSchedule .

ind:docketId rdf:type rdf:Property ;
    rdfs:label 'Docket Id' ;
    rdfs:comment 'Foreign key linking to regulatory.docket. Business justification: Bill disputes escalated to PUC become formal docket proceedings. Real business process: customer complaint escalation to regulatory commission. The existing puc_complaint_number field signals this rel' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Docket .

ind:invoiceId rdf:type rdf:Property ;
    rdfs:label 'Invoice Id' ;
    rdfs:comment 'Reference to the specific invoice or bill being disputed. Links to the bill master record.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Invoice .

ind:invoiceLineId rdf:type rdf:Property ;
    rdfs:label 'Invoice Line Id' ;
    rdfs:comment 'Foreign key linking to billing.invoice_line. Business justification: Customer disputes are often about specific line-item charges (e.g., disputing a demand charge calculation or a regulatory rider amount), not the entire invoice. Adding this FK allows precise tracking ' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InvoiceLine .

ind:adjustmentReasonCode rdf:type rdf:Property ;
    rdfs:label 'Adjustment Reason Code' ;
    rdfs:comment 'Standardized code identifying the specific reason for any billing adjustment or credit issued. Required for financial audit and regulatory reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignedAnalystCode rdf:type rdf:Property ;
    rdfs:label 'Assigned Analyst Code' ;
    rdfs:comment 'Reference to the customer service analyst or dispute resolution specialist assigned to investigate and resolve this case.' ;
    rdfs:domain ind:BillDispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assignedDepartment rdf:type rdf:Property ;
    rdfs:label 'Assigned Department' ;
    rdfs:comment 'Department or functional area responsible for investigating and resolving the dispute. Determines escalation path and subject matter expertise.' ;
    rdfs:domain ind:BillDispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Billing Period End Date' ;
    rdfs:comment 'End date of the billing period for the disputed bill. Defines the service period under dispute.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:billingPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Billing Period Start Date' ;
    rdfs:comment 'Start date of the billing period for the disputed bill. Defines the service period under dispute.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:closedDate rdf:type rdf:Property ;
    rdfs:label 'Closed Date' ;
    rdfs:comment 'Date when the dispute case was formally closed in the system after resolution and all follow-up actions were completed.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:creditAmount rdf:type rdf:Property ;
    rdfs:label 'Credit Amount' ;
    rdfs:comment 'Dollar amount of credit issued to the customer account as part of the dispute resolution. Zero if no credit was granted.' ;
    rdfs:domain ind:BillDispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:customerContactEmail rdf:type rdf:Property ;
    rdfs:label 'Customer Contact Email' ;
    rdfs:comment 'Email address for the customer contact regarding this dispute. Used for written communication and resolution documentation.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerContactName rdf:type rdf:Property ;
    rdfs:label 'Customer Contact Name' ;
    rdfs:comment 'Name of the customer or authorized representative who initiated the dispute. May differ from the account holder name.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerContactPhone rdf:type rdf:Property ;
    rdfs:label 'Customer Contact Phone' ;
    rdfs:comment 'Primary phone number for the customer contact regarding this dispute. Used for follow-up communication and resolution coordination.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerSatisfactionRating rdf:type rdf:Property ;
    rdfs:label 'Customer Satisfaction Rating' ;
    rdfs:comment 'Post-resolution customer satisfaction score on a scale of 1 to 5. Used for service quality monitoring and process improvement.' ;
    rdfs:domain ind:BillDispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:disputeDescription rdf:type rdf:Property ;
    rdfs:label 'Dispute Description' ;
    rdfs:comment 'Detailed narrative description of the customer complaint and the specific issues being disputed. Captures customer-provided context and concerns.' ;
    rdfs:domain ind:BillDispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disputeNumber rdf:type rdf:Property ;
    rdfs:label 'Dispute Number' ;
    rdfs:comment 'Externally visible unique business identifier for the dispute case. Used for customer communication and case tracking across systems.' ;
    rdfs:domain ind:BillDispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disputeOpenDate rdf:type rdf:Property ;
    rdfs:label 'Dispute Open Date' ;
    rdfs:comment 'Date when the dispute was formally opened in the system. Marks the start of the SLA clock for regulatory compliance tracking.' ;
    rdfs:domain ind:BillDispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:disputeOpenTimestamp rdf:type rdf:Property ;
    rdfs:label 'Dispute Open Timestamp' ;
    rdfs:comment 'Precise date and time when the dispute case was created in the system. Used for detailed SLA tracking and audit trails.' ;
    rdfs:domain ind:BillDispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:disputeReasonCode rdf:type rdf:Property ;
    rdfs:label 'Dispute Reason Code' ;
    rdfs:comment 'Standardized code categorizing the specific reason for the dispute. Used for root cause analysis and process improvement tracking.' ;
    rdfs:domain ind:BillDispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disputeStatus rdf:type rdf:Property ;
    rdfs:label 'Dispute Status' ;
    rdfs:comment 'Current lifecycle status of the dispute case. Tracks progression through investigation, resolution, and closure workflows. [ENUM-REF-CANDIDATE: open|under_investigation|pending_customer_response|pending_meter_test|resolved|closed|escalated — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:BillDispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disputeType rdf:type rdf:Property ;
    rdfs:label 'Dispute Type' ;
    rdfs:comment 'Classification of the dispute based on the nature of the customer complaint. Determines routing, investigation procedures, and resolution workflows. [ENUM-REF-CANDIDATE: billing_error|rate_misapplication|estimated_read|meter_malfunction|high_bill_complaint|unauthorized_charge|regulatory_complaint — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:BillDispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disputedAmount rdf:type rdf:Property ;
    rdfs:label 'Disputed Amount' ;
    rdfs:comment 'Total dollar amount being disputed by the customer. May represent full bill amount or specific line item charges.' ;
    rdfs:domain ind:BillDispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disputedKwh rdf:type rdf:Property ;
    rdfs:label 'Disputed Kwh' ;
    rdfs:comment 'Quantity of electric energy consumption in kilowatt-hours being disputed. Applicable for electric service disputes involving usage discrepancies.' ;
    rdfs:domain ind:BillDispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disputedMcf rdf:type rdf:Property ;
    rdfs:label 'Disputed Mcf' ;
    rdfs:comment 'Quantity of natural gas consumption in thousand cubic feet being disputed. Applicable for gas service disputes involving usage discrepancies.' ;
    rdfs:domain ind:BillDispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:escalationDate rdf:type rdf:Property ;
    rdfs:label 'Escalation Date' ;
    rdfs:comment 'Date when the dispute was escalated to a higher tier or specialized team. Used for tracking escalation patterns and resolution complexity.' ;
    rdfs:domain ind:BillDispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:escalationLevel rdf:type rdf:Property ;
    rdfs:label 'Escalation Level' ;
    rdfs:comment 'Current escalation tier of the dispute case. Indicates the level of management or specialized expertise involved in resolution.' ;
    rdfs:domain ind:BillDispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investigationNotes rdf:type rdf:Property ;
    rdfs:label 'Investigation Notes' ;
    rdfs:comment 'Detailed internal notes documenting the investigation process, findings, evidence reviewed, and decision rationale. Used for audit trail and knowledge management.' ;
    rdfs:domain ind:BillDispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meterReadType rdf:type rdf:Property ;
    rdfs:label 'Meter Read Type' ;
    rdfs:comment 'Method used to obtain the meter reading for the disputed billing period. Critical for estimated read disputes and meter malfunction investigations.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pucComplaintFlag rdf:type rdf:Property ;
    rdfs:label 'Puc Complaint Flag' ;
    rdfs:comment 'Indicator whether this dispute was escalated to or originated from a formal complaint filed with the state Public Utility Commission. Triggers enhanced regulatory reporting and tracking requirements.' ;
    rdfs:domain ind:BillDispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pucComplaintNumber rdf:type rdf:Property ;
    rdfs:label 'Puc Complaint Number' ;
    rdfs:comment 'Official complaint case number assigned by the state Public Utility Commission if the dispute was escalated to regulatory level. Used for regulatory correspondence and reporting.' ;
    rdfs:domain ind:BillDispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolutionDate rdf:type rdf:Property ;
    rdfs:label 'Resolution Date' ;
    rdfs:comment 'Date when the dispute was formally resolved and a final determination was communicated to the customer. Marks the end of the SLA clock.' ;
    rdfs:domain ind:BillDispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:resolutionDescription rdf:type rdf:Property ;
    rdfs:label 'Resolution Description' ;
    rdfs:comment 'Detailed narrative explanation of the investigation findings and the rationale for the resolution decision. Provides audit trail and customer communication content.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolutionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Resolution Timestamp' ;
    rdfs:comment 'Precise date and time when the dispute resolution was finalized in the system. Used for detailed SLA compliance reporting.' ;
    rdfs:domain ind:BillDispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:resolutionType rdf:type rdf:Property ;
    rdfs:label 'Resolution Type' ;
    rdfs:comment 'Classification of the final resolution action taken to close the dispute. Determines financial adjustments and follow-up actions required. [ENUM-REF-CANDIDATE: credit_issued|bill_upheld|rate_correction|re_read_ordered|meter_test_ordered|payment_plan_offered|partial_credit|no_action — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:BillDispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceType rdf:type rdf:Property ;
    rdfs:label 'Service Type' ;
    rdfs:comment 'Type of utility service associated with the disputed bill. Determines applicable rate schedules, regulatory requirements, and investigation procedures.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaActualDays rdf:type rdf:Property ;
    rdfs:label 'Sla Actual Days' ;
    rdfs:comment 'Actual number of calendar days elapsed from dispute open date to resolution date. Used for SLA compliance tracking and performance reporting.' ;
    rdfs:domain ind:BillDispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:slaComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Sla Compliance Flag' ;
    rdfs:comment 'Indicator whether the dispute was resolved within the target SLA timeframe. Used for regulatory reporting and internal performance management.' ;
    rdfs:domain ind:BillDispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:slaTargetDays rdf:type rdf:Property ;
    rdfs:label 'Sla Target Days' ;
    rdfs:comment 'Number of calendar days allowed for dispute resolution per regulatory or internal service level agreement. Varies by dispute type and jurisdiction.' ;
    rdfs:domain ind:BillDispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:billingServiceAgreementId rdf:type rdf:Property ;
    rdfs:label 'Billing Service Agreement Id' ;
    rdfs:comment 'Unique identifier for the billing service agreement. Primary key for this entity.' ;
    rdfs:domain ind:BillingServiceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:partyId rdf:type rdf:Property ;
    rdfs:label 'Party Id' ;
    rdfs:comment 'Identifier of the customer party to this service agreement. Links to the customer master entity.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:paymentArrangementId rdf:type rdf:Property ;
    rdfs:label 'Payment Arrangement Id' ;
    rdfs:comment 'Identifier of the active payment arrangement or installment plan for past-due balances. Null if no arrangement in place.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PaymentArrangement .

ind:servicePointId rdf:type rdf:Property ;
    rdfs:label 'Service Point Id' ;
    rdfs:comment 'Identifier of the physical service point (meter location) where electric or gas service is delivered under this agreement.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ServicePoint .

ind:activatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Activated Timestamp' ;
    rdfs:comment 'Timestamp when service delivery under this agreement was activated and billing commenced.' ;
    rdfs:domain ind:BillingServiceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:agreementNumber rdf:type rdf:Property ;
    rdfs:label 'Agreement Number' ;
    rdfs:comment 'Externally visible business identifier for the service agreement. Used in customer communications and billing statements.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agreementStatus rdf:type rdf:Property ;
    rdfs:label 'Agreement Status' ;
    rdfs:comment 'Current lifecycle status of the service agreement. Active = service in delivery; Pending = awaiting activation; Suspended = temporarily halted; Final = closed with final bill issued; Cancelled = terminated before activation.' ;
    rdfs:domain ind:BillingServiceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agreementType rdf:type rdf:Property ;
    rdfs:label 'Agreement Type' ;
    rdfs:comment 'Type of utility service provided under this agreement: electric only, gas only, or dual fuel (both electric and gas).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autoPayFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Pay Flag' ;
    rdfs:comment 'Indicates whether automatic payment is enabled for this service agreement. True = auto-pay active; False = manual payment.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:averageMonthlyUsageKwh rdf:type rdf:Property ;
    rdfs:label 'Average Monthly Usage Kwh' ;
    rdfs:comment 'Rolling 12-month average monthly electric consumption in kilowatt-hours for this service agreement. Used for budget billing calculation and load forecasting.' ;
    rdfs:domain ind:BillingServiceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:averageMonthlyUsageMcf rdf:type rdf:Property ;
    rdfs:label 'Average Monthly Usage Mcf' ;
    rdfs:comment 'Rolling 12-month average monthly gas consumption in thousand cubic feet for this service agreement. Used for budget billing calculation and load forecasting.' ;
    rdfs:domain ind:BillingServiceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:budgetBillingFlag rdf:type rdf:Property ;
    rdfs:label 'Budget Billing Flag' ;
    rdfs:comment 'Indicates whether this service agreement is enrolled in budget billing (levelized monthly payment plan). True = enrolled; False = standard billing.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:collectionStatus rdf:type rdf:Property ;
    rdfs:label 'Collection Status' ;
    rdfs:comment 'Current collections status for this service agreement. Current = no arrears; Past Due = overdue balance; Collection = active collections; Payment Plan = installment arrangement; Suspended = service disconnected; Write Off = uncollectible.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractDemandKw rdf:type rdf:Property ;
    rdfs:label 'Contract Demand Kw' ;
    rdfs:comment 'Contracted demand level in kilowatts for commercial and industrial customers with demand-based rate schedules. Used for demand charge calculation and capacity reservation.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:creditRating rdf:type rdf:Property ;
    rdfs:label 'Credit Rating' ;
    rdfs:comment 'Credit assessment of the customer for deposit and payment term determination. Excellent/Good = no deposit; Fair/Poor = deposit required.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currentBalance rdf:type rdf:Property ;
    rdfs:label 'Current Balance' ;
    rdfs:comment 'Current outstanding balance for this service agreement. Positive = amount owed by customer; Negative = credit balance.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depositAmount rdf:type rdf:Property ;
    rdfs:label 'Deposit Amount' ;
    rdfs:comment 'Dollar amount of security deposit held for this service agreement. Required for customers with poor credit or payment history. Null if no deposit required.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depositHeldDate rdf:type rdf:Property ;
    rdfs:label 'Deposit Held Date' ;
    rdfs:comment 'Date when the security deposit was collected and held. Used for interest accrual calculation per PUC rules.' ;
    rdfs:domain ind:BillingServiceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:endDate rdf:type rdf:Property ;
    rdfs:label 'End Date' ;
    rdfs:comment 'Date when service delivery and billing under this agreement ended or is scheduled to end. Null for open-ended active agreements. Corresponds to move-out or service termination date.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastBillDate rdf:type rdf:Property ;
    rdfs:label 'Last Bill Date' ;
    rdfs:comment 'Date of the most recent invoice generated for this service agreement.' ;
    rdfs:domain ind:BillingServiceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastPaymentDate rdf:type rdf:Property ;
    rdfs:label 'Last Payment Date' ;
    rdfs:comment 'Date of the most recent payment received for this service agreement.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lifeSupportFlag rdf:type rdf:Property ;
    rdfs:label 'Life Support Flag' ;
    rdfs:comment 'Indicates whether the premise has registered life-support medical equipment requiring uninterrupted electric service. True = life support present; False = none. Affects disconnection rules.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:loadProfileCode rdf:type rdf:Property ;
    rdfs:label 'Load Profile Code' ;
    rdfs:comment 'Code identifying the typical consumption pattern profile for this service agreement. Used for demand forecasting and rate design.' ;
    rdfs:domain ind:BillingServiceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lowIncomeQualifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Low Income Qualified Flag' ;
    rdfs:comment 'Indicates whether the customer qualifies for low-income assistance programs and discounted rates. True = qualified; False = not qualified.' ;
    rdfs:domain ind:BillingServiceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nemEnrolledFlag rdf:type rdf:Property ;
    rdfs:label 'Nem Enrolled Flag' ;
    rdfs:comment 'Indicates whether this service agreement is enrolled in a Net Energy Metering program for distributed generation (solar, wind). True = enrolled; False = not enrolled.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paperlessBillingFlag rdf:type rdf:Property ;
    rdfs:label 'Paperless Billing Flag' ;
    rdfs:comment 'Indicates whether the customer has opted for electronic billing statements instead of paper. True = paperless; False = paper billing.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:premiseType rdf:type rdf:Property ;
    rdfs:label 'Premise Type' ;
    rdfs:comment 'Classification of the physical premise receiving service: single-family home, multi-family dwelling, commercial office, retail, industrial facility, agricultural facility, or public building. [ENUM-REF-CANDIDATE: single_family|multi_family|commercial_office|retail|industrial_facility|agricultural_facility|public_building — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceVoltageLevel rdf:type rdf:Property ;
    rdfs:label 'Service Voltage Level' ;
    rdfs:comment 'Voltage level at which electric service is delivered. Secondary = low voltage residential/small commercial; Primary = medium voltage large commercial; Transmission = high voltage industrial.' ;
    rdfs:domain ind:BillingServiceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialRateRiderCodes rdf:type rdf:Property ;
    rdfs:label 'Special Rate Rider Codes' ;
    rdfs:comment 'Comma-separated list of special rate rider codes applied to this agreement. Examples: FAC (Fuel Adjustment Clause), renewable energy surcharge, low-income discount, energy efficiency incentive.' ;
    rdfs:domain ind:BillingServiceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:terminatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Terminated Timestamp' ;
    rdfs:comment 'Timestamp when service delivery under this agreement was terminated. Null for active agreements.' ;
    rdfs:domain ind:BillingServiceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:terminationReason rdf:type rdf:Property ;
    rdfs:label 'Termination Reason' ;
    rdfs:comment 'Reason code for service agreement termination. Customer Request = voluntary disconnect; Move Out = customer relocation; Non Payment = involuntary disconnect; Property Demolition = premise no longer exists; Service Transfer = agreement superseded by new agreement.' ;
    rdfs:domain ind:BillingServiceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thirdPartyNotificationFlag rdf:type rdf:Property ;
    rdfs:label 'Third Party Notification Flag' ;
    rdfs:comment 'Indicates whether a third party (family member, social service agency) is registered to receive billing and disconnection notices. True = third party registered; False = none.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:collectionsCaseId rdf:type rdf:Property ;
    rdfs:label 'Collections Case Id' ;
    rdfs:comment 'Unique identifier for the collections case record. Primary key for tracking the full lifecycle of a delinquent account from initial past-due notice through resolution.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CollectionsCase .

ind:glAccountId rdf:type rdf:Property ;
    rdfs:label 'Gl Account Id' ;
    rdfs:comment 'Foreign key linking to finance.gl_account. Business justification: Write-offs and bad debt expense from collections cases must post to GL allowance for doubtful accounts. Required for accurate AR valuation and expense recognition.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GlAccount .

ind:actualDisconnectDate rdf:type rdf:Property ;
    rdfs:label 'Actual Disconnect Date' ;
    rdfs:comment 'Date when service was physically disconnected by field crews. Marks the point where customer loses electric or gas service.' ;
    rdfs:domain ind:CollectionsCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:agencyReferralDate rdf:type rdf:Property ;
    rdfs:label 'Agency Referral Date' ;
    rdfs:comment 'Date when the delinquent account was referred to an external collections agency for third-party debt recovery.' ;
    rdfs:domain ind:CollectionsCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assignedCollectionsAgent rdf:type rdf:Property ;
    rdfs:label 'Assigned Collections Agent' ;
    rdfs:comment 'Name or identifier of the internal collections agent responsible for managing this case. Used for workload balancing and performance tracking.' ;
    rdfs:domain ind:CollectionsCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankruptcyCaseNumber rdf:type rdf:Property ;
    rdfs:label 'Bankruptcy Case Number' ;
    rdfs:comment 'Court-assigned bankruptcy case number. Used for tracking bankruptcy proceedings and proof of claim filings.' ;
    rdfs:domain ind:CollectionsCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankruptcyFilingDate rdf:type rdf:Property ;
    rdfs:label 'Bankruptcy Filing Date' ;
    rdfs:comment 'Date when the customer filed for bankruptcy. Triggers automatic stay of collections activity per federal bankruptcy law.' ;
    rdfs:domain ind:CollectionsCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:bankruptcyFlag rdf:type rdf:Property ;
    rdfs:label 'Bankruptcy Flag' ;
    rdfs:comment 'Indicates whether the customer has filed for bankruptcy protection. True if bankruptcy filing has been recorded, which typically suspends collections activity.' ;
    rdfs:domain ind:CollectionsCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:caseClosedDate rdf:type rdf:Property ;
    rdfs:label 'Case Closed Date' ;
    rdfs:comment 'Date when the collections case was closed. Populated upon successful payment, write-off, or other resolution outcome.' ;
    rdfs:domain ind:CollectionsCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:caseNumber rdf:type rdf:Property ;
    rdfs:label 'Case Number' ;
    rdfs:comment 'Business-facing unique identifier for the collections case. Used in customer communications, agent tracking, and external collections agency referrals.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:caseOpenedDate rdf:type rdf:Property ;
    rdfs:label 'Case Opened Date' ;
    rdfs:comment 'Date when the collections case was first opened. Typically triggered when an account becomes past due beyond the grace period threshold.' ;
    rdfs:domain ind:CollectionsCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:caseStatus rdf:type rdf:Property ;
    rdfs:label 'Case Status' ;
    rdfs:comment 'Current lifecycle status of the collections case. Tracks progression from initial dunning through final resolution or write-off. [ENUM-REF-CANDIDATE: open|pending_payment|payment_arrangement|field_collection|agency_referral|legal_action|suspended|closed|written_off|bankruptcy — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectionsAgencyName rdf:type rdf:Property ;
    rdfs:label 'Collections Agency Name' ;
    rdfs:comment 'Name of the external collections agency assigned to recover the debt. Used for tracking agency performance and commission calculations.' ;
    rdfs:domain ind:CollectionsCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectionsCost rdf:type rdf:Property ;
    rdfs:label 'Collections Cost' ;
    rdfs:comment 'Total cost incurred for collections activity including agency fees, legal fees, and internal labor. Used for cost-benefit analysis of collections efforts. Denominated in USD.' ;
    rdfs:domain ind:CollectionsCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:collectionsStage rdf:type rdf:Property ;
    rdfs:label 'Collections Stage' ;
    rdfs:comment 'Current escalation stage in the collections process. Defines the severity level and action type being pursued for debt recovery.' ;
    rdfs:domain ind:CollectionsCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:daysPastDue rdf:type rdf:Property ;
    rdfs:label 'Days Past Due' ;
    rdfs:comment 'Number of days the account balance has been overdue. Calculated from the original invoice due date to the current date or case closure date.' ;
    rdfs:domain ind:CollectionsCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:disconnectOrderDate rdf:type rdf:Property ;
    rdfs:label 'Disconnect Order Date' ;
    rdfs:comment 'Date when a field disconnect order was issued to terminate service for non-payment. Triggers field crew dispatch for physical disconnection.' ;
    rdfs:domain ind:CollectionsCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:disconnectWarningSentDate rdf:type rdf:Property ;
    rdfs:label 'Disconnect Warning Sent Date' ;
    rdfs:comment 'Date when the service disconnection warning notice was sent. Escalated collections action notifying customer of imminent service termination.' ;
    rdfs:domain ind:CollectionsCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dunningNoticeSentDate rdf:type rdf:Property ;
    rdfs:label 'Dunning Notice Sent Date' ;
    rdfs:comment 'Date when the initial past-due notice was sent to the customer. First formal collections communication in the escalation process.' ;
    rdfs:domain ind:CollectionsCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastContactDate rdf:type rdf:Property ;
    rdfs:label 'Last Contact Date' ;
    rdfs:comment 'Date of the most recent contact attempt with the customer. Used to track collections agent activity and ensure compliance with contact frequency regulations.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastContactMethod rdf:type rdf:Property ;
    rdfs:label 'Last Contact Method' ;
    rdfs:comment 'Communication channel used for the most recent customer contact. Tracks effectiveness of different outreach methods.' ;
    rdfs:domain ind:CollectionsCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Last Payment Amount' ;
    rdfs:comment 'Amount of the most recent payment received. Helps evaluate partial payment patterns and customer financial capacity. Denominated in USD.' ;
    rdfs:domain ind:CollectionsCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastUpdatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Updated Timestamp' ;
    rdfs:comment 'System timestamp when the collections case record was most recently modified. Used for change tracking and data synchronization.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:legalActionDate rdf:type rdf:Property ;
    rdfs:label 'Legal Action Date' ;
    rdfs:comment 'Date when legal proceedings were initiated for debt recovery. Marks escalation to court filings, liens, or judgments.' ;
    rdfs:domain ind:CollectionsCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:legalActionFlag rdf:type rdf:Property ;
    rdfs:label 'Legal Action Flag' ;
    rdfs:comment 'Indicates whether legal action has been initiated to recover the debt. True if case has been escalated to legal collections or court proceedings.' ;
    rdfs:domain ind:CollectionsCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:originalDebtAmount rdf:type rdf:Property ;
    rdfs:label 'Original Debt Amount' ;
    rdfs:comment 'Initial past-due balance at the time the collections case was opened. Used to track debt reduction progress and recovery rate. Denominated in USD.' ;
    rdfs:domain ind:CollectionsCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pastDueAmount rdf:type rdf:Property ;
    rdfs:label 'Past Due Amount' ;
    rdfs:comment 'Total outstanding balance that is past due and subject to collections activity. Includes principal charges, late fees, and accrued interest. Denominated in USD for single-currency utility operations.' ;
    rdfs:domain ind:CollectionsCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentArrangementFlag rdf:type rdf:Property ;
    rdfs:label 'Payment Arrangement Flag' ;
    rdfs:comment 'Indicates whether the customer has entered into a payment arrangement or installment plan to resolve the debt. True if active arrangement exists.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:resolutionOutcome rdf:type rdf:Property ;
    rdfs:label 'Resolution Outcome' ;
    rdfs:comment 'Final outcome of the collections case. Captures how the delinquency was resolved for performance tracking and recovery rate analysis. [ENUM-REF-CANDIDATE: paid_in_full|payment_arrangement|partial_payment|written_off|bankruptcy_discharge|account_transferred|other — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:CollectionsCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalRecoveredAmount rdf:type rdf:Property ;
    rdfs:label 'Total Recovered Amount' ;
    rdfs:comment 'Total amount recovered through collections activity. Includes all payments received after case opening. Used to calculate recovery rate and collections effectiveness. Denominated in USD.' ;
    rdfs:domain ind:CollectionsCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:writeOffAmount rdf:type rdf:Property ;
    rdfs:label 'Write Off Amount' ;
    rdfs:comment 'Total amount written off as uncollectible bad debt. Flows to SAP S/4HANA for bad debt expense accounting and regulatory reporting. Denominated in USD.' ;
    rdfs:domain ind:CollectionsCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:writeOffDate rdf:type rdf:Property ;
    rdfs:label 'Write Off Date' ;
    rdfs:comment 'Date when the debt was written off. Triggers bad debt expense recognition in SAP S/4HANA for GAAP financial reporting.' ;
    rdfs:domain ind:CollectionsCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:writeOffFlag rdf:type rdf:Property ;
    rdfs:label 'Write Off Flag' ;
    rdfs:comment 'Indicates whether the debt has been written off as uncollectible. True if the utility has recognized the bad debt expense and removed the receivable from active collections.' ;
    rdfs:domain ind:CollectionsCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:writeOffReason rdf:type rdf:Property ;
    rdfs:label 'Write Off Reason' ;
    rdfs:comment 'Business reason for writing off the debt. Used for bad debt analysis and collections process improvement.' ;
    rdfs:domain ind:CollectionsCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditAdjustmentId rdf:type rdf:Property ;
    rdfs:label 'Credit Adjustment Id' ;
    rdfs:comment 'Unique identifier for the credit adjustment record. Primary key for the credit adjustment entity.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CreditAdjustment .

ind:commissionOrderId rdf:type rdf:Property ;
    rdfs:label 'Commission Order Id' ;
    rdfs:comment 'Foreign key linking to regulatory.commission_order. Business justification: Credits issued as result of commission orders or settlement agreements in regulatory proceedings require traceability. Real business process: commission-ordered refunds, rate case settlements, and reg' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CommissionOrder .

ind:primaryReversalOfAdjustmentCreditAdjustmentId rdf:type rdf:Property ;
    rdfs:label 'Primary Reversal Of Adjustment Credit Adjustment Id' ;
    rdfs:comment 'Reference to the original credit adjustment that this record reverses. Nullable for original adjustments. Used to maintain audit trail for adjustment corrections and reversals.' ;
    rdfs:domain ind:CreditAdjustment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CreditAdjustment .

ind:settlementStatementId rdf:type rdf:Property ;
    rdfs:label 'Settlement Statement Id' ;
    rdfs:comment 'Foreign key linking to market.settlement_statement. Business justification: Market settlement errors or RTO resettlements trigger billing adjustments to retail customers. Real process: when wholesale market disputes are resolved or statements are reissued, utilities must cred' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SettlementStatement .

ind:adjustmentAmount rdf:type rdf:Property ;
    rdfs:label 'Adjustment Amount' ;
    rdfs:comment 'Monetary value of the credit adjustment in US dollars. Positive values represent credits to the customer (reducing account balance); negative values represent debits (increasing account balance). Includes the net impact on customer account receivable.' ;
    rdfs:domain ind:CreditAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:adjustmentNumber rdf:type rdf:Property ;
    rdfs:label 'Adjustment Number' ;
    rdfs:comment 'Externally visible business identifier for the credit adjustment. Unique human-readable reference number used in customer communications and dispute resolution tracking.' ;
    rdfs:domain ind:CreditAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adjustmentStatus rdf:type rdf:Property ;
    rdfs:label 'Adjustment Status' ;
    rdfs:comment 'Current lifecycle status of the credit adjustment. Tracks the adjustment from initial creation through approval, posting to the General Ledger (GL), and potential reversal or cancellation.' ;
    rdfs:domain ind:CreditAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adjustmentType rdf:type rdf:Property ;
    rdfs:label 'Adjustment Type' ;
    rdfs:comment 'Classification of the credit adjustment by business purpose. Includes rate correction credits, outage performance credits (SAIDI/SAIFI-related), low-income program discounts (LIHEAP, PIPP), returned payment fees, late payment charges, deposit interest credits, bad debt write-offs, billing error corrections, meter error adjustments, estimated bill corrections, Fuel Adjustment Clause (FAC) adjustments, Contribution in Aid of Construction (CIAC) adjustments, regulatory rider adjustments, dispute resolution credits, customer service credits, payment reversals, and other miscellaneous adjustments. [ENUM-REF-CANDIDATE: rate_correction|service_credit|outage_credit|regulatory_refund|low_income_discount|returned_payment_fee|late_payment_charge|deposit_interest|bad_debt_writeoff|billing_error_correction|meter_error_adjustment|estimated_bill_correction|fac_adjustment|ciac_adjustment|rider_adjustment|dispute_resolution_credit|customer_service_credit|payment_reversal|other — 19 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:CreditAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvedByUserCode rdf:type rdf:Property ;
    rdfs:label 'Approved By User Code' ;
    rdfs:comment 'System user identifier of the employee who authorized and approved this adjustment. Nullable for system-automated adjustments. Used for audit trail and SOX compliance reporting.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvedByUserName rdf:type rdf:Property ;
    rdfs:label 'Approved By User Name' ;
    rdfs:comment 'Full name of the employee who authorized and approved this adjustment. Denormalized for reporting convenience and audit trail readability.' ;
    rdfs:domain ind:CreditAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorizationLevel rdf:type rdf:Property ;
    rdfs:label 'Authorization Level' ;
    rdfs:comment 'Approval authority level required for this adjustment based on amount thresholds and adjustment type. System-automated adjustments (e.g., FAC riders) require no manual approval; large or sensitive adjustments require supervisor, manager, director, or executive approval per internal controls and Sarbanes-Oxley (SOX) compliance requirements. [ENUM-REF-CANDIDATE: system_auto|csr_tier1|csr_tier2|supervisor|manager|director|executive — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:CreditAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:comments rdf:type rdf:Property ;
    rdfs:label 'Comments' ;
    rdfs:comment 'Additional free-text comments or notes related to this credit adjustment. Captures internal operational notes, customer service representative observations, supporting documentation references, and any other contextual information not captured in structured fields.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:createdByUserCode rdf:type rdf:Property ;
    rdfs:label 'Created By User Code' ;
    rdfs:comment 'System user identifier of the employee or automated process that created this adjustment record. Used for audit trail and SOX compliance reporting.' ;
    rdfs:domain ind:CreditAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerNotificationSent rdf:type rdf:Property ;
    rdfs:label 'Customer Notification Sent' ;
    rdfs:comment 'Flag indicating whether the customer has been notified of this adjustment via bill message, email, or other communication channel. Used for customer service tracking and regulatory compliance with customer notification requirements.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:glPostingStatus rdf:type rdf:Property ;
    rdfs:label 'Gl Posting Status' ;
    rdfs:comment 'Status of the adjustment posting to the General Ledger (GL) in the Enterprise Resource Planning (ERP) system. Tracks whether the adjustment has been successfully integrated into financial accounting records for GAAP revenue reporting and reconciliation.' ;
    rdfs:domain ind:CreditAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastModifiedByUserCode rdf:type rdf:Property ;
    rdfs:label 'Last Modified By User Code' ;
    rdfs:comment 'System user identifier of the employee or automated process that last modified this adjustment record. Used for audit trail and SOX compliance reporting.' ;
    rdfs:domain ind:CreditAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationDate rdf:type rdf:Property ;
    rdfs:label 'Notification Date' ;
    rdfs:comment 'Date on which the customer was notified of this adjustment. Nullable if customer notification has not been sent. Used for regulatory compliance tracking and customer service audit trail.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:postingDate rdf:type rdf:Property ;
    rdfs:label 'Posting Date' ;
    rdfs:comment 'Date on which the adjustment was posted to the General Ledger (GL) and applied to the customer account balance. Represents the accounting transaction date for financial reporting and reconciliation.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reasonCode rdf:type rdf:Property ;
    rdfs:label 'Reason Code' ;
    rdfs:comment 'Standardized code indicating the specific business reason for the adjustment. Maps to internal reason code taxonomy used for regulatory reporting and financial analysis. Examples include OUTAGE (outage credit), RATEFIX (rate correction), LIHEAP (low-income assistance), BDWRT (bad debt write-off), METERERR (meter error), ESTCORR (estimated bill correction).' ;
    rdfs:domain ind:CreditAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reasonDescription rdf:type rdf:Property ;
    rdfs:label 'Reason Description' ;
    rdfs:comment 'Free-text narrative explanation of the business reason for the adjustment. Provides additional context beyond the reason code, including customer-facing explanation, internal notes, and supporting documentation references.' ;
    rdfs:domain ind:CreditAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryProgramCode rdf:type rdf:Property ;
    rdfs:label 'Regulatory Program Code' ;
    rdfs:comment 'Code identifying the regulatory program or mandate associated with this adjustment. Examples include LIHEAP (Low Income Home Energy Assistance Program), PIPP (Percentage of Income Payment Plan), Renewable Portfolio Standard (RPS) credits, Energy Efficiency (EE) program rebates, and Demand Response (DR) incentive payments. Used for regulatory compliance reporting to the Public Utility Commission (PUC) and Federal Energy Regulatory Commission (FERC).' ;
    rdfs:domain ind:CreditAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystem rdf:type rdf:Property ;
    rdfs:label 'Source System' ;
    rdfs:comment 'Operational system of record that originated this credit adjustment. Identifies whether the adjustment was created in Oracle CC&B, SAP IS-U, Salesforce CRM, Meter Data Management System (MDMS), ERP, or manually entered. Used for data lineage tracking and system integration reconciliation.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceTransactionReference rdf:type rdf:Property ;
    rdfs:label 'Source Transaction Reference' ;
    rdfs:comment 'Unique transaction identifier from the source system of record. Maintains traceability back to the originating system transaction for audit and reconciliation purposes.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxImpactAmount rdf:type rdf:Property ;
    rdfs:label 'Tax Impact Amount' ;
    rdfs:comment 'Tax amount adjustment associated with this credit adjustment. Represents the change in sales tax, utility tax, or other regulatory taxes resulting from the adjustment. Used for tax reconciliation and regulatory tax reporting.' ;
    rdfs:domain ind:CreditAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:customerServiceAgreementId rdf:type rdf:Property ;
    rdfs:label 'Customer Service Agreement Id' ;
    rdfs:comment 'Reference to the service agreement (contract) under which this invoice was issued. A customer account may have multiple service agreements for different service points or commodity types (electric vs gas).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CustomerServiceAgreement .

ind:rateCaseId rdf:type rdf:Property ;
    rdfs:label 'Rate Case Id' ;
    rdfs:comment 'Foreign key linking to regulatory.rate_case. Business justification: Invoices generated under rates approved in specific rate cases need traceability for revenue requirement validation, true-up calculations, and rate case reconciliation. Real business process: rate cas' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RateCase .

ind:billPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Bill Period End Date' ;
    rdfs:comment 'End date of the billing period covered by this invoice. Represents the last day of consumption included in the bill. Typically corresponds to the meter read date.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:billPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Bill Period Start Date' ;
    rdfs:comment 'Start date of the billing period covered by this invoice. Represents the first day of consumption included in the bill. Aligns with meter read cycle dates.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:billingDays rdf:type rdf:Property ;
    rdfs:label 'Billing Days' ;
    rdfs:comment 'Number of days in the billing period, calculated as the difference between bill period end date and bill period start date. Used to normalize consumption for comparison across billing cycles of varying lengths.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:consumptionKwh rdf:type rdf:Property ;
    rdfs:label 'Consumption Kwh' ;
    rdfs:comment 'Total electric energy consumption during the billing period, measured in kWh (Kilowatt-Hours). Derived from meter reads (actual or estimated) from AMI or AMR systems. Null for gas-only invoices.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:consumptionTherms rdf:type rdf:Property ;
    rdfs:label 'Consumption Therms' ;
    rdfs:comment 'Total gas consumption during the billing period, measured in Therms (unit of heat energy for gas billing). One Therm equals 100,000 BTU. Derived from meter reads. Null for electric-only invoices.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentChargesAmount rdf:type rdf:Property ;
    rdfs:label 'Current Charges Amount' ;
    rdfs:comment 'Total charges for the current billing period before taxes and regulatory riders. Includes energy charges (kWh or Therm), demand charges (kW or MW), customer charges, and any applicable FAC (Fuel Adjustment Clause) adjustments. Expressed in USD.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:customerChargeAmount rdf:type rdf:Property ;
    rdfs:label 'Customer Charge Amount' ;
    rdfs:comment 'Fixed monthly charge for maintaining the customer account and service connection, independent of consumption. Covers meter reading, billing, customer service, and infrastructure maintenance costs. Approved by PUC tariff. Expressed in USD.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deliveryMethod rdf:type rdf:Property ;
    rdfs:label 'Delivery Method' ;
    rdfs:comment 'Method by which the invoice was delivered to the customer. Paper invoices are mailed via postal service. Email invoices are sent as PDF attachments. Online portal invoices are available for download through the customer self-service portal.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:demandChargeAmount rdf:type rdf:Property ;
    rdfs:label 'Demand Charge Amount' ;
    rdfs:comment 'Charges for peak demand during the billing period, applicable to commercial and industrial customers. Based on the highest kW (Kilowatt) or MW (Megawatt) demand recorded during on-peak hours. Not applicable to most residential customers. Expressed in USD.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disconnectionNoticeFlag rdf:type rdf:Property ;
    rdfs:label 'Disconnection Notice Flag' ;
    rdfs:comment 'Indicates whether a disconnection notice has been issued for this invoice due to non-payment. True if the customer has been notified of pending service disconnection. Disconnection procedures are governed by PUC consumer protection rules.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disputeFlag rdf:type rdf:Property ;
    rdfs:label 'Dispute Flag' ;
    rdfs:comment 'Indicates whether the customer has disputed this invoice. True if a formal dispute has been filed with customer service or the PUC. Disputed invoices may be placed on hold for collections pending resolution.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disputeReason rdf:type rdf:Property ;
    rdfs:label 'Dispute Reason' ;
    rdfs:comment 'Free-text description of the reason for the invoice dispute, as provided by the customer or customer service representative. Common reasons include billing errors, meter read discrepancies, rate application issues, and service quality complaints.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dueDate rdf:type rdf:Property ;
    rdfs:label 'Due Date' ;
    rdfs:comment 'Date by which payment must be received to avoid late fees or service disconnection. Calculated based on invoice date plus payment terms (typically 15-21 days).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:energyChargeAmount rdf:type rdf:Property ;
    rdfs:label 'Energy Charge Amount' ;
    rdfs:comment 'Charges for energy consumption during the billing period. For electric service, based on kWh (Kilowatt-Hours) consumed. For gas service, based on Therms or MCF (Thousand Cubic Feet) consumed. Calculated by applying the rate schedule energy rate to metered usage. Expressed in USD.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:facAdjustmentAmount rdf:type rdf:Property ;
    rdfs:label 'Fac Adjustment Amount' ;
    rdfs:comment 'Adjustment to energy charges based on fluctuations in fuel costs for generation. FAC (Fuel Adjustment Clause) allows utilities to pass through fuel cost changes without a full rate case. Can be positive (surcharge) or negative (credit). Approved by PUC. Expressed in USD.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:glPostingDate rdf:type rdf:Property ;
    rdfs:label 'Gl Posting Date' ;
    rdfs:comment 'Date the invoice was posted to the general ledger in the ERP system (SAP S/4HANA or Oracle ERP Cloud). Used for financial period closing and reconciliation between the CIS and ERP systems.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:invoiceDate rdf:type rdf:Property ;
    rdfs:label 'Invoice Date' ;
    rdfs:comment 'Date the invoice was generated by the billing system. Used as the official invoice issuance date for revenue recognition and aging calculations.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:invoiceNumber rdf:type rdf:Property ;
    rdfs:label 'Invoice Number' ;
    rdfs:comment 'Human-readable, externally-visible invoice number printed on the customer bill. Unique within the billing system and used for customer inquiries, payment references, and dispute resolution.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:invoiceStatus rdf:type rdf:Property ;
    rdfs:label 'Invoice Status' ;
    rdfs:comment 'Current lifecycle status of the invoice. Tracks progression from generation through payment or write-off. Disputed status triggers collections workflow. Cancelled status applies to voided or reversed invoices. [ENUM-REF-CANDIDATE: generated|issued|mailed|paid|partially_paid|disputed|written_off|cancelled — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:invoiceType rdf:type rdf:Property ;
    rdfs:label 'Invoice Type' ;
    rdfs:comment 'Classification of the invoice based on billing cycle context. Regular invoices are standard monthly/bi-monthly bills. Final invoices are issued upon account closure or move-out. Adjustment invoices correct prior billing errors. Estimated invoices are issued when actual meter reads are unavailable. Corrected invoices replace previously issued invoices.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lateFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Late Fee Amount' ;
    rdfs:comment 'Late payment fee assessed if payment is not received by the due date. Late fee rates and grace periods are defined in the PUC-approved tariff. Expressed in USD.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outstandingBalanceAmount rdf:type rdf:Property ;
    rdfs:label 'Outstanding Balance Amount' ;
    rdfs:comment 'Remaining unpaid balance on this invoice, calculated as total amount due minus payment received amount. Used for aging analysis and collections prioritization. Expressed in USD.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentPlanFlag rdf:type rdf:Property ;
    rdfs:label 'Payment Plan Flag' ;
    rdfs:comment 'Indicates whether this invoice is part of a payment plan or installment agreement. True if the customer has arranged to pay the balance over multiple billing cycles. Payment plans are offered to customers facing financial hardship.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentReceivedAmount rdf:type rdf:Property ;
    rdfs:label 'Payment Received Amount' ;
    rdfs:comment 'Total payments received and applied to this invoice as of the current date. Updated as payments are posted from various channels (online, mail, phone, in-person). Expressed in USD.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:peakDemandKw rdf:type rdf:Property ;
    rdfs:label 'Peak Demand Kw' ;
    rdfs:comment 'Maximum electric demand recorded during the billing period, measured in kW (Kilowatts). Used to calculate demand charges for commercial and industrial customers. Captured from interval meter data (AMI). Null for residential customers without demand metering.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:previousBalanceAmount rdf:type rdf:Property ;
    rdfs:label 'Previous Balance Amount' ;
    rdfs:comment 'Outstanding balance carried forward from prior billing cycles. Includes unpaid charges, late fees, and any credits or adjustments from previous invoices. Expressed in USD.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:printDate rdf:type rdf:Property ;
    rdfs:label 'Print Date' ;
    rdfs:comment 'Date the invoice was printed or electronically delivered to the customer. May differ from invoice date if batch printing or electronic delivery is delayed.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryRiderAmount rdf:type rdf:Property ;
    rdfs:label 'Regulatory Rider Amount' ;
    rdfs:comment 'Total charges or credits from regulatory riders approved by the PUC. Riders recover specific costs such as renewable energy programs (RPS - Renewable Portfolio Standard), energy efficiency (EE) programs, demand response (DR) programs, environmental compliance, and infrastructure investments. Expressed in USD.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:revenueRecognitionDate rdf:type rdf:Property ;
    rdfs:label 'Revenue Recognition Date' ;
    rdfs:comment 'Date on which revenue from this invoice is recognized in the general ledger for GAAP financial reporting. Typically the invoice date or the bill period end date, depending on the utility\'s revenue recognition policy.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:taxAmount rdf:type rdf:Property ;
    rdfs:label 'Tax Amount' ;
    rdfs:comment 'Total taxes applied to the invoice, including state sales tax, local utility taxes, franchise fees, and any other government-mandated taxes. Tax rates and applicability vary by jurisdiction and customer class. Expressed in USD.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalAmountDue rdf:type rdf:Property ;
    rdfs:label 'Total Amount Due' ;
    rdfs:comment 'Total amount the customer must pay, calculated as previous balance plus current charges plus taxes plus regulatory riders. This is the net amount due printed on the invoice. Expressed in USD.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:chargeDescription rdf:type rdf:Property ;
    rdfs:label 'Charge Description' ;
    rdfs:comment 'Human-readable description of the charge line item as it appears on the customer invoice. Provides detailed explanation of the charge component, rate schedule tier, Time-of-Use (TOU) period, or regulatory rider being applied. Examples: \'Residential Electric Service - Summer On-Peak Energy\', \'Natural Gas Distribution Charge\', \'Renewable Energy Surcharge\', \'State Sales Tax\'.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chargeTypeCode rdf:type rdf:Property ;
    rdfs:label 'Charge Type Code' ;
    rdfs:comment 'Classification code identifying the nature of the billable charge. Common values include ENERGY (consumption charges in kWh or MCF), DEMAND (peak kW charges), CUSTOMER (fixed monthly service charge), DISTRIBUTION (delivery charges), TRANSMISSION (bulk transport charges), FAC (Fuel Adjustment Clause rider), CIAC (Contribution in Aid of Construction recovery), RPS (Renewable Portfolio Standard surcharge), TAX (sales tax, utility tax), CREDIT (bill adjustments, payment credits), LATE_FEE (penalty charges), RECONNECT (service restoration fee), DEPOSIT (security deposit), and OTHER (miscellaneous charges). [ENUM-REF-CANDIDATE: ENERGY|DEMAND|CUSTOMER|DISTRIBUTION|TRANSMISSION|FAC|CIAC|RPS|TAX|CREDIT|LATE_FEE|RECONNECT|DEPOSIT|OTHER — 14 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:InvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costCenterCode rdf:type rdf:Property ;
    rdfs:label 'Cost Center Code' ;
    rdfs:comment 'Cost center or profit center code for internal management accounting. Identifies the business unit, operating division, or service territory responsible for this revenue line. Supports Operations and Maintenance (O&M) cost allocation, performance-based ratemaking (PBR) analysis, and internal profitability reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disputedFlag rdf:type rdf:Property ;
    rdfs:label 'Disputed Flag' ;
    rdfs:comment 'Indicates whether this invoice line is under customer dispute. True if the customer has formally disputed this charge through the Customer Information System (CIS) or Customer Relationship Management (CRM) system. False if not disputed. Disputed charges may be held from collections pending resolution. Supports dispute management and regulatory compliance with customer rights provisions.' ;
    rdfs:domain ind:InvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lineAmount rdf:type rdf:Property ;
    rdfs:label 'Line Amount' ;
    rdfs:comment 'Extended charge amount for this invoice line. Calculated as usage_quantity multiplied by unit_rate, or a fixed amount for non-usage-based charges. Represents the pre-tax charge value. Positive values indicate charges; negative values indicate credits or adjustments. Expressed in the invoice currency (typically USD for U.S. utilities).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:printSequence rdf:type rdf:Property ;
    rdfs:label 'Print Sequence' ;
    rdfs:comment 'Display sequence number for printing this line on the customer invoice. Determines the order in which charges appear on the bill. Typically groups charges by type (energy, demand, fixed, taxes) and sorts within groups. Supports customer bill presentation and readability.' ;
    rdfs:domain ind:InvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:prorationFactor rdf:type rdf:Property ;
    rdfs:label 'Proration Factor' ;
    rdfs:comment 'Proration factor applied to calculate partial-period charges for move-in, move-out, or mid-cycle rate changes. Expressed as a decimal between 0 and 1 representing the fraction of the billing period for which the charge applies. Example: 0.5000 for a half-month charge. Null for full-period charges. Ensures accurate billing for partial service periods.' ;
    rdfs:domain ind:InvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateComponentCode rdf:type rdf:Property ;
    rdfs:label 'Rate Component Code' ;
    rdfs:comment 'Specific component within the rate schedule being applied. Identifies the tier, block, or Time-of-Use (TOU) period for tiered or time-differentiated rates. Examples: \'TIER1\' (first 500 kWh), \'TIER2\' (501-1000 kWh), \'ON_PEAK\' (summer on-peak hours), \'OFF_PEAK\' (off-peak hours), \'SHOULDER\' (shoulder period). Enables granular revenue analysis by rate structure element.' ;
    rdfs:domain ind:InvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryRiderCode rdf:type rdf:Property ;
    rdfs:label 'Regulatory Rider Code' ;
    rdfs:comment 'Code identifying the regulatory rider or surcharge applied to this line. Riders are PUC-approved rate adjustments for specific cost recovery mechanisms. Examples: \'FAC\' (Fuel Adjustment Clause for fuel cost pass-through), \'DSM\' (Demand-Side Management program cost recovery), \'RPS\' (Renewable Portfolio Standard compliance surcharge), \'CIAC\' (Contribution in Aid of Construction recovery), \'PBR\' (Performance-Based Ratemaking adjustment). Null if no rider applies. Critical for regulatory reporting and rate case reconciliation.' ;
    rdfs:domain ind:InvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revenueClassCode rdf:type rdf:Property ;
    rdfs:label 'Revenue Class Code' ;
    rdfs:comment 'Customer class or revenue category for regulatory reporting. RESIDENTIAL (single-family and multi-family homes), COMMERCIAL (small and medium businesses), INDUSTRIAL (large manufacturing and industrial customers), STREET_LIGHTING (municipal street and highway lighting), PUBLIC_AUTHORITY (government and public institutions), WHOLESALE (sales to other utilities or power marketers). Aligns with FERC Form 1 and state PUC reporting requirements.' ;
    rdfs:domain ind:InvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemCode rdf:type rdf:Property ;
    rdfs:label 'Source System Code' ;
    rdfs:comment 'Code identifying the operational system of record that generated this invoice line. CC&B (Oracle Customer Care and Billing), IS-U (SAP Industry Solution for Utilities), MDMS (Meter Data Management System for interval data charges), ERP (Enterprise Resource Planning for manual adjustments), MANUAL (manually entered adjustments). Supports data lineage, audit trail, and system integration reconciliation.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxableFlag rdf:type rdf:Property ;
    rdfs:label 'Taxable Flag' ;
    rdfs:comment 'Indicates whether this invoice line is subject to sales tax or utility tax. True if taxable, False if exempt. Determines whether tax_amount is calculated for this line. Tax exemption rules vary by jurisdiction, customer class, and charge type. Supports tax compliance and reporting.' ;
    rdfs:domain ind:InvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:totalLineAmount rdf:type rdf:Property ;
    rdfs:label 'Total Line Amount' ;
    rdfs:comment 'Total amount for this invoice line including taxes. Calculated as line_amount plus tax_amount. Represents the final charge or credit amount for this line item. Positive values indicate charges; negative values indicate credits. Expressed in the invoice currency.' ;
    rdfs:domain ind:InvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unitRate rdf:type rdf:Property ;
    rdfs:label 'Unit Rate' ;
    rdfs:comment 'Rate per unit of measure applied to calculate the charge amount. Expressed in currency per unit (e.g., dollars per kWh, dollars per MCF, dollars per kW). Derived from the approved tariff rate schedule filed with the PUC. Null for fixed charges or lump-sum adjustments. Critical for rate case analysis and revenue reconciliation.' ;
    rdfs:domain ind:InvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:usageQuantity rdf:type rdf:Property ;
    rdfs:label 'Usage Quantity' ;
    rdfs:comment 'Quantity of utility service consumed or delivered during the billing period. For energy charges, represents kilowatt-hours (kWh), Megawatt-hours (MWh), thousand cubic feet (MCF), or Therms. For demand charges, represents peak kilowatts (kW) or Megawatts (MW). Null for fixed charges, taxes, or credits that are not usage-based. Sourced from MDMS interval data aggregation or Automated Meter Reading (AMR) systems.' ;
    rdfs:domain ind:InvoiceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentId rdf:type rdf:Property ;
    rdfs:label 'Payment Id' ;
    rdfs:comment 'Unique system-generated identifier for the payment transaction record. Primary key for the payment entity.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Payment .

ind:allocationMethod rdf:type rdf:Property ;
    rdfs:label 'Allocation Method' ;
    rdfs:comment 'Business rule or algorithm used to allocate the payment amount across multiple outstanding bills or charges on the customer account. Common methods include First-In-First-Out (FIFO), Last-In-First-Out (LIFO), pro-rata distribution, or customer-directed allocation.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amount rdf:type rdf:Property ;
    rdfs:label 'Amount' ;
    rdfs:comment 'Total monetary value of the payment transaction in the utility\'s functional currency. Represents the gross amount tendered by the customer before any adjustments or fees.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:appliedAmount rdf:type rdf:Property ;
    rdfs:label 'Applied Amount' ;
    rdfs:comment 'The portion of the payment amount that was successfully applied to reduce the customer account balance. May differ from payment_amount if payment was partially applied, held in suspense, or subject to fees.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bankAccountNumberLastFour rdf:type rdf:Property ;
    rdfs:label 'Bank Account Number Last Four' ;
    rdfs:comment 'Last four digits of the customer\'s bank account number, stored for customer service reference and payment verification. Full account number is tokenized and stored in secure vault per PCI DSS requirements.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankRoutingNumber rdf:type rdf:Property ;
    rdfs:label 'Bank Routing Number' ;
    rdfs:comment 'Nine-digit American Bankers Association (ABA) routing transit number identifying the financial institution for ACH or EFT payments. Confidential financial data subject to PCI DSS controls.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:batchReference rdf:type rdf:Property ;
    rdfs:label 'Batch Reference' ;
    rdfs:comment 'Identifier for the payment processing batch or lockbox deposit in which this payment was grouped for posting and reconciliation. Used for audit trail and batch balancing.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:channel rdf:type rdf:Property ;
    rdfs:label 'Channel' ;
    rdfs:comment 'The customer-facing interface or channel through which the payment was submitted. Includes web portal, mobile application, Interactive Voice Response (IVR) system, walk-in payment center, mail, lockbox, third-party payment agency, or automated recurring payment (auto-pay). [ENUM-REF-CANDIDATE: web_portal|mobile_app|ivr|walk_in|mail|lockbox|third_party_agency|auto_pay — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:checkNumber rdf:type rdf:Property ;
    rdfs:label 'Check Number' ;
    rdfs:comment 'The sequential number printed on the customer\'s check. Captured for check payments to support reconciliation and returned check processing. Null for non-check payment methods.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clearedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Cleared Timestamp' ;
    rdfs:comment 'Date and time when the payment was confirmed as cleared by the financial institution or payment processor. Applicable to checks, ACH, and credit card transactions. Null for cash payments.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:confirmationNumber rdf:type rdf:Property ;
    rdfs:label 'Confirmation Number' ;
    rdfs:comment 'Externally visible confirmation or receipt number provided to the customer upon successful payment submission. Used for customer service inquiries and dispute resolution.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditCardLastFour rdf:type rdf:Property ;
    rdfs:label 'Credit Card Last Four' ;
    rdfs:comment 'Last four digits of the customer\'s credit or debit card number, retained for customer service and dispute resolution. Full card number is tokenized per PCI DSS requirements and not stored in this system.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditCardType rdf:type rdf:Property ;
    rdfs:label 'Credit Card Type' ;
    rdfs:comment 'Brand or network of the credit or debit card used for payment. Common values include Visa, MasterCard, American Express, and Discover.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:methodType rdf:type rdf:Property ;
    rdfs:label 'Method Type' ;
    rdfs:comment 'The financial instrument or tender type used by the customer to remit payment. Distinguishes between check, electronic funds transfer (EFT), Automated Clearing House (ACH), credit card, debit card, cash, or money order. [ENUM-REF-CANDIDATE: check|ach|eft|credit_card|debit_card|cash|money_order — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nsfFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Nsf Fee Amount' ;
    rdfs:comment 'Monetary penalty assessed to the customer account when a payment is returned due to Non-Sufficient Funds. Fee amount is governed by tariff and Public Utility Commission (PUC) regulations. Null if no NSF fee applies.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentDate rdf:type rdf:Property ;
    rdfs:label 'Payment Date' ;
    rdfs:comment 'The business date on which the payment was received or initiated by the customer. This is the authoritative date for revenue recognition and aging calculations, distinct from posting or clearing dates.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paymentStatus rdf:type rdf:Property ;
    rdfs:label 'Payment Status' ;
    rdfs:comment 'Current lifecycle state of the payment transaction. Tracks progression from initial receipt through posting to general ledger, including exception states such as NSF (Non-Sufficient Funds) returns or reversals. [ENUM-REF-CANDIDATE: received|posted|cleared|returned|reversed|pending|failed — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Posted Timestamp' ;
    rdfs:comment 'Date and time when the payment was successfully posted to the customer account balance and general ledger. Null if payment has not yet been posted.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:processorName rdf:type rdf:Property ;
    rdfs:label 'Processor Name' ;
    rdfs:comment 'Name of the third-party payment processor or financial institution that handled the electronic payment transaction. Applicable to credit card, ACH, and EFT payments.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:processorTransactionReference rdf:type rdf:Property ;
    rdfs:label 'Processor Transaction Reference' ;
    rdfs:comment 'Unique transaction identifier assigned by the external payment processor or gateway. Used for reconciliation, dispute resolution, and chargeback processing.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receivedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Received Timestamp' ;
    rdfs:comment 'Precise date and time when the payment transaction was received by the utility system, including time zone offset. Used for audit trail and SLA compliance tracking.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:reversalDate rdf:type rdf:Property ;
    rdfs:label 'Reversal Date' ;
    rdfs:comment 'Business date on which the payment was reversed or returned by the financial institution or payment processor. Null if payment has not been reversed.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reversalReason rdf:type rdf:Property ;
    rdfs:label 'Reversal Reason' ;
    rdfs:comment 'Free-text or coded explanation for why a payment was reversed or returned. Common reasons include Non-Sufficient Funds (NSF), account closed, stop payment, unauthorized transaction, or administrative error. Null if payment has not been reversed.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thirdPartyAgencyName rdf:type rdf:Property ;
    rdfs:label 'Third Party Agency Name' ;
    rdfs:comment 'Name of the external agency or authorized payment location that accepted the payment on behalf of the utility. Examples include retail payment centers, community action agencies, or government assistance programs. Null for direct payments.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:token rdf:type rdf:Property ;
    rdfs:label 'Token' ;
    rdfs:comment 'Tokenized representation of sensitive payment instrument data (credit card number, bank account number) issued by the payment processor or tokenization service. Used for recurring payments and PCI DSS compliance.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unappliedAmount rdf:type rdf:Property ;
    rdfs:label 'Unapplied Amount' ;
    rdfs:comment 'The portion of the payment amount that remains unapplied or held in suspense, typically due to account discrepancies, overpayment, or pending dispute resolution. Zero if payment is fully applied.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:associatedCollectionsActionId rdf:type rdf:Property ;
    rdfs:label 'Associated Collections Action Id' ;
    rdfs:comment 'Reference to the collections action or case that prompted this payment arrangement. Null if arrangement was proactively requested by customer rather than initiated through collections workflow.' ;
    rdfs:domain ind:Billing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CollectionsAction .

ind:actualCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Actual Completion Date' ;
    rdfs:comment 'Actual date when the arrangement was fully satisfied and all deferred amounts paid. Null if arrangement is still active, broken, or cancelled. May differ from arrangement_end_date if customer paid early or late.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:approvalDate rdf:type rdf:Property ;
    rdfs:label 'Approval Date' ;
    rdfs:comment 'Date when the payment arrangement was formally approved by the utility. May differ from arrangement_start_date if down payment is required before activation.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:arrangementEndDate rdf:type rdf:Property ;
    rdfs:label 'Arrangement End Date' ;
    rdfs:comment 'Scheduled date when the final installment is due and the arrangement is expected to be completed. Calculated from start date plus (number_of_installments * installment_frequency).' ;
    rdfs:domain ind:PaymentArrangement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:arrangementNotes rdf:type rdf:Property ;
    rdfs:label 'Arrangement Notes' ;
    rdfs:comment 'Free-text field for customer service representatives to document special terms, customer circumstances, or other contextual information relevant to the arrangement. Not displayed to customer.' ;
    rdfs:domain ind:PaymentArrangement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:arrangementNumber rdf:type rdf:Property ;
    rdfs:label 'Arrangement Number' ;
    rdfs:comment 'Externally visible unique business identifier for the payment arrangement, typically displayed on customer correspondence and used in customer service interactions.' ;
    rdfs:domain ind:PaymentArrangement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:arrangementStartDate rdf:type rdf:Property ;
    rdfs:label 'Arrangement Start Date' ;
    rdfs:comment 'Effective date when the payment arrangement becomes active and the first installment is due. Typically the date down payment is received or arrangement is approved.' ;
    rdfs:domain ind:PaymentArrangement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:arrangementStatus rdf:type rdf:Property ;
    rdfs:label 'Arrangement Status' ;
    rdfs:comment 'Current lifecycle state of the payment arrangement. Pending: awaiting approval or down payment. Active: in good standing with payments current. Broken: customer missed payment(s) per terms. Completed: all installments paid. Cancelled: arrangement terminated by utility or customer. Suspended: temporarily paused.' ;
    rdfs:domain ind:PaymentArrangement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:arrangementType rdf:type rdf:Property ;
    rdfs:label 'Arrangement Type' ;
    rdfs:comment 'Classification of the payment arrangement plan. Budget billing spreads annual costs evenly; levelized payment smooths seasonal variation; low-income assistance provides subsidized payment terms; collections installment addresses past-due balances; deferred payment postpones a portion of charges; custom represents negotiated terms.' ;
    rdfs:domain ind:PaymentArrangement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autoPayEnrolled rdf:type rdf:Property ;
    rdfs:label 'Auto Pay Enrolled' ;
    rdfs:comment 'Indicates whether the customer has enrolled in automatic payment for installments via bank draft or credit card. Auto-pay enrollment often reduces the risk of arrangement default.' ;
    rdfs:domain ind:PaymentArrangement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:brokenDate rdf:type rdf:Property ;
    rdfs:label 'Broken Date' ;
    rdfs:comment 'Date when the arrangement was marked as broken due to non-compliance with payment terms. Triggers collections workflow and potential service disconnection per tariff rules.' ;
    rdfs:domain ind:PaymentArrangement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cancellationReason rdf:type rdf:Property ;
    rdfs:label 'Cancellation Reason' ;
    rdfs:comment 'Reason code explaining why the arrangement was cancelled before completion. Used for reporting and policy analysis.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cancelledDate rdf:type rdf:Property ;
    rdfs:label 'Cancelled Date' ;
    rdfs:comment 'Date when the arrangement was cancelled by the utility or customer before completion. Remaining balance typically becomes immediately due.' ;
    rdfs:domain ind:PaymentArrangement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:downPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Down Payment Amount' ;
    rdfs:comment 'Initial payment required to establish the arrangement, typically a percentage of the total deferred amount as mandated by state Public Utility Commission (PUC) rules or utility policy. Expressed in USD.' ;
    rdfs:domain ind:PaymentArrangement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:installmentAmount rdf:type rdf:Property ;
    rdfs:label 'Installment Amount' ;
    rdfs:comment 'Fixed amount due per installment period, calculated as (total_deferred_amount - down_payment_amount) / number_of_installments. May be adjusted for final installment to account for rounding. Expressed in USD.' ;
    rdfs:domain ind:PaymentArrangement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:installmentFrequency rdf:type rdf:Property ;
    rdfs:label 'Installment Frequency' ;
    rdfs:comment 'Cadence at which installment payments are due. Monthly is most common for residential customers; other frequencies may be used for commercial accounts or special assistance programs.' ;
    rdfs:domain ind:PaymentArrangement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:installmentsMissed rdf:type rdf:Property ;
    rdfs:label 'Installments Missed' ;
    rdfs:comment 'Count of scheduled installment payments that were not received by the due date. Exceeding the allowed threshold (typically 1-2 missed payments) triggers arrangement_status transition to broken.' ;
    rdfs:domain ind:PaymentArrangement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:installmentsPaid rdf:type rdf:Property ;
    rdfs:label 'Installments Paid' ;
    rdfs:comment 'Count of installment payments successfully received and applied to the arrangement. Used to track compliance with payment schedule.' ;
    rdfs:domain ind:PaymentArrangement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:interestAccrued rdf:type rdf:Property ;
    rdfs:label 'Interest Accrued' ;
    rdfs:comment 'Total interest charges accrued on the deferred balance to date. Zero if interest_rate is zero. Expressed in USD.' ;
    rdfs:domain ind:PaymentArrangement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interestRate rdf:type rdf:Property ;
    rdfs:label 'Interest Rate' ;
    rdfs:comment 'Annual interest rate applied to the deferred balance, if any. Expressed as a decimal (e.g., 0.0500 for 5%). Many jurisdictions prohibit interest on residential payment arrangements; commercial arrangements may include interest per tariff.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nextInstallmentDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Installment Due Date' ;
    rdfs:comment 'Date when the next scheduled installment payment is due. Updated after each payment is received. Null when arrangement is completed, broken, or cancelled.' ;
    rdfs:domain ind:PaymentArrangement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:notificationPreference rdf:type rdf:Property ;
    rdfs:label 'Notification Preference' ;
    rdfs:comment 'Customer\'s preferred channel for receiving payment reminders and arrangement status notifications. Used by Customer Information System (CIS) to trigger communications.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:numberOfInstallments rdf:type rdf:Property ;
    rdfs:label 'Number Of Installments' ;
    rdfs:comment 'Total count of scheduled installment payments over the life of the arrangement. Typically ranges from 3 to 24 months depending on arrangement type and regulatory constraints.' ;
    rdfs:domain ind:PaymentArrangement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:programCode rdf:type rdf:Property ;
    rdfs:label 'Program Code' ;
    rdfs:comment 'Code identifying the low-income assistance program, demand-side management (DSM) program, or special rate program under which this arrangement was established. Examples: LIHEAP, CARE, FERA. Null for standard arrangements.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remainingBalance rdf:type rdf:Property ;
    rdfs:label 'Remaining Balance' ;
    rdfs:comment 'Current outstanding balance under the arrangement after applying all payments received to date. Decreases with each installment payment. Zero when arrangement is completed. Expressed in USD.' ;
    rdfs:domain ind:PaymentArrangement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalDeferredAmount rdf:type rdf:Property ;
    rdfs:label 'Total Deferred Amount' ;
    rdfs:comment 'Total outstanding balance being deferred under this arrangement at the time of establishment, including principal charges, late fees, and any applicable interest. Expressed in USD.' ;
    rdfs:domain ind:PaymentArrangement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateScheduleId rdf:type rdf:Property ;
    rdfs:label 'Rate Schedule Id' ;
    rdfs:comment 'Primary key for rate_schedule' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RateSchedule .

ind:pricingNodeId rdf:type rdf:Property ;
    rdfs:label 'Pricing Node Id' ;
    rdfs:comment 'Foreign key linking to market.pricing_node. Business justification: Utilities in restructured markets with nodal pricing or location-based rates tie rate schedules to specific pricing nodes for pass-through of locational marginal pricing. Essential for real-time prici' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PricingNode .

ind:supersededByRateScheduleId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Rate Schedule Id' ;
    rdfs:comment 'Foreign key reference to the rate schedule that supersedes this one. Nullable if this is the current active version. Used to maintain rate schedule lineage and support customer migration from old to new schedules.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RateSchedule .

ind:baseEnergyRate rdf:type rdf:Property ;
    rdfs:label 'Base Energy Rate' ;
    rdfs:comment 'Base rate per unit of energy consumption (dollars per kWh for electric, dollars per Therm or MCF for gas). Excludes riders, surcharges, and adjustments. Represents the foundational commodity charge before layering FAC and other regulatory adjustments.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:customerCharge rdf:type rdf:Property ;
    rdfs:label 'Customer Charge' ;
    rdfs:comment 'Fixed monthly charge per customer account, independent of consumption. Covers meter reading, billing, and customer service costs. Expressed in dollars per month.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:demandChargeRate rdf:type rdf:Property ;
    rdfs:label 'Demand Charge Rate' ;
    rdfs:comment 'Rate per unit of peak demand (dollars per kW or MW). Applicable to commercial and industrial rate schedules with demand-based pricing. Nullable for residential and other non-demand schedules.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:demandChargeUom rdf:type rdf:Property ;
    rdfs:label 'Demand Charge Uom' ;
    rdfs:comment 'Unit of measure for the demand charge: kW (kilowatt) or MW (megawatt). Applicable only when demand_charge_rate is populated.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityCriteria rdf:type rdf:Property ;
    rdfs:label 'Eligibility Criteria' ;
    rdfs:comment 'Textual description of customer eligibility requirements for enrollment in this rate schedule. May include minimum/maximum usage thresholds, service type requirements, or geographic restrictions.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:energyRateUom rdf:type rdf:Property ;
    rdfs:label 'Energy Rate Uom' ;
    rdfs:comment 'Unit of measure for the base energy rate: kWh (kilowatt-hour) or MWh (megawatt-hour) for electric, Therm or MCF (thousand cubic feet) or CCF (hundred cubic feet) for gas.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interruptibleFlag rdf:type rdf:Property ;
    rdfs:label 'Interruptible Flag' ;
    rdfs:comment 'Indicates whether this rate schedule is for interruptible service, where the utility may curtail service during peak demand or emergencies in exchange for lower rates. True for interruptible schedules; False for firm service.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minimumCharge rdf:type rdf:Property ;
    rdfs:label 'Minimum Charge' ;
    rdfs:comment 'Minimum total charge per billing cycle regardless of consumption. Ensures cost recovery for low-usage customers. Nullable if no minimum applies.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netMeteringEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Net Metering Eligible Flag' ;
    rdfs:comment 'Indicates whether customers on this rate schedule are eligible for Net Energy Metering (NEM) programs, allowing bidirectional energy flow and credit for excess generation from DER (Distributed Energy Resources) such as rooftop solar.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rateCaseDocket rdf:type rdf:Property ;
    rdfs:label 'Rate Case Docket' ;
    rdfs:comment 'PUC docket number of the rate case proceeding that established or last modified this rate schedule. Used to trace rate design back to cost-of-service studies and regulatory decisions.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateCode rdf:type rdf:Property ;
    rdfs:label 'Rate Code' ;
    rdfs:comment 'Unique alphanumeric code identifying the rate schedule in the tariff book. Used as the business identifier for rate lookup in billing calculations. Examples: RES-TOU-1, COM-DEMAND-A, IND-SPECIAL-3.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateName rdf:type rdf:Property ;
    rdfs:label 'Rate Name' ;
    rdfs:comment 'Human-readable name of the rate schedule as published in the tariff. Examples: Residential Time-of-Use Schedule A, Commercial Demand Rate, Industrial Interruptible Service.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateScheduleDescription rdf:type rdf:Property ;
    rdfs:label 'Rate Schedule Description' ;
    rdfs:comment 'Detailed textual description of the rate schedule, including eligibility criteria, service characteristics, and any special terms or conditions. Sourced from the tariff filing.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateScheduleStatus rdf:type rdf:Property ;
    rdfs:label 'Rate Schedule Status' ;
    rdfs:comment 'Current lifecycle status of the rate schedule. Active schedules are available for new enrollments and billing. Pending approval schedules await PUC approval. Superseded schedules have been replaced by newer versions. Retired schedules are no longer offered.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateStructureType rdf:type rdf:Property ;
    rdfs:label 'Rate Structure Type' ;
    rdfs:comment 'Pricing structure methodology: flat (single rate), tiered (increasing block rates), TOU (Time-of-Use with period-based pricing), CPP (Critical Peak Pricing), demand (based on peak kW), real-time pricing (hourly market-based), or net metering (bidirectional energy credit). [ENUM-REF-CANDIDATE: flat|tiered|tou|cpp|demand|real_time_pricing|net_metering — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seasonalDefinition rdf:type rdf:Property ;
    rdfs:label 'Seasonal Definition' ;
    rdfs:comment 'JSON or delimited string defining seasonal periods and associated rate adjustments. Example: Summer (June-September): base rate + $0.03/kWh; Winter (October-May): base rate. Nullable if seasonal_variation_flag is False.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seasonalVariationFlag rdf:type rdf:Property ;
    rdfs:label 'Seasonal Variation Flag' ;
    rdfs:comment 'Indicates whether this rate schedule has seasonal rate variations (e.g., summer vs. winter rates). True if rates vary by season; False if rates are constant year-round.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:specialContractFlag rdf:type rdf:Property ;
    rdfs:label 'Special Contract Flag' ;
    rdfs:comment 'Indicates whether this rate schedule is a special contract rate negotiated individually with a large customer (typically industrial or commercial) rather than a standard tariff rate. True for special contracts; False for standard tariff schedules.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tierStructureDefinition rdf:type rdf:Property ;
    rdfs:label 'Tier Structure Definition' ;
    rdfs:comment 'JSON or delimited string defining tiered rate blocks for tiered rate structures. Example: Tier 1: 0-500 kWh at $0.10/kWh; Tier 2: 501-1000 kWh at $0.12/kWh; Tier 3: 1001+ kWh at $0.15/kWh. Nullable for non-tiered schedules.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:touPeriodDefinition rdf:type rdf:Property ;
    rdfs:label 'Tou Period Definition' ;
    rdfs:comment 'JSON or delimited string defining TOU pricing periods and rates. Example: On-Peak (2pm-8pm weekdays): $0.25/kWh; Off-Peak (all other hours): $0.08/kWh; Super Off-Peak (midnight-6am): $0.05/kWh. Nullable for non-TOU schedules.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:voltageLevel rdf:type rdf:Property ;
    rdfs:label 'Voltage Level' ;
    rdfs:comment 'Voltage level at which service is delivered. Primary (distribution voltage), Secondary (customer voltage), Transmission (high voltage bulk), Sub-Transmission (intermediate voltage). Affects rate level due to cost-of-service differences.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentAccountId rdf:type rdf:Property ;
    rdfs:label 'Parent Account Id' ;
    rdfs:comment 'Foreign key reference to the parent account in a hierarchical account structure. Used for corporate customers with multiple locations or master-metered properties with sub-accounts. Null for standalone accounts. Enables consolidated billing and reporting.' ;
    rdfs:domain ind:Customer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Account .

ind:accountNumber rdf:type rdf:Property ;
    rdfs:label 'Account Number' ;
    rdfs:comment 'Externally visible, human-readable account number assigned by the Customer Information System (CIS). Used on bills, customer correspondence, and customer service interactions. Unique across all accounts.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountStatus rdf:type rdf:Property ;
    rdfs:label 'Account Status' ;
    rdfs:comment 'Current lifecycle status of the account. Active: account is open and receiving service; Inactive: service temporarily suspended but account remains open; Pending: account application submitted but not yet activated; Final: final bill issued, awaiting closure; Closed: account permanently closed with zero balance; Written-off: account closed with uncollectible balance transferred to bad debt.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountType rdf:type rdf:Property ;
    rdfs:label 'Account Type' ;
    rdfs:comment 'Classification of the account based on customer segment and service characteristics. Determines applicable rate schedules, billing cycles, and regulatory reporting categories. Residential serves single-family and multi-family dwellings; small commercial serves small businesses under demand thresholds; large commercial serves businesses above demand thresholds; industrial serves manufacturing and heavy industry; street lighting serves municipal and private street lighting; unmetered serves fixed-load services without metering.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingCycleCode rdf:type rdf:Property ;
    rdfs:label 'Billing Cycle Code' ;
    rdfs:comment 'Code identifying the billing cycle (meter reading and bill generation schedule) assigned to this account. Determines the monthly meter read date, bill generation date, and payment due date. Typically organized by geographic route or customer segment.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closeDate rdf:type rdf:Property ;
    rdfs:label 'Close Date' ;
    rdfs:comment 'Date the account was permanently closed. Null for active accounts. Populated when the customer terminates service and all final billing is complete. Used for churn analysis and regulatory reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:demandResponseEnrolledFlag rdf:type rdf:Property ;
    rdfs:label 'Demand Response Enrolled Flag' ;
    rdfs:comment 'Indicates whether the account is enrolled in one or more Demand Response (DR) programs that provide incentives for reducing or shifting electricity usage during peak demand periods. True if enrolled; False otherwise. Supports grid reliability and peak load management.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disconnectStatus rdf:type rdf:Property ;
    rdfs:label 'Disconnect Status' ;
    rdfs:comment 'Current service disconnection status of the account. Connected: service is active; Pending disconnect: disconnection order issued but not yet executed; Disconnected: service physically disconnected for non-payment or customer request; Reconnect pending: payment received, reconnection order issued but not yet executed.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:electricVehicleFlag rdf:type rdf:Property ;
    rdfs:label 'Electric Vehicle Flag' ;
    rdfs:comment 'Indicates whether the account is enrolled in an Electric Vehicle (EV) rate program or has registered an EV charging installation. True if enrolled or registered; False otherwise. EV programs typically offer lower off-peak rates to encourage overnight charging.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:energyEfficiencyProgramFlag rdf:type rdf:Property ;
    rdfs:label 'Energy Efficiency Program Flag' ;
    rdfs:comment 'Indicates whether the account has participated in utility-sponsored Energy Efficiency (EE) programs such as home energy audits, appliance rebates, or weatherization assistance. True if participated; False otherwise. Supports regulatory EE portfolio standards and customer engagement tracking.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:finalBillDate rdf:type rdf:Property ;
    rdfs:label 'Final Bill Date' ;
    rdfs:comment 'Date the final bill was issued for the account. Typically precedes account_close_date. Used to track the completion of billing obligations and the transition to account closure.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:languagePreference rdf:type rdf:Property ;
    rdfs:label 'Language Preference' ;
    rdfs:comment 'Preferred language for customer communications, bills, and notices. Uses ISO 639-1 two-letter language codes. en=English, es=Spanish, zh=Chinese, vi=Vietnamese, ko=Korean, tl=Tagalog. Supports regulatory requirements for multilingual customer service in diverse service territories.' ;
    rdfs:domain ind:Customer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lowIncomeAssistanceFlag rdf:type rdf:Property ;
    rdfs:label 'Low Income Assistance Flag' ;
    rdfs:comment 'Indicates whether the account is enrolled in a low-income energy assistance program such as CARE (California Alternate Rates for Energy) or LIHEAP (Low Income Home Energy Assistance Program). True if enrolled; False otherwise. Provides discounted rates and additional disconnection protections.' ;
    rdfs:domain ind:Customer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicalBaselineFlag rdf:type rdf:Property ;
    rdfs:label 'Medical Baseline Flag' ;
    rdfs:comment 'Indicates whether the account is enrolled in a medical baseline program that provides additional energy allowances at lower rates for customers with qualifying medical conditions. True if enrolled; False otherwise. Enrollment requires physician certification and is subject to annual recertification.' ;
    rdfs:domain ind:Customer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:netMeteringFlag rdf:type rdf:Property ;
    rdfs:label 'Net Metering Flag' ;
    rdfs:comment 'Indicates whether the account is enrolled in a Net Energy Metering (NEM) program for customers with on-site distributed energy resources (DER) such as solar photovoltaic systems. True if enrolled; False otherwise. NEM customers receive bill credits for excess generation exported to the grid.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:openDate rdf:type rdf:Property ;
    rdfs:label 'Open Date' ;
    rdfs:comment 'Date the account was first opened and activated for service. Represents the start of the contractual relationship between the customer and the utility. Used for customer tenure analysis and regulatory reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:serviceTerritoryCode rdf:type rdf:Property ;
    rdfs:label 'Service Territory Code' ;
    rdfs:comment 'Code identifying the geographic service territory or operating division where the account is located. Used for regulatory reporting, operational planning, and cost allocation. May correspond to PUC-defined service areas or internal utility divisions.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxExemptFlag rdf:type rdf:Property ;
    rdfs:label 'Tax Exempt Flag' ;
    rdfs:comment 'Indicates whether the account is exempt from utility taxes and surcharges. True if tax-exempt (e.g., government entities, non-profit organizations with valid exemption certificates); False otherwise. Requires documentation of tax-exempt status.' ;
    rdfs:domain ind:Account ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:timeOfUseFlag rdf:type rdf:Property ;
    rdfs:label 'Time Of Use Flag' ;
    rdfs:comment 'Indicates whether the account is on a Time-of-Use (TOU) rate schedule with different energy prices for peak, off-peak, and shoulder periods. True if on TOU rate; False if on flat rate. Requires interval metering (AMI) for accurate time-differentiated billing.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:accountHierarchyId rdf:type rdf:Property ;
    rdfs:label 'Account Hierarchy Id' ;
    rdfs:comment 'Unique identifier for the account hierarchy relationship record. Primary key for the account hierarchy entity.' ;
    rdfs:domain ind:AccountHierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:childAccountId rdf:type rdf:Property ;
    rdfs:label 'Child Account Id' ;
    rdfs:comment 'Identifier of the child account in the hierarchy. Represents the subordinate account whose billing and usage data may be aggregated to the parent account. Used for multi-site enterprises, individual units in master-metered buildings, and departmental accounts within large commercial and industrial (C&I) customers.' ;
    rdfs:domain ind:AccountHierarchy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Account .

ind:allocationPercentage rdf:type rdf:Property ;
    rdfs:label 'Allocation Percentage' ;
    rdfs:comment 'Fixed percentage used to allocate charges or usage from parent to child account when allocation method is fixed percentage. Value between 0.00 and 100.00. Sum of allocation percentages across all child accounts under a parent should equal 100.00. Used in master-metered multi-dwelling unit (MDU) billing and shared facility cost allocation.' ;
    rdfs:domain ind:AccountHierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:billingAggregationFlag rdf:type rdf:Property ;
    rdfs:label 'Billing Aggregation Flag' ;
    rdfs:comment 'Indicates whether billing amounts from the child account are aggregated into the parent account invoice. True enables consolidated billing statements for multi-site enterprises and property management companies. False maintains separate billing while preserving the hierarchical relationship for reporting purposes. Integrates with Oracle CC&B billing engine and Salesforce Energy & Utilities Cloud for key account management.' ;
    rdfs:domain ind:AccountHierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:prioritySequence rdf:type rdf:Property ;
    rdfs:label 'Priority Sequence' ;
    rdfs:comment 'Numeric ordering used to determine processing sequence when multiple hierarchy relationships exist for the same account. Lower numbers indicate higher priority. Used in complex organizational structures where an account may participate in multiple hierarchies (e.g., both a corporate umbrella and a property management relationship). Ensures deterministic billing and reporting behavior.' ;
    rdfs:domain ind:AccountHierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:relationshipOwner rdf:type rdf:Property ;
    rdfs:label 'Relationship Owner' ;
    rdfs:comment 'Name or identifier of the business user or key account manager responsible for managing this account hierarchy relationship. Used for customer relationship management (CRM) workflows in Salesforce Energy & Utilities Cloud. Supports large commercial and industrial (C&I) account management and enterprise customer service delivery.' ;
    rdfs:domain ind:AccountHierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usageAggregationFlag rdf:type rdf:Property ;
    rdfs:label 'Usage Aggregation Flag' ;
    rdfs:comment 'Indicates whether energy usage (kilowatt-hour (kWh) or thousand cubic feet (MCF) of gas) from the child account is aggregated into parent account usage reporting. True enables enterprise-level usage analysis for large commercial and industrial (C&I) customers. False maintains separate usage tracking. Supports demand response (DR) program enrollment, energy efficiency (EE) program participation, and Renewable Portfolio Standard (RPS) compliance reporting.' ;
    rdfs:domain ind:AccountHierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contactId rdf:type rdf:Property ;
    rdfs:label 'Contact Id' ;
    rdfs:comment 'Unique identifier for the contact record. Primary key for the contact entity.' ;
    rdfs:domain ind:Customer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Contact .

ind:alternateEmailAddress rdf:type rdf:Property ;
    rdfs:label 'Alternate Email Address' ;
    rdfs:comment 'Secondary email address for the contact. Provides redundancy for critical electronic communications.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alternatePhone rdf:type rdf:Property ;
    rdfs:label 'Alternate Phone' ;
    rdfs:comment 'Secondary telephone number for reaching the contact. Used as backup for critical communications when primary phone is unavailable.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alternatePhoneType rdf:type rdf:Property ;
    rdfs:label 'Alternate Phone Type' ;
    rdfs:comment 'Classification of the alternate phone number. Determines appropriate calling hours and communication protocols.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorizationEndDate rdf:type rdf:Property ;
    rdfs:label 'Authorization End Date' ;
    rdfs:comment 'Date when the contact\'s authorization to act on behalf of the account expires or was revoked. Nullable for indefinite authorizations. Required for third-party authorization compliance.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:authorizationStartDate rdf:type rdf:Property ;
    rdfs:label 'Authorization Start Date' ;
    rdfs:comment 'Date when the contact\'s authorization to act on behalf of the account became effective. Required for third-party authorization compliance under state PUC regulations.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contactRole rdf:type rdf:Property ;
    rdfs:label 'Contact Role' ;
    rdfs:comment 'Functional role of the contact within the account context. Determines which communications and notifications this contact should receive (e.g., billing notices, outage alerts, collections). [ENUM-REF-CANDIDATE: primary|billing|service|technical|emergency|legal|financial — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactStatus rdf:type rdf:Property ;
    rdfs:label 'Contact Status' ;
    rdfs:comment 'Current lifecycle status of the contact record. Determines whether the contact should receive communications and whether the record is valid for operational use.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:doNotCallFlag rdf:type rdf:Property ;
    rdfs:label 'Do Not Call Flag' ;
    rdfs:comment 'Indicates whether the contact has opted out of receiving telephone calls. Enforces compliance with FCC Telephone Consumer Protection Act (TCPA) and National Do Not Call Registry.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:doNotEmailFlag rdf:type rdf:Property ;
    rdfs:label 'Do Not Email Flag' ;
    rdfs:comment 'Indicates whether the contact has opted out of receiving email communications. Enforces compliance with CAN-SPAM Act and GDPR consent requirements.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:doNotMailFlag rdf:type rdf:Property ;
    rdfs:label 'Do Not Mail Flag' ;
    rdfs:comment 'Indicates whether the contact has opted out of receiving physical mail communications. Honors customer communication preferences.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:doNotSmsFlag rdf:type rdf:Property ;
    rdfs:label 'Do Not Sms Flag' ;
    rdfs:comment 'Indicates whether the contact has opted out of receiving SMS text messages. Enforces compliance with FCC TCPA for text messaging.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:emailAddress rdf:type rdf:Property ;
    rdfs:label 'Email Address' ;
    rdfs:comment 'Primary email address for electronic communication with the contact. Used for billing notifications, outage alerts, and account correspondence. Sourced from Salesforce Energy & Utilities Cloud Contact object and Oracle CC&B Person entity.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalContactCode rdf:type rdf:Property ;
    rdfs:label 'External Contact Code' ;
    rdfs:comment 'Unique identifier for this contact in the source system (e.g., Salesforce Contact ID, CC&B Person ID). Used for cross-system reconciliation and data lineage.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:firstName rdf:type rdf:Property ;
    rdfs:label 'First Name' ;
    rdfs:comment 'Given name of the contact individual. Used for personalized communication and identification. Required for regulatory customer-of-record reporting to state Public Utility Commissions (PUCs).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fullName rdf:type rdf:Property ;
    rdfs:label 'Full Name' ;
    rdfs:comment 'Complete concatenated name of the contact including first, middle, last, and suffix. Used for display purposes, correspondence, and outage notifications. Sourced from Salesforce Energy & Utilities Cloud Contact object.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isPrimaryContact rdf:type rdf:Property ;
    rdfs:label 'Is Primary Contact' ;
    rdfs:comment 'Indicates whether this contact is the primary contact for the associated account. Used to determine default recipient for account-level communications.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastName rdf:type rdf:Property ;
    rdfs:label 'Last Name' ;
    rdfs:comment 'Family name or surname of the contact individual. Used for formal identification and legal correspondence. Required for regulatory customer-of-record reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mailingAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Mailing Address Line1' ;
    rdfs:comment 'First line of the contact\'s mailing address. Used when the contact\'s correspondence address differs from the service premise address. Required for billing and legal notices.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mailingAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Mailing Address Line2' ;
    rdfs:comment 'Second line of the contact\'s mailing address for apartment, suite, or unit information.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mailingCity rdf:type rdf:Property ;
    rdfs:label 'Mailing City' ;
    rdfs:comment 'City name for the contact\'s mailing address.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mailingCountry rdf:type rdf:Property ;
    rdfs:label 'Mailing Country' ;
    rdfs:comment 'Three-letter ISO country code for the contact\'s mailing address. Supports international correspondence.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mailingPostalCode rdf:type rdf:Property ;
    rdfs:label 'Mailing Postal Code' ;
    rdfs:comment 'ZIP or postal code for the contact\'s mailing address. Used for mail delivery and geographic segmentation.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mailingState rdf:type rdf:Property ;
    rdfs:label 'Mailing State' ;
    rdfs:comment 'State or province code for the contact\'s mailing address. Two-letter abbreviation per USPS standards.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:middleName rdf:type rdf:Property ;
    rdfs:label 'Middle Name' ;
    rdfs:comment 'Middle name or initial of the contact individual. Optional field for complete name representation.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredContactMethod rdf:type rdf:Property ;
    rdfs:label 'Preferred Contact Method' ;
    rdfs:comment 'The contact\'s preferred channel for receiving communications from the utility. Used to route outage notifications, billing reminders, and service alerts. Supports regulatory requirements for customer communication preferences.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryPhone rdf:type rdf:Property ;
    rdfs:label 'Primary Phone' ;
    rdfs:comment 'Main telephone number for reaching the contact. Used for outage notifications, collections contact, and emergency communications. Must comply with FCC Telephone Consumer Protection Act (TCPA) for automated dialing.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryPhoneType rdf:type rdf:Property ;
    rdfs:label 'Primary Phone Type' ;
    rdfs:comment 'Classification of the primary phone number (mobile, home, work, fax). Determines appropriate calling hours and communication protocols under TCPA regulations.' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relationshipType rdf:type rdf:Property ;
    rdfs:label 'Relationship Type' ;
    rdfs:comment 'Defines the relationship of this contact to the account or party. Determines authorization level and communication rights. Critical for third-party authorization compliance under PUC regulations. [ENUM-REF-CANDIDATE: self|spouse|co_applicant|property_manager|landlord|authorized_third_party|emergency_contact|guarantor — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suffix rdf:type rdf:Property ;
    rdfs:label 'Suffix' ;
    rdfs:comment 'Generational or professional suffix appended to the contact name (e.g., Jr., Sr., III, PhD). Used for proper name formatting and formal communication. [ENUM-REF-CANDIDATE: Jr|Sr|II|III|IV|V|PhD|MD|Esq — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Contact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationDate rdf:type rdf:Property ;
    rdfs:label 'Verification Date' ;
    rdfs:comment 'Date when the contact information was last verified. Used to track data freshness and trigger re-verification workflows.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:verificationStatus rdf:type rdf:Property ;
    rdfs:label 'Verification Status' ;
    rdfs:comment 'Indicates whether the contact information has been verified through outbound communication or customer confirmation. Used to ensure data quality for critical communications.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditDepositId rdf:type rdf:Property ;
    rdfs:label 'Credit Deposit Id' ;
    rdfs:comment 'Unique system-generated identifier for the credit deposit record. Primary key for the credit deposit entity.' ;
    rdfs:domain ind:CreditDeposit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:journalEntryId rdf:type rdf:Property ;
    rdfs:label 'Journal Entry Id' ;
    rdfs:comment 'Foreign key linking to finance.journal_entry. Business justification: Deposit receipt, refund, and forfeiture transactions generate journal entries for financial recording. Required for audit trail, financial transaction reconciliation, and regulatory compliance. Links ' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:JournalEntry .

ind:primaryCreditAccountId rdf:type rdf:Property ;
    rdfs:label 'Primary Credit Account Id' ;
    rdfs:comment 'Reference to the customer account for which this deposit is held. Links deposit to the billing account in the Customer Information System (CIS).' ;
    rdfs:domain ind:CreditDeposit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Account .

ind:tertiaryCreditTransferToAccountId rdf:type rdf:Property ;
    rdfs:label 'Tertiary Credit Transfer To Account Id' ;
    rdfs:comment 'Reference to the destination account if this deposit was transferred to another customer account.' ;
    rdfs:domain ind:CreditDeposit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Account .

ind:accruedInterestAmount rdf:type rdf:Property ;
    rdfs:label 'Accrued Interest Amount' ;
    rdfs:comment 'Cumulative interest earned on the deposit from the received date through the current date. Calculated per PUC-mandated interest rate and compounding rules.' ;
    rdfs:domain ind:CreditDeposit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:appliedToBillDate rdf:type rdf:Property ;
    rdfs:label 'Applied To Bill Date' ;
    rdfs:comment 'Date when the deposit was applied to the customer\'s final bill or outstanding balance. Typically occurs at account closure or service disconnection.' ;
    rdfs:domain ind:CreditDeposit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:authorizationCode rdf:type rdf:Property ;
    rdfs:label 'Authorization Code' ;
    rdfs:comment 'Unique code or reference number for the deposit authorization transaction. Used for payment verification and fraud prevention.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentDate rdf:type rdf:Property ;
    rdfs:label 'Consent Date' ;
    rdfs:comment 'Date when customer consent for deposit collection was obtained. Part of regulatory compliance audit trail.' ;
    rdfs:domain ind:CreditDeposit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:consentMethod rdf:type rdf:Property ;
    rdfs:label 'Consent Method' ;
    rdfs:comment 'Channel through which customer consent was obtained. Determines documentation requirements and verification procedures.' ;
    rdfs:domain ind:CreditDeposit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentObtainedFlag rdf:type rdf:Property ;
    rdfs:label 'Consent Obtained Flag' ;
    rdfs:comment 'Indicates whether customer provided explicit consent for deposit collection. Required for regulatory compliance and customer protection.' ;
    rdfs:domain ind:CreditDeposit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:creditScoreAtAssessment rdf:type rdf:Property ;
    rdfs:label 'Credit Score At Assessment' ;
    rdfs:comment 'Customer\'s credit score at the time deposit requirement was assessed. Used to determine deposit amount and eligibility for waiver. Confidential business data.' ;
    rdfs:domain ind:CreditDeposit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:depositNumber rdf:type rdf:Property ;
    rdfs:label 'Deposit Number' ;
    rdfs:comment 'Externally visible unique business identifier for the deposit transaction. Used for customer communication and regulatory reporting.' ;
    rdfs:domain ind:CreditDeposit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depositReasonCode rdf:type rdf:Property ;
    rdfs:label 'Deposit Reason Code' ;
    rdfs:comment 'Code indicating the business reason why the deposit was required. Used for regulatory compliance reporting and customer service analysis.' ;
    rdfs:domain ind:CreditDeposit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depositStatus rdf:type rdf:Property ;
    rdfs:label 'Deposit Status' ;
    rdfs:comment 'Current lifecycle status of the deposit. Tracks the deposit from initial collection through final disposition (refund or application to account).' ;
    rdfs:domain ind:Customer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depositType rdf:type rdf:Property ;
    rdfs:label 'Deposit Type' ;
    rdfs:comment 'Classification of the deposit instrument or method used by the customer to provide security. Determines handling and refund procedures.' ;
    rdfs:domain ind:CreditDeposit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalDepositCode rdf:type rdf:Property ;
    rdfs:label 'External Deposit Code' ;
    rdfs:comment 'Unique identifier for this deposit in the source operational system (CIS). Enables cross-system reconciliation and data lineage tracking.' ;
    rdfs:domain ind:CreditDeposit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forfeitureDate rdf:type rdf:Property ;
    rdfs:label 'Forfeiture Date' ;
    rdfs:comment 'Date when the deposit was forfeited due to customer default, non-payment, or abandonment of service. Triggers revenue recognition per accounting standards.' ;
    rdfs:domain ind:CreditDeposit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:forfeitureReason rdf:type rdf:Property ;
    rdfs:label 'Forfeiture Reason' ;
    rdfs:comment 'Detailed explanation of why the deposit was forfeited. Required for regulatory reporting and customer dispute resolution.' ;
    rdfs:domain ind:CreditDeposit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastInterestCalculationDate rdf:type rdf:Property ;
    rdfs:label 'Last Interest Calculation Date' ;
    rdfs:comment 'Date when interest was most recently calculated and accrued to the deposit balance. Used for audit trail and regulatory compliance verification.' ;
    rdfs:domain ind:CreditDeposit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:receivedDate rdf:type rdf:Property ;
    rdfs:label 'Received Date' ;
    rdfs:comment 'Date when the utility received and recorded the deposit from the customer. Marks the start of interest accrual and holding period.' ;
    rdfs:domain ind:CreditDeposit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:refundAmount rdf:type rdf:Property ;
    rdfs:label 'Refund Amount' ;
    rdfs:comment 'Total amount refunded to the customer, including original deposit plus accrued interest. Null if deposit has not been refunded.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:refundCheckNumber rdf:type rdf:Property ;
    rdfs:label 'Refund Check Number' ;
    rdfs:comment 'Check number if deposit was refunded via paper check. Used for payment reconciliation and audit trail.' ;
    rdfs:domain ind:CreditDeposit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:refundDate rdf:type rdf:Property ;
    rdfs:label 'Refund Date' ;
    rdfs:comment 'Actual date when the deposit (plus accrued interest) was refunded to the customer. Null if deposit has not been refunded.' ;
    rdfs:domain ind:CreditDeposit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:refundEligibilityDate rdf:type rdf:Property ;
    rdfs:label 'Refund Eligibility Date' ;
    rdfs:comment 'Date when the customer becomes eligible for deposit refund based on payment history and regulatory holding period requirements (typically 12-24 months of on-time payments).' ;
    rdfs:domain ind:CreditDeposit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:refundMethod rdf:type rdf:Property ;
    rdfs:label 'Refund Method' ;
    rdfs:comment 'Method used to return the deposit to the customer. Determines processing workflow and reconciliation procedures.' ;
    rdfs:domain ind:CreditDeposit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waiverFlag rdf:type rdf:Property ;
    rdfs:label 'Waiver Flag' ;
    rdfs:comment 'Indicates whether the deposit requirement was waived based on credit evaluation, low-income assistance program, or other qualifying criteria.' ;
    rdfs:domain ind:CreditDeposit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:waiverReason rdf:type rdf:Property ;
    rdfs:label 'Waiver Reason' ;
    rdfs:comment 'Explanation of why deposit was waived. Required for regulatory compliance and internal audit.' ;
    rdfs:domain ind:CreditDeposit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:profitCenterId rdf:type rdf:Property ;
    rdfs:label 'Profit Center Id' ;
    rdfs:comment 'Foreign key linking to finance.profit_center. Business justification: Service agreements are assigned to profit centers for revenue recognition, margin tracking by service type/commodity, and regulatory reporting. Required for rate case cost studies, FERC Form 1 reporti' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProfitCenter .

ind:autopayEnrolledFlag rdf:type rdf:Property ;
    rdfs:label 'Autopay Enrolled Flag' ;
    rdfs:comment 'Indicates whether automatic payment is enabled for this service agreement. True if bills are automatically paid from a bank account or credit card, false otherwise. Reduces collection risk and improves cash flow.' ;
    rdfs:domain ind:CustomerServiceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contractedDemandKw rdf:type rdf:Property ;
    rdfs:label 'Contracted Demand Kw' ;
    rdfs:comment 'Maximum demand capacity contracted by the customer, measured in kilowatts. Used for demand-based billing and capacity planning. Applicable to commercial and industrial customers with demand charges. Null for residential and energy-only rate schedules.' ;
    rdfs:domain ind:CustomerServiceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:creditScore rdf:type rdf:Property ;
    rdfs:label 'Credit Score' ;
    rdfs:comment 'Credit score of the account holder at the time of service agreement initiation. Used for deposit determination and credit risk assessment. Typically FICO score range 300-850. May be null if credit check was waived or not performed.' ;
    rdfs:domain ind:CustomerServiceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:drProgramCodes rdf:type rdf:Property ;
    rdfs:label 'Dr Program Codes' ;
    rdfs:comment 'Comma-separated list of DR program codes in which this service agreement is enrolled. Examples: CPP (critical peak pricing), PTR (peak time rebate), DLC (direct load control), BIP (base interruptible program). Empty if not enrolled in any DR programs.' ;
    rdfs:domain ind:CustomerServiceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drProgramEnrolledFlag rdf:type rdf:Property ;
    rdfs:label 'Dr Program Enrolled Flag' ;
    rdfs:comment 'Indicates whether this service agreement is enrolled in one or more demand response programs. True if enrolled in any DR program, false otherwise. DR programs provide incentives for load curtailment during peak demand periods.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:estimatedAnnualUsageKwh rdf:type rdf:Property ;
    rdfs:label 'Estimated Annual Usage Kwh' ;
    rdfs:comment 'Estimated annual energy consumption for this service agreement in kilowatt-hours. Used for rate comparison, budget billing calculations, and load forecasting. Based on historical usage, premise characteristics, or customer-provided estimates. Null for gas-only service agreements.' ;
    rdfs:domain ind:CustomerServiceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedAnnualUsageTherms rdf:type rdf:Property ;
    rdfs:label 'Estimated Annual Usage Therms' ;
    rdfs:comment 'Estimated annual natural gas consumption for this service agreement in therms. One therm equals 100,000 BTU. Used for rate comparison, budget billing calculations, and supply planning. Based on historical usage or premise characteristics. Null for electric-only service agreements.' ;
    rdfs:domain ind:CustomerServiceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:evChargingFlag rdf:type rdf:Property ;
    rdfs:label 'Ev Charging Flag' ;
    rdfs:comment 'Indicates whether this service agreement is designated for electric vehicle charging service. True if the premise has registered EV charging equipment or is on an EV-specific rate schedule, false otherwise. Used for EV program tracking and grid planning.' ;
    rdfs:domain ind:CustomerServiceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:loadProfileType rdf:type rdf:Property ;
    rdfs:label 'Load Profile Type' ;
    rdfs:comment 'Standard load profile classification used for non-interval metered customers in settlement and forecasting. Represents typical consumption patterns for customer class. Used by MDMS for load research and unmetered consumption estimation.' ;
    rdfs:domain ind:CustomerServiceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meterReadFrequency rdf:type rdf:Property ;
    rdfs:label 'Meter Read Frequency' ;
    rdfs:comment 'Frequency at which meter readings are collected for billing purposes. Monthly for standard residential/commercial, bimonthly for some rural areas, quarterly for seasonal accounts, on-demand for special reads, AMI daily for advanced metering infrastructure with interval data collection.' ;
    rdfs:domain ind:CustomerServiceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nemProgramType rdf:type rdf:Property ;
    rdfs:label 'Nem Program Type' ;
    rdfs:comment 'Specific NEM program version or variant under which the customer is enrolled. NEM 1.0/2.0/3.0 represent successive tariff generations with different compensation structures. VNEM is virtual net metering for multi-tenant properties. Aggregate NEM allows multiple meters under one NEM agreement. None if not enrolled in NEM.' ;
    rdfs:domain ind:CustomerServiceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateClass rdf:type rdf:Property ;
    rdfs:label 'Rate Class' ;
    rdfs:comment 'High-level customer rate classification for regulatory reporting and revenue allocation. Residential for single-family and multi-family homes, commercial for small/medium business, industrial for large manufacturing and processing facilities, agricultural for farms and irrigation, street lighting for municipal lighting, public authority for government facilities.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:saNumber rdf:type rdf:Property ;
    rdfs:label 'Sa Number' ;
    rdfs:comment 'Externally visible business identifier for the service agreement. Used in customer communications and billing statements.' ;
    rdfs:domain ind:CustomerServiceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:saStatus rdf:type rdf:Property ;
    rdfs:label 'Sa Status' ;
    rdfs:comment 'Current lifecycle status of the service agreement. Active indicates service is being delivered and billed. Pending start indicates future-dated service initiation. Pending stop indicates scheduled service termination. Stopped indicates service has been terminated. Suspended indicates temporary service hold. Cancelled indicates agreement was voided before activation.' ;
    rdfs:domain ind:CustomerServiceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:saStatusReason rdf:type rdf:Property ;
    rdfs:label 'Sa Status Reason' ;
    rdfs:comment 'Detailed reason code or description explaining the current SA status. Examples: customer request, move out, non-payment disconnection, seasonal disconnect, construction delay, regulatory hold. Provides operational context for status transitions.' ;
    rdfs:domain ind:CustomerServiceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:saType rdf:type rdf:Property ;
    rdfs:label 'Sa Type' ;
    rdfs:comment 'Classification of the service agreement based on service characteristics. Standard for typical residential/commercial service, net metering for DER customers, demand response for DR program participants, interruptible for curtailable load, standby for backup service, street lighting for municipal lighting.' ;
    rdfs:domain ind:CustomerServiceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:servicePhase rdf:type rdf:Property ;
    rdfs:label 'Service Phase' ;
    rdfs:comment 'Electrical phase configuration of the service. Single phase for residential and small commercial, three phase for larger commercial and industrial loads requiring balanced power delivery. Not applicable for gas-only service agreements.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceVoltage rdf:type rdf:Property ;
    rdfs:label 'Service Voltage' ;
    rdfs:comment 'Nominal voltage level at which electric service is delivered to the customer premise. Measured in volts. Determines equipment requirements and rate applicability. Common values: 120/240V (residential), 480V (small commercial), 4.16kV-34.5kV (primary distribution), 69kV+ (transmission). Not applicable for gas-only service agreements. [ENUM-REF-CANDIDATE: 120|240|480|4160|12470|34500|69000|115000|138000|230000|345000|500000|765000 — 13 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialReadFlag rdf:type rdf:Property ;
    rdfs:label 'Special Read Flag' ;
    rdfs:comment 'Indicates whether this service agreement requires special meter reading procedures outside the standard billing cycle. True if special read is required (e.g., for move-in/move-out, disputed bills, or high-bill investigations), false for standard cycle reads.' ;
    rdfs:domain ind:CustomerServiceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tariffEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Tariff Effective Date' ;
    rdfs:comment 'Date when the current tariff version became effective for this service agreement. Used to determine applicable rates for billing periods and to track rate case impacts.' ;
    rdfs:domain ind:CustomerServiceAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:tariffVersion rdf:type rdf:Property ;
    rdfs:label 'Tariff Version' ;
    rdfs:comment 'Version identifier of the tariff book or rate schedule effective for this service agreement. Tracks regulatory-approved rate changes over time. Format varies by utility (e.g., 2024-01, v5.2, AL-123). Used to ensure correct rate application and regulatory compliance.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enrollmentId rdf:type rdf:Property ;
    rdfs:label 'Enrollment Id' ;
    rdfs:comment 'Unique identifier for the program enrollment record. Primary key for the enrollment entity.' ;
    rdfs:domain ind:Customer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Enrollment .

ind:autoRenewFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Renew Flag' ;
    rdfs:comment 'Indicates whether the enrollment automatically renews at expiration. True indicates enrollment will auto-renew unless customer opts out; False indicates enrollment requires explicit renewal action.' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:baselineUsageKwh rdf:type rdf:Property ;
    rdfs:label 'Baseline Usage Kwh' ;
    rdfs:comment 'Baseline energy usage in kilowatt-hours (kWh) established at enrollment. Used for Energy Efficiency (EE) program savings measurement, Demand Response (DR) baseline calculation, or medical baseline allowance determination.' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cancellationDate rdf:type rdf:Property ;
    rdfs:label 'Cancellation Date' ;
    rdfs:comment 'Date when the enrollment was cancelled by the utility or system. Nullable if enrollment was not utility-terminated. Distinct from opt_out_date which represents customer-initiated termination.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cancellationReasonCode rdf:type rdf:Property ;
    rdfs:label 'Cancellation Reason Code' ;
    rdfs:comment 'Code indicating the reason for enrollment cancellation. Examples include non-compliance, account closure, ineligibility discovered, program discontinued, customer request, or administrative error. Used for program performance analysis and regulatory reporting.' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:committedLoadReductionKw rdf:type rdf:Property ;
    rdfs:label 'Committed Load Reduction Kw' ;
    rdfs:comment 'Customer-committed load reduction capacity in kilowatts (kW) for Demand Response (DR) programs. Represents the amount of load the customer agrees to curtail during DR events. Used for DR program capacity planning and settlement.' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:discountPercentage rdf:type rdf:Property ;
    rdfs:label 'Discount Percentage' ;
    rdfs:comment 'Percentage discount applied to customer bills as a result of program enrollment. Applicable to low-income assistance programs such as CARE/FERA which provide percentage-based rate discounts. Expressed as a percentage (e.g., 20.00 for 20% discount).' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eligibilityStatus rdf:type rdf:Property ;
    rdfs:label 'Eligibility Status' ;
    rdfs:comment 'Status of eligibility verification for programs requiring qualification criteria. Verified indicates eligibility confirmed; Pending Verification indicates documentation submitted awaiting review; Not Verified indicates eligibility not yet confirmed; Ineligible indicates customer does not meet program criteria; Recertification Required indicates periodic re-verification needed (common for CARE/FERA low-income programs).' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Eligibility Verification Date' ;
    rdfs:comment 'Date when customer eligibility for the program was verified. Required for programs with qualification criteria such as CARE/FERA income verification, medical baseline certification, or EV ownership verification.' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:enrolledByUserCode rdf:type rdf:Property ;
    rdfs:label 'Enrolled By User Code' ;
    rdfs:comment 'Identifier of the system user or agent who processed the enrollment. Used for audit trail and enrollment quality tracking. May be customer self-service user ID, call center agent ID, or field service representative ID.' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enrollmentDate rdf:type rdf:Property ;
    rdfs:label 'Enrollment Date' ;
    rdfs:comment 'Date when the customer submitted the enrollment application or was enrolled in the program. Represents the business event timestamp for the enrollment request.' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:enrollmentStatus rdf:type rdf:Property ;
    rdfs:label 'Enrollment Status' ;
    rdfs:comment 'Current lifecycle status of the program enrollment. Pending indicates enrollment application submitted but not yet effective; Active indicates enrollment is in effect; Suspended indicates temporary hold due to non-compliance or account issues; Cancelled indicates customer-initiated or utility-initiated termination; Expired indicates enrollment term ended; Waitlisted indicates enrollment requested but program capacity full; Denied indicates enrollment application rejected due to ineligibility. [ENUM-REF-CANDIDATE: pending|active|suspended|cancelled|expired|waitlisted|denied — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incentiveAmount rdf:type rdf:Property ;
    rdfs:label 'Incentive Amount' ;
    rdfs:comment 'Monetary incentive or rebate amount associated with the enrollment. Applicable to Energy Efficiency (EE) rebate programs, Demand Response (DR) participation payments, or enrollment bonuses. Expressed in local currency (USD for US utilities).' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:monthlyCreditAmount rdf:type rdf:Property ;
    rdfs:label 'Monthly Credit Amount' ;
    rdfs:comment 'Fixed monthly credit amount applied to customer bills as a result of program enrollment. Applicable to programs providing fixed monthly bill credits. Expressed in local currency (USD for US utilities).' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:optOutDate rdf:type rdf:Property ;
    rdfs:label 'Opt Out Date' ;
    rdfs:comment 'Date when the customer voluntarily terminated or opted out of the program enrollment. Nullable if enrollment was not customer-terminated. Used for customer choice tracking and program retention analysis.' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:programName rdf:type rdf:Property ;
    rdfs:label 'Program Name' ;
    rdfs:comment 'Human-readable name of the utility program or tariff option. Provides business-friendly description of the program for customer communication and reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programType rdf:type rdf:Property ;
    rdfs:label 'Program Type' ;
    rdfs:comment 'Classification of the program category. Segments programs into major types for regulatory reporting and program management. Demand Response includes curtailment and load management programs; Energy Efficiency includes rebate and conservation programs; Rate Program includes TOU, CPP, and tiered pricing; Billing Preference includes paperless billing, auto-pay, and budget billing; Low Income Assistance includes CARE and FERA; Renewable Energy includes NEM, solar interconnection, and green pricing; Electric Vehicle includes EV charging rate programs; Medical Baseline includes medical necessity allowances. [ENUM-REF-CANDIDATE: demand_response|energy_efficiency|rate_program|billing_preference|low_income_assistance|renewable_energy|electric_vehicle|medical_baseline|other — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recertificationDueDate rdf:type rdf:Property ;
    rdfs:label 'Recertification Due Date' ;
    rdfs:comment 'Date by which the customer must recertify eligibility to maintain enrollment. Applicable to programs requiring periodic eligibility re-verification such as annual CARE/FERA income recertification or medical baseline renewal.' ;
    rdfs:domain ind:Customer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:termsAcceptedFlag rdf:type rdf:Property ;
    rdfs:label 'Terms Accepted Flag' ;
    rdfs:comment 'Indicates whether the customer accepted the program terms and conditions. True indicates terms accepted; False indicates terms not accepted. Required for programs with contractual obligations such as Demand Response (DR) curtailment commitments or Net Energy Metering (NEM) interconnection agreements.' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:termsAcceptedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Terms Accepted Timestamp' ;
    rdfs:comment 'Date and time when the customer accepted the program terms and conditions. Used for legal compliance and audit trail. Captured in ISO 8601 format with timezone.' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:waitlistPosition rdf:type rdf:Property ;
    rdfs:label 'Waitlist Position' ;
    rdfs:comment 'Position in the program waitlist queue when enrollment_status is waitlisted. Applicable to capacity-constrained programs such as Demand Response (DR) or pilot programs. Lower numbers indicate higher priority for enrollment when capacity becomes available.' ;
    rdfs:domain ind:Enrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:interactionId rdf:type rdf:Property ;
    rdfs:label 'Interaction Id' ;
    rdfs:comment 'Unique identifier for the customer interaction event. Primary key.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:agentPartyId rdf:type rdf:Property ;
    rdfs:label 'Agent Party Id' ;
    rdfs:comment 'Identifier of the customer service agent or representative who handled the interaction. May be null for self-service interactions.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:moveOrderId rdf:type rdf:Property ;
    rdfs:label 'Move Order Id' ;
    rdfs:comment 'Foreign key linking to customer.move_order. Business justification: Customer interactions frequently relate to move-in/move-out requests (scheduling, status inquiries, cancellations, address corrections). Linking interaction to move_order enables tracking of move-rela' ;
    rdfs:domain ind:Customer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MoveOrder .

ind:agentName rdf:type rdf:Property ;
    rdfs:label 'Agent Name' ;
    rdfs:comment 'Full name of the customer service agent who handled the interaction. Used for quality assurance and performance tracking.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:callbackCompletedFlag rdf:type rdf:Property ;
    rdfs:label 'Callback Completed Flag' ;
    rdfs:comment 'Indicates whether a requested callback was successfully completed. Null if no callback was requested.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:callbackRequestedFlag rdf:type rdf:Property ;
    rdfs:label 'Callback Requested Flag' ;
    rdfs:comment 'Indicates whether the customer requested a callback from the utility. Used for callback queue management.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complaintCategory rdf:type rdf:Property ;
    rdfs:label 'Complaint Category' ;
    rdfs:comment 'High-level classification of the complaint type. Required for state PUC (Public Utility Commission) customer complaint reporting. Null if complaint_flag is false.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complaintFlag rdf:type rdf:Property ;
    rdfs:label 'Complaint Flag' ;
    rdfs:comment 'Indicates whether the interaction was classified as a formal customer complaint. Used for PUC (Public Utility Commission) regulatory reporting.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contactReasonCode rdf:type rdf:Property ;
    rdfs:label 'Contact Reason Code' ;
    rdfs:comment 'Standardized code representing the detailed reason for customer contact. Supports granular categorization for root cause analysis and PUC (Public Utility Commission) reporting.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Contact Reason Description' ;
    rdfs:comment 'Human-readable description of the contact reason. Provides additional context beyond the standardized code.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerSatisfactionScore rdf:type rdf:Property ;
    rdfs:label 'Customer Satisfaction Score' ;
    rdfs:comment 'Customer satisfaction rating provided by the customer, typically on a scale of 1-5 or 1-10. Null if no feedback was collected.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:durationSeconds rdf:type rdf:Property ;
    rdfs:label 'Duration Seconds' ;
    rdfs:comment 'Total duration of the interaction in seconds. Calculated as the difference between start and end timestamps. Used for customer service performance metrics.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:endTimestamp rdf:type rdf:Property ;
    rdfs:label 'End Timestamp' ;
    rdfs:comment 'Date and time when the customer interaction concluded. Used to calculate interaction duration and agent handle time.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:escalationFlag rdf:type rdf:Property ;
    rdfs:label 'Escalation Flag' ;
    rdfs:comment 'Indicates whether the interaction was escalated to a supervisor, specialist, or higher tier of support.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:escalationReason rdf:type rdf:Property ;
    rdfs:label 'Escalation Reason' ;
    rdfs:comment 'Explanation of why the interaction was escalated. Null if escalation_flag is false.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:firstContactResolutionFlag rdf:type rdf:Property ;
    rdfs:label 'First Contact Resolution Flag' ;
    rdfs:comment 'Indicates whether the customer issue was fully resolved during the initial interaction without requiring follow-up. Key customer service performance indicator.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:inboundOutboundIndicator rdf:type rdf:Property ;
    rdfs:label 'Inbound Outbound Indicator' ;
    rdfs:comment 'Indicates whether the interaction was initiated by the customer (inbound) or by the utility (outbound). Used for contact center analytics.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interactionStatus rdf:type rdf:Property ;
    rdfs:label 'Interaction Status' ;
    rdfs:comment 'Current lifecycle status of the interaction or case. Tracks progression from initiation through resolution. [ENUM-REF-CANDIDATE: new|in_progress|pending_customer|pending_internal|resolved|closed|escalated|cancelled — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interactionType rdf:type rdf:Property ;
    rdfs:label 'Interaction Type' ;
    rdfs:comment 'Classification of the interaction purpose. Indicates the primary reason for customer contact or engagement.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:languageCode rdf:type rdf:Property ;
    rdfs:label 'Language Code' ;
    rdfs:comment 'Two-letter ISO 639-1 language code indicating the language used during the interaction. Supports multilingual customer service tracking.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:npsScore rdf:type rdf:Property ;
    rdfs:label 'Nps Score' ;
    rdfs:comment 'Net Promoter Score provided by the customer, typically on a scale of 0-10. Measures customer loyalty and likelihood to recommend. Null if not collected.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priorityLevel rdf:type rdf:Property ;
    rdfs:label 'Priority Level' ;
    rdfs:comment 'Priority classification assigned to the interaction based on urgency and impact. Drives case routing and SLA (Service Level Agreement) targets.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolutionCode rdf:type rdf:Property ;
    rdfs:label 'Resolution Code' ;
    rdfs:comment 'Standardized code indicating how the interaction was resolved. Used for first-call resolution metrics and quality tracking.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Service Order Number' ;
    rdfs:comment 'Reference number of any field service order or work order created as a result of this interaction. Null if no service order was generated.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaMetFlag rdf:type rdf:Property ;
    rdfs:label 'Sla Met Flag' ;
    rdfs:comment 'Indicates whether the interaction was resolved within the target SLA (Service Level Agreement) timeframe. Used for customer service performance reporting.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:slaTargetResolutionHours rdf:type rdf:Property ;
    rdfs:label 'Sla Target Resolution Hours' ;
    rdfs:comment 'Target number of hours within which this interaction type and priority should be resolved, per internal SLA (Service Level Agreement) standards.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:startTimestamp rdf:type rdf:Property ;
    rdfs:label 'Start Timestamp' ;
    rdfs:comment 'Date and time when the customer interaction began. Represents the moment the customer initiated contact or the utility initiated outreach.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:surveyResponseFlag rdf:type rdf:Property ;
    rdfs:label 'Survey Response Flag' ;
    rdfs:comment 'Indicates whether the customer completed a post-interaction survey. Used to track survey response rates.' ;
    rdfs:domain ind:Interaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:primaryMoveCurrentPremiseId rdf:type rdf:Property ;
    rdfs:label 'Primary Move Current Premise Id' ;
    rdfs:comment 'Reference to the premise from which the customer is moving or where service is being terminated. For move-in orders, this may be null.' ;
    rdfs:domain ind:MoveOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Premise .

ind:actualEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Actual Effective Date' ;
    rdfs:comment 'Actual date when the move order was completed and service transition occurred. Used for billing proration and regulatory reporting.' ;
    rdfs:domain ind:MoveOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appointmentDate rdf:type rdf:Property ;
    rdfs:label 'Appointment Date' ;
    rdfs:comment 'Scheduled date for the field appointment to complete the move order, if an appointment is required.' ;
    rdfs:domain ind:MoveOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appointmentRequiredIndicator rdf:type rdf:Property ;
    rdfs:label 'Appointment Required Indicator' ;
    rdfs:comment 'Flag indicating whether a field appointment is required to complete the move order. True when physical access to the premise or meter is needed, false for remote service activation.' ;
    rdfs:domain ind:MoveOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appointmentTimeWindow rdf:type rdf:Property ;
    rdfs:label 'Appointment Time Window' ;
    rdfs:comment 'Time window for the scheduled field appointment, typically expressed as a range such as 8AM-12PM or 1PM-5PM. Used to set customer expectations for field crew arrival.' ;
    rdfs:domain ind:MoveOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactEmail rdf:type rdf:Property ;
    rdfs:label 'Contact Email' ;
    rdfs:comment 'Email address to reach the customer regarding this move order. Used for appointment confirmations, status updates, and final billing notifications.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactPhone rdf:type rdf:Property ;
    rdfs:label 'Contact Phone' ;
    rdfs:comment 'Phone number to reach the customer regarding this move order. May differ from the primary customer phone number on file.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depositRequiredIndicator rdf:type rdf:Property ;
    rdfs:label 'Deposit Required Indicator' ;
    rdfs:comment 'Flag indicating whether a security deposit is required for this move order. Typically true for new customers, customers with poor credit history, or high-risk service locations.' ;
    rdfs:domain ind:MoveOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:finalReadDate rdf:type rdf:Property ;
    rdfs:label 'Final Read Date' ;
    rdfs:comment 'Date when the final meter read was or will be performed for move-out or transfer orders. Used to calculate final billing period and consumption.' ;
    rdfs:domain ind:MoveOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:finalReadIndicator rdf:type rdf:Property ;
    rdfs:label 'Final Read Indicator' ;
    rdfs:comment 'Flag indicating whether a final meter read is required for this move order. True for move-out and transfer orders where final billing is needed, false for move-in or name change orders.' ;
    rdfs:domain ind:MoveOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:forwardingAddress rdf:type rdf:Property ;
    rdfs:label 'Forwarding Address' ;
    rdfs:comment 'Mailing address where final bills and correspondence should be sent after service termination. Required for move-out orders to ensure customer receives final billing.' ;
    rdfs:domain ind:MoveOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastUpdatedBy rdf:type rdf:Property ;
    rdfs:label 'Last Updated By' ;
    rdfs:comment 'User ID or system identifier of the person or process that most recently modified the move order record. Used for audit trail and accountability.' ;
    rdfs:domain ind:MoveOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:moveOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Move Order Number' ;
    rdfs:comment 'Business-facing unique identifier for the move order, typically displayed to customers and customer service representatives. May follow utility-specific numbering conventions.' ;
    rdfs:domain ind:MoveOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:moveOrderStatus rdf:type rdf:Property ;
    rdfs:label 'Move Order Status' ;
    rdfs:comment 'Current lifecycle status of the move order. Pending indicates awaiting scheduling, scheduled means appointment set, in-progress indicates field work underway, completed means service transition finalized, cancelled means customer withdrew request, and rejected means utility denied the request.' ;
    rdfs:domain ind:MoveOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:moveType rdf:type rdf:Property ;
    rdfs:label 'Move Type' ;
    rdfs:comment 'Classification of the move order transaction type. Move-in establishes new service, move-out terminates service, transfer relocates service to a new premise, and name change updates account ownership without premise change.' ;
    rdfs:domain ind:MoveOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overlappingServiceCheckResult rdf:type rdf:Property ;
    rdfs:label 'Overlapping Service Check Result' ;
    rdfs:comment 'Result of the system check to detect overlapping service periods at the same premise. No-overlap indicates clean transition, overlap-detected indicates potential duplicate service, overlap-resolved indicates issue was addressed, and not-checked indicates validation was skipped.' ;
    rdfs:domain ind:MoveOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorityCode rdf:type rdf:Property ;
    rdfs:label 'Priority Code' ;
    rdfs:comment 'Priority level assigned to the move order for scheduling and processing. Standard indicates normal processing, expedited indicates faster service for a fee, emergency indicates same-day service for critical situations, and critical indicates life-support or public safety priority.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:processingChannel rdf:type rdf:Property ;
    rdfs:label 'Processing Channel' ;
    rdfs:comment 'Channel through which the move order was initiated. Web self-service indicates customer portal, call center indicates phone interaction, field indicates in-person or field crew initiation, third-party notification indicates landlord or property manager notification, mobile app indicates mobile application, and agent portal indicates customer service representative entry.' ;
    rdfs:domain ind:MoveOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rejectionReason rdf:type rdf:Property ;
    rdfs:label 'Rejection Reason' ;
    rdfs:comment 'Free-text or coded reason for move order rejection by the utility. May include credit issues, service availability constraints, regulatory restrictions, or incomplete customer information.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestedEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Requested Effective Date' ;
    rdfs:comment 'Date requested by the customer for the move order to take effect. This is the customer\'s desired service start or stop date.' ;
    rdfs:domain ind:MoveOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:scheduledEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Effective Date' ;
    rdfs:comment 'Date scheduled by the utility for the move order to be executed. May differ from requested date based on operational constraints, field crew availability, or regulatory notice requirements.' ;
    rdfs:domain ind:MoveOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sourceSystemKey rdf:type rdf:Property ;
    rdfs:label 'Source System Key' ;
    rdfs:comment 'Primary key or unique identifier of this move order in the source operational system. Used for data lineage and reconciliation with source systems.' ;
    rdfs:domain ind:MoveOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialInstructions rdf:type rdf:Property ;
    rdfs:label 'Special Instructions' ;
    rdfs:comment 'Free-text field for customer or utility staff to provide special instructions related to the move order. May include access instructions, safety concerns, or customer preferences.' ;
    rdfs:domain ind:MoveOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stopReasonCode rdf:type rdf:Property ;
    rdfs:label 'Stop Reason Code' ;
    rdfs:comment 'Reason code for service termination in move-out orders. Moved indicates customer relocation, deceased indicates customer death, foreclosure indicates property foreclosure, non-pay disconnect indicates service termination for non-payment, demolition indicates property demolition, and other captures miscellaneous reasons.' ;
    rdfs:domain ind:MoveOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessRegistrationNumber rdf:type rdf:Property ;
    rdfs:label 'Business Registration Number' ;
    rdfs:comment 'State or federal business registration number for commercial, industrial, and government entity parties. Used for business identity verification, credit checks, and regulatory reporting. May include state corporation number, DUNS number, or other official business identifiers.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditClass rdf:type rdf:Property ;
    rdfs:label 'Credit Class' ;
    rdfs:comment 'Credit risk classification based on credit bureau scores and payment history. Determines deposit requirements, payment plan eligibility, and disconnection risk. Supports revenue assurance and bad debt forecasting. Must comply with Fair Credit Reporting Act (FCRA) and Equal Credit Opportunity Act (ECOA).' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerSinceDate rdf:type rdf:Property ;
    rdfs:label 'Customer Since Date' ;
    rdfs:comment 'Date when the party first became a customer of the utility. Used for customer tenure analysis, loyalty program eligibility, and customer lifetime value calculations. Supports customer segmentation and retention analytics.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dateOfBirth rdf:type rdf:Property ;
    rdfs:label 'Date Of Birth' ;
    rdfs:comment 'Date of birth for individual parties. Used for identity verification, credit checks, and eligibility determination for low-income assistance programs and senior citizen rate discounts. Supports PUC customer protection requirements.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:doNotContactIndicator rdf:type rdf:Property ;
    rdfs:label 'Do Not Contact Indicator' ;
    rdfs:comment 'Flag indicating the party has requested no marketing or non-essential communication. Utility must honor this preference except for critical safety notifications, outage alerts, and mandatory regulatory communications. Supports TCPA compliance.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dunsNumber rdf:type rdf:Property ;
    rdfs:label 'Duns Number' ;
    rdfs:comment 'Nine-digit Dun & Bradstreet DUNS number for commercial and industrial parties. Used for credit evaluation, supplier qualification, and business identity verification. Standard business identifier for Enterprise Resource Planning (ERP) and supply chain systems.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalReferenceCode rdf:type rdf:Property ;
    rdfs:label 'External Reference Code' ;
    rdfs:comment 'External system identifier for the party from source systems such as Oracle CC&B customer number, SAP IS-U business partner ID, or Salesforce Account ID. Supports data integration and cross-system reconciliation. Multiple external IDs may be stored in related integration tables.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:identityVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Identity Verification Date' ;
    rdfs:comment 'Date when the party identity was last verified. Used to track verification currency and trigger re-verification workflows per utility security policies and SOX compliance requirements.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:identityVerificationStatus rdf:type rdf:Property ;
    rdfs:label 'Identity Verification Status' ;
    rdfs:comment 'Status of identity verification process for the party. Verified status is required before service activation. Supports Know Your Customer (KYC) requirements, fraud prevention, and SOX identity controls. Verification may include government-issued ID check, credit bureau validation, or utility bill history.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:industryCode rdf:type rdf:Property ;
    rdfs:label 'Industry Code' ;
    rdfs:comment 'North American Industry Classification System (NAICS) code for commercial and industrial parties. Used for load forecasting, rate design, economic development analysis, and regulatory reporting. Supports segmentation of commercial and industrial customer classes.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalName rdf:type rdf:Property ;
    rdfs:label 'Legal Name' ;
    rdfs:comment 'Full legal name of the party as registered with government authorities. For individuals, this is the name on government-issued identification. For organizations, this is the registered business name. Required for customer-of-record reporting to Public Utility Commission (PUC) and supports Sarbanes-Oxley Act (SOX) identity controls.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lifecycleStatus rdf:type rdf:Property ;
    rdfs:label 'Lifecycle Status' ;
    rdfs:comment 'Current lifecycle state of the party record. Active parties have one or more active service agreements. Inactive parties have no current service but retain historical records. Suspended parties are temporarily blocked from new service due to fraud or non-payment. Deceased status triggers estate handling procedures. Merged and duplicate statuses support master data management (MDM) consolidation.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lowIncomeAssistanceIndicator rdf:type rdf:Property ;
    rdfs:label 'Low Income Assistance Indicator' ;
    rdfs:comment 'Flag indicating the party is enrolled in low-income energy assistance programs such as Low Income Home Energy Assistance Program (LIHEAP) or utility-specific discount rates. Determines eligibility for reduced rates, payment plans, and disconnection protections mandated by PUC regulations.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:marketingOptInIndicator rdf:type rdf:Property ;
    rdfs:label 'Marketing Opt In Indicator' ;
    rdfs:comment 'Flag indicating the party has consented to receive marketing communications about energy efficiency (EE) programs, demand response (DR) enrollment, electric vehicle (EV) rates, and renewable energy options. Must comply with CAN-SPAM Act and Telephone Consumer Protection Act (TCPA) consent requirements.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:medicalBaselineIndicator rdf:type rdf:Property ;
    rdfs:label 'Medical Baseline Indicator' ;
    rdfs:comment 'Flag indicating the party has a medical condition requiring uninterrupted electric service for life-support equipment. Medical baseline customers receive additional kilowatt-hour (kWh) allowances at lower rates and are protected from disconnection. Mandated by state PUC regulations for customer protection.' ;
    rdfs:domain ind:Customer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mobilePhoneNumber rdf:type rdf:Property ;
    rdfs:label 'Mobile Phone Number' ;
    rdfs:comment 'Mobile telephone number for SMS notifications and mobile app authentication. Used for Advanced Metering Infrastructure (AMI) alerts, demand response program enrollment, and two-factor authentication in customer portals.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paperlessBillingIndicator rdf:type rdf:Property ;
    rdfs:label 'Paperless Billing Indicator' ;
    rdfs:comment 'Flag indicating the party has opted for electronic billing delivery instead of paper bills. Supports utility cost reduction initiatives and environmental sustainability goals. Electronic bills are delivered via email or customer portal.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:partyType rdf:type rdf:Property ;
    rdfs:label 'Party Type' ;
    rdfs:comment 'Classification of the party entity type. Determines applicable rate schedules, regulatory reporting categories, and service agreement terms. Residential individuals receive consumer protection under PUC regulations. Commercial and industrial customers may have different tariff structures and demand response eligibility.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:phoneNumber rdf:type rdf:Property ;
    rdfs:label 'Phone Number' ;
    rdfs:comment 'Primary contact telephone number for the party. Used for customer service calls, outage notifications, critical peak pricing (CPP) alerts, and emergency contact during service interruptions. Supports Federal Communications Commission (FCC) customer contact requirements.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxIdentifier rdf:type rdf:Property ;
    rdfs:label 'Tax Identifier' ;
    rdfs:comment 'Federal tax identification number. For individuals, this is the Social Security Number (SSN) stored in masked format. For businesses, this is the Employer Identification Number (EIN). Required for credit verification, collections, and Internal Revenue Service (IRS) reporting. Supports SOX financial controls and Generally Accepted Accounting Principles (GAAP) compliance.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vipIndicator rdf:type rdf:Property ;
    rdfs:label 'Vip Indicator' ;
    rdfs:comment 'Flag indicating the party is a VIP customer requiring special handling. VIP designation may apply to elected officials, critical infrastructure operators, medical baseline customers, or high-value commercial accounts. Triggers priority service restoration during outages and escalated customer service routing.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:preferenceId rdf:type rdf:Property ;
    rdfs:label 'Preference Id' ;
    rdfs:comment 'Unique identifier for the customer preference record. Primary key.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contactFrequencyLimit rdf:type rdf:Property ;
    rdfs:label 'Contact Frequency Limit' ;
    rdfs:comment 'The maximum frequency at which the customer wishes to receive communications for this preference category. Helps manage communication fatigue and supports customer experience optimization.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactTimeWindowEnd rdf:type rdf:Property ;
    rdfs:label 'Contact Time Window End' ;
    rdfs:comment 'The latest time of day (HH:MM format, 24-hour clock) the customer is willing to receive non-emergency communications. Used for outbound call scheduling and SMS delivery timing to comply with TCPA restrictions on contact hours.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactTimeWindowStart rdf:type rdf:Property ;
    rdfs:label 'Contact Time Window Start' ;
    rdfs:comment 'The earliest time of day (HH:MM format, 24-hour clock) the customer is willing to receive non-emergency communications. Used for outbound call scheduling and SMS delivery timing to comply with TCPA restrictions on contact hours.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryChannel rdf:type rdf:Property ;
    rdfs:label 'Delivery Channel' ;
    rdfs:comment 'The preferred communication channel through which the customer wishes to receive notifications for this preference category. Supports multi-channel customer engagement strategy.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalPreferenceCode rdf:type rdf:Property ;
    rdfs:label 'External Preference Code' ;
    rdfs:comment 'The unique identifier for this preference record in the source system (CC&B, Salesforce, SAP IS-U). Supports cross-system reconciliation and bidirectional synchronization.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isVerified rdf:type rdf:Property ;
    rdfs:label 'Is Verified' ;
    rdfs:comment 'Indicates whether the contact information associated with this preference has been verified through a confirmation process (e.g., double opt-in for email, SMS confirmation code). Critical for TCPA compliance and reducing communication delivery failures.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mobileDeviceToken rdf:type rdf:Property ;
    rdfs:label 'Mobile Device Token' ;
    rdfs:comment 'The push notification device token for mobile app notifications. Used by mobile notification services (APNS, FCM) to deliver push notifications to the customers registered mobile device.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationEmail rdf:type rdf:Property ;
    rdfs:label 'Notification Email' ;
    rdfs:comment 'The specific email address to use for this preference category if email is the selected delivery channel. May differ from the primary account email. Supports multi-email management for different communication types.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationPhone rdf:type rdf:Property ;
    rdfs:label 'Notification Phone' ;
    rdfs:comment 'The specific phone number to use for this preference category if SMS or IVR is the selected delivery channel. May differ from the primary account phone. Supports multi-phone management for different communication types. Format follows E.164 international standard.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:optInStatus rdf:type rdf:Property ;
    rdfs:label 'Opt In Status' ;
    rdfs:comment 'Indicates whether the customer has opted in or out of receiving communications for this preference category and channel combination. Critical for TCPA and CAN-SPAM compliance.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferenceCategory rdf:type rdf:Property ;
    rdfs:label 'Preference Category' ;
    rdfs:comment 'The type of communication or service preference being configured. Defines what kind of notification or communication this preference controls. [ENUM-REF-CANDIDATE: outage_alert|demand_response_notification|planned_outage_notification|billing_statement_ready|payment_confirmation|payment_reminder|marketing_communication|service_appointment_reminder|energy_usage_report|rate_change_notification|program_enrollment_confirmation — promote to reference product]' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferenceSource rdf:type rdf:Property ;
    rdfs:label 'Preference Source' ;
    rdfs:comment 'The channel or system through which this preference was originally captured or set. Supports audit trail and preference data lineage tracking.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredLanguage rdf:type rdf:Property ;
    rdfs:label 'Preferred Language' ;
    rdfs:comment 'The language in which the customer prefers to receive communications. Uses 3-letter ISO 639-2 language codes. Supports multilingual customer base and regulatory requirements for language access. [ENUM-REF-CANDIDATE: ENG|SPA|FRA|CHI|VIE|KOR|RUS|ARA|POR|GER — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:setTimestamp rdf:type rdf:Property ;
    rdfs:label 'Set Timestamp' ;
    rdfs:comment 'The date and time when this preference was originally established by the customer or system. Critical for TCPA and CAN-SPAM compliance audit trails demonstrating when consent was obtained.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:suppressionFlag rdf:type rdf:Property ;
    rdfs:label 'Suppression Flag' ;
    rdfs:comment 'Indicates whether this preference is currently suppressed due to delivery failures, compliance holds, or customer service blocks. When true, communications should not be sent regardless of opt-in status.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:suppressionReason rdf:type rdf:Property ;
    rdfs:label 'Suppression Reason' ;
    rdfs:comment 'The reason why communications are suppressed for this preference. Supports compliance with do-not-contact regulations and customer service escalation management.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suppressionStartDate rdf:type rdf:Property ;
    rdfs:label 'Suppression Start Date' ;
    rdfs:comment 'The date from which communication suppression became effective for this preference. Supports time-bound suppression management and audit trail.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:unsubscribeReason rdf:type rdf:Property ;
    rdfs:label 'Unsubscribe Reason' ;
    rdfs:comment 'Free-text field capturing the reason provided by the customer when opting out of a communication preference. Supports customer experience analysis and communication strategy improvement.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Verification Timestamp' ;
    rdfs:comment 'The date and time when the contact information for this preference was verified. Supports audit trail for double opt-in compliance and contact data quality management.' ;
    rdfs:domain ind:Preference ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:gasMainSegmentId rdf:type rdf:Property ;
    rdfs:label 'Gas Main Segment Id' ;
    rdfs:comment 'Identifier of the gas distribution main pipeline segment that serves this premise. Links premise to the gas distribution network for leak survey tracking, pipeline integrity management, pressure zone analysis, and emergency response planning. Sourced from GIS or Pipeline Management System.' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Segment .

ind:addressLine1 rdf:type rdf:Property ;
    rdfs:label 'Address Line 1' ;
    rdfs:comment 'Primary street address of the premise including house number, street name, and street type. First line of the physical service location address used for service delivery, emergency response, field crew dispatch, and regulatory customer-of-record reporting to state Public Utility Commissions.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:addressLine2 rdf:type rdf:Property ;
    rdfs:label 'Address Line 2' ;
    rdfs:comment 'Secondary address information such as apartment number, suite, unit, building, floor, or other location qualifier within a multi-tenant structure. Critical for accurate service delivery in multi-family dwellings and commercial complexes.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amiDeploymentStatus rdf:type rdf:Property ;
    rdfs:label 'Ami Deployment Status' ;
    rdfs:comment 'Status of advanced metering infrastructure deployment at the premise. AMI installed indicates two-way smart meter with interval data collection; AMR installed indicates one-way automated meter reading; manual read indicates traditional meter requiring field visit; pending deployment indicates scheduled future AMI installation. Used for meter data management system (MDMS) integration, interval data availability determination, and AMI deployment project tracking.' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:batteryCapacityKwh rdf:type rdf:Property ;
    rdfs:label 'Battery Capacity Kwh' ;
    rdfs:comment 'Energy storage capacity of installed battery system in kilowatt-hours (kWh). Represents the total energy that can be stored and discharged. Used for demand response program design, virtual power plant dispatch optimization, backup power duration calculation, and distribution grid services valuation. Sourced from DER interconnection agreements.' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:batteryStorageIndicator rdf:type rdf:Property ;
    rdfs:label 'Battery Storage Indicator' ;
    rdfs:comment 'Boolean flag indicating whether the premise has battery energy storage system (BESS) installed. True indicates battery storage; False indicates no storage. Used for demand response program enrollment, virtual power plant (VPP) aggregation, distribution grid services, and resilience analysis. Sourced from DER interconnection applications or customer enrollment data.' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:buildingSquareFootage rdf:type rdf:Property ;
    rdfs:label 'Building Square Footage' ;
    rdfs:comment 'Total conditioned floor area of the building at the premise in square feet. Used for energy efficiency program targeting, load forecasting normalization, rate design analysis, and benchmarking energy consumption intensity (kWh per square foot). Sourced from property tax records or customer self-reporting.' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:classification rdf:type rdf:Property ;
    rdfs:label 'Classification' ;
    rdfs:comment 'Detailed structural classification of the premise building type. Single-family indicates detached residential dwelling; multi-family indicates apartment complex or condominium building; MDU (Multi-Dwelling Unit) unit indicates individual apartment within a larger structure; commercial building indicates retail or office structure; industrial facility indicates manufacturing or warehouse; mixed-use indicates combined residential and commercial. Used for load profile assignment, AMI deployment planning, and demand response program eligibility.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:climateZone rdf:type rdf:Property ;
    rdfs:label 'Climate Zone' ;
    rdfs:comment 'Climate zone classification for the premise location based on heating degree days (HDD) and cooling degree days (CDD). Used for weather normalization of energy consumption, load forecasting model segmentation, energy efficiency program design, and building code compliance verification. Typically follows ASHRAE or Department of Energy climate zone definitions.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:constructionYear rdf:type rdf:Property ;
    rdfs:label 'Construction Year' ;
    rdfs:comment 'Year the building at the premise was originally constructed. Used for building vintage analysis, energy efficiency program targeting (older buildings typically have higher energy intensity), appliance saturation modeling, and demand-side management program design. Sourced from property tax records or building permit databases.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:coolingSystemType rdf:type rdf:Property ;
    rdfs:label 'Cooling System Type' ;
    rdfs:comment 'Type of air conditioning or cooling system installed at the premise. Central AC indicates whole-house central air conditioning; window AC indicates room air conditioners; heat pump indicates reversible heat pump system; evaporative cooler indicates swamp cooler; none indicates no cooling system. Used for peak demand forecasting, demand response program eligibility, and energy efficiency program targeting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:electricServiceTerritory rdf:type rdf:Property ;
    rdfs:label 'Electric Service Territory' ;
    rdfs:comment 'Designated electric service territory or district code where the premise is located. Determines the operating division responsible for electric distribution, applicable electric tariffs, and regulatory reporting segments. Aligns with FERC service territory definitions and state PUC jurisdictional boundaries.' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:electricVehicleIndicator rdf:type rdf:Property ;
    rdfs:label 'Electric Vehicle Indicator' ;
    rdfs:comment 'Boolean flag indicating whether the premise has an electric vehicle (EV) registered or EV charging equipment installed. True indicates EV presence; False indicates no EV. Used for EV rate program enrollment, managed charging program targeting, distribution transformer load planning, and transportation electrification analysis. Sourced from customer enrollment data or AMI load shape analysis.' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:floodZoneIndicator rdf:type rdf:Property ;
    rdfs:label 'Flood Zone Indicator' ;
    rdfs:comment 'Boolean flag indicating whether the premise is located in a FEMA-designated flood hazard area. True indicates flood zone location; False indicates non-flood zone. Used for infrastructure resilience planning, emergency preparedness, undergrounding prioritization, and climate adaptation strategy development. Sourced from FEMA Flood Insurance Rate Maps (FIRM).' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gasServiceTerritory rdf:type rdf:Property ;
    rdfs:label 'Gas Service Territory' ;
    rdfs:comment 'Designated gas service territory or district code where the premise is located. Determines the operating division responsible for gas distribution, applicable gas tariffs, and regulatory reporting segments. Aligns with Pipeline and Hazardous Materials Safety Administration (PHMSA) jurisdictional requirements.' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:heatingFuelType rdf:type rdf:Property ;
    rdfs:label 'Heating Fuel Type' ;
    rdfs:comment 'Primary fuel source used for space heating at the premise. Electric indicates electric resistance or heat pump; natural gas indicates gas furnace or boiler; propane indicates propane furnace; fuel oil indicates oil furnace; wood indicates wood stove or pellet stove. Critical for load forecasting, fuel switching analysis, electrification program targeting, and greenhouse gas (GHG) emissions calculation. [ENUM-REF-CANDIDATE: electric|natural_gas|propane|fuel_oil|wood|other|unknown — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastServiceDate rdf:type rdf:Property ;
    rdfs:label 'Last Service Date' ;
    rdfs:comment 'Date of the most recent service activity at the premise, such as meter installation, service upgrade, or reconnection after disconnection. Used for service history tracking, field crew activity analysis, and customer service quality monitoring. Sourced from work order management system or CIS service order history.' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lifeSupportIndicator rdf:type rdf:Property ;
    rdfs:label 'Life Support Indicator' ;
    rdfs:comment 'Boolean flag indicating whether the premise has electrically-powered life-support equipment requiring continuous power supply. True indicates life-support equipment present; False indicates no life-support equipment. Used for critical customer notification during planned outages, priority restoration during unplanned outages, and Public Safety Power Shutoff (PSPS) exemption or advance notification. Subject to strict confidentiality and HIPAA privacy requirements.' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lowIncomeIndicator rdf:type rdf:Property ;
    rdfs:label 'Low Income Indicator' ;
    rdfs:comment 'Boolean flag indicating whether the premise qualifies for low-income energy assistance programs based on household income verification or participation in government assistance programs (SNAP, Medicaid, LIHEAP). True indicates low-income qualification; False indicates non-qualification. Used for California Alternate Rates for Energy (CARE), Family Electric Rate Assistance (FERA), energy efficiency program targeting, and arrearage management program eligibility. Subject to strict confidentiality requirements.' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:premiseNumber rdf:type rdf:Property ;
    rdfs:label 'Premise Number' ;
    rdfs:comment 'Externally-known business identifier for the premise, typically assigned by the utility\'s Customer Information System (CIS). Used for customer communication, billing correspondence, and cross-system reference. Unique across the utility\'s service territory.' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:premiseStatus rdf:type rdf:Property ;
    rdfs:label 'Premise Status' ;
    rdfs:comment 'Current operational status of the premise indicating whether utility services can be delivered. Serviceable indicates active infrastructure and ability to provide service; non-serviceable indicates no infrastructure or service restrictions; pending construction indicates planned future service; demolished indicates structure no longer exists; inactive indicates temporary service suspension.' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateZone rdf:type rdf:Property ;
    rdfs:label 'Rate Zone' ;
    rdfs:comment 'Geographic rate zone or pricing area where the premise is located. Determines applicable electric and gas tariff schedules, time-of-use (TOU) rate structures, seasonal rate variations, and locational pricing adjustments. Used for billing system rate assignment and revenue forecasting. Defined in utility tariff filings approved by state Public Utility Commission.' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceEstablishmentDate rdf:type rdf:Property ;
    rdfs:label 'Service Establishment Date' ;
    rdfs:comment 'Date when utility service was first established at this premise location. Represents the initial energization or gas service activation. Used for customer tenure analysis, infrastructure age tracking, and historical service continuity reporting. Sourced from Customer Information System (CIS) service order history.' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:smartThermostatIndicator rdf:type rdf:Property ;
    rdfs:label 'Smart Thermostat Indicator' ;
    rdfs:comment 'Boolean flag indicating whether the premise has a smart or programmable thermostat enrolled in utility demand response or energy efficiency programs. True indicates smart thermostat participation; False indicates no enrollment. Used for demand response event dispatch, peak load reduction forecasting, and customer engagement program tracking.' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:solarCapacityKw rdf:type rdf:Property ;
    rdfs:label 'Solar Capacity Kw' ;
    rdfs:comment 'Nameplate capacity of installed solar photovoltaic system in kilowatts (kW). Represents the maximum rated output of the solar installation under standard test conditions. Used for interconnection capacity tracking, distribution hosting capacity analysis, NEM credit calculation, and renewable portfolio standard (RPS) compliance reporting. Sourced from DER interconnection agreements.' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:solarInstallationIndicator rdf:type rdf:Property ;
    rdfs:label 'Solar Installation Indicator' ;
    rdfs:comment 'Boolean flag indicating whether the premise has rooftop solar photovoltaic (PV) panels or other distributed energy resource (DER) generation installed. True indicates solar installation; False indicates no solar. Used for Net Energy Metering (NEM) program administration, interconnection tracking, distribution planning, and renewable energy certificate (REC) accounting. Sourced from DER interconnection applications or AMI reverse power flow detection.' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:wildfireRiskZone rdf:type rdf:Property ;
    rdfs:label 'Wildfire Risk Zone' ;
    rdfs:comment 'Wildfire risk classification for the premise location based on vegetation density, topography, historical fire patterns, and climate conditions. Extreme indicates highest risk requiring enhanced fire mitigation; high indicates elevated risk; moderate indicates some risk; low indicates minimal risk; none indicates no wildfire risk. Used for Public Safety Power Shutoff (PSPS) program planning, vegetation management prioritization, and grid hardening investment decisions. Critical for California utilities under CPUC wildfire mitigation plan requirements.' ;
    rdfs:domain ind:Premise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentId rdf:type rdf:Property ;
    rdfs:label 'Segment Id' ;
    rdfs:comment 'Unique identifier for the customer segmentation classification record.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:amiDeploymentCohort rdf:type rdf:Property ;
    rdfs:label 'Ami Deployment Cohort' ;
    rdfs:comment 'AMI smart meter deployment wave or cohort identifier indicating when the customer received AMI meter installation. Used for AMI deployment tracking, interval data availability determination, and time-of-use rate migration planning. Examples: WAVE-1-2018, WAVE-2-2019, LEGACY-AMR (not yet upgraded to AMI).' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:annualConsumptionKwh rdf:type rdf:Property ;
    rdfs:label 'Annual Consumption Kwh' ;
    rdfs:comment 'Trailing twelve-month total electric energy consumption in kilowatt-hours at the time of segment assignment. Used for load profile group classification, customer value tier determination, and rate case cost-of-service allocation. Nullable for new customers without consumption history.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assignmentReason rdf:type rdf:Property ;
    rdfs:label 'Assignment Reason' ;
    rdfs:comment 'The business reason or trigger for this segment classification assignment. Initial enrollment occurs at customer onboarding. Rate change reflects tariff modification. Program enrollment occurs when customer joins income assistance or DER program. Annual review reflects periodic re-certification. Customer request reflects customer-initiated rate or program change. System migration reflects data conversion. Regulatory mandate reflects PUC-ordered reclassification. [ENUM-REF-CANDIDATE: initial_enrollment|rate_change|program_enrollment|annual_review|customer_request|system_migration|regulatory_mandate — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentSource rdf:type rdf:Property ;
    rdfs:label 'Assignment Source' ;
    rdfs:comment 'The system or process that originated this segment classification. CIS system assignments come from Oracle CC&B or SAP IS-U customer master. CRM system assignments come from Salesforce campaign or program enrollment. Manual override reflects analyst or customer service representative adjustment. Third party verification reflects income verification service for CARE/FERA. Regulatory filing reflects PUC rate case assignment. AMI analytics reflects MDMS load profile analysis.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:batteryStorageFlag rdf:type rdf:Property ;
    rdfs:label 'Battery Storage Flag' ;
    rdfs:comment 'Indicates whether the customer has an interconnected battery energy storage system. True if customer has active battery storage interconnection agreement. Used for demand response program eligibility, grid services procurement, and DERMS (Distributed Energy Resource Management System) enrollment.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cppEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Cpp Eligible Flag' ;
    rdfs:comment 'Indicates whether the customer is eligible for Critical Peak Pricing program enrollment. True if customer meets minimum demand threshold and has AMI meter with interval data capability. CPP programs charge higher rates during system peak events (typically 10-15 days per year) to incentivize load reduction.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:customerValueTier rdf:type rdf:Property ;
    rdfs:label 'Customer Value Tier' ;
    rdfs:comment 'Customer lifetime value segmentation tier for retention and engagement strategies. High-value customers have high consumption, low payment risk, and long tenure. Medium-value customers have moderate consumption and stable payment history. Low-value customers have low consumption or short tenure. At-risk customers show indicators of potential churn or payment default.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:demandResponseTier rdf:type rdf:Property ;
    rdfs:label 'Demand Response Tier' ;
    rdfs:comment 'Demand response program eligibility tier based on load flexibility, historical participation, and curtailment capability. Tier 1 customers have high curtailment capability (>50 kW) and reliable participation history. Tier 2 customers have moderate capability (10-50 kW). Tier 3 customers have low capability (<10 kW) or are residential participants. Not eligible customers do not meet minimum requirements for DR program participation.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:derAdoptionFlag rdf:type rdf:Property ;
    rdfs:label 'Der Adoption Flag' ;
    rdfs:comment 'Indicates whether the customer has adopted any Distributed Energy Resource (DER) technology including solar photovoltaic, battery energy storage, electric vehicle, or combined heat and power (CHP). True if customer has one or more DER assets interconnected or registered. Used for DER program targeting, grid planning, and Renewable Portfolio Standard (RPS) compliance reporting.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:evOwnerFlag rdf:type rdf:Property ;
    rdfs:label 'Ev Owner Flag' ;
    rdfs:comment 'Indicates whether the customer owns or leases an electric vehicle and is enrolled in an EV-specific rate or program. True if customer has registered EV ownership or is on EV time-of-use rate. Used for EV program targeting, managed charging programs, and transportation electrification planning.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:incomeTier rdf:type rdf:Property ;
    rdfs:label 'Income Tier' ;
    rdfs:comment 'Income-based program eligibility tier for low-income assistance programs. CARE (California Alternate Rates for Energy) provides 30-35% discount for households at or below 200% of federal poverty level. FERA (Family Electric Rate Assistance) provides 18% discount for households between 200-250% of federal poverty level. Medical baseline provides additional allowance for customers with qualifying medical equipment. Standard tier receives no income-based discount.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loadFactor rdf:type rdf:Property ;
    rdfs:label 'Load Factor' ;
    rdfs:comment 'Ratio of average load to peak load over the trailing twelve months, expressed as a decimal between 0 and 1. High load factor (>0.7) indicates consistent baseload consumption typical of industrial customers. Low load factor (<0.4) indicates peaky consumption typical of commercial customers. Used for load profile group classification and rate design analysis.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:loadProfileGroup rdf:type rdf:Property ;
    rdfs:label 'Load Profile Group' ;
    rdfs:comment 'Load profile classification grouping customers by consumption pattern for load forecasting and Integrated Resource Plan (IRP) projections. Examples: RES-STANDARD (standard residential), RES-HIGH-USE (high-consumption residential), COMM-RETAIL (retail commercial), COMM-OFFICE (office commercial), IND-CONTINUOUS (24/7 industrial), IND-SHIFT (shift-based industrial).' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programEnrollmentDate rdf:type rdf:Property ;
    rdfs:label 'Program Enrollment Date' ;
    rdfs:comment 'The date when the customer enrolled in the program or rate associated with this segment classification. Applicable for income assistance programs (CARE, FERA), demand response programs, time-of-use rates, and DER programs. Nullable for non-program segments such as standard rate class assignments.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:segmentCode rdf:type rdf:Property ;
    rdfs:label 'Segment Code' ;
    rdfs:comment 'The specific segment classification code assigned to this party or account within the segment type. Examples: RES (residential), COMM-SM (small commercial), IND-LG (large industrial), CARE (California Alternate Rates for Energy), FERA (Family Electric Rate Assistance), SOLAR-NEM (Net Energy Metering solar customer), EV-OWNER (electric vehicle owner), DR-TIER1 (demand response tier 1 eligible).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentDescription rdf:type rdf:Property ;
    rdfs:label 'Segment Description' ;
    rdfs:comment 'Detailed description of the segment classification criteria, business rules for assignment, and intended use cases. Supports regulatory rate case testimony and program design documentation.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentName rdf:type rdf:Property ;
    rdfs:label 'Segment Name' ;
    rdfs:comment 'Human-readable name of the segment classification for reporting and analytics. Examples: Residential Customer, Small Commercial, Large Industrial, CARE-Eligible Low Income, High-Value Customer, Solar NEM Customer, EV Owner, Demand Response Participant.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentStatus rdf:type rdf:Property ;
    rdfs:label 'Segment Status' ;
    rdfs:comment 'Current lifecycle status of this segment classification record. Active segments are currently in effect. Pending segments are scheduled for future effective date. Expired segments have passed their expiration date. Superseded segments have been replaced by a newer assignment. Cancelled segments were voided before becoming effective.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentType rdf:type rdf:Property ;
    rdfs:label 'Segment Type' ;
    rdfs:comment 'The dimension or category of segmentation being applied. Rate class segments customers by tariff eligibility (residential, commercial, industrial). Load profile groups customers by consumption pattern. Income tier identifies program eligibility (CARE, FERA). Customer value tiers support retention strategies. DER adoption flags solar, battery, EV ownership. Demand response eligibility determines DR program participation.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:solarCustomerFlag rdf:type rdf:Property ;
    rdfs:label 'Solar Customer Flag' ;
    rdfs:comment 'Indicates whether the customer has an interconnected solar photovoltaic system under Net Energy Metering (NEM) or other solar tariff. True if customer has active solar interconnection agreement. Used for NEM billing, RPS compliance tracking, and distributed generation forecasting.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:touRateEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Tou Rate Eligible Flag' ;
    rdfs:comment 'Indicates whether the customer is eligible for time-of-use rate enrollment based on AMI meter availability and rate class. True if customer has AMI meter and rate class supports TOU tariff. Used for TOU rate migration campaigns and dynamic pricing program targeting.' ;
    rdfs:domain ind:Segment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:demandResponseEventId rdf:type rdf:Property ;
    rdfs:label 'Demand Response Event Id' ;
    rdfs:comment 'Unique identifier for the demand response event record. Primary key for the demand response event entity.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DemandResponseEvent .

ind:feederId rdf:type rdf:Property ;
    rdfs:label 'Feeder Id' ;
    rdfs:comment 'Identifier of the distribution feeder or circuit targeted by this demand response event, linking to the distribution network topology.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Feeder .

ind:opexTransactionId rdf:type rdf:Property ;
    rdfs:label 'Opex Transaction Id' ;
    rdfs:comment 'Foreign key linking to finance.opex_transaction. Business justification: Demand response events generate incentive payment transactions to participating customers. Essential for DR program cost tracking, regulatory reporting, and cost recovery mechanisms.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OpexTransaction .

ind:actualLoadReductionKw rdf:type rdf:Property ;
    rdfs:label 'Actual Load Reduction Kw' ;
    rdfs:comment 'Measured load reduction in kilowatts achieved during the demand response event, calculated from baseline load comparison using Advanced Metering Infrastructure (AMI) or Meter Data Management System (MDMS) interval data.' ;
    rdfs:domain ind:DemandResponseEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ambientTemperatureF rdf:type rdf:Property ;
    rdfs:label 'Ambient Temperature F' ;
    rdfs:comment 'Ambient air temperature in degrees Fahrenheit at the time of the demand response event, captured from weather station data to correlate load reduction performance with thermal conditions.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:baselineLoadKw rdf:type rdf:Property ;
    rdfs:label 'Baseline Load Kw' ;
    rdfs:comment 'Calculated baseline load in kilowatts representing the expected load absent the demand response event, used as the reference for measuring actual load reduction. Typically calculated using customer baseline load (CBL) methodologies per NAESB standards.' ;
    rdfs:domain ind:DemandResponseEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:curtailmentComplianceRate rdf:type rdf:Property ;
    rdfs:label 'Curtailment Compliance Rate' ;
    rdfs:comment 'Percentage of notified customers who responded to the demand response event, calculated as (customers_responding_count / customers_notified_count) * 100, used to measure program engagement and effectiveness.' ;
    rdfs:domain ind:DemandResponseEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:customersNotifiedCount rdf:type rdf:Property ;
    rdfs:label 'Customers Notified Count' ;
    rdfs:comment 'Total number of customers or service points notified of the demand response event through automated messaging, mobile app alerts, or direct load control signals.' ;
    rdfs:domain ind:DemandResponseEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:customersRespondingCount rdf:type rdf:Property ;
    rdfs:label 'Customers Responding Count' ;
    rdfs:comment 'Number of customers or service points that actively participated in the demand response event by reducing load, either through voluntary curtailment or direct load control device activation.' ;
    rdfs:domain ind:DemandResponseEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dataSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Data Source System' ;
    rdfs:comment 'Name of the operational system that originated this demand response event record, typically Distributed Energy Resource Management System (DERMS), Customer Information System (CIS) DR module, or Meter Data Management System (MDMS).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dermsIntegratedFlag rdf:type rdf:Property ;
    rdfs:label 'Derms Integrated Flag' ;
    rdfs:comment 'Boolean indicator (True/False) denoting whether this demand response event was dispatched and managed through the utility\'s Distributed Energy Resource Management System (DERMS) platform, enabling automated control and telemetry.' ;
    rdfs:domain ind:DemandResponseEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dispatchSource rdf:type rdf:Property ;
    rdfs:label 'Dispatch Source' ;
    rdfs:comment 'System or mechanism that initiated the demand response event dispatch: Distributed Energy Resource Management System (DERMS), Distribution Management System (DMS), Outage Management System (OMS), manual operator dispatch, automated schedule, or market signal from Regional Transmission Organization (RTO) or Independent System Operator (ISO).' ;
    rdfs:domain ind:DemandResponseEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Event Duration Minutes' ;
    rdfs:comment 'Total duration of the demand response event in minutes, calculated from event start to event end timestamp.' ;
    rdfs:domain ind:DemandResponseEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:eventEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Event End Timestamp' ;
    rdfs:comment 'Date and time when the demand response event curtailment period concluded, marking the end of load reduction dispatch and return to normal operations.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:eventNumber rdf:type rdf:Property ;
    rdfs:label 'Event Number' ;
    rdfs:comment 'Business-facing unique identifier or reference number for the demand response event, used for external communication and reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventOutcomeStatus rdf:type rdf:Property ;
    rdfs:label 'Event Outcome Status' ;
    rdfs:comment 'Assessment of the demand response event outcome relative to target objectives: target met (achieved 90-110% of target), target exceeded (>110% of target), target missed (<90% of target), partial success (50-90% of target), or no response (minimal or no measurable load reduction).' ;
    rdfs:domain ind:DemandResponseEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Event Start Timestamp' ;
    rdfs:comment 'Date and time when the demand response event curtailment period began, marking the start of load reduction dispatch.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:eventStatus rdf:type rdf:Property ;
    rdfs:label 'Event Status' ;
    rdfs:comment 'Current lifecycle status of the demand response event: scheduled (pending activation), active (currently dispatched), completed (event concluded successfully), cancelled (event aborted before or during execution), or failed (event did not achieve operational objectives).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventType rdf:type rdf:Property ;
    rdfs:label 'Event Type' ;
    rdfs:comment 'Classification of the demand response event by operational mechanism: peak shaving (load reduction during system peak), direct load control (utility-controlled device curtailment), voluntary curtailment (customer opt-in reduction), Critical Peak Pricing (CPP) activation (price-signal driven), emergency DR (grid emergency response), or economic DR (market-driven dispatch).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incentivePaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Incentive Payment Amount' ;
    rdfs:comment 'Total incentive payment amount in US dollars to be paid to participating customers for this demand response event, calculated based on program tariff rates and measured load reduction.' ;
    rdfs:domain ind:DemandResponseEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lmpPricePerMwh rdf:type rdf:Property ;
    rdfs:label 'Lmp Price Per Mwh' ;
    rdfs:comment 'Locational Marginal Price in dollars per megawatt-hour at the distribution zone or pricing node during the demand response event, used for economic DR event valuation and settlement.' ;
    rdfs:domain ind:DemandResponseEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:loadReductionPercentage rdf:type rdf:Property ;
    rdfs:label 'Load Reduction Percentage' ;
    rdfs:comment 'Percentage of target load reduction achieved, calculated as (actual_load_reduction_kw / target_load_reduction_kw) * 100, used to assess event performance.' ;
    rdfs:domain ind:DemandResponseEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:notificationLeadTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Notification Lead Time Minutes' ;
    rdfs:comment 'Number of minutes between customer notification and event start timestamp, representing the advance notice provided to participants.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:notificationMethod rdf:type rdf:Property ;
    rdfs:label 'Notification Method' ;
    rdfs:comment 'Primary communication channel used to notify customers of the demand response event: Short Message Service (SMS), email, mobile application push notification, Interactive Voice Response (IVR) call, direct control signal to smart devices, or web portal alert.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:penaltyAmount rdf:type rdf:Property ;
    rdfs:label 'Penalty Amount' ;
    rdfs:comment 'Penalty amount in US dollars assessed for non-compliance or failure to meet contracted demand response obligations, applicable to capacity-based or firm DR programs.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pucReportingStatus rdf:type rdf:Property ;
    rdfs:label 'Puc Reporting Status' ;
    rdfs:comment 'Status of regulatory reporting submission to the state Public Utility Commission (PUC) for this demand response event, used for demand-side management program compliance and cost recovery filings.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pucSubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Puc Submission Date' ;
    rdfs:comment 'Date when demand response event data was submitted to the state Public Utility Commission (PUC) as part of demand-side management program reporting or rate case cost recovery documentation.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rtoIsoEventCode rdf:type rdf:Property ;
    rdfs:label 'Rto Iso Event Code' ;
    rdfs:comment 'External event identifier from the Regional Transmission Organization (RTO) or Independent System Operator (ISO) if this demand response event was dispatched in coordination with wholesale market operations or grid emergency procedures.' ;
    rdfs:domain ind:DemandResponseEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:systemPeakLoadMw rdf:type rdf:Property ;
    rdfs:label 'System Peak Load Mw' ;
    rdfs:comment 'Total system peak load in megawatts at the time of the demand response event, providing context for the event\'s contribution to peak shaving and grid reliability.' ;
    rdfs:domain ind:DemandResponseEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetLoadReductionKw rdf:type rdf:Property ;
    rdfs:label 'Target Load Reduction Kw' ;
    rdfs:comment 'Planned or target load reduction in kilowatts that the demand response event was designed to achieve, representing the dispatch instruction to the distribution network.' ;
    rdfs:domain ind:DemandResponseEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetZoneCode rdf:type rdf:Property ;
    rdfs:label 'Target Zone Code' ;
    rdfs:comment 'Geographic or operational zone code identifying the distribution area or load zone targeted for curtailment, used when event scope is broader than a single feeder.' ;
    rdfs:domain ind:DemandResponseEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:triggeringCondition rdf:type rdf:Property ;
    rdfs:label 'Triggering Condition' ;
    rdfs:comment 'The operational or market condition that initiated the demand response event: system peak (forecasted or actual peak load), grid emergency (reliability threat), price signal (high Locational Marginal Price or CPP threshold), capacity shortage (insufficient generation reserves), voltage deviation (distribution voltage issue), or scheduled test (program validation exercise).' ;
    rdfs:domain ind:DemandResponseEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:derInterconnectionId rdf:type rdf:Property ;
    rdfs:label 'Der Interconnection Id' ;
    rdfs:comment 'Unique surrogate identifier for each DER interconnection record on the distribution network. Primary key for this entity. Entity role: MASTER_AGREEMENT — represents a binding interconnection agreement and registration between a customer-sited DER and the utility distribution grid.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DerInterconnection .

ind:cpcnApplicationId rdf:type rdf:Property ;
    rdfs:label 'Cpcn Application Id' ;
    rdfs:comment 'Foreign key linking to regulatory.cpcn_application. Business justification: Large DER projects (utility-scale solar, storage) require CPCN approval before interconnection. Business process: tracking regulatory approval status for significant DER installations that need certif' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CpcnApplication .

ind:participantRegistrationId rdf:type rdf:Property ;
    rdfs:label 'Participant Registration Id' ;
    rdfs:comment 'Foreign key linking to market.participant_registration. Business justification: DERs participating in wholesale markets (via aggregation or direct participation under FERC Order 2222) require market registration tracking for settlement reconciliation, telemetry requirements, and ' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ParticipantRegistration .

ind:serviceTransformerId rdf:type rdf:Property ;
    rdfs:label 'Service Transformer Id' ;
    rdfs:comment 'Foreign key linking to distribution.service_transformer. Business justification: DER interconnections connect to the distribution network at service points, which are served by service transformers. The service transformer is the primary hosting point for distributed generation an' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ServiceTransformer .

ind:transformerId rdf:type rdf:Property ;
    rdfs:label 'Transformer Id' ;
    rdfs:comment 'Reference to the distribution service transformer through which the DER connects to the grid. Used for transformer loading analysis, hosting capacity calculations, and protection coordination studies.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Transformer .

ind:advancedInverterFunctionsEnabled rdf:type rdf:Property ;
    rdfs:label 'Advanced Inverter Functions Enabled' ;
    rdfs:comment 'Indicates whether IEEE 1547-2018 advanced inverter functions (volt-VAR optimization, volt-watt, frequency-watt, ride-through) are enabled and configured on this DER. Advanced inverter functions are required for DERMS grid services participation and may be mandated by state PUC rules.' ;
    rdfs:domain ind:DerInterconnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:antiIslandingProtectionType rdf:type rdf:Property ;
    rdfs:label 'Anti Islanding Protection Type' ;
    rdfs:comment 'Type of anti-islanding protection scheme implemented on the DER interconnection to prevent unintentional islanding during grid outages. Passive: frequency/voltage relay-based; Active: active frequency drift or impedance measurement; Hybrid: combination; Transfer Trip: utility-initiated trip signal. Required by IEEE 1547 and NERC reliability standards.' ;
    rdfs:domain ind:DerInterconnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicationDate rdf:type rdf:Property ;
    rdfs:label 'Application Date' ;
    rdfs:comment 'Date on which the customer or installer submitted the interconnection application to the utility. Used to track application processing timelines, regulatory queue position, and PUC-mandated processing deadlines.' ;
    rdfs:domain ind:DerInterconnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:commissioningDate rdf:type rdf:Property ;
    rdfs:label 'Commissioning Date' ;
    rdfs:comment 'Date on which the DER installation passed final inspection and was energized and commissioned for operation. Marks the start of NEM billing eligibility and DERMS operational status. Sourced from utility field inspection records.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:customerSegment rdf:type rdf:Property ;
    rdfs:label 'Customer Segment' ;
    rdfs:comment 'Customer segment classification for the DER interconnection site. Residential: single-family or multi-family dwelling; Commercial: small to medium business; Industrial: large commercial or industrial customer. Drives applicable interconnection rules, NEM tariff eligibility, and program offerings.' ;
    rdfs:domain ind:DerInterconnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:derType rdf:type rdf:Property ;
    rdfs:label 'Der Type' ;
    rdfs:comment 'Classification of the DER technology installed at the customer premise. Drives NEM eligibility, DERMS dispatch logic, and IEEE 1547 compliance requirements. Values: solar_pv (rooftop/ground-mount photovoltaic), battery_storage (standalone or paired), wind (small wind turbine), chp (Combined Heat and Power), ev_charger (bidirectional EV charging station), fuel_cell.' ;
    rdfs:domain ind:DerInterconnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dermsDeviceCode rdf:type rdf:Property ;
    rdfs:label 'Derms Device Code' ;
    rdfs:comment 'External device identifier assigned by the DERMS platform for real-time communication and dispatch of this DER. Used to correlate DERMS telemetry with the interconnection master record. Null if derms_integrated is False.' ;
    rdfs:domain ind:DerInterconnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dermsIntegrated rdf:type rdf:Property ;
    rdfs:label 'Derms Integrated' ;
    rdfs:comment 'Indicates whether this DER is registered and actively integrated with the utility DERMS platform for real-time monitoring, dispatch, and grid services. DERMS-integrated DERs are eligible for demand response, voltage support, and frequency regulation programs.' ;
    rdfs:domain ind:DerInterconnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exportCapacityKw rdf:type rdf:Property ;
    rdfs:label 'Export Capacity Kw' ;
    rdfs:comment 'Maximum permitted export capacity to the grid in kilowatts (kW) as specified in the interconnection agreement. May be less than installed AC capacity due to feeder hosting capacity constraints or export limitation agreements. Critical for DERMS dispatch and NEM credit calculations.' ;
    rdfs:domain ind:DerInterconnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exportLimitationFlag rdf:type rdf:Property ;
    rdfs:label 'Export Limitation Flag' ;
    rdfs:comment 'Indicates whether this DER interconnection is subject to an export limitation agreement restricting the maximum power exported to the grid below the installed AC capacity. Export-limited DERs require DERMS monitoring or smart inverter export control settings.' ;
    rdfs:domain ind:DerInterconnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ieee1547ComplianceStatus rdf:type rdf:Property ;
    rdfs:label 'Ieee1547 Compliance Status' ;
    rdfs:comment 'Compliance status of the DER installation with IEEE Standard 1547-2018 for interconnection and interoperability of distributed energy resources. Compliant installations may be eligible for advanced inverter functions and DERMS integration. Required for regulatory reporting to state PUCs.' ;
    rdfs:domain ind:DerInterconnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:installedCapacityKwAc rdf:type rdf:Property ;
    rdfs:label 'Installed Capacity Kw Ac' ;
    rdfs:comment 'Nameplate AC inverter output capacity of the DER installation in kilowatts (kW-AC). The AC capacity is the binding limit for grid export and interconnection agreement terms. Used for hosting capacity analysis and DERMS dispatch limits.' ;
    rdfs:domain ind:DerInterconnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:installedCapacityKwDc rdf:type rdf:Property ;
    rdfs:label 'Installed Capacity Kw Dc' ;
    rdfs:comment 'Nameplate DC generating capacity of the DER installation in kilowatts (kW-DC). Applicable primarily to solar PV systems. Used for NEM program sizing, interconnection study thresholds, and RPS tracking. Sourced from interconnection application.' ;
    rdfs:domain ind:DerInterconnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:installerLicenseNumber rdf:type rdf:Property ;
    rdfs:label 'Installer License Number' ;
    rdfs:comment 'State-issued electrical contractor license number for the DER installer. Required for interconnection application validation and regulatory compliance verification.' ;
    rdfs:domain ind:DerInterconnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:installerName rdf:type rdf:Property ;
    rdfs:label 'Installer Name' ;
    rdfs:comment 'Name of the licensed electrical contractor or solar installer who performed the DER installation. Used for contractor performance tracking, permit verification, and warranty claim processing.' ;
    rdfs:domain ind:DerInterconnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interconnectionAgreementDate rdf:type rdf:Property ;
    rdfs:label 'Interconnection Agreement Date' ;
    rdfs:comment 'Date on which the interconnection agreement was fully executed between the customer/installer and the utility. Marks the start of the binding contractual relationship. Used for regulatory reporting and program enrollment tracking.' ;
    rdfs:domain ind:DerInterconnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:interconnectionAgreementType rdf:type rdf:Property ;
    rdfs:label 'Interconnection Agreement Type' ;
    rdfs:comment 'Type of interconnection agreement executed with the customer. Standard: full interconnection agreement for larger systems; Simplified: streamlined agreement for small systems meeting fast-track criteria; Full Study: agreement following full interconnection study; Expedited: fast-track agreement. Determines contractual terms and cost responsibility.' ;
    rdfs:domain ind:DerInterconnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interconnectionLevel rdf:type rdf:Property ;
    rdfs:label 'Interconnection Level' ;
    rdfs:comment 'Interconnection application review level as defined by state PUC fast-track and full study processes. Level 1: simplified/fast-track for small systems below hosting capacity threshold; Level 2: expedited review; Level 3: full interconnection study required. Determines processing timeline and cost responsibility.' ;
    rdfs:domain ind:DerInterconnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interconnectionNumber rdf:type rdf:Property ;
    rdfs:label 'Interconnection Number' ;
    rdfs:comment 'Externally-known, human-readable identifier assigned to the interconnection application and agreement (e.g., \'DER-2024-00412\'). Used in customer correspondence, regulatory filings, and DERMS integration. Sourced from Oracle CC&B/SAP IS-U interconnection module.' ;
    rdfs:domain ind:DerInterconnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interconnectionPointGisCode rdf:type rdf:Property ;
    rdfs:label 'Interconnection Point Gis Code' ;
    rdfs:comment 'ESRI ArcGIS feature identifier for the point of interconnection on the distribution network. Enables spatial analysis of DER hosting capacity, feeder penetration mapping, and grid impact visualization. Sourced from ESRI ArcGIS distribution network model.' ;
    rdfs:domain ind:DerInterconnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interconnectionStatus rdf:type rdf:Property ;
    rdfs:label 'Interconnection Status' ;
    rdfs:comment 'Current lifecycle state of the DER interconnection agreement. Drives operational eligibility for NEM billing, DERMS dispatch, and export permissions. Pending: application submitted; Approved: agreement executed; Commissioned: DER energized and operational; Suspended: temporarily de-energized; Terminated: permanently disconnected; Withdrawn: application cancelled.' ;
    rdfs:domain ind:DerInterconnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inverterManufacturer rdf:type rdf:Property ;
    rdfs:label 'Inverter Manufacturer' ;
    rdfs:comment 'Name of the inverter equipment manufacturer (e.g., Enphase, SolarEdge, SMA, Fronius). Used for equipment compatibility assessment, firmware update tracking, and advanced inverter function certification verification.' ;
    rdfs:domain ind:DerInterconnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inverterModel rdf:type rdf:Property ;
    rdfs:label 'Inverter Model' ;
    rdfs:comment 'Model designation of the inverter equipment. Used in conjunction with inverter_manufacturer to verify California Energy Commission (CEC) or equivalent certification and IEEE 1547 compliance level.' ;
    rdfs:domain ind:DerInterconnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inverterType rdf:type rdf:Property ;
    rdfs:label 'Inverter Type' ;
    rdfs:comment 'Type of inverter technology used in the DER installation. Determines IEEE 1547 advanced inverter function capabilities (volt-VAR, volt-watt, frequency-watt), anti-islanding method, and DERMS controllability. None applies to non-inverter-based DER types such as synchronous CHP generators.' ;
    rdfs:domain ind:DerInterconnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nemEnrolled rdf:type rdf:Property ;
    rdfs:label 'Nem Enrolled' ;
    rdfs:comment 'Indicates whether this DER interconnection is enrolled in a Net Energy Metering (NEM) program, entitling the customer to bill credits for excess generation exported to the grid. Drives NEM billing logic in Oracle CC&B/SAP IS-U.' ;
    rdfs:domain ind:DerInterconnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nemTariffType rdf:type rdf:Property ;
    rdfs:label 'Nem Tariff Type' ;
    rdfs:comment 'Specific NEM tariff schedule under which the customer receives bill credits for exported generation. NEM 1: legacy retail rate credit; NEM 2: time-of-use with non-bypassable charges; NEM 3 (NEM-Successor): avoided-cost-based export rate; NEM Virtual: community solar; NEM Aggregated: multi-meter aggregation; None: not enrolled in NEM. Sourced from Oracle CC&B/SAP IS-U rate schedule.' ;
    rdfs:domain ind:DerInterconnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:permitNumber rdf:type rdf:Property ;
    rdfs:label 'Permit Number' ;
    rdfs:comment 'Local authority having jurisdiction (AHJ) building or electrical permit number issued for the DER installation. Required for interconnection approval and final commissioning sign-off.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:phaseConfiguration rdf:type rdf:Property ;
    rdfs:label 'Phase Configuration' ;
    rdfs:comment 'Electrical phase configuration of the DER interconnection. Single-phase installations are typical for residential rooftop solar; three-phase for commercial/industrial DER and larger battery storage systems. Affects protection coordination and power quality analysis.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recEligible rdf:type rdf:Property ;
    rdfs:label 'Rec Eligible' ;
    rdfs:comment 'Indicates whether the DER installation is eligible to generate Renewable Energy Certificates (RECs) under the applicable state Renewable Portfolio Standard (RPS). Eligible DERs must be registered with the relevant REC tracking system (e.g., WREGIS, PJM-GATS).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:storageCapacityKwh rdf:type rdf:Property ;
    rdfs:label 'Storage Capacity Kwh' ;
    rdfs:comment 'Usable energy storage capacity in kilowatt-hours (kWh) for battery storage DER types. Null for non-storage DER types. Used for demand response program enrollment, DERMS dispatch scheduling, and grid services valuation.' ;
    rdfs:domain ind:DerInterconnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:terminationDate rdf:type rdf:Property ;
    rdfs:label 'Termination Date' ;
    rdfs:comment 'Date on which the interconnection agreement was terminated or the DER was permanently disconnected from the grid. Null for active interconnections. Used for NEM billing cessation and DERMS deregistration.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:utilityProgramEnrollment rdf:type rdf:Property ;
    rdfs:label 'Utility Program Enrollment' ;
    rdfs:comment 'Utility-sponsored program in which this DER is enrolled beyond NEM. Demand Response: dispatchable load curtailment/generation; Virtual Power Plant: aggregated dispatch program; Grid Services: ancillary service provision; Storage Incentive: battery storage incentive program; None: no additional program enrollment. [ENUM-REF-CANDIDATE: none|demand_response|virtual_power_plant|grid_services|storage_incentive|self_generation_incentive — promote to reference product]' ;
    rdfs:domain ind:DerInterconnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wregisCode rdf:type rdf:Property ;
    rdfs:label 'Wregis Code' ;
    rdfs:comment 'Generator registration identifier assigned by WREGIS (or equivalent REC tracking registry) for this DER. Required for REC issuance, RPS compliance reporting, and green tariff program participation. Null if rec_eligible is False.' ;
    rdfs:domain ind:DerInterconnection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:distributionSubstationId rdf:type rdf:Property ;
    rdfs:label 'Distribution Substation Id' ;
    rdfs:comment 'Unique surrogate identifier for the distribution substation record in the Silver Layer lakehouse. Primary key. Entity role: MASTER_RESOURCE — represents a physical facility owned and operated by the utility to step down transmission voltage for last-mile electric distribution.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DistributionSubstation .

ind:fixedAssetId rdf:type rdf:Property ;
    rdfs:label 'Fixed Asset Id' ;
    rdfs:comment 'Foreign key linking to finance.fixed_asset. Business justification: Substations are major capitalized assets requiring fixed asset tracking for depreciation, rate base calculation, and FERC Form 1 plant accounting. Critical for regulatory financial reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FixedAsset .

ind:constructionWorkOrder rdf:type rdf:Property ;
    rdfs:label 'Construction Work Order' ;
    rdfs:comment 'Work order number from Oracle WAM or IBM Maximo associated with the original construction or most recent major capital project at this substation. Links to CAPEX project records, WIP accounting, and AFUDC capitalization in SAP S/4HANA or Oracle ERP.' ;
    rdfs:domain ind:DistributionSubstation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:countyName rdf:type rdf:Property ;
    rdfs:label 'County Name' ;
    rdfs:comment 'Name of the county or parish in which the substation is located. Used for local franchise agreement compliance, county emergency management coordination, and property tax assessment records.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customersServedCount rdf:type rdf:Property ;
    rdfs:label 'Customers Served Count' ;
    rdfs:comment 'Total number of end-use customer accounts (residential and commercial) served by distribution feeders emanating from this substation. Used as the denominator for SAIDI/SAIFI/CAIDI reliability index calculations and outage impact reporting to the PUC.' ;
    rdfs:domain ind:DistributionSubstation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:decommissionDate rdf:type rdf:Property ;
    rdfs:label 'Decommission Date' ;
    rdfs:comment 'Date on which the substation was permanently retired from service (yyyy-MM-dd). Null if the substation is still active. Used for asset retirement accounting, rate base removal, and regulatory decommissioning filings with the PUC.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:derHostingCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Der Hosting Capacity Mw' ;
    rdfs:comment 'Maximum additional Distributed Energy Resource (DER) generation capacity (in MW) that can be interconnected to feeders served by this substation without requiring infrastructure upgrades, per the utility\'s hosting capacity analysis. Used for NEM interconnection screening and DERMS planning.' ;
    rdfs:domain ind:DistributionSubstation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:divisionCode rdf:type rdf:Property ;
    rdfs:label 'Division Code' ;
    rdfs:comment 'Internal organizational division or district code responsible for operating and maintaining this substation. Maps to the utility\'s organizational hierarchy in SAP S/4HANA or Oracle ERP for O&M cost allocation and workforce dispatch.' ;
    rdfs:domain ind:DistributionSubstation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emsNodeCode rdf:type rdf:Property ;
    rdfs:label 'Ems Node Code' ;
    rdfs:comment 'Node identifier for this substation within the ABB or GE Energy Management System (EMS) network model. Used for power flow analysis, state estimation, and real-time grid balancing. Distinct from the SCADA point ID which references the historian tag.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feederCount rdf:type rdf:Property ;
    rdfs:label 'Feeder Count' ;
    rdfs:comment 'Count of active distribution feeder circuits emanating from this substation\'s distribution bus. Used for load balancing analysis, SAIDI/SAIFI reliability reporting, and outage impact assessment. Sourced from ESRI ArcGIS network topology and Schneider Electric AMS.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:gisFeatureCode rdf:type rdf:Property ;
    rdfs:label 'Gis Feature Code' ;
    rdfs:comment 'Unique feature identifier assigned to this substation in the ESRI ArcGIS enterprise geodatabase. Serves as the cross-reference key for spatial joins, network tracing, and GIS-to-OMS/DMS integration. Distinct from the surrogate primary key.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:installedCapacityMva rdf:type rdf:Property ;
    rdfs:label 'Installed Capacity Mva' ;
    rdfs:comment 'Sum of the nameplate ratings of all power transformers installed at the substation, expressed in Megavolt-Amperes (MVA). Represents the maximum apparent power the substation can deliver to distribution feeders under normal operating conditions. Used for capacity planning, IRP, and FERC Form 1 reporting. Satisfies MASTER_RESOURCE MEASUREMENT_OR_VALUE category.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isAutomatedSwitching rdf:type rdf:Property ;
    rdfs:label 'Is Automated Switching' ;
    rdfs:comment 'Indicates whether the substation is equipped with automated switching devices (e.g., automated reclosers, sectionalizers, or FLISR-capable switches) that enable self-healing grid restoration without manual crew dispatch (True/False). Key metric for AMI/DERMS integration and reliability improvement programs.' ;
    rdfs:domain ind:DistributionSubstation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isNormallyOpenTie rdf:type rdf:Property ;
    rdfs:label 'Is Normally Open Tie' ;
    rdfs:comment 'Indicates whether this substation serves as a normally-open tie point between two distribution circuits or substations (True) or operates as a radial/normally-closed facility (False). Critical for OMS/DMS switching order generation and restoration planning.' ;
    rdfs:domain ind:DistributionSubstation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isScadaMonitored rdf:type rdf:Property ;
    rdfs:label 'Is Scada Monitored' ;
    rdfs:comment 'Indicates whether this substation has real-time SCADA telemetry integrated into the OSIsoft PI historian or ABB/GE EMS (True) or relies on manual reads and field inspection (False). Affects outage detection latency and SAIDI/SAIFI calculation methodology.' ;
    rdfs:domain ind:DistributionSubstation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:landParcelNumber rdf:type rdf:Property ;
    rdfs:label 'Land Parcel Number' ;
    rdfs:comment 'County assessor parcel number (APN) or land parcel identifier for the property on which the substation is sited. Used for property tax filings, easement management, and real estate records in SAP S/4HANA or Oracle ERP.' ;
    rdfs:domain ind:DistributionSubstation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastMajorUpgradeDate rdf:type rdf:Property ;
    rdfs:label 'Last Major Upgrade Date' ;
    rdfs:comment 'Date of the most recent major capital upgrade or refurbishment of the substation (e.g., transformer replacement, bus reconfiguration, protection system modernization). Used for CAPEX project tracking, asset condition assessment, and IRP planning.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:loadFactorPct rdf:type rdf:Property ;
    rdfs:label 'Load Factor Pct' ;
    rdfs:comment 'Ratio of average load to peak load at this substation over the most recent 12-month period, expressed as a percentage. Indicates utilization efficiency; a higher load factor means more uniform loading. Used in rate case cost studies and capacity planning.' ;
    rdfs:domain ind:DistributionSubstation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nemInterconnectionCount rdf:type rdf:Property ;
    rdfs:label 'Nem Interconnection Count' ;
    rdfs:comment 'Number of active Net Energy Metering (NEM) customer interconnections (e.g., rooftop solar, small wind) on feeders served by this substation. Used to assess reverse power flow risk, hosting capacity consumption, and DERMS dispatch requirements.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:nercBesApplicable rdf:type rdf:Property ;
    rdfs:label 'Nerc Bes Applicable' ;
    rdfs:comment 'Indicates whether this substation meets the NERC Bulk Electric System (BES) definition thresholds (e.g., connected at 100 kV or above, or meeting generation/load criteria) and is therefore subject to NERC reliability standards (True/False). Drives CIP cybersecurity and FAC compliance obligations.' ;
    rdfs:domain ind:DistributionSubstation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nercCipClassification rdf:type rdf:Property ;
    rdfs:label 'Nerc Cip Classification' ;
    rdfs:comment 'NERC CIP cyber security impact classification for this substation\'s Electronic Security Perimeter (ESP) and associated BES Cyber Systems. \'high\', \'medium\', or \'low\' impact per NERC CIP-002-5.1a; \'not_applicable\' if BES threshold not met. Governs physical and cyber security control requirements.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:omsFacilityCode rdf:type rdf:Property ;
    rdfs:label 'Oms Facility Code' ;
    rdfs:comment 'Facility identifier for this substation in the Schneider Electric AMS or GE PowerOn Outage Management System / Distribution Management System (OMS/DMS). Used to associate outage events, switching orders, and restoration activities with this substation.' ;
    rdfs:domain ind:DistributionSubstation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operationalStatus rdf:type rdf:Property ;
    rdfs:label 'Operational Status' ;
    rdfs:comment 'Current lifecycle state of the distribution substation. \'in_service\' = energized and serving load; \'out_of_service\' = de-energized for maintenance or fault; \'under_construction\' = not yet commissioned; \'decommissioned\' = permanently retired; \'mothballed\' = temporarily idled. Drives OMS/DMS outage eligibility and asset management workflows. Satisfies MASTER_RESOURCE LIFECYCLE_STATUS category.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:peakLoadMw rdf:type rdf:Property ;
    rdfs:label 'Peak Load Mw' ;
    rdfs:comment 'Maximum recorded real power demand (in Megawatts) observed at this substation during the most recent annual peak period. Used for capacity planning, demand response (DR) program sizing, and IRP load forecasting. Sourced from OSIsoft PI historian interval data.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:primaryVoltageKv rdf:type rdf:Property ;
    rdfs:label 'Primary Voltage Kv' ;
    rdfs:comment 'Nominal voltage level on the high-voltage (transmission) side of the substation transformer, expressed in kilovolts (kV). Typical values for distribution substations include 69 kV, 115 kV, 138 kV, or 230 kV. Used for interconnection studies, OATT compliance, and NERC BES applicability determination.' ;
    rdfs:domain ind:DistributionSubstation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:protectionScheme rdf:type rdf:Property ;
    rdfs:label 'Protection Scheme' ;
    rdfs:comment 'Type of protective relay scheme deployed at the substation for fault detection and isolation. Drives maintenance inspection intervals, NERC PRC compliance tracking, and equipment procurement for relay upgrades.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:saidiContributionMin rdf:type rdf:Property ;
    rdfs:label 'Saidi Contribution Min' ;
    rdfs:comment 'This substation\'s contribution to the utility\'s annual System Average Interruption Duration Index (SAIDI), expressed in customer-minutes per customer. Calculated from outage events originating at or upstream of this substation. Used for PUC reliability benchmarking and Performance-Based Ratemaking (PBR) incentive calculations.' ;
    rdfs:domain ind:DistributionSubstation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scadaPointCode rdf:type rdf:Property ;
    rdfs:label 'Scada Point Code' ;
    rdfs:comment 'Identifier of the SCADA integration point (RTU/IED address or OSIsoft PI tag prefix) associated with this substation in the OSIsoft PI or GE Proficy historian and the ABB/GE Energy Management System. Enables real-time telemetry linkage for voltage, load, and breaker status monitoring.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:secondaryVoltageKv rdf:type rdf:Property ;
    rdfs:label 'Secondary Voltage Kv' ;
    rdfs:comment 'Nominal voltage level on the low-voltage (distribution) side of the substation transformer, expressed in kilovolts (kV). Typical values include 4.16 kV, 12.47 kV, 13.2 kV, 13.8 kV, 25 kV, or 34.5 kV. Determines feeder voltage class and equipment ratings for downstream distribution assets.' ;
    rdfs:domain ind:DistributionSubstation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stateCode rdf:type rdf:Property ;
    rdfs:label 'State Code' ;
    rdfs:comment 'Two-letter US state abbreviation (USPS standard) for the state in which the substation is located. Used for jurisdictional regulatory reporting to state PUCs and for multi-state utility operational segmentation.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:substationCode rdf:type rdf:Property ;
    rdfs:label 'Substation Code' ;
    rdfs:comment 'Externally-known alphanumeric business identifier for the substation, as assigned by the utility\'s GIS and OMS/DMS systems (e.g., \'ESRI ArcGIS feature ID\' or Schneider Electric AMS station code). Used in SCADA tags, outage tickets, and regulatory filings. Satisfies MASTER_RESOURCE BUSINESS_IDENTIFIER category.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:substationType rdf:type rdf:Property ;
    rdfs:label 'Substation Type' ;
    rdfs:comment 'Categorical classification of the substation by function within the distribution network. \'distribution\' = standard step-down facility; \'switching\' = bus-tie/sectionalizing point; \'network\' = secondary network vault; \'customer_owned\' = customer-sited facility interconnected to the utility grid. Satisfies MASTER_RESOURCE CLASSIFICATION_OR_TYPE category.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transformerCount rdf:type rdf:Property ;
    rdfs:label 'Transformer Count' ;
    rdfs:comment 'Total count of power transformers (including main bank and spare/standby units) installed at the substation. Relevant for N-1 contingency analysis, maintenance scheduling in Oracle WAM/IBM Maximo, and capacity redundancy assessment.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:voltageRegulationScheme rdf:type rdf:Property ;
    rdfs:label 'Voltage Regulation Scheme' ;
    rdfs:comment 'Primary voltage regulation technology deployed at the substation. \'ltc\' = Load Tap Changer on main transformer; \'svr\' = Step Voltage Regulator on feeder; \'capacitor_bank\' = switched capacitor bank; \'statcom\' = Static Synchronous Compensator; \'none\' = no active regulation. Relevant for DER/DERMS integration and power quality compliance.' ;
    rdfs:domain ind:DistributionSubstation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conductorMaterialMasterId rdf:type rdf:Property ;
    rdfs:label 'Conductor Material Master Id' ;
    rdfs:comment 'Foreign key linking to supply.material_master. Business justification: Feeders use standardized conductor materials tracked by type and size. Enables lifecycle replacement planning, material standardization programs, and accurate cost estimation for feeder reconductoring' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MaterialMaster .

ind:caidiAnnual rdf:type rdf:Property ;
    rdfs:label 'Caidi Annual' ;
    rdfs:comment 'The annual Customer Average Interruption Duration Index for this feeder, measured in minutes. Represents the average outage duration per interruption event.' ;
    rdfs:domain ind:Feeder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capacitorBankCount rdf:type rdf:Property ;
    rdfs:label 'Capacitor Bank Count' ;
    rdfs:comment 'The number of capacitor banks installed on the feeder for power factor correction and voltage support.' ;
    rdfs:domain ind:Feeder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:circuitConfiguration rdf:type rdf:Property ;
    rdfs:label 'Circuit Configuration' ;
    rdfs:comment 'The topology or architecture of the feeder circuit. Radial feeders have a single source path; loop feeders have alternate paths with normally-open points; networked feeders have multiple energized sources.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conductorSizeKcmil rdf:type rdf:Property ;
    rdfs:label 'Conductor Size Kcmil' ;
    rdfs:comment 'The cross-sectional area of the conductor in thousand circular mils, which determines current-carrying capacity and voltage drop characteristics.' ;
    rdfs:domain ind:Feeder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerCount rdf:type rdf:Property ;
    rdfs:label 'Customer Count' ;
    rdfs:comment 'The total number of end-use customers served by this feeder. Critical for calculating SAIFI and SAIDI reliability indices.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:derCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Der Capacity Mw' ;
    rdfs:comment 'The total nameplate generation capacity of all DER interconnections on this feeder in megawatts. Critical for hosting capacity analysis and grid stability studies.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:derInterconnectionCount rdf:type rdf:Property ;
    rdfs:label 'Der Interconnection Count' ;
    rdfs:comment 'The total number of distributed energy resources (solar PV, wind, battery storage, etc.) interconnected to this feeder under IEEE 1547 or state interconnection standards.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dmsCircuitCode rdf:type rdf:Property ;
    rdfs:label 'Dms Circuit Code' ;
    rdfs:comment 'The circuit identifier used in the Distribution Management System for real-time network analysis, switching operations, and voltage optimization.' ;
    rdfs:domain ind:Feeder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feederName rdf:type rdf:Property ;
    rdfs:label 'Feeder Name' ;
    rdfs:comment 'Human-readable name or designation for the feeder, often incorporating geographic or landmark references for operational clarity.' ;
    rdfs:domain ind:Feeder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feederNumber rdf:type rdf:Property ;
    rdfs:label 'Feeder Number' ;
    rdfs:comment 'Business identifier for the feeder circuit, typically assigned by the utility following internal naming conventions. Used in operational communications, OMS displays, and field work orders.' ;
    rdfs:domain ind:Feeder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastInspectionDate rdf:type rdf:Property ;
    rdfs:label 'Last Inspection Date' ;
    rdfs:comment 'The date of the most recent comprehensive inspection of the feeder circuit, including poles, conductors, and equipment.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lengthMiles rdf:type rdf:Property ;
    rdfs:label 'Length Miles' ;
    rdfs:comment 'The total circuit length of the feeder from substation to the furthest endpoint, measured in miles. Used for voltage drop calculations, reliability metrics, and maintenance planning.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nemCustomerCount rdf:type rdf:Property ;
    rdfs:label 'Nem Customer Count' ;
    rdfs:comment 'The number of customers on this feeder enrolled in net energy metering programs, typically residential or commercial solar installations.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:nextInspectionDate rdf:type rdf:Property ;
    rdfs:label 'Next Inspection Date' ;
    rdfs:comment 'The scheduled date for the next comprehensive feeder inspection, based on regulatory requirements and utility maintenance cycles.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nominalVoltageKv rdf:type rdf:Property ;
    rdfs:label 'Nominal Voltage Kv' ;
    rdfs:comment 'The nominal operating voltage of the feeder circuit in kilovolts, typically ranging from 4 kV to 35 kV for distribution feeders.' ;
    rdfs:domain ind:Feeder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:omsCircuitCode rdf:type rdf:Property ;
    rdfs:label 'Oms Circuit Code' ;
    rdfs:comment 'The circuit identifier used in the Outage Management System for tracking outage events, restoration activities, and customer impact analysis.' ;
    rdfs:domain ind:Feeder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratedCapacityMva rdf:type rdf:Property ;
    rdfs:label 'Rated Capacity Mva' ;
    rdfs:comment 'The maximum continuous load capacity of the feeder in megavolt-amperes, determined by conductor thermal limits, protection settings, and substation transformer capacity allocation.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recloserCount rdf:type rdf:Property ;
    rdfs:label 'Recloser Count' ;
    rdfs:comment 'The number of automatic reclosing devices installed on the feeder to isolate faults and minimize customer interruptions.' ;
    rdfs:domain ind:Feeder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:saidiAnnual rdf:type rdf:Property ;
    rdfs:label 'Saidi Annual' ;
    rdfs:comment 'The annual System Average Interruption Duration Index for this feeder, measured in minutes. Represents the average total outage duration per customer served by the feeder.' ;
    rdfs:domain ind:Feeder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:saifiAnnual rdf:type rdf:Property ;
    rdfs:label 'Saifi Annual' ;
    rdfs:comment 'The annual System Average Interruption Frequency Index for this feeder, representing the average number of sustained interruptions per customer.' ;
    rdfs:domain ind:Feeder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sourceBusId rdf:type rdf:Property ;
    rdfs:label 'Source Bus Id' ;
    rdfs:comment 'Reference to the specific bus or breaker position within the substation from which this feeder is energized.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Bus .

ind:treeTrimmingCycleMonths rdf:type rdf:Property ;
    rdfs:label 'Tree Trimming Cycle Months' ;
    rdfs:comment 'The scheduled vegetation management cycle for this feeder in months. Critical for reliability improvement and wildfire risk mitigation.' ;
    rdfs:domain ind:Feeder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:undergroundPercentage rdf:type rdf:Property ;
    rdfs:label 'Underground Percentage' ;
    rdfs:comment 'The percentage of the feeder circuit length that is underground cable versus overhead conductor. Underground circuits typically have higher reliability but higher installation costs.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:voltageRegulatorCount rdf:type rdf:Property ;
    rdfs:label 'Voltage Regulator Count' ;
    rdfs:comment 'The number of voltage regulation devices (line regulators or load tap changers) installed on the feeder to maintain voltage within acceptable limits per ANSI C84.1.' ;
    rdfs:domain ind:Feeder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:gasLeakSurveyId rdf:type rdf:Property ;
    rdfs:label 'Gas Leak Survey Id' ;
    rdfs:comment 'Unique identifier for the gas leak survey record. Primary key for the gas leak survey transaction.' ;
    rdfs:domain ind:GasLeakSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:gasMainId rdf:type rdf:Property ;
    rdfs:label 'Gas Main Id' ;
    rdfs:comment 'Foreign key reference to the gas distribution main or service lateral segment that was surveyed. Links to the GIS network topology for the pipeline segment.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GasMain .

ind:repairWorkOrderId rdf:type rdf:Property ;
    rdfs:label 'Repair Work Order Id' ;
    rdfs:comment 'Foreign key reference to the work order created for leak repair. Links to EAM system (Oracle WAM, IBM Maximo) for repair tracking and completion verification. Null if no repair required.' ;
    rdfs:domain ind:GasLeakSurvey ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WorkOrder .

ind:gasConcentrationPpm rdf:type rdf:Property ;
    rdfs:label 'Gas Concentration Ppm' ;
    rdfs:comment 'Measured natural gas concentration in parts per million (PPM) at the leak location. Used for leak grade classification and hazard assessment. Null if no leak detected.' ;
    rdfs:domain ind:GasLeakSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:leakDetectedFlag rdf:type rdf:Property ;
    rdfs:label 'Leak Detected Flag' ;
    rdfs:comment 'Boolean indicator of whether a gas leak was detected during this survey. True if leak found; False if no leak detected.' ;
    rdfs:domain ind:GasLeakSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:leakGrade rdf:type rdf:Property ;
    rdfs:label 'Leak Grade' ;
    rdfs:comment 'AGA and PHMSA leak classification. Grade 1 is hazardous requiring immediate repair; Grade 2 is non-hazardous requiring scheduled repair within one year; Grade 3 is non-hazardous monitored annually.' ;
    rdfs:domain ind:GasLeakSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leakLatitude rdf:type rdf:Property ;
    rdfs:label 'Leak Latitude' ;
    rdfs:comment 'GPS latitude coordinate of the detected leak location in decimal degrees. Used for GIS mapping and spatial analysis of leak patterns.' ;
    rdfs:domain ind:GasLeakSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:leakLocationDescription rdf:type rdf:Property ;
    rdfs:label 'Leak Location Description' ;
    rdfs:comment 'Textual description of the precise leak location on the pipeline segment (e.g., valve body, joint, service tee, main-to-lateral connection). Used for repair crew dispatch and work order generation.' ;
    rdfs:domain ind:GasLeakSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leakLongitude rdf:type rdf:Property ;
    rdfs:label 'Leak Longitude' ;
    rdfs:comment 'GPS longitude coordinate of the detected leak location in decimal degrees. Used for GIS mapping and spatial analysis of leak patterns.' ;
    rdfs:domain ind:GasLeakSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:leakSizeEstimateMcfPerDay rdf:type rdf:Property ;
    rdfs:label 'Leak Size Estimate Mcf Per Day' ;
    rdfs:comment 'Estimated volumetric leak rate in thousand cubic feet (MCF) of natural gas per day. Used for emissions reporting and repair prioritization. Null if no leak detected.' ;
    rdfs:domain ind:GasLeakSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:operatingPressurePsig rdf:type rdf:Property ;
    rdfs:label 'Operating Pressure Psig' ;
    rdfs:comment 'Operating pressure of the gas distribution system at the survey location in pounds per square inch gauge (PSIG). Used for leak grade classification and hazard assessment.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:phmsaIncidentNumber rdf:type rdf:Property ;
    rdfs:label 'Phmsa Incident Number' ;
    rdfs:comment 'PHMSA-assigned incident tracking number for reportable gas leaks. Used for federal regulatory compliance and incident investigation tracking. Null if not PHMSA-reportable.' ;
    rdfs:domain ind:GasLeakSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:phmsaReportableFlag rdf:type rdf:Property ;
    rdfs:label 'Phmsa Reportable Flag' ;
    rdfs:comment 'Boolean indicator of whether this leak meets PHMSA federal reporting thresholds (e.g., incident causing injury, death, or significant property damage). True if reportable to PHMSA; False otherwise.' ;
    rdfs:domain ind:GasLeakSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pipelineDiameterInches rdf:type rdf:Property ;
    rdfs:label 'Pipeline Diameter Inches' ;
    rdfs:comment 'Nominal diameter of the surveyed pipeline segment in inches. Used for leak size estimation and repair planning.' ;
    rdfs:domain ind:GasLeakSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pipelineMaterial rdf:type rdf:Property ;
    rdfs:label 'Pipeline Material' ;
    rdfs:comment 'Material composition of the surveyed pipeline segment. PE is polyethylene; HDPE is high-density polyethylene. Material type affects leak risk and survey frequency requirements. [ENUM-REF-CANDIDATE: steel|cast iron|plastic|PE|HDPE|copper|bare steel|coated steel — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:GasLeakSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pipelineSegmentType rdf:type rdf:Property ;
    rdfs:label 'Pipeline Segment Type' ;
    rdfs:comment 'Classification of the pipeline infrastructure component surveyed. Main is distribution backbone; service lateral is customer connection; riser is vertical pipe to meter.' ;
    rdfs:domain ind:GasLeakSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorSurveyDate rdf:type rdf:Property ;
    rdfs:label 'Prior Survey Date' ;
    rdfs:comment 'Date of the most recent previous leak survey performed on this pipeline segment. Used to verify compliance with PHMSA survey frequency requirements.' ;
    rdfs:domain ind:GasLeakSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:repairCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Repair Completion Date' ;
    rdfs:comment 'Actual date on which the leak repair was completed and verified. Used for regulatory compliance reporting and SAIDI/SAIFI reliability metrics. Null if repair not yet completed.' ;
    rdfs:domain ind:GasLeakSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:repairDueDate rdf:type rdf:Property ;
    rdfs:label 'Repair Due Date' ;
    rdfs:comment 'Regulatory deadline by which the detected leak must be repaired. Grade 1 leaks require immediate action; Grade 2 leaks must be repaired within 12 months per PHMSA. Null if no repair required.' ;
    rdfs:domain ind:GasLeakSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:repairPriority rdf:type rdf:Property ;
    rdfs:label 'Repair Priority' ;
    rdfs:comment 'Work order priority classification for leak repair. Immediate for Grade 1 hazardous leaks; scheduled for Grade 2; monitor for Grade 3.' ;
    rdfs:domain ind:GasLeakSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceTerritoryState rdf:type rdf:Property ;
    rdfs:label 'Service Territory State' ;
    rdfs:comment 'Two-letter state code where the survey was performed. Used for state PUC regulatory reporting and jurisdictional compliance tracking.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyCrewSize rdf:type rdf:Property ;
    rdfs:label 'Survey Crew Size' ;
    rdfs:comment 'Number of personnel assigned to the survey crew. Used for workforce planning and cost allocation.' ;
    rdfs:domain ind:GasLeakSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:surveyDate rdf:type rdf:Property ;
    rdfs:label 'Survey Date' ;
    rdfs:comment 'The date on which the leak survey or investigation was performed in the field. Principal business event timestamp for the survey transaction.' ;
    rdfs:domain ind:GasLeakSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:surveyDurationHours rdf:type rdf:Property ;
    rdfs:label 'Survey Duration Hours' ;
    rdfs:comment 'Total time in hours spent performing the leak survey. Used for labor cost tracking and productivity analysis.' ;
    rdfs:domain ind:GasLeakSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:surveyExternalCode rdf:type rdf:Property ;
    rdfs:label 'Survey External Code' ;
    rdfs:comment 'External business identifier for the survey as recorded in the source system (e.g., Oracle WAM, IBM Maximo work order number or survey ticket number). Used for cross-system reconciliation and audit trail.' ;
    rdfs:domain ind:GasLeakSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyFrequencyMonths rdf:type rdf:Property ;
    rdfs:label 'Survey Frequency Months' ;
    rdfs:comment 'Regulatory-mandated survey frequency in months for this pipeline segment. PHMSA requires annual surveys for business districts, multi-year for less critical areas. Used for compliance scheduling.' ;
    rdfs:domain ind:GasLeakSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:surveyMethod rdf:type rdf:Property ;
    rdfs:label 'Survey Method' ;
    rdfs:comment 'The leak detection method or technology used during the survey. CGI is Combustible Gas Indicator; bar-hole is physical probe method; flame ionization is laboratory-grade detector.' ;
    rdfs:domain ind:GasLeakSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyNotes rdf:type rdf:Property ;
    rdfs:label 'Survey Notes' ;
    rdfs:comment 'Free-text field for surveyor observations, special conditions, access issues, or other contextual information relevant to the survey. Used for audit trail and follow-up investigation.' ;
    rdfs:domain ind:GasLeakSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyStatus rdf:type rdf:Property ;
    rdfs:label 'Survey Status' ;
    rdfs:comment 'Current lifecycle status of the survey record. Tracks progression from scheduling through completion and regulatory approval.' ;
    rdfs:domain ind:GasLeakSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyType rdf:type rdf:Property ;
    rdfs:label 'Survey Type' ;
    rdfs:comment 'Classification of the survey activity. Leak survey is routine PHMSA-mandated inspection; leak investigation is response to reported leak; follow-up survey is re-inspection of previously identified leak.' ;
    rdfs:domain ind:GasLeakSurvey ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cityGateStationId rdf:type rdf:Property ;
    rdfs:label 'City Gate Station Id' ;
    rdfs:comment 'Reference to the city gate or gate station that feeds the pressure zone containing this gas main segment. Used for supply traceability, pressure management, and gas quality tracking.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CityGateStation .

ind:fromNodeId rdf:type rdf:Property ;
    rdfs:label 'From Node Id' ;
    rdfs:comment 'GIS network node identifier at the upstream (supply) end of the gas main segment. Used for network topology traversal, hydraulic modeling, and outage/isolation analysis.' ;
    rdfs:domain ind:GasMain ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GasNetworkNode .

ind:cathodicProtectionFlag rdf:type rdf:Property ;
    rdfs:label 'Cathodic Protection Flag' ;
    rdfs:comment 'Indicates whether the gas main segment is covered by an active cathodic protection (CP) system. True = CP system in place and active; False = no cathodic protection. Required for PHMSA corrosion control compliance on steel mains per 49 CFR Part 192 Subpart I.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cathodicProtectionType rdf:type rdf:Property ;
    rdfs:label 'Cathodic Protection Type' ;
    rdfs:comment 'Type of cathodic protection system applied to the gas main segment. Impressed-current systems use rectifiers; sacrificial-anode systems use zinc or magnesium anodes. Used in corrosion control program documentation and PHMSA compliance records.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coatingType rdf:type rdf:Property ;
    rdfs:label 'Coating Type' ;
    rdfs:comment 'External corrosion protection coating applied to the pipe. Relevant primarily for steel mains. Used in corrosion control program management and PHMSA integrity management. Values: fusion-bonded-epoxy, coal-tar, polyethylene-tape, bare (no coating), other, unknown.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crossingType rdf:type rdf:Property ;
    rdfs:label 'Crossing Type' ;
    rdfs:comment 'Type of infrastructure crossing associated with this gas main segment, if applicable. Used for permit tracking, inspection scheduling, and PHMSA high-consequence area (HCA) assessments. Values: road, railroad, water, aerial, none.' ;
    rdfs:domain ind:GasMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dimpThreatRank rdf:type rdf:Property ;
    rdfs:label 'Dimp Threat Rank' ;
    rdfs:comment 'Risk/threat ranking assigned to this gas main segment under the utility\'s Distribution Integrity Management Program (DIMP) as required by PHMSA 49 CFR Part 192 Subpart P. Drives prioritization of inspection, repair, and replacement activities.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:districtCode rdf:type rdf:Property ;
    rdfs:label 'District Code' ;
    rdfs:comment 'Code identifying the gas distribution operating district or service territory subdivision responsible for this main segment. Used for O&M cost allocation, workforce dispatch, and regulatory reporting by district.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:encasedFlag rdf:type rdf:Property ;
    rdfs:label 'Encased Flag' ;
    rdfs:comment 'Indicates whether the gas main segment is installed within a casing pipe (e.g., at road crossings, railroad crossings, or water crossings). True = encased; False = direct burial. Relevant for PHMSA integrity management and maintenance access planning.' ;
    rdfs:domain ind:GasMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:installationYear rdf:type rdf:Property ;
    rdfs:label 'Installation Year' ;
    rdfs:comment 'Year the gas main segment was installed, retained as a separate field for legacy records where only the year (not full date) is known from historical GIS or paper records. Used in PHMSA annual mileage reporting by decade of installation.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:installedBy rdf:type rdf:Property ;
    rdfs:label 'Installed By' ;
    rdfs:comment 'Name of the contractor or utility crew that installed the gas main segment. Used for construction quality traceability and warranty/liability tracking.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jointType rdf:type rdf:Property ;
    rdfs:label 'Joint Type' ;
    rdfs:comment 'Type of pipe joint used in the gas main segment construction. Relevant for integrity assessment and leak history analysis. [ENUM-REF-CANDIDATE: butt-fusion|electrofusion|mechanical|threaded|welded|bell-spigot|other — promote to reference product]' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leakSurveyDate rdf:type rdf:Property ;
    rdfs:label 'Leak Survey Date' ;
    rdfs:comment 'Date of the most recent leak survey conducted on this gas main segment. Used to track compliance with PHMSA-mandated leak survey frequency requirements, which vary by pipe material, pressure tier, and class location.' ;
    rdfs:domain ind:GasMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:leakSurveyMethod rdf:type rdf:Property ;
    rdfs:label 'Leak Survey Method' ;
    rdfs:comment 'Method used in the most recent leak survey of this gas main segment. Values: bar-hole (soil probe), walking (combustible gas indicator on foot), mobile (vehicle-mounted methane detector), aerial (helicopter/drone), other.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mainCode rdf:type rdf:Property ;
    rdfs:label 'Main Code' ;
    rdfs:comment 'Externally-known alphanumeric identifier for the gas main segment as assigned in the GIS (ESRI ArcGIS) and referenced in PHMSA pipeline safety records, work orders, and field documentation. Serves as the BUSINESS_IDENTIFIER / natural key for cross-system traceability.' ;
    rdfs:domain ind:GasMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mainName rdf:type rdf:Property ;
    rdfs:label 'Main Name' ;
    rdfs:comment 'Human-readable descriptive name or label for the gas main segment (e.g., \'Oak Street 4-inch PE Main\'). Serves as the IDENTITY_LABEL for operational reference and field crew communication.' ;
    rdfs:domain ind:GasMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maopPsig rdf:type rdf:Property ;
    rdfs:label 'Maop Psig' ;
    rdfs:comment 'Maximum Allowable Operating Pressure in pounds per square inch gauge (PSIG) as established per PHMSA 49 CFR Part 192. The regulatory ceiling for operating pressure on this segment. Critical for pipeline safety compliance and integrity management programs.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:municipality rdf:type rdf:Property ;
    rdfs:label 'Municipality' ;
    rdfs:comment 'Name of the city, town, or municipality in which the gas main segment is located. Used for regulatory reporting, permit management, and service territory mapping.' ;
    rdfs:domain ind:GasMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nominalDiameterIn rdf:type rdf:Property ;
    rdfs:label 'Nominal Diameter In' ;
    rdfs:comment 'Nominal pipe diameter in inches (e.g., 2, 4, 6, 8, 12). MEASUREMENT_OR_VALUE for this pipeline asset. Used for capacity calculations, flow modeling, and replacement cost estimation. Standard nominal sizes per ASME B36.10M.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:phmsaClassLocation rdf:type rdf:Property ;
    rdfs:label 'Phmsa Class Location' ;
    rdfs:comment 'Pipeline class location (1 through 4) as defined by PHMSA 49 CFR Part 192 §192.5, based on population density within a sliding-mile corridor along the pipeline. Class 1 = rural/low density; Class 4 = high-density urban. Determines design factor, testing requirements, and integrity management obligations.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pipeDepthIn rdf:type rdf:Property ;
    rdfs:label 'Pipe Depth In' ;
    rdfs:comment 'Depth of cover over the gas main in inches, measured from ground surface to top of pipe. Used to verify compliance with minimum cover requirements per PHMSA 49 CFR Part 192 §192.327 and to assess third-party damage risk.' ;
    rdfs:domain ind:GasMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pipeGrade rdf:type rdf:Property ;
    rdfs:label 'Pipe Grade' ;
    rdfs:comment 'Material grade or specification of the pipe (e.g., ASTM D2513 for PE, API 5L Grade B for steel). Used in integrity management calculations, MAOP determination, and PHMSA compliance documentation.' ;
    rdfs:domain ind:GasMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pipeMaterial rdf:type rdf:Property ;
    rdfs:label 'Pipe Material' ;
    rdfs:comment 'Material composition of the gas main pipe. Critical for PHMSA pipeline integrity management, leak survey frequency determination, and replacement prioritization. Common values: PE (polyethylene — modern standard), steel (bare or coated), cast-iron (legacy, high leak risk), wrought-iron (legacy), copper, PVC, other. [ENUM-REF-CANDIDATE: PE|steel|cast-iron|wrought-iron|copper|PVC|other — promote to reference product]' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pressureTier rdf:type rdf:Property ;
    rdfs:label 'Pressure Tier' ;
    rdfs:comment 'Pressure classification tier of the gas main segment. Drives operational procedures, regulator station requirements, and customer service pressure expectations. Values: high (typically >60 PSIG), medium (typically 0.5–60 PSIG), low (typically <0.5 PSIG), very-low (inches of water column).' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pressureZoneCode rdf:type rdf:Property ;
    rdfs:label 'Pressure Zone Code' ;
    rdfs:comment 'Code identifying the gas distribution pressure zone or district regulator area to which this main segment belongs. Used for hydraulic network modeling, pressure management, and operational dispatch. Sourced from ESRI ArcGIS network topology.' ;
    rdfs:domain ind:GasMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:routeGeometryWkt rdf:type rdf:Property ;
    rdfs:label 'Route Geometry Wkt' ;
    rdfs:comment 'GIS route geometry of the gas main segment encoded as Well-Known Text (WKT) LINESTRING in WGS84 coordinate reference system. Enables spatial analysis, proximity queries, and map visualization in the lakehouse without requiring a live GIS connection.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seamType rdf:type rdf:Property ;
    rdfs:label 'Seam Type' ;
    rdfs:comment 'Longitudinal seam type for steel pipe mains (e.g., seamless, ERW — Electric Resistance Welded, DSAW — Double Submerged Arc Welded). Used in integrity management threat identification per PHMSA Distribution Integrity Management Program (DIMP) requirements.' ;
    rdfs:domain ind:GasMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentLengthFt rdf:type rdf:Property ;
    rdfs:label 'Segment Length Ft' ;
    rdfs:comment 'Physical length of the gas main segment in feet as measured in the GIS network. Used for leak survey scheduling, replacement cost estimation, PHMSA mileage reporting, and O&M planning.' ;
    rdfs:domain ind:GasMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:toNodeCode rdf:type rdf:Property ;
    rdfs:label 'To Node Code' ;
    rdfs:comment 'GIS network node identifier at the downstream (delivery) end of the gas main segment. Used for network topology traversal, hydraulic modeling, and isolation analysis.' ;
    rdfs:domain ind:GasMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wallThicknessIn rdf:type rdf:Property ;
    rdfs:label 'Wall Thickness In' ;
    rdfs:comment 'Nominal pipe wall thickness in inches. Used in MAOP calculations per PHMSA 49 CFR Part 192 hoop stress formula and in integrity management assessments.' ;
    rdfs:domain ind:GasMain ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gasServiceLateralId rdf:type rdf:Property ;
    rdfs:label 'Gas Service Lateral Id' ;
    rdfs:comment 'Unique identifier for the gas service lateral record. Primary key for the gas service lateral entity.' ;
    rdfs:domain ind:GasServiceLateral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:efvInstallationDate rdf:type rdf:Property ;
    rdfs:label 'Efv Installation Date' ;
    rdfs:comment 'Date when the excess flow valve was installed on the service lateral. Tracks compliance with PHMSA EFV installation requirements and supports maintenance scheduling.' ;
    rdfs:domain ind:GasServiceLateral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:excessFlowValveFlag rdf:type rdf:Property ;
    rdfs:label 'Excess Flow Valve Flag' ;
    rdfs:comment 'Indicates whether an excess flow valve is installed on the service lateral. EFVs are safety devices that automatically restrict gas flow in the event of a line break or excessive flow condition, required under PHMSA regulations for certain installations.' ;
    rdfs:domain ind:GasServiceLateral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastLeakSurveyDate rdf:type rdf:Property ;
    rdfs:label 'Last Leak Survey Date' ;
    rdfs:comment 'Date of the most recent leak survey conducted on the service lateral. PHMSA requires periodic leak surveys based on class location and pressure tier to detect and repair gas leaks.' ;
    rdfs:domain ind:GasServiceLateral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lateralCode rdf:type rdf:Property ;
    rdfs:label 'Lateral Code' ;
    rdfs:comment 'Business identifier or code assigned to the gas service lateral for operational reference and tracking within the utility\'s asset management system.' ;
    rdfs:domain ind:GasServiceLateral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lengthFt rdf:type rdf:Property ;
    rdfs:label 'Length Ft' ;
    rdfs:comment 'Total length of the service lateral from the gas main connection point to the customer meter location, measured in feet. Used for material inventory, replacement cost estimation, and pressure drop calculations.' ;
    rdfs:domain ind:GasServiceLateral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nextLeakSurveyDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Leak Survey Due Date' ;
    rdfs:comment 'Scheduled date for the next required leak survey based on PHMSA regulatory frequency requirements and the utility\'s integrity management program.' ;
    rdfs:domain ind:GasServiceLateral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:loadProfileId rdf:type rdf:Property ;
    rdfs:label 'Load Profile Id' ;
    rdfs:comment 'Unique identifier for the load profile measurement record. Primary key for the load profile data product.' ;
    rdfs:domain ind:LoadProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:apparentPowerKva rdf:type rdf:Property ;
    rdfs:label 'Apparent Power Kva' ;
    rdfs:comment 'Average apparent power in kilovolt-amperes during the measurement interval. Represents the total power flow including both real and reactive components.' ;
    rdfs:domain ind:LoadProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:averageVoltageV rdf:type rdf:Property ;
    rdfs:label 'Average Voltage V' ;
    rdfs:comment 'Average voltage in volts measured during the interval. Used for voltage regulation analysis and power quality monitoring.' ;
    rdfs:domain ind:LoadProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:circuitMiles rdf:type rdf:Property ;
    rdfs:label 'Circuit Miles' ;
    rdfs:comment 'Total circuit miles of distribution infrastructure served by the measurement point. Used for load density calculations and capacity planning.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:computationMethod rdf:type rdf:Property ;
    rdfs:label 'Computation Method' ;
    rdfs:comment 'Algorithm or method used to compute aggregated load values from raw telemetry or AMI interval data. Describes the aggregation logic applied by the historian or MDMS system.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:computedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Computed Timestamp' ;
    rdfs:comment 'Date and time when the load profile record was computed or aggregated by the source system. Distinct from the measurement timestamp, represents the processing time.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:currentAmperes rdf:type rdf:Property ;
    rdfs:label 'Current Amperes' ;
    rdfs:comment 'Average current flow in amperes during the measurement interval. Used for thermal loading analysis and conductor capacity assessment.' ;
    rdfs:domain ind:LoadProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dataQualityFlag rdf:type rdf:Property ;
    rdfs:label 'Data Quality Flag' ;
    rdfs:comment 'Quality indicator for the load measurement data. Flags data that has been estimated, is suspect, missing, or manually overridden for operational or analytical purposes.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:demandResponseEventFlag rdf:type rdf:Property ;
    rdfs:label 'Demand Response Event Flag' ;
    rdfs:comment 'Indicates whether a demand response event was active during the measurement interval. True when load curtailment or demand-side management programs were in effect.' ;
    rdfs:domain ind:LoadProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:derPenetrationPercent rdf:type rdf:Property ;
    rdfs:label 'Der Penetration Percent' ;
    rdfs:comment 'Percentage of total load served by Distributed Energy Resources at the measurement point during the interval. Used for DER impact analysis and hosting capacity studies.' ;
    rdfs:domain ind:LoadProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:energyDeliveredKwh rdf:type rdf:Property ;
    rdfs:label 'Energy Delivered Kwh' ;
    rdfs:comment 'Total energy delivered in kilowatt-hours during the measurement interval. Represents the integrated real power over the interval duration.' ;
    rdfs:domain ind:LoadProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimationMethod rdf:type rdf:Property ;
    rdfs:label 'Estimation Method' ;
    rdfs:comment 'Method used to estimate or interpolate missing or suspect load data. Describes the algorithm or business rule applied when actual measurements were unavailable.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hostingCapacityAnalysisFlag rdf:type rdf:Property ;
    rdfs:label 'Hosting Capacity Analysis Flag' ;
    rdfs:comment 'Indicates whether this load profile record is used for Distributed Energy Resource (DER) hosting capacity analysis. True when the data supports feeder-level solar or storage impact modeling.' ;
    rdfs:domain ind:LoadProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:measurementIntervalMinutes rdf:type rdf:Property ;
    rdfs:label 'Measurement Interval Minutes' ;
    rdfs:comment 'Duration of the measurement interval in minutes. Common values are 15, 30, or 60 minutes for distribution load profiling and capacity analysis.' ;
    rdfs:domain ind:LoadProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:measurementPointName rdf:type rdf:Property ;
    rdfs:label 'Measurement Point Name' ;
    rdfs:comment 'Human-readable name or designation of the measurement point in the distribution network. Used for operational identification and reporting.' ;
    rdfs:domain ind:LoadProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measurementPointType rdf:type rdf:Property ;
    rdfs:label 'Measurement Point Type' ;
    rdfs:comment 'Type of distribution network measurement point where load data was captured. Indicates the level of aggregation in the distribution hierarchy.' ;
    rdfs:domain ind:LoadProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measurementTimestamp rdf:type rdf:Property ;
    rdfs:label 'Measurement Timestamp' ;
    rdfs:comment 'Date and time when the load measurement interval ended. Represents the real-world event time for the aggregated load reading from SCADA or AMI systems.' ;
    rdfs:domain ind:LoadProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:planningAreaCode rdf:type rdf:Property ;
    rdfs:label 'Planning Area Code' ;
    rdfs:comment 'Distribution planning area or zone code where the measurement point is located. Used for capacity planning, load forecasting, and capital investment prioritization.' ;
    rdfs:domain ind:LoadProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:powerFactor rdf:type rdf:Property ;
    rdfs:label 'Power Factor' ;
    rdfs:comment 'Ratio of real power to apparent power during the measurement interval. Indicates the efficiency of power utilization at the measurement point. Values range from 0 to 1.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reactivePowerKvar rdf:type rdf:Property ;
    rdfs:label 'Reactive Power Kvar' ;
    rdfs:comment 'Average reactive power in kilovolt-amperes reactive during the measurement interval. Used for voltage regulation and power factor analysis.' ;
    rdfs:domain ind:LoadProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:realPowerKw rdf:type rdf:Property ;
    rdfs:label 'Real Power Kw' ;
    rdfs:comment 'Average real power demand in kilowatts during the measurement interval. Represents the actual power consumed or delivered at the measurement point.' ;
    rdfs:domain ind:LoadProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:temperatureAdjustedDemandKw rdf:type rdf:Property ;
    rdfs:label 'Temperature Adjusted Demand Kw' ;
    rdfs:comment 'Real power demand normalized for ambient temperature variations. Used for weather-normalized load forecasting and capacity planning to remove seasonal temperature effects.' ;
    rdfs:domain ind:LoadProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:utilityIdentifier rdf:type rdf:Property ;
    rdfs:label 'Utility Identifier' ;
    rdfs:comment 'Unique identifier for the utility company operating the measurement point. Used for multi-utility environments and regulatory reporting to FERC and state PUCs.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:protectiveDeviceId rdf:type rdf:Property ;
    rdfs:label 'Protective Device Id' ;
    rdfs:comment 'Asset identifier of the protective device (recloser, fuse, breaker, sectionalizer) that operated during this outage event, as recorded in the GIS or EAM system. Used to track device operation history and support asset reliability analysis.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProtectiveDevice .

ind:actualCustomersAffected rdf:type rdf:Property ;
    rdfs:label 'Actual Customers Affected' ;
    rdfs:comment 'Verified count of customer service points that experienced an interruption during this outage event, confirmed after restoration. This is the authoritative figure used in SAIDI and SAIFI index calculations reported to the PUC. Distinct from estimated_customers_affected which is the initial OMS estimate.' ;
    rdfs:domain ind:DistributionOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:caidiMinutes rdf:type rdf:Property ;
    rdfs:label 'Caidi Minutes' ;
    rdfs:comment 'Customer Average Interruption Duration Index (CAIDI) for this event, representing the average restoration time experienced by affected customers. Calculated as outage_duration_minutes / 1 (per-event basis) or as SAIDI contribution / SAIFI contribution at the event level. Used in PUC reliability performance benchmarking.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:causeCode rdf:type rdf:Property ;
    rdfs:label 'Cause Code' ;
    rdfs:comment 'Standardized cause code identifying the primary reason for the outage, sourced from the OMS cause code library. Common values include: weather, equipment_failure, animal, vegetation, vehicle, human_error, unknown, scheduled_maintenance, third_party. [ENUM-REF-CANDIDATE: weather|equipment_failure|animal|vegetation|vehicle|human_error|unknown|scheduled_maintenance|third_party|overload — promote to reference product]' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:causeDescription rdf:type rdf:Property ;
    rdfs:label 'Cause Description' ;
    rdfs:comment 'Free-text narrative description of the outage cause as entered by the field crew or OMS operator, providing additional context beyond the standardized cause code. Used for post-event analysis and regulatory reporting narratives.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crewArrivalTimestamp rdf:type rdf:Property ;
    rdfs:label 'Crew Arrival Timestamp' ;
    rdfs:comment 'Date and time when the first field crew arrived at the fault location. Used to calculate crew response time (crew_arrival_timestamp minus outage_start_timestamp) for operational performance monitoring and PUC reporting on emergency response.' ;
    rdfs:domain ind:DistributionOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:crewDispatchId rdf:type rdf:Property ;
    rdfs:label 'Crew Dispatch Id' ;
    rdfs:comment 'Identifier of the crew dispatch or work order record associated with this outage event, linking to the workforce/work management system (Oracle WAM or IBM Maximo). Used to correlate outage events with crew response times, labor costs, and O&M reporting.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:crewDispatchTimestamp rdf:type rdf:Property ;
    rdfs:label 'Crew Dispatch Timestamp' ;
    rdfs:comment 'Date and time when the field crew was dispatched from the OMS/dispatch center to respond to this outage event. Used to measure dispatch response time and crew mobilization performance.' ;
    rdfs:domain ind:DistributionOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:customersRestoredPartial rdf:type rdf:Property ;
    rdfs:label 'Customers Restored Partial' ;
    rdfs:comment 'Number of customers restored through partial restoration switching actions before the final full restoration of the outage event. Populated only when partial_restoration_flag is True. Used for accurate CAIDI calculation when restoration occurs in stages.' ;
    rdfs:domain ind:DistributionOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:estimatedCustomersAffected rdf:type rdf:Property ;
    rdfs:label 'Estimated Customers Affected' ;
    rdfs:comment 'Initial estimate of the number of customer service points interrupted by this outage event, as determined by the OMS at the time of event creation based on network topology and affected equipment. Used for early situational awareness and crew dispatch prioritization.' ;
    rdfs:domain ind:DistributionOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:faultLatitude rdf:type rdf:Property ;
    rdfs:label 'Fault Latitude' ;
    rdfs:comment 'Geographic latitude coordinate (decimal degrees, WGS84) of the confirmed fault location, as captured by field crew GPS or GIS snap. Used for spatial analysis of outage patterns, vegetation management targeting, and storm damage assessment.' ;
    rdfs:domain ind:DistributionOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:faultLocationDescription rdf:type rdf:Property ;
    rdfs:label 'Fault Location Description' ;
    rdfs:comment 'Free-text description of the physical location where the fault or outage cause was identified (e.g., pole number, street address, GPS coordinates, landmark). Captured by field crew upon arrival and entered into the OMS. Supports post-event analysis and asset failure pattern identification.' ;
    rdfs:domain ind:DistributionOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:faultLongitude rdf:type rdf:Property ;
    rdfs:label 'Fault Longitude' ;
    rdfs:comment 'Geographic longitude coordinate (decimal degrees, WGS84) of the confirmed fault location, as captured by field crew GPS or GIS snap. Used in conjunction with fault_latitude for spatial outage analysis and GIS-based reliability reporting.' ;
    rdfs:domain ind:DistributionOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ieee1366ExclusionFlag rdf:type rdf:Property ;
    rdfs:label 'Ieee1366 Exclusion Flag' ;
    rdfs:comment 'Indicates whether this outage event is excluded from SAIDI/SAIFI/CAIDI index calculations per IEEE 1366-2012 major event day (MED) criteria or other exclusion rules (e.g., planned outages, momentary events). True = excluded from reliability indices; False = included in reliability index calculations.' ;
    rdfs:domain ind:DistributionOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ieee1366ExclusionReason rdf:type rdf:Property ;
    rdfs:label 'Ieee1366 Exclusion Reason' ;
    rdfs:comment 'Reason code explaining why this outage event is excluded from IEEE 1366 reliability index calculations. Populated only when ieee1366_exclusion_flag is True. \'major_event_day\' = event occurred on a day classified as a Major Event Day per IEEE 1366 beta method; \'planned_outage\' = scheduled interruption; \'momentary\' = duration under 5 minutes; \'loss_of_supply\' = bulk transmission supply failure.' ;
    rdfs:domain ind:DistributionOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:momentaryInterruptionCount rdf:type rdf:Property ;
    rdfs:label 'Momentary Interruption Count' ;
    rdfs:comment 'Number of momentary interruptions (each less than 5 minutes) associated with this outage event, typically caused by recloser operations before a sustained outage is declared. Used to calculate the Momentary Average Interruption Frequency Index (MAIFI) per IEEE 1366.' ;
    rdfs:domain ind:DistributionOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:mutualAidFlag rdf:type rdf:Property ;
    rdfs:label 'Mutual Aid Flag' ;
    rdfs:comment 'Indicates whether mutual aid crews from another utility were requested or utilized to restore this outage event. True = mutual aid activated; False = restored with own crews. Relevant for storm restoration cost tracking, mutual aid agreement compliance, and FEMA reimbursement documentation.' ;
    rdfs:domain ind:DistributionOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:omsEventCode rdf:type rdf:Property ;
    rdfs:label 'Oms Event Code' ;
    rdfs:comment 'Native event identifier from the source Outage Management System (Schneider Electric AMS or GE PowerOn OMS). Preserved for lineage traceability and cross-system reconciliation between the Silver layer and the operational OMS. Distinct from the surrogate outage_event_id.' ;
    rdfs:domain ind:DistributionOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outageStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Outage Start Timestamp' ;
    rdfs:comment 'Date and time (ISO 8601 with timezone offset) when the outage event began — i.e., when the interruption to customer electric service was first confirmed by the OMS. This is the principal real-world event time used as the basis for outage duration calculations and SAIDI/SAIFI index reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:outageType rdf:type rdf:Property ;
    rdfs:label 'Outage Type' ;
    rdfs:comment 'Classification of the outage event by its nature. \'unplanned\' = sustained interruption caused by an unexpected fault or failure; \'planned\' = scheduled interruption for maintenance or construction (excluded from SAIDI/SAIFI per IEEE 1366); \'momentary\' = interruption lasting less than 5 minutes (excluded from sustained SAIDI/SAIFI but tracked for MAIFI).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:partialRestorationFlag rdf:type rdf:Property ;
    rdfs:label 'Partial Restoration Flag' ;
    rdfs:comment 'Indicates whether a partial restoration was performed during this outage event — i.e., some customers were restored via switching before the full fault repair was completed. True = partial restoration occurred; False = all customers restored simultaneously. Relevant for multi-step restoration tracking and CAIDI accuracy.' ;
    rdfs:domain ind:DistributionOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:partialRestorationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Partial Restoration Timestamp' ;
    rdfs:comment 'Date and time when the first partial restoration of customers was achieved through switching, prior to full fault repair. Populated only when partial_restoration_flag is True. Used in multi-step CAIDI calculations.' ;
    rdfs:domain ind:DistributionOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:protectiveDeviceType rdf:type rdf:Property ;
    rdfs:label 'Protective Device Type' ;
    rdfs:comment 'Type of protective device that operated to isolate the fault and initiate the outage event. Used for equipment failure analysis, recloser operation tracking, and momentary vs. sustained interruption classification.' ;
    rdfs:domain ind:DistributionOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingPeriod rdf:type rdf:Property ;
    rdfs:label 'Reporting Period' ;
    rdfs:comment 'The regulatory reporting period (e.g., \'2024-Q1\', \'2024-Annual\') to which this outage event is attributed for SAIDI/SAIFI/CAIDI index reporting to the State PUC. Supports period-based reliability index aggregation and regulatory filing preparation.' ;
    rdfs:domain ind:DistributionOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:restorationMethod rdf:type rdf:Property ;
    rdfs:label 'Restoration Method' ;
    rdfs:comment 'Method used to restore power to affected customers. \'crew_repair\' = physical repair of damaged equipment by field crew; \'switching\' = manual switching to alternate supply path; \'auto_recloser\' = automatic recloser operation restored supply; \'fuse_replacement\' = blown fuse replaced; \'remote_switching\' = SCADA/DMS-initiated remote switching; \'temporary_bypass\' = temporary cable or jumper installed pending permanent repair.' ;
    rdfs:domain ind:DistributionOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:saidiContributionMinutes rdf:type rdf:Property ;
    rdfs:label 'Saidi Contribution Minutes' ;
    rdfs:comment 'This event\'s contribution to the System Average Interruption Duration Index (SAIDI), calculated as (actual_customers_affected × outage_duration_minutes) / total_customers_served. Stored per event to enable period-level SAIDI aggregation for PUC reliability reporting. Zero for IEEE 1366 excluded events.' ;
    rdfs:domain ind:DistributionOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:poleId rdf:type rdf:Property ;
    rdfs:label 'Pole Id' ;
    rdfs:comment 'Unique identifier for the distribution pole or structure. Primary key for the pole master record.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Pole .

ind:acquisitionCost rdf:type rdf:Property ;
    rdfs:label 'Acquisition Cost' ;
    rdfs:comment 'Original purchase and installation cost of the pole structure in USD. Used for capital expenditure tracking, depreciation calculations, and rate base reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bookValue rdf:type rdf:Property ;
    rdfs:label 'Book Value' ;
    rdfs:comment 'Current net book value of the pole asset after accumulated depreciation. Used for financial reporting, rate case preparation, and asset valuation.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:classRating rdf:type rdf:Property ;
    rdfs:label 'Class Rating' ;
    rdfs:comment 'ANSI class designation indicating the pole\'s structural strength and load-bearing capacity (e.g., Class 1, Class 2, Class H1). Determines maximum allowable loading for conductors, transformers, and attachments.' ;
    rdfs:domain ind:Pole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fccPoleAttachmentComplianceStatus rdf:type rdf:Property ;
    rdfs:label 'Fcc Pole Attachment Compliance Status' ;
    rdfs:comment 'Compliance status with FCC pole attachment regulations governing third-party access, rental rates, and safety clearances for telecommunications and cable TV attachments.' ;
    rdfs:domain ind:Pole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gisStructureNumber rdf:type rdf:Property ;
    rdfs:label 'Gis Structure Number' ;
    rdfs:comment 'Unique structure identifier assigned by the ESRI ArcGIS system for network topology modeling and spatial analysis. Links pole record to GIS feature layer.' ;
    rdfs:domain ind:Pole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:groundLineCondition rdf:type rdf:Property ;
    rdfs:label 'Ground Line Condition' ;
    rdfs:comment 'Structural condition assessment at the ground line where the pole enters the soil. This is the most critical inspection point for wood poles as decay typically begins at ground level.' ;
    rdfs:domain ind:Pole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:heightFt rdf:type rdf:Property ;
    rdfs:label 'Height Ft' ;
    rdfs:comment 'Total height of the pole structure measured in feet from ground level to the top. Used for clearance calculations, loading analysis, and vegetation management planning.' ;
    rdfs:domain ind:Pole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:jointUseAttachmentCount rdf:type rdf:Property ;
    rdfs:label 'Joint Use Attachment Count' ;
    rdfs:comment 'Total number of third-party attachments on the pole including cable TV, telecommunications, and broadband providers. Critical for FCC pole attachment compliance and loading analysis.' ;
    rdfs:domain ind:Pole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastMaintenanceDate rdf:type rdf:Property ;
    rdfs:label 'Last Maintenance Date' ;
    rdfs:comment 'Date of the most recent maintenance activity performed on the pole including treatment, repair, or reinforcement work.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:loadingPercentage rdf:type rdf:Property ;
    rdfs:label 'Loading Percentage' ;
    rdfs:comment 'Current loading as a percentage of the pole\'s rated capacity based on NESC calculations. Includes weight and wind loading from conductors, transformers, and attachments. Values exceeding 100% indicate overloading requiring remediation.' ;
    rdfs:domain ind:Pole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:materialType rdf:type rdf:Property ;
    rdfs:label 'Material Type' ;
    rdfs:comment 'Primary construction material of the pole structure. Critical for pole loading analysis, inspection protocols, treatment requirements, and lifecycle management.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:poleNumber rdf:type rdf:Property ;
    rdfs:label 'Pole Number' ;
    rdfs:comment 'Externally-known utility-assigned pole number or tag identifier used for field operations, maintenance work orders, and joint-use attachment management. This is the business identifier displayed on the physical pole structure.' ;
    rdfs:domain ind:Pole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:poleType rdf:type rdf:Property ;
    rdfs:label 'Pole Type' ;
    rdfs:comment 'Classification of the pole based on its primary utility function within the electric or communication infrastructure.' ;
    rdfs:domain ind:Pole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stormHardeningFlag rdf:type rdf:Property ;
    rdfs:label 'Storm Hardening Flag' ;
    rdfs:comment 'Indicates whether the pole has been upgraded with storm hardening measures such as stronger materials, deeper embedment, or guy wire reinforcement to improve resilience against extreme weather events.' ;
    rdfs:domain ind:Pole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:treatmentType rdf:type rdf:Property ;
    rdfs:label 'Treatment Type' ;
    rdfs:comment 'Chemical preservative treatment applied to wood poles to prevent decay and extend service life. CCA (Chromated Copper Arsenate) and pentachlorophenol are common treatments. Relevant only for wood poles.' ;
    rdfs:domain ind:Pole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vegetationClearanceZoneFt rdf:type rdf:Property ;
    rdfs:label 'Vegetation Clearance Zone Ft' ;
    rdfs:comment 'Required radial clearance distance in feet from the pole and conductors for vegetation management. Based on voltage level and NERC FAC-003 standards.' ;
    rdfs:domain ind:Pole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reliabilityIndexId rdf:type rdf:Property ;
    rdfs:label 'Reliability Index Id' ;
    rdfs:comment 'Unique surrogate identifier for each reliability index record. Primary key for the reliability_index data product in the distribution domain Silver layer.' ;
    rdfs:domain ind:ReliabilityIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:indexVersion rdf:type rdf:Property ;
    rdfs:label 'Index Version' ;
    rdfs:comment 'Sequential version number for this reliability index record, incremented each time the record is revised or amended (e.g., due to outage data corrections or MED reclassification). Version 1 = initial computation. Supports audit trail for regulatory restatements.' ;
    rdfs:domain ind:ReliabilityIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:interruptionCauseCategory rdf:type rdf:Property ;
    rdfs:label 'Interruption Cause Category' ;
    rdfs:comment 'Dominant cause category for interruptions contributing to this reliability index record, per IEEE 1366 cause code taxonomy. Examples: weather, equipment failure, tree contact, animal contact, vehicle accident, planned/scheduled, unknown. [ENUM-REF-CANDIDATE: weather|equipment_failure|tree_contact|animal_contact|vehicle_accident|planned|unknown|other — promote to reference product]' ;
    rdfs:domain ind:ReliabilityIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maifiCount rdf:type rdf:Property ;
    rdfs:label 'Maifi Count' ;
    rdfs:comment 'Momentary Average Interruption Frequency Index expressed as average number of momentary interruptions (less than 5 minutes) per customer per reporting period. Tracks recloser and auto-sectionalizer operations per IEEE 1366. Reported separately from sustained interruption indices.' ;
    rdfs:domain ind:ReliabilityIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:medEventCount rdf:type rdf:Property ;
    rdfs:label 'Med Event Count' ;
    rdfs:comment 'Number of calendar days during the reporting period that qualified as Major Event Days under the IEEE 1366 beta method threshold. Null when med_exclusion_flag is False. Used in PUC regulatory filings to document the basis for MED exclusions.' ;
    rdfs:domain ind:ReliabilityIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:medExcludedSaidiMinutes rdf:type rdf:Property ;
    rdfs:label 'Med Excluded Saidi Minutes' ;
    rdfs:comment 'SAIDI contribution attributable to Major Event Days that has been excluded from the normalized saidi_minutes value per IEEE 1366 beta method. Null when med_exclusion_flag is False. Enables regulators to reconcile normalized vs. total SAIDI in PUC filings.' ;
    rdfs:domain ind:ReliabilityIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:medExclusionFlag rdf:type rdf:Property ;
    rdfs:label 'Med Exclusion Flag' ;
    rdfs:comment 'Indicates whether one or more Major Event Days (MEDs) as defined by IEEE 1366 beta method have been identified and excluded from the reported SAIDI/SAIFI/CAIDI values for this period. True = MED exclusion applied; False = no MED exclusion. Critical for normalized PUC regulatory reporting.' ;
    rdfs:domain ind:ReliabilityIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overheadCircuitMiles rdf:type rdf:Property ;
    rdfs:label 'Overhead Circuit Miles' ;
    rdfs:comment 'Circuit miles of overhead distribution line within the reporting scope. Subset of circuit_miles. Overhead lines have higher weather-related interruption exposure. Used for overhead vs. underground reliability segmentation in PUC filings.' ;
    rdfs:domain ind:ReliabilityIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorYearSaidiMinutes rdf:type rdf:Property ;
    rdfs:label 'Prior Year Saidi Minutes' ;
    rdfs:comment 'SAIDI value in minutes for the equivalent reporting period in the prior year. Stored on the record to support year-over-year variance analysis in PUC regulatory filings without requiring a self-join. Null for the first year of data.' ;
    rdfs:domain ind:ReliabilityIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorYearSaifiCount rdf:type rdf:Property ;
    rdfs:label 'Prior Year Saifi Count' ;
    rdfs:comment 'SAIFI value for the equivalent reporting period in the prior year. Stored on the record to support year-over-year variance analysis in PUC regulatory filings without requiring a self-join. Null for the first year of data.' ;
    rdfs:domain ind:ReliabilityIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pucDocketNumber rdf:type rdf:Property ;
    rdfs:label 'Puc Docket Number' ;
    rdfs:comment 'Official docket or case number assigned by the state Public Utility Commission to the regulatory filing in which this reliability index record is included. Enables cross-reference to the regulatory.docket product. Null until assigned by the PUC.' ;
    rdfs:domain ind:ReliabilityIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingFrequency rdf:type rdf:Property ;
    rdfs:label 'Reporting Frequency' ;
    rdfs:comment 'Frequency of the regulatory reporting cycle for this index record. \'monthly\' for monthly PUC filings, \'annual\' for annual NERC/PUC submissions, \'quarterly\' for quarterly state commission reports.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingLevel rdf:type rdf:Property ;
    rdfs:label 'Reporting Level' ;
    rdfs:comment 'Discriminator indicating the aggregation level at which reliability indices are computed. \'system\' = utility-wide aggregate; \'substation\' = substation-level rollup; \'feeder\' = individual distribution feeder. Governs nullability of feeder_id and substation_id FK references.' ;
    rdfs:domain ind:ReliabilityIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingPeriodEnd rdf:type rdf:Property ;
    rdfs:label 'Reporting Period End' ;
    rdfs:comment 'Last calendar date of the regulatory reporting period covered by this reliability index record (e.g., 2024-01-31 for January 2024 monthly report or 2024-12-31 for annual 2024 report). Aligns with PUC and NERC reporting cycle boundaries.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingPeriodMonth rdf:type rdf:Property ;
    rdfs:label 'Reporting Period Month' ;
    rdfs:comment 'Calendar month (1–12) of the regulatory reporting period. Null for annual reporting frequency records. Used for monthly PUC reliability filings and intra-year trend analysis.' ;
    rdfs:domain ind:ReliabilityIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reportingPeriodStart rdf:type rdf:Property ;
    rdfs:label 'Reporting Period Start' ;
    rdfs:comment 'First calendar date of the regulatory reporting period covered by this reliability index record (e.g., 2024-01-01 for January 2024 monthly report or 2024-01-01 for annual 2024 report). Aligns with PUC and NERC reporting cycle boundaries.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingPeriodYear rdf:type rdf:Property ;
    rdfs:label 'Reporting Period Year' ;
    rdfs:comment 'Calendar year of the regulatory reporting period (e.g., 2024). Used as a primary filter dimension for annual PUC filings and year-over-year trend analysis.' ;
    rdfs:domain ind:ReliabilityIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:saidiMinutes rdf:type rdf:Property ;
    rdfs:label 'Saidi Minutes' ;
    rdfs:comment 'System Average Interruption Duration Index expressed in minutes per customer. Computed as total customer-minutes interrupted divided by total customers served for the reporting period. Primary reliability metric reported to state PUCs and benchmarked against NERC standards per IEEE 1366.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:saidiWithMedMinutes rdf:type rdf:Property ;
    rdfs:label 'Saidi With Med Minutes' ;
    rdfs:comment 'Total SAIDI value in minutes including all Major Event Day contributions, prior to any MED exclusion. Reported alongside normalized saidi_minutes to provide full transparency in PUC regulatory submissions. Equals saidi_minutes when med_exclusion_flag is False.' ;
    rdfs:domain ind:ReliabilityIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:saifiCount rdf:type rdf:Property ;
    rdfs:label 'Saifi Count' ;
    rdfs:comment 'System Average Interruption Frequency Index expressed as average number of interruptions per customer per reporting period. Computed as total customer interruptions divided by total customers served. Core IEEE 1366 metric for PUC regulatory reporting.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:saifiWithMedCount rdf:type rdf:Property ;
    rdfs:label 'Saifi With Med Count' ;
    rdfs:comment 'Total SAIFI value including all Major Event Day contributions, prior to any MED exclusion. Reported alongside normalized saifi_count for full PUC regulatory transparency. Equals saifi_count when med_exclusion_flag is False.' ;
    rdfs:domain ind:ReliabilityIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalCustomerInterruptions rdf:type rdf:Property ;
    rdfs:label 'Total Customer Interruptions' ;
    rdfs:comment 'Total count of customer interruptions (sustained, greater than or equal to 5 minutes) during the reporting period at the applicable reporting level. Numerator component used in SAIFI calculation. Aggregated from OMS/DMS outage event records.' ;
    rdfs:domain ind:ReliabilityIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalCustomerMinutesInterrupted rdf:type rdf:Property ;
    rdfs:label 'Total Customer Minutes Interrupted' ;
    rdfs:comment 'Sum of all customer-minutes interrupted during the reporting period at the applicable reporting level. Numerator component used in SAIDI calculation. Expressed in customer-minutes. Source data aggregated from OMS/DMS outage event records.' ;
    rdfs:domain ind:ReliabilityIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalCustomersServed rdf:type rdf:Property ;
    rdfs:label 'Total Customers Served' ;
    rdfs:comment 'Total number of customers served within the reporting scope (system, substation, or feeder) during the reporting period. Denominator component used in SAIDI and SAIFI calculations. Sourced from CIS/Oracle CC&B or SAP IS-U active service point counts.' ;
    rdfs:domain ind:ReliabilityIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:undergroundCircuitMiles rdf:type rdf:Property ;
    rdfs:label 'Underground Circuit Miles' ;
    rdfs:comment 'Circuit miles of underground distribution cable within the reporting scope. Subset of circuit_miles. Underground infrastructure typically exhibits lower frequency but longer duration interruptions. Used for overhead vs. underground reliability segmentation.' ;
    rdfs:domain ind:ReliabilityIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:serviceEquipmentMaterialMasterId rdf:type rdf:Property ;
    rdfs:label 'Service Equipment Material Master Id' ;
    rdfs:comment 'Foreign key linking to supply.material_master. Business justification: Service points have standardized service equipment (meter sockets, service entrance cables, disconnects) tracked as materials. Enables new service installation cost estimation, AMI deployment material' ;
    rdfs:domain ind:ServicePoint ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MaterialMaster .

ind:amiEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Ami Enabled Flag' ;
    rdfs:comment 'Indicates whether this service point is equipped with an Advanced Metering Infrastructure (AMI) smart meter capable of two-way communication and interval data collection. Distinguishes AMI from legacy AMR or manual-read meters.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:connectDate rdf:type rdf:Property ;
    rdfs:label 'Connect Date' ;
    rdfs:comment 'Date on which utility service was first connected and activated at this service point. Used for service tenure analysis, asset age tracking, and move-in/move-out processing.' ;
    rdfs:domain ind:ServicePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:derCapacityKw rdf:type rdf:Property ;
    rdfs:label 'Der Capacity Kw' ;
    rdfs:comment 'Nameplate installed capacity in kilowatts (kW) of the Distributed Energy Resource (DER) interconnected at this service point. Populated only when der_interconnect_flag is true. Used for hosting capacity analysis and DERMS dispatch.' ;
    rdfs:domain ind:ServicePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:derInterconnectFlag rdf:type rdf:Property ;
    rdfs:label 'Der Interconnect Flag' ;
    rdfs:comment 'Indicates whether a Distributed Energy Resource (DER) — such as rooftop solar PV, battery storage, or small wind — is interconnected at this service point. Used by DERMS for grid visibility, voltage regulation, and DER dispatch coordination.' ;
    rdfs:domain ind:ServicePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disconnectDate rdf:type rdf:Property ;
    rdfs:label 'Disconnect Date' ;
    rdfs:comment 'Date on which utility service was permanently disconnected at this service point. Null for active service points. Used for move-out processing, final billing, and service point lifecycle management.' ;
    rdfs:domain ind:ServicePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:evChargerFlag rdf:type rdf:Property ;
    rdfs:label 'Ev Charger Flag' ;
    rdfs:comment 'Indicates whether an Electric Vehicle (EV) charging station is installed at this service point. Used for load forecasting, grid impact analysis, and EV-specific rate program eligibility (e.g., TOU-EV rates).' ;
    rdfs:domain ind:ServicePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gasMeterSetCode rdf:type rdf:Property ;
    rdfs:label 'Gas Meter Set Code' ;
    rdfs:comment 'Identifier for the gas meter set assembly (regulator, meter, and associated fittings) at this service point. Used for gas asset management, safety inspection scheduling, and PHMSA compliance tracking.' ;
    rdfs:domain ind:ServicePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gasPressureClass rdf:type rdf:Property ;
    rdfs:label 'Gas Pressure Class' ;
    rdfs:comment 'Operating pressure classification of the gas service lateral at this service point (low, medium, or high pressure). Applicable only for gas or dual-service service points. Required for PHMSA pipeline safety management and gas distribution system design.' ;
    rdfs:domain ind:ServicePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gisLastUpdatedDate rdf:type rdf:Property ;
    rdfs:label 'Gis Last Updated Date' ;
    rdfs:comment 'Date on which the GIS spatial record for this service point was last updated in ESRI ArcGIS. Used for GIS data quality monitoring and network model synchronization with OMS/DMS.' ;
    rdfs:domain ind:ServicePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:gisParcelCode rdf:type rdf:Property ;
    rdfs:label 'Gis Parcel Code' ;
    rdfs:comment 'County assessor parcel identification number (APN) or GIS parcel reference linking the service point to the land parcel record in the ESRI ArcGIS system. Used for property-level spatial analysis and CIAC/AFUDC cost allocation.' ;
    rdfs:domain ind:ServicePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loadClassCode rdf:type rdf:Property ;
    rdfs:label 'Load Class Code' ;
    rdfs:comment 'Utility-defined load classification code assigned to the service point for rate design, load forecasting, and demand-side management program targeting (e.g., RES-1, COM-2, IND-3). Sourced from Oracle CC&B / SAP IS-U rate class assignment.' ;
    rdfs:domain ind:ServicePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meterReadCycle rdf:type rdf:Property ;
    rdfs:label 'Meter Read Cycle' ;
    rdfs:comment 'Billing cycle code or route identifier that determines the scheduled meter reading frequency and sequence for this service point (e.g., monthly cycle 01, bi-monthly cycle 02). Used for meter reading route optimization and billing cycle management.' ;
    rdfs:domain ind:ServicePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meterSocketCode rdf:type rdf:Property ;
    rdfs:label 'Meter Socket Code' ;
    rdfs:comment 'Physical identifier of the meter socket or meter base at the service point. Distinguishes the physical installation point from the meter device itself, enabling meter change-out tracking without losing service point continuity.' ;
    rdfs:domain ind:ServicePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nemEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Nem Eligible Flag' ;
    rdfs:comment 'Indicates whether this service point is eligible for Net Energy Metering (NEM) — the billing arrangement allowing customers with on-site generation (e.g., rooftop solar) to receive credit for excess energy exported to the grid. Drives NEM tariff application and bidirectional metering requirements.' ;
    rdfs:domain ind:ServicePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:serviceAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Service Address Line1' ;
    rdfs:comment 'Primary street address line of the physical service delivery location. Used for field crew dispatch, GIS geocoding, and customer correspondence. Satisfies MASTER_RESOURCE IDENTITY_LABEL category.' ;
    rdfs:domain ind:ServicePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Service Address Line2' ;
    rdfs:comment 'Secondary address line for the service delivery location (e.g., apartment, suite, unit number). Supplements the primary address for multi-unit premises.' ;
    rdfs:domain ind:ServicePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceLateralLengthFt rdf:type rdf:Property ;
    rdfs:label 'Service Lateral Length Ft' ;
    rdfs:comment 'Length in feet of the service lateral — the conductor or pipe segment connecting the distribution main or transformer to the customer\'s meter. Used for CIAC cost estimation, line loss calculations, and asset inventory.' ;
    rdfs:domain ind:ServicePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:serviceLateralMaterial rdf:type rdf:Property ;
    rdfs:label 'Service Lateral Material' ;
    rdfs:comment 'Material type of the service lateral conductor (electric) or pipe (gas). Used for asset condition assessment, replacement prioritization, and PHMSA gas pipeline safety reporting. [ENUM-REF-CANDIDATE: overhead_aluminum|overhead_copper|underground_xlpe|underground_pvc|steel_pipe|polyethylene_pipe|other — promote to reference product]' ;
    rdfs:domain ind:ServicePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:servicePointStatus rdf:type rdf:Property ;
    rdfs:label 'Service Point Status' ;
    rdfs:comment 'Current lifecycle status of the service point indicating whether utility service is being actively delivered. Drives field work orders, billing eligibility, and OMS outage event correlation. Satisfies MASTER_RESOURCE LIFECYCLE_STATUS category. [ENUM-REF-CANDIDATE: active|inactive|pending_connect|pending_disconnect|disconnected|abandoned — promote to reference product]' ;
    rdfs:domain ind:ServicePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceVoltageV rdf:type rdf:Property ;
    rdfs:label 'Service Voltage V' ;
    rdfs:comment 'Nominal utilization voltage delivered at the service point in volts (e.g., 120, 240, 480). Used for voltage regulation analysis, equipment compatibility verification, and DMS load flow studies. Satisfies MASTER_RESOURCE MEASUREMENT_OR_VALUE category.' ;
    rdfs:domain ind:ServicePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:spExternalCode rdf:type rdf:Property ;
    rdfs:label 'Sp External Code' ;
    rdfs:comment 'Externally-known alphanumeric identifier for the service point as assigned by the source system of record (Oracle CC&B or SAP IS-U / ESRI ArcGIS). Used for cross-system reconciliation between the CIS, GIS, and MDMS. Satisfies MASTER_RESOURCE BUSINESS_IDENTIFIER category.' ;
    rdfs:domain ind:ServicePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetConditionScore rdf:type rdf:Property ;
    rdfs:label 'Asset Condition Score' ;
    rdfs:comment 'Composite health index (0-100 scale) derived from inspection findings, age, load history, and failure risk models. Guides capital investment prioritization and replacement planning.' ;
    rdfs:domain ind:ServiceTransformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:connectedCustomerCount rdf:type rdf:Property ;
    rdfs:label 'Connected Customer Count' ;
    rdfs:comment 'Number of customer service points (meters) served by this transformer. Used for outage impact assessment and SAIDI/SAIFI/CAIDI reliability calculations.' ;
    rdfs:domain ind:ServiceTransformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:coolingType rdf:type rdf:Property ;
    rdfs:label 'Cooling Type' ;
    rdfs:comment 'Insulation and cooling medium classification. Oil-immersed transformers require spill containment and environmental monitoring; dry-type are used indoors or where fire safety is critical.' ;
    rdfs:domain ind:ServiceTransformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:derInterconnectionFlag rdf:type rdf:Property ;
    rdfs:label 'Der Interconnection Flag' ;
    rdfs:comment 'Indicates whether one or more Distributed Energy Resources (solar PV, battery storage, EV chargers) are interconnected to this transformer under Net Energy Metering (NEM) or other programs. Critical for DERMS integration and voltage management.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:impedancePercent rdf:type rdf:Property ;
    rdfs:label 'Impedance Percent' ;
    rdfs:comment 'Nameplate impedance of the transformer expressed as a percentage. Critical for short-circuit analysis, protective device coordination, and voltage regulation studies.' ;
    rdfs:domain ind:ServiceTransformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:kvaRating rdf:type rdf:Property ;
    rdfs:label 'Kva Rating' ;
    rdfs:comment 'Nameplate capacity of the service transformer in kilovolt-amperes. Principal measurement for load balancing, capacity planning, and determining service adequacy for connected customers.' ;
    rdfs:domain ind:ServiceTransformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:loadFactorPercent rdf:type rdf:Property ;
    rdfs:label 'Load Factor Percent' ;
    rdfs:comment 'Ratio of average load to peak load over a measurement period, expressed as a percentage. Indicates utilization efficiency and guides capacity planning.' ;
    rdfs:domain ind:ServiceTransformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:manufactureYear rdf:type rdf:Property ;
    rdfs:label 'Manufacture Year' ;
    rdfs:comment 'Year the transformer was manufactured. Used for age-based risk assessment, depreciation calculations, and replacement prioritization.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:peakLoadKva rdf:type rdf:Property ;
    rdfs:label 'Peak Load Kva' ;
    rdfs:comment 'Maximum observed load on the transformer in kilovolt-amperes. Used to assess overload risk and determine upgrade or replacement needs.' ;
    rdfs:domain ind:ServiceTransformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:primaryVoltage rdf:type rdf:Property ;
    rdfs:label 'Primary Voltage' ;
    rdfs:comment 'Medium-voltage input from the distribution feeder in kilovolts. Typical values include 4.16kV, 12.47kV, 13.2kV, 13.8kV, 24.9kV, 34.5kV depending on utility standards.' ;
    rdfs:domain ind:ServiceTransformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scadaMonitoredFlag rdf:type rdf:Property ;
    rdfs:label 'Scada Monitored Flag' ;
    rdfs:comment 'Indicates whether the transformer is equipped with real-time monitoring via SCADA or Advanced Distribution Management System (ADMS). Enables proactive outage detection and load management.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:secondaryVoltage rdf:type rdf:Property ;
    rdfs:label 'Secondary Voltage' ;
    rdfs:comment 'Utilization voltage output to end-use customers in volts. Typical residential values: 120/240V single-phase; typical commercial values: 208Y/120V or 480Y/277V three-phase.' ;
    rdfs:domain ind:ServiceTransformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stateProvince rdf:type rdf:Property ;
    rdfs:label 'State Province' ;
    rdfs:comment 'State or province where the transformer is located. Used for regulatory reporting to state Public Utility Commissions (PUCs).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tapPosition rdf:type rdf:Property ;
    rdfs:label 'Tap Position' ;
    rdfs:comment 'Current tap setting for voltage regulation (e.g., +2.5%, nominal, -5%). Adjusts secondary voltage to maintain service quality within ANSI C84.1 limits.' ;
    rdfs:domain ind:ServiceTransformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transformerNumber rdf:type rdf:Property ;
    rdfs:label 'Transformer Number' ;
    rdfs:comment 'Externally-known business identifier for the service transformer, used in field operations, work orders, and GIS mapping. Unique across the utility\'s distribution network.' ;
    rdfs:domain ind:ServiceTransformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transformerType rdf:type rdf:Property ;
    rdfs:label 'Transformer Type' ;
    rdfs:comment 'Physical installation configuration of the service transformer. Determines accessibility, maintenance procedures, and safety protocols.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:windingConfiguration rdf:type rdf:Property ;
    rdfs:label 'Winding Configuration' ;
    rdfs:comment 'Primary and secondary winding connection topology. Affects voltage transformation, grounding, and harmonic performance.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:switchingOperationId rdf:type rdf:Property ;
    rdfs:label 'Switching Operation Id' ;
    rdfs:comment 'Unique identifier for the distribution switching operation record. Primary key for the switching operation transaction.' ;
    rdfs:domain ind:SwitchingOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:authorizedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Authorized Timestamp' ;
    rdfs:comment 'Date and time when the switching order was authorized by the control center or authorized supervisor. Establishes the official approval to proceed with the switching operation.' ;
    rdfs:domain ind:SwitchingOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:authorizingSupervisorEmployeeNumber rdf:type rdf:Property ;
    rdfs:label 'Authorizing Supervisor Employee Number' ;
    rdfs:comment 'Identifier of the control center operator or field supervisor who authorized the switching order. Establishes accountability for the switching decision.' ;
    rdfs:domain ind:SwitchingOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:completedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Completed Timestamp' ;
    rdfs:comment 'Date and time when the switching operation was marked as completed and all post-switching verification steps were finalized. May differ from operation_timestamp if verification and documentation steps follow the physical switching action.' ;
    rdfs:domain ind:SwitchingOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:deviceIdentifier rdf:type rdf:Property ;
    rdfs:label 'Device Identifier' ;
    rdfs:comment 'Unique identifier or asset tag of the specific distribution device that was operated. Links to the asset management system (EAM) and Geographic Information System (GIS) for device location, specifications, and maintenance history.' ;
    rdfs:domain ind:SwitchingOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deviceOperated rdf:type rdf:Property ;
    rdfs:label 'Device Operated' ;
    rdfs:comment 'Type of distribution network device that was operated during this switching action. Switches and disconnects provide isolation; reclosers provide automatic fault interruption and restoration; sectionalizers coordinate with reclosers; breakers provide overcurrent protection; fuses provide single-operation protection. [ENUM-REF-CANDIDATE: switch|recloser|sectionalizer|breaker|fuse|disconnect|load_break_switch — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:SwitchingOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dmsSystemSource rdf:type rdf:Property ;
    rdfs:label 'Dms System Source' ;
    rdfs:comment 'Name or identifier of the Distribution Management System (DMS) or Outage Management System (OMS) that originated the switching operation record. Examples include Schneider Electric AMS, GE PowerOn, ABB Network Manager. Used for data lineage and system integration tracking.' ;
    rdfs:domain ind:SwitchingOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gisLocationReference rdf:type rdf:Property ;
    rdfs:label 'Gis Location Reference' ;
    rdfs:comment 'Geographic Information System (GIS) feature identifier or coordinate reference for the physical location of the device operated. Links to ESRI ArcGIS or equivalent GIS platform for spatial analysis, mapping, and network topology visualization.' ;
    rdfs:domain ind:SwitchingOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interruptionDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Interruption Duration Minutes' ;
    rdfs:comment 'Duration in minutes that customers experienced service interruption as a result of the switching operation. Used for SAIDI (System Average Interruption Duration Index) calculations and regulatory reporting. Zero for switching operations that did not interrupt service.' ;
    rdfs:domain ind:SwitchingOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:loadTransferredKw rdf:type rdf:Property ;
    rdfs:label 'Load Transferred Kw' ;
    rdfs:comment 'Amount of electrical load in kilowatts (kW) transferred from one feeder or circuit segment to another as a result of the switching operation. Used for load balancing analysis and circuit capacity management. Null if the operation did not involve load transfer.' ;
    rdfs:domain ind:SwitchingOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:operationStatus rdf:type rdf:Property ;
    rdfs:label 'Operation Status' ;
    rdfs:comment 'Current lifecycle status of the switching operation. Tracks progression from authorization through execution to completion or cancellation. Failed status indicates unsuccessful execution; rolled back indicates reversal to prior configuration. [ENUM-REF-CANDIDATE: pending|authorized|in_progress|completed|cancelled|failed|rolled_back — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:SwitchingOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Operation Timestamp' ;
    rdfs:comment 'Date and time when the switching operation was physically executed in the field. Represents the actual moment the device state changed. Distinct from authorization or completion timestamps. Critical for outage duration calculations and SAIDI/SAIFI/CAIDI reliability index computation.' ;
    rdfs:domain ind:SwitchingOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:operationType rdf:type rdf:Property ;
    rdfs:label 'Operation Type' ;
    rdfs:comment 'Classification of the switching operation based on its purpose and planning status. Planned operations are scheduled in advance; emergency operations respond to unplanned events; restoration operations return circuits to normal configuration; maintenance operations support asset work; reconfiguration operations optimize load distribution; fault isolation operations isolate faulted sections.' ;
    rdfs:domain ind:SwitchingOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operatorEmployeeNumber rdf:type rdf:Property ;
    rdfs:label 'Operator Employee Number' ;
    rdfs:comment 'Identifier of the field technician or operator who physically executed the switching operation. Links to workforce management system for operator qualifications, certifications, and training records. Critical for OSHA lockout/tagout compliance and safety audit trails.' ;
    rdfs:domain ind:SwitchingOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:postSwitchConfiguration rdf:type rdf:Property ;
    rdfs:label 'Post Switch Configuration' ;
    rdfs:comment 'State of the device after the switching operation was completed. Represents the new configuration achieved by the switching action.' ;
    rdfs:domain ind:SwitchingOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preSwitchConfiguration rdf:type rdf:Property ;
    rdfs:label 'Pre Switch Configuration' ;
    rdfs:comment 'State of the device immediately before the switching operation was executed. Open indicates no current flow; closed indicates energized and conducting; grounded indicates connected to ground; isolated indicates disconnected from all sources.' ;
    rdfs:domain ind:SwitchingOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rollbackFlag rdf:type rdf:Property ;
    rdfs:label 'Rollback Flag' ;
    rdfs:comment 'Indicates whether the switching operation was subsequently reversed or rolled back to the original configuration due to operational issues, equipment problems, or changed conditions. True if the operation was rolled back; False if the new configuration was maintained.' ;
    rdfs:domain ind:SwitchingOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rollbackReason rdf:type rdf:Property ;
    rdfs:label 'Rollback Reason' ;
    rdfs:comment 'Free-text explanation of why the switching operation was rolled back to the original configuration. Null if rollback_flag is False.' ;
    rdfs:domain ind:SwitchingOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:safetyClearanceNumber rdf:type rdf:Property ;
    rdfs:label 'Safety Clearance Number' ;
    rdfs:comment 'Reference number for the safety clearance or work permit authorizing personnel to work on or near the device. Links to the safety management system for clearance scope, authorized personnel, and expiration. Required for all switching operations involving worker access to energized or de-energized equipment.' ;
    rdfs:domain ind:SwitchingOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scadaCommandIssuedFlag rdf:type rdf:Property ;
    rdfs:label 'Scada Command Issued Flag' ;
    rdfs:comment 'Indicates whether the switching operation was executed via remote SCADA command from the control center (True) or manually in the field (False). Remote SCADA operations enable faster response and reduce field crew dispatch requirements.' ;
    rdfs:domain ind:SwitchingOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scadaVerificationFlag rdf:type rdf:Property ;
    rdfs:label 'Scada Verification Flag' ;
    rdfs:comment 'Indicates whether the post-switching device state was verified via SCADA telemetry (True) or required manual field verification (False). SCADA verification provides real-time confirmation of device state.' ;
    rdfs:domain ind:SwitchingOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scheduledTimestamp rdf:type rdf:Property ;
    rdfs:label 'Scheduled Timestamp' ;
    rdfs:comment 'Planned date and time for the switching operation to be executed. Applicable to planned and maintenance operations. Null for emergency and unplanned operations.' ;
    rdfs:domain ind:SwitchingOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:switchingOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Switching Order Number' ;
    rdfs:comment 'Externally-known switching order number issued by the Distribution Management System (DMS) or Outage Management System (OMS) authorizing the switching operation. Serves as the business identifier for tracking and audit purposes.' ;
    rdfs:domain ind:SwitchingOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:switchingReasonCode rdf:type rdf:Property ;
    rdfs:label 'Switching Reason Code' ;
    rdfs:comment 'Categorized reason for the switching operation. Fault isolation responds to detected faults; load transfer balances circuit loading; voltage regulation addresses voltage issues; maintenance support enables asset work; storm restoration recovers from weather events; planned outage supports scheduled work; equipment failure responds to device malfunction; customer request fulfills service requests. [ENUM-REF-CANDIDATE: fault_isolation|load_transfer|voltage_regulation|maintenance_support|storm_restoration|planned_outage|equipment_failure|customer_request — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:SwitchingOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:switchingReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Switching Reason Description' ;
    rdfs:comment 'Free-text narrative describing the specific business or operational reason for the switching operation. Provides context beyond the categorized reason code, including details of the fault, maintenance activity, or operational need.' ;
    rdfs:domain ind:SwitchingOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tagLockoutStatus rdf:type rdf:Property ;
    rdfs:label 'Tag Lockout Status' ;
    rdfs:comment 'OSHA lockout/tagout (LOTO) status of the device during the switching operation. Tagged indicates warning tag applied; locked out indicates physical lock preventing operation; tagged and locked indicates both controls applied; cleared indicates LOTO removed and device returned to service. Critical for worker safety compliance.' ;
    rdfs:domain ind:SwitchingOperation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:voltageRegulationDeviceId rdf:type rdf:Property ;
    rdfs:label 'Voltage Regulation Device Id' ;
    rdfs:comment 'Unique surrogate identifier for a voltage regulation device record in the distribution domain. Serves as the primary key for this master resource entity.' ;
    rdfs:domain ind:VoltageRegulationDevice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bandwidthV rdf:type rdf:Property ;
    rdfs:label 'Bandwidth V' ;
    rdfs:comment 'Voltage bandwidth or deadband setting in volts (V) around the voltage setpoint within which the regulator will not initiate a tap change. A wider bandwidth reduces tap operation count and extends equipment life; a narrower bandwidth improves voltage precision. Expressed on the 120-V base for voltage regulators. Critical parameter for tap wear analysis and CVR program tuning.' ;
    rdfs:domain ind:VoltageRegulationDevice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:circuitMileMarker rdf:type rdf:Property ;
    rdfs:label 'Circuit Mile Marker' ;
    rdfs:comment 'Distance in miles from the substation bus to the point on the feeder where this device is installed, measured along the circuit centerline. Used for voltage drop calculations, protection coordination, and feeder sectionalizing analysis. Aligns with GIS linear referencing.' ;
    rdfs:domain ind:VoltageRegulationDevice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:communicationProtocol rdf:type rdf:Property ;
    rdfs:label 'Communication Protocol' ;
    rdfs:comment 'Communication protocol used by the device controller to interface with the SCADA/DMS system for telemetry and remote control. \'dnp3\' — DNP3 (Distributed Network Protocol 3), most common for distribution automation; \'iec61850\' — IEC 61850 substation automation standard; \'modbus\' — legacy Modbus RTU/TCP; \'iccp\' — Inter-Control Center Communications Protocol; \'none\' — no remote communication (manual-only device).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:controlMode rdf:type rdf:Property ;
    rdfs:label 'Control Mode' ;
    rdfs:comment 'Operating control mode of the voltage regulation device. \'automatic\' — device self-regulates based on local voltage sensing and programmed setpoints; \'manual\' — field crew or operator manually positions taps or switches; \'scada\' — remote control via SCADA system (OSIsoft PI / GE Proficy or Schneider AMS/GE PowerOn DMS); \'volt_var_optimization\' — device is under centralized VOLT/VAR optimization (VVO) / DERMS control; \'disabled\' — control logic is inactive.' ;
    rdfs:domain ind:VoltageRegulationDevice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cumulativeTapOperations rdf:type rdf:Property ;
    rdfs:label 'Cumulative Tap Operations' ;
    rdfs:comment 'Total number of tap change operations recorded on the voltage regulator since installation or last counter reset. A key maintenance trigger metric — most voltage regulators are rated for a finite number of tap operations (e.g., 500,000) before contact replacement is required. Sourced from SCADA historian or field inspection. Used in predictive maintenance scheduling in Oracle WAM / IBM Maximo.' ;
    rdfs:domain ind:VoltageRegulationDevice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cvrEnrolled rdf:type rdf:Property ;
    rdfs:label 'Cvr Enrolled' ;
    rdfs:comment 'Indicates whether this device participates in the utility\'s Conservation Voltage Reduction (CVR) program, which intentionally lowers distribution voltage within ANSI C84.1 Range A limits to reduce customer energy consumption and peak demand. CVR-enrolled devices have their voltage setpoints managed to the lower end of the acceptable voltage range during CVR events.' ;
    rdfs:domain ind:VoltageRegulationDevice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:derHostingZone rdf:type rdf:Property ;
    rdfs:label 'Der Hosting Zone' ;
    rdfs:comment 'Indicates whether this voltage regulation device is located on a feeder segment with high penetration of distributed energy resources (DER) such as rooftop solar (NEM interconnections). When True, the device plays a critical role in managing reverse power flow and voltage rise caused by DER generation, and is subject to enhanced monitoring and DERMS coordination.' ;
    rdfs:domain ind:VoltageRegulationDevice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deviceCode rdf:type rdf:Property ;
    rdfs:label 'Device Code' ;
    rdfs:comment 'Externally-known alphanumeric asset tag or utility-assigned device code used to identify this voltage regulation device across operational systems (Oracle WAM/Maximo, GIS, SCADA). Serves as the business-facing identifier referenced in field work orders, GIS records, and SCADA point configurations.' ;
    rdfs:domain ind:VoltageRegulationDevice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deviceName rdf:type rdf:Property ;
    rdfs:label 'Device Name' ;
    rdfs:comment 'Human-readable descriptive name or label assigned to the voltage regulation device, typically incorporating feeder name, circuit mile marker, or substation bay designation (e.g., \'Feeder 12 Reg Bank 1 at Mile 3.2\'). Used in OMS/DMS displays and field crew communications.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deviceSubtype rdf:type rdf:Property ;
    rdfs:label 'Device Subtype' ;
    rdfs:comment 'Further classification of the device configuration. Indicates whether the device is single-phase or three-phase, and for capacitor banks whether it is gang-operated (all phases switched together) or individually switched per phase. Drives field maintenance procedures and SCADA control logic.' ;
    rdfs:domain ind:VoltageRegulationDevice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deviceType rdf:type rdf:Property ;
    rdfs:label 'Device Type' ;
    rdfs:comment 'Classification of the voltage regulation device by its primary function on the distribution feeder. \'voltage_regulator\' — step-voltage regulator that adjusts tap position to maintain voltage; \'capacitor_bank\' — switched or fixed capacitor bank providing reactive power (kVAR) compensation; \'line_reactor\' — series or shunt reactor used to absorb excess reactive power or limit fault current.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fercAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Ferc Account Number' ;
    rdfs:comment 'Federal Energy Regulatory Commission (FERC) Uniform System of Accounts (USofA) account number under which this voltage regulation device is capitalized for regulatory rate base reporting. Distribution voltage regulation equipment is typically classified under FERC Account 362 (Station Equipment) or 364 (Poles, Towers, and Fixtures) depending on mounting configuration. Required for FERC Form 1 and state PUC rate case filings.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gisObjectCode rdf:type rdf:Property ;
    rdfs:label 'Gis Object Code' ;
    rdfs:comment 'Unique object identifier assigned to this device in the ESRI ArcGIS geospatial information system, used for network topology linkage, spatial analysis, and field crew navigation. Enables cross-system reconciliation between the asset management system (Oracle WAM/Maximo) and the GIS network model.' ;
    rdfs:domain ind:VoltageRegulationDevice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastTapPosition rdf:type rdf:Property ;
    rdfs:label 'Last Tap Position' ;
    rdfs:comment 'Most recently recorded tap position of the step-voltage regulator, as reported by the SCADA system (OSIsoft PI / GE Proficy) or field inspection. Negative values indicate buck (voltage reduction) positions; positive values indicate boost (voltage raise) positions; zero is neutral. Used for voltage profile analysis, CVR performance monitoring, and detecting stuck-tap conditions.' ;
    rdfs:domain ind:VoltageRegulationDevice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastTapPositionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Tap Position Timestamp' ;
    rdfs:comment 'Date and time (ISO 8601 with timezone offset) when the last_tap_position reading was recorded or updated from SCADA or field inspection. Used to assess data freshness and detect communication failures with the device controller.' ;
    rdfs:domain ind:VoltageRegulationDevice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:maximoAssetCode rdf:type rdf:Property ;
    rdfs:label 'Maximo Asset Code' ;
    rdfs:comment 'Asset record identifier assigned in the Enterprise Asset Management system (Oracle WAM or IBM Maximo). Used to cross-reference this voltage regulation device master record with work orders, preventive maintenance plans, failure history, and cost tracking in the EAM system. Serves as the integration key between the distribution data product and the asset management system of record.' ;
    rdfs:domain ind:VoltageRegulationDevice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mountingType rdf:type rdf:Property ;
    rdfs:label 'Mounting Type' ;
    rdfs:comment 'Physical installation configuration of the voltage regulation device on the distribution system. Determines maintenance access requirements, environmental exposure ratings, and applicable construction standards. \'pole_mounted\' — overhead distribution pole; \'pad_mounted\' — ground-level pad enclosure; \'substation_installed\' — within a distribution substation; \'underground_vault\' — below-grade vault installation.' ;
    rdfs:domain ind:VoltageRegulationDevice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nercCipApplicable rdf:type rdf:Property ;
    rdfs:label 'Nerc Cip Applicable' ;
    rdfs:comment 'Indicates whether this voltage regulation device is classified as a cyber asset subject to NERC CIP (Critical Infrastructure Protection) standards due to its role in the Bulk Electric System (BES) or its connectivity to BES cyber systems. When True, the device and its communication infrastructure must comply with NERC CIP-002 through CIP-013 requirements.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nextMaintenanceDate rdf:type rdf:Property ;
    rdfs:label 'Next Maintenance Date' ;
    rdfs:comment 'Planned date for the next scheduled preventive maintenance activity on this voltage regulation device, as generated by the Oracle WAM / IBM Maximo preventive maintenance (PM) scheduling engine. Used for workforce planning, material staging, and outage coordination with the OMS/DMS.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ratedKva rdf:type rdf:Property ;
    rdfs:label 'Rated Kva' ;
    rdfs:comment 'Nameplate kVA rating of the voltage regulator or line reactor, representing the maximum apparent power the device is designed to handle continuously. Applicable primarily to voltage regulators and line reactors. Null for capacitor banks where rated_kvar is the principal rating. Used in loading analysis and equipment sizing studies.' ;
    rdfs:domain ind:VoltageRegulationDevice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ratedKvar rdf:type rdf:Property ;
    rdfs:label 'Rated Kvar' ;
    rdfs:comment 'Nameplate reactive power rating in kVAR for capacitor banks and reactors. Represents the reactive compensation capacity the device provides or absorbs at rated voltage. Used in VOLT/VAR optimization (VVO), power factor correction studies, and DER integration planning on feeders with high rooftop solar penetration.' ;
    rdfs:domain ind:VoltageRegulationDevice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ratedVoltageKv rdf:type rdf:Property ;
    rdfs:label 'Rated Voltage Kv' ;
    rdfs:comment 'Nameplate system voltage rating of the device in kilovolts (kV), corresponding to the distribution circuit voltage class (e.g., 4.16 kV, 12.47 kV, 25 kV, 34.5 kV). Used to verify compatibility with the host feeder voltage class and for protection relay coordination.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tapRangeMax rdf:type rdf:Property ;
    rdfs:label 'Tap Range Max' ;
    rdfs:comment 'Maximum allowable tap position for a step-voltage regulator, representing the maximum voltage boost limit in the raise direction. Typically expressed as a positive integer (e.g., +16 for a ±10% regulator with 32 steps). Used in tap position monitoring and equipment limit enforcement.' ;
    rdfs:domain ind:VoltageRegulationDevice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tapRangeMin rdf:type rdf:Property ;
    rdfs:label 'Tap Range Min' ;
    rdfs:comment 'Minimum allowable tap position for a step-voltage regulator, representing the maximum voltage boost or buck limit in the lower direction. Typically expressed as a negative integer (e.g., -16 for a ±10% regulator with 32 steps). Used in tap position monitoring and equipment limit enforcement.' ;
    rdfs:domain ind:VoltageRegulationDevice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:timeDelaySeconds rdf:type rdf:Property ;
    rdfs:label 'Time Delay Seconds' ;
    rdfs:comment 'Intentional time delay in seconds programmed into the voltage regulator or capacitor bank controller before initiating a tap change or switching operation after a voltage deviation is detected. Prevents unnecessary operations due to transient voltage fluctuations (e.g., motor starts, DER intermittency). Coordinated with upstream and downstream devices to avoid hunting.' ;
    rdfs:domain ind:VoltageRegulationDevice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:voltageSetpointV rdf:type rdf:Property ;
    rdfs:label 'Voltage Setpoint V' ;
    rdfs:comment 'Target regulated voltage in volts (V) that the device controller attempts to maintain at the regulation point. For voltage regulators, this is the output voltage setpoint on the 120-V base. Compared against ANSI C84.1 Range A service voltage limits (114–126 V on 120-V base) for compliance monitoring and conservation voltage reduction (CVR) programs.' ;
    rdfs:domain ind:VoltageRegulationDevice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vvoEnrolled rdf:type rdf:Property ;
    rdfs:label 'Vvo Enrolled' ;
    rdfs:comment 'Indicates whether this voltage regulation device is enrolled in and actively controlled by the utility\'s VOLT/VAR optimization (VVO) program, typically managed through the DERMS or DMS platform. When True, the device setpoints and switching schedules may be dynamically adjusted by the VVO algorithm to minimize losses, support CVR, and manage DER-induced voltage fluctuations.' ;
    rdfs:domain ind:VoltageRegulationDevice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:budgetId rdf:type rdf:Property ;
    rdfs:label 'Budget Id' ;
    rdfs:comment 'Unique surrogate identifier for each budget record in the Silver Layer lakehouse. Each record represents a unique combination of budget version, budget type, cost center, GL account, and fiscal year. Sourced from SAP S/4HANA CO-PA or Oracle ERP Cloud Budgetary Control module.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:financialPeriodId rdf:type rdf:Property ;
    rdfs:label 'Financial Period Id' ;
    rdfs:comment 'Foreign key linking to finance.financial_period. Business justification: budget has fiscal_year and fiscal_period attributes. financial_period is the master for fiscal periods. Normalizing this reference allows joining to get full period metadata (period dates, status, etc' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinancialPeriod .

ind:allocationFactor rdf:type rdf:Property ;
    rdfs:label 'Allocation Factor' ;
    rdfs:comment 'The proportional allocation factor (0.000000 to 1.000000) used to distribute shared or common costs across jurisdictions, functional areas, or cost centers in rate case cost-of-service studies. Derived from FERC-approved or PUC-approved allocation methodologies (e.g., plant ratio, revenue ratio, customer count).' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approvalStatus rdf:type rdf:Property ;
    rdfs:label 'Approval Status' ;
    rdfs:comment 'Current workflow status of the budget record in the approval lifecycle. \'draft\' indicates budget under preparation; \'pending_approval\' indicates submitted for management or board review; \'approved\' indicates authorized for execution; \'rejected\' indicates returned for revision; \'superseded\' indicates replaced by a revised version.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvedAmount rdf:type rdf:Property ;
    rdfs:label 'Approved Amount' ;
    rdfs:comment 'The total board- or management-approved budget amount in USD for this cost center, GL account, and fiscal year combination. Represents the authorized spending or revenue target. Used as the baseline for budget-vs-actual variance analysis and rate case test year cost-of-service calculations.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assetCategory rdf:type rdf:Property ;
    rdfs:label 'Asset Category' ;
    rdfs:comment 'The utility asset category for CAPEX budget records (e.g., Generation Plant, Transmission Lines, Distribution Substation, Gas Pipeline, Smart Meter/AMI, IT Infrastructure). Aligns with FERC plant account classifications for regulatory depreciation and rate base inclusion. Null for OPEX budget records.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetType rdf:type rdf:Property ;
    rdfs:label 'Budget Type' ;
    rdfs:comment 'Classifies the nature of the budget record. \'opex\' covers O&M operating expenditures; \'capex\' covers capital expenditures for utility plant additions; \'revenue\' covers projected rate revenues; \'depreciation\' covers regulatory depreciation expense budgets; \'regulatory\' covers rate case and compliance cost budgets. Aligns with FERC Uniform System of Accounts classification.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depreciationRatePct rdf:type rdf:Property ;
    rdfs:label 'Depreciation Rate Pct' ;
    rdfs:comment 'The annual regulatory depreciation rate (as a percentage) applied to CAPEX budget records for utility plant additions. Established by PUC-approved depreciation studies. Used to calculate budgeted depreciation expense for rate case cost-of-service studies and FERC Form 1 reporting. Null for OPEX budget records.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:energyType rdf:type rdf:Property ;
    rdfs:label 'Energy Type' ;
    rdfs:comment 'Identifies whether this budget record pertains to electric or gas utility operations, or a specific generation fuel type. Required for FERC jurisdictional cost separation between electric and gas operations, and for RPS (Renewable Portfolio Standard) compliance cost tracking.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fiscalPeriod rdf:type rdf:Property ;
    rdfs:label 'Fiscal Period' ;
    rdfs:comment 'The fiscal period (month number 1–12) within the fiscal year for which this budget amount is recorded. Enables monthly budget-vs-actual variance reporting and period-level financial planning cycles in SAP S/4HANA or Oracle ERP Cloud.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fiscalYear rdf:type rdf:Property ;
    rdfs:label 'Fiscal Year' ;
    rdfs:comment 'The fiscal year to which this budget record applies (e.g., 2025). Used for annual budget cycle management, rate case test year identification, and multi-year capital program planning. Aligns with the utility\'s regulatory fiscal year as filed with the PUC and FERC.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:functionalArea rdf:type rdf:Property ;
    rdfs:label 'Functional Area' ;
    rdfs:comment 'The business functional area associated with this budget record (e.g., Generation, Transmission, Electric Distribution, Gas Distribution, Customer Service, Corporate). Used for cost-of-service allocation in rate case studies and FERC jurisdictional separation of costs between electric and gas operations.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:owner rdf:type rdf:Property ;
    rdfs:label 'Owner' ;
    rdfs:comment 'Name or employee identifier of the manager or director responsible for this budget record (e.g., Director of Generation Operations, VP of T&D). Accountable for budget execution, variance explanations, and SOX attestation of financial controls for their cost center.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pbrTargetFlag rdf:type rdf:Property ;
    rdfs:label 'Pbr Target Flag' ;
    rdfs:comment 'Indicates whether this budget record is associated with a PBR (Performance-Based Ratemaking) performance target or incentive mechanism established by the PUC. True = linked to a PBR metric (e.g., SAIDI, SAIFI, customer satisfaction); False = standard budget record.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:periodAmount rdf:type rdf:Property ;
    rdfs:label 'Period Amount' ;
    rdfs:comment 'The budget amount allocated to the specific fiscal period (month) within the fiscal year, in USD. Supports monthly budget-vs-actual variance reporting and cash flow planning. The sum of all period amounts for a fiscal year should equal the approved_amount for annual budget records.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:planningCycle rdf:type rdf:Property ;
    rdfs:label 'Planning Cycle' ;
    rdfs:comment 'Identifies the financial planning cycle that produced this budget record. \'annual\' is the primary year-end budget cycle; \'mid_year_review\' is the formal mid-year reforecast; quarterly forecasts (q1–q3) are rolling updates; \'long_range\' covers multi-year IRP and capital program planning cycles.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorYearActualAmount rdf:type rdf:Property ;
    rdfs:label 'Prior Year Actual Amount' ;
    rdfs:comment 'The actual expenditure or revenue recorded in the prior fiscal year for the same cost center and GL account combination, in USD. Used as a baseline reference for budget development, trend analysis, and rate case historical test year comparisons filed with the PUC.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateCaseTestYearFlag rdf:type rdf:Property ;
    rdfs:label 'Rate Case Test Year Flag' ;
    rdfs:comment 'Indicates whether this budget record is designated as part of the rate case test year cost-of-service study submitted to the PUC or FERC. True = this record is included in the test year filing; False = standard budget record not designated for rate case use.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sourceRecordReference rdf:type rdf:Property ;
    rdfs:label 'Source Record Reference' ;
    rdfs:comment 'The natural key or document number from the originating source system (e.g., SAP CO document number, Oracle budget line ID). Used for data lineage, reconciliation between the lakehouse Silver Layer and the ERP source system, and SOX audit trail.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:varianceThresholdPct rdf:type rdf:Property ;
    rdfs:label 'Variance Threshold Pct' ;
    rdfs:comment 'The allowable percentage deviation between budgeted and actual amounts before a budget variance alert or escalation is triggered. Expressed as a percentage (e.g., 10.00 for 10%). Used in monthly budget-vs-actual variance reporting and SOX internal control monitoring.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:version rdf:type rdf:Property ;
    rdfs:label 'Version' ;
    rdfs:comment 'Identifies the planning iteration of this budget record. \'original\' is the board-approved annual budget; \'revised\' reflects mid-year amendments; \'forecast\' is the rolling latest estimate; \'long_range_plan\' covers multi-year capital programs (IRP/CAPEX plans); \'supplemental\' covers emergency or regulatory-driven additions.' ;
    rdfs:domain ind:Budget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wbsElement rdf:type rdf:Property ;
    rdfs:label 'Wbs Element' ;
    rdfs:comment 'The Work Breakdown Structure element code from SAP Project System (PS) or Oracle ERP Project module, used to track CAPEX budgets at the project or sub-project level. Supports AFUDC (Allowance for Funds Used During Construction) tracking and WIP (Work in Progress) capitalization per FERC accounting rules.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capexExpenditureId rdf:type rdf:Property ;
    rdfs:label 'Capex Expenditure Id' ;
    rdfs:comment 'Unique surrogate identifier for each capital expenditure transaction record in the Silver layer lakehouse. Primary key for this entity.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CapexExpenditure .

ind:afudcAmount rdf:type rdf:Property ;
    rdfs:label 'Afudc Amount' ;
    rdfs:comment 'The dollar amount of AFUDC accrued on this capital expenditure for the applicable period. Calculated as expenditure balance multiplied by the AFUDC rate. Capitalized to the asset cost basis and recovered through depreciation in rates.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:afudcRate rdf:type rdf:Property ;
    rdfs:label 'Afudc Rate' ;
    rdfs:comment 'The AFUDC rate applied to this expenditure for the period, expressed as a decimal (e.g., 0.075 for 7.5%). AFUDC represents the cost of financing construction and is capitalized to the asset cost basis per FERC regulations and GAAP ASC 835-20.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approvalReference rdf:type rdf:Property ;
    rdfs:label 'Approval Reference' ;
    rdfs:comment 'Reference number or identifier for the capital authorization document (e.g., Capital Appropriation Request, Board Resolution, or CPCN number) that approved this expenditure. Required for SOX compliance and audit trail.' ;
    rdfs:domain ind:CapexExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetAmount rdf:type rdf:Property ;
    rdfs:label 'Budget Amount' ;
    rdfs:comment 'The approved capital budget amount for the project or WBS element at the time of this expenditure. Used for budget-to-actual variance analysis and capital spend tracking against authorized CAPEX.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capitalizationStatus rdf:type rdf:Property ;
    rdfs:label 'Capitalization Status' ;
    rdfs:comment 'Current capitalization lifecycle state of this expenditure. \'wip\' indicates the cost is in Construction Work in Progress (CWIP); \'placed_in_service\' indicates the asset has been capitalized to the fixed asset register; \'expensed\' indicates the cost was reclassified as OPEX; \'reversed\' indicates a correcting entry; \'pending_review\' indicates awaiting capitalization determination.' ;
    rdfs:domain ind:CapexExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expenditureAmount rdf:type rdf:Property ;
    rdfs:label 'Expenditure Amount' ;
    rdfs:comment 'Gross amount of the capital expenditure in USD before any adjustments. Represents the base cost charged to the CAPEX project for this transaction line. Used for CWIP balance tracking and budget variance analysis.' ;
    rdfs:domain ind:CapexExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expenditureDate rdf:type rdf:Property ;
    rdfs:label 'Expenditure Date' ;
    rdfs:comment 'The actual calendar date on which the capital expenditure was incurred or the cost was recognized. This is the principal business event date used for CWIP balance reporting and period-end close.' ;
    rdfs:domain ind:CapexExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:expenditureDescription rdf:type rdf:Property ;
    rdfs:label 'Expenditure Description' ;
    rdfs:comment 'Free-text description of the capital expenditure, including the nature of work performed, materials procured, or services rendered. Provides context for audit review, rate case cost justification, and asset capitalization documentation.' ;
    rdfs:domain ind:CapexExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expenditureNumber rdf:type rdf:Property ;
    rdfs:label 'Expenditure Number' ;
    rdfs:comment 'Externally-known business identifier for this capital expenditure transaction, typically sourced from the ERP system (e.g., SAP S/4HANA document number or Oracle ERP Cloud transaction number). Used for cross-system traceability and audit.' ;
    rdfs:domain ind:CapexExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expenditureType rdf:type rdf:Property ;
    rdfs:label 'Expenditure Type' ;
    rdfs:comment 'Classification of the nature of the capital expenditure. Drives cost allocation and capitalization treatment. Values: labor (internal workforce), materials (equipment and supplies), contractor (third-party services), overhead (allocated indirect costs), afudc_accrual (Allowance for Funds Used During Construction accrual), other.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fercPlantAccount rdf:type rdf:Property ;
    rdfs:label 'Ferc Plant Account' ;
    rdfs:comment 'FERC Uniform System of Accounts plant account number (e.g., Account 310-399 for Electric Plant in Service, Account 107 for CWIP) to which this expenditure is classified. Required for FERC Form 1 regulatory reporting and rate case cost-of-service studies.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:functionalLocation rdf:type rdf:Property ;
    rdfs:label 'Functional Location' ;
    rdfs:comment 'The physical or logical functional location code (from Oracle WAM, IBM Maximo, or ESRI ArcGIS GIS system) identifying where the capital work is being performed. Examples: substation identifier, transmission line segment, distribution circuit, gas pipeline segment.' ;
    rdfs:domain ind:CapexExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isAfudcEligible rdf:type rdf:Property ;
    rdfs:label 'Is Afudc Eligible' ;
    rdfs:comment 'Indicates whether this expenditure qualifies for AFUDC accrual under FERC regulations and GAAP ASC 835-20. True if the expenditure is part of a qualifying construction project with a construction period exceeding the AFUDC threshold.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCapitalized rdf:type rdf:Property ;
    rdfs:label 'Is Capitalized' ;
    rdfs:comment 'Indicates whether this expenditure has been formally capitalized to the fixed asset register (True) or remains in CWIP or has been expensed (False). Used to filter capitalized vs. in-progress costs for balance sheet reporting.' ;
    rdfs:domain ind:CapexExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:netAmount rdf:type rdf:Property ;
    rdfs:label 'Net Amount' ;
    rdfs:comment 'Net capital expenditure amount after adjustments, credits, or reversals (expenditure_amount + tax_amount minus any credits). Represents the final capitalized cost contribution of this transaction to the project.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:placedInServiceDate rdf:type rdf:Property ;
    rdfs:label 'Placed In Service Date' ;
    rdfs:comment 'The date on which the constructed or acquired asset was placed in service and transferred from CWIP (Construction Work in Progress) to the fixed asset register. Triggers the start of depreciation and AFUDC cessation. Null while the project remains in WIP status.' ;
    rdfs:domain ind:CapexExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:quantity rdf:type rdf:Property ;
    rdfs:label 'Quantity' ;
    rdfs:comment 'Quantity of units (hours, units of material, etc.) associated with this capital expenditure. For labor expenditures, represents hours worked. For materials, represents units procured. Used for unit cost analysis and project cost benchmarking.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualCostToDate rdf:type rdf:Property ;
    rdfs:label 'Actual Cost To Date' ;
    rdfs:comment 'Cumulative actual capital expenditures incurred on the project to date, expressed in US dollars. Sourced from the ERP cost collection against the WBS element. Used for CWIP balance reporting, budget variance analysis, and capital program tracking.' ;
    rdfs:domain ind:CapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualInServiceDate rdf:type rdf:Property ;
    rdfs:label 'Actual In Service Date' ;
    rdfs:comment 'Actual date on which the capital project assets were placed in service and transferred from CWIP to plant in service accounts. Triggers AFUDC cessation, depreciation commencement, and inclusion in rate base. Null until the project reaches in-service status.' ;
    rdfs:domain ind:CapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:afudcAccruedAmount rdf:type rdf:Property ;
    rdfs:label 'Afudc Accrued Amount' ;
    rdfs:comment 'Cumulative AFUDC amount capitalized to the project to date, expressed in US dollars. Represents the financing cost of construction capitalized per FERC accounting rules. Included in the total project cost and rate base upon in-service. Null if afudc_eligible is False.' ;
    rdfs:domain ind:CapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:afudcEligible rdf:type rdf:Property ;
    rdfs:label 'Afudc Eligible' ;
    rdfs:comment 'Flag indicating whether this capital project is eligible for Allowance for Funds Used During Construction (AFUDC) accrual (True) or not (False). AFUDC represents the cost of financing construction and is capitalized to the project per FERC accounting rules. Eligibility is determined by project type, duration, and regulatory authorization.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:authorizationDate rdf:type rdf:Property ;
    rdfs:label 'Authorization Date' ;
    rdfs:comment 'Date on which the capital budget for this project was formally authorized through the utility\'s capital appropriations approval process. Marks the transition from planned to approved status and enables commitment of funds.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:authorizedBudgetAmount rdf:type rdf:Property ;
    rdfs:label 'Authorized Budget Amount' ;
    rdfs:comment 'Total capital budget amount authorized by the utility\'s capital appropriations process for this project, expressed in US dollars. Represents the approved spending ceiling for the project. Used for capital program tracking, variance analysis, and rate case cost-of-service studies.' ;
    rdfs:domain ind:CapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capexOpexSplitPct rdf:type rdf:Property ;
    rdfs:label 'Capex Opex Split Pct' ;
    rdfs:comment 'Percentage of total project costs classified as capital expenditure (CAPEX) versus operating expenditure (OPEX), expressed as the CAPEX percentage (0.00 to 100.00). Supports GAAP capitalization policy compliance and regulatory cost classification for rate case filings.' ;
    rdfs:domain ind:CapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ciacAmount rdf:type rdf:Property ;
    rdfs:label 'Ciac Amount' ;
    rdfs:comment 'Dollar amount of Contribution in Aid of Construction (CIAC) received or expected for this project, expressed in US dollars. Reduces the utility\'s net capital investment and rate base. Null if ciac_indicator is False.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ciacIndicator rdf:type rdf:Property ;
    rdfs:label 'Ciac Indicator' ;
    rdfs:comment 'Flag indicating whether this capital project involves a Contribution in Aid of Construction (CIAC) from a customer or developer (True) or not (False). CIAC represents funds or assets contributed by third parties to fund utility infrastructure extensions. Affects rate base treatment and tax accounting under GAAP and FERC rules.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cwipAccount rdf:type rdf:Property ;
    rdfs:label 'Cwip Account' ;
    rdfs:comment 'FERC Account 107 (Electric) or Account 105 (Gas) Construction Work in Progress sub-account code used to accumulate project costs prior to in-service date. Supports CWIP balance reporting for rate case filings and regulatory plant additions schedules.' ;
    rdfs:domain ind:CapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depreciationRate rdf:type rdf:Property ;
    rdfs:label 'Depreciation Rate' ;
    rdfs:comment 'Annual straight-line depreciation rate applied to the capital project assets upon in-service, expressed as a decimal (e.g., 0.033333 for 3.33% / 30-year life). Determined by the utility\'s FERC-approved or PUC-approved depreciation study by asset class. Null until the project is placed in service.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedCostAtCompletion rdf:type rdf:Property ;
    rdfs:label 'Estimated Cost At Completion' ;
    rdfs:comment 'Current forecast of total project cost at completion, expressed in US dollars. Reflects the project manager\'s latest estimate incorporating actual costs to date plus remaining work. Supports capital program forecasting and rate case cost-of-service studies.' ;
    rdfs:domain ind:CapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isBlanketProject rdf:type rdf:Property ;
    rdfs:label 'Is Blanket Project' ;
    rdfs:comment 'Flag indicating whether this is a blanket capital project (True) or a specific discrete capital project (False). Blanket projects represent recurring capital programs (e.g., annual pole replacement, annual meter deployment) that aggregate multiple small work orders under a single project authorization. Specific projects represent discrete capital investments with defined scope and budget.' ;
    rdfs:domain ind:CapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:justificationCategory rdf:type rdf:Property ;
    rdfs:label 'Justification Category' ;
    rdfs:comment 'Primary business justification category for the capital investment. Used for capital program portfolio analysis and regulatory prudency demonstrations. Values: reliability (grid or system reliability improvement), safety (worker or public safety), regulatory_compliance (mandated by FERC, PUC, EPA, NERC, PHMSA, or OSHA), growth (customer growth or load growth), replacement (end-of-life asset replacement), efficiency (operational efficiency improvement), environmental (environmental remediation or GHG reduction). [ENUM-REF-CANDIDATE: reliability|safety|regulatory_compliance|growth|replacement|efficiency|environmental — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:CapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nercReliabilityStandard rdf:type rdf:Property ;
    rdfs:label 'Nerc Reliability Standard' ;
    rdfs:comment 'NERC reliability standard (e.g., FAC-001, TPL-001, PRC-005) that mandates or drives this capital project, if applicable. Null if the project is not driven by a NERC compliance requirement. Supports regulatory compliance reporting and capital prudency documentation.' ;
    rdfs:domain ind:CapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:plantAdditionAmount rdf:type rdf:Property ;
    rdfs:label 'Plant Addition Amount' ;
    rdfs:comment 'Final gross plant addition amount recorded to the FERC plant in service account upon project close-out and in-service transfer, expressed in US dollars. Represents the capitalized cost of the asset placed in service, net of any CIAC. Used for FERC Form 1 plant additions schedule and rate base calculations.' ;
    rdfs:domain ind:CapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorityRank rdf:type rdf:Property ;
    rdfs:label 'Priority Rank' ;
    rdfs:comment 'Numeric priority ranking of the capital project within the utility\'s annual capital program, used for capital budget allocation and deferral decisions. Lower numbers indicate higher priority. Assigned during the annual capital planning cycle.' ;
    rdfs:domain ind:CapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:projectDescription rdf:type rdf:Property ;
    rdfs:label 'Project Description' ;
    rdfs:comment 'Detailed narrative description of the capital project scope, including the work to be performed, assets to be installed or replaced, and business justification. Supports rate case cost-of-service studies and regulatory reporting to PUCs and FERC.' ;
    rdfs:domain ind:CapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectManager rdf:type rdf:Property ;
    rdfs:label 'Project Manager' ;
    rdfs:comment 'Name or employee identifier of the project manager responsible for delivering the capital project on time and within budget. Used for accountability tracking, capital program reporting, and escalation routing.' ;
    rdfs:domain ind:CapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectName rdf:type rdf:Property ;
    rdfs:label 'Project Name' ;
    rdfs:comment 'Short human-readable name or title of the capital expenditure project (e.g., \'Substation 12 Transformer Replacement\', \'Annual Pole Replacement Program FY2024\'). Used in dashboards, capital program reports, and regulatory plant additions filings.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectNumber rdf:type rdf:Property ;
    rdfs:label 'Project Number' ;
    rdfs:comment 'Externally-known alphanumeric project identifier assigned by the Enterprise Resource Planning (ERP) system (e.g., SAP PS WBS element or Oracle Project number). Used for cross-system reference, regulatory filings, and rate case cost-of-service studies.' ;
    rdfs:domain ind:CapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectStartDate rdf:type rdf:Property ;
    rdfs:label 'Project Start Date' ;
    rdfs:comment 'Date on which capital project activities (design, procurement, or construction) formally commenced. Used for project duration tracking, AFUDC accrual period calculation, and capital program scheduling.' ;
    rdfs:domain ind:CapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:projectStatus rdf:type rdf:Property ;
    rdfs:label 'Project Status' ;
    rdfs:comment 'Current lifecycle status of the capital expenditure project. Drives capital program prioritization, CWIP balance reporting, and regulatory plant additions reporting. Values: planned (identified but not yet authorized), approved (capital budget authorized), in_progress (construction or implementation underway), complete (work finished, pending close-out), closed (fully closed and placed in service or written off), cancelled (project terminated prior to completion).' ;
    rdfs:domain ind:CapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectType rdf:type rdf:Property ;
    rdfs:label 'Project Type' ;
    rdfs:comment 'Functional classification of the capital project by utility business segment. Used for capital program segmentation, regulatory reporting, and rate base allocation. Values: transmission (high-voltage bulk electric infrastructure), distribution (last-mile electric delivery), generation (power plant assets), gas (natural gas pipeline and distribution), it (information technology infrastructure), environmental_compliance (environmental or regulatory compliance investments).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revisedBudgetAmount rdf:type rdf:Property ;
    rdfs:label 'Revised Budget Amount' ;
    rdfs:comment 'Most recent revised authorized budget amount reflecting approved budget amendments or change orders since original authorization. Null if no revisions have been approved. Supports capital program variance reporting and rate case prudency reviews.' ;
    rdfs:domain ind:CapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:soxControlRelevant rdf:type rdf:Property ;
    rdfs:label 'Sox Control Relevant' ;
    rdfs:comment 'Flag indicating whether this capital project is subject to Sarbanes-Oxley (SOX) internal controls over financial reporting (True) or not (False). SOX-relevant projects require documented approval workflows, segregation of duties, and audit trail maintenance per SOX Section 302 and 404 requirements.' ;
    rdfs:domain ind:CapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sponsoringDepartment rdf:type rdf:Property ;
    rdfs:label 'Sponsoring Department' ;
    rdfs:comment 'Name or code of the utility business department or organizational unit sponsoring and accountable for the capital project (e.g., Transmission Engineering, Distribution Operations, Gas Operations, IT). Used for capital program allocation and departmental CAPEX reporting.' ;
    rdfs:domain ind:CapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetInServiceDate rdf:type rdf:Property ;
    rdfs:label 'Target In Service Date' ;
    rdfs:comment 'Planned date on which the capital project assets are expected to be placed in service and transferred from Construction Work in Progress (CWIP) to plant in service accounts. Drives capital program scheduling, AFUDC cessation planning, and regulatory plant additions forecasting.' ;
    rdfs:domain ind:CapexProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:activityType rdf:type rdf:Property ;
    rdfs:label 'Activity Type' ;
    rdfs:comment 'Primary SAP activity type (LSTAR) associated with this cost center, representing the unit of output or service produced (e.g., labor hours, machine hours, kWh generated). Used for internal activity allocation, cost rate calculation, and transfer pricing between cost centers in the utility\'s controlling model.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:annualCapexBudget rdf:type rdf:Property ;
    rdfs:label 'Annual Capex Budget' ;
    rdfs:comment 'Approved annual CAPEX budget amount for this cost center in the controlling area currency. Supports capital program tracking, AFUDC eligibility assessment, WIP monitoring, and rate base additions reporting to PUCs and FERC.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:annualOpexBudget rdf:type rdf:Property ;
    rdfs:label 'Annual Opex Budget' ;
    rdfs:comment 'Approved annual OPEX budget amount for this cost center in the controlling area currency. Used for budget vs. actual variance reporting, rate case cost-of-service studies, and PBR performance tracking. Sourced from SAP S/4HANA CO planning versions.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:budgetFiscalYear rdf:type rdf:Property ;
    rdfs:label 'Budget Fiscal Year' ;
    rdfs:comment 'Fiscal year (YYYY) for which the annual OPEX and CAPEX budget amounts are applicable. Aligns with the utility\'s SAP fiscal year variant and regulatory test year used in rate case filings.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:businessArea rdf:type rdf:Property ;
    rdfs:label 'Business Area' ;
    rdfs:comment 'SAP Business Area (GSBER) representing a distinct operational segment of the utility (e.g., electric operations, gas operations, unregulated). Used for cross-company-code reporting and supports regulatory separation of electric and gas operations as required by state PUC accounting orders.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capexOpexIndicator rdf:type rdf:Property ;
    rdfs:label 'Capex Opex Indicator' ;
    rdfs:comment 'Indicates whether this cost center primarily accumulates Capital Expenditures (CAPEX), Operating Expenditures (OPEX), or a mix of both. Critical for regulatory accounting, rate base determination, and FERC USoA plant account vs. expense account mapping. Supports AFUDC calculation eligibility and WIP tracking.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:companyCode rdf:type rdf:Property ;
    rdfs:label 'Company Code' ;
    rdfs:comment 'SAP Company Code (BUKRS) representing the legal entity to which this cost center is assigned. Aligns with the utility\'s GAAP reporting entity and FERC jurisdictional entity for rate case and regulatory reporting purposes.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:controllingArea rdf:type rdf:Property ;
    rdfs:label 'Controlling Area' ;
    rdfs:comment 'SAP Controlling Area (KOKRS) to which this cost center belongs. Defines the organizational unit within which cost accounting is performed. Typically maps to the utility\'s legal entity or consolidated reporting entity.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costCenterCategory rdf:type rdf:Property ;
    rdfs:label 'Cost Center Category' ;
    rdfs:comment 'SAP cost center category code (KOSAR) classifying the type of cost center (e.g., E=Production/Operations, F=Overhead, H=Overhead, I=Investment, etc.). Determines which activity types and statistical key figures can be posted and controls planning behavior in SAP CO.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costCenterLevel rdf:type rdf:Property ;
    rdfs:label 'Cost Center Level' ;
    rdfs:comment 'Numeric level of this cost center within the organizational hierarchy (e.g., 1=Division, 2=Department, 3=Work Group). Supports hierarchical drill-down in financial reporting and budget consolidation processes.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:costCenterName rdf:type rdf:Property ;
    rdfs:label 'Cost Center Name' ;
    rdfs:comment 'Short descriptive name of the cost center as maintained in SAP S/4HANA (KTEXT field). Used in financial reports, budget variance analyses, and cost-of-service studies submitted to state Public Utility Commissions (PUCs) and FERC.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costCenterStatus rdf:type rdf:Property ;
    rdfs:label 'Cost Center Status' ;
    rdfs:comment 'Current lifecycle status of the cost center in SAP S/4HANA. \'active\' = open for postings; \'inactive\' = temporarily closed; \'locked\' = blocked for new postings (SAP lock indicator); \'pending_approval\' = awaiting activation; \'archived\' = historically closed and no longer in use. Controls whether financial transactions can be posted to this cost center.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costElementGroup rdf:type rdf:Property ;
    rdfs:label 'Cost Element Group' ;
    rdfs:comment 'SAP cost element group associated with this cost center, grouping related primary and secondary cost elements (G/L accounts) for planning, budgeting, and reporting. Supports OPEX and CAPEX segregation required for FERC USoA account mapping.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:departmentCode rdf:type rdf:Property ;
    rdfs:label 'Department Code' ;
    rdfs:comment 'Organizational department code to which this cost center belongs, as defined in the utility\'s HR and finance organizational structure (SuccessFactors/Workday). Supports headcount and labor cost allocation reporting and aligns with the utility\'s organizational chart for management reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depreciationArea rdf:type rdf:Property ;
    rdfs:label 'Depreciation Area' ;
    rdfs:comment 'SAP Asset Accounting depreciation area code associated with assets assigned to this cost center. Defines the depreciation rules (GAAP book, FERC regulatory, tax) applied to utility plant assets tracked under this cost center. Supports FERC-prescribed depreciation rates and GAAP ASC 360 asset accounting.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:energyCommodity rdf:type rdf:Property ;
    rdfs:label 'Energy Commodity' ;
    rdfs:comment 'Identifies whether this cost center supports electric operations, gas operations, both, or neither (corporate/shared services). Required for regulatory separation of electric and gas utility operations per state PUC accounting orders and FERC USoA commodity-specific account mapping.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fiscalYearVariant rdf:type rdf:Property ;
    rdfs:label 'Fiscal Year Variant' ;
    rdfs:comment 'SAP Fiscal Year Variant (PERIV) assigned to this cost center\'s controlling area, defining the fiscal year calendar (e.g., K4 = calendar year Jan-Dec). Ensures correct period assignment for budget planning and actual cost postings in regulatory and GAAP financial reporting.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:glAccountGroup rdf:type rdf:Property ;
    rdfs:label 'Gl Account Group' ;
    rdfs:comment 'SAP General Ledger account group associated with this cost center, defining the range of G/L accounts (FERC USoA accounts) that can be posted. Ensures that only appropriate expense and capital accounts are used for each functional area, supporting GAAP and FERC regulatory accounting integrity.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:headcountPlan rdf:type rdf:Property ;
    rdfs:label 'Headcount Plan' ;
    rdfs:comment 'Approved planned headcount (number of full-time equivalent positions) assigned to this cost center for the current budget year. Used for labor cost planning, workforce analytics, and rate case labor cost justification in cost-of-service studies filed with PUCs.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:hierarchyArea rdf:type rdf:Property ;
    rdfs:label 'Hierarchy Area' ;
    rdfs:comment 'Node within the SAP standard cost center hierarchy (KHINR) to which this cost center belongs. Defines the organizational rollup path for management reporting, budget consolidation, and cost-of-service study aggregations aligned with the utility\'s organizational structure.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastChangedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Changed Timestamp' ;
    rdfs:comment 'Timestamp of the most recent modification to this cost center master record in SAP S/4HANA. Used for incremental ETL processing in the Databricks Lakehouse pipeline and SOX change management audit trail.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:longDescription rdf:type rdf:Property ;
    rdfs:label 'Long Description' ;
    rdfs:comment 'Extended narrative description of the cost center\'s business purpose, scope of activities, and organizational context. Supports regulatory documentation and rate case cost-of-service study narratives.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:plantCode rdf:type rdf:Property ;
    rdfs:label 'Plant Code' ;
    rdfs:comment 'SAP Plant (WERKS) or physical facility/location to which this cost center is primarily assigned. For generation cost centers, maps to a specific power plant. For T&D cost centers, maps to a service territory or operating district. Supports asset-level cost tracking in conjunction with Oracle WAM or IBM Maximo EAM.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:profitCenter rdf:type rdf:Property ;
    rdfs:label 'Profit Center' ;
    rdfs:comment 'SAP Profit Center (PRCTR) to which this cost center is assigned for internal management reporting and segment profitability analysis. Supports GAAP segment reporting disclosures (ASC 280) and internal ROE/ROI analysis by business segment (electric, gas, corporate).' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsibleManagerCode rdf:type rdf:Property ;
    rdfs:label 'Responsible Manager Code' ;
    rdfs:comment 'Employee identifier of the manager accountable for the cost center\'s budget and expenditures, as maintained in SAP S/4HANA (VERAK field) and synchronized with SuccessFactors or Workday HCM. Used for budget approval workflows, variance reporting, and SOX internal control accountability assignments.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsibleManagerName rdf:type rdf:Property ;
    rdfs:label 'Responsible Manager Name' ;
    rdfs:comment 'Full name of the manager responsible for this cost center\'s budget and financial performance. Displayed in financial reports, budget variance dashboards, and cost-of-service study documentation. Sourced from SAP S/4HANA cost center master (VERAK_NAME).' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:soxRelevant rdf:type rdf:Property ;
    rdfs:label 'Sox Relevant' ;
    rdfs:comment 'Indicates whether this cost center is within scope for Sarbanes-Oxley (SOX) Section 404 internal controls over financial reporting. SOX-relevant cost centers require documented controls, segregation of duties, and periodic management testing as part of the utility\'s annual SOX compliance program.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:workOrderSettlementProfile rdf:type rdf:Property ;
    rdfs:label 'Work Order Settlement Profile' ;
    rdfs:comment 'SAP settlement profile (ABCPROFIL) defining how maintenance and capital work order costs are settled to this cost center from Oracle WAM or IBM Maximo work orders integrated via SAP PM. Governs CAPEX vs. OPEX treatment of maintenance activities for regulatory accounting.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validFrom rdf:type rdf:Property ;
    rdfs:label 'Valid From' ;
    rdfs:comment 'Date from which this cost center is valid and open for financial postings in SAP S/4HANA (DATAB field). Defines the start of the cost center\'s active period for budget planning, actual cost accumulation, and regulatory reporting.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:validTo rdf:type rdf:Property ;
    rdfs:label 'Valid To' ;
    rdfs:comment 'Date through which this cost center is valid in SAP S/4HANA (DATBI field). After this date, no new postings are permitted. Nullable for open-ended cost centers. Supports historical cost center management and regulatory period-of-record requirements.' ;
    rdfs:domain ind:CostCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:depreciationRunId rdf:type rdf:Property ;
    rdfs:label 'Depreciation Run Id' ;
    rdfs:comment 'Unique surrogate identifier for each depreciation calculation run executed against the fixed asset subledger. Primary key for this record.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:depreciationStudyId rdf:type rdf:Property ;
    rdfs:label 'Depreciation Study Id' ;
    rdfs:comment 'Reference identifier for the PUC-approved depreciation study whose rates were applied in this run. Links the run to the authoritative rate study (interim or final) that established the depreciation rates, supporting depreciation study true-up analysis and rate case cost-of-service documentation.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DepreciationStudy .

ind:accumulatedDepreciationAmount rdf:type rdf:Property ;
    rdfs:label 'Accumulated Depreciation Amount' ;
    rdfs:comment 'Total accumulated depreciation balance (in USD) for the assets processed in this run as of the end of the fiscal period, across the specified depreciation area. Represents the cumulative depreciation charged against the gross plant-in-service balance. Used in FERC Form 1 Schedule 336 and rate base calculations for rate cases.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approvalTimestamp rdf:type rdf:Property ;
    rdfs:label 'Approval Timestamp' ;
    rdfs:comment 'Timestamp when the depreciation run was approved for posting by the authorized finance approver. Part of the SOX audit trail for the depreciation posting lifecycle.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:assetsErroredCount rdf:type rdf:Property ;
    rdfs:label 'Assets Errored Count' ;
    rdfs:comment 'Number of fixed asset records that encountered errors and were excluded from depreciation calculation during this run. A non-zero value requires investigation and potential rerun. Supports SOX completeness controls over the depreciation process.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assetsProcessedCount rdf:type rdf:Property ;
    rdfs:label 'Assets Processed Count' ;
    rdfs:comment 'Total number of fixed asset records processed during this depreciation run. Used for run completeness validation, reconciliation against the fixed asset register count, and identifying partial runs or processing errors.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:depreciationAreaCode rdf:type rdf:Property ;
    rdfs:label 'Depreciation Area Code' ;
    rdfs:comment 'Code identifying the depreciation valuation area for which this run was executed. Common utility depreciation areas: \'01\' = Book/GAAP, \'10\' = Federal Tax (MACRS), \'15\' = State Tax, \'20\' = Regulatory/FERC, \'30\' = Alternative Minimum Tax (AMT), \'40\' = Group/Composite. Each area maintains independent depreciation values per SAP FI-AA configuration. [ENUM-REF-CANDIDATE: 01|10|15|20|30|40 — promote to reference product]' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depreciationAreaName rdf:type rdf:Property ;
    rdfs:label 'Depreciation Area Name' ;
    rdfs:comment 'Human-readable name of the depreciation area (e.g., \'Book/GAAP\', \'Federal Tax MACRS\', \'State Tax\', \'Regulatory/FERC\', \'Alternative Minimum Tax\', \'Group/Composite\'). Supports reporting and audit trail readability without requiring a join to a reference table.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depreciationMethodCode rdf:type rdf:Property ;
    rdfs:label 'Depreciation Method Code' ;
    rdfs:comment 'Code identifying the depreciation calculation method applied during this run. \'SL\' = Straight-Line (primary GAAP method for utilities); \'GRP\' = Group/Composite (common for utility plant accounts per FERC); \'SYD\' = Sum-of-Years-Digits; \'DB\' = Declining Balance; \'UOP\' = Units-of-Production. Determines the mathematical basis for depreciation expense calculation.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depreciationMethodName rdf:type rdf:Property ;
    rdfs:label 'Depreciation Method Name' ;
    rdfs:comment 'Full descriptive name of the depreciation method applied (e.g., \'Straight-Line\', \'Group/Composite\', \'Sum-of-Years-Digits\', \'Declining Balance\', \'Units-of-Production\'). Supports FERC Form 1 Schedule 336 reporting and rate case cost-of-service documentation.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depreciationRateType rdf:type rdf:Property ;
    rdfs:label 'Depreciation Rate Type' ;
    rdfs:comment 'Indicates whether the depreciation rates applied in this run are interim rates (provisionally approved by the PUC pending final order), final rates (approved in a final PUC order), proposed rates (filed but not yet approved), or approved rates (in effect under current tariff). Critical for regulatory accounting and rate case true-up calculations.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:errorMessage rdf:type rdf:Property ;
    rdfs:label 'Error Message' ;
    rdfs:comment 'System-generated error message text when run_status = \'error\'. Captures the ERP error description to support troubleshooting and resolution of failed depreciation runs. Null when the run completed successfully.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grossPlantAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Plant Amount' ;
    rdfs:comment 'Total gross plant-in-service value (in USD) of the assets processed in this depreciation run as of the run date. Represents the depreciable asset base. Used to validate the depreciation rate applied (total_depreciation_amount / gross_plant_amount) and supports rate base calculations in rate case cost-of-service studies.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isRepeatRun rdf:type rdf:Property ;
    rdfs:label 'Is Repeat Run' ;
    rdfs:comment 'Indicates whether this run is a repeat execution for a period that was previously processed (True) or a first-time run for the period (False). Repeat runs occur after reversals or corrections. Relevant for SOX controls over duplicate depreciation postings.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSimulation rdf:type rdf:Property ;
    rdfs:label 'Is Simulation' ;
    rdfs:comment 'Indicates whether this depreciation run was executed in simulation (test) mode without posting to the general ledger (True) or as a live posting run (False). Simulation runs are used to preview depreciation amounts before period-end close.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:plannedDepreciationAmount rdf:type rdf:Property ;
    rdfs:label 'Planned Depreciation Amount' ;
    rdfs:comment 'The budgeted or planned depreciation amount for this fiscal period and depreciation area, as established in the depreciation study or annual budget. Compared against total_depreciation_amount to identify variances for depreciation study true-up analysis and rate case cost-of-service reconciliation.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:postingDocumentNumber rdf:type rdf:Property ;
    rdfs:label 'Posting Document Number' ;
    rdfs:comment 'ERP financial document number (e.g., SAP FI document number) generated when depreciation amounts are posted to the general ledger. Provides the audit trail linkage between the depreciation run and the actual GL posting for SOX compliance and external audit support.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reversalDocumentNumber rdf:type rdf:Property ;
    rdfs:label 'Reversal Document Number' ;
    rdfs:comment 'ERP financial document number of the reversal posting if this depreciation run was reversed. Null if the run has not been reversed. Supports audit trail for corrected depreciation postings and SOX compliance.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:runDate rdf:type rdf:Property ;
    rdfs:label 'Run Date' ;
    rdfs:comment 'The calendar date on which the depreciation calculation run was executed. This is the principal business event date — the date the depreciation program was triggered in the asset accounting system.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:runEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Run End Timestamp' ;
    rdfs:comment 'Timestamp when the depreciation calculation program completed execution. Used with run_start_timestamp to measure total processing duration for operational monitoring of the period-end close process.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:runInitiator rdf:type rdf:Property ;
    rdfs:label 'Run Initiator' ;
    rdfs:comment 'User ID or system account that initiated the depreciation run in the ERP system. Required for SOX audit trail to establish accountability over the depreciation posting process and segregation of duties compliance.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:runNumber rdf:type rdf:Property ;
    rdfs:label 'Run Number' ;
    rdfs:comment 'Externally-known business identifier assigned to the depreciation run by the ERP system (e.g., SAP S/4HANA depreciation run document number). Used for cross-system reconciliation and audit trail reference.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:runStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Run Start Timestamp' ;
    rdfs:comment 'Timestamp when the depreciation calculation program began execution in the ERP system. Used with run_end_timestamp to measure processing duration and identify performance issues with large asset portfolios.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:runStatus rdf:type rdf:Property ;
    rdfs:label 'Run Status' ;
    rdfs:comment 'Current lifecycle state of the depreciation run. \'planned\' indicates scheduled but not yet executed; \'simulated\' indicates a test run without posting; \'posted\' indicates amounts have been committed to the general ledger; \'reversed\' indicates the posting has been reversed; \'error\' indicates the run failed during processing.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:runType rdf:type rdf:Property ;
    rdfs:label 'Run Type' ;
    rdfs:comment 'Classification of the depreciation run by its business purpose. \'periodic\' = standard monthly/quarterly run; \'year_end\' = annual closing run; \'special\' = off-cycle run for asset disposals or acquisitions; \'repeat\' = rerun of a previously executed period.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalDepreciationAmount rdf:type rdf:Property ;
    rdfs:label 'Total Depreciation Amount' ;
    rdfs:comment 'Total depreciation expense amount (in USD) calculated and posted during this run across all assets processed. This is the gross depreciation charge for the period and depreciation area. Key input for rate case cost-of-service calculations, FERC Form 1 Schedule 336 reporting, and GAAP income statement depreciation expense line.' ;
    rdfs:domain ind:DepreciationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorYearPeriodFinancialPeriodId rdf:type rdf:Property ;
    rdfs:label 'Prior Year Period Financial Period Id' ;
    rdfs:comment 'Reference to the corresponding fiscal period in the prior year, enabling year-over-year financial comparisons in regulatory filings, earnings reports, and rate case testimony. For example, Period 3 FY2024 links to Period 3 FY2023.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinancialPeriod .

ind:accrualCutoffDate rdf:type rdf:Property ;
    rdfs:label 'Accrual Cutoff Date' ;
    rdfs:comment 'The last date by which accrual journal entries (unbilled revenue, fuel cost accruals, O&M accruals, AFUDC accruals) must be posted to be included in this fiscal period\'s financial results. May differ from calendar_end_date when the utility\'s close schedule allows a grace period for late accruals. Format: yyyy-MM-dd.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:budgetPeriodFlag rdf:type rdf:Property ;
    rdfs:label 'Budget Period Flag' ;
    rdfs:comment 'Indicates whether this fiscal period has an approved operating budget loaded in the financial planning system. True = budget data available for variance analysis; False = no budget loaded. Supports CAPEX/OPEX budget vs. actual variance reporting and rate case cost-of-service analysis.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:calendarEndDate rdf:type rdf:Property ;
    rdfs:label 'Calendar End Date' ;
    rdfs:comment 'The calendar date on which this fiscal period ends (inclusive). Defines the boundary for accruals, revenue recognition cut-offs, and period-end close procedures. Format: yyyy-MM-dd.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:calendarMonth rdf:type rdf:Property ;
    rdfs:label 'Calendar Month' ;
    rdfs:comment 'The calendar month number (1–12) corresponding to this fiscal period. For regular periods, this aligns with the calendar month. For adjustment periods (13–16), this retains the calendar month of the base period to which adjustments are attributed. Supports alignment with AMI billing cycles and meter read schedules.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:calendarStartDate rdf:type rdf:Property ;
    rdfs:label 'Calendar Start Date' ;
    rdfs:comment 'The calendar date on which this fiscal period begins (inclusive). Used to align fiscal period boundaries with calendar-month meter reads, billing cycles, energy market settlement dates, and regulatory reporting windows. Format: yyyy-MM-dd.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:calendarYear rdf:type rdf:Property ;
    rdfs:label 'Calendar Year' ;
    rdfs:comment 'The four-digit calendar year corresponding to this fiscal period. May differ from fiscal_year for utilities operating on a non-calendar fiscal year (e.g., April–March). Required for aligning fiscal periods with calendar-year regulatory reporting and energy market settlement calendars.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:closeWorkflowStatus rdf:type rdf:Property ;
    rdfs:label 'Close Workflow Status' ;
    rdfs:comment 'Tracks the current state of the period-end or year-end close workflow for this fiscal period. \'not_started\' = close activities not yet initiated; \'in_progress\' = close tasks underway; \'completed\' = all close tasks finished; \'approved\' = controller/CFO sign-off obtained; \'failed\' = close workflow encountered errors requiring remediation.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:daysInPeriod rdf:type rdf:Property ;
    rdfs:label 'Days In Period' ;
    rdfs:comment 'The total number of calendar days in this fiscal period (derived from calendar_start_date and calendar_end_date). Used for daily rate proration in billing, depreciation calculations, fuel cost accruals, and energy generation output normalization. Stored explicitly to avoid runtime date arithmetic in reporting queries.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:depreciationRunStatus rdf:type rdf:Property ;
    rdfs:label 'Depreciation Run Status' ;
    rdfs:comment 'Indicates the status of the periodic depreciation calculation run for utility plant assets in this fiscal period. \'not_run\' = depreciation not yet calculated; \'in_progress\' = depreciation run executing; \'completed\' = calculated but not yet posted; \'posted\' = depreciation journal entries posted to the GL. Critical for CAPEX tracking and FERC plant account reporting.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fercReportingYear rdf:type rdf:Property ;
    rdfs:label 'Ferc Reporting Year' ;
    rdfs:comment 'The FERC reporting year to which this fiscal period\'s financial data is attributed for FERC Form 1 (electric) and FERC Form 2 (gas) annual report submissions. May differ from fiscal_year for utilities with non-calendar fiscal years. Ensures correct period-to-FERC-filing alignment for regulatory compliance.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fiscalQuarter rdf:type rdf:Property ;
    rdfs:label 'Fiscal Quarter' ;
    rdfs:comment 'The fiscal quarter (1–4) to which this period belongs. Derived from period_number but stored explicitly to support quarterly financial reporting, quarterly FERC filings, and quarterly earnings disclosures without requiring runtime computation.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:intercompanyEliminationStatus rdf:type rdf:Property ;
    rdfs:label 'Intercompany Elimination Status' ;
    rdfs:comment 'Tracks whether intercompany transaction eliminations have been completed for this fiscal period in consolidated financial statements. Relevant for utilities with multiple regulated subsidiaries (electric, gas, unregulated affiliates). \'not_required\' = single-entity utility; \'pending\' = eliminations not yet processed; \'completed\' = eliminations posted.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isAdjustmentPeriod rdf:type rdf:Property ;
    rdfs:label 'Is Adjustment Period' ;
    rdfs:comment 'Indicates whether this is a special adjustment period (periods 13–16) used for post-close audit adjustments, regulatory accounting entries, or tax provision postings that must be segregated from regular operating period activity. True = adjustment period; False = regular period.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isOpenForAssetPosting rdf:type rdf:Property ;
    rdfs:label 'Is Open For Asset Posting' ;
    rdfs:comment 'Indicates whether the asset accounting sub-ledger is open for depreciation runs, asset acquisitions, retirements, and transfers in this fiscal period. Utilities carry significant CAPEX in generation, transmission, and distribution assets; asset accounting periods may close independently from the GL. True = asset postings permitted; False = blocked.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isOpenForCoPosting rdf:type rdf:Property ;
    rdfs:label 'Is Open For Co Posting' ;
    rdfs:comment 'Indicates whether the cost controlling module is open for internal order settlements, cost center allocations, and profit center postings in this fiscal period. True = CO postings permitted; False = blocked. Supports OPEX and CAPEX cost allocation for rate case cost-of-service studies.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isOpenForGlPosting rdf:type rdf:Property ;
    rdfs:label 'Is Open For Gl Posting' ;
    rdfs:comment 'Indicates whether the general ledger module is currently open for journal entry postings in this fiscal period. True = GL postings permitted; False = GL postings blocked. Distinct from asset accounting and cost controlling open flags, as each sub-ledger may have independent open/close timing.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isOpenForMmPosting rdf:type rdf:Property ;
    rdfs:label 'Is Open For Mm Posting' ;
    rdfs:comment 'Indicates whether the materials management module is open for goods receipts, inventory movements, and purchase order invoice verifications in this fiscal period. Relevant for utility supply chain — fuel procurement, spare parts, and construction materials. True = MM postings permitted; False = blocked.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isYearEndPeriod rdf:type rdf:Property ;
    rdfs:label 'Is Year End Period' ;
    rdfs:comment 'Indicates whether this fiscal period is a year-end closing period requiring full year-end close procedures including balance carryforward, retained earnings posting, and annual financial statement preparation. True = year-end period; False = regular or interim period.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ledgerType rdf:type rdf:Property ;
    rdfs:label 'Ledger Type' ;
    rdfs:comment 'Identifies the accounting ledger to which this period definition applies. \'leading\' = primary GAAP ledger; \'extension\' = parallel ledger for IFRS or tax accounting; \'regulatory\' = FERC regulatory accounting ledger. Utilities maintain parallel ledgers to reconcile GAAP financial statements with FERC Uniform System of Accounts regulatory books.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:periodCloseTimestamp rdf:type rdf:Property ;
    rdfs:label 'Period Close Timestamp' ;
    rdfs:comment 'The date and time when this fiscal period was officially closed following completion of period-end close procedures (accruals, reconciliations, depreciation runs, allocations). Null if the period has not yet been closed. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:periodDescription rdf:type rdf:Property ;
    rdfs:label 'Period Description' ;
    rdfs:comment 'Free-text description providing additional context about this fiscal period, such as special close instructions, regulatory filing notes, or explanations for non-standard adjustment periods. Used by the financial close team and external auditors for period documentation.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:periodLockTimestamp rdf:type rdf:Property ;
    rdfs:label 'Period Lock Timestamp' ;
    rdfs:comment 'The date and time when this fiscal period was hard-locked, preventing any further postings including adjustments. Represents the final SOX control point after which no unauthorized changes can be made to the period\'s financial data. Null if the period has not been locked. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:periodName rdf:type rdf:Property ;
    rdfs:label 'Period Name' ;
    rdfs:comment 'Human-readable label for the fiscal period (e.g., \'January 2024\', \'Q1 2024 Adjustment\', \'Year-End Close 2024\'). Used in financial reports, dashboards, and regulatory filings for display purposes.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:periodNumber rdf:type rdf:Property ;
    rdfs:label 'Period Number' ;
    rdfs:comment 'The sequential period number within the fiscal year. Regular operating periods are numbered 1 through 12 (monthly). Adjustment and special closing periods are numbered 13 through 16 per SAP S/4HANA fiscal year variant conventions. Controls which posting periods are open in the general ledger, asset accounting, and cost controlling modules.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:periodOpenTimestamp rdf:type rdf:Property ;
    rdfs:label 'Period Open Timestamp' ;
    rdfs:comment 'The date and time when this fiscal period was officially opened for journal entry postings. Provides an audit trail for period lifecycle management and SOX compliance. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:periodShortCode rdf:type rdf:Property ;
    rdfs:label 'Period Short Code' ;
    rdfs:comment 'Compact alphanumeric code uniquely identifying the fiscal period in the format YYYY.PPP (e.g., \'2024.001\' for Period 1 of FY2024, \'2024.013\' for the first adjustment period). Used as a display key in financial reports, journal entry headers, and regulatory filings where space is constrained.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:periodStatus rdf:type rdf:Property ;
    rdfs:label 'Period Status' ;
    rdfs:comment 'Current lifecycle state of the fiscal period controlling whether journal entry postings are permitted. \'open\' = postings allowed; \'closed\' = period-end close completed, no new postings; \'locked\' = SOX-compliant hard lock preventing any unauthorized postings; \'future\' = period not yet reached. Critical SOX internal control — period lock prevents unauthorized retroactive postings to closed periods.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:periodType rdf:type rdf:Property ;
    rdfs:label 'Period Type' ;
    rdfs:comment 'Classifies the nature of the fiscal period. \'regular\' = standard monthly operating period (1-12); \'adjustment\' = post-close adjustment period (13-14); \'year_end_closing\' = year-end closing period (15); \'special\' = utility-specific special posting period (16). Determines which business transactions and journal entry types are permitted during the period.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryReportingPeriod rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reporting Period' ;
    rdfs:comment 'Indicates whether this fiscal period aligns with a mandatory regulatory reporting deadline (e.g., FERC Form 1 annual filing, quarterly PUC financial reports, NERC reliability reporting). True = regulatory filing due at end of this period; False = no regulatory filing deadline. Triggers regulatory reporting workflow initiation.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sourceSystemPeriodKey rdf:type rdf:Property ;
    rdfs:label 'Source System Period Key' ;
    rdfs:comment 'The natural key or technical identifier for this fiscal period as it exists in the originating source system (e.g., SAP S/4HANA fiscal year + posting period concatenation \'202401\', or Oracle ERP Cloud period_name \'Jan-24\'). Enables lineage tracing from the Silver layer back to the operational system of record for audit and reconciliation purposes.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:soxCertificationStatus rdf:type rdf:Property ;
    rdfs:label 'Sox Certification Status' ;
    rdfs:comment 'Tracks the SOX Section 302/404 internal control certification status for this fiscal period. \'not_required\' = period not subject to SOX certification (e.g., interim adjustment periods); \'pending\' = certification in progress; \'certified\' = management certification completed with no material weaknesses; \'exceptions_noted\' = material weakness or significant deficiency identified.' ;
    rdfs:domain ind:FinancialPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accumulatedDepreciation rdf:type rdf:Property ;
    rdfs:label 'Accumulated Depreciation' ;
    rdfs:comment 'Total depreciation accrued on the asset from in-service date through the current reporting period. Represents the cumulative reduction in the asset\'s book value due to wear, obsolescence, and passage of time. Used to compute net book value and rate base. Denominated in USD. Corresponds to FERC Account 108 (Accumulated Provision for Depreciation of Electric Utility Plant) or equivalent gas accounts.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:acquisitionDate rdf:type rdf:Property ;
    rdfs:label 'Acquisition Date' ;
    rdfs:comment 'Date on which the utility acquired ownership or control of the asset (purchase date, transfer date, or contribution date). May differ from in-service date for assets acquired from third parties or contributed by developers (CIAC — Contribution in Aid of Construction).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:annualDepreciationRate rdf:type rdf:Property ;
    rdfs:label 'Annual Depreciation Rate' ;
    rdfs:comment 'The composite or straight-line annual depreciation rate applied to this asset or asset group, expressed as a decimal (e.g., 0.033333 for a 30-year life). Derived from the FERC or PUC-approved depreciation study. Used to compute annual depreciation expense for regulatory reporting and rate case cost-of-service studies.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assetDescription rdf:type rdf:Property ;
    rdfs:label 'Asset Description' ;
    rdfs:comment 'Human-readable description of the capitalized utility plant asset (e.g., \'138kV Transmission Line Segment — Substation A to Substation B\', \'Gas Distribution Main — 4-inch PE Pipe\'). Sourced from the asset master record in the ERP fixed asset module.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetNumber rdf:type rdf:Property ;
    rdfs:label 'Asset Number' ;
    rdfs:comment 'Externally-known alphanumeric identifier assigned to the capitalized asset in the fixed asset subledger (e.g., SAP S/4HANA Asset Master number or Oracle ERP asset number). Used for cross-system reconciliation between the financial subledger and the operational asset register in Oracle WAM or IBM Maximo.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetRetirementObligation rdf:type rdf:Property ;
    rdfs:label 'Asset Retirement Obligation' ;
    rdfs:comment 'Recorded Asset Retirement Obligation (ARO) associated with this asset, representing the present value of the estimated future cost to retire the asset in accordance with legal or regulatory obligations (e.g., nuclear decommissioning, PCB-contaminated equipment disposal, gas main abandonment). Recognized per GAAP ASC 410-20 and tracked for FERC regulatory accounting. Denominated in USD.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capexCategory rdf:type rdf:Property ;
    rdfs:label 'Capex Category' ;
    rdfs:comment 'Strategic CAPEX category classifying the business driver for the capital investment in this asset. \'growth\' supports customer or load growth. \'reliability\' improves grid or system reliability (SAIDI/SAIFI improvement). \'compliance\' meets regulatory or environmental mandates. \'replacement\' replaces end-of-life infrastructure. \'technology\' supports grid modernization or AMI deployment. Used in IRP and regulatory filings.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capitalizationThreshold rdf:type rdf:Property ;
    rdfs:label 'Capitalization Threshold' ;
    rdfs:comment 'Minimum dollar threshold applied to determine whether an expenditure on this asset class is capitalized as plant in service or expensed as O&M. Established by the utility\'s capitalization policy, approved by the board, and subject to SOX internal controls. Denominated in USD.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costOfRemoval rdf:type rdf:Property ;
    rdfs:label 'Cost Of Removal' ;
    rdfs:comment 'Actual or estimated cost incurred to remove the asset from service upon retirement (excavation, demolition, environmental remediation, disposal). Subtracted from gross salvage to determine net salvage. Frequently exceeds gross salvage for underground utility infrastructure, resulting in negative net salvage. Denominated in USD.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cwipTransferReference rdf:type rdf:Property ;
    rdfs:label 'Cwip Transfer Reference' ;
    rdfs:comment 'Reference number or identifier of the Construction Work in Progress (CWIP) work order or project from which this asset was transferred upon completion and placement in service. Links the capitalized plant record back to the capital project that funded its construction. Corresponds to FERC Account 107 (Construction Work in Progress) transfer transactions.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depreciationGroupCode rdf:type rdf:Property ;
    rdfs:label 'Depreciation Group Code' ;
    rdfs:comment 'Code identifying the depreciation group or composite account to which this asset belongs for group/composite depreciation purposes. Assets within the same depreciation group share a common composite depreciation rate derived from the FERC or PUC-approved depreciation study. Critical for utility industry group depreciation accounting.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depreciationStudyYear rdf:type rdf:Property ;
    rdfs:label 'Depreciation Study Year' ;
    rdfs:comment 'The year of the most recent FERC or PUC-approved depreciation study from which the depreciation rates, useful life, and net salvage rate for this asset class were derived. Depreciation studies are typically conducted every 3–5 years and filed with the applicable regulatory authority. Tracks which study vintage governs the current depreciation parameters.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fercPlantAccountName rdf:type rdf:Property ;
    rdfs:label 'Ferc Plant Account Name' ;
    rdfs:comment 'Descriptive name corresponding to the FERC plant account code (e.g., \'Electric Plant in Service\', \'Distribution Mains — Gas\'). Supports human-readable reporting on FERC Form 1 plant schedules without requiring a join to a reference table.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:functionalClass rdf:type rdf:Property ;
    rdfs:label 'Functional Class' ;
    rdfs:comment 'FERC functional classification of the utility plant asset: Generation, Transmission, Distribution, General Plant, or Intangible. Drives allocation of rate base and O&M costs across customer classes in rate case cost-of-service studies.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grossSalvageAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Salvage Amount' ;
    rdfs:comment 'Actual or estimated gross salvage proceeds received or expected upon retirement of the asset (scrap value, resale proceeds). Used in conjunction with cost of removal to compute net salvage for depreciation study updates. Populated upon retirement; null for in-service assets. Denominated in USD.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isRateBaseEligible rdf:type rdf:Property ;
    rdfs:label 'Is Rate Base Eligible' ;
    rdfs:comment 'Indicates whether this asset is eligible for inclusion in the utility\'s regulatory rate base for cost-of-service rate case purposes. Assets funded by CIAC, regulatory disallowances, or held for future use may be excluded from rate base. Critical for PUC and FERC rate case filings.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRegulatoryAsset rdf:type rdf:Property ;
    rdfs:label 'Is Regulatory Asset' ;
    rdfs:comment 'Indicates whether this item is classified as a regulatory asset under GAAP ASC 980 (Regulated Operations), meaning its recovery through future rates is probable. Regulatory assets arise from costs deferred for rate recovery (e.g., storm damage costs, deferred fuel costs, environmental remediation). Affects balance sheet presentation and rate case strategy.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastPhysicalInventoryDate rdf:type rdf:Property ;
    rdfs:label 'Last Physical Inventory Date' ;
    rdfs:comment 'Date of the most recent physical inventory verification confirming the existence and condition of this asset. Physical inventories are required for SOX compliance (internal controls over financial reporting) and support reconciliation between the fixed asset subledger and the operational asset register in Oracle WAM or IBM Maximo.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:netBookValue rdf:type rdf:Property ;
    rdfs:label 'Net Book Value' ;
    rdfs:comment 'Current net book value of the asset, calculated as original cost minus accumulated depreciation. Represents the carrying value of the asset on the utility\'s balance sheet and is the primary basis for rate base inclusion in cost-of-service rate cases. Denominated in USD. Note: while derivable, this field is stored for performance and regulatory reporting efficiency.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netSalvageRate rdf:type rdf:Property ;
    rdfs:label 'Net Salvage Rate' ;
    rdfs:comment 'The net salvage rate applied to this asset class in the depreciation study, expressed as a decimal. Net salvage equals gross salvage proceeds minus cost of removal. For utility assets, net salvage is frequently negative (negative salvage) because cost of removal (e.g., pole removal, underground cable excavation, gas main abandonment) exceeds any scrap value. Negative salvage rates increase the depreciable base and are a critical input unique to utility depreciation studies.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:retirementType rdf:type rdf:Property ;
    rdfs:label 'Retirement Type' ;
    rdfs:comment 'Classification of the asset retirement event. \'normal\' retirements are expected end-of-life removals consistent with the depreciation study survivor curve. \'abnormal\' retirements are premature removals due to accidents, storms, or regulatory mandates. \'extraordinary\' retirements involve large-scale plant abandonments. Classification affects regulatory accounting treatment and potential regulatory asset recovery.' ;
    rdfs:domain ind:FixedAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:utilityType rdf:type rdf:Property ;
    rdfs:label 'Utility Type' ;
    rdfs:comment 'Identifies whether the asset belongs to the electric utility plant, gas utility plant, common plant (shared between electric and gas), or other. Critical for cost-of-service allocation studies in rate cases filed with state PUCs and FERC.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vintageYear rdf:type rdf:Property ;
    rdfs:label 'Vintage Year' ;
    rdfs:comment 'The year in which the asset was originally constructed or manufactured. Critical input for group/composite depreciation studies unique to the utility industry, where survivor curve analysis and Iowa Curve fitting require age distribution data by vintage year. Used in FERC-approved depreciation studies and PUC rate case filings.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:accountDescription rdf:type rdf:Property ;
    rdfs:label 'Account Description' ;
    rdfs:comment 'Extended narrative description of the GL account\'s purpose, the types of transactions posted to it, and any special accounting treatment required. Provides guidance to accountants and auditors on proper account usage. Sourced from the SAP S/4HANA or Oracle ERP Cloud account master long text field.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountGroup rdf:type rdf:Property ;
    rdfs:label 'Account Group' ;
    rdfs:comment 'The account group in SAP S/4HANA or Oracle ERP Cloud that controls the number range and field selection for this GL account (e.g., \'UTIL_PLANT\' for utility plant accounts, \'OPEX\' for operating expense accounts, \'REVENUE\' for revenue accounts). Used in chart-of-accounts governance and ERP configuration management.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountName rdf:type rdf:Property ;
    rdfs:label 'Account Name' ;
    rdfs:comment 'The official descriptive name of the GL account as defined in the chart of accounts (e.g., \'Electric Plant in Service\', \'Miscellaneous Intangible Plant\', \'Operation and Maintenance Expense\'). Used in financial statements, rate case filings, and FERC Form 1/2 schedules.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountShortName rdf:type rdf:Property ;
    rdfs:label 'Account Short Name' ;
    rdfs:comment 'Abbreviated display name for the GL account used in reports, dashboards, and ERP screen labels where space is limited. Sourced from the SAP S/4HANA or Oracle ERP Cloud short description field on the chart of accounts master.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountSubtype rdf:type rdf:Property ;
    rdfs:label 'Account Subtype' ;
    rdfs:comment 'Secondary classification within the account_type that provides finer segmentation for financial reporting (e.g., \'current asset\', \'non-current asset\', \'operating revenue\', \'non-operating expense\', \'long-term liability\', \'retained earnings\'). Used in GAAP balance sheet and income statement sub-classifications. [ENUM-REF-CANDIDATE: current_asset|non_current_asset|current_liability|non_current_liability|operating_revenue|non_operating_revenue|operating_expense|non_operating_expense|retained_earnings|paid_in_capital — promote to reference product]' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chartOfAccountsCode rdf:type rdf:Property ;
    rdfs:label 'Chart Of Accounts Code' ;
    rdfs:comment 'The chart-of-accounts identifier in SAP S/4HANA or Oracle ERP Cloud to which this GL account belongs (e.g., \'UTIL\' for the utility operating company chart, \'CORP\' for the corporate holding company chart). Supports multi-entity financial consolidation and intercompany eliminations.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ciacAccountFlag rdf:type rdf:Property ;
    rdfs:label 'Ciac Account Flag' ;
    rdfs:comment 'Indicates whether this GL account records Contributions in Aid of Construction (CIAC) — cash or property contributed by customers or developers to fund utility infrastructure extensions. CIAC reduces rate base and is tracked separately per FERC USoA Account 271 and state PUC requirements.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:costElementCategory rdf:type rdf:Property ;
    rdfs:label 'Cost Element Category' ;
    rdfs:comment 'The SAP Controlling (CO) cost element category assigned to this GL account, indicating how costs flow through the cost accounting module. Primary cost elements represent costs originating from Financial Accounting (FI); secondary cost elements represent internal allocations and settlements. Used in O&M cost allocation studies for rate cases.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deactivationDate rdf:type rdf:Property ;
    rdfs:label 'Deactivation Date' ;
    rdfs:comment 'The date on which this GL account was deactivated and made unavailable for new journal entry postings. Null for currently active accounts. Historical balances remain accessible for reporting after deactivation. Used in chart-of-accounts governance and period-end close validation.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:depreciationAccountFlag rdf:type rdf:Property ;
    rdfs:label 'Depreciation Account Flag' ;
    rdfs:comment 'Indicates whether this GL account is an accumulated depreciation or depreciation expense account. True for FERC accounts 108 (Accumulated Provision for Depreciation of Electric Utility Plant) and equivalent gas accounts. Used to identify accounts included in depreciation rate studies filed with state PUCs.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fercAccountDescription rdf:type rdf:Property ;
    rdfs:label 'Ferc Account Description' ;
    rdfs:comment 'The official FERC USoA description for the mapped FERC account code. Provides the regulatory definition of allowable charges to this account as prescribed by FERC 18 CFR Parts 101 and 201. Used in rate case cost-of-service studies and FERC Form 1/2 narrative disclosures.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fercFormReference rdf:type rdf:Property ;
    rdfs:label 'Ferc Form Reference' ;
    rdfs:comment 'Identifies which FERC annual report form this account populates: FERC Form 1 (Major Electric Utilities), FERC Form 2 (Major Natural Gas Companies), FERC Form 1-F (Non-Major Electric Utilities), both (for common accounts), or not_applicable for accounts not reported to FERC. Drives automated FERC regulatory reporting extraction.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:financialStatementVersion rdf:type rdf:Property ;
    rdfs:label 'Financial Statement Version' ;
    rdfs:comment 'The financial statement version (FSV) code in SAP S/4HANA or Oracle ERP Cloud that governs how this account is presented in GAAP financial statements (e.g., \'GAAP_UTIL\' for GAAP utility financial statements, \'FERC_F1\' for FERC Form 1 reporting). Supports multi-GAAP and regulatory reporting from a single chart of accounts.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gaapClassification rdf:type rdf:Property ;
    rdfs:label 'Gaap Classification' ;
    rdfs:comment 'The GAAP financial statement line-item classification for this account (e.g., \'Utility Plant\', \'Accumulated Depreciation\', \'Long-Term Debt\', \'Operating Revenues – Electric\', \'Operation Expense – Fuel\'). Maps the account to the specific line in GAAP-compliant financial statements filed with the SEC and state PUCs. [ENUM-REF-CANDIDATE: utility_plant|accumulated_depreciation|regulatory_asset|regulatory_liability|operating_revenue|operation_expense|maintenance_expense|depreciation_expense|income_tax|long_term_debt|common_equity — promote to reference product]' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incomeTaxAccountFlag rdf:type rdf:Property ;
    rdfs:label 'Income Tax Account Flag' ;
    rdfs:comment 'Indicates whether this GL account is an income tax account (current or deferred). True for FERC accounts 408 (Taxes Other Than Income Taxes), 409 (Income Taxes), 410/411 (Deferred Income Taxes). Used in SOX tax provision controls and rate case income tax normalization studies.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lineItemDisplay rdf:type rdf:Property ;
    rdfs:label 'Line Item Display' ;
    rdfs:comment 'Indicates whether individual line items posted to this GL account are stored and displayable in the ERP system for audit and drill-down purposes. When True, auditors and financial analysts can view each individual posting. Required for SOX audit trail completeness on high-risk accounts.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:normalBalance rdf:type rdf:Property ;
    rdfs:label 'Normal Balance' ;
    rdfs:comment 'Indicates whether the account\'s normal (expected) balance is a debit or credit per double-entry bookkeeping rules. Assets and expenses carry a debit normal balance; liabilities, equity, and revenues carry a credit normal balance. Used by the ERP posting engine to detect out-of-balance conditions and in SOX journal entry controls.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:openItemManagement rdf:type rdf:Property ;
    rdfs:label 'Open Item Management' ;
    rdfs:comment 'Indicates whether this GL account uses open item management in SAP S/4HANA or Oracle ERP Cloud, meaning individual line items remain open until cleared by a matching offsetting entry. Typically enabled for clearing accounts, bank accounts, and GR/IR (Goods Receipt/Invoice Receipt) accounts. Supports accounts receivable and accounts payable reconciliation.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:parentAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Parent Account Number' ;
    rdfs:comment 'The account number of the parent/summary GL account in the chart-of-accounts hierarchy. Enables roll-up of detailed accounts into summary accounts for financial statement presentation and FERC Form 1/2 schedule aggregation. Null for top-level summary accounts.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:plantAccountFlag rdf:type rdf:Property ;
    rdfs:label 'Plant Account Flag' ;
    rdfs:comment 'Indicates whether this GL account is a utility plant account subject to FERC plant-in-service reporting, depreciation schedules, and rate base inclusion. True for accounts in the FERC 100-series (Electric Plant) and 200-series (Gas Plant). Used to filter accounts for AFUDC capitalization and depreciation rate studies.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:postingAllowed rdf:type rdf:Property ;
    rdfs:label 'Posting Allowed' ;
    rdfs:comment 'Indicates whether direct journal entry postings are permitted to this GL account. False for summary/group accounts that only aggregate child accounts and do not accept direct postings. Sourced from the SAP S/4HANA account master \'Post Automatically Only\' or Oracle ERP Cloud \'Allow Posting\' flag.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rateBaseEligible rdf:type rdf:Property ;
    rdfs:label 'Rate Base Eligible' ;
    rdfs:comment 'Indicates whether balances in this GL account are eligible for inclusion in the utility\'s rate base for rate case cost-of-service studies filed with FERC or state PUCs. Rate base typically includes net utility plant in service, working capital allowances, and regulatory assets. Used in PBR and traditional cost-of-service rate case models.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reconciliationAccountFlag rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Account Flag' ;
    rdfs:comment 'Indicates whether this GL account is a reconciliation account (subledger control account) in SAP S/4HANA, meaning postings are made automatically from subledger modules (Accounts Receivable, Accounts Payable, Asset Accounting) and direct manual postings are restricted. Critical for SOX subledger-to-general-ledger reconciliation controls.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryAssetLiabilityFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Asset Liability Flag' ;
    rdfs:comment 'Indicates whether this GL account represents a regulatory asset or regulatory liability recognized under GAAP ASC 980 (Regulated Operations). Regulatory assets/liabilities arise from rate-regulated accounting deferrals approved by FERC or state PUCs (e.g., deferred fuel costs, storm damage deferrals, pension regulatory assets).' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sourceSystemAccountCode rdf:type rdf:Property ;
    rdfs:label 'Source System Account Code' ;
    rdfs:comment 'The native account identifier as stored in the originating ERP system (SAP S/4HANA GL account number or Oracle ERP Cloud natural account segment value). Enables traceability from the Databricks Silver Layer record back to the source system for reconciliation and audit purposes.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxCategory rdf:type rdf:Property ;
    rdfs:label 'Tax Category' ;
    rdfs:comment 'The tax relevance category for this GL account in the ERP system, indicating whether the account is subject to sales/use tax, gross receipts tax, or is tax-exempt. Used in automated tax determination during invoice processing and in state PUC gross receipts tax reporting. [ENUM-REF-CANDIDATE: taxable_input|taxable_output|exempt|not_relevant — promote to reference product]' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:utilityFunction rdf:type rdf:Property ;
    rdfs:label 'Utility Function' ;
    rdfs:comment 'Identifies whether the GL account is associated with the electric utility function, gas utility function, common/shared services, or other non-utility operations. Critical for cost-of-service studies in rate cases, FERC Form 1 (electric) vs. FERC Form 2 (gas) filing segregation, and state PUC jurisdictional separation of revenues and expenses.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wipAccountFlag rdf:type rdf:Property ;
    rdfs:label 'Wip Account Flag' ;
    rdfs:comment 'Indicates whether this GL account is a Work in Progress (WIP) / Construction Work in Progress (CWIP) account (FERC Account 107 – Construction Work in Progress – Electric, or equivalent gas account). WIP accounts accumulate capital project costs before transfer to plant-in-service upon project completion. Used in AFUDC calculation and capital project tracking.' ;
    rdfs:domain ind:GlAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recurringTemplateId rdf:type rdf:Property ;
    rdfs:label 'Recurring Template Id' ;
    rdfs:comment 'Identifier of the recurring entry template in the ERP system that generated this journal entry. Populated only when is_recurring = True. Enables traceability from posted entries back to the template for maintenance and audit purposes.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:JournalEntryTemplate .

ind:wbsElementId rdf:type rdf:Property ;
    rdfs:label 'Wbs Element Id' ;
    rdfs:comment 'Reference to the Work Breakdown Structure element for CAPEX project postings. Links journal entries to capital projects for AFUDC calculation, WIP tracking, and asset capitalization. Populated for capital expenditure entries; null for OPEX entries. Supports FERC CIAC and AFUDC regulatory accounting.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WbsElement .

ind:approverUserCode rdf:type rdf:Property ;
    rdfs:label 'Approver User Code' ;
    rdfs:comment 'ERP system user ID of the individual who approved this journal entry under the dual-approval SOX control framework. Distinct from posting_user_id to enforce segregation of duties. Null when approval is not required or entry is pending approval.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentNumber rdf:type rdf:Property ;
    rdfs:label 'Assignment Number' ;
    rdfs:comment 'Alphanumeric assignment field used for sorting and grouping journal entries in account line item displays and financial reports. Often populated with a customer account number, asset number, or billing period for quick identification. Corresponds to ZUONR in SAP FI.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clearingDate rdf:type rdf:Property ;
    rdfs:label 'Clearing Date' ;
    rdfs:comment 'The date on which open items in this journal entry were cleared (matched and closed) against a payment or offsetting document. Populated when posting_status = cleared. Used for aging analysis and cash flow reporting.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:clearingDocumentNumber rdf:type rdf:Property ;
    rdfs:label 'Clearing Document Number' ;
    rdfs:comment 'Document number of the clearing entry that matched and closed open items associated with this journal entry (e.g., payment clearing against an invoice). Populated when posting_status = cleared. Supports accounts receivable and accounts payable reconciliation.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentDate rdf:type rdf:Property ;
    rdfs:label 'Document Date' ;
    rdfs:comment 'The date of the original business transaction or source document (e.g., invoice date, contract date) that triggered this journal entry. May differ from posting_date for accruals or late postings. Corresponds to BLDAT in SAP FI.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:documentNumber rdf:type rdf:Property ;
    rdfs:label 'Document Number' ;
    rdfs:comment 'Externally-known alphanumeric document number assigned by the ERP system (SAP S/4HANA or Oracle ERP Cloud) at the time of posting. Used by accountants and auditors to locate and reference a specific journal entry. Corresponds to BELNR in SAP FI or Document Number in Oracle GL.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentTypeCode rdf:type rdf:Property ;
    rdfs:label 'Document Type Code' ;
    rdfs:comment 'Two-character ERP document type code that classifies the nature of the journal entry (e.g., SA=General Ledger, AA=Asset Posting, KR=Vendor Invoice, DR=Customer Invoice, AB=Accounting Document, ZP=Payment Clearing). Controls number range assignment and account type permissibility. Corresponds to BLART in SAP FI. [ENUM-REF-CANDIDATE: SA|AA|KR|DR|AB|ZP|RV|WA|ML|RE — promote to reference product]' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entryTimestamp rdf:type rdf:Property ;
    rdfs:label 'Entry Timestamp' ;
    rdfs:comment 'The system timestamp when this journal entry record was first created in the ERP system. Used for SOX audit trail and segregation-of-duties reporting. Represents RECORD_AUDIT_CREATED per canonical attribute requirements.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:entryType rdf:type rdf:Property ;
    rdfs:label 'Entry Type' ;
    rdfs:comment 'Business classification of the journal entry indicating its functional purpose: standard (normal operational posting), accrual (period-end estimate), reversal (correction of prior entry), intercompany (cross-entity elimination), recurring (template-based periodic posting), or statistical (non-financial cost allocation). Drives GAAP presentation and FERC regulatory accounting treatment.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:functionalAreaCode rdf:type rdf:Property ;
    rdfs:label 'Functional Area Code' ;
    rdfs:comment 'Code identifying the utility functional area to which this journal entry is attributed for cost-of-service and rate case analysis: GEN (Generation), TRN (Transmission), DST (Electric Distribution), GAS (Gas Distribution), CUS (Customer Service), ADM (Administrative and General), REG (Regulatory), FIN (Finance). Supports FERC jurisdictional cost separation and PUC rate case filings. [ENUM-REF-CANDIDATE: GEN|TRN|DST|GAS|CUS|ADM|REG|FIN — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:headerText rdf:type rdf:Property ;
    rdfs:label 'Header Text' ;
    rdfs:comment 'Free-text description of the journal entry provided by the posting user, summarizing the business purpose or nature of the transaction (e.g., \'Q3 2024 Transmission Line Depreciation Accrual\', \'October AMI Meter Installation CAPEX\'). Used for search, audit review, and financial reporting narrative. Corresponds to BKTXT in SAP FI.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isIntercompany rdf:type rdf:Property ;
    rdfs:label 'Is Intercompany' ;
    rdfs:comment 'Flag indicating whether this journal entry involves a transaction between two legal entities within the utility holding company structure (e.g., electric subsidiary billing gas subsidiary for shared services). True for intercompany entries requiring elimination in consolidated financial statements per GAAP ASC 810.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRecurring rdf:type rdf:Property ;
    rdfs:label 'Is Recurring' ;
    rdfs:comment 'Flag indicating whether this journal entry was generated from a recurring entry template (e.g., monthly depreciation, lease accruals, fixed O&M allocations). True when generated from a recurring template; False for manually created entries. Supports automated period-close processes.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isReversed rdf:type rdf:Property ;
    rdfs:label 'Is Reversed' ;
    rdfs:comment 'Flag indicating whether this journal entry has been reversed by a subsequent offsetting entry. True when a reversal document exists; False otherwise. Used to exclude reversed entries from financial statement balances and to identify correction activity for SOX audit purposes.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ledgerCode rdf:type rdf:Property ;
    rdfs:label 'Ledger Code' ;
    rdfs:comment 'Identifier for the accounting ledger in which this entry is recorded. In SAP S/4HANA Universal Journal, 0L is the leading ledger (GAAP), while parallel ledgers (1L, 2L) may capture FERC regulatory accounting or IFRS. Ensures correct financial statement presentation per applicable accounting framework.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lineItemCount rdf:type rdf:Property ;
    rdfs:label 'Line Item Count' ;
    rdfs:comment 'Total number of journal entry line items (debit and credit legs) associated with this header record. Used for data completeness validation, balanced-entry checks, and identifying complex multi-line entries requiring additional review. Supports SOX control monitoring.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:localCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Local Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter code for the company code local currency (functional currency) in which amounts are also recorded. Supports multi-currency translation for consolidated GAAP financial statements and FERC Form 1 reporting. Corresponds to WAERS for local currency in SAP FI.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postingStatus rdf:type rdf:Property ;
    rdfs:label 'Posting Status' ;
    rdfs:comment 'Current lifecycle state of the journal entry in the ERP workflow: draft (in preparation), parked (saved but not posted), held (temporarily suspended), posted (committed to GL), reversed (offset entry created), or cleared (open items matched). Supports SOX period-close controls and dual-approval enforcement.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postingUserCode rdf:type rdf:Property ;
    rdfs:label 'Posting User Code' ;
    rdfs:comment 'ERP system user ID of the individual who created and posted this journal entry. Essential for SOX segregation-of-duties controls, audit trail completeness, and detection of unauthorized postings. Corresponds to USNAM in SAP FI.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referenceDocumentNumber rdf:type rdf:Property ;
    rdfs:label 'Reference Document Number' ;
    rdfs:comment 'External reference number linking this journal entry to the originating business document (e.g., vendor invoice number, purchase order number, work order number, billing document number, rate case docket number). Enables drill-through from GL to source transaction for audit and reconciliation. Corresponds to XBLNR in SAP FI.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceModule rdf:type rdf:Property ;
    rdfs:label 'Source Module' ;
    rdfs:comment 'The ERP functional module that originated this journal entry: FI (Financial Accounting), CO (Controlling/Cost Accounting), MM (Materials Management), PM (Plant Maintenance/Asset Management), SD (Sales and Distribution), PS (Project System for CAPEX/WIP), HR (Human Resources), RE (Real Estate). Supports cross-module reconciliation and FERC cost-of-service allocation. [ENUM-REF-CANDIDATE: FI|CO|MM|PM|SD|PS|HR|RE — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalCreditAmount rdf:type rdf:Property ;
    rdfs:label 'Total Credit Amount' ;
    rdfs:comment 'Sum of all credit line item amounts for this journal entry in the transaction currency. Must equal total_debit_amount for a balanced entry per double-entry bookkeeping. Used for balanced-entry validation, GAAP financial statement preparation, and FERC regulatory reporting.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalCreditAmountLocal rdf:type rdf:Property ;
    rdfs:label 'Total Credit Amount Local' ;
    rdfs:comment 'Sum of all credit line item amounts translated into the company code local currency (functional currency). Used for domestic financial statement preparation and FERC regulatory reporting when transaction currency differs from local currency.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalDebitAmount rdf:type rdf:Property ;
    rdfs:label 'Total Debit Amount' ;
    rdfs:comment 'Sum of all debit line item amounts for this journal entry in the transaction currency. Must equal total_credit_amount for a balanced entry per double-entry bookkeeping. Used for balanced-entry validation, GAAP financial statement preparation, and FERC regulatory reporting.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalDebitAmountLocal rdf:type rdf:Property ;
    rdfs:label 'Total Debit Amount Local' ;
    rdfs:comment 'Sum of all debit line item amounts translated into the company code local currency (functional currency). Used for domestic financial statement preparation and FERC regulatory reporting when transaction currency differs from local currency.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tradingPartnerCode rdf:type rdf:Property ;
    rdfs:label 'Trading Partner Code' ;
    rdfs:comment 'Company code of the intercompany trading partner entity involved in this journal entry. Populated only when is_intercompany = True. Used for intercompany reconciliation and elimination in consolidated GAAP financial statements. Corresponds to VBUND in SAP FI.' ;
    rdfs:domain ind:JournalEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:journalEntryLineId rdf:type rdf:Property ;
    rdfs:label 'Journal Entry Line Id' ;
    rdfs:comment 'Unique surrogate identifier for each journal entry line item in the general ledger. Primary key for this record in the Silver Layer lakehouse.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:amountCompanyCurrency rdf:type rdf:Property ;
    rdfs:label 'Amount Company Currency' ;
    rdfs:comment 'The monetary amount of this line item translated into the company code\'s local currency (e.g., USD). Used for consolidated financial statements, FERC reporting, and SOX-compliant audit trails. Corresponds to SAP BSEG-DMBTR.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:amountTransactionCurrency rdf:type rdf:Property ;
    rdfs:label 'Amount Transaction Currency' ;
    rdfs:comment 'The monetary amount of this line item expressed in the transaction currency. Positive for debits, negative for credits (or vice versa per system convention). Corresponds to SAP BSEG-WRBTR.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:businessAreaCode rdf:type rdf:Property ;
    rdfs:label 'Business Area Code' ;
    rdfs:comment 'SAP business area for cross-company-code segment reporting, enabling balance sheet and P&L reporting by business segment (e.g., electric utility, gas utility, unregulated). Corresponds to SAP BSEG-GSBER.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:companyCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Company Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code of the company code\'s local currency (typically USD for US utilities). Used for consolidated financial reporting. Corresponds to SAP BSEG-PSWSL.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerNumber rdf:type rdf:Property ;
    rdfs:label 'Customer Number' ;
    rdfs:comment 'SAP customer (debtor) account number when this line item relates to a customer receivable posting (e.g., utility bill revenue recognition). Links to the accounts receivable subledger. Corresponds to SAP BSEG-KUNNR.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:debitCreditIndicator rdf:type rdf:Property ;
    rdfs:label 'Debit Credit Indicator' ;
    rdfs:comment 'Indicates whether this line item is a debit (D) or credit (C) posting to the GL account. Fundamental to double-entry bookkeeping and ensures journal entry balance. Corresponds to SAP BSEG-SHKZG.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lineItemText rdf:type rdf:Property ;
    rdfs:label 'Line Item Text' ;
    rdfs:comment 'Free-text description of this individual posting line providing context for the transaction (e.g., \'Q3 fuel adjustment accrual\', \'Substation transformer replacement CAPEX\'). Supports SOX audit trail and financial statement footnote preparation. Corresponds to SAP BSEG-SGTXT.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:openItemIndicator rdf:type rdf:Property ;
    rdfs:label 'Open Item Indicator' ;
    rdfs:comment 'Indicates whether this line item remains open (uncleared) in the GL. True = open item pending clearing; False = item has been cleared. Drives accounts receivable/payable aging reports and collections workflows.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:orderNumber rdf:type rdf:Property ;
    rdfs:label 'Order Number' ;
    rdfs:comment 'SAP internal order number for overhead cost collection, capital investment orders, or maintenance orders. Used to accumulate costs for specific projects or activities before settlement to cost centers or WBS elements. Corresponds to SAP BSEG-AUFNR.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postingKey rdf:type rdf:Property ;
    rdfs:label 'Posting Key' ;
    rdfs:comment 'Two-digit SAP posting key that determines the account type, debit/credit side, and field status for this line item (e.g., 40=GL debit, 50=GL credit, 01=customer invoice, 31=vendor invoice). Corresponds to SAP BSEG-BSCHL.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quantityUnit rdf:type rdf:Property ;
    rdfs:label 'Quantity Unit' ;
    rdfs:comment 'Unit of measure for the quantity field (e.g., MWh for energy, MCF for gas, EA for each/count, HR for hours). Aligns with utility industry standard units for energy and gas accounting. Corresponds to SAP BSEG-MEINS. [ENUM-REF-CANDIDATE: MWh|kWh|MCF|Therm|MW|kW|EA|HR|M3|GJ — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reversalIndicator rdf:type rdf:Property ;
    rdfs:label 'Reversal Indicator' ;
    rdfs:comment 'Indicates whether this line item is part of a reversal document (True) or an original posting (False). Reversal entries are critical for period-end accrual management and SOX audit trail integrity.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sourceLedgerCode rdf:type rdf:Property ;
    rdfs:label 'Source Ledger Code' ;
    rdfs:comment 'Identifies the source ledger or subledger from which this posting originated (e.g., 0L=Leading Ledger, 2L=IFRS Ledger, US=US GAAP Ledger). Supports parallel accounting for GAAP and regulatory reporting. Corresponds to SAP BSEG-RLDNR.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialGlIndicator rdf:type rdf:Property ;
    rdfs:label 'Special Gl Indicator' ;
    rdfs:comment 'SAP special GL indicator identifying non-standard postings such as down payments (A), guarantees (B), or bill of exchange (W). Used to segregate special transactions in balance sheet reporting. Corresponds to SAP BSEG-UMSKZ.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxCode rdf:type rdf:Property ;
    rdfs:label 'Tax Code' ;
    rdfs:comment 'Tax code assigned to this line item determining applicable tax rates and tax account postings (e.g., sales tax, use tax, gross receipts tax). Required for tax compliance reporting and regulatory filings. Corresponds to SAP BSEG-MWSKZ.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Transaction Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code of the original transaction (e.g., USD for domestic, CAD for cross-border Canadian operations). Corresponds to SAP BSEG-WAERS.' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorNumber rdf:type rdf:Property ;
    rdfs:label 'Vendor Number' ;
    rdfs:comment 'SAP vendor (creditor) account number when this line item relates to a vendor payable posting. Links to the accounts payable subledger for vendor balance and aging reporting. Corresponds to SAP BSEG-LIFNR.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wbsElementCode rdf:type rdf:Property ;
    rdfs:label 'Wbs Element Code' ;
    rdfs:comment 'Project WBS element code for CAPEX postings, enabling capital project cost tracking, AFUDC calculation, and WIP balance management. Critical for utility plant accounting and rate base determination. Corresponds to SAP BSEG-PS_PSP_PNR (WBS Element).' ;
    rdfs:domain ind:JournalEntryLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employeeCode rdf:type rdf:Property ;
    rdfs:label 'Employee Code' ;
    rdfs:comment 'Reference to the employee associated with this OPEX transaction, applicable for labor cost postings (direct labor, overtime, benefits allocations) originating from the payroll system (SuccessFactors or Workday). Null for non-labor transactions such as vendor invoices or fuel purchases.' ;
    rdfs:domain ind:OpexTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:expenseCategory rdf:type rdf:Property ;
    rdfs:label 'Expense Category' ;
    rdfs:comment 'High-level classification of the operating expenditure type. Categories align with standard O&M cost-of-service study breakdowns used in rate case filings before state Public Utility Commissions (PUCs) and FERC. Labor includes direct and indirect employee costs; contractor_services covers third-party O&M contracts; fuel covers FAC-eligible fuel costs.' ;
    rdfs:domain ind:OpexTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isCapexReclassified rdf:type rdf:Property ;
    rdfs:label 'Is Capex Reclassified' ;
    rdfs:comment 'Indicates whether this transaction was initially posted as OPEX but subsequently reclassified as a capital expenditure (CAPEX) following engineering or accounting review. OPEX-to-CAPEX reclassifications are common in utility accounting and are subject to regulatory scrutiny in rate cases.' ;
    rdfs:domain ind:OpexTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isFacEligible rdf:type rdf:Property ;
    rdfs:label 'Is Fac Eligible' ;
    rdfs:comment 'Indicates whether this OPEX transaction represents a fuel cost eligible for recovery through the Fuel Adjustment Clause (FAC) mechanism. FAC-eligible costs (e.g., natural gas, coal, nuclear fuel purchases) are tracked separately for regulatory pass-through rate adjustments filed with state PUCs.' ;
    rdfs:domain ind:OpexTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRateCaseIncludable rdf:type rdf:Property ;
    rdfs:label 'Is Rate Case Includable' ;
    rdfs:comment 'Indicates whether this OPEX transaction is includable in the utility\'s rate case cost-of-service study as a recoverable O&M expense. Transactions flagged as non-includable (e.g., lobbying costs, penalties, shareholder expenses) are excluded from the revenue requirement calculation per PUC and FERC guidelines.' ;
    rdfs:domain ind:OpexTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:originalTransactionNumber rdf:type rdf:Property ;
    rdfs:label 'Original Transaction Number' ;
    rdfs:comment 'For reversal or correcting entries, the transaction_number of the original OPEX transaction being reversed or corrected. Enables audit trail linkage between original postings and their reversals. Null for original (non-reversal) transactions.' ;
    rdfs:domain ind:OpexTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overheadAllocationAmount rdf:type rdf:Property ;
    rdfs:label 'Overhead Allocation Amount' ;
    rdfs:comment 'Dollar amount of indirect overhead costs allocated to this OPEX transaction using the utility\'s cost allocation methodology (e.g., labor-hour basis, direct-cost basis). Overhead allocations are scrutinized in rate case cost-of-service studies to ensure only appropriate costs are included in revenue requirement calculations.' ;
    rdfs:domain ind:OpexTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:projectCode rdf:type rdf:Property ;
    rdfs:label 'Project Code' ;
    rdfs:comment 'Internal project or WBS (Work Breakdown Structure) code from the ERP system to which this OPEX transaction is charged. Used for project-level O&M cost tracking, particularly for multi-year maintenance programs, storm restoration activities, and demand-side management (DSM) program cost tracking.' ;
    rdfs:domain ind:OpexTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceDocumentType rdf:type rdf:Property ;
    rdfs:label 'Source Document Type' ;
    rdfs:comment 'Classification of the originating document type that generated this OPEX transaction in the ERP system. Distinguishes between vendor invoices, manual journal entries, period-end accruals, payroll cost allocations, intercompany charges, and goods receipts. Used for financial audit and SOX controls testing.' ;
    rdfs:domain ind:OpexTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionAmount rdf:type rdf:Property ;
    rdfs:label 'Transaction Amount' ;
    rdfs:comment 'Gross base amount of the operating expenditure in the transaction currency before any adjustments, discounts, or overhead allocations. Represents the raw O&M cost posted to the general ledger. Used for OPEX budget variance analysis and FERC O&M expense reporting.' ;
    rdfs:domain ind:OpexTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transactionDate rdf:type rdf:Property ;
    rdfs:label 'Transaction Date' ;
    rdfs:comment 'The principal real-world business event date on which the operating expenditure was incurred or the cost was recognized. Used for period-end accruals, FERC O&M expense reporting, and rate case cost-of-service study period alignment.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:transactionDescription rdf:type rdf:Property ;
    rdfs:label 'Transaction Description' ;
    rdfs:comment 'Free-text description of the operating expenditure as entered in the ERP system (SAP S/4HANA or Oracle ERP Cloud). Provides context for the nature of the O&M cost, such as \'Turbine blade inspection labor - Unit 3\' or \'Natural gas fuel purchase - Peaker Plant\'. Used in audit reviews and rate case cost justification.' ;
    rdfs:domain ind:OpexTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionNumber rdf:type rdf:Property ;
    rdfs:label 'Transaction Number' ;
    rdfs:comment 'Externally-known business identifier for the OPEX transaction as assigned by the ERP system (SAP S/4HANA or Oracle ERP Cloud). Corresponds to the document number or journal entry number used in financial reporting and audit trails. Supports FERC Form 1/2 O&M expense reconciliation.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorInvoiceNumber rdf:type rdf:Property ;
    rdfs:label 'Vendor Invoice Number' ;
    rdfs:comment 'The invoice number provided by the vendor or contractor for this OPEX transaction. Used for three-way match (PO, goods receipt, invoice) in the procure-to-pay process and for SOX accounts payable controls. Enables traceability from the general ledger entry back to the source vendor document.' ;
    rdfs:domain ind:OpexTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allowedRoePercent rdf:type rdf:Property ;
    rdfs:label 'Allowed Roe Percent' ;
    rdfs:comment 'Regulatory-approved return on equity percentage for this profit center as determined in the most recent rate case or FERC order. Used to calculate the allowed return component in cost-of-service studies and PBR performance tracking.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:businessSegment rdf:type rdf:Property ;
    rdfs:label 'Business Segment' ;
    rdfs:comment 'Regulatory and operational business segment to which this profit center belongs. Drives FERC-required segment reporting and ROE/ROI analysis by business unit. Values align with the utility\'s FERC Form 1 and state PUC segment reporting requirements: electric_generation, electric_transmission, electric_distribution, gas_distribution, unregulated.' ;
    rdfs:domain ind:ProfitCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capexBudgetUsd rdf:type rdf:Property ;
    rdfs:label 'Capex Budget Usd' ;
    rdfs:comment 'Approved annual capital expenditure budget allocated to this profit center in US dollars. Used for CAPEX tracking, rate base calculations, and AFUDC (Allowance for Funds Used During Construction) accruals in regulatory accounting.' ;
    rdfs:domain ind:ProfitCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ciacEligible rdf:type rdf:Property ;
    rdfs:label 'Ciac Eligible' ;
    rdfs:comment 'Indicates whether this profit center is eligible to receive Contributions in Aid of Construction (CIAC) from customers or developers. CIAC receipts reduce rate base and are tracked separately per FERC Account 271 and state PUC requirements.' ;
    rdfs:domain ind:ProfitCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:controllingAreaCode rdf:type rdf:Property ;
    rdfs:label 'Controlling Area Code' ;
    rdfs:comment 'SAP Controlling Area (KOKRS) to which this profit center belongs. Defines the organizational unit within which cost and profit accounting is performed. All profit centers within a controlling area share the same fiscal year variant and currency.' ;
    rdfs:domain ind:ProfitCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costCenterAssignment rdf:type rdf:Property ;
    rdfs:label 'Cost Center Assignment' ;
    rdfs:comment 'Default cost center code associated with this profit center for overhead allocation and cost-of-service studies. Used in rate case preparation to allocate shared costs between regulated business segments per FERC and PUC requirements.' ;
    rdfs:domain ind:ProfitCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fercAccountClass rdf:type rdf:Property ;
    rdfs:label 'Ferc Account Class' ;
    rdfs:comment 'FERC Uniform System of Accounts classification associated with this profit center (e.g., Electric Plant in Service accounts 301-399, Gas Plant accounts 101-199). Drives regulatory financial reporting on FERC Form 1 and Form 2.' ;
    rdfs:domain ind:ProfitCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:glAccountAssignmentGroup rdf:type rdf:Property ;
    rdfs:label 'Gl Account Assignment Group' ;
    rdfs:comment 'GL account assignment group that governs automatic account determination for revenue and cost postings to this profit center. Ensures correct FERC account mapping for regulated utility accounting.' ;
    rdfs:domain ind:ProfitCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hierarchyNode rdf:type rdf:Property ;
    rdfs:label 'Hierarchy Node' ;
    rdfs:comment 'Node identifier within the SAP profit center standard hierarchy (SETCLASS 0106) to which this profit center is assigned. Enables roll-up reporting across organizational levels for EBITDA and segment reporting.' ;
    rdfs:domain ind:ProfitCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:intercompanyEliminationFlag rdf:type rdf:Property ;
    rdfs:label 'Intercompany Elimination Flag' ;
    rdfs:comment 'Indicates whether transactions posted to this profit center are subject to intercompany elimination in consolidated financial statements. Critical for SOX-compliant consolidation and FERC affiliate transaction reporting.' ;
    rdfs:domain ind:ProfitCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nercRegion rdf:type rdf:Property ;
    rdfs:label 'Nerc Region' ;
    rdfs:comment 'NERC reliability region (e.g., WECC, SERC, RFC, MRO) associated with this profit center\'s electric operations. Used for NERC compliance reporting and bulk electric system (BES) reliability cost allocation.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:opexBudgetUsd rdf:type rdf:Property ;
    rdfs:label 'Opex Budget Usd' ;
    rdfs:comment 'Approved annual operating expenditure budget allocated to this profit center in US dollars. Supports O&M cost tracking, rate case cost-of-service studies, and EBITDA reporting by segment.' ;
    rdfs:domain ind:ProfitCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:plantLocationCode rdf:type rdf:Property ;
    rdfs:label 'Plant Location Code' ;
    rdfs:comment 'Geographic or operational location code associated with this profit center, linking it to a specific generation plant, transmission substation, distribution district, or gas service territory. Used in GIS-integrated financial analysis and asset management reporting.' ;
    rdfs:domain ind:ProfitCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:profitCenterCode rdf:type rdf:Property ;
    rdfs:label 'Profit Center Code' ;
    rdfs:comment 'Externally-known alphanumeric code that uniquely identifies the profit center within the SAP S/4HANA Controlling (CO-PCA) module. Used in journal entries, cost allocations, and regulatory segment reports. Corresponds to the PRCTR field in SAP table CEPC.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:profitCenterGroup rdf:type rdf:Property ;
    rdfs:label 'Profit Center Group' ;
    rdfs:comment 'Grouping identifier used to aggregate profit centers for management reporting, EBITDA analysis, and regulatory segment reporting. Corresponds to SAP profit center groups (SETCLASS 0106) used in report painter/writer reports.' ;
    rdfs:domain ind:ProfitCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:profitCenterName rdf:type rdf:Property ;
    rdfs:label 'Profit Center Name' ;
    rdfs:comment 'Human-readable short name of the profit center as maintained in SAP CO-PCA (KTEXT field in CEPC). Used in financial reports, dashboards, and rate case cost-of-service studies.' ;
    rdfs:domain ind:ProfitCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:profitCenterStatus rdf:type rdf:Property ;
    rdfs:label 'Profit Center Status' ;
    rdfs:comment 'Current lifecycle status of the profit center record. Active profit centers accept postings; locked centers are frozen for new transactions; inactive centers are retired from use. Corresponds to the LOCK_IND and PRCTR_STATUS indicators in SAP CEPC.' ;
    rdfs:domain ind:ProfitCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:profitCenterType rdf:type rdf:Property ;
    rdfs:label 'Profit Center Type' ;
    rdfs:comment 'Classification of the profit center by regulatory and operational type. Regulated centers are subject to PUC/FERC oversight and rate-of-return regulation; unregulated centers operate in competitive markets; corporate centers capture holding company costs; shared_services centers allocate common costs.' ;
    rdfs:domain ind:ProfitCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateBaseUsd rdf:type rdf:Property ;
    rdfs:label 'Rate Base Usd' ;
    rdfs:comment 'Regulatory rate base value assigned to this profit center in US dollars, representing the net investment on which the utility is permitted to earn a regulated return. Used in ROE calculations and rate case cost-of-service studies filed with FERC and state PUCs.' ;
    rdfs:domain ind:ProfitCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:revenueBudgetUsd rdf:type rdf:Property ;
    rdfs:label 'Revenue Budget Usd' ;
    rdfs:comment 'Approved annual revenue budget for this profit center in US dollars. Used in ROE and ROI analysis by business unit, EBITDA reporting by segment, and variance analysis against actual revenues.' ;
    rdfs:domain ind:ProfitCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rtoIsoMembership rdf:type rdf:Property ;
    rdfs:label 'Rto Iso Membership' ;
    rdfs:comment 'RTO or ISO market area in which this profit center participates (e.g., PJM, MISO, CAISO, SPP, ERCOT). Drives energy market cost allocation, LMP-based settlement, and OATT compliance reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentReportingCode rdf:type rdf:Property ;
    rdfs:label 'Segment Reporting Code' ;
    rdfs:comment 'Code used to map this profit center to a reportable segment under GAAP ASC 280 (Segment Reporting) and FERC segment reporting requirements. Enables aggregation of profit centers into disclosed business segments in annual reports and FERC filings.' ;
    rdfs:domain ind:ProfitCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validFromDate rdf:type rdf:Property ;
    rdfs:label 'Valid From Date' ;
    rdfs:comment 'Date from which this profit center is effective and available for financial postings. Corresponds to DATAB in SAP CEPC. Used to enforce temporal validity in period-based financial reporting and rate case cost studies.' ;
    rdfs:domain ind:ProfitCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:validToDate rdf:type rdf:Property ;
    rdfs:label 'Valid To Date' ;
    rdfs:comment 'Date through which this profit center remains effective. Corresponds to DATBI in SAP CEPC. A value of 9999-12-31 indicates an open-ended profit center with no planned deactivation.' ;
    rdfs:domain ind:ProfitCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:wipAccountIndicator rdf:type rdf:Property ;
    rdfs:label 'Wip Account Indicator' ;
    rdfs:comment 'Indicates whether this profit center is designated to capture Work in Progress (WIP) costs for capital projects prior to asset capitalization. When true, costs posted here are subject to AFUDC accrual per FERC accounting requirements.' ;
    rdfs:domain ind:ProfitCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rateCaseCostStudyId rdf:type rdf:Property ;
    rdfs:label 'Rate Case Cost Study Id' ;
    rdfs:comment 'Unique surrogate identifier for the rate case cost-of-service study record in the Databricks Silver Layer. Primary key for this entity.' ;
    rdfs:domain ind:RateCaseCostStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:aditAmount rdf:type rdf:Property ;
    rdfs:label 'Adit Amount' ;
    rdfs:comment 'Accumulated Deferred Income Tax (ADIT) balance deducted from rate base, representing the tax benefits of accelerated depreciation that have been passed through to customers. Expressed in US dollars. Corresponds to FERC Account 190/282/283.' ;
    rdfs:domain ind:RateCaseCostStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approvedDate rdf:type rdf:Property ;
    rdfs:label 'Approved Date' ;
    rdfs:comment 'Date on which the regulatory authority (PUC or FERC) issued a final order approving the rates derived from this cost-of-service study. Null if the study has not yet received final regulatory approval.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:authorizedRoePct rdf:type rdf:Property ;
    rdfs:label 'Authorized Roe Pct' ;
    rdfs:comment 'Authorized or proposed Return on Equity (ROE) percentage used in the cost-of-service study to calculate the equity component of the allowed return on rate base. Expressed as a decimal percentage (e.g., 9.5000 for 9.5%). Benchmarked against comparable utility ROE awards by the PUC or FERC.' ;
    rdfs:domain ind:RateCaseCostStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capexAmount rdf:type rdf:Property ;
    rdfs:label 'Capex Amount' ;
    rdfs:comment 'Total Capital Expenditure (CAPEX) included in or supporting the rate base determination for this cost-of-service study. Represents plant additions during the test year or projected capital investment period. Expressed in US dollars.' ;
    rdfs:domain ind:RateCaseCostStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costAllocationMethod rdf:type rdf:Property ;
    rdfs:label 'Cost Allocation Method' ;
    rdfs:comment 'Methodology used to allocate costs among customer classes or rate jurisdictions in this cost-of-service study. Fully Distributed Cost (FDC) allocates all costs; Marginal Cost reflects incremental costs; Embedded Cost uses historical average costs; Hybrid combines approaches.' ;
    rdfs:domain ind:RateCaseCostStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costOfDebtPct rdf:type rdf:Property ;
    rdfs:label 'Cost Of Debt Pct' ;
    rdfs:comment 'Embedded cost of long-term debt used in the WACC calculation, representing the weighted average interest rate on the utility\'s outstanding debt instruments. Expressed as a decimal percentage (e.g., 4.8500 for 4.85%).' ;
    rdfs:domain ind:RateCaseCostStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cpcnReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Cpcn Reference Number' ;
    rdfs:comment 'Reference number of the Certificate of Public Convenience and Necessity (CPCN) application supported by this cost-of-service study, if applicable. Links the cost justification to the capital project authorization for major infrastructure investments.' ;
    rdfs:domain ind:RateCaseCostStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:debtRatioPct rdf:type rdf:Property ;
    rdfs:label 'Debt Ratio Pct' ;
    rdfs:comment 'Percentage of the capital structure represented by long-term debt, used in the WACC calculation. Expressed as a decimal percentage (e.g., 48.0000 for 48%). Together with equity_ratio_pct must sum to 100%.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depreciationExpenseAmount rdf:type rdf:Property ;
    rdfs:label 'Depreciation Expense Amount' ;
    rdfs:comment 'Total depreciation expense included in the revenue requirement for the test year, calculated using depreciation rates approved by the regulatory authority applied to the depreciable plant in service. Expressed in US dollars. Corresponds to FERC Account 403.' ;
    rdfs:domain ind:RateCaseCostStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:equityRatioPct rdf:type rdf:Property ;
    rdfs:label 'Equity Ratio Pct' ;
    rdfs:comment 'Percentage of the capital structure represented by equity, used in the WACC calculation. Expressed as a decimal percentage (e.g., 52.0000 for 52%). Determined by the utility\'s actual or hypothetical capital structure as accepted by the regulatory authority.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:existingRevenueAmount rdf:type rdf:Property ;
    rdfs:label 'Existing Revenue Amount' ;
    rdfs:comment 'Current annual revenue collected under existing rates at the time of the rate case filing. The difference between revenue_requirement_amount and existing_revenue_amount represents the revenue deficiency or excess (rate increase or decrease needed). Expressed in US dollars.' ;
    rdfs:domain ind:RateCaseCostStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:filingDate rdf:type rdf:Property ;
    rdfs:label 'Filing Date' ;
    rdfs:comment 'Date on which the cost-of-service study was formally filed with the regulatory authority (PUC or FERC). This is the BUSINESS_EVENT_TIMESTAMP (date precision) for this TRANSACTION_HEADER entity. Triggers statutory review timelines and suspension periods.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:filingStatus rdf:type rdf:Property ;
    rdfs:label 'Filing Status' ;
    rdfs:comment 'Current lifecycle status of the cost-of-service study within the rate case workflow. Tracks progression from internal preparation through regulatory submission and disposition. This is the LIFECYCLE_STATUS for this TRANSACTION_HEADER entity.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:functionalizationMethod rdf:type rdf:Property ;
    rdfs:label 'Functionalization Method' ;
    rdfs:comment 'Primary functional category used to classify utility costs in this study per FERC Uniform System of Accounts: production, transmission, distribution, customer, or general/administrative. Drives cost allocation to customer classes and rate design. [ENUM-REF-CANDIDATE: production|transmission|distribution|customer|general — promote to reference product if multi-function studies require line-level detail]' ;
    rdfs:domain ind:RateCaseCostStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incomeTaxExpenseAmount rdf:type rdf:Property ;
    rdfs:label 'Income Tax Expense Amount' ;
    rdfs:comment 'Total income tax expense (federal and state) included in the revenue requirement, calculated on the allowed return on equity component of the rate base. Expressed in US dollars. Includes adjustments for accumulated deferred income taxes (ADIT).' ;
    rdfs:domain ind:RateCaseCostStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:irpReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Irp Reference Number' ;
    rdfs:comment 'Reference number of the Integrated Resource Plan (IRP) submission that this cost-of-service study supports, if applicable. Connects long-term resource planning cost projections to the rate case revenue requirement.' ;
    rdfs:domain ind:RateCaseCostStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdictionState rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction State' ;
    rdfs:comment 'Two-letter US state abbreviation identifying the state PUC jurisdiction for this filing (e.g., CA, TX, NY). Null if the filing is exclusively with FERC. Used to apply state-specific regulatory accounting rules and tariff structures.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdictionType rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Type' ;
    rdfs:comment 'Indicates whether this cost-of-service study is filed with a state Public Utility Commission (PUC), the Federal Energy Regulatory Commission (FERC), or both (dual jurisdiction). Determines applicable regulatory accounting standards and reporting requirements.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:omExpenseAmount rdf:type rdf:Property ;
    rdfs:label 'Om Expense Amount' ;
    rdfs:comment 'Total Operations and Maintenance (O&M) expense included in the revenue requirement for the test year, covering labor, materials, and contracted services for operating and maintaining generation, transmission, and distribution assets. Expressed in US dollars.' ;
    rdfs:domain ind:RateCaseCostStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pbrTargetIncluded rdf:type rdf:Property ;
    rdfs:label 'Pbr Target Included' ;
    rdfs:comment 'Indicates whether this cost-of-service study includes Performance-Based Ratemaking (PBR) performance targets or incentive mechanisms as part of the rate design. True if PBR metrics (e.g., SAIDI, SAIFI, customer satisfaction) are incorporated into the revenue requirement or rate structure.' ;
    rdfs:domain ind:RateCaseCostStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:preparedBy rdf:type rdf:Property ;
    rdfs:label 'Prepared By' ;
    rdfs:comment 'Name or employee identifier of the regulatory analyst or financial professional responsible for preparing this cost-of-service study. Supports SOX accountability and regulatory filing certification requirements. This is the PARTY_REFERENCE for this TRANSACTION_HEADER entity.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:propertyTaxExpenseAmount rdf:type rdf:Property ;
    rdfs:label 'Property Tax Expense Amount' ;
    rdfs:comment 'Total property and other taxes (excluding income taxes) included in the revenue requirement for the test year. Expressed in US dollars. Corresponds to FERC Account 408.1.' ;
    rdfs:domain ind:RateCaseCostStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateBaseAmount rdf:type rdf:Property ;
    rdfs:label 'Rate Base Amount' ;
    rdfs:comment 'Total rate base as determined in this cost-of-service study, representing the net investment on which the utility is entitled to earn a return. Includes net plant in service, working capital, and other allowable investments, less accumulated depreciation and deferred taxes. Expressed in US dollars.' ;
    rdfs:domain ind:RateCaseCostStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:revenueDeficiencyAmount rdf:type rdf:Property ;
    rdfs:label 'Revenue Deficiency Amount' ;
    rdfs:comment 'Net difference between the total revenue requirement and existing revenues. A positive value indicates a revenue deficiency (rate increase needed); a negative value indicates a revenue surplus (rate decrease). Expressed in US dollars. This is the MONETARY_TRIPLET adjustment/net component.' ;
    rdfs:domain ind:RateCaseCostStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:revenueRequirementAmount rdf:type rdf:Property ;
    rdfs:label 'Revenue Requirement Amount' ;
    rdfs:comment 'Total revenue requirement calculated in this cost-of-service study, representing the total amount the utility is authorized to collect from customers to recover its costs and earn a fair return. Expressed in US dollars. This is the primary MONETARY_TRIPLET gross amount for this TRANSACTION_HEADER entity.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:settlementReached rdf:type rdf:Property ;
    rdfs:label 'Settlement Reached' ;
    rdfs:comment 'Indicates whether the rate case associated with this cost-of-service study was resolved through a negotiated settlement agreement among the utility, regulatory staff, and intervening parties, rather than a fully litigated proceeding.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:studyDescription rdf:type rdf:Property ;
    rdfs:label 'Study Description' ;
    rdfs:comment 'Narrative description of the scope, purpose, and key assumptions of this cost-of-service study. Includes summary of major cost drivers, significant adjustments from prior rate case, and any unusual items requiring regulatory explanation.' ;
    rdfs:domain ind:RateCaseCostStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:studyNumber rdf:type rdf:Property ;
    rdfs:label 'Study Number' ;
    rdfs:comment 'Externally-known alphanumeric identifier assigned to this cost-of-service study, used in regulatory filings and cross-referenced in dockets. Typically formatted as a combination of jurisdiction code, year, and sequence (e.g., CA-GRC-2024-001). This is the BUSINESS_IDENTIFIER for this TRANSACTION_HEADER entity.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:studyType rdf:type rdf:Property ;
    rdfs:label 'Study Type' ;
    rdfs:comment 'Classification of the rate case type for which this cost-of-service study is prepared. Determines the applicable regulatory framework, tariff schedules, and cost allocation methodology. [ENUM-REF-CANDIDATE: general_rate_case|transmission_rate_case|gas_rate_case|distribution_rate_case|limited_rate_case — promote to reference product if additional types are needed]' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:studyVersion rdf:type rdf:Property ;
    rdfs:label 'Study Version' ;
    rdfs:comment 'Version number of this cost-of-service study, incremented when the study is revised during the regulatory proceeding (e.g., in response to data requests, settlement negotiations, or updated actuals). Version 1 is the initial filing; subsequent versions reflect amendments.' ;
    rdfs:domain ind:RateCaseCostStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:testYearEndDate rdf:type rdf:Property ;
    rdfs:label 'Test Year End Date' ;
    rdfs:comment 'End date of the test year used as the basis for cost-of-service calculations. Together with test_year_start_date, defines the 12-month test period. May be historical (fully known actuals) or projected (future test year with estimates).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:testYearStartDate rdf:type rdf:Property ;
    rdfs:label 'Test Year Start Date' ;
    rdfs:comment 'Start date of the test year (historical or projected) used as the basis for cost-of-service calculations. The test year is the 12-month period whose costs and revenues form the foundation of the revenue requirement determination.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:testYearType rdf:type rdf:Property ;
    rdfs:label 'Test Year Type' ;
    rdfs:comment 'Indicates whether the test year is based on historical actuals, a projected future period, or a hybrid combining historical data with known and measurable adjustments. Affects the level of regulatory scrutiny and the types of adjustments permitted.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waccPct rdf:type rdf:Property ;
    rdfs:label 'Wacc Pct' ;
    rdfs:comment 'Weighted Average Cost of Capital (WACC) used to determine the overall allowed rate of return on rate base, blending the cost of debt and equity weighted by their respective proportions in the capital structure. Expressed as a decimal percentage (e.g., 7.2500 for 7.25%).' ;
    rdfs:domain ind:RateCaseCostStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:workingCapitalAmount rdf:type rdf:Property ;
    rdfs:label 'Working Capital Amount' ;
    rdfs:comment 'Working capital allowance included in rate base, representing the utility\'s investment in cash, materials, supplies, and prepayments needed to operate the business between billing cycles. Expressed in US dollars.' ;
    rdfs:domain ind:RateCaseCostStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryAssetEntryId rdf:type rdf:Property ;
    rdfs:label 'Regulatory Asset Entry Id' ;
    rdfs:comment 'Unique identifier for the regulatory asset or liability entry in the regulatory asset base (RAB). Primary key for tracking individual regulatory accounting entries reported to PUCs and FERC.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RegulatoryAssetEntry .

ind:accumulatedAmortization rdf:type rdf:Property ;
    rdfs:label 'Accumulated Amortization' ;
    rdfs:comment 'Total cumulative amortization expense recognized to date for this regulatory asset or liability, representing the portion already recovered or refunded through customer rates.' ;
    rdfs:domain ind:RegulatoryAssetEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:amortizationEndDate rdf:type rdf:Property ;
    rdfs:label 'Amortization End Date' ;
    rdfs:comment 'Scheduled date on which amortization of the regulatory asset or liability is expected to be fully completed, representing the end of the recovery or refund period.' ;
    rdfs:domain ind:RegulatoryAssetEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:amortizationMethod rdf:type rdf:Property ;
    rdfs:label 'Amortization Method' ;
    rdfs:comment 'Method used to calculate periodic amortization expense for the regulatory asset or liability, as prescribed by the regulatory commission or approved accounting policy.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amortizationPeriodMonths rdf:type rdf:Property ;
    rdfs:label 'Amortization Period Months' ;
    rdfs:comment 'Total number of months over which the regulatory asset or liability is scheduled to be amortized, as approved by the regulatory commission in the rate case order.' ;
    rdfs:domain ind:RegulatoryAssetEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:amortizationStartDate rdf:type rdf:Property ;
    rdfs:label 'Amortization Start Date' ;
    rdfs:comment 'Date on which amortization of the regulatory asset or liability begins, marking the commencement of systematic recovery or refund through customer rates.' ;
    rdfs:domain ind:RegulatoryAssetEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:annualAmortizationAmount rdf:type rdf:Property ;
    rdfs:label 'Annual Amortization Amount' ;
    rdfs:comment 'Planned annual amortization expense for the regulatory asset or liability, representing the amount to be recovered or refunded each year through customer rates.' ;
    rdfs:domain ind:Finance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:carryingCostAmount rdf:type rdf:Property ;
    rdfs:label 'Carrying Cost Amount' ;
    rdfs:comment 'Dollar amount of carrying costs accrued on the regulatory asset balance for the current period, representing the return component recoverable through rates in addition to amortization.' ;
    rdfs:domain ind:RegulatoryAssetEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:carryingCostRate rdf:type rdf:Property ;
    rdfs:label 'Carrying Cost Rate' ;
    rdfs:comment 'Annual percentage rate applied to the unamortized balance of the regulatory asset to calculate carrying costs (return on investment), representing the weighted average cost of capital (WACC) or authorized rate of return.' ;
    rdfs:domain ind:RegulatoryAssetEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:entryDescription rdf:type rdf:Property ;
    rdfs:label 'Entry Description' ;
    rdfs:comment 'Detailed narrative description of the regulatory asset or liability, explaining the nature of the deferred cost or obligation, the business justification, and the regulatory treatment approved by the commission.' ;
    rdfs:domain ind:RegulatoryAssetEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entryNumber rdf:type rdf:Property ;
    rdfs:label 'Entry Number' ;
    rdfs:comment 'Business identifier for the regulatory asset or liability entry, used for external reporting and cross-referencing in rate case filings and regulatory submissions.' ;
    rdfs:domain ind:RegulatoryAssetEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entryStatus rdf:type rdf:Property ;
    rdfs:label 'Entry Status' ;
    rdfs:comment 'Current lifecycle status of the regulatory asset or liability entry, tracking its progression from initial recording through amortization to retirement or transfer. [ENUM-REF-CANDIDATE: active|pending_approval|approved|amortizing|fully_amortized|retired|transferred — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:RegulatoryAssetEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isCwipEligible rdf:type rdf:Property ;
    rdfs:label 'Is Cwip Eligible' ;
    rdfs:comment 'Indicates whether this entry represents construction work in progress that is eligible for inclusion in rate base before the asset is placed in service, subject to regulatory approval.' ;
    rdfs:domain ind:RegulatoryAssetEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:originalAmount rdf:type rdf:Property ;
    rdfs:label 'Original Amount' ;
    rdfs:comment 'Original dollar value of the regulatory asset or liability at the time of initial recognition, representing the total amount authorized for recovery or refund before any amortization.' ;
    rdfs:domain ind:RegulatoryAssetEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recognitionDate rdf:type rdf:Property ;
    rdfs:label 'Recognition Date' ;
    rdfs:comment 'Date on which the regulatory asset or liability was initially recognized in the regulatory accounting records, typically corresponding to the regulatory order or commission approval date.' ;
    rdfs:domain ind:RegulatoryAssetEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryOrderDate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Order Date' ;
    rdfs:comment 'Date on which the regulatory commission issued the order authorizing this regulatory asset or liability, establishing the legal basis for rate recovery or refund.' ;
    rdfs:domain ind:RegulatoryAssetEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Regulatory Order Number' ;
    rdfs:comment 'Official order or docket number issued by the regulatory commission (FERC or state PUC) authorizing the recognition and recovery of this regulatory asset or liability.' ;
    rdfs:domain ind:RegulatoryAssetEntry ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryDeferralId rdf:type rdf:Property ;
    rdfs:label 'Regulatory Deferral Id' ;
    rdfs:comment 'Unique identifier for the regulatory deferral record. Primary key for the regulatory deferral master table.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RegulatoryDeferral .

ind:accumulatedCarryingCharges rdf:type rdf:Property ;
    rdfs:label 'Accumulated Carrying Charges' ;
    rdfs:comment 'Total carrying charges (interest) accumulated on the regulatory deferral balance to date, representing the time value of money on deferred costs or revenues.' ;
    rdfs:domain ind:RegulatoryDeferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:accumulatedDeferralAmount rdf:type rdf:Property ;
    rdfs:label 'Accumulated Deferral Amount' ;
    rdfs:comment 'Total amount of costs or revenues accumulated in the regulatory deferral account to date, representing the gross balance before any amortization.' ;
    rdfs:domain ind:RegulatoryDeferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:amortizationPeriodYears rdf:type rdf:Property ;
    rdfs:label 'Amortization Period Years' ;
    rdfs:comment 'Number of years over which the regulatory deferral is authorized to be amortized and recovered through customer rates or refunded to customers.' ;
    rdfs:domain ind:RegulatoryDeferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:authorizedDeferralAmount rdf:type rdf:Property ;
    rdfs:label 'Authorized Deferral Amount' ;
    rdfs:comment 'Total amount authorized by the regulatory authority for deferral, representing the maximum cost or revenue that may be deferred for future rate recovery or refund.' ;
    rdfs:domain ind:RegulatoryDeferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:carryingChargeRatePct rdf:type rdf:Property ;
    rdfs:label 'Carrying Charge Rate Pct' ;
    rdfs:comment 'Annual percentage rate applied to the unamortized balance to calculate carrying charges (interest) on the regulatory deferral, typically based on the utility\'s weighted average cost of capital or a regulatory-approved rate.' ;
    rdfs:domain ind:RegulatoryDeferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deferralCategory rdf:type rdf:Property ;
    rdfs:label 'Deferral Category' ;
    rdfs:comment 'Specific category of the regulatory deferral such as storm cost, pension/OPEB, fuel adjustment clause under/over-recovery, environmental remediation, rate case expense, EDIT (Excess Deferred Income Taxes), demand-side management program costs, renewable energy program costs, or other regulatory-approved deferral categories. [ENUM-REF-CANDIDATE: storm_cost|pension_opeb|fuel_adjustment_clause|environmental_remediation|rate_case_expense|edit|dsm_program|renewable_program|transmission_upgrade|distribution_upgrade|other — promote to reference product]' ;
    rdfs:domain ind:RegulatoryDeferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deferralDescription rdf:type rdf:Property ;
    rdfs:label 'Deferral Description' ;
    rdfs:comment 'Detailed business description of the regulatory deferral, including the nature of the deferred costs or revenues, the business justification, and the regulatory authorization basis.' ;
    rdfs:domain ind:RegulatoryDeferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deferralNumber rdf:type rdf:Property ;
    rdfs:label 'Deferral Number' ;
    rdfs:comment 'Business identifier or tracking number assigned to the regulatory deferral for external reference and regulatory reporting.' ;
    rdfs:domain ind:RegulatoryDeferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deferralStatus rdf:type rdf:Property ;
    rdfs:label 'Deferral Status' ;
    rdfs:comment 'Current lifecycle status of the regulatory deferral indicating whether it is pending regulatory approval, approved and active, fully amortized, terminated, or suspended.' ;
    rdfs:domain ind:RegulatoryDeferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deferralType rdf:type rdf:Property ;
    rdfs:label 'Deferral Type' ;
    rdfs:comment 'Classification of the deferral as either a regulatory asset (costs deferred for future recovery) or regulatory liability (revenues deferred for future refund to customers).' ;
    rdfs:domain ind:RegulatoryDeferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isFercReportable rdf:type rdf:Property ;
    rdfs:label 'Is Ferc Reportable' ;
    rdfs:comment 'Boolean flag indicating whether the regulatory deferral must be reported on FERC Form 1 Schedules 232 (Regulatory Assets) or 254 (Regulatory Liabilities).' ;
    rdfs:domain ind:RegulatoryDeferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSoxRelevant rdf:type rdf:Property ;
    rdfs:label 'Is Sox Relevant' ;
    rdfs:comment 'Boolean flag indicating whether the regulatory deferral is subject to Sarbanes-Oxley Act internal control and audit requirements due to materiality or financial statement impact.' ;
    rdfs:domain ind:RegulatoryDeferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pucAuthorizationReference rdf:type rdf:Property ;
    rdfs:label 'Puc Authorization Reference' ;
    rdfs:comment 'Reference number or citation of the PUC order, rate case docket, or FERC order that authorized the regulatory deferral.' ;
    rdfs:domain ind:RegulatoryDeferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoveryMechanism rdf:type rdf:Property ;
    rdfs:label 'Recovery Mechanism' ;
    rdfs:comment 'Description of the rate mechanism through which the regulatory deferral will be recovered from or refunded to customers, such as base rates, rider, surcharge, fuel adjustment clause, or other regulatory-approved mechanism.' ;
    rdfs:domain ind:RegulatoryDeferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unamortizedBalance rdf:type rdf:Property ;
    rdfs:label 'Unamortized Balance' ;
    rdfs:comment 'Remaining balance of the regulatory deferral that has not yet been amortized or recovered through rates, representing the current carrying value on the balance sheet.' ;
    rdfs:domain ind:RegulatoryDeferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxProvisionId rdf:type rdf:Property ;
    rdfs:label 'Tax Provision Id' ;
    rdfs:comment 'Unique identifier for the tax provision record. Primary key.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:aditAcceleratedDepreciation rdf:type rdf:Property ;
    rdfs:label 'Adit Accelerated Depreciation' ;
    rdfs:comment 'Component of ADIT balance attributable to timing differences from accelerated tax depreciation methods versus book depreciation, the largest ADIT category for utilities.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:aditBalance rdf:type rdf:Property ;
    rdfs:label 'Adit Balance' ;
    rdfs:comment 'Cumulative balance of Accumulated Deferred Income Taxes at the end of the provision period, representing the net deferred tax liability or asset position that directly reduces rate base in regulatory accounting.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:aditPensionObligations rdf:type rdf:Property ;
    rdfs:label 'Adit Pension Obligations' ;
    rdfs:comment 'Component of ADIT balance attributable to timing differences from pension and other post-retirement benefit obligations where book and tax recognition timing differs.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:aditRegulatoryLiabilities rdf:type rdf:Property ;
    rdfs:label 'Adit Regulatory Liabilities' ;
    rdfs:comment 'Component of ADIT balance attributable to regulatory liabilities and deferred revenue items that create temporary differences between book and tax treatment.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:aditStormCostDeferrals rdf:type rdf:Property ;
    rdfs:label 'Adit Storm Cost Deferrals' ;
    rdfs:comment 'Component of ADIT balance attributable to deferred storm restoration costs and other extraordinary event deferrals that create temporary differences.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentFederalTaxExpense rdf:type rdf:Property ;
    rdfs:label 'Current Federal Tax Expense' ;
    rdfs:comment 'Current period federal income tax expense calculated on taxable income for the provision period, representing taxes payable to the federal government in the current year.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentStateTaxExpense rdf:type rdf:Property ;
    rdfs:label 'Current State Tax Expense' ;
    rdfs:comment 'Current period state income tax expense calculated on taxable income for the provision period, representing taxes payable to state jurisdictions in the current year.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deferredFederalTaxExpense rdf:type rdf:Property ;
    rdfs:label 'Deferred Federal Tax Expense' ;
    rdfs:comment 'Deferred federal income tax expense arising from temporary differences between book and tax accounting, representing future tax consequences of events recognized in financial statements.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deferredStateTaxExpense rdf:type rdf:Property ;
    rdfs:label 'Deferred State Tax Expense' ;
    rdfs:comment 'Deferred state income tax expense arising from temporary differences between book and tax accounting at the state jurisdiction level.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:editAmortizationAmount rdf:type rdf:Property ;
    rdfs:label 'Edit Amortization Amount' ;
    rdfs:comment 'Amount of Excess Deferred Income Taxes amortized during the provision period, flowing back to customers through reduced rates or regulatory liability accounts.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:editProtectedBalance rdf:type rdf:Property ;
    rdfs:label 'Edit Protected Balance' ;
    rdfs:comment 'Protected portion of Excess Deferred Income Taxes related to public utility property that must be amortized using Average Rate Assumption Method (ARAM) per IRS normalization requirements.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:editUnprotectedBalance rdf:type rdf:Property ;
    rdfs:label 'Edit Unprotected Balance' ;
    rdfs:comment 'Unprotected portion of Excess Deferred Income Taxes not subject to IRS normalization rules, which can be amortized more quickly to benefit customers.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:effectiveTaxRatePct rdf:type rdf:Property ;
    rdfs:label 'Effective Tax Rate Pct' ;
    rdfs:comment 'Effective tax rate percentage calculated as total tax expense divided by pre-tax book income, used for financial statement disclosure and rate case analysis.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:excessDeferredIncomeTaxes rdf:type rdf:Property ;
    rdfs:label 'Excess Deferred Income Taxes' ;
    rdfs:comment 'Excess Deferred Income Taxes balance resulting from the Tax Cuts and Jobs Act (TCJA) federal rate reduction from 35% to 21%, requiring amortization back to customers per IRS normalization rules.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:federalTaxJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Federal Tax Jurisdiction' ;
    rdfs:comment 'Federal tax jurisdiction code or identifier, typically IRS or federal tax authority reference for the provision calculation.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:itcAmortizationAmount rdf:type rdf:Property ;
    rdfs:label 'Itc Amortization Amount' ;
    rdfs:comment 'Amount of Investment Tax Credit amortized during the provision period, representing the systematic recognition of ITC benefits over the life of qualifying renewable energy or other eligible assets per IRS normalization rules.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:itcUnamortizedBalance rdf:type rdf:Property ;
    rdfs:label 'Itc Unamortized Balance' ;
    rdfs:comment 'Remaining unamortized balance of Investment Tax Credits at the end of the provision period, representing future tax benefits to be recognized over the remaining asset life.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:permanentDifferenceAmount rdf:type rdf:Property ;
    rdfs:label 'Permanent Difference Amount' ;
    rdfs:comment 'Total permanent differences between book and tax income that will never reverse, such as non-deductible expenses, tax-exempt income, and meals and entertainment disallowances.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preTaxBookIncome rdf:type rdf:Property ;
    rdfs:label 'Pre Tax Book Income' ;
    rdfs:comment 'Pre-tax book income for the provision period per GAAP financial statements, serving as the starting point for the tax provision calculation and effective rate reconciliation.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:provisionNumber rdf:type rdf:Property ;
    rdfs:label 'Provision Number' ;
    rdfs:comment 'Business identifier for the tax provision record, typically following a sequential or period-based numbering scheme for external reference and audit trail purposes.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:provisionPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Provision Period End Date' ;
    rdfs:comment 'End date of the period covered by this tax provision calculation, typically the last day of a fiscal quarter or year.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:provisionPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Provision Period Start Date' ;
    rdfs:comment 'Start date of the period covered by this tax provision calculation, typically the first day of a fiscal quarter or year.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:provisionStatus rdf:type rdf:Property ;
    rdfs:label 'Provision Status' ;
    rdfs:comment 'Current lifecycle status of the tax provision record indicating its stage in the approval and posting workflow.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:provisionType rdf:type rdf:Property ;
    rdfs:label 'Provision Type' ;
    rdfs:comment 'Classification of the tax provision indicating whether it is a regular quarterly provision, annual provision, interim adjustment, amended filing, or year-end true-up calculation.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateBaseAditOffset rdf:type rdf:Property ;
    rdfs:label 'Rate Base Adit Offset' ;
    rdfs:comment 'ADIT amount used to reduce rate base in regulatory ratemaking, representing zero-cost capital that reduces the utility\'s investment base for return calculation purposes.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reviewedBy rdf:type rdf:Property ;
    rdfs:label 'Reviewed By' ;
    rdfs:comment 'Name or identifier of the senior tax professional or manager who reviewed and validated this tax provision calculation.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateTaxJurisdiction rdf:type rdf:Property ;
    rdfs:label 'State Tax Jurisdiction' ;
    rdfs:comment 'State tax jurisdiction code or abbreviation identifying the primary state tax authority for this provision, critical for multi-state utilities with apportionment requirements.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statutoryFederalTaxRatePct rdf:type rdf:Property ;
    rdfs:label 'Statutory Federal Tax Rate Pct' ;
    rdfs:comment 'Statutory federal income tax rate percentage in effect for the provision period, currently 21% post-TCJA, used as the baseline for effective rate reconciliation.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:statutoryStateTaxRatePct rdf:type rdf:Property ;
    rdfs:label 'Statutory State Tax Rate Pct' ;
    rdfs:comment 'Statutory state income tax rate percentage in effect for the provision period in the primary state jurisdiction, used for state tax expense calculation.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxableIncome rdf:type rdf:Property ;
    rdfs:label 'Taxable Income' ;
    rdfs:comment 'Taxable income calculated per Internal Revenue Code for the provision period, after adjusting book income for permanent and temporary differences.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:temporaryDifferenceAmount rdf:type rdf:Property ;
    rdfs:label 'Temporary Difference Amount' ;
    rdfs:comment 'Total temporary differences between book and tax income that will reverse in future periods, giving rise to deferred tax assets or liabilities.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalTaxExpense rdf:type rdf:Property ;
    rdfs:label 'Total Tax Expense' ;
    rdfs:comment 'Total income tax expense for the provision period, calculated as the sum of current and deferred federal and state tax expenses.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:uncertainTaxPositionReserve rdf:type rdf:Property ;
    rdfs:label 'Uncertain Tax Position Reserve' ;
    rdfs:comment 'Reserve established for uncertain tax positions under FIN 48 (ASC 740-10) where the utility has taken a tax position that may not be sustained upon examination by tax authorities.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:valuationAllowance rdf:type rdf:Property ;
    rdfs:label 'Valuation Allowance' ;
    rdfs:comment 'Valuation allowance established against deferred tax assets when it is more likely than not that some portion will not be realized, per GAAP ASC 740 guidance.' ;
    rdfs:domain ind:TaxProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capacityResourceId rdf:type rdf:Property ;
    rdfs:label 'Capacity Resource Id' ;
    rdfs:comment 'Unique identifier for the capacity resource registration record in the RTO/ISO capacity market.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CapacityResource .

ind:approvalDocketId rdf:type rdf:Property ;
    rdfs:label 'Approval Docket Id' ;
    rdfs:comment 'Foreign key linking to regulatory.docket. Business justification: Capacity market participation and resource accreditation often require state regulatory approval through dockets, particularly for cost recovery of capacity revenues or obligations. Tracking the appro' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Docket .

ind:transmissionSubstationId rdf:type rdf:Property ;
    rdfs:label 'Transmission Substation Id' ;
    rdfs:comment 'Foreign key linking to transmission.transmission_substation. Business justification: Capacity resources must specify delivery points for capacity market participation and deliverability studies. Required for PJM/NYISO/ISO-NE capacity auctions, FERC Form 1 reporting, and resource adequ' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TransmissionSubstation .

ind:accreditationPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Accreditation Period End Date' ;
    rdfs:comment 'The end date of the accreditation period during which the resource is qualified to provide capacity.' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:accreditationPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Accreditation Period Start Date' ;
    rdfs:comment 'The start date of the accreditation period during which the resource is qualified to provide capacity.' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:accreditedCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Accredited Capacity Mw' ;
    rdfs:comment 'The accredited capacity value in megawatts (MW) that the resource is qualified to provide based on RTO/ISO testing and performance criteria.' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:auctionClearingPricePerMwDay rdf:type rdf:Property ;
    rdfs:label 'Auction Clearing Price Per Mw Day' ;
    rdfs:comment 'The capacity auction clearing price in dollars per megawatt-day ($/MW-day) at which this resource cleared in the capacity market auction.' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bonusPaymentEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Bonus Payment Eligible Flag' ;
    rdfs:comment 'Indicates whether the resource is eligible for bonus payments for over-performance during capacity performance events (True/False).' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:capacityCommitmentPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Capacity Commitment Period End Date' ;
    rdfs:comment 'The end date of the capacity commitment period during which the resource must be available to deliver committed capacity.' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:capacityCommitmentPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Capacity Commitment Period Start Date' ;
    rdfs:comment 'The start date of the capacity commitment period during which the resource must be available to deliver committed capacity.' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:capacityInterconnectionRightsFlag rdf:type rdf:Property ;
    rdfs:label 'Capacity Interconnection Rights Flag' ;
    rdfs:comment 'Indicates whether the resource has secured capacity interconnection rights (CIR) or capacity network resource interconnection service (CNRIS) (True/False).' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:capacityMarketProductType rdf:type rdf:Property ;
    rdfs:label 'Capacity Market Product Type' ;
    rdfs:comment 'Type of capacity product offered in the RTO/ISO market (e.g., base capacity, capacity performance, must-offer obligation).' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capacityRevenueAmount rdf:type rdf:Property ;
    rdfs:label 'Capacity Revenue Amount' ;
    rdfs:comment 'The total capacity market revenue amount in dollars earned by this resource for the planning year based on cleared capacity and auction price.' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capacityTransferRightsFlag rdf:type rdf:Property ;
    rdfs:label 'Capacity Transfer Rights Flag' ;
    rdfs:comment 'Indicates whether the resource has capacity transfer rights allowing capacity to be sold or transferred to other zones (True/False).' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:capacityZone rdf:type rdf:Property ;
    rdfs:label 'Capacity Zone' ;
    rdfs:comment 'The RTO/ISO capacity zone or locational deliverability area (LDA) where the resource is located and registered.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:demandResponseResourceFlag rdf:type rdf:Property ;
    rdfs:label 'Demand Response Resource Flag' ;
    rdfs:comment 'Indicates whether the capacity resource is a demand response (DR) resource rather than a generation asset (True/False).' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:energyStorageResourceFlag rdf:type rdf:Property ;
    rdfs:label 'Energy Storage Resource Flag' ;
    rdfs:comment 'Indicates whether the capacity resource is an energy storage system (e.g., battery, pumped hydro) participating in the capacity market (True/False).' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:equivalentForcedOutageRateEford rdf:type rdf:Property ;
    rdfs:label 'Equivalent Forced Outage Rate Eford' ;
    rdfs:comment 'The equivalent forced outage rate on demand (EFORd) expressed as a decimal, used to calculate UCAP from ICAP.' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:installedCapacityIcapMw rdf:type rdf:Property ;
    rdfs:label 'Installed Capacity Icap Mw' ;
    rdfs:comment 'The installed capacity (ICAP) rating in megawatts representing the maximum nameplate capacity of the resource.' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastAccreditationTestDate rdf:type rdf:Property ;
    rdfs:label 'Last Accreditation Test Date' ;
    rdfs:comment 'The date of the most recent accreditation test or performance verification conducted by the RTO/ISO to validate the resource\'s capacity rating.' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mustOfferObligationFlag rdf:type rdf:Property ;
    rdfs:label 'Must Offer Obligation Flag' ;
    rdfs:comment 'Indicates whether the resource has a must-offer obligation requiring it to bid into energy and ancillary service markets (True/False).' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nextAccreditationTestDate rdf:type rdf:Property ;
    rdfs:label 'Next Accreditation Test Date' ;
    rdfs:comment 'The scheduled date for the next accreditation test or performance verification required by the RTO/ISO.' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nonPerformanceChargeRate rdf:type rdf:Property ;
    rdfs:label 'Non Performance Charge Rate' ;
    rdfs:comment 'The penalty charge rate in dollars per megawatt-hour ($/MWh) applied when the resource fails to deliver committed capacity during performance assessment intervals.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:performanceObligationMw rdf:type rdf:Property ;
    rdfs:label 'Performance Obligation Mw' ;
    rdfs:comment 'The committed capacity performance obligation in megawatts that the resource must deliver during capacity performance events or face penalties.' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:planningYear rdf:type rdf:Property ;
    rdfs:label 'Planning Year' ;
    rdfs:comment 'The capacity market planning year or delivery year for which this resource is registered (e.g., 2024/2025).' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registrationDate rdf:type rdf:Property ;
    rdfs:label 'Registration Date' ;
    rdfs:comment 'The date when the capacity resource was initially registered with the RTO/ISO for capacity market participation.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:registrationStatus rdf:type rdf:Property ;
    rdfs:label 'Registration Status' ;
    rdfs:comment 'Current lifecycle status of the capacity resource registration with the RTO/ISO.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewableResourceFlag rdf:type rdf:Property ;
    rdfs:label 'Renewable Resource Flag' ;
    rdfs:comment 'Indicates whether the capacity resource is a renewable energy resource (wind, solar, hydro, biomass) (True/False).' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:resourceAdequacyStatus rdf:type rdf:Property ;
    rdfs:label 'Resource Adequacy Status' ;
    rdfs:comment 'The resource adequacy qualification status indicating whether the resource meets RTO/ISO reliability and performance standards.' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resourceRegistrationNumber rdf:type rdf:Property ;
    rdfs:label 'Resource Registration Number' ;
    rdfs:comment 'External registration identifier assigned by the RTO/ISO for this capacity resource (e.g., PJM resource ID, MISO planning resource ID).' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rtoIsoName rdf:type rdf:Property ;
    rdfs:label 'Rto Iso Name' ;
    rdfs:comment 'The name of the RTO or ISO administering the capacity market in which this resource participates. [ENUM-REF-CANDIDATE: PJM|MISO|SPP|CAISO|NYISO|ISO_NE|ERCOT — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seasonalCapacityFlag rdf:type rdf:Property ;
    rdfs:label 'Seasonal Capacity Flag' ;
    rdfs:comment 'Indicates whether the resource is registered as a seasonal capacity resource with different capacity values for summer and winter periods (True/False).' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:unforcedCapacityUcapMw rdf:type rdf:Property ;
    rdfs:label 'Unforced Capacity Ucap Mw' ;
    rdfs:comment 'The unforced capacity (UCAP) value in megawatts, calculated as ICAP adjusted for the resource\'s equivalent forced outage rate (EFORd).' ;
    rdfs:domain ind:CapacityResource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dispatchScheduleId rdf:type rdf:Property ;
    rdfs:label 'Dispatch Schedule Id' ;
    rdfs:comment 'Primary key for dispatch_schedule' ;
    rdfs:domain ind:DispatchSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:gridTopologyId rdf:type rdf:Property ;
    rdfs:label 'Grid Topology Id' ;
    rdfs:comment 'Foreign key linking to transmission.grid_topology. Business justification: Dispatch schedules are calculated against specific network topology models for security-constrained economic dispatch. Critical for day-ahead and real-time market clearing, congestion management, and ' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GridTopology .

ind:ancillaryServiceFlag rdf:type rdf:Property ;
    rdfs:label 'Ancillary Service Flag' ;
    rdfs:comment 'Boolean indicator (True/False) denoting whether the unit is scheduled to provide ancillary services (regulation, spinning reserve, non-spinning reserve, voltage support) during this operating hour.' ;
    rdfs:domain ind:DispatchSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commitmentFlag rdf:type rdf:Property ;
    rdfs:label 'Commitment Flag' ;
    rdfs:comment 'Boolean indicator (True/False) denoting whether the unit commitment decision has been finalized for this schedule. True indicates the unit is committed to operate; False indicates the schedule is preliminary or advisory.' ;
    rdfs:domain ind:DispatchSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:controlArea rdf:type rdf:Property ;
    rdfs:label 'Control Area' ;
    rdfs:comment 'The RTO/ISO control area or balancing authority area in which the generating unit operates. Examples include PJM, CAISO, ERCOT, MISO, NYISO, ISO-NE, SPP.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispatchInstructionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Dispatch Instruction Timestamp' ;
    rdfs:comment 'The date and time when the dispatch instruction was issued by the Energy Management System (EMS) or RTO/ISO. Represents the business event time for the dispatch decision.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dispatchStatus rdf:type rdf:Property ;
    rdfs:label 'Dispatch Status' ;
    rdfs:comment 'Current lifecycle status of the dispatch schedule. Scheduled indicates initial plan; committed means unit commitment decision made; dispatched means unit is operating per schedule; cancelled or revised indicate changes.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispatchType rdf:type rdf:Property ;
    rdfs:label 'Dispatch Type' ;
    rdfs:comment 'Classification of the dispatch instruction based on the operational driver. Economic dispatch follows least-cost optimization; reliability dispatch addresses grid constraints; emergency dispatch responds to system contingencies; regulation and load-following provide ancillary services.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:economicDispatchMw rdf:type rdf:Property ;
    rdfs:label 'Economic Dispatch Mw' ;
    rdfs:comment 'The economically optimal generation output in megawatts based on marginal cost optimization and Locational Marginal Price (LMP) signals. May differ from scheduled MW if reliability or must-run constraints apply.' ;
    rdfs:domain ind:DispatchSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:emissionsRateLbsPerMwh rdf:type rdf:Property ;
    rdfs:label 'Emissions Rate Lbs Per Mwh' ;
    rdfs:comment 'The forecasted emissions rate in pounds per megawatt-hour for the scheduled generation. Typically represents CO2, NOx, or SO2 emissions depending on regulatory reporting requirements.' ;
    rdfs:domain ind:DispatchSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forecastLoadMw rdf:type rdf:Property ;
    rdfs:label 'Forecast Load Mw' ;
    rdfs:comment 'The forecasted system load in megawatts for the control area during the scheduled operating hour. Provides context for the dispatch decision and unit commitment optimization.' ;
    rdfs:domain ind:DispatchSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fuelBurnForecastMmbtu rdf:type rdf:Property ;
    rdfs:label 'Fuel Burn Forecast Mmbtu' ;
    rdfs:comment 'Forecasted fuel consumption in million British Thermal Units (MMBTU) required to produce the scheduled generation output. Used for fuel procurement planning and cost forecasting.' ;
    rdfs:domain ind:DispatchSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fuelType rdf:type rdf:Property ;
    rdfs:label 'Fuel Type' ;
    rdfs:comment 'The primary fuel source used by the generating unit. Used for fuel procurement planning, emissions tracking, and Renewable Portfolio Standard (RPS) compliance. [ENUM-REF-CANDIDATE: natural_gas|coal|nuclear|hydro|wind|solar|oil|biomass — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:heatRateBtuPerKwh rdf:type rdf:Property ;
    rdfs:label 'Heat Rate Btu Per Kwh' ;
    rdfs:comment 'The expected heat rate in BTU per kWh for the unit at the scheduled output level. Represents the thermal efficiency of the generating unit. Lower heat rates indicate higher efficiency.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:marginalCostUsdPerMwh rdf:type rdf:Property ;
    rdfs:label 'Marginal Cost Usd Per Mwh' ;
    rdfs:comment 'The incremental cost in US dollars per megawatt-hour to produce the next unit of energy at the scheduled output level. Used in economic dispatch optimization and bid cost recovery calculations.' ;
    rdfs:domain ind:DispatchSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maximumGenerationMw rdf:type rdf:Property ;
    rdfs:label 'Maximum Generation Mw' ;
    rdfs:comment 'The maximum generation capacity in megawatts available from the unit during the operating hour. Represents the upper operating limit considering unit capability and any derates.' ;
    rdfs:domain ind:DispatchSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumDownTimeHours rdf:type rdf:Property ;
    rdfs:label 'Minimum Down Time Hours' ;
    rdfs:comment 'The minimum number of consecutive hours the unit must remain offline once shut down. Operational constraint based on cooling requirements and thermal stress limits.' ;
    rdfs:domain ind:DispatchSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minimumGenerationMw rdf:type rdf:Property ;
    rdfs:label 'Minimum Generation Mw' ;
    rdfs:comment 'The minimum stable generation level in megawatts that the unit can sustain during the operating hour. Represents the lower operating limit for the unit.' ;
    rdfs:domain ind:DispatchSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumUpTimeHours rdf:type rdf:Property ;
    rdfs:label 'Minimum Up Time Hours' ;
    rdfs:comment 'The minimum number of consecutive hours the unit must remain online once started. Operational constraint based on unit design and thermal stress limits.' ;
    rdfs:domain ind:DispatchSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:mustRunFlag rdf:type rdf:Property ;
    rdfs:label 'Must Run Flag' ;
    rdfs:comment 'Boolean indicator (True/False) denoting whether the unit is designated as must-run for reliability purposes. Must-run units are committed regardless of economic merit to maintain grid stability, voltage support, or local reliability.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:operatingHour rdf:type rdf:Property ;
    rdfs:label 'Operating Hour' ;
    rdfs:comment 'The hour of the day (0-23) for which this dispatch schedule applies. Represents the hour-ending convention used in energy markets.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rampRateMwPerMin rdf:type rdf:Property ;
    rdfs:label 'Ramp Rate Mw Per Min' ;
    rdfs:comment 'The maximum rate at which the generating unit can increase or decrease output, measured in megawatts per minute. Critical for load-following and frequency regulation services.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulationReserveMw rdf:type rdf:Property ;
    rdfs:label 'Regulation Reserve Mw' ;
    rdfs:comment 'The amount of generation capacity in megawatts reserved for automatic generation control (AGC) regulation service. This capacity is held back from energy dispatch to provide frequency regulation.' ;
    rdfs:domain ind:DispatchSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scheduleCreatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Schedule Created Timestamp' ;
    rdfs:comment 'The date and time when this dispatch schedule record was first created in the system. Audit timestamp for record creation.' ;
    rdfs:domain ind:DispatchSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:scheduleDate rdf:type rdf:Property ;
    rdfs:label 'Schedule Date' ;
    rdfs:comment 'The calendar date for which this dispatch schedule is effective. Used for day-ahead and real-time dispatch planning.' ;
    rdfs:domain ind:DispatchSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:scheduleNotes rdf:type rdf:Property ;
    rdfs:label 'Schedule Notes' ;
    rdfs:comment 'Free-text field for operational notes, comments, or special instructions related to the dispatch schedule. May include reasons for out-of-merit dispatch, coordination notes, or operator remarks.' ;
    rdfs:domain ind:DispatchSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Schedule Source System' ;
    rdfs:comment 'The name of the source system that generated this dispatch schedule. Typically the ABB or GE Energy Management System (EMS) dispatch engine, or the RTO/ISO market system.' ;
    rdfs:domain ind:DispatchSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleType rdf:type rdf:Property ;
    rdfs:label 'Schedule Type' ;
    rdfs:comment 'Classification of the dispatch schedule based on market timing and purpose. Day-ahead schedules are produced 24 hours in advance; real-time schedules are produced hourly; reliability and emergency schedules address grid stability needs.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleUpdatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Schedule Updated Timestamp' ;
    rdfs:comment 'The date and time when this dispatch schedule record was last modified. Audit timestamp for record updates, capturing schedule revisions.' ;
    rdfs:domain ind:DispatchSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:scheduleVersion rdf:type rdf:Property ;
    rdfs:label 'Schedule Version' ;
    rdfs:comment 'Version number of the dispatch schedule. Increments when schedules are revised due to updated forecasts, unit availability changes, or market conditions. Version 1 is typically the day-ahead schedule.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:scheduledMwOutput rdf:type rdf:Property ;
    rdfs:label 'Scheduled Mw Output' ;
    rdfs:comment 'The planned generation output in megawatts (MW) for the generating unit during the specified operating hour. This is the target output level determined by the Energy Management System (EMS) dispatch optimization.' ;
    rdfs:domain ind:DispatchSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:settlementInterval rdf:type rdf:Property ;
    rdfs:label 'Settlement Interval' ;
    rdfs:comment 'The sub-hourly settlement interval (typically 5, 10, or 15 minutes) within the operating hour for which this schedule applies. Used in real-time markets with sub-hourly dispatch and settlement.' ;
    rdfs:domain ind:DispatchSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:spinningReserveMw rdf:type rdf:Property ;
    rdfs:label 'Spinning Reserve Mw' ;
    rdfs:comment 'The amount of synchronized generation capacity in megawatts held in reserve to respond to sudden generation or transmission outages within 10 minutes.' ;
    rdfs:domain ind:DispatchSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:startupCostUsd rdf:type rdf:Property ;
    rdfs:label 'Startup Cost Usd' ;
    rdfs:comment 'The estimated cost in US dollars to start the generating unit from an offline state. Includes fuel, labor, and wear-and-tear costs. Used in unit commitment optimization.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:startupType rdf:type rdf:Property ;
    rdfs:label 'Startup Type' ;
    rdfs:comment 'Classification of the unit startup condition if the unit is being committed from an offline state. Hot startup occurs within 8 hours of shutdown; warm startup within 8-48 hours; cold startup after 48+ hours. Affects startup time and costs.' ;
    rdfs:domain ind:DispatchSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transmissionConstraintFlag rdf:type rdf:Property ;
    rdfs:label 'Transmission Constraint Flag' ;
    rdfs:comment 'Boolean indicator (True/False) denoting whether transmission system constraints influenced the dispatch schedule. True indicates the unit was dispatched out-of-economic-merit to address transmission congestion or voltage issues.' ;
    rdfs:domain ind:DispatchSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:emissionsRecordId rdf:type rdf:Property ;
    rdfs:label 'Emissions Record Id' ;
    rdfs:comment 'Primary key for emissions_record' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:plantId rdf:type rdf:Property ;
    rdfs:label 'Plant Id' ;
    rdfs:comment 'Foreign key reference to the power generation facility where the emissions occurred. Links to the facility master data.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Plant .

ind:allowanceAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Allowance Account Number' ;
    rdfs:comment 'The EPA allowance tracking system account number from which allowances were retired to cover these emissions. Used for compliance reconciliation.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allowanceConsumption rdf:type rdf:Property ;
    rdfs:label 'Allowance Consumption' ;
    rdfs:comment 'The number of emissions allowances consumed or required for this emissions record under cap-and-trade programs such as the EPA Acid Rain Program or state-level programs. One allowance typically equals one ton of SO2 or NOx.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:carbonContentPercent rdf:type rdf:Property ;
    rdfs:label 'Carbon Content Percent' ;
    rdfs:comment 'The carbon content of the fuel as a percentage by weight. Used in mass balance calculations for CO2 emissions when CEMS is unavailable.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:carbonCostTotal rdf:type rdf:Property ;
    rdfs:label 'Carbon Cost Total' ;
    rdfs:comment 'The total carbon cost for this emissions record, calculated as emission quantity multiplied by carbon price. Used for financial reporting and cost allocation.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:carbonPricePerTon rdf:type rdf:Property ;
    rdfs:label 'Carbon Price Per Ton' ;
    rdfs:comment 'The carbon price applied to CO2 emissions for this record, expressed in dollars per ton. Used for carbon accounting, internal carbon pricing, and compliance with carbon pricing programs.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cemsMonitorStatus rdf:type rdf:Property ;
    rdfs:label 'Cems Monitor Status' ;
    rdfs:comment 'The operational status of the CEMS monitor during the reporting period. Operational indicates normal functioning. Out of service, calibration, maintenance, and failed QA indicate periods when direct measurement was unavailable and substitute data may have been used.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:controlEfficiencyPercent rdf:type rdf:Property ;
    rdfs:label 'Control Efficiency Percent' ;
    rdfs:comment 'The removal efficiency of emissions control equipment during the reporting period, expressed as a percentage. For example, a scrubber with 95% efficiency removes 95% of SO2 from flue gas.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:controlEquipmentStatus rdf:type rdf:Property ;
    rdfs:label 'Control Equipment Status' ;
    rdfs:comment 'The operational status of emissions control equipment (scrubbers, SCR, baghouses, etc.) during the reporting period. Bypassed or out-of-service status may result in higher emissions.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataQualityScore rdf:type rdf:Property ;
    rdfs:label 'Data Quality Score' ;
    rdfs:comment 'A calculated score representing the overall quality and reliability of this emissions record, typically ranging from 0 to 100. Factors include measurement method, CEMS status, QA test results, and data completeness.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dataSubstitutionFlag rdf:type rdf:Property ;
    rdfs:label 'Data Substitution Flag' ;
    rdfs:comment 'Boolean flag indicating whether substitute data was used for this emissions record due to CEMS monitor unavailability. True indicates substitute data was used; False indicates actual measured or calculated data.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ecmpsSubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Ecmps Submission Date' ;
    rdfs:comment 'The date this emissions record was submitted to EPA ECMPS for regulatory compliance reporting. Quarterly submissions are typically required within 30 days of quarter end.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ecmpsSubmissionStatus rdf:type rdf:Property ;
    rdfs:label 'Ecmps Submission Status' ;
    rdfs:comment 'The status of this emissions record in the EPA ECMPS reporting system. Tracks the lifecycle from pending submission through acceptance or rejection by EPA.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ecmpsTrackingNumber rdf:type rdf:Property ;
    rdfs:label 'Ecmps Tracking Number' ;
    rdfs:comment 'The unique tracking number assigned by EPA ECMPS upon submission. Used to track the status and history of the regulatory filing.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emissionQuantityTons rdf:type rdf:Property ;
    rdfs:label 'Emission Quantity Tons' ;
    rdfs:comment 'The total quantity of pollutant emitted during the reporting period, measured in short tons. This is the primary emissions metric reported to EPA ECMPS.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:emissionRateLbsPerMmbtu rdf:type rdf:Property ;
    rdfs:label 'Emission Rate Lbs Per Mmbtu' ;
    rdfs:comment 'The emission rate expressed as pounds of pollutant per million British Thermal Units (MMBTU) of heat input. This normalized rate allows comparison across units of different sizes and fuel types.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fuelConsumptionQuantity rdf:type rdf:Property ;
    rdfs:label 'Fuel Consumption Quantity' ;
    rdfs:comment 'The quantity of fuel consumed during the reporting period. Units vary by fuel type: tons for coal, MCF (Thousand Cubic Feet) for natural gas, barrels for oil.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fuelConsumptionUnit rdf:type rdf:Property ;
    rdfs:label 'Fuel Consumption Unit' ;
    rdfs:comment 'The unit of measure for fuel consumption quantity. Common units include tons (coal), MCF or Thousand Cubic Feet (natural gas), barrels (oil), or MMBTU (heat content).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ghgInventoryCategory rdf:type rdf:Property ;
    rdfs:label 'Ghg Inventory Category' ;
    rdfs:comment 'The GHG inventory category for this emissions record under EPA GHG reporting and corporate carbon accounting frameworks. Stationary combustion is the primary category for power generation.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grossGenerationMwh rdf:type rdf:Property ;
    rdfs:label 'Gross Generation Mwh' ;
    rdfs:comment 'The total gross electrical energy generated by the unit during the reporting period, measured in Megawatt-Hours (MWh). Used to calculate emission intensity per unit of generation.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:heatInputMmbtu rdf:type rdf:Property ;
    rdfs:label 'Heat Input Mmbtu' ;
    rdfs:comment 'The total heat input to the generating unit during the reporting period, measured in Million British Thermal Units (MMBTU). Used to calculate emission rates and heat rate efficiency.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:measurementMethod rdf:type rdf:Property ;
    rdfs:label 'Measurement Method' ;
    rdfs:comment 'The method used to determine emissions quantity. CEMS indicates Continuous Emissions Monitoring System direct measurement. Fuel factor uses fuel consumption and emission factors. Mass balance calculates emissions from material inputs and outputs. Engineering estimate and default factor are used when direct measurement is unavailable. Substitute indicates data substitution during monitor downtime.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operatingHours rdf:type rdf:Property ;
    rdfs:label 'Operating Hours' ;
    rdfs:comment 'The number of hours the generating unit was in operation during the reporting period. Used for availability calculations and emissions rate normalization.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pollutantConcentrationPpm rdf:type rdf:Property ;
    rdfs:label 'Pollutant Concentration Ppm' ;
    rdfs:comment 'The concentration of the pollutant in the flue gas as measured by CEMS, expressed in parts per million (ppm) or parts per billion (ppb) for mercury. Combined with stack flow rate to calculate mass emissions.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pollutantType rdf:type rdf:Property ;
    rdfs:label 'Pollutant Type' ;
    rdfs:comment 'The type of pollutant emitted. Standard pollutants tracked include Carbon Dioxide (CO2), Sulfur Dioxide (SO2), Nitrogen Oxides (NOx), Mercury (Hg), Particulate Matter 2.5 microns (PM2.5), and Methane (CH4).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qaCertificationDate rdf:type rdf:Property ;
    rdfs:label 'Qa Certification Date' ;
    rdfs:comment 'The date of the most recent CEMS quality assurance certification test. EPA requires periodic QA testing to ensure monitor accuracy.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:qaTestResult rdf:type rdf:Property ;
    rdfs:label 'Qa Test Result' ;
    rdfs:comment 'The result of the most recent CEMS quality assurance test. Passed indicates the monitor meets EPA accuracy requirements. Failed or conditional results may require corrective action and data substitution.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Rec Eligible Flag' ;
    rdfs:comment 'Boolean flag indicating whether the generation associated with this emissions record is eligible to generate Renewable Energy Certificates (RECs). Typically true for renewable generation with zero emissions.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rpsComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Rps Compliance Flag' ;
    rdfs:comment 'Boolean flag indicating whether this generation and its associated emissions are eligible for Renewable Portfolio Standard (RPS) compliance credit. True for renewable generation with zero or low emissions.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stackFlowRateScfh rdf:type rdf:Property ;
    rdfs:label 'Stack Flow Rate Scfh' ;
    rdfs:comment 'The volumetric flow rate of flue gas through the stack during the reporting period, measured in Standard Cubic Feet per Hour (SCFH). Used in CEMS calculations to convert pollutant concentration to mass emissions.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:substitutionMethod rdf:type rdf:Property ;
    rdfs:label 'Substitution Method' ;
    rdfs:comment 'The specific method used to substitute emissions data when CEMS was unavailable. Methods include maximum potential emissions, fuel-specific default factors, load-based estimation, or EPA-approved missing data procedures.' ;
    rdfs:domain ind:EmissionsRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sulfurContentPercent rdf:type rdf:Property ;
    rdfs:label 'Sulfur Content Percent' ;
    rdfs:comment 'The sulfur content of the fuel as a percentage by weight. Used to estimate SO2 emissions when CEMS is unavailable and to verify CEMS accuracy.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:environmentalPermitId rdf:type rdf:Property ;
    rdfs:label 'Environmental Permit Id' ;
    rdfs:comment 'Unique identifier for the environmental permit record. Primary key for the environmental permit entity.' ;
    rdfs:domain ind:EnvironmentalPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:complianceStatus rdf:type rdf:Property ;
    rdfs:label 'Compliance Status' ;
    rdfs:comment 'Current compliance status of the facility with respect to this environmental permit. Indicates whether the facility is operating within permitted limits and conditions.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:controlEfficiencyRequiredPercent rdf:type rdf:Property ;
    rdfs:label 'Control Efficiency Required Percent' ;
    rdfs:comment 'Minimum required control efficiency percentage for pollution control equipment as specified in the permit. Represents the percentage reduction in pollutant concentration that must be achieved.' ;
    rdfs:domain ind:EnvironmentalPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:controlEquipmentRequired rdf:type rdf:Property ;
    rdfs:label 'Control Equipment Required' ;
    rdfs:comment 'Description of pollution control equipment or technologies required by the permit to achieve compliance with emission or discharge limits. May include scrubbers, baghouses, electrostatic precipitators, cooling towers, or wastewater treatment systems.' ;
    rdfs:domain ind:EnvironmentalPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coolingWaterIntakeLimitMgd rdf:type rdf:Property ;
    rdfs:label 'Cooling Water Intake Limit Mgd' ;
    rdfs:comment 'Maximum allowable cooling water intake flow rate in million gallons per day as specified under Clean Water Act Section 316(b) requirements. Regulates intake structure impacts on aquatic organisms.' ;
    rdfs:domain ind:EnvironmentalPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:emissionLimitTonsPerYear rdf:type rdf:Property ;
    rdfs:label 'Emission Limit Tons Per Year' ;
    rdfs:comment 'Maximum allowable emission quantity in tons per year for the regulated pollutant as specified in the air permit. Applies to Title V and PSD air permits.' ;
    rdfs:domain ind:EnvironmentalPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:emissionRateLimitLbsPerMmbtu rdf:type rdf:Property ;
    rdfs:label 'Emission Rate Limit Lbs Per Mmbtu' ;
    rdfs:comment 'Maximum allowable emission rate in pounds per million BTU of heat input for the regulated pollutant. Common metric for fossil fuel combustion sources.' ;
    rdfs:domain ind:EnvironmentalPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:enforcementActionFlag rdf:type rdf:Property ;
    rdfs:label 'Enforcement Action Flag' ;
    rdfs:comment 'Indicates whether this permit is currently subject to regulatory enforcement action such as notice of violation, consent decree, or administrative order.' ;
    rdfs:domain ind:EnvironmentalPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hazardousWasteQuantityLimitTonsPerMonth rdf:type rdf:Property ;
    rdfs:label 'Hazardous Waste Quantity Limit Tons Per Month' ;
    rdfs:comment 'Maximum allowable quantity of hazardous waste that may be generated or stored per month under the RCRA permit. Applies to facilities with hazardous waste generation or treatment operations.' ;
    rdfs:domain ind:EnvironmentalPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:issuanceDate rdf:type rdf:Property ;
    rdfs:label 'Issuance Date' ;
    rdfs:comment 'Date on which the environmental permit was officially issued by the regulatory authority. Marks the beginning of the permit authorization period.' ;
    rdfs:domain ind:EnvironmentalPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:issuingAgency rdf:type rdf:Property ;
    rdfs:label 'Issuing Agency' ;
    rdfs:comment 'Name of the regulatory authority that issued the environmental permit. May be EPA, state Department of Environmental Quality (DEQ), or other environmental regulatory body with jurisdiction over the facility.' ;
    rdfs:domain ind:EnvironmentalPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuingAgencyCode rdf:type rdf:Property ;
    rdfs:label 'Issuing Agency Code' ;
    rdfs:comment 'Standardized code identifying the regulatory agency that issued the permit. Enables consistent tracking across multiple jurisdictions.' ;
    rdfs:domain ind:EnvironmentalPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastInspectionResult rdf:type rdf:Property ;
    rdfs:label 'Last Inspection Result' ;
    rdfs:comment 'Outcome of the most recent regulatory inspection. Indicates whether the facility was found in compliance or if violations were identified.' ;
    rdfs:domain ind:EnvironmentalPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastViolationDate rdf:type rdf:Property ;
    rdfs:label 'Last Violation Date' ;
    rdfs:comment 'Date of the most recent permit violation or non-compliance event. Critical for tracking compliance history and enforcement actions.' ;
    rdfs:domain ind:EnvironmentalPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:monitoringFrequency rdf:type rdf:Property ;
    rdfs:label 'Monitoring Frequency' ;
    rdfs:comment 'Required frequency of compliance monitoring and reporting as specified in the permit. Determines how often emissions, discharges, or waste parameters must be measured and reported. [ENUM-REF-CANDIDATE: continuous|hourly|daily|weekly|monthly|quarterly|annual — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:EnvironmentalPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:penaltyAmountUsd rdf:type rdf:Property ;
    rdfs:label 'Penalty Amount Usd' ;
    rdfs:comment 'Total monetary penalties assessed for permit violations in US dollars. Includes civil penalties, fines, and settlement amounts related to this permit.' ;
    rdfs:domain ind:EnvironmentalPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:permitConditions rdf:type rdf:Property ;
    rdfs:label 'Permit Conditions' ;
    rdfs:comment 'Detailed text of special conditions, operational restrictions, monitoring requirements, and compliance stipulations imposed by the regulatory authority as part of the permit authorization.' ;
    rdfs:domain ind:EnvironmentalPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:permitFeeAmountUsd rdf:type rdf:Property ;
    rdfs:label 'Permit Fee Amount Usd' ;
    rdfs:comment 'Annual or one-time permit fee paid to the regulatory authority in US dollars. Title V permits typically require annual fees based on actual emissions.' ;
    rdfs:domain ind:EnvironmentalPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:permitName rdf:type rdf:Property ;
    rdfs:label 'Permit Name' ;
    rdfs:comment 'Descriptive name or title of the environmental permit as documented in the permit authorization.' ;
    rdfs:domain ind:EnvironmentalPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:permitStatus rdf:type rdf:Property ;
    rdfs:label 'Permit Status' ;
    rdfs:comment 'Current lifecycle status of the environmental permit. Indicates whether the permit is active and in compliance, expired and requiring renewal, pending regulatory review, suspended due to violations, or revoked by the issuing authority.' ;
    rdfs:domain ind:EnvironmentalPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:permitType rdf:type rdf:Property ;
    rdfs:label 'Permit Type' ;
    rdfs:comment 'Classification of the environmental permit by regulatory program. Categorizes the permit into major environmental compliance frameworks such as Title V air operating permits, NPDES water discharge permits, PSD construction permits, state air quality permits, hazardous waste permits, or 316(b) cooling water intake structure permits.' ;
    rdfs:domain ind:EnvironmentalPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publicNoticeDate rdf:type rdf:Property ;
    rdfs:label 'Public Notice Date' ;
    rdfs:comment 'Date on which public notice of the permit application or renewal was published. Marks the beginning of the public comment period.' ;
    rdfs:domain ind:EnvironmentalPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:publicNoticeRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Public Notice Required Flag' ;
    rdfs:comment 'Indicates whether public notice and comment period is required for permit issuance or renewal under applicable regulations. Typically required for major source permits.' ;
    rdfs:domain ind:EnvironmentalPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:renewalApplicationDeadline rdf:type rdf:Property ;
    rdfs:label 'Renewal Application Deadline' ;
    rdfs:comment 'Deadline by which the permit renewal application must be submitted to the regulatory authority. Typically 180 days before expiration for Title V permits.' ;
    rdfs:domain ind:EnvironmentalPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:renewalDate rdf:type rdf:Property ;
    rdfs:label 'Renewal Date' ;
    rdfs:comment 'Date on which the permit was last renewed or is scheduled for renewal. Supports proactive permit renewal management and compliance planning.' ;
    rdfs:domain ind:EnvironmentalPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:responsiblePartyName rdf:type rdf:Property ;
    rdfs:label 'Responsible Party Name' ;
    rdfs:comment 'Name of the individual or organization legally responsible for permit compliance. Typically the facility operator or designated responsible official.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsiblePartyTitle rdf:type rdf:Property ;
    rdfs:label 'Responsible Party Title' ;
    rdfs:comment 'Job title or position of the responsible party. Common titles include Environmental Manager, Plant Manager, or Compliance Officer.' ;
    rdfs:domain ind:EnvironmentalPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:violationCount rdf:type rdf:Property ;
    rdfs:label 'Violation Count' ;
    rdfs:comment 'Total number of permit violations recorded for this permit during the current permit term. Supports compliance performance tracking and enforcement risk assessment.' ;
    rdfs:domain ind:EnvironmentalPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:waterDischargeLimitMgd rdf:type rdf:Property ;
    rdfs:label 'Water Discharge Limit Mgd' ;
    rdfs:comment 'Maximum allowable water discharge flow rate in million gallons per day as specified in the NPDES permit. Applies to cooling water discharge and wastewater effluent.' ;
    rdfs:domain ind:EnvironmentalPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:waterTemperatureLimitF rdf:type rdf:Property ;
    rdfs:label 'Water Temperature Limit F' ;
    rdfs:comment 'Maximum allowable temperature in degrees Fahrenheit for water discharged under the NPDES permit. Critical for thermal pollution control at steam electric generating facilities.' ;
    rdfs:domain ind:EnvironmentalPermit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fuelConsumptionId rdf:type rdf:Property ;
    rdfs:label 'Fuel Consumption Id' ;
    rdfs:comment 'Unique identifier for each fuel consumption record. Primary key for the fuel consumption data product.' ;
    rdfs:domain ind:FuelConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fuelContractId rdf:type rdf:Property ;
    rdfs:label 'Fuel Contract Id' ;
    rdfs:comment 'Foreign key reference to the fuel supply contract under which the fuel was purchased. Links to contract master data for cost allocation and contract performance tracking.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FuelContract .

ind:goodsReceiptId rdf:type rdf:Property ;
    rdfs:label 'Goods Receipt Id' ;
    rdfs:comment 'Foreign key linking to supply.goods_receipt. Business justification: Each fuel consumption event must trace to the goods receipt that brought that fuel batch into inventory for audit trail and quality tracking. Fuel quality issue root cause analysis requires tracing co' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GoodsReceipt .

ind:cemsReconciliationFlag rdf:type rdf:Property ;
    rdfs:label 'Cems Reconciliation Flag' ;
    rdfs:comment 'Boolean flag indicating whether this fuel consumption record has been reconciled with EPA CEMS (Continuous Emissions Monitoring System) emissions data. True indicates reconciliation is complete; False indicates pending reconciliation.' ;
    rdfs:domain ind:FuelConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ch4EmissionsFactor rdf:type rdf:Property ;
    rdfs:label 'Ch4 Emissions Factor' ;
    rdfs:comment 'The methane emissions factor applied to the fuel type, expressed in pounds of CH4 per MMBTU of fuel consumed. Used to calculate total CH4 emissions for EPA GHG reporting and climate disclosure.' ;
    rdfs:domain ind:FuelConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:co2EmissionsFactor rdf:type rdf:Property ;
    rdfs:label 'Co2 Emissions Factor' ;
    rdfs:comment 'The carbon dioxide emissions factor applied to the fuel type, expressed in pounds of CO2 per MMBTU of fuel consumed. Used to calculate total CO2 emissions for EPA GHG reporting and RPS compliance.' ;
    rdfs:domain ind:FuelConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:consumptionDate rdf:type rdf:Property ;
    rdfs:label 'Consumption Date' ;
    rdfs:comment 'The calendar date on which the fuel was consumed by the generating unit. Used for daily fuel tracking and reconciliation.' ;
    rdfs:domain ind:FuelConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:consumptionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Consumption Timestamp' ;
    rdfs:comment 'Precise timestamp when the fuel consumption measurement was recorded, typically from SCADA or DCS systems. Supports real-time fuel monitoring and interval-level analysis.' ;
    rdfs:domain ind:FuelConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dataQualityCode rdf:type rdf:Property ;
    rdfs:label 'Data Quality Code' ;
    rdfs:comment 'Code indicating the quality and validation status of the fuel consumption record. Verified indicates the data has passed all validation checks; Estimated indicates the data was calculated or interpolated; Provisional indicates preliminary data subject to revision; Suspect indicates data that failed quality checks.' ;
    rdfs:domain ind:FuelConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataSource rdf:type rdf:Property ;
    rdfs:label 'Data Source' ;
    rdfs:comment 'The source system or method from which the fuel consumption data was captured (e.g., SCADA, DCS, manual entry, EMS, PI Historian). Used for data quality assessment and audit trail.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eiaReportingFlag rdf:type rdf:Property ;
    rdfs:label 'Eia Reporting Flag' ;
    rdfs:comment 'Boolean flag indicating whether this fuel consumption record has been included in EIA Form 923 monthly fuel consumption reporting. True indicates the record has been reported; False indicates it has not yet been reported.' ;
    rdfs:domain ind:FuelConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:facRecoveryEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Fac Recovery Eligible Flag' ;
    rdfs:comment 'Boolean flag indicating whether the fuel costs associated with this consumption record are eligible for recovery through the Fuel Adjustment Clause (FAC) mechanism. True indicates eligible; False indicates not eligible (e.g., due to imprudence findings or contract limitations).' ;
    rdfs:domain ind:FuelConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fuelCostPerUnit rdf:type rdf:Property ;
    rdfs:label 'Fuel Cost Per Unit' ;
    rdfs:comment 'The delivered cost of fuel per unit of measure (e.g., dollars per ton, dollars per MCF, dollars per barrel). Includes transportation and handling costs. Used for fuel cost allocation and FAC (Fuel Adjustment Clause) calculations.' ;
    rdfs:domain ind:FuelConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fuelSubtype rdf:type rdf:Property ;
    rdfs:label 'Fuel Subtype' ;
    rdfs:comment 'Detailed subclassification of fuel type (e.g., bituminous coal, sub-bituminous coal, anthracite, pipeline natural gas, LNG, No. 2 fuel oil, No. 6 fuel oil). Used for precise heat content and emissions factor application.' ;
    rdfs:domain ind:FuelConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:generationOutputMwh rdf:type rdf:Property ;
    rdfs:label 'Generation Output Mwh' ;
    rdfs:comment 'The gross electrical energy output produced by the generating unit during the fuel consumption period, measured in Megawatt-Hours (MWh). Used as the denominator in heat rate calculation.' ;
    rdfs:domain ind:FuelConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:heatContentPerUnit rdf:type rdf:Property ;
    rdfs:label 'Heat Content Per Unit' ;
    rdfs:comment 'The average heat content (energy value) of the fuel per unit of measure, expressed in BTU per unit (e.g., BTU per ton, BTU per MCF, BTU per barrel). Used to convert physical fuel quantity to energy equivalent.' ;
    rdfs:domain ind:FuelConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:noxEmissionsFactor rdf:type rdf:Property ;
    rdfs:label 'Nox Emissions Factor' ;
    rdfs:comment 'The nitrogen oxides emissions factor applied to the fuel type, expressed in pounds of NOx per MMBTU of fuel consumed. Used to calculate total NOx emissions for EPA Clean Air Act compliance and ozone transport region reporting.' ;
    rdfs:domain ind:FuelConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:operatingMode rdf:type rdf:Property ;
    rdfs:label 'Operating Mode' ;
    rdfs:comment 'The operating mode of the generating unit during the fuel consumption period. Affects fuel efficiency and heat rate. Used for operational analysis and dispatch optimization.' ;
    rdfs:domain ind:FuelConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:so2EmissionsFactor rdf:type rdf:Property ;
    rdfs:label 'So2 Emissions Factor' ;
    rdfs:comment 'The sulfur dioxide emissions factor applied to the fuel type, expressed in pounds of SO2 per MMBTU of fuel consumed. Used to calculate total SO2 emissions for EPA Clean Air Act compliance and acid rain program reporting.' ;
    rdfs:domain ind:FuelConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalCo2EmissionsTons rdf:type rdf:Property ;
    rdfs:label 'Total Co2 Emissions Tons' ;
    rdfs:comment 'The total carbon dioxide emissions produced from the fuel consumed, calculated as (total_heat_content_mmbtu × co2_emissions_factor) ÷ 2000. Expressed in short tons. Primary metric for EPA GHG reporting and carbon accounting.' ;
    rdfs:domain ind:FuelConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalFuelCostUsd rdf:type rdf:Property ;
    rdfs:label 'Total Fuel Cost Usd' ;
    rdfs:comment 'The total cost of fuel consumed during the operating period, expressed in US dollars. Calculated as quantity_consumed × fuel_cost_per_unit. Used for FAC cost recovery, rate case preparation, and financial reporting.' ;
    rdfs:domain ind:FuelConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalHeatContentMmbtu rdf:type rdf:Property ;
    rdfs:label 'Total Heat Content Mmbtu' ;
    rdfs:comment 'The total energy content of the fuel consumed, expressed in Million British Thermal Units (MMBTU). Calculated as quantity_consumed × heat_content_per_unit. Primary metric for heat rate calculation and fuel cost recovery.' ;
    rdfs:domain ind:FuelConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalNoxEmissionsTons rdf:type rdf:Property ;
    rdfs:label 'Total Nox Emissions Tons' ;
    rdfs:comment 'The total nitrogen oxides emissions produced from the fuel consumed, calculated as (total_heat_content_mmbtu × nox_emissions_factor) ÷ 2000. Expressed in short tons. Used for EPA Clean Air Act compliance and ozone transport region reporting.' ;
    rdfs:domain ind:FuelConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalSo2EmissionsTons rdf:type rdf:Property ;
    rdfs:label 'Total So2 Emissions Tons' ;
    rdfs:comment 'The total sulfur dioxide emissions produced from the fuel consumed, calculated as (total_heat_content_mmbtu × so2_emissions_factor) ÷ 2000. Expressed in short tons. Used for EPA Clean Air Act compliance and acid rain program reporting.' ;
    rdfs:domain ind:FuelConsumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deliveryPointPlantId rdf:type rdf:Property ;
    rdfs:label 'Delivery Point Plant Id' ;
    rdfs:comment 'Identifier of the generation facility where fuel is to be delivered. Plant-specific delivery terms are critical for transportation cost allocation and logistics planning.' ;
    rdfs:domain ind:FuelContract ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Plant .

ind:primaryFuelVendorId rdf:type rdf:Property ;
    rdfs:label 'Primary Fuel Vendor Id' ;
    rdfs:comment 'Identifier for the fuel supplier party providing coal, natural gas, nuclear fuel, or oil under this contract.' ;
    rdfs:domain ind:FuelContract ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:prudencyReviewId rdf:type rdf:Property ;
    rdfs:label 'Prudency Review Id' ;
    rdfs:comment 'Foreign key linking to regulatory.prudency_review. Business justification: Fuel procurement contracts are subject to prudency review to determine if costs are reasonable and recoverable through rates. Linking contracts to their prudency reviews supports fuel adjustment claus' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PrudencyReview .

ind:wholesaleCounterpartyId rdf:type rdf:Property ;
    rdfs:label 'Wholesale Counterparty Id' ;
    rdfs:comment 'Foreign key linking to market.wholesale_counterparty. Business justification: Fuel contracts with wholesale market participants require tracking counterparty credit ratings, FERC market-based rate authorizations, master agreements, and collateral requirements for bilateral trad' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WholesaleCounterparty .

ind:ashContentLimitPercent rdf:type rdf:Property ;
    rdfs:label 'Ash Content Limit Percent' ;
    rdfs:comment 'Maximum allowable ash content as a percentage of fuel weight. High ash content reduces combustion efficiency and increases disposal costs. Primarily applicable to coal contracts.' ;
    rdfs:domain ind:FuelContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:basePrice rdf:type rdf:Property ;
    rdfs:label 'Base Price' ;
    rdfs:comment 'Base price per unit of fuel under this contract. For fixed-price contracts, this is the contract price. For index or escalation contracts, this is the starting reference price. Currency is USD unless otherwise specified.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:btuContentSpecification rdf:type rdf:Property ;
    rdfs:label 'Btu Content Specification' ;
    rdfs:comment 'Contractually specified heat content of the fuel in British Thermal Units per unit (e.g., BTU per pound for coal, BTU per cubic foot for gas). Critical for heat rate calculations and fuel quality compliance.' ;
    rdfs:domain ind:FuelContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contractAmendmentCount rdf:type rdf:Property ;
    rdfs:label 'Contract Amendment Count' ;
    rdfs:comment 'Number of formal amendments made to the original contract. Tracks contract change history for audit and compliance purposes.' ;
    rdfs:domain ind:FuelContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contractName rdf:type rdf:Property ;
    rdfs:label 'Contract Name' ;
    rdfs:comment 'Descriptive name of the fuel supply contract for business reference and reporting purposes.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractNumber rdf:type rdf:Property ;
    rdfs:label 'Contract Number' ;
    rdfs:comment 'Externally-known business identifier for the fuel supply contract. Used in procurement documentation, regulatory filings, and supplier communications.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractOwnerEmployeeCode rdf:type rdf:Property ;
    rdfs:label 'Contract Owner Employee Code' ;
    rdfs:comment 'Identifier of the utility employee responsible for managing this fuel supply contract. Typically a fuel procurement manager or supply chain analyst.' ;
    rdfs:domain ind:FuelContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:contractStatus rdf:type rdf:Property ;
    rdfs:label 'Contract Status' ;
    rdfs:comment 'Current lifecycle state of the fuel supply contract. Active contracts are in force; expired contracts have passed their end date; terminated contracts were ended early.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractType rdf:type rdf:Property ;
    rdfs:label 'Contract Type' ;
    rdfs:comment 'Classification of the fuel supply agreement based on delivery commitment and flexibility. Firm contracts guarantee supply; interruptible contracts allow curtailment; spot contracts are short-term market purchases.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractValueTotal rdf:type rdf:Property ;
    rdfs:label 'Contract Value Total' ;
    rdfs:comment 'Total estimated monetary value of the fuel contract over its full term, calculated as contracted volume multiplied by base price. Used for CAPEX/OPEX planning and regulatory rate case cost studies. Currency is USD.' ;
    rdfs:domain ind:FuelContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contractedVolume rdf:type rdf:Property ;
    rdfs:label 'Contracted Volume' ;
    rdfs:comment 'Total quantity of fuel committed under this contract for the specified period. Units vary by fuel type: tons for coal, MCF or MMBTU for natural gas, assemblies for nuclear fuel, barrels for oil.' ;
    rdfs:domain ind:FuelContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deliveryPeriod rdf:type rdf:Property ;
    rdfs:label 'Delivery Period' ;
    rdfs:comment 'Frequency or time period over which the contracted volume is to be delivered. Supports burn forecast modeling and inventory planning.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryPointDescription rdf:type rdf:Property ;
    rdfs:label 'Delivery Point Description' ;
    rdfs:comment 'Textual description of the fuel delivery location, including plant name, receiving facility, or pipeline interconnection point.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forceMajeureProvisionFlag rdf:type rdf:Property ;
    rdfs:label 'Force Majeure Provision Flag' ;
    rdfs:comment 'Indicates whether the contract includes force majeure clauses allowing suspension of obligations due to unforeseeable circumstances (natural disasters, strikes, regulatory changes).' ;
    rdfs:domain ind:FuelContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastAmendmentDate rdf:type rdf:Property ;
    rdfs:label 'Last Amendment Date' ;
    rdfs:comment 'Date of the most recent contract amendment. Null if no amendments have been made.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:minimumTakeObligation rdf:type rdf:Property ;
    rdfs:label 'Minimum Take Obligation' ;
    rdfs:comment 'Minimum quantity of fuel the utility is obligated to purchase during the contract period, regardless of actual need. Used for supply commitment analysis and FAC cost recovery.' ;
    rdfs:domain ind:FuelContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumTakeUnitOfMeasure rdf:type rdf:Property ;
    rdfs:label 'Minimum Take Unit Of Measure' ;
    rdfs:comment 'Unit of measure for the minimum take obligation quantity.' ;
    rdfs:domain ind:FuelContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:moistureContentLimitPercent rdf:type rdf:Property ;
    rdfs:label 'Moisture Content Limit Percent' ;
    rdfs:comment 'Maximum allowable moisture content as a percentage of fuel weight. Excess moisture reduces heat content and combustion efficiency. Primarily applicable to coal and biomass contracts.' ;
    rdfs:domain ind:FuelContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentTermsDays rdf:type rdf:Property ;
    rdfs:label 'Payment Terms Days' ;
    rdfs:comment 'Number of days from invoice date within which payment is due to the supplier. Standard terms are Net 30, Net 60, etc.' ;
    rdfs:domain ind:FuelContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priceIndexReference rdf:type rdf:Property ;
    rdfs:label 'Price Index Reference' ;
    rdfs:comment 'Name of the published market index used for index-based pricing (e.g., Henry Hub, NYMEX, Platts Coal Index). Null for fixed-price contracts.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priceUnitOfMeasure rdf:type rdf:Property ;
    rdfs:label 'Price Unit Of Measure' ;
    rdfs:comment 'Unit of measure for the fuel price. Must align with volume unit of measure for cost calculations.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pricingMechanism rdf:type rdf:Property ;
    rdfs:label 'Pricing Mechanism' ;
    rdfs:comment 'Method by which fuel price is determined. Fixed = constant price; index = tied to published market index (e.g., Henry Hub for gas); cost-plus = supplier cost plus markup; escalation = base price with periodic adjustments.' ;
    rdfs:domain ind:FuelContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Approval Date' ;
    rdfs:comment 'Date when the contract received regulatory approval from the PUC or FERC. Null if approval is not required or not yet granted.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryApprovalRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Approval Required Flag' ;
    rdfs:comment 'Indicates whether this fuel contract requires Public Utility Commission (PUC) or FERC approval before execution. Large or long-term contracts often require regulatory review.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:renewableFuelFlag rdf:type rdf:Property ;
    rdfs:label 'Renewable Fuel Flag' ;
    rdfs:comment 'Indicates whether the fuel qualifies as renewable under state Renewable Portfolio Standard (RPS) regulations. Applicable to biomass, biogas, and renewable natural gas contracts.' ;
    rdfs:domain ind:FuelContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rpsEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Rps Eligible Flag' ;
    rdfs:comment 'Indicates whether fuel deliveries under this contract are eligible for Renewable Portfolio Standard (RPS) compliance credit. Supports RPS tracking and Renewable Energy Certificate (REC) generation.' ;
    rdfs:domain ind:Generation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sulfurContentLimitPercent rdf:type rdf:Property ;
    rdfs:label 'Sulfur Content Limit Percent' ;
    rdfs:comment 'Maximum allowable sulfur content as a percentage of fuel weight. Enforced to meet EPA emissions standards and state air quality regulations. Primarily applicable to coal and oil contracts.' ;
    rdfs:domain ind:FuelContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transportationArrangement rdf:type rdf:Property ;
    rdfs:label 'Transportation Arrangement' ;
    rdfs:comment 'Mode and responsibility for transporting fuel from supplier to delivery point. Pipeline (natural gas), rail/barge/truck (coal, oil). Supplier-arranged = supplier bears transportation cost and risk; utility-arranged = utility contracts transportation separately.' ;
    rdfs:domain ind:FuelContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transportationCostResponsibility rdf:type rdf:Property ;
    rdfs:label 'Transportation Cost Responsibility' ;
    rdfs:comment 'Party responsible for bearing fuel transportation costs. Impacts delivered fuel cost and FAC cost recovery calculations.' ;
    rdfs:domain ind:FuelContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:volumeUnitOfMeasure rdf:type rdf:Property ;
    rdfs:label 'Volume Unit Of Measure' ;
    rdfs:comment 'Unit of measure for the contracted fuel volume. MCF = Thousand Cubic Feet (gas), MMBTU = Million British Thermal Units (energy content), assemblies (nuclear fuel). [ENUM-REF-CANDIDATE: tons|mcf|mmbtu|barrels|assemblies|kg|mwh_thermal — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:FuelContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fuelInventoryId rdf:type rdf:Property ;
    rdfs:label 'Fuel Inventory Id' ;
    rdfs:comment 'Unique identifier for the fuel inventory record. Primary key for the fuel inventory product.' ;
    rdfs:domain ind:FuelInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:warehouseId rdf:type rdf:Property ;
    rdfs:label 'Warehouse Id' ;
    rdfs:comment 'Foreign key linking to supply.warehouse. Business justification: Fuel storage at generation plants uses centralized warehouse management for inventory tracking, safety stock monitoring, and physical count reconciliation. Monthly fuel inventory reconciliation proces' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Warehouse .

ind:ashContentPercent rdf:type rdf:Property ;
    rdfs:label 'Ash Content Percent' ;
    rdfs:comment 'Percentage of ash by weight in the fuel (primarily applicable to coal and biomass). Affects combustion efficiency and waste disposal requirements.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:averageDailyConsumptionRate rdf:type rdf:Property ;
    rdfs:label 'Average Daily Consumption Rate' ;
    rdfs:comment 'Average daily fuel consumption rate at the facility, measured in the same unit as quantity_on_hand. Used to calculate days of burn remaining and forecast fuel needs.' ;
    rdfs:domain ind:FuelInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:batchNumber rdf:type rdf:Property ;
    rdfs:label 'Batch Number' ;
    rdfs:comment 'Batch or lot number assigned to the fuel shipment for traceability and quality control. Enables tracking of fuel quality issues back to specific deliveries.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:btuContent rdf:type rdf:Property ;
    rdfs:label 'Btu Content' ;
    rdfs:comment 'Heat content of the fuel measured in BTU per unit (e.g., BTU per pound for coal, BTU per cubic foot for gas). Critical for heat rate calculations and energy output forecasting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:daysOfBurnRemaining rdf:type rdf:Property ;
    rdfs:label 'Days Of Burn Remaining' ;
    rdfs:comment 'Estimated number of days the current fuel inventory will last at the current consumption rate. Calculated metric used for fuel procurement planning and supply chain risk management.' ;
    rdfs:domain ind:FuelInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:economicOrderQuantity rdf:type rdf:Property ;
    rdfs:label 'Economic Order Quantity' ;
    rdfs:comment 'Optimal order quantity that minimizes total inventory holding costs and ordering costs. Used for fuel procurement optimization and cost management.' ;
    rdfs:domain ind:FuelInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:enrichmentLevelPercent rdf:type rdf:Property ;
    rdfs:label 'Enrichment Level Percent' ;
    rdfs:comment 'Percentage of fissile isotope U-235 in nuclear fuel assemblies. Applicable only to nuclear fuel inventory. Critical for reactor physics and fuel cycle planning.' ;
    rdfs:domain ind:FuelInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:environmentalPermitNumber rdf:type rdf:Property ;
    rdfs:label 'Environmental Permit Number' ;
    rdfs:comment 'Permit number issued by EPA or state environmental agency authorizing the storage and use of the fuel type. Required for compliance with Clean Air Act and state environmental regulations.' ;
    rdfs:domain ind:FuelInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Fac Eligible Flag' ;
    rdfs:comment 'Boolean flag indicating whether the fuel costs are eligible for recovery through the Fuel Adjustment Clause mechanism in customer rates. True indicates FAC-eligible, False indicates costs must be absorbed or recovered through base rates.' ;
    rdfs:domain ind:FuelInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fuelGrade rdf:type rdf:Property ;
    rdfs:label 'Fuel Grade' ;
    rdfs:comment 'Grade or quality classification of the fuel (e.g., bituminous coal, sub-bituminous coal, pipeline-quality natural gas, enriched uranium U-235). Indicates fuel specification and quality tier.' ;
    rdfs:domain ind:FuelInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ghgEmissionsFactor rdf:type rdf:Property ;
    rdfs:label 'Ghg Emissions Factor' ;
    rdfs:comment 'Greenhouse gas emissions factor for the fuel type, measured in metric tons of CO2 equivalent per unit of fuel consumed. Used for GHG emissions reporting and carbon accounting under EPA regulations.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inventoryDate rdf:type rdf:Property ;
    rdfs:label 'Inventory Date' ;
    rdfs:comment 'Date when the inventory quantity was measured or recorded. Represents the as-of date for the inventory snapshot.' ;
    rdfs:domain ind:FuelInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:inventoryStatus rdf:type rdf:Property ;
    rdfs:label 'Inventory Status' ;
    rdfs:comment 'Current status of the fuel inventory. Available indicates fuel ready for consumption, reserved indicates fuel allocated to specific generation schedule, in_transit indicates fuel en route to storage, quarantined indicates fuel held for quality testing, depleted indicates storage location is empty.' ;
    rdfs:domain ind:FuelInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastPhysicalCountDate rdf:type rdf:Property ;
    rdfs:label 'Last Physical Count Date' ;
    rdfs:comment 'Date when the last physical inventory count was performed at the storage location. Used for inventory reconciliation and audit compliance.' ;
    rdfs:domain ind:FuelInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:maximumStorageCapacity rdf:type rdf:Property ;
    rdfs:label 'Maximum Storage Capacity' ;
    rdfs:comment 'Maximum fuel quantity that can be physically stored at the location. Represents the storage facility design capacity in the same unit as quantity_on_hand.' ;
    rdfs:domain ind:FuelInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumOperatingReserve rdf:type rdf:Property ;
    rdfs:label 'Minimum Operating Reserve' ;
    rdfs:comment 'Minimum fuel quantity that must be maintained to ensure continuous plant operations and meet reliability requirements. Measured in the same unit as quantity_on_hand.' ;
    rdfs:domain ind:FuelInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:moistureContentPercent rdf:type rdf:Property ;
    rdfs:label 'Moisture Content Percent' ;
    rdfs:comment 'Percentage of moisture by weight in the fuel. Impacts combustion efficiency, heat rate, and fuel handling characteristics.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nitrogenContentPercent rdf:type rdf:Property ;
    rdfs:label 'Nitrogen Content Percent' ;
    rdfs:comment 'Percentage of nitrogen by weight in the fuel. Relevant for NOx emissions calculations and environmental compliance.' ;
    rdfs:domain ind:FuelInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:qualityCertificationNumber rdf:type rdf:Property ;
    rdfs:label 'Quality Certification Number' ;
    rdfs:comment 'Certification or test report number from the laboratory that performed fuel quality analysis. Provides traceability to quality assurance documentation.' ;
    rdfs:domain ind:FuelInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityTestDate rdf:type rdf:Property ;
    rdfs:label 'Quality Test Date' ;
    rdfs:comment 'Date when the most recent fuel quality test was performed. Quality parameters such as BTU content, sulfur content, and ash content are validated through periodic testing.' ;
    rdfs:domain ind:FuelInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:quantityOnHand rdf:type rdf:Property ;
    rdfs:label 'Quantity On Hand' ;
    rdfs:comment 'Current quantity of fuel in inventory at the storage location. Measured in the unit specified in unit_of_measure field.' ;
    rdfs:domain ind:FuelInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:receiptDate rdf:type rdf:Property ;
    rdfs:label 'Receipt Date' ;
    rdfs:comment 'Date when the fuel was received at the storage location. Used for inventory aging analysis and FIFO/LIFO accounting methods.' ;
    rdfs:domain ind:FuelInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reorderPoint rdf:type rdf:Property ;
    rdfs:label 'Reorder Point' ;
    rdfs:comment 'Inventory level at which a new fuel order should be triggered to maintain adequate supply. Used for automated procurement planning and supply chain optimization.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:storagePressure rdf:type rdf:Property ;
    rdfs:label 'Storage Pressure' ;
    rdfs:comment 'Current pressure in the fuel storage container, measured in pounds per square inch (PSI). Applicable to natural gas storage holders and pressurized fuel systems.' ;
    rdfs:domain ind:FuelInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:storageTemperature rdf:type rdf:Property ;
    rdfs:label 'Storage Temperature' ;
    rdfs:comment 'Current temperature of the fuel storage location, measured in degrees Fahrenheit. Relevant for liquid fuels (oil, diesel) and nuclear fuel pool cooling monitoring.' ;
    rdfs:domain ind:FuelInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalInventoryValue rdf:type rdf:Property ;
    rdfs:label 'Total Inventory Value' ;
    rdfs:comment 'Total monetary value of the fuel inventory at the storage location, calculated as quantity_on_hand multiplied by unit_cost. Reported in USD for financial accounting and regulatory rate case filings.' ;
    rdfs:domain ind:FuelInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:varianceQuantity rdf:type rdf:Property ;
    rdfs:label 'Variance Quantity' ;
    rdfs:comment 'Difference between book inventory and physical count from the last inventory reconciliation. Positive values indicate overage, negative values indicate shortage. Measured in the same unit as quantity_on_hand.' ;
    rdfs:domain ind:FuelInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cpcnDocketId rdf:type rdf:Property ;
    rdfs:label 'Cpcn Docket Id' ;
    rdfs:comment 'Foreign key linking to regulatory.docket. Business justification: Individual generating units often require separate CPCN approval, especially for capacity additions or repowering projects. Linking units to their authorizing dockets supports cost recovery filings, p' ;
    rdfs:domain ind:Generation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Docket .

ind:ancillaryServicesCapable rdf:type rdf:Property ;
    rdfs:label 'Ancillary Services Capable' ;
    rdfs:comment 'Comma-separated list of ancillary services the generating unit is technically capable of providing (e.g., regulation, spinning reserve, non-spinning reserve, voltage support, black start).' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:balancingAuthority rdf:type rdf:Property ;
    rdfs:label 'Balancing Authority' ;
    rdfs:comment 'NERC-registered Balancing Authority responsible for integrating resource plans, maintaining load-interchange-generation balance, and supporting interconnection frequency in real time for the area where this unit operates.' ;
    rdfs:domain ind:Generation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:blackStartCapable rdf:type rdf:Property ;
    rdfs:label 'Black Start Capable' ;
    rdfs:comment 'Indicates whether the generating unit has black start capability, meaning it can start without external electrical supply and help restore the grid after a blackout. True if capable, False otherwise.' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:capacityFactorTargetPct rdf:type rdf:Property ;
    rdfs:label 'Capacity Factor Target Pct' ;
    rdfs:comment 'Target or expected capacity factor for the generating unit, expressed as a percentage. Capacity factor is the ratio of actual output over a period to the maximum possible output if the unit operated at full capacity continuously.' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:carbonCaptureEnabled rdf:type rdf:Property ;
    rdfs:label 'Carbon Capture Enabled' ;
    rdfs:comment 'Indicates whether the generating unit is equipped with carbon capture and storage (CCS) or carbon capture and utilization (CCU) technology. True if equipped, False otherwise.' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commercialOperationDate rdf:type rdf:Property ;
    rdfs:label 'Commercial Operation Date' ;
    rdfs:comment 'Date when the generating unit first entered commercial service and began producing electricity for sale or delivery to the grid.' ;
    rdfs:domain ind:Generation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dispatchPriority rdf:type rdf:Property ;
    rdfs:label 'Dispatch Priority' ;
    rdfs:comment 'Numeric priority ranking used by the Energy Management System (EMS) for economic dispatch and unit commitment decisions. Lower numbers indicate higher priority.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eiaGeneratorCode rdf:type rdf:Property ;
    rdfs:label 'Eia Generator Code' ;
    rdfs:comment 'Energy Information Administration (EIA) unique identifier for the generator, used in EIA-860 and EIA-923 regulatory reporting.' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emissionsControlEquipment rdf:type rdf:Property ;
    rdfs:label 'Emissions Control Equipment' ;
    rdfs:comment 'Description of installed emissions control technologies (e.g., Selective Catalytic Reduction for NOx, Flue Gas Desulfurization for SO2, Electrostatic Precipitator for particulates, Carbon Capture and Storage).' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fuelPrimary rdf:type rdf:Property ;
    rdfs:label 'Fuel Primary' ;
    rdfs:comment 'Primary fuel type consumed by the generating unit (e.g., natural gas, coal, uranium, wind, solar, water). Aligns with EIA fuel type codes.' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fuelSecondary rdf:type rdf:Property ;
    rdfs:label 'Fuel Secondary' ;
    rdfs:comment 'Secondary or backup fuel type that the unit can consume, if applicable. Null for units with single fuel capability.' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interconnectionVoltageKv rdf:type rdf:Property ;
    rdfs:label 'Interconnection Voltage Kv' ;
    rdfs:comment 'Voltage level in kilovolts (kV) at which the generating unit interconnects to the transmission or distribution grid.' ;
    rdfs:domain ind:Generation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastMajorOverhaulDate rdf:type rdf:Property ;
    rdfs:label 'Last Major Overhaul Date' ;
    rdfs:comment 'Date of the most recent major overhaul, refurbishment, or life-extension project performed on the generating unit.' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:minimumStableLoadMw rdf:type rdf:Property ;
    rdfs:label 'Minimum Stable Load Mw' ;
    rdfs:comment 'Minimum output level at which the generating unit can operate continuously in a stable manner without shutting down, measured in Megawatts (MW).' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mustRunDesignation rdf:type rdf:Property ;
    rdfs:label 'Must Run Designation' ;
    rdfs:comment 'Indicates whether the generating unit has been designated as a must-run or reliability-must-run (RMR) unit by the RTO/ISO or Balancing Authority for grid reliability purposes. True if designated, False otherwise.' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nameplateCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Nameplate Capacity Mw' ;
    rdfs:comment 'Maximum rated output of the generator under ideal conditions as specified by the manufacturer, measured in Megawatts (MW).' ;
    rdfs:domain ind:Generation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nercUnitCode rdf:type rdf:Property ;
    rdfs:label 'Nerc Unit Code' ;
    rdfs:comment 'North American Electric Reliability Corporation (NERC) unique identifier for the generating unit, used in NERC GADS reporting and reliability coordination.' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netSummerCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Net Summer Capacity Mw' ;
    rdfs:comment 'Maximum net output the unit can sustain over a specified period under summer ambient conditions, accounting for station service loads, measured in Megawatts (MW).' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netWinterCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Net Winter Capacity Mw' ;
    rdfs:comment 'Maximum net output the unit can sustain over a specified period under winter ambient conditions, accounting for station service loads, measured in Megawatts (MW).' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nextScheduledOutageDate rdf:type rdf:Property ;
    rdfs:label 'Next Scheduled Outage Date' ;
    rdfs:comment 'Date of the next planned maintenance outage for the generating unit. Used for outage coordination and resource adequacy planning.' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:plannedRetirementDate rdf:type rdf:Property ;
    rdfs:label 'Planned Retirement Date' ;
    rdfs:comment 'Anticipated date for permanent retirement of the generating unit, if known. Used for long-term resource planning and Integrated Resource Plan (IRP) development.' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:primeMoverCode rdf:type rdf:Property ;
    rdfs:label 'Prime Mover Code' ;
    rdfs:comment 'EIA-860 standard code identifying the type of prime mover (engine or turbine) that drives the generator. ST=Steam Turbine, GT=Gas Turbine, IC=Internal Combustion, CA=Combined Cycle Steam, CT=Combustion Turbine, CS=Combined Cycle Single Shaft, CC=Combined Cycle, CE=Compressed Air Energy Storage, HY=Hydraulic Turbine, PS=Pumped Storage, PV=Photovoltaic, WT=Wind Turbine, WS=Wind Turbine Offshore, FC=Fuel Cell, ES=Energy Storage, OT=Other. [ENUM-REF-CANDIDATE: ST|GT|IC|CA|CT|CS|CC|CE|HY|PS|PV|WT|WS|FC|ES|OT — 16 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewableEnergyCreditEligible rdf:type rdf:Property ;
    rdfs:label 'Renewable Energy Credit Eligible' ;
    rdfs:comment 'Indicates whether the generating unit is eligible to generate Renewable Energy Credits (RECs) under applicable Renewable Portfolio Standard (RPS) programs. True if eligible, False otherwise.' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rtoIsoRegion rdf:type rdf:Property ;
    rdfs:label 'Rto Iso Region' ;
    rdfs:comment 'Regional Transmission Organization (RTO) or Independent System Operator (ISO) market region in which the generating unit participates (e.g., PJM, CAISO, ERCOT, MISO, NYISO, ISO-NE, SPP).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scadaPointReference rdf:type rdf:Property ;
    rdfs:label 'Scada Point Reference' ;
    rdfs:comment 'Supervisory Control and Data Acquisition (SCADA) system identifier or tag name for real-time telemetry data from this generating unit.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:synchronizationDate rdf:type rdf:Property ;
    rdfs:label 'Synchronization Date' ;
    rdfs:comment 'Date when the generating unit was first synchronized to the electrical grid for testing or initial operation.' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:technologyType rdf:type rdf:Property ;
    rdfs:label 'Technology Type' ;
    rdfs:comment 'Detailed technology classification of the generating unit (e.g., supercritical coal, combined cycle gas turbine, pressurized water reactor, onshore wind, utility-scale solar PV, pumped hydro storage).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unitCode rdf:type rdf:Property ;
    rdfs:label 'Unit Code' ;
    rdfs:comment 'Externally-known alphanumeric code or designation for the generating unit, used in operational systems and regulatory filings.' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unitName rdf:type rdf:Property ;
    rdfs:label 'Unit Name' ;
    rdfs:comment 'Human-readable name or designation of the generating unit (e.g., Boiler 1, Turbine A, Wind Turbine 42, Solar Inverter Block 3).' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unitStatus rdf:type rdf:Property ;
    rdfs:label 'Unit Status' ;
    rdfs:comment 'Current operational status of the generating unit in its lifecycle. Available=ready for dispatch, Operating=currently generating, Forced Outage=unplanned unavailability, Planned Outage=scheduled maintenance, Derated=operating below full capacity, Standby=ready but not dispatched, Retired=permanently out of service, Mothballed=temporarily preserved for potential future use. [ENUM-REF-CANDIDATE: available|operating|forced_outage|planned_outage|derated|standby|retired|mothballed — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Generation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unitType rdf:type rdf:Property ;
    rdfs:label 'Unit Type' ;
    rdfs:comment 'High-level classification of the generating unit by energy source or technology type. [ENUM-REF-CANDIDATE: fossil|nuclear|hydro|wind|solar|geothermal|biomass|storage|other — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waterSource rdf:type rdf:Property ;
    rdfs:label 'Water Source' ;
    rdfs:comment 'Primary water source used for cooling or other plant operations (e.g., river, lake, ocean, groundwater, municipal supply). Applicable to thermal and hydro units.' ;
    rdfs:domain ind:GeneratingUnit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:generationOutageEventId rdf:type rdf:Property ;
    rdfs:label 'Generation Outage Event Id' ;
    rdfs:comment 'Unique identifier for the generation outage event record. Primary key for this entity.' ;
    rdfs:domain ind:GenerationOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:affectedSystem rdf:type rdf:Property ;
    rdfs:label 'Affected System' ;
    rdfs:comment 'Primary system or component of the generating unit that was affected by the outage (e.g., boiler, turbine, generator, condenser, cooling system, fuel handling, emissions control, electrical auxiliary).' ;
    rdfs:domain ind:GenerationOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:availableCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Available Capacity Mw' ;
    rdfs:comment 'Remaining generating capacity (in megawatts) available during a partial outage. Zero for full outages. Used to calculate net capacity impact and dispatch availability.' ;
    rdfs:domain ind:GenerationOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deratedCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Derated Capacity Mw' ;
    rdfs:comment 'Amount of generating capacity (in megawatts) that was unavailable during the outage. For full outages, this equals the unit\'s nameplate capacity. For partial outages, this is the reduction in available capacity.' ;
    rdfs:domain ind:GenerationOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eforContributionHours rdf:type rdf:Property ;
    rdfs:label 'Efor Contribution Hours' ;
    rdfs:comment 'Equivalent forced outage hours contributed by this event to the unit\'s Equivalent Forced Outage Rate (EFOR) calculation. Accounts for both full and partial forced outages weighted by capacity impact.' ;
    rdfs:domain ind:GenerationOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:environmentalIncidentFlag rdf:type rdf:Property ;
    rdfs:label 'Environmental Incident Flag' ;
    rdfs:comment 'Boolean indicator (True/False) specifying whether the outage was associated with an environmental incident (e.g., emissions exceedance, spill, discharge violation). True if EPA or state environmental reporting is required.' ;
    rdfs:domain ind:GenerationOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:estimatedRevenueImpactUsd rdf:type rdf:Property ;
    rdfs:label 'Estimated Revenue Impact Usd' ;
    rdfs:comment 'Estimated financial impact of the outage in US dollars, calculated based on lost generation and applicable market prices (LMP, PPA rates, or avoided cost). Used for financial reporting and outage cost-benefit analysis.' ;
    rdfs:domain ind:GenerationOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:extensionReason rdf:type rdf:Property ;
    rdfs:label 'Extension Reason' ;
    rdfs:comment 'Explanation for why a planned outage was extended beyond its scheduled duration (e.g., additional repairs discovered, parts delay, weather, contractor availability). Null if no extension occurred.' ;
    rdfs:domain ind:GenerationOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lostGenerationMwh rdf:type rdf:Property ;
    rdfs:label 'Lost Generation Mwh' ;
    rdfs:comment 'Total energy generation lost due to the outage, measured in megawatt-hours. Calculated as derated capacity multiplied by outage duration. Used for revenue impact analysis and capacity factor calculations.' ;
    rdfs:domain ind:GenerationOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maintenanceCostUsd rdf:type rdf:Property ;
    rdfs:label 'Maintenance Cost Usd' ;
    rdfs:comment 'Total cost of maintenance or repair work performed during the outage in US dollars, including labor, materials, and contractor expenses. Sourced from work order cost actuals in Oracle WAM or IBM Maximo.' ;
    rdfs:domain ind:GenerationOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nercGadsReportableFlag rdf:type rdf:Property ;
    rdfs:label 'Nerc Gads Reportable Flag' ;
    rdfs:comment 'Boolean indicator (True/False) specifying whether this outage event must be reported to NERC under the Generating Availability Data System (GADS) reporting requirements. True for events meeting NERC reporting thresholds.' ;
    rdfs:domain ind:GenerationOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nercGadsSubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Nerc Gads Submission Date' ;
    rdfs:comment 'Date when the outage event data was submitted to NERC GADS for regulatory compliance reporting. Null if not yet submitted or not reportable.' ;
    rdfs:domain ind:GenerationOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:outageApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Outage Approval Date' ;
    rdfs:comment 'Date when the planned outage was approved by management, operations, or the RTO/ISO outage coordination process. Null for forced outages.' ;
    rdfs:domain ind:GenerationOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:outageCauseCode rdf:type rdf:Property ;
    rdfs:label 'Outage Cause Code' ;
    rdfs:comment 'Standardized NERC GADS cause code identifying the root cause of the outage (e.g., boiler tube leak, turbine blade failure, transformer fault, fuel supply interruption). Required for NERC GADS submissions and reliability analysis.' ;
    rdfs:domain ind:GenerationOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outageCauseDescription rdf:type rdf:Property ;
    rdfs:label 'Outage Cause Description' ;
    rdfs:comment 'Detailed narrative description of the root cause and circumstances of the outage event. Provides context beyond the standardized cause code for engineering analysis and lessons learned.' ;
    rdfs:domain ind:GenerationOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outageCoordinator rdf:type rdf:Property ;
    rdfs:label 'Outage Coordinator' ;
    rdfs:comment 'Name or identifier of the individual responsible for coordinating the outage event, including scheduling, RTO/ISO notification, work order management, and return-to-service activities.' ;
    rdfs:domain ind:GenerationOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outageDurationHours rdf:type rdf:Property ;
    rdfs:label 'Outage Duration Hours' ;
    rdfs:comment 'Total duration of the outage event in hours, calculated as the difference between outage_start_timestamp and outage_end_timestamp. Used for SAIDI-equivalent generation reliability metrics and maintenance planning.' ;
    rdfs:domain ind:GenerationOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outageEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Outage End Timestamp' ;
    rdfs:comment 'Date and time when the generating unit returned to service at full or partial capacity. Null if the outage is still ongoing. Used to calculate outage duration and availability metrics.' ;
    rdfs:domain ind:GenerationOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:outageExtensionFlag rdf:type rdf:Property ;
    rdfs:label 'Outage Extension Flag' ;
    rdfs:comment 'Boolean indicator (True/False) specifying whether a planned outage was extended beyond its originally scheduled end date. True if actual duration exceeded scheduled duration.' ;
    rdfs:domain ind:GenerationOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outageNumber rdf:type rdf:Property ;
    rdfs:label 'Outage Number' ;
    rdfs:comment 'Business identifier for the outage event, typically assigned by the work management system (Oracle WAM or IBM Maximo) or EMS. Used for tracking and reporting purposes.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outageStatus rdf:type rdf:Property ;
    rdfs:label 'Outage Status' ;
    rdfs:comment 'Current lifecycle status of the outage event. Active indicates the unit is currently offline. Completed means the unit has returned to service. Extended indicates a planned outage that exceeded its scheduled duration. Cancelled applies to planned outages that were aborted before execution.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:replacementPowerCostUsd rdf:type rdf:Property ;
    rdfs:label 'Replacement Power Cost Usd' ;
    rdfs:comment 'Cost of purchasing replacement power from the wholesale market or other sources to cover the capacity shortfall during the outage. Used for total outage cost analysis.' ;
    rdfs:domain ind:GenerationOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:responsibleCrew rdf:type rdf:Property ;
    rdfs:label 'Responsible Crew' ;
    rdfs:comment 'Name or identifier of the maintenance crew, operations team, or contractor responsible for managing the outage and performing repair or maintenance work.' ;
    rdfs:domain ind:GenerationOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:returnToServiceTimestamp rdf:type rdf:Property ;
    rdfs:label 'Return To Service Timestamp' ;
    rdfs:comment 'Date and time when the unit was officially declared available for dispatch by the RTO/ISO or grid operator. May differ from outage_end_timestamp if testing or ramp-up is required.' ;
    rdfs:domain ind:GenerationOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:rtoIsoNotificationMethod rdf:type rdf:Property ;
    rdfs:label 'Rto Iso Notification Method' ;
    rdfs:comment 'Method used to notify the RTO/ISO of the outage event (phone call, email, EMS system integration, web portal submission, or automated system notification).' ;
    rdfs:domain ind:GenerationOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rtoIsoNotificationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Rto Iso Notification Timestamp' ;
    rdfs:comment 'Date and time when the Regional Transmission Organization or Independent System Operator was notified of the outage. Required for compliance with RTO/ISO operating procedures and market rules.' ;
    rdfs:domain ind:GenerationOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:safetyIncidentFlag rdf:type rdf:Property ;
    rdfs:label 'Safety Incident Flag' ;
    rdfs:comment 'Boolean indicator (True/False) specifying whether the outage was associated with a safety incident (injury, near-miss, OSHA recordable event). True if OSHA reporting is required.' ;
    rdfs:domain ind:GenerationOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scheduledDurationHours rdf:type rdf:Property ;
    rdfs:label 'Scheduled Duration Hours' ;
    rdfs:comment 'Originally planned duration of the outage in hours for planned or maintenance outages. Used to calculate schedule variance and extension impact. Null for forced outages.' ;
    rdfs:domain ind:GenerationOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scheduledEndDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled End Date' ;
    rdfs:comment 'Originally planned end date for planned or maintenance outages. Used to identify outage extensions and schedule variance. Null for forced outages.' ;
    rdfs:domain ind:GenerationOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:weatherRelatedFlag rdf:type rdf:Property ;
    rdfs:label 'Weather Related Flag' ;
    rdfs:comment 'Boolean indicator (True/False) specifying whether the outage was caused by or significantly influenced by weather conditions (e.g., extreme heat, cold, wind, lightning, ice). Used for climate resilience analysis.' ;
    rdfs:domain ind:GenerationOutageEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:capacityFactorPercent rdf:type rdf:Property ;
    rdfs:label 'Capacity Factor Percent' ;
    rdfs:comment 'Ratio of actual energy output to maximum possible output over a reporting period, expressed as a percentage. Used for renewable energy performance tracking, asset utilization analysis, and Power Purchase Agreement (PPA) performance guarantees.' ;
    rdfs:domain ind:Generation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eiaPlantCode rdf:type rdf:Property ;
    rdfs:label 'Eia Plant Code' ;
    rdfs:comment 'U.S. Department of Energy EIA-assigned unique identifier for the generation facility used in EIA-860 and EIA-923 reporting.' ;
    rdfs:domain ind:Plant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emissionsControlled rdf:type rdf:Property ;
    rdfs:label 'Emissions Controlled' ;
    rdfs:comment 'Indicates whether the generation facility is equipped with emissions control technology (scrubbers, selective catalytic reduction, carbon capture). Used for EPA compliance reporting, Greenhouse Gas (GHG) inventory, and environmental cost allocation.' ;
    rdfs:domain ind:Plant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:emsResourceReference rdf:type rdf:Property ;
    rdfs:label 'Ems Resource Reference' ;
    rdfs:comment 'Unique identifier assigned to the generation facility within the utility\'s Energy Management System (EMS) or SCADA platform. Used for real-time dispatch instructions, telemetry data correlation, and outage coordination.' ;
    rdfs:domain ind:Plant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fercPlantCode rdf:type rdf:Property ;
    rdfs:label 'Ferc Plant Code' ;
    rdfs:comment 'FERC-assigned unique identifier for the generation facility used in FERC Form 1 reporting and rate case filings.' ;
    rdfs:domain ind:Plant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isoRtoRegion rdf:type rdf:Property ;
    rdfs:label 'Iso Rto Region' ;
    rdfs:comment 'The ISO or RTO market region where the generation facility is interconnected and participates in wholesale electricity markets. Determines market rules, Locational Marginal Price (LMP) settlement, and transmission tariff obligations. [ENUM-REF-CANDIDATE: CAISO|ERCOT|ISONE|MISO|NYISO|PJM|SPP|non_iso — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Plant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumLoadMw rdf:type rdf:Property ;
    rdfs:label 'Minimum Load Mw' ;
    rdfs:comment 'Minimum stable operating output level in megawatts (MW) below which the generation unit cannot operate reliably. Used for unit commitment decisions, ancillary service qualification, and dispatch constraint modeling.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nercPlantCode rdf:type rdf:Property ;
    rdfs:label 'Nerc Plant Code' ;
    rdfs:comment 'NERC-assigned unique identifier for the generation facility used in Bulk Electric System (BES) registration and compliance reporting.' ;
    rdfs:domain ind:Plant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Net Capacity Mw' ;
    rdfs:comment 'Actual electrical output capacity available for delivery to the grid after accounting for auxiliary load and station service requirements. Used for dispatch scheduling and market settlement.' ;
    rdfs:domain ind:Plant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:operatorName rdf:type rdf:Property ;
    rdfs:label 'Operator Name' ;
    rdfs:comment 'Name of the entity responsible for day-to-day operations and maintenance of the generation facility. May differ from the owner in cases of third-party operations and maintenance (O&M) contracts.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownershipPercentage rdf:type rdf:Property ;
    rdfs:label 'Ownership Percentage' ;
    rdfs:comment 'Percentage of the generation facility owned by the utility, expressed as a decimal (e.g., 100.00 for wholly-owned, 50.00 for joint venture). Used for capacity allocation, cost allocation, and FERC Form 1 reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:plantName rdf:type rdf:Property ;
    rdfs:label 'Plant Name' ;
    rdfs:comment 'Official name of the power generation facility as registered with regulatory authorities and used in operational communications.' ;
    rdfs:domain ind:Plant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:plantStatus rdf:type rdf:Property ;
    rdfs:label 'Plant Status' ;
    rdfs:comment 'Current operational lifecycle state of the generation facility. Determines availability for dispatch, capacity market participation, and regulatory reporting obligations.' ;
    rdfs:domain ind:Plant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ppaContractFlag rdf:type rdf:Property ;
    rdfs:label 'Ppa Contract Flag' ;
    rdfs:comment 'Indicates whether the generation facility operates under a Power Purchase Agreement (PPA) with the utility or third-party offtaker. Used for revenue forecasting, contract administration, and regulatory cost recovery filings.' ;
    rdfs:domain ind:Plant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:primaryUse rdf:type rdf:Property ;
    rdfs:label 'Primary Use' ;
    rdfs:comment 'Operational dispatch classification describing the typical role of the generation facility in meeting system load. Used for unit commitment optimization, capacity factor analysis, and Integrated Resource Plan (IRP) modeling.' ;
    rdfs:domain ind:Plant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rampRateMwPerMinute rdf:type rdf:Property ;
    rdfs:label 'Ramp Rate Mw Per Minute' ;
    rdfs:comment 'Maximum rate at which the generation facility can increase or decrease output, measured in megawatts per minute. Critical for frequency regulation, load following, and renewable integration support.' ;
    rdfs:domain ind:Plant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:renewableEnergyFlag rdf:type rdf:Property ;
    rdfs:label 'Renewable Energy Flag' ;
    rdfs:comment 'Indicates whether the generation facility qualifies as a renewable energy resource under state Renewable Portfolio Standard (RPS) programs and federal Production Tax Credit (PTC) or Investment Tax Credit (ITC) eligibility.' ;
    rdfs:domain ind:Plant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scadaIntegrationFlag rdf:type rdf:Property ;
    rdfs:label 'Scada Integration Flag' ;
    rdfs:comment 'Indicates whether the generation facility is integrated with the utility\'s Energy Management System (EMS) or SCADA platform for real-time telemetry, dispatch control, and automatic generation control (AGC).' ;
    rdfs:domain ind:Plant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:startupTimeHours rdf:type rdf:Property ;
    rdfs:label 'Startup Time Hours' ;
    rdfs:comment 'Time required in hours to bring the generation unit from offline to minimum load under normal conditions. Used for day-ahead market bidding, unit commitment optimization, and reliability planning.' ;
    rdfs:domain ind:Plant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unitOutputId rdf:type rdf:Property ;
    rdfs:label 'Unit Output Id' ;
    rdfs:comment 'Unique identifier for each unit output telemetry record. Primary key for the unit output data product.' ;
    rdfs:domain ind:UnitOutput ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:auxiliaryLoadMwh rdf:type rdf:Property ;
    rdfs:label 'Auxiliary Load Mwh' ;
    rdfs:comment 'Electrical energy consumed by the power plant\'s own auxiliary equipment (pumps, fans, controls, lighting) during the interval, measured in megawatt-hours (MWh). Deducted from gross generation to calculate net generation.' ;
    rdfs:domain ind:UnitOutput ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:barometricPressureInhg rdf:type rdf:Property ;
    rdfs:label 'Barometric Pressure Inhg' ;
    rdfs:comment 'Barometric pressure at the plant site during the interval, measured in inches of mercury (inHg). Affects combustion turbine performance and is used for altitude and weather corrections in performance calculations.' ;
    rdfs:domain ind:UnitOutput ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:co2EmissionsTons rdf:type rdf:Property ;
    rdfs:label 'Co2 Emissions Tons' ;
    rdfs:comment 'Carbon dioxide emissions produced during the interval, measured in short tons. Calculated from fuel consumption and emission factors or measured via continuous emissions monitoring system (CEMS). Required for greenhouse gas (GHG) reporting and carbon compliance.' ;
    rdfs:domain ind:UnitOutput ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dispatchMode rdf:type rdf:Property ;
    rdfs:label 'Dispatch Mode' ;
    rdfs:comment 'The operational dispatch mode of the unit during the interval. Indicates how the unit was being operated: baseload (continuous), cycling (load-following), peaking (on-demand), must-run (reliability), economic (market-driven), or manual (operator-controlled).' ;
    rdfs:domain ind:UnitOutput ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:frequencyHz rdf:type rdf:Property ;
    rdfs:label 'Frequency Hz' ;
    rdfs:comment 'Average electrical frequency at the generator terminals during the interval, measured in hertz (Hz). Standard grid frequency is 60 Hz in North America. Deviations indicate grid imbalance.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fuelConsumptionMmbtu rdf:type rdf:Property ;
    rdfs:label 'Fuel Consumption Mmbtu' ;
    rdfs:comment 'Total fuel energy consumed during the interval, measured in millions of British Thermal Units (MMBtu). Calculated from fuel flow meters and fuel heating value. Used for fuel cost allocation and emissions calculation.' ;
    rdfs:domain ind:UnitOutput ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:intervalDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Interval Duration Minutes' ;
    rdfs:comment 'The duration of the measurement interval in minutes. Common values are 5, 15, or 60 minutes. Used to normalize interval data to hourly or daily totals.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:intervalTimestamp rdf:type rdf:Property ;
    rdfs:label 'Interval Timestamp' ;
    rdfs:comment 'The precise date and time when this generation output measurement was recorded by the SCADA historian system. Represents the end of the measurement interval. Typically recorded at 5-minute or 15-minute intervals depending on unit type and regulatory requirements.' ;
    rdfs:domain ind:UnitOutput ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:netGenerationMwh rdf:type rdf:Property ;
    rdfs:label 'Net Generation Mwh' ;
    rdfs:comment 'Net electrical energy delivered to the grid during the interval, measured in megawatt-hours (MWh). Calculated as gross generation minus auxiliary load. This is the sellable energy used for RTO settlement and revenue calculation.' ;
    rdfs:domain ind:UnitOutput ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:noxEmissionsLbs rdf:type rdf:Property ;
    rdfs:label 'Nox Emissions Lbs' ;
    rdfs:comment 'Nitrogen oxides emissions produced during the interval, measured in pounds. Monitored via CEMS for air quality compliance. Subject to EPA and state air quality regulations.' ;
    rdfs:domain ind:UnitOutput ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reactivePowerMvar rdf:type rdf:Property ;
    rdfs:label 'Reactive Power Mvar' ;
    rdfs:comment 'Reactive power output during the interval, measured in megavolt-amperes reactive (MVAR). Used for voltage support and grid stability. May be positive (generation) or negative (consumption).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recQuantity rdf:type rdf:Property ;
    rdfs:label 'Rec Quantity' ;
    rdfs:comment 'Number of Renewable Energy Certificates (RECs) generated during this interval. Typically one REC equals one MWh of renewable generation. Used for RPS compliance tracking and REC trading.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:relativeHumidityPercent rdf:type rdf:Property ;
    rdfs:label 'Relative Humidity Percent' ;
    rdfs:comment 'Relative humidity at the plant site during the interval, expressed as a percentage. Affects combustion turbine performance and cooling tower efficiency. Used for environmental correction factors.' ;
    rdfs:domain ind:UnitOutput ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rtoSettlementFlag rdf:type rdf:Property ;
    rdfs:label 'Rto Settlement Flag' ;
    rdfs:comment 'Boolean flag indicating whether this interval\'s generation output has been submitted to the RTO/ISO for energy market settlement. True means the data has been used for settlement; false means it has not yet been submitted or was excluded.' ;
    rdfs:domain ind:UnitOutput ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scadaSourceTag rdf:type rdf:Property ;
    rdfs:label 'Scada Source Tag' ;
    rdfs:comment 'The SCADA historian tag name or point identifier from which this telemetry data was sourced. Typically an OSIsoft PI tag or GE Proficy tag. Used for data lineage and troubleshooting.' ;
    rdfs:domain ind:UnitOutput ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:so2EmissionsLbs rdf:type rdf:Property ;
    rdfs:label 'So2 Emissions Lbs' ;
    rdfs:comment 'Sulfur dioxide emissions produced during the interval, measured in pounds. Monitored via CEMS for acid rain program compliance and air quality regulations.' ;
    rdfs:domain ind:UnitOutput ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:steamFlowKlbPerHr rdf:type rdf:Property ;
    rdfs:label 'Steam Flow Klb Per Hr' ;
    rdfs:comment 'Steam flow rate through the turbine during the interval, measured in thousands of pounds per hour (klb/hr). Applicable to steam turbine units (fossil, nuclear, combined cycle). Used for thermodynamic performance analysis.' ;
    rdfs:domain ind:UnitOutput ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:voltageKv rdf:type rdf:Property ;
    rdfs:label 'Voltage Kv' ;
    rdfs:comment 'Average voltage at the generator terminals during the interval, measured in kilovolts (kV). Varies by unit design and step-up transformer configuration.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ancillaryServiceAwardId rdf:type rdf:Property ;
    rdfs:label 'Ancillary Service Award Id' ;
    rdfs:comment 'Unique surrogate identifier for each ancillary service award record in the Silver Layer lakehouse. Primary key for this transactional entity.' ;
    rdfs:domain ind:AncillaryServiceAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:capacityMarketAuctionId rdf:type rdf:Property ;
    rdfs:label 'Capacity Market Auction Id' ;
    rdfs:comment 'Identifier of the capacity market auction (e.g., PJM RPM, MISO Planning Resource Auction) associated with this award, if applicable. Populated for capacity-market-sourced ancillary obligations; null for DAM/RTM awards.' ;
    rdfs:domain ind:Market ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CapacityMarketAuction .

ind:rtoIsoId rdf:type rdf:Property ;
    rdfs:label 'Rto Iso Id' ;
    rdfs:comment 'Reference to the RTO/ISO entity (e.g., PJM, MISO, CAISO, ERCOT, NYISO, ISO-NE) that issued this ancillary service award. Serves as the PARTY_REFERENCE for this transaction.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RtoIso .

ind:awardReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Award Reference Number' ;
    rdfs:comment 'Externally-known award confirmation number or transaction identifier assigned by the RTO/ISO for this ancillary service award. Used for reconciliation with RTO/ISO settlement statements and FERC compliance reporting.' ;
    rdfs:domain ind:Market ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:awardStatus rdf:type rdf:Property ;
    rdfs:label 'Award Status' ;
    rdfs:comment 'Current lifecycle state of the ancillary service award. \'awarded\' = RTO/ISO has issued the award; \'confirmed\' = utility has acknowledged; \'settled\' = financial settlement completed; \'disputed\' = under dispute resolution; \'cancelled\' = award rescinded; \'expired\' = obligation period elapsed without settlement.' ;
    rdfs:domain ind:Market ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:awardTimestamp rdf:type rdf:Property ;
    rdfs:label 'Award Timestamp' ;
    rdfs:comment 'The date and time when the RTO/ISO issued the ancillary service award to the market participant. Represents the principal business event timestamp for this transaction record.' ;
    rdfs:domain ind:AncillaryServiceAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:awardedMw rdf:type rdf:Property ;
    rdfs:label 'Awarded Mw' ;
    rdfs:comment 'The quantity of capacity in megawatts (MW) awarded by the RTO/ISO for the specified ancillary service type and operating interval. This is the primary quantitative fact of the award.' ;
    rdfs:domain ind:AncillaryServiceAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:clearingPricePerMw rdf:type rdf:Property ;
    rdfs:label 'Clearing Price Per Mw' ;
    rdfs:comment 'The market clearing price in US dollars per megawatt ($/MW) at which the ancillary service was procured by the RTO/ISO. Used for settlement calculation and revenue recognition.' ;
    rdfs:domain ind:AncillaryServiceAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:controlAreaCode rdf:type rdf:Property ;
    rdfs:label 'Control Area Code' ;
    rdfs:comment 'Identifier for the balancing authority area or control area within the RTO/ISO footprint where the ancillary service obligation applies. Used for geographic segmentation of reliability obligations and NERC compliance reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deployedMw rdf:type rdf:Property ;
    rdfs:label 'Deployed Mw' ;
    rdfs:comment 'Actual megawatts delivered by the resource during deployment events within the obligation period. May differ from awarded_mw if the resource was partially deployed or experienced a forced outage. Used for performance score calculation and NERC compliance.' ;
    rdfs:domain ind:AncillaryServiceAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deploymentEventCount rdf:type rdf:Property ;
    rdfs:label 'Deployment Event Count' ;
    rdfs:comment 'Number of times the ancillary service resource was actually deployed (called upon) by the RTO/ISO during the obligation period. A count of zero indicates the resource was held in reserve but not activated. Supports NERC reliability compliance reporting.' ;
    rdfs:domain ind:AncillaryServiceAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:disputeReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Dispute Reference Number' ;
    rdfs:comment 'RTO/ISO or internal dispute tracking number if this award is under settlement dispute. Populated only when settlement_status is \'disputed\'. Supports dispute resolution workflow and FERC complaint tracking.' ;
    rdfs:domain ind:Market ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketType rdf:type rdf:Property ;
    rdfs:label 'Market Type' ;
    rdfs:comment 'Indicates whether the ancillary service award was procured in the Day-Ahead Market (DAM), Real-Time Market (RTM), or a forward capacity market auction.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nercComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Nerc Compliance Flag' ;
    rdfs:comment 'Indicates whether this ancillary service award and its associated performance met all applicable NERC reliability standards (e.g., BAL-001, BAL-002) for the obligation period. Used for NERC compliance reporting and audit trails.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:netSettlementAmount rdf:type rdf:Property ;
    rdfs:label 'Net Settlement Amount' ;
    rdfs:comment 'Final net settlement amount in US dollars after applying performance adjustments to the base settlement amount (settlement_amount + performance_adjustment_amount). Represents the actual revenue recognized for this award.' ;
    rdfs:domain ind:AncillaryServiceAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:obligationEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Obligation End Timestamp' ;
    rdfs:comment 'The date and time when the ancillary service obligation period ends. Together with obligation_start_timestamp, defines the full obligation window for availability and performance measurement.' ;
    rdfs:domain ind:AncillaryServiceAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:obligationStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Obligation Start Timestamp' ;
    rdfs:comment 'The date and time when the ancillary service obligation period begins. Defines the start of the window during which the resource must be available and responsive.' ;
    rdfs:domain ind:AncillaryServiceAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:offerPricePerMw rdf:type rdf:Property ;
    rdfs:label 'Offer Price Per Mw' ;
    rdfs:comment 'The price in US dollars per megawatt ($/MW) at which the utility submitted its ancillary service offer into the market. Compared against clearing_price_per_mw for margin analysis and offer strategy review.' ;
    rdfs:domain ind:AncillaryServiceAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:offeredMw rdf:type rdf:Property ;
    rdfs:label 'Offered Mw' ;
    rdfs:comment 'The quantity of capacity in megawatts (MW) that the utility originally offered into the ancillary service market. Compared against awarded_mw to assess offer acceptance rate and market clearing outcomes.' ;
    rdfs:domain ind:AncillaryServiceAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:operatingDate rdf:type rdf:Property ;
    rdfs:label 'Operating Date' ;
    rdfs:comment 'The calendar date on which the ancillary service obligation is to be performed. This is the principal real-world event date for the award, distinct from the award issuance timestamp.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:performanceAdjustmentAmount rdf:type rdf:Property ;
    rdfs:label 'Performance Adjustment Amount' ;
    rdfs:comment 'Dollar adjustment applied to the base settlement amount based on the resource\'s performance score. Positive values indicate performance bonuses; negative values indicate penalties for under-performance. Required for FERC Order 755 pay-for-performance regulation compliance.' ;
    rdfs:domain ind:AncillaryServiceAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:performanceScore rdf:type rdf:Property ;
    rdfs:label 'Performance Score' ;
    rdfs:comment 'Numeric performance score assigned by the RTO/ISO reflecting the resource\'s compliance with the ancillary service obligation during the operating interval. Scores typically range from 0.0 to 1.0 (or 0–100 per RTO convention). Impacts performance-based settlement adjustments and NERC compliance metrics.' ;
    rdfs:domain ind:AncillaryServiceAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:responseTimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Response Time Minutes' ;
    rdfs:comment 'Actual response time in minutes from RTO/ISO dispatch signal to full MW delivery by the resource. Compared against the service type\'s required response time (e.g., 10 minutes for spinning reserve) for performance evaluation and NERC compliance.' ;
    rdfs:domain ind:AncillaryServiceAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:settlementAmount rdf:type rdf:Property ;
    rdfs:label 'Settlement Amount' ;
    rdfs:comment 'The gross settlement amount in US dollars payable to the utility for this ancillary service award, calculated as awarded_mw multiplied by clearing_price_per_mw for the obligation period. Supports ancillary service revenue tracking and FERC settlement reconciliation.' ;
    rdfs:domain ind:AncillaryServiceAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:settlementPeriod rdf:type rdf:Property ;
    rdfs:label 'Settlement Period' ;
    rdfs:comment 'The RTO/ISO-defined settlement period identifier (e.g., \'DAM-2024-01-15\', \'RTM-2024-01-15-HE14\') to which this award belongs. Used for batch settlement reconciliation and financial close processes.' ;
    rdfs:domain ind:Market ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementStatus rdf:type rdf:Property ;
    rdfs:label 'Settlement Status' ;
    rdfs:comment 'Current status of the financial settlement for this award. \'pending\' = awaiting RTO/ISO settlement run; \'preliminary\' = initial settlement issued; \'final\' = settlement finalized; \'resettled\' = corrected after initial settlement; \'disputed\' = under formal dispute with RTO/ISO.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemAwardCode rdf:type rdf:Property ;
    rdfs:label 'Source System Award Code' ;
    rdfs:comment 'The native award identifier from the originating energy management or market operations system (e.g., ABB or GE Energy Management System, or RTO/ISO OASIS portal). Enables traceability back to the operational system of record for audit and reconciliation.' ;
    rdfs:domain ind:AncillaryServiceAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capacityObligationId rdf:type rdf:Property ;
    rdfs:label 'Capacity Obligation Id' ;
    rdfs:comment 'Unique surrogate identifier for each capacity market obligation record registered with an RTO/ISO. Primary key for the capacity_obligation data product in the Silver Layer lakehouse.' ;
    rdfs:domain ind:Market ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CapacityObligation .

ind:procurementContractId rdf:type rdf:Property ;
    rdfs:label 'Procurement Contract Id' ;
    rdfs:comment 'Foreign key linking to supply.procurement_contract. Business justification: Capacity obligations depend on underlying procurement contracts for fuel supply, equipment maintenance, or tolling agreements that enable capacity delivery. Critical for cost allocation, performance g' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProcurementContract .

ind:transferAgreementId rdf:type rdf:Property ;
    rdfs:label 'Transfer Agreement Id' ;
    rdfs:comment 'Reference to a bilateral capacity transfer agreement if this obligation has been partially or fully transferred to or from another market participant. Null if no transfer applies. Used for capacity position management and FERC market-based rate compliance.' ;
    rdfs:domain ind:CapacityObligation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CapacityTransferAgreement .

ind:zoneId rdf:type rdf:Property ;
    rdfs:label 'Zone Id' ;
    rdfs:comment 'Reference to the locational deliverability area (LDA), capacity zone, or planning zone within the RTO/ISO footprint where this obligation applies (e.g., PJM MAAC, MISO Zone 7, ISO-NE NEMA). Determines applicable clearing price and performance requirements.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:UtilityCompany .

ind:auctionClearingDate rdf:type rdf:Property ;
    rdfs:label 'Auction Clearing Date' ;
    rdfs:comment 'Date on which the capacity auction cleared and this obligation was established. For bilateral transactions, the date the agreement was executed. Used as the principal business event date for financial recognition and FERC market-based rate reporting.' ;
    rdfs:domain ind:CapacityObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:auctionCode rdf:type rdf:Property ;
    rdfs:label 'Auction Code' ;
    rdfs:comment 'Reference to the capacity market auction event (e.g., PJM Base Residual Auction, MISO Planning Resource Auction, ISO-NE Forward Capacity Auction) from which this obligation was established. Links to the auction master record.' ;
    rdfs:domain ind:CapacityObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:auctionType rdf:type rdf:Property ;
    rdfs:label 'Auction Type' ;
    rdfs:comment 'Classification of the auction mechanism through which this obligation was established. \'base_residual\' is the primary annual auction; \'incremental\' covers subsequent adjustment auctions; \'bilateral\' covers negotiated capacity transactions; \'self_supply\' covers vertically integrated utility self-commitment; \'reliability_must_run\' covers RMR designations.' ;
    rdfs:domain ind:Market ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capacityQualificationDate rdf:type rdf:Property ;
    rdfs:label 'Capacity Qualification Date' ;
    rdfs:comment 'Date on which the RTO/ISO formally qualified this resource to participate in the capacity market for the applicable delivery year. Marks the point at which the resource\'s UCAP value was certified and the obligation became binding.' ;
    rdfs:domain ind:CapacityObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:clearingPricePerMwDay rdf:type rdf:Property ;
    rdfs:label 'Clearing Price Per Mw Day' ;
    rdfs:comment 'The capacity auction clearing price in dollars per Megawatt per day ($/MW-day) at which this obligation was established. Multiplied by committed_mw and the number of days in the delivery year to determine total capacity revenue or cost. Classified confidential as commercially sensitive market pricing data.' ;
    rdfs:domain ind:CapacityObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:committedMw rdf:type rdf:Property ;
    rdfs:label 'Committed Mw' ;
    rdfs:comment 'The quantity of capacity in Megawatts (MW) committed under this obligation as cleared in the capacity auction or bilaterally agreed. Represents the principal quantitative fact of the obligation. Used for resource adequacy compliance, FERC reporting, and IRP analysis.' ;
    rdfs:domain ind:CapacityObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:curtailmentEventCount rdf:type rdf:Property ;
    rdfs:label 'Curtailment Event Count' ;
    rdfs:comment 'Number of RTO/ISO-declared capacity performance events (e.g., PJM Performance Assessment Hours, MISO Emergency Operating Procedures) during which this resource was called upon to perform within the current delivery year. Used for compliance tracking and non-performance charge calculation.' ;
    rdfs:domain ind:CapacityObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:deliveryYear rdf:type rdf:Property ;
    rdfs:label 'Delivery Year' ;
    rdfs:comment 'The RTO/ISO-defined delivery year (e.g., \'2025/2026\') during which the capacity obligation must be fulfilled. Typically spans June 1 through May 31 for PJM; aligns with the planning year used in the auction. Critical for resource adequacy planning and FERC capacity market reporting.' ;
    rdfs:domain ind:Market ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:efordRate rdf:type rdf:Property ;
    rdfs:label 'Eford Rate' ;
    rdfs:comment 'The Equivalent Forced Outage Rate on Demand (EFORd) applied to this resource for the delivery year, expressed as a decimal (e.g., 0.0250 = 2.50%). Used by the RTO/ISO to derate installed capacity to Unforced Capacity (UCAP). Sourced from NERC GADS reporting and RTO/ISO capacity qualification processes.' ;
    rdfs:domain ind:CapacityObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forceMajeureFlag rdf:type rdf:Property ;
    rdfs:label 'Force Majeure Flag' ;
    rdfs:comment 'Indicates whether a force majeure event (True) has been declared for this obligation, potentially relieving the utility of non-performance charges for affected performance events. Triggers a separate RTO/ISO review and waiver process.' ;
    rdfs:domain ind:CapacityObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:installedCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Installed Capacity Mw' ;
    rdfs:comment 'The nameplate or installed capacity in Megawatts (MW) of the resource registered for this obligation, prior to any derating adjustments. Used as the baseline for UCAP calculations and resource adequacy assessments in MISO and ISO-NE markets.' ;
    rdfs:domain ind:Market ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isDemandResponse rdf:type rdf:Property ;
    rdfs:label 'Is Demand Response' ;
    rdfs:comment 'Indicates whether this capacity obligation is fulfilled by a Demand Response (DR) resource (True) rather than a generation asset (False). DR capacity obligations are subject to different performance measurement rules under FERC Order 745 and RTO/ISO DR tariff provisions.' ;
    rdfs:domain ind:CapacityObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSelfScheduled rdf:type rdf:Property ;
    rdfs:label 'Is Self Scheduled' ;
    rdfs:comment 'Indicates whether this capacity obligation was established through a self-schedule (True) rather than through a competitive auction clearing (False). Self-scheduled resources bypass the auction clearing price and are committed at cost-of-service or bilateral rates. Relevant for vertically integrated utilities under state PUC jurisdiction.' ;
    rdfs:domain ind:Market ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastPerformanceTestDate rdf:type rdf:Property ;
    rdfs:label 'Last Performance Test Date' ;
    rdfs:comment 'Date of the most recent RTO/ISO-administered or utility-conducted capacity performance test for the resource fulfilling this obligation. Used to verify continued eligibility and compliance with performance threshold requirements.' ;
    rdfs:domain ind:CapacityObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:locationalDeliverabilityArea rdf:type rdf:Property ;
    rdfs:label 'Locational Deliverability Area' ;
    rdfs:comment 'The name or code of the Locational Deliverability Area (LDA) or sub-zone within the RTO/ISO footprint where this capacity obligation must be physically deliverable. Relevant for constrained zones with higher clearing prices. Used for transmission planning and resource adequacy analysis.' ;
    rdfs:domain ind:CapacityObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nonPerformanceChargeAmount rdf:type rdf:Property ;
    rdfs:label 'Non Performance Charge Amount' ;
    rdfs:comment 'Cumulative non-performance charge amount in US Dollars (USD) assessed against this obligation for the current delivery year due to resource underperformance during capacity performance events. Used for financial exposure tracking, FERC reporting, and collections management.' ;
    rdfs:domain ind:CapacityObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:obligationEndDate rdf:type rdf:Property ;
    rdfs:label 'Obligation End Date' ;
    rdfs:comment 'Calendar date on which the capacity obligation period concludes. Typically May 31 of the delivery year for PJM-style markets. Nullable for multi-year obligations with rolling terms. Used for expiry tracking and resource adequacy planning.' ;
    rdfs:domain ind:CapacityObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:obligationNumber rdf:type rdf:Property ;
    rdfs:label 'Obligation Number' ;
    rdfs:comment 'Externally-known alphanumeric identifier assigned by the RTO/ISO (e.g., PJM RPM obligation ID, MISO Planning Resource Auction ID, ISO-NE FCM commitment reference) that uniquely identifies this obligation in the market operator\'s system. Used for FERC reporting and RTO/ISO reconciliation.' ;
    rdfs:domain ind:CapacityObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:obligationStartDate rdf:type rdf:Property ;
    rdfs:label 'Obligation Start Date' ;
    rdfs:comment 'Calendar date on which the capacity obligation period begins and the utility must demonstrate resource availability. Typically June 1 of the delivery year for PJM-style markets. Used for compliance monitoring and IRP scheduling.' ;
    rdfs:domain ind:CapacityObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:obligationStatus rdf:type rdf:Property ;
    rdfs:label 'Obligation Status' ;
    rdfs:comment 'Current lifecycle status of the capacity obligation. \'active\' indicates the obligation is in force during the delivery year; \'pending\' indicates awaiting RTO/ISO confirmation; \'suspended\' indicates temporarily relieved; \'terminated\' indicates early exit; \'expired\' indicates the obligation period has concluded.' ;
    rdfs:domain ind:CapacityObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:obligationType rdf:type rdf:Property ;
    rdfs:label 'Obligation Type' ;
    rdfs:comment 'Classification of the capacity obligation by resource category. \'capacity_supply\' covers generation assets; \'demand_response\' covers DR programs; \'energy_efficiency\' covers EE resources; \'import\'/\'export\' cover inter-regional capacity transactions. Drives applicable performance standards and penalty calculations.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performanceTestResultMw rdf:type rdf:Property ;
    rdfs:label 'Performance Test Result Mw' ;
    rdfs:comment 'The demonstrated output in Megawatts (MW) achieved during the most recent capacity performance test. Compared against committed_mw to assess compliance with the obligation and determine if non-performance charges apply.' ;
    rdfs:domain ind:CapacityObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:performanceThresholdPct rdf:type rdf:Property ;
    rdfs:label 'Performance Threshold Pct' ;
    rdfs:comment 'The minimum performance ratio (expressed as a decimal percentage, e.g., 0.9750 = 97.50%) that the resource must achieve during capacity performance events to avoid Non-Performance Charges. Defined by the RTO/ISO tariff for the applicable delivery year and resource type.' ;
    rdfs:domain ind:CapacityObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:planningReserveMarginPct rdf:type rdf:Property ;
    rdfs:label 'Planning Reserve Margin Pct' ;
    rdfs:comment 'The RTO/ISO-mandated planning reserve margin (expressed as a decimal percentage, e.g., 0.1650 = 16.50%) applicable to this obligation\'s delivery year and zone. Used to verify that the utility\'s total capacity portfolio meets resource adequacy requirements for IRP and regulatory filings.' ;
    rdfs:domain ind:CapacityObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:resourceType rdf:type rdf:Property ;
    rdfs:label 'Resource Type' ;
    rdfs:comment 'Technology classification of the resource fulfilling the capacity obligation. Used for resource adequacy portfolio analysis, RPS compliance tracking, and IRP reporting. Aligns with NERC Generator Inventory and FERC Form 1 resource classifications. [ENUM-REF-CANDIDATE: thermal|nuclear|hydro|wind|solar|storage|demand_response|other — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:CapacityObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rtoIsoCode rdf:type rdf:Property ;
    rdfs:label 'Rto Iso Code' ;
    rdfs:comment 'Code identifying the Regional Transmission Organization or Independent System Operator (RTO/ISO) with which this capacity obligation is registered. Determines the applicable tariff, auction rules, and compliance framework. [ENUM-REF-CANDIDATE: PJM|MISO|ISO-NE|NYISO|CAISO|SPP|ERCOT — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalCapacityRevenue rdf:type rdf:Property ;
    rdfs:label 'Total Capacity Revenue' ;
    rdfs:comment 'Total expected capacity revenue in US Dollars (USD) for the full obligation period, calculated as clearing_price_per_mw_day × committed_mw × obligation days. Stored as a pre-computed contract value for financial planning, EBITDA forecasting, and FERC market-based rate filings. Classified confidential as commercially sensitive financial data.' ;
    rdfs:domain ind:CapacityObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unforcedCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Unforced Capacity Mw' ;
    rdfs:comment 'The Unforced Capacity (UCAP) value in Megawatts (MW) after applying the Equivalent Forced Outage Rate (EFORd) derating factor to the installed capacity. UCAP is the RTO/ISO-recognized capacity credit used for compliance verification and auction clearing. Distinct from committed_mw which reflects the cleared auction quantity.' ;
    rdfs:domain ind:CapacityObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dispatchAwardId rdf:type rdf:Property ;
    rdfs:label 'Dispatch Award Id' ;
    rdfs:comment 'Unique surrogate identifier for each dispatch award record in the Silver layer lakehouse. Primary key for the dispatch_award data product. Entity role: TRANSACTION_HEADER — represents a discrete RTO/ISO market clearing event awarding a generation unit a scheduled MW commitment for a specific market interval.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DispatchAward .

ind:energyBidId rdf:type rdf:Property ;
    rdfs:label 'Energy Bid Id' ;
    rdfs:comment 'Reference to the originating market bid or offer submitted by the utility to the RTO/ISO that resulted in this dispatch award. Links the award back to the bid strategy and offer parameters for settlement verification and FERC market-based rate compliance auditing.' ;
    rdfs:domain ind:Market ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EnergyBid .

ind:fuelDeliveryId rdf:type rdf:Property ;
    rdfs:label 'Fuel Delivery Id' ;
    rdfs:comment 'Foreign key linking to supply.fuel_delivery. Business justification: Real-time dispatch decisions require fuel availability confirmation. Links generation dispatch awards to actual fuel deliveries for operational reconciliation, heat rate validation, cost-to-serve calc' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FuelDelivery .

ind:ancillaryServiceMw rdf:type rdf:Property ;
    rdfs:label 'Ancillary Service Mw' ;
    rdfs:comment 'The Megawatt (MW) capacity awarded for ancillary service obligations (e.g., spinning reserve, regulation) associated with this dispatch award. Distinct from scheduled_mw which represents energy dispatch. Null or zero when ancillary_service_type is NONE. Used for NERC reliability compliance and RTO/ISO ancillary service settlement.' ;
    rdfs:domain ind:DispatchAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ancillaryServiceType rdf:type rdf:Property ;
    rdfs:label 'Ancillary Service Type' ;
    rdfs:comment 'Identifies whether this dispatch award includes an ancillary service obligation in addition to or instead of energy dispatch. NONE = energy-only dispatch; REG_UP = regulation up (frequency regulation upward); REG_DOWN = regulation down; SPIN_RES = spinning reserve; NON_SPIN_RES = non-spinning reserve; VOLT_SUPPORT = voltage support / reactive power. Required for FERC ancillary services tariff compliance and NERC reliability standard reporting.' ;
    rdfs:domain ind:Market ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:awardVersionNumber rdf:type rdf:Property ;
    rdfs:label 'Award Version Number' ;
    rdfs:comment 'Sequential version number for this dispatch award record, incremented each time the RTO/ISO issues a revised dispatch instruction for the same generation unit and interval. Version 1 is the initial award; higher versions represent resettlements or corrections. Used to identify the most current award and track instruction revisions.' ;
    rdfs:domain ind:DispatchAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:commitmentStatus rdf:type rdf:Property ;
    rdfs:label 'Commitment Status' ;
    rdfs:comment 'Indicates how the generation unit was committed for this dispatch award. COMMITTED = unit was committed by the RTO/ISO through the market clearing process; DECOMMITTED = unit was previously committed but released; SELF_SCHEDULED = utility submitted a self-schedule outside the competitive market; MUST_RUN = unit designated as must-run by the RTO/ISO for reliability; RELIABILITY_MUST_RUN = unit committed for reliability reasons outside normal market dispatch.' ;
    rdfs:domain ind:DispatchAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:economicMaxMw rdf:type rdf:Property ;
    rdfs:label 'Economic Max Mw' ;
    rdfs:comment 'The maximum Megawatt (MW) output level at which the generation unit can operate economically, as submitted in the unit\'s market offer and recognized in this dispatch award. Defines the upper bound of the unit\'s dispatchable operating range. Used by the RTO/ISO dispatch algorithm and SCADA/EMS for real-time control.' ;
    rdfs:domain ind:DispatchAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:economicMinMw rdf:type rdf:Property ;
    rdfs:label 'Economic Min Mw' ;
    rdfs:comment 'The minimum Megawatt (MW) output level at which the generation unit can operate economically, as submitted in the unit\'s market offer and recognized in this dispatch award. Defines the lower bound of the unit\'s dispatchable operating range. Used by the RTO/ISO dispatch algorithm and SCADA/EMS for real-time control.' ;
    rdfs:domain ind:DispatchAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:emsDispatchConfirmationCode rdf:type rdf:Property ;
    rdfs:label 'Ems Dispatch Confirmation Code' ;
    rdfs:comment 'The confirmation or acknowledgment identifier generated by the ABB or GE Energy Management System (EMS) when the dispatch instruction was received and confirmed for execution. Provides the audit trail linking the market award to the real-time SCADA/EMS dispatch execution record. Used for operations coordination and post-event reliability analysis.' ;
    rdfs:domain ind:DispatchAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:generationTechnology rdf:type rdf:Property ;
    rdfs:label 'Generation Technology' ;
    rdfs:comment 'The generation technology classification of the dispatched unit. CT = Combustion Turbine; CC = Combined Cycle; STEAM = steam turbine (coal/gas/nuclear); HYDRO = hydroelectric; WIND = wind turbine; SOLAR_PV = photovoltaic; SOLAR_THERMAL = concentrating solar; STORAGE = battery or pumped hydro storage. Used for IRP resource adequacy modeling and FERC EQR reporting. [ENUM-REF-CANDIDATE: CT|CC|STEAM|NUCLEAR|HYDRO|WIND|SOLAR_PV|SOLAR_THERMAL|STORAGE|CHP|GEOTHERMAL — promote to reference product]' ;
    rdfs:domain ind:DispatchAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ghgEmissionsRateLbsPerMwh rdf:type rdf:Property ;
    rdfs:label 'Ghg Emissions Rate Lbs Per Mwh' ;
    rdfs:comment 'The greenhouse gas (GHG) CO2-equivalent emissions rate in pounds per Megawatt-Hour (lbs/MWh) for the generation unit at this dispatch level. Used for EPA GHG compliance reporting, state environmental regulatory filings, and corporate sustainability accounting. Null for zero-emission resources.' ;
    rdfs:domain ind:DispatchAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:intervalEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Interval End Timestamp' ;
    rdfs:comment 'End date and time of the market dispatch interval for which the MW schedule is awarded. Defines the close of the operating window. For RTM typically 5 minutes after interval_start_timestamp; for DAM typically 60 minutes after. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:intervalStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Interval Start Timestamp' ;
    rdfs:comment 'Start date and time of the market dispatch interval for which the MW schedule is awarded. For RTM this is typically a 5-minute interval; for DAM this is typically an hourly interval. Combined with interval_end_timestamp defines the precise operating window. Format: yyyy-MM-ddTHH:mm:ss.SSSXXX.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:isReliabilityDispatch rdf:type rdf:Property ;
    rdfs:label 'Is Reliability Dispatch' ;
    rdfs:comment 'Indicates whether this dispatch award was issued for reliability reasons (True) rather than economic dispatch (False). Reliability dispatches may occur outside normal market clearing to maintain grid stability per NERC reliability standards. Affects cost recovery treatment and FERC compliance reporting.' ;
    rdfs:domain ind:DispatchAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRenewable rdf:type rdf:Property ;
    rdfs:label 'Is Renewable' ;
    rdfs:comment 'Indicates whether the dispatched generation unit qualifies as a renewable resource (True) under applicable state Renewable Portfolio Standard (RPS) or federal definitions. Drives Renewable Energy Certificate (REC) tracking, RPS compliance reporting to state PUCs, and GHG emissions accounting.' ;
    rdfs:domain ind:Market ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lmpCongestionComponentUsdPerMwh rdf:type rdf:Property ;
    rdfs:label 'Lmp Congestion Component Usd Per Mwh' ;
    rdfs:comment 'The congestion component of the Locational Marginal Price (LMP) in USD/MWh, reflecting the cost of transmission constraints between the pricing node and the reference bus. Negative values indicate the node benefits from congestion. Critical for transmission planning and FERC OATT compliance analysis.' ;
    rdfs:domain ind:DispatchAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lmpEnergyComponentUsdPerMwh rdf:type rdf:Property ;
    rdfs:label 'Lmp Energy Component Usd Per Mwh' ;
    rdfs:comment 'The energy component of the Locational Marginal Price (LMP) in USD/MWh, representing the system-wide marginal cost of energy at the reference bus. One of three LMP components (energy, congestion, loss) published by the RTO/ISO. Used for granular settlement analysis and IRP resource adequacy modeling.' ;
    rdfs:domain ind:DispatchAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lmpLossComponentUsdPerMwh rdf:type rdf:Property ;
    rdfs:label 'Lmp Loss Component Usd Per Mwh' ;
    rdfs:comment 'The marginal loss component of the Locational Marginal Price (LMP) in USD/MWh, reflecting the incremental cost of transmission losses between the pricing node and the reference bus. Used for settlement reconciliation and transmission loss accounting per FERC OATT requirements.' ;
    rdfs:domain ind:DispatchAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lmpUsdPerMwh rdf:type rdf:Property ;
    rdfs:label 'Lmp Usd Per Mwh' ;
    rdfs:comment 'The Locational Marginal Price (LMP) in US Dollars per Megawatt-Hour ($/MWh) at the associated pricing node for this dispatch interval, as published by the RTO/ISO following market clearing. Composed of energy, congestion, and loss components. Primary settlement price for the awarded MW schedule. Sensitive market pricing data.' ;
    rdfs:domain ind:DispatchAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:noLoadCostUsdPerHr rdf:type rdf:Property ;
    rdfs:label 'No Load Cost Usd Per Hr' ;
    rdfs:comment 'The fixed operating cost in US Dollars per hour ($/hr) incurred to keep the generation unit synchronized and online at zero net output, as submitted in the market offer. Recovered through RTO/ISO no-load cost compensation. Sensitive commercial cost data used in IRP and FERC rate case filings.' ;
    rdfs:domain ind:Market ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rampRateDownMwPerMin rdf:type rdf:Property ;
    rdfs:label 'Ramp Rate Down Mw Per Min' ;
    rdfs:comment 'The maximum rate in Megawatts per minute (MW/min) at which the generation unit can decrease its output, as recognized in this dispatch award. Constrains how quickly the unit can respond to downward dispatch instructions. Used for SCADA/EMS real-time control and RTO/ISO reliability dispatch.' ;
    rdfs:domain ind:DispatchAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rampRateUpMwPerMin rdf:type rdf:Property ;
    rdfs:label 'Ramp Rate Up Mw Per Min' ;
    rdfs:comment 'The maximum rate in Megawatts per minute (MW/min) at which the generation unit can increase its output, as recognized in this dispatch award. Constrains how quickly the unit can respond to upward dispatch instructions from the RTO/ISO or SCADA/EMS. Critical for frequency regulation and ancillary services compliance.' ;
    rdfs:domain ind:DispatchAward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scheduledMw rdf:type rdf:Property ;
    rdfs:label 'Scheduled Mw' ;
    rdfs:comment 'The awarded generation output in Megawatts (MW) that the generation unit is scheduled to produce during the dispatch interval, as determined by the RTO/ISO market clearing engine. This is the primary quantitative fact of the dispatch award. Used for real-time SCADA/EMS dispatch execution, settlement, and NERC reliability compliance.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:settlementAmountUsd rdf:type rdf:Property ;
    rdfs:label 'Settlement Amount Usd' ;
    rdfs:comment 'The gross settlement amount in US Dollars ($) for this dispatch award, calculated as scheduled_mw × (interval_duration_minutes / 60) × lmp_usd_per_mwh plus applicable start-up and no-load cost recovery. Represents the revenue or cost obligation for the awarded interval. Used for financial settlement reconciliation with the RTO/ISO and GAAP revenue recognition.' ;
    rdfs:domain ind:Market ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:demandResponseProgramId rdf:type rdf:Property ;
    rdfs:label 'Demand Response Program Id' ;
    rdfs:comment 'Reference to the Demand Response (DR) or Demand-Side Management (DSM) program under which this bid is submitted, if applicable. Links demand response curtailment offers to the specific program enrollment. Null for supply-side bids. Supports DR program performance tracking and FERC Order 745 compliance.' ;
    rdfs:domain ind:Market ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DemandResponseProgram .

ind:resourceGeneratingUnitId rdf:type rdf:Property ;
    rdfs:label 'Resource Generating Unit Id' ;
    rdfs:comment 'Reference to the generating unit, load resource, or virtual resource associated with this bid. Links to the asset or resource master record (e.g., a generation unit registered with the RTO/ISO). Serves as the PARTY_REFERENCE / resource reference for this transaction.' ;
    rdfs:domain ind:EnergyBid ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GeneratingUnit .

ind:bidCurveSegmentCount rdf:type rdf:Property ;
    rdfs:label 'Bid Curve Segment Count' ;
    rdfs:comment 'The number of price-quantity segments in the bid curve for this offer. Most RTO/ISO markets allow multi-segment step-function bids (e.g., up to 10 segments in PJM). A value of 1 indicates a single-price, single-quantity bid. Used to understand bid complexity and for validation against market rules.' ;
    rdfs:domain ind:EnergyBid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bidPricePerMwh rdf:type rdf:Property ;
    rdfs:label 'Bid Price Per Mwh' ;
    rdfs:comment 'The offer or bid price in US dollars per Megawatt-Hour ($/MWh) for the first or single segment of the bid curve. For multi-segment bids, this represents the marginal cost or price at the first step. Confidential as it reflects the utility\'s internal cost and pricing strategy. Core MONETARY_TRIPLET / QUANTITATIVE_RESULT field for this transaction.' ;
    rdfs:domain ind:EnergyBid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bidQuantityMw rdf:type rdf:Property ;
    rdfs:label 'Bid Quantity Mw' ;
    rdfs:comment 'The total quantity of energy or capacity offered or bid in Megawatts (MW) for this bid record. For supply offers, this is the maximum generation capacity offered. For demand bids, this is the load reduction or consumption quantity. Core quantitative field for market scheduling and settlement.' ;
    rdfs:domain ind:EnergyBid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bidReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Bid Reference Number' ;
    rdfs:comment 'Externally-known bid or offer identifier assigned by the RTO/ISO upon submission. Used to correlate internal records with the market operator\'s confirmation and settlement systems (e.g., MISO, PJM, CAISO bid ID). This is the BUSINESS_IDENTIFIER category field for this TRANSACTION_HEADER entity.' ;
    rdfs:domain ind:EnergyBid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bidStatus rdf:type rdf:Property ;
    rdfs:label 'Bid Status' ;
    rdfs:comment 'Current lifecycle state of the bid as returned by the RTO/ISO or tracked internally. \'submitted\' = sent to market operator; \'accepted\' = cleared by the market; \'rejected\' = not accepted by the market operator; \'partially_accepted\' = portion of bid quantity cleared; \'withdrawn\' = retracted before market close; \'expired\' = submission window closed without action. This is the LIFECYCLE_STATUS category field for this TRANSACTION_HEADER entity.' ;
    rdfs:domain ind:EnergyBid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bidType rdf:type rdf:Property ;
    rdfs:label 'Bid Type' ;
    rdfs:comment 'Classifies the nature of the bid or offer submitted to the market. \'energy\' = standard energy supply or demand bid; \'ancillary\' = ancillary services (regulation, spinning reserve, etc.); \'capacity\' = capacity market obligation; \'virtual\' = virtual transaction (INC/DEC/UTC — note: virtual bids may warrant a dedicated product at ECM scope); \'demand_response\' = Demand Response (DR) curtailment offer. [ENUM-REF-CANDIDATE: energy|ancillary|capacity|virtual|demand_response|export|import — promote to reference product]' ;
    rdfs:domain ind:EnergyBid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bidVersion rdf:type rdf:Property ;
    rdfs:label 'Bid Version' ;
    rdfs:comment 'Sequential version number of the bid, incremented each time the bid is amended or resubmitted prior to market close. Version 1 is the original submission. Used to track bid revisions and ensure the latest version is used for settlement and reporting.' ;
    rdfs:domain ind:EnergyBid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:capacityMarketObligationMw rdf:type rdf:Property ;
    rdfs:label 'Capacity Market Obligation Mw' ;
    rdfs:comment 'The capacity obligation in Megawatts (MW) associated with this bid in the capacity market (e.g., PJM RPM, MISO Planning Resource Auction). Represents the committed capacity the resource must provide to meet resource adequacy requirements. Null for non-capacity bids.' ;
    rdfs:domain ind:EnergyBid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:clearedPricePerMwh rdf:type rdf:Property ;
    rdfs:label 'Cleared Price Per Mwh' ;
    rdfs:comment 'The Locational Marginal Price (LMP) or market clearing price in $/MWh at which this bid was settled by the RTO/ISO. Populated after market clearing results are received. Used for revenue calculation and settlement reconciliation. Confidential as it reflects market settlement financials.' ;
    rdfs:domain ind:EnergyBid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:clearedQuantityMw rdf:type rdf:Property ;
    rdfs:label 'Cleared Quantity Mw' ;
    rdfs:comment 'The quantity of energy or capacity in Megawatts (MW) that was accepted and cleared by the RTO/ISO market. May be less than bid_quantity_mw for partially accepted bids. Null if the bid was rejected or not yet processed. Used for settlement reconciliation and dispatch scheduling.' ;
    rdfs:domain ind:EnergyBid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lmpCongestionComponent rdf:type rdf:Property ;
    rdfs:label 'Lmp Congestion Component' ;
    rdfs:comment 'The congestion component of the Locational Marginal Price (LMP) in $/MWh, reflecting transmission congestion costs at the pricing node. A negative value indicates the node benefits from congestion (sink node). Used for transmission planning and congestion cost analysis.' ;
    rdfs:domain ind:Market ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lmpEnergyComponent rdf:type rdf:Property ;
    rdfs:label 'Lmp Energy Component' ;
    rdfs:comment 'The energy component of the Locational Marginal Price (LMP) in $/MWh, representing the system marginal cost of energy at the pricing node. LMP is decomposed into energy, congestion, and loss components per FERC and RTO/ISO settlement rules. Used for granular settlement analysis and IRP cost modeling.' ;
    rdfs:domain ind:Market ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lmpLossComponent rdf:type rdf:Property ;
    rdfs:label 'Lmp Loss Component' ;
    rdfs:comment 'The marginal loss component of the Locational Marginal Price (LMP) in $/MWh, reflecting the cost of transmission losses at the pricing node. Used with energy and congestion components to reconcile total LMP for settlement and cost allocation.' ;
    rdfs:domain ind:Market ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:marketSubmissionDeadline rdf:type rdf:Property ;
    rdfs:label 'Market Submission Deadline' ;
    rdfs:comment 'The RTO/ISO-defined deadline timestamp by which bids must be submitted for the target operating date and market type. Used to assess whether the bid was submitted on time and for compliance monitoring against market participation rules.' ;
    rdfs:domain ind:EnergyBid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:maximumCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Maximum Capacity Mw' ;
    rdfs:comment 'The maximum generation or load capacity in Megawatts (MW) available for this bid. Represents the upper physical limit of the resource\'s capability for the bid interval. Must not exceed the resource\'s registered capacity with the RTO/ISO.' ;
    rdfs:domain ind:EnergyBid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rejectionReasonCode rdf:type rdf:Property ;
    rdfs:label 'Rejection Reason Code' ;
    rdfs:comment 'The reason code or message returned by the RTO/ISO when a bid is rejected or partially accepted. Null for accepted bids. Used for operational troubleshooting, bid strategy refinement, and regulatory compliance review. Values are RTO/ISO-specific and may vary by market operator.' ;
    rdfs:domain ind:EnergyBid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rtoConfirmationNumber rdf:type rdf:Property ;
    rdfs:label 'Rto Confirmation Number' ;
    rdfs:comment 'The confirmation or acknowledgment number returned by the RTO/ISO system upon successful receipt of the bid submission. Serves as the external system receipt reference for audit and dispute resolution purposes.' ;
    rdfs:domain ind:EnergyBid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:selfScheduleFlag rdf:type rdf:Property ;
    rdfs:label 'Self Schedule Flag' ;
    rdfs:comment 'Indicates whether this bid is a self-schedule (True) or an economic bid (False). Self-schedules are submitted at a price that ensures dispatch regardless of market clearing price (e.g., must-run or must-take resources such as nuclear or contracted renewables). Economic bids compete on price in the market.' ;
    rdfs:domain ind:EnergyBid ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:submissionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Submission Timestamp' ;
    rdfs:comment 'The date and time when the bid or offer was submitted to the RTO/ISO market system. Represents the principal real-world business event time (BUSINESS_EVENT_TIMESTAMP category). Stored in ISO 8601 format with timezone offset. Critical for market deadline compliance and audit trail.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lmpPriceId rdf:type rdf:Property ;
    rdfs:label 'Lmp Price Id' ;
    rdfs:comment 'Unique surrogate identifier for each LMP price record in the silver layer. Primary key for the lmp_price data product. Entity role: TRANSACTION_HEADER — represents a discrete published price event from the RTO/ISO for a specific pricing node and settlement interval.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LmpPrice .

ind:lmpPricingNodeId rdf:type rdf:Property ;
    rdfs:label 'Lmp Pricing Node Id' ;
    rdfs:comment 'FK to market.pricing_node' ;
    rdfs:domain ind:LmpPrice ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PricingNode .

ind:primaryLmpPricingNodeId rdf:type rdf:Property ;
    rdfs:label 'Primary Lmp Pricing Node Id' ;
    rdfs:comment 'Reference identifier for the pricing node (pnode) at which the LMP is published by the RTO/ISO. A pnode represents a specific electrical bus or aggregation point on the transmission grid where energy prices are calculated. Used to join to the pnode master reference for geographic and network context.' ;
    rdfs:domain ind:LmpPrice ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PricingNode .

ind:congestionComponentPerMwh rdf:type rdf:Property ;
    rdfs:label 'Congestion Component Per Mwh' ;
    rdfs:comment 'The congestion component of the LMP in US dollars per megawatt-hour ($/MWh), reflecting the cost of transmission congestion at this pricing node relative to the reference bus. A positive value indicates the node is import-constrained; a negative value indicates export-constrained. Critical for transmission congestion management and FTR/CRR hedging analysis.' ;
    rdfs:domain ind:LmpPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:congestionDirection rdf:type rdf:Property ;
    rdfs:label 'Congestion Direction' ;
    rdfs:comment 'Indicates the direction of transmission congestion affecting this pricing node: IMPORT (node is import-constrained, positive congestion component), EXPORT (node is export-constrained, negative congestion component), or UNCONSTRAINED (no binding transmission constraint). Supports FTR/CRR portfolio management and transmission congestion hedging strategy.' ;
    rdfs:domain ind:LmpPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataFeedCode rdf:type rdf:Property ;
    rdfs:label 'Data Feed Code' ;
    rdfs:comment 'Code identifying the specific RTO/ISO data feed, API endpoint, or file type from which this LMP record was sourced (e.g., PJM_DA_LMP, CAISO_RTM_LMP_5MIN). Supports data lineage tracking, feed monitoring, and troubleshooting of price data gaps or anomalies.' ;
    rdfs:domain ind:LmpPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:energyComponentPerMwh rdf:type rdf:Property ;
    rdfs:label 'Energy Component Per Mwh' ;
    rdfs:comment 'The energy component of the LMP in US dollars per megawatt-hour ($/MWh), representing the system-wide marginal cost of energy at the reference bus. This component is uniform across all nodes in the market and reflects the cost of the marginal generating unit dispatched to serve load.' ;
    rdfs:domain ind:LmpPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isBindingConstraint rdf:type rdf:Property ;
    rdfs:label 'Is Binding Constraint' ;
    rdfs:comment 'Indicates whether a transmission constraint was binding during this settlement interval at or affecting this pricing node (True = binding constraint active; False = no binding constraint). A binding constraint causes non-zero congestion component values and is critical for transmission congestion management and FTR/CRR settlement analysis.' ;
    rdfs:domain ind:LmpPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isHoliday rdf:type rdf:Property ;
    rdfs:label 'Is Holiday' ;
    rdfs:comment 'Indicates whether the operating date falls on a recognized market holiday as defined by the RTO/ISO or applicable tariff (True = holiday; False = non-holiday). Holiday periods typically follow off-peak pricing rules and affect demand response program eligibility and TOU rate calculations.' ;
    rdfs:domain ind:LmpPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPriceCapApplied rdf:type rdf:Property ;
    rdfs:label 'Is Price Cap Applied' ;
    rdfs:comment 'Indicates whether the RTO/ISO applied a market price cap or floor to this LMP during the settlement interval (True = price cap or floor was applied; False = price cleared within normal bounds). Price caps are regulatory limits set by FERC to prevent market manipulation. Relevant for settlement dispute analysis and regulatory reporting.' ;
    rdfs:domain ind:LmpPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lmpTotalPerMwh rdf:type rdf:Property ;
    rdfs:label 'Lmp Total Per Mwh' ;
    rdfs:comment 'The total Locational Marginal Price (LMP) in US dollars per megawatt-hour ($/MWh) for this pricing node and settlement interval, as published by the RTO/ISO. Equals the sum of the energy component, congestion component, and loss component. The primary price used for wholesale energy settlement calculations.' ;
    rdfs:domain ind:LmpPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lmpVersion rdf:type rdf:Property ;
    rdfs:label 'Lmp Version' ;
    rdfs:comment 'Version label or identifier assigned by the RTO/ISO to distinguish between different published versions of LMP data for the same operating interval (e.g., \'v1\', \'v2\', or a timestamp-based version string). Used alongside revision_number to uniquely identify the authoritative price record for settlement and audit purposes.' ;
    rdfs:domain ind:LmpPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loadZoneCode rdf:type rdf:Property ;
    rdfs:label 'Load Zone Code' ;
    rdfs:comment 'The RTO/ISO-defined load zone or pricing zone code to which this pricing node belongs. Load zones aggregate individual bus nodes for zonal settlement and load-serving entity (LSE) obligations. Used for zonal LMP analysis, capacity market obligations, and TOU rate design.' ;
    rdfs:domain ind:Market ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossComponentPerMwh rdf:type rdf:Property ;
    rdfs:label 'Loss Component Per Mwh' ;
    rdfs:comment 'The marginal loss component of the LMP in US dollars per megawatt-hour ($/MWh), representing the cost of marginal transmission losses at this pricing node relative to the reference bus. Reflects the incremental cost of delivering an additional MWh to this node accounting for line losses.' ;
    rdfs:domain ind:LmpPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:marketDay rdf:type rdf:Property ;
    rdfs:label 'Market Day' ;
    rdfs:comment 'The market operating day (yyyy-MM-dd) as defined by the RTO/ISO, which may differ from the calendar date for intervals near midnight due to market day boundary conventions. Used for market settlement period alignment and day-ahead vs. real-time reconciliation.' ;
    rdfs:domain ind:LmpPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:peakPeriodType rdf:type rdf:Property ;
    rdfs:label 'Peak Period Type' ;
    rdfs:comment 'Classification of the settlement interval into a peak period category based on the applicable tariff or market definition: ON_PEAK (high-demand hours, typically weekday daytime), OFF_PEAK (low-demand hours, nights and weekends), SUPER_PEAK (highest demand hours for CPP or TOU rates), or SHOULDER (transitional hours). Used for TOU rate analysis, demand response program evaluation, and IRP resource adequacy studies.' ;
    rdfs:domain ind:LmpPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priceCapType rdf:type rdf:Property ;
    rdfs:label 'Price Cap Type' ;
    rdfs:comment 'Type of price cap or floor applied to this LMP when is_price_cap_applied is True. OFFER_CAP indicates the offer cap was binding; PRICE_FLOOR indicates the minimum price floor was applied; SCARCITY_PRICING indicates emergency scarcity pricing was triggered; NONE indicates no cap was applied. Used for market monitoring and regulatory reporting to FERC.' ;
    rdfs:domain ind:LmpPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priceQualityFlag rdf:type rdf:Property ;
    rdfs:label 'Price Quality Flag' ;
    rdfs:comment 'Data quality indicator for this LMP record as assessed by the utility\'s market data management or EMS platform. VALID = price passed all validation checks; SUSPECT = price flagged for review due to anomalous value; INVALID = price failed validation and should not be used for settlement; ESTIMATED = price was estimated due to missing source data; MISSING = no price was received for this interval.' ;
    rdfs:domain ind:LmpPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priceStatus rdf:type rdf:Property ;
    rdfs:label 'Price Status' ;
    rdfs:comment 'Lifecycle status of this LMP price record indicating its settlement finality. PRELIMINARY prices are published shortly after the interval; FINAL prices are the binding settlement values after RTO/ISO validation; REVISED prices reflect corrections to previously published values; ESTIMATED prices are used when actual data is unavailable. Drives which records are used in financial settlement.' ;
    rdfs:domain ind:LmpPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publishTimestamp rdf:type rdf:Property ;
    rdfs:label 'Publish Timestamp' ;
    rdfs:comment 'The date and time when the RTO/ISO officially published or released this LMP price record, in ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX). Represents the business event time of price publication. Used to track data latency, validate timeliness of price feeds, and support audit trails for settlement disputes.' ;
    rdfs:domain ind:LmpPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:revisionNumber rdf:type rdf:Property ;
    rdfs:label 'Revision Number' ;
    rdfs:comment 'Sequential revision number assigned by the RTO/ISO or the utility\'s MDMS/market system to track successive corrections to a published LMP for the same pnode and interval. A value of 0 or 1 indicates the initial publication; higher values indicate subsequent revisions. Used to identify the most current authoritative price for settlement.' ;
    rdfs:domain ind:LmpPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:seasonCode rdf:type rdf:Property ;
    rdfs:label 'Season Code' ;
    rdfs:comment 'Seasonal classification of the operating date for this LMP record (SUMMER, WINTER, SPRING, FALL) based on the utility\'s or RTO/ISO\'s tariff-defined seasonal boundaries. Used for seasonal price analysis, capacity market seasonal obligations, and IRP resource adequacy modeling.' ;
    rdfs:domain ind:LmpPrice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemRecordCode rdf:type rdf:Property ;
    rdfs:label 'Source System Record Code' ;
    rdfs:comment 'The native record identifier assigned by the source RTO/ISO market system or the utility\'s market data management platform (e.g., ABB or GE Energy Management System, or the RTO/ISO API response record ID). Enables traceability back to the originating system for audit, reconciliation, and dispute resolution purposes.' ;
    rdfs:domain ind:Market ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ancillaryServicesAuthorized rdf:type rdf:Property ;
    rdfs:label 'Ancillary Services Authorized' ;
    rdfs:comment 'Indicates whether the utility is authorized to offer ancillary services (regulation, spinning reserve, non-spinning reserve, reactive power) in the RTO/ISO market under this registration.' ;
    rdfs:domain ind:ParticipantRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:capacityMarketAuthorized rdf:type rdf:Property ;
    rdfs:label 'Capacity Market Authorized' ;
    rdfs:comment 'Indicates whether the utility is authorized to participate in the capacity market (e.g., PJM RPM, MISO Planning Resource Auction) under this registration. True if authorized for capacity obligations and auctions.' ;
    rdfs:domain ind:ParticipantRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:collateralRequirementUsd rdf:type rdf:Property ;
    rdfs:label 'Collateral Requirement Usd' ;
    rdfs:comment 'The total collateral amount in US dollars required by the RTO/ISO to cover the utility\'s market exposure under this registration. Determined by the RTO/ISO based on credit rating, market activity, and unsecured credit limits.' ;
    rdfs:domain ind:Market ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:creditRatingAgency rdf:type rdf:Property ;
    rdfs:label 'Credit Rating Agency' ;
    rdfs:comment 'The credit rating agency that issued the credit rating used to satisfy the RTO/ISO credit and collateral requirements for market participation. RTO/ISOs require participants to demonstrate creditworthiness.' ;
    rdfs:domain ind:Market ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:damAuthorized rdf:type rdf:Property ;
    rdfs:label 'Dam Authorized' ;
    rdfs:comment 'Indicates whether the utility is authorized to submit bids and offers in the Day-Ahead Market (DAM) under this registration. Supports scheduling and financial settlement for next-day energy positions.' ;
    rdfs:domain ind:ParticipantRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dbaName rdf:type rdf:Property ;
    rdfs:label 'Dba Name' ;
    rdfs:comment 'Trade name or doing-business-as name used by the utility in market operations, if different from the legal entity name. May appear on market communications and RTO/ISO portals.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:energyMarketAuthorized rdf:type rdf:Property ;
    rdfs:label 'Energy Market Authorized' ;
    rdfs:comment 'Indicates whether the utility is authorized to participate in the energy market (Day-Ahead Market and Real-Time Market) under this registration. True if authorized for energy bids and offers.' ;
    rdfs:domain ind:ParticipantRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fercMbrAuthorizationDate rdf:type rdf:Property ;
    rdfs:label 'Ferc Mbr Authorization Date' ;
    rdfs:comment 'The date on which FERC granted market-based rate authority to the utility under the referenced docket number. Establishes the legal basis for wholesale energy market participation.' ;
    rdfs:domain ind:ParticipantRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fercMbrDocketNumber rdf:type rdf:Property ;
    rdfs:label 'Ferc Mbr Docket Number' ;
    rdfs:comment 'The Federal Energy Regulatory Commission docket number associated with the utility\'s market-based rate authorization. Format follows FERC docket numbering convention (e.g., ER22-1234-000). Required for FERC compliance, rate case management, and regulatory reporting.' ;
    rdfs:domain ind:Market ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fercMbrExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Ferc Mbr Expiration Date' ;
    rdfs:comment 'The date on which the FERC market-based rate authorization expires and must be renewed. Null if the authorization is indefinite. Supports regulatory compliance monitoring and renewal workflow triggers.' ;
    rdfs:domain ind:ParticipantRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ftrAuthorized rdf:type rdf:Property ;
    rdfs:label 'Ftr Authorized' ;
    rdfs:comment 'Indicates whether the utility is authorized to hold and trade Financial Transmission Rights (FTRs) in the RTO/ISO market under this registration. FTRs are used to hedge against congestion costs in LMP-based markets.' ;
    rdfs:domain ind:ParticipantRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:irpResourceAdequacyFlag rdf:type rdf:Property ;
    rdfs:label 'Irp Resource Adequacy Flag' ;
    rdfs:comment 'Indicates whether this market participant registration is associated with resource adequacy obligations under the utility\'s Integrated Resource Plan (IRP). True if the registration supports IRP-tracked capacity commitments.' ;
    rdfs:domain ind:Market ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastAmendedDate rdf:type rdf:Property ;
    rdfs:label 'Last Amended Date' ;
    rdfs:comment 'The date on which the market participant registration was most recently amended or updated with the RTO/ISO or FERC. Tracks the currency of the registration and triggers compliance review workflows.' ;
    rdfs:domain ind:ParticipantRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:legalEntityName rdf:type rdf:Property ;
    rdfs:label 'Legal Entity Name' ;
    rdfs:comment 'The full legal name of the utility entity as registered with the RTO/ISO and on file with FERC. Must match the name on the FERC market-based rate authorization and RTO/ISO membership agreement.' ;
    rdfs:domain ind:ParticipantRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lseLoadZone rdf:type rdf:Property ;
    rdfs:label 'Lse Load Zone' ;
    rdfs:comment 'The RTO/ISO-designated load zone associated with the utility\'s load-serving entity registration. Determines the applicable zonal LMP for load settlement and capacity market obligations. Applicable when participant_type includes load_serving_entity.' ;
    rdfs:domain ind:ParticipantRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketRegion rdf:type rdf:Property ;
    rdfs:label 'Market Region' ;
    rdfs:comment 'The geographic market region or zone within the RTO/ISO footprint where the utility is registered to participate (e.g., PJM-WEST, MISO-Central, CAISO-NP15). Relevant for Locational Marginal Price (LMP) settlement and capacity market zone assignments.' ;
    rdfs:domain ind:Market ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:membershipAgreementDate rdf:type rdf:Property ;
    rdfs:label 'Membership Agreement Date' ;
    rdfs:comment 'The date on which the utility executed the RTO/ISO membership or participation agreement. Establishes the contractual start of the market relationship.' ;
    rdfs:domain ind:ParticipantRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:membershipAgreementNumber rdf:type rdf:Property ;
    rdfs:label 'Membership Agreement Number' ;
    rdfs:comment 'The agreement or contract number assigned by the RTO/ISO for the utility\'s membership or participation agreement. Serves as the binding contractual reference for market participation rights and obligations.' ;
    rdfs:domain ind:ParticipantRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nercFunctionCodes rdf:type rdf:Property ;
    rdfs:label 'Nerc Function Codes' ;
    rdfs:comment 'Comma-separated list of NERC functional entity registration codes applicable to this participant (e.g., BA=Balancing Authority, TO=Transmission Owner, GO=Generator Owner, LSE=Load-Serving Entity, DP=Distribution Provider). Supports NERC compliance reporting and reliability standard applicability determination.' ;
    rdfs:domain ind:ParticipantRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nercRegisteredEntityCode rdf:type rdf:Property ;
    rdfs:label 'Nerc Registered Entity Code' ;
    rdfs:comment 'The unique identifier assigned by the North American Electric Reliability Corporation (NERC) to the utility as a registered reliability entity (e.g., Transmission Operator, Balancing Authority, Generator Operator). Links market participation to NERC reliability compliance obligations.' ;
    rdfs:domain ind:Market ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:oattFilingDate rdf:type rdf:Property ;
    rdfs:label 'Oatt Filing Date' ;
    rdfs:comment 'The date on which the utility filed its Open Access Transmission Tariff (OATT) with FERC, establishing the terms and conditions for transmission service. Relevant for transmission owner registrations.' ;
    rdfs:domain ind:ParticipantRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:participantType rdf:type rdf:Property ;
    rdfs:label 'Participant Type' ;
    rdfs:comment 'Classification of the utility\'s role in the wholesale energy market as registered with the RTO/ISO. Determines which market products and services the participant is authorized to transact. [ENUM-REF-CANDIDATE: load_serving_entity|generator_owner|transmission_owner|marketer|power_marketer|distribution_utility|combined_utility — promote to reference product]' ;
    rdfs:domain ind:ParticipantRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryContactEmail rdf:type rdf:Property ;
    rdfs:label 'Primary Contact Email' ;
    rdfs:comment 'Email address of the primary contact person responsible for market operations and RTO/ISO communications under this registration. Used for regulatory correspondence, market notices, and settlement dispute communications.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryContactName rdf:type rdf:Property ;
    rdfs:label 'Primary Contact Name' ;
    rdfs:comment 'Full name of the primary contact person at the utility responsible for market operations and RTO/ISO communications under this registration. Used for regulatory correspondence and RTO/ISO notifications.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryContactPhone rdf:type rdf:Property ;
    rdfs:label 'Primary Contact Phone' ;
    rdfs:comment 'Phone number of the primary contact person responsible for market operations and RTO/ISO communications under this registration.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recTrackingProgram rdf:type rdf:Property ;
    rdfs:label 'Rec Tracking Program' ;
    rdfs:comment 'The REC tracking registry or program in which the utility is enrolled under this market registration for tracking and retiring Renewable Energy Certificates (RECs) to demonstrate RPS compliance (e.g., GATS, M-RETS, WREGIS, NEPOOL GIS). [ENUM-REF-CANDIDATE: GATS|MRETS|WREGIS|NEPOOL-GIS|PJM-GATS|ERCOT-REC|NAR — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:ParticipantRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registrationNotes rdf:type rdf:Property ;
    rdfs:label 'Registration Notes' ;
    rdfs:comment 'Free-text field for capturing supplementary information about the market participant registration, including special conditions, regulatory caveats, pending amendments, or operational notes relevant to market compliance and operations.' ;
    rdfs:domain ind:ParticipantRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryContactEmail rdf:type rdf:Property ;
    rdfs:label 'Regulatory Contact Email' ;
    rdfs:comment 'Email address of the regulatory affairs contact responsible for FERC filings and compliance activities associated with this market registration.' ;
    rdfs:domain ind:ParticipantRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryContactName rdf:type rdf:Property ;
    rdfs:label 'Regulatory Contact Name' ;
    rdfs:comment 'Full name of the regulatory affairs contact responsible for FERC filings, rate case management, and PUC compliance activities associated with this market registration. May differ from the primary market operations contact.' ;
    rdfs:domain ind:ParticipantRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rtmAuthorized rdf:type rdf:Property ;
    rdfs:label 'Rtm Authorized' ;
    rdfs:comment 'Indicates whether the utility is authorized to participate in the Real-Time Market (RTM) under this registration. Supports real-time dispatch, imbalance settlement, and deviation management.' ;
    rdfs:domain ind:ParticipantRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rtoIsoParticipantCode rdf:type rdf:Property ;
    rdfs:label 'Rto Iso Participant Code' ;
    rdfs:comment 'The unique participant identifier assigned by the specific RTO/ISO to the utility as a registered market participant. This is the externally-known business identifier used in all market communications, bid submissions, and settlement statements with the RTO/ISO (e.g., PJM participant ID, CAISO SCID). Essential for FERC compliance and market operations.' ;
    rdfs:domain ind:ParticipantRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateJurisdiction rdf:type rdf:Property ;
    rdfs:label 'State Jurisdiction' ;
    rdfs:comment 'The U.S. state(s) in which the utility holds a Certificate of Public Convenience and Necessity (CPCN) and is subject to state Public Utility Commission (PUC) jurisdiction. Relevant for aligning market participation with state-level regulatory obligations and IRP requirements.' ;
    rdfs:domain ind:Market ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unsecuredCreditLimitUsd rdf:type rdf:Property ;
    rdfs:label 'Unsecured Credit Limit Usd' ;
    rdfs:comment 'The maximum unsecured credit limit in US dollars extended by the RTO/ISO to the utility under this registration, based on credit rating and financial standing. Amounts above this limit require collateral posting.' ;
    rdfs:domain ind:Market ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:virtualBiddingAuthorized rdf:type rdf:Property ;
    rdfs:label 'Virtual Bidding Authorized' ;
    rdfs:comment 'Indicates whether the utility is authorized to submit virtual bids (increment offers / decrement bids) in the Day-Ahead Market under this registration. Virtual bidding is used for financial arbitrage between DAM and RTM prices.' ;
    rdfs:domain ind:ParticipantRegistration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:approvalCommissionOrderId rdf:type rdf:Property ;
    rdfs:label 'Approval Commission Order Id' ;
    rdfs:comment 'Foreign key linking to regulatory.commission_order. Business justification: PPAs approved via commission orders. Links power purchase agreements to their regulatory approval orders for authorization tracking and compliance verification.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CommissionOrder .

ind:costRecoveryMechanismId rdf:type rdf:Property ;
    rdfs:label 'Cost Recovery Mechanism Id' ;
    rdfs:comment 'Foreign key linking to regulatory.cost_recovery_mechanism. Business justification: PPA costs recovered through purchased power cost adjustment mechanisms. Links specific power purchase agreements to their regulatory cost recovery riders for tariff rate calculation.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CostRecoveryMechanism .

ind:interconnectionRequestId rdf:type rdf:Property ;
    rdfs:label 'Interconnection Request Id' ;
    rdfs:comment 'Reference to the FERC-filed interconnection agreement governing the physical grid connection of the contracted generation resource. Required for unit-contingent and tolling PPAs.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InterconnectionRequest .

ind:irpPortfolioId rdf:type rdf:Property ;
    rdfs:label 'Irp Portfolio Id' ;
    rdfs:comment 'Reference to the Integrated Resource Plan (IRP) resource portfolio to which this Power Purchase Agreement is assigned. Supports IRP resource adequacy analysis and long-term supply planning.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IrpPortfolio .

ind:regulatoryDocketId rdf:type rdf:Property ;
    rdfs:label 'Regulatory Docket Id' ;
    rdfs:comment 'Foreign key linking to regulatory.docket. Business justification: Power purchase agreements require regulatory approval and oversight. Links PPA to its regulatory proceeding for approval tracking, prudency review, and cost recovery authorization in utility operation' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Docket .

ind:ancillaryServicesIncluded rdf:type rdf:Property ;
    rdfs:label 'Ancillary Services Included' ;
    rdfs:comment 'Indicates whether ancillary services (regulation, spinning reserve, non-spinning reserve, voltage support) are included in the scope of this Power Purchase Agreement in addition to energy and capacity.' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:annualEnergyMwh rdf:type rdf:Property ;
    rdfs:label 'Annual Energy Mwh' ;
    rdfs:comment 'Expected annual energy delivery volume in Megawatt-Hours (MWh) under this Power Purchase Agreement. Used for annual budget planning, FAC (Fuel Adjustment Clause) forecasting, and regulatory reporting.' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:billingFrequency rdf:type rdf:Property ;
    rdfs:label 'Billing Frequency' ;
    rdfs:comment 'Frequency at which financial settlement invoices are generated under this Power Purchase Agreement. Drives integration with SAP S/4HANA accounts payable/receivable and billing cycles.' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capacityMarketEligible rdf:type rdf:Property ;
    rdfs:label 'Capacity Market Eligible' ;
    rdfs:comment 'Indicates whether the contracted resource qualifies for capacity market obligations under the applicable RTO/ISO capacity market (e.g., PJM RPM, MISO Planning Resource Auction). True if eligible; False if energy-only.' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:capacityPricePerMwMonth rdf:type rdf:Property ;
    rdfs:label 'Capacity Price Per Mw Month' ;
    rdfs:comment 'Contracted capacity payment in USD per MW per month for capacity-inclusive Power Purchase Agreements. Reflects the resource adequacy value of the contracted capacity. Null for energy-only contracts.' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contractTermYears rdf:type rdf:Property ;
    rdfs:label 'Contract Term Years' ;
    rdfs:comment 'Total duration of the Power Purchase Agreement expressed in years. Used for IRP long-term resource planning, AFUDC (Allowance for Funds Used During Construction) calculations, and CAPEX amortization analysis.' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contractedCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Contracted Capacity Mw' ;
    rdfs:comment 'Maximum contracted generation capacity in Megawatts (MW) that the seller is obligated to make available under this Power Purchase Agreement. Used in NERC resource adequacy assessments and IRP capacity planning.' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contractedEnergyMwh rdf:type rdf:Property ;
    rdfs:label 'Contracted Energy Mwh' ;
    rdfs:comment 'Total contracted energy volume in Megawatt-Hours (MWh) over the full term of the Power Purchase Agreement. Used for long-term supply portfolio management and IRP resource adequacy analysis.' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:creditSupportAmount rdf:type rdf:Property ;
    rdfs:label 'Credit Support Amount' ;
    rdfs:comment 'Dollar value of credit support or collateral posted under this Power Purchase Agreement. Used for counterparty credit risk exposure monitoring and financial reporting.' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:creditSupportType rdf:type rdf:Property ;
    rdfs:label 'Credit Support Type' ;
    rdfs:comment 'Type of credit support or collateral arrangement required under this Power Purchase Agreement to mitigate counterparty credit risk. Relevant for SOX financial risk management and FERC credit requirements.' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:curtailmentRights rdf:type rdf:Property ;
    rdfs:label 'Curtailment Rights' ;
    rdfs:comment 'Specifies which party holds curtailment rights under the Power Purchase Agreement. Buyer curtailment allows the utility to reduce scheduled deliveries; seller curtailment allows the generator to reduce output; mutual curtailment permits either party. Relevant for Demand Response (DR) and grid reliability operations.' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryPoint rdf:type rdf:Property ;
    rdfs:label 'Delivery Point' ;
    rdfs:comment 'Named electrical delivery point or pricing node where energy is transferred under the Power Purchase Agreement (e.g., RTO/ISO hub, busbar, interconnection point). Aligns with LMP settlement nodes in the Day-Ahead Market (DAM) and Real-Time Market (RTM).' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:energyPricePerMwh rdf:type rdf:Property ;
    rdfs:label 'Energy Price Per Mwh' ;
    rdfs:comment 'Contracted energy price in USD per Megawatt-Hour (MWh) for fixed-price Power Purchase Agreements. For index-linked contracts, this represents the base or floor price. Null for tolling agreements where pricing is fuel-cost-based.' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:executionDate rdf:type rdf:Property ;
    rdfs:label 'Execution Date' ;
    rdfs:comment 'Calendar date on which all parties signed and executed the Power Purchase Agreement. Distinct from the effective date; used for FERC filing timelines and contract audit trails.' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fercDocketNumber rdf:type rdf:Property ;
    rdfs:label 'Ferc Docket Number' ;
    rdfs:comment 'FERC-assigned docket number for the regulatory filing associated with this Power Purchase Agreement. Used for tracking FERC market-based rate authority approvals and compliance reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fercFilingStatus rdf:type rdf:Property ;
    rdfs:label 'Ferc Filing Status' ;
    rdfs:comment 'Current status of the FERC (Federal Energy Regulatory Commission) market-based rate authority filing associated with this Power Purchase Agreement. Tracks regulatory approval lifecycle for wholesale market transactions.' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forceMajeureClause rdf:type rdf:Property ;
    rdfs:label 'Force Majeure Clause' ;
    rdfs:comment 'Indicates whether the Power Purchase Agreement includes a force majeure clause that excuses performance obligations under extraordinary circumstances (natural disasters, grid emergencies, regulatory actions). True if clause is present.' ;
    rdfs:domain ind:Market ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumTakeMwh rdf:type rdf:Property ;
    rdfs:label 'Minimum Take Mwh' ;
    rdfs:comment 'Minimum energy volume in Megawatt-Hours (MWh) that the buyer is contractually obligated to take or pay for during each contract period. Represents the take-or-pay floor for financial settlement purposes.' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pucApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Puc Approval Date' ;
    rdfs:comment 'Date on which the state Public Utility Commission (PUC) approved this Power Purchase Agreement. Null if approval is not required or not yet received.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:pucApprovalRequired rdf:type rdf:Property ;
    rdfs:label 'Puc Approval Required' ;
    rdfs:comment 'Indicates whether this Power Purchase Agreement requires approval from the state Public Utility Commission (PUC) before becoming effective. True if PUC approval is required; False if the contract is exempt from state regulatory review.' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recBundled rdf:type rdf:Property ;
    rdfs:label 'Rec Bundled' ;
    rdfs:comment 'Indicates whether Renewable Energy Certificates (RECs) are bundled with the energy delivery under this Power Purchase Agreement. True if RECs transfer with energy; False if RECs are unbundled or retained by the seller. Critical for RPS compliance accounting.' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recQuantityAnnual rdf:type rdf:Property ;
    rdfs:label 'Rec Quantity Annual' ;
    rdfs:comment 'Expected annual quantity of Renewable Energy Certificates (RECs) transferred under this Power Purchase Agreement when rec_bundled is True. Measured in MWh-equivalent RECs. Used for RPS compliance portfolio management.' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:settlementCurrency rdf:type rdf:Property ;
    rdfs:label 'Settlement Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code for financial settlement of this Power Purchase Agreement (e.g., USD). Supports multi-currency contract management for cross-border PPAs.' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:terminationProvisions rdf:type rdf:Property ;
    rdfs:label 'Termination Provisions' ;
    rdfs:comment 'Description of early termination rights, notice periods, and termination payment obligations under the Power Purchase Agreement. Captures key contractual terms for legal and regulatory compliance review.' ;
    rdfs:domain ind:PpaContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:apnodePricingNodeId rdf:type rdf:Property ;
    rdfs:label 'Apnode Pricing Node Id' ;
    rdfs:comment 'The RTO/ISO-assigned identifier of the aggregated pricing node (APNode) that groups this generator bus node for scheduling and settlement purposes. APNodes are used in CAISO and similar markets to aggregate multiple generator buses under a single scheduling point. Null for non-generator-bus node types.' ;
    rdfs:domain ind:PricingNode ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PricingNode .

ind:hubNodeId rdf:type rdf:Property ;
    rdfs:label 'Hub Node Id' ;
    rdfs:comment 'The RTO/ISO-assigned identifier of the virtual trading hub node associated with this pricing node. Hub nodes (e.g., PJM Western Hub, CAISO NP15 Hub) serve as reference points for bilateral contract pricing and FTR settlement. Null for non-hub node types.' ;
    rdfs:domain ind:PricingNode ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PricingNode .

ind:ancillaryServicesEligible rdf:type rdf:Property ;
    rdfs:label 'Ancillary Services Eligible' ;
    rdfs:comment 'Indicates whether this pricing node is eligible to provide ancillary services (regulation up/down, spinning reserve, non-spinning reserve, voltage support) in the RTO/ISO market. Used for ancillary services bid mapping and capacity obligation tracking.' ;
    rdfs:domain ind:PricingNode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:busNumber rdf:type rdf:Property ;
    rdfs:label 'Bus Number' ;
    rdfs:comment 'The electrical bus number in the transmission network model (power flow model) corresponding to this pricing node. Used in SCADA/EMS systems (ABB or GE Energy Management System) for state estimation, contingency analysis, and LMP decomposition into energy, congestion, and loss components.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capacityMarketZone rdf:type rdf:Property ;
    rdfs:label 'Capacity Market Zone' ;
    rdfs:comment 'The capacity market zone or locational deliverability area (LDA) designation assigned by the RTO/ISO for capacity market obligations and auctions (e.g., PJM MAAC, EMAAC; NYISO Zone J; ISO-NE NEMA). Used for resource adequacy analysis in the IRP and capacity auction bid preparation.' ;
    rdfs:domain ind:PricingNode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:damEligible rdf:type rdf:Property ;
    rdfs:label 'Dam Eligible' ;
    rdfs:comment 'Indicates whether this pricing node is eligible for Day-Ahead Market (DAM) bid submission and settlement. True for nodes that can participate in the DAM; False for nodes restricted to real-time or ancillary services markets only.' ;
    rdfs:domain ind:PricingNode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ftrEligible rdf:type rdf:Property ;
    rdfs:label 'Ftr Eligible' ;
    rdfs:comment 'Indicates whether this pricing node is eligible as a source or sink point for Financial Transmission Rights (FTR) path definitions. FTR eligibility is required for congestion hedging in the utility\'s wholesale market portfolio.' ;
    rdfs:domain ind:PricingNode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lmpCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Lmp Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the LMP reference price (e.g., USD). Supports multi-currency environments for cross-border nodes and international market participation.' ;
    rdfs:domain ind:PricingNode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lmpReferencePrice rdf:type rdf:Property ;
    rdfs:label 'Lmp Reference Price' ;
    rdfs:comment 'The most recently published or baseline reference LMP in dollars per megawatt-hour ($/MWh) for this pricing node. Serves as a reference value for contract pricing, FTR valuation, and IRP resource adequacy analysis. Not a real-time or interval value — use the lmp_interval_data product for time-series LMP data.' ;
    rdfs:domain ind:PricingNode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nercBalancingAuthority rdf:type rdf:Property ;
    rdfs:label 'Nerc Balancing Authority' ;
    rdfs:comment 'The NERC-registered Balancing Authority (BA) area code responsible for maintaining load-generation balance at this pricing node\'s location (e.g., CISO, PJM, MISO). Required for NERC reliability reporting, FERC Form 714 submissions, and transmission planning studies.' ;
    rdfs:domain ind:PricingNode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nodeStatus rdf:type rdf:Property ;
    rdfs:label 'Node Status' ;
    rdfs:comment 'Current lifecycle status of the pricing node. Active nodes are eligible for LMP settlement and bid submission. Inactive or retired nodes are retained for historical settlement reference only.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pnodeCode rdf:type rdf:Property ;
    rdfs:label 'Pnode Code' ;
    rdfs:comment 'The externally-assigned unique identifier for this pricing node as published by the RTO/ISO (e.g., CAISO, PJM, MISO, ERCOT). This is the business-facing key used in market settlement systems, LMP price lookups, and bid submissions. Maps to the pnode_id field in RTO/ISO market data feeds.' ;
    rdfs:domain ind:PricingNode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pnodeName rdf:type rdf:Property ;
    rdfs:label 'Pnode Name' ;
    rdfs:comment 'Human-readable name of the pricing node as designated by the RTO/ISO. Used in market reports, settlement statements, and bid location mapping. Examples include generator bus names, load zone names, and hub designations.' ;
    rdfs:domain ind:PricingNode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pnodeOwnerType rdf:type rdf:Property ;
    rdfs:label 'Pnode Owner Type' ;
    rdfs:comment 'Classifies the ownership relationship of the utility to this pricing node. Utility-owned nodes correspond to the utility\'s own generation or load assets; third-party nodes are associated with counterparty assets relevant to PPA or bilateral contracts; RTO virtual nodes are hub or interface constructs with no physical owner; jointly-owned nodes reflect shared transmission assets.' ;
    rdfs:domain ind:PricingNode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pnodeType rdf:type rdf:Property ;
    rdfs:label 'Pnode Type' ;
    rdfs:comment 'Classification of the pricing node by its functional role in the wholesale market. Generator bus nodes represent individual generation injection points; load zone nodes represent aggregated load areas; hub nodes are virtual trading points; interface nodes represent inter-regional tie points; aggregated pnodes (APnodes) aggregate multiple generator buses for scheduling purposes.' ;
    rdfs:domain ind:PricingNode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rtmEligible rdf:type rdf:Property ;
    rdfs:label 'Rtm Eligible' ;
    rdfs:comment 'Indicates whether this pricing node is eligible for Real-Time Market (RTM) dispatch and settlement. True for nodes participating in the RTM; False for nodes limited to DAM or forward market products only.' ;
    rdfs:domain ind:PricingNode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transmissionOwnerCode rdf:type rdf:Property ;
    rdfs:label 'Transmission Owner Code' ;
    rdfs:comment 'The FERC-registered identifier or internal code of the transmission owner responsible for the physical transmission facilities at this pricing node. Used for OATT cost allocation, transmission service requests, and FERC Form 1 regulatory reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recInventoryId rdf:type rdf:Property ;
    rdfs:label 'Rec Inventory Id' ;
    rdfs:comment 'Unique surrogate identifier for each REC inventory position record in the Power and Utilities wholesale energy market data product. Serves as the primary key for the silver-layer lakehouse table.' ;
    rdfs:domain ind:RecInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:irpSubmissionId rdf:type rdf:Property ;
    rdfs:label 'Irp Submission Id' ;
    rdfs:comment 'Foreign key linking to regulatory.irp_submission. Business justification: REC inventory demonstrates renewable portfolio compliance in integrated resource plan filings. Links renewable energy certificates to IRP submissions for RPS compliance reporting and planning verifica' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IrpSubmission .

ind:rpsProgramId rdf:type rdf:Property ;
    rdfs:label 'Rps Program Id' ;
    rdfs:comment 'Reference to the state Renewable Portfolio Standard (RPS) compliance program with which this REC inventory position is associated. Null if the RECs are held for voluntary renewable procurement rather than mandatory compliance.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RpsProgram .

ind:capacityMw rdf:type rdf:Property ;
    rdfs:label 'Capacity Mw' ;
    rdfs:comment 'The nameplate generating capacity of the renewable generating unit in Megawatts (MW). Used to verify REC issuance volumes against expected generation output and for IRP resource adequacy analysis.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:compliancePeriodYear rdf:type rdf:Property ;
    rdfs:label 'Compliance Period Year' ;
    rdfs:comment 'The regulatory compliance period year (typically a calendar year) to which these RECs are applied for state RPS obligation fulfillment. A single REC inventory position may be designated to a compliance period that differs from its vintage year depending on state banking and carry-forward rules.' ;
    rdfs:domain ind:RecInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:costPerRec rdf:type rdf:Property ;
    rdfs:label 'Cost Per Rec' ;
    rdfs:comment 'The unit acquisition cost per REC in U.S. dollars at the time of purchase or contract execution. Used for financial accounting, IRP cost analysis, and rate case cost recovery filings. Confidential as it reflects contract pricing strategy.' ;
    rdfs:domain ind:RecInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:counterpartyName rdf:type rdf:Property ;
    rdfs:label 'Counterparty Name' ;
    rdfs:comment 'The name of the counterparty from whom these RECs were purchased or to whom they were transferred. Applicable for market purchases and bilateral transfers. Confidential as it reveals commercial relationships and contract counterparties.' ;
    rdfs:domain ind:RecInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityState rdf:type rdf:Property ;
    rdfs:label 'Eligibility State' ;
    rdfs:comment 'The two-letter U.S. state postal abbreviation for the state RPS compliance program for which these RECs have been certified as eligible. May differ from state_of_issuance when a generator is certified for out-of-state RPS programs. Null if RECs are held for voluntary procurement only.' ;
    rdfs:domain ind:RecInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:generationFacilityName rdf:type rdf:Property ;
    rdfs:label 'Generation Facility Name' ;
    rdfs:comment 'The human-readable name of the renewable energy generating facility or plant that produced the electricity underlying these RECs. Used for reporting, audit, and stakeholder communication purposes.' ;
    rdfs:domain ind:Market ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isBanked rdf:type rdf:Property ;
    rdfs:label 'Is Banked' ;
    rdfs:comment 'Indicates whether these RECs are being held (banked) for use in a future compliance period beyond the current year (True) or are designated for the current compliance period (False). Banking eligibility and duration limits vary by state RPS program.' ;
    rdfs:domain ind:RecInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSelfGenerated rdf:type rdf:Property ;
    rdfs:label 'Is Self Generated' ;
    rdfs:comment 'Indicates whether these RECs were generated by a generating unit owned or operated by the Power and Utilities (True) or procured from a third-party generator or market (False). Distinguishes owned renewable generation from purchased RECs for IRP and RPS compliance reporting.' ;
    rdfs:domain ind:RecInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:marketPricePerRec rdf:type rdf:Property ;
    rdfs:label 'Market Price Per Rec' ;
    rdfs:comment 'The current or most recently observed market price per REC in U.S. dollars for the applicable fuel type, vintage, and state. Used for mark-to-market valuation, IRP resource adequacy analysis, and voluntary procurement benchmarking. Confidential as it reflects market position.' ;
    rdfs:domain ind:RecInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:procurementType rdf:type rdf:Property ;
    rdfs:label 'Procurement Type' ;
    rdfs:comment 'Indicates whether these RECs are held for mandatory state RPS compliance obligations, voluntary renewable procurement commitments (e.g., green tariff programs, corporate renewable PPAs), or both purposes.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quantityMwh rdf:type rdf:Property ;
    rdfs:label 'Quantity Mwh' ;
    rdfs:comment 'The number of Renewable Energy Certificates (RECs) in this inventory position, expressed in Megawatt-Hours (MWh). One REC represents one MWh of electricity generated from a qualifying renewable resource. This is the principal quantitative fact for the inventory record.' ;
    rdfs:domain ind:Market ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recSerialNumber rdf:type rdf:Property ;
    rdfs:label 'Rec Serial Number' ;
    rdfs:comment 'Externally assigned unique serial number or certificate identifier issued by the registry (WREGIS, NEPOOL GIS, or PJM-GATS) for this REC lot. Used for tracking, transfer, and retirement transactions within the registry system. Format varies by registry.' ;
    rdfs:domain ind:RecInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recSource rdf:type rdf:Property ;
    rdfs:label 'Rec Source' ;
    rdfs:comment 'The procurement channel or source through which these RECs were obtained. \'owned_generation\' for RECs from Power and Utilities-owned renewable assets; \'ppa\' for RECs delivered under a Power Purchase Agreement; \'spot_market\' for RECs purchased on the open market; \'bilateral_trade\' for negotiated bilateral transfers; \'green_tariff_program\' for RECs associated with a utility green tariff offering.' ;
    rdfs:domain ind:RecInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recStatus rdf:type rdf:Property ;
    rdfs:label 'Rec Status' ;
    rdfs:comment 'Current lifecycle status of the REC inventory position. \'available\' indicates RECs are unencumbered and eligible for use; \'retired\' indicates RECs have been permanently surrendered for compliance or voluntary claim; \'transferred\' indicates RECs have been sold or conveyed to another party; \'reserved\' indicates RECs are earmarked for a specific compliance obligation or transaction; \'pending\' indicates a registry transaction is in process; \'cancelled\' indicates RECs have been invalidated.' ;
    rdfs:domain ind:RecInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registryPlatform rdf:type rdf:Property ;
    rdfs:label 'Registry Platform' ;
    rdfs:comment 'The renewable energy certificate tracking registry platform in which this inventory position is recorded. WREGIS (Western Renewable Energy Generation Information System) serves the Western Interconnection; NEPOOL GIS serves New England; PJM-GATS serves the PJM footprint; NAR (North American Renewables Registry), M-RETS (Midwest Renewable Energy Tracking System), and NC-RETS (North Carolina Renewable Energy Tracking System) serve other regions.' ;
    rdfs:domain ind:RecInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registryTransactionCode rdf:type rdf:Property ;
    rdfs:label 'Registry Transaction Code' ;
    rdfs:comment 'The transaction identifier assigned by the registry platform (WREGIS, NEPOOL GIS, PJM-GATS) for the most recent registry action (issuance, transfer, retirement, or cancellation) affecting this inventory position. Used for registry audit trail and reconciliation.' ;
    rdfs:domain ind:RecInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retirementPurpose rdf:type rdf:Property ;
    rdfs:label 'Retirement Purpose' ;
    rdfs:comment 'The stated purpose for which these RECs were retired in the registry. \'rps_compliance\' for mandatory state RPS obligation fulfillment; \'voluntary_claim\' for voluntary renewable energy claims; \'green_tariff\' for utility green tariff program customers; \'net_energy_metering\' for NEM program accounting; \'other\' for miscellaneous retirement purposes. Null if rec_status is not \'retired\'.' ;
    rdfs:domain ind:RecInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rpsTier rdf:type rdf:Property ;
    rdfs:label 'Rps Tier' ;
    rdfs:comment 'The RPS compliance tier classification for these RECs under the applicable state RPS program. Many states have tiered RPS structures that prioritize newer or specific technology types (e.g., Tier 1 for new in-state solar/wind, Tier 2 for older or out-of-state resources). \'not_applicable\' for voluntary procurement RECs.' ;
    rdfs:domain ind:RecInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateOfIssuance rdf:type rdf:Property ;
    rdfs:label 'State Of Issuance' ;
    rdfs:comment 'The two-letter U.S. state postal abbreviation for the state in which the generating unit is located and where the RECs were issued. State of issuance determines eligibility for specific state RPS compliance programs, as most states require RECs to originate from generators within defined geographic boundaries or interconnection regions.' ;
    rdfs:domain ind:RecInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:technologyClass rdf:type rdf:Property ;
    rdfs:label 'Technology Class' ;
    rdfs:comment 'The specific renewable energy technology classification of the generating unit, providing sub-category detail within the fuel_type. Used for RPS tier eligibility determination and voluntary procurement product differentiation. [ENUM-REF-CANDIDATE: photovoltaic|concentrated_solar|onshore_wind|offshore_wind|run_of_river|pumped_storage|anaerobic_digestion|dedicated_biomass|landfill_gas_engine|geothermal_flash|geothermal_binary — promote to reference product]' ;
    rdfs:domain ind:RecInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalCost rdf:type rdf:Property ;
    rdfs:label 'Total Cost' ;
    rdfs:comment 'The total acquisition cost for this REC inventory position in U.S. dollars, calculated as quantity_mwh multiplied by cost_per_rec at time of acquisition. Stored as a raw financial fact for accounting and rate case purposes. Confidential as it reflects contract pricing.' ;
    rdfs:domain ind:RecInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transferDate rdf:type rdf:Property ;
    rdfs:label 'Transfer Date' ;
    rdfs:comment 'The date on which these RECs were transferred to another registry account or counterparty. Populated only when rec_status is \'transferred\'. Used for chain-of-custody tracking and audit.' ;
    rdfs:domain ind:RecInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:vintageMonth rdf:type rdf:Property ;
    rdfs:label 'Vintage Month' ;
    rdfs:comment 'The calendar month (1–12) within the vintage year in which the electricity underlying these RECs was generated. Provides sub-annual granularity for seasonal generation tracking and registry reconciliation.' ;
    rdfs:domain ind:RecInventory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:recTransactionId rdf:type rdf:Property ;
    rdfs:label 'Rec Transaction Id' ;
    rdfs:comment 'Unique surrogate identifier for each REC transaction record in the Power and Utilities wholesale energy market data product. Serves as the primary key for all REC transfer, retirement, purchase, and sale events.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RecTransaction .

ind:primaryRecRegistryAccountId rdf:type rdf:Property ;
    rdfs:label 'Primary Rec Registry Account Id' ;
    rdfs:comment 'Power and Utilities\'s account identifier within the REC registry (e.g., WREGIS account number, M-RETS organization ID). Used to identify the Power and Utilities\'s registry account as the source or destination of the REC transfer. Required for registry reconciliation and audit.' ;
    rdfs:domain ind:RecTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Account .

ind:riderChargeId rdf:type rdf:Property ;
    rdfs:label 'Rider Charge Id' ;
    rdfs:comment 'Foreign key linking to regulatory.rider_charge. Business justification: REC procurement costs recovered through renewable energy riders. Links renewable energy credit transactions to specific tariff riders for cost recovery and rate calculation.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RiderCharge .

ind:brokerName rdf:type rdf:Property ;
    rdfs:label 'Broker Name' ;
    rdfs:comment 'Name of the energy broker or intermediary that facilitated this REC transaction, if applicable. Null for direct bilateral transactions or registry self-transfers. Used for broker relationship management and fee reconciliation.' ;
    rdfs:domain ind:RecTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certificateSerialEnd rdf:type rdf:Property ;
    rdfs:label 'Certificate Serial End' ;
    rdfs:comment 'Ending serial number of the REC certificate block transferred or retired in this transaction, as assigned by the REC registry. Together with certificate_serial_start, defines the complete range of individual REC certificates covered by this transaction for audit and reconciliation purposes.' ;
    rdfs:domain ind:RecTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certificateSerialStart rdf:type rdf:Property ;
    rdfs:label 'Certificate Serial Start' ;
    rdfs:comment 'Starting serial number of the REC certificate block transferred or retired in this transaction, as assigned by the REC registry. REC registries assign unique serial numbers to each MWh certificate. The range from certificate_serial_start to certificate_serial_end defines the exact certificates involved.' ;
    rdfs:domain ind:RecTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceProgram rdf:type rdf:Property ;
    rdfs:label 'Compliance Program' ;
    rdfs:comment 'The regulatory or voluntary compliance program under which this REC transaction is being executed. \'RPS\' indicates state Renewable Portfolio Standard obligation; \'voluntary\' indicates green power or corporate sustainability purchase; \'federal_clean_energy\' indicates federal clean energy standard compliance; \'CHP\' indicates Combined Heat and Power (CHP) program; \'other\' for non-standard programs.' ;
    rdfs:domain ind:RecTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:energySourceType rdf:type rdf:Property ;
    rdfs:label 'Energy Source Type' ;
    rdfs:comment 'Classification of the renewable energy generation technology that produced the electricity underlying the RECs. Many state RPS programs have technology-specific carve-outs (e.g., solar carve-outs) that require RECs from specific generation types. [ENUM-REF-CANDIDATE: solar|wind|hydro|geothermal|biomass|landfill_gas|other_renewable — promote to reference product if additional types are needed]' ;
    rdfs:domain ind:RecTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:generationFacilityState rdf:type rdf:Property ;
    rdfs:label 'Generation Facility State' ;
    rdfs:comment 'Two-letter US state code (USPS abbreviation) for the state in which the renewable generation facility is located. Many state RPS programs restrict eligible RECs to facilities located within the state or within a defined geographic region (e.g., in-state, regional grid).' ;
    rdfs:domain ind:RecTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grossAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Amount' ;
    rdfs:comment 'Total gross monetary value of the REC transaction before any adjustments, fees, or discounts, calculated as quantity_mwh multiplied by price_per_rec. Expressed in US Dollars (USD). Used for revenue recognition, financial settlement, and FERC market-based rate reporting.' ;
    rdfs:domain ind:RecTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isBundled rdf:type rdf:Property ;
    rdfs:label 'Is Bundled' ;
    rdfs:comment 'Indicates whether the RECs in this transaction are bundled with the underlying electricity delivery (True) or are unbundled certificates traded separately from the physical energy (False). Bundled RECs are typically associated with PPA deliveries; unbundled RECs are traded independently in the REC market. Affects RPS eligibility in some states.' ;
    rdfs:domain ind:RecTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isEligibleForRps rdf:type rdf:Property ;
    rdfs:label 'Is Eligible For Rps' ;
    rdfs:comment 'Indicates whether the RECs in this transaction have been verified as eligible for the applicable state Renewable Portfolio Standard (RPS) compliance program (True) or are ineligible/unverified (False). Eligibility is determined by generation technology, vintage year, facility location, and registry certification.' ;
    rdfs:domain ind:RecTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pricePerRec rdf:type rdf:Property ;
    rdfs:label 'Price Per Rec' ;
    rdfs:comment 'Contracted or market price per REC in US Dollars (USD). Represents the unit price agreed upon between counterparties for purchase or sale transactions. Null for retirement-only or internal transfer transactions with no financial consideration. Sensitive commercial pricing data.' ;
    rdfs:domain ind:RecTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:registryConfirmationNumber rdf:type rdf:Property ;
    rdfs:label 'Registry Confirmation Number' ;
    rdfs:comment 'Unique confirmation number issued by the REC registry (e.g., WREGIS, M-RETS, NAR) upon successful processing of the REC transfer or retirement. Serves as the authoritative audit trail reference for RPS compliance filings with state PUCs and FERC market-based rate reporting.' ;
    rdfs:domain ind:RecTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registryName rdf:type rdf:Property ;
    rdfs:label 'Registry Name' ;
    rdfs:comment 'Name of the REC tracking registry through which this transaction was processed. Different RTOs and regions use different registries: WREGIS (Western US), M-RETS (Midwest), NAR (North American Renewables Registry), NEPOOL-GIS (New England), PJM-GATS (PJM region), ERCOT (Texas). Determines applicable operating rules and transfer confirmation procedures.' ;
    rdfs:domain ind:RecTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rpsComplianceYear rdf:type rdf:Property ;
    rdfs:label 'Rps Compliance Year' ;
    rdfs:comment 'The RPS compliance obligation year to which this REC transaction is applied. State PUC RPS programs require utilities to demonstrate compliance by retiring sufficient RECs for each annual compliance period. Populated for RPS-type transactions; null for voluntary transactions.' ;
    rdfs:domain ind:RecTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:settlementDate rdf:type rdf:Property ;
    rdfs:label 'Settlement Date' ;
    rdfs:comment 'Date on which financial settlement for the REC transaction was completed, including payment exchange between counterparties. May differ from transaction_date for forward or deferred settlement arrangements. Used for revenue recognition and GAAP financial reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:tradeConfirmationNumber rdf:type rdf:Property ;
    rdfs:label 'Trade Confirmation Number' ;
    rdfs:comment 'Bilateral trade confirmation number exchanged between Power and Utilities and the counterparty at the time of deal execution, prior to registry transfer. Distinct from the registry_confirmation_number which is issued by the registry post-transfer. Used for pre-settlement reconciliation and dispute resolution.' ;
    rdfs:domain ind:RecTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionFee rdf:type rdf:Property ;
    rdfs:label 'Transaction Fee' ;
    rdfs:comment 'Registry or broker fees assessed on this REC transaction, expressed in US Dollars (USD). Includes WREGIS, M-RETS, or NAR registry transfer fees and any applicable brokerage commissions. Deducted from gross amount to derive net settlement amount.' ;
    rdfs:domain ind:RecTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transactionStatus rdf:type rdf:Property ;
    rdfs:label 'Transaction Status' ;
    rdfs:comment 'Current lifecycle state of the REC transaction workflow. \'pending\' indicates awaiting registry confirmation; \'confirmed\' indicates registry transfer acknowledged; \'settled\' indicates financial settlement complete; \'retired\' indicates RECs permanently retired for compliance; \'cancelled\' indicates transaction voided; \'disputed\' indicates counterparty or registry dispute in progress.' ;
    rdfs:domain ind:RecTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionType rdf:type rdf:Property ;
    rdfs:label 'Transaction Type' ;
    rdfs:comment 'Classification of the REC transaction by its business purpose. \'transfer\' indicates a registry account-to-account transfer; \'retirement\' indicates permanent retirement of RECs for RPS or voluntary compliance; \'purchase\' indicates acquisition of RECs from a counterparty; \'sale\' indicates disposition of RECs to a counterparty.' ;
    rdfs:domain ind:RecTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementLineItemId rdf:type rdf:Property ;
    rdfs:label 'Settlement Line Item Id' ;
    rdfs:comment 'Unique identifier for the settlement line item record. Primary key for the settlement line item entity.' ;
    rdfs:domain ind:SettlementLineItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:originalLineItemSettlementLineItemId rdf:type rdf:Property ;
    rdfs:label 'Original Line Item Settlement Line Item Id' ;
    rdfs:comment 'Foreign key reference to the original settlement line item that this record adjusts or replaces. Creates an audit trail for resettlements and dispute adjustments.' ;
    rdfs:domain ind:SettlementLineItem ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SettlementLineItem .

ind:billingDeterminantQuantity rdf:type rdf:Property ;
    rdfs:label 'Billing Determinant Quantity' ;
    rdfs:comment 'Quantity of the billing determinant (MW, MWh, MW-day, or other unit) used to calculate the line item charge. Represents the volume of energy, capacity, or service delivered or consumed.' ;
    rdfs:domain ind:SettlementLineItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:billingDeterminantUnit rdf:type rdf:Property ;
    rdfs:label 'Billing Determinant Unit' ;
    rdfs:comment 'Unit of measure for the billing determinant quantity. Specifies whether the charge is based on energy (MWh), capacity (MW), demand (MW-day), or reactive power (MVAR).' ;
    rdfs:domain ind:SettlementLineItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chargeCode rdf:type rdf:Property ;
    rdfs:label 'Charge Code' ;
    rdfs:comment 'Detailed RTO/ISO-specific charge code identifying the exact settlement product or service. Maps to the ISO tariff schedule and enables granular GL posting and dispute resolution.' ;
    rdfs:domain ind:SettlementLineItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chargeType rdf:type rdf:Property ;
    rdfs:label 'Charge Type' ;
    rdfs:comment 'High-level category of the settlement charge or credit. Classifies the line item into major wholesale market product categories for financial reporting and analysis. [ENUM-REF-CANDIDATE: energy|capacity|ancillary_service|transmission|congestion|loss|uplift|make_whole_payment|revenue_sufficiency_guarantee|oatt_charge|administrative_fee|penalty|credit_adjustment — promote to reference product]' ;
    rdfs:domain ind:SettlementLineItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lineItemNumber rdf:type rdf:Property ;
    rdfs:label 'Line Item Number' ;
    rdfs:comment 'Sequential line number within the parent settlement statement. Used for ordering and referencing specific charges or credits within the statement.' ;
    rdfs:domain ind:SettlementLineItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lineItemStatus rdf:type rdf:Property ;
    rdfs:label 'Line Item Status' ;
    rdfs:comment 'Current lifecycle status of the settlement line item. Tracks whether the charge is preliminary, final, under dispute, or has been adjusted through resettlement.' ;
    rdfs:domain ind:SettlementLineItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratePerUnit rdf:type rdf:Property ;
    rdfs:label 'Rate Per Unit' ;
    rdfs:comment 'Unit rate applied to the billing determinant to calculate the line item amount. Expressed in currency per unit (e.g., USD per MWh, USD per MW-day). May represent LMP, capacity clearing price, or ancillary service rate.' ;
    rdfs:domain ind:SettlementLineItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:settlementIntervalEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Settlement Interval End Timestamp' ;
    rdfs:comment 'End timestamp of the settlement interval to which this line item applies. Defines the conclusion of the operating period for the settled transaction.' ;
    rdfs:domain ind:SettlementLineItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:settlementIntervalStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Settlement Interval Start Timestamp' ;
    rdfs:comment 'Start timestamp of the settlement interval to which this line item applies. Defines the beginning of the operating period for energy, capacity, or ancillary service delivery.' ;
    rdfs:domain ind:SettlementLineItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:statementRunType rdf:type rdf:Property ;
    rdfs:label 'Statement Run Type' ;
    rdfs:comment 'Type of settlement run that produced this line item. Distinguishes between initial settlements, final settlements, resettlements due to meter data corrections, and dispute adjustments.' ;
    rdfs:domain ind:Market ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorStatementSettlementStatementId rdf:type rdf:Property ;
    rdfs:label 'Prior Statement Settlement Statement Id' ;
    rdfs:comment 'Reference to the immediately preceding settlement statement version for the same billing period and market type. Enables version lineage tracking and delta analysis between resettlement runs.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SettlementStatement .

ind:prudencyDocketId rdf:type rdf:Property ;
    rdfs:label 'Prudency Docket Id' ;
    rdfs:comment 'Foreign key linking to regulatory.docket. Business justification: Wholesale market settlement costs are subject to regulatory prudency review in rate cases. Links market costs to regulatory proceedings for cost recovery approval and reasonableness determination.' ;
    rdfs:domain ind:Market ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Docket .

ind:vendorInvoiceId rdf:type rdf:Property ;
    rdfs:label 'Vendor Invoice Id' ;
    rdfs:comment 'Foreign key linking to supply.vendor_invoice. Business justification: Market settlements for tolling agreements, capacity payments, or generation services often correspond to vendor invoices. Enables three-way matching between market settlement, vendor invoice, and serv' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:VendorInvoice .

ind:ancillaryServiceChargesUsd rdf:type rdf:Property ;
    rdfs:label 'Ancillary Service Charges Usd' ;
    rdfs:comment 'Charges for ancillary services procured from the RTO/ISO, including regulation, spinning reserve, non-spinning reserve, and reactive power. Supports O&M cost allocation and FERC Form 1 Schedule 321.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ancillaryServiceCreditsUsd rdf:type rdf:Property ;
    rdfs:label 'Ancillary Service Credits Usd' ;
    rdfs:comment 'Revenues received for ancillary services provided to the RTO/ISO, including regulation, spinning reserve, and demand response. Supports revenue disaggregation for FERC Form 1 and IRP analysis.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capacityChargesUsd rdf:type rdf:Property ;
    rdfs:label 'Capacity Charges Usd' ;
    rdfs:comment 'Charges assessed for capacity market obligations, including capacity deficiency penalties or capacity purchases from the RTO/ISO capacity auction. Supports resource adequacy cost tracking for IRP filings.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capacityCreditsUsd rdf:type rdf:Property ;
    rdfs:label 'Capacity Credits Usd' ;
    rdfs:comment 'Revenues received for capacity resources cleared in the RTO/ISO capacity auction. Supports resource adequacy revenue tracking and PPA valuation for IRP filings.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:congestionCreditsUsd rdf:type rdf:Property ;
    rdfs:label 'Congestion Credits Usd' ;
    rdfs:comment 'Credits received from Congestion Revenue Rights (CRR) or Financial Transmission Rights (FTR) held by the market participant, offsetting congestion costs in the LMP settlement. Supports hedging effectiveness analysis.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disputeAmountUsd rdf:type rdf:Property ;
    rdfs:label 'Dispute Amount Usd' ;
    rdfs:comment 'Dollar amount under formal dispute with the RTO/ISO for this settlement statement. May be a subset of the net_settlement_amount_usd. Populated only when is_disputed = True. Supports contingent liability disclosure for SOX and GAAP.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disputeDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Dispute Deadline Date' ;
    rdfs:comment 'Last calendar date by which the market participant may file a formal dispute or request for resettlement with the RTO/ISO for this statement. Derived from RTO/ISO tariff dispute windows; tracked to prevent forfeiture of dispute rights.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:energyChargesUsd rdf:type rdf:Property ;
    rdfs:label 'Energy Charges Usd' ;
    rdfs:comment 'Portion of total charges attributable to energy (MWh) purchases in the DAM or RTM, settled at Locational Marginal Price (LMP). Supports disaggregated cost analysis for IRP and FERC EQR reporting.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:energyCreditsUsd rdf:type rdf:Property ;
    rdfs:label 'Energy Credits Usd' ;
    rdfs:comment 'Portion of total credits attributable to energy (MWh) sales in the DAM or RTM, settled at Locational Marginal Price (LMP). Supports revenue disaggregation for IRP and FERC EQR reporting.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isDisputed rdf:type rdf:Property ;
    rdfs:label 'Is Disputed' ;
    rdfs:comment 'Indicates whether the utility has filed a formal dispute with the RTO/ISO for this settlement statement. True = active dispute filed; False = no dispute. Triggers dispute tracking workflow and suspends payment processing for disputed amounts.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:netSettlementAmountUsd rdf:type rdf:Property ;
    rdfs:label 'Net Settlement Amount Usd' ;
    rdfs:comment 'Net financial obligation for this settlement statement in US dollars, calculated as total_credits_usd minus total_charges_usd. A positive value indicates a net receipt (credit to utility); a negative value indicates a net payment owed to the RTO/ISO. Primary figure for treasury and FERC Form 1 reporting.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:operatingDay rdf:type rdf:Property ;
    rdfs:label 'Operating Day' ;
    rdfs:comment 'The specific RTO/ISO operating day (midnight-to-midnight) to which this settlement statement applies. For DAM and RTM settlements, this is a single calendar date. For multi-day statements (capacity, ancillary), this field represents the primary operating day or is set to the billing_period_start_date.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paymentDueDate rdf:type rdf:Property ;
    rdfs:label 'Payment Due Date' ;
    rdfs:comment 'Calendar date by which the net settlement amount must be paid to or received from the RTO/ISO. Drives cash flow forecasting, treasury operations, and late-payment penalty exposure.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paymentTransactionRef rdf:type rdf:Property ;
    rdfs:label 'Payment Transaction Ref' ;
    rdfs:comment 'External payment transaction reference number or ACH/wire transfer confirmation number associated with the settlement of this statement. Populated upon payment execution. Supports treasury reconciliation with SAP S/4HANA accounts payable/receivable.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resettlementReason rdf:type rdf:Property ;
    rdfs:label 'Resettlement Reason' ;
    rdfs:comment 'Free-text or coded description of the reason for resettlement or true-up, as provided by the RTO/ISO. Examples include meter data correction, LMP recalculation, capacity obligation adjustment, or ancillary service reallocation. Populated only for statement_run_type values of \'resettlement\' or \'true_up\'.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statementNumber rdf:type rdf:Property ;
    rdfs:label 'Statement Number' ;
    rdfs:comment 'Externally-known alphanumeric identifier assigned by the RTO/ISO to uniquely identify this settlement statement. Used for reconciliation with the RTO/ISO portal and FERC EQR filings.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statementPublicationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Statement Publication Timestamp' ;
    rdfs:comment 'Date and time when the RTO/ISO published and made this settlement statement available to market participants. This is the principal real-world business event timestamp — the moment the financial obligation became known to the utility.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:statementStatus rdf:type rdf:Property ;
    rdfs:label 'Statement Status' ;
    rdfs:comment 'Current lifecycle state of the settlement statement within the utility\'s internal reconciliation workflow. \'published\' = received from RTO/ISO; \'under_review\' = internal validation in progress; \'disputed\' = formal dispute filed with RTO/ISO; \'accepted\' = validated and approved for payment; \'paid\' = payment executed; \'closed\' = fully settled and archived.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statementVersion rdf:type rdf:Property ;
    rdfs:label 'Statement Version' ;
    rdfs:comment 'Sequential version number of the settlement statement issued by the RTO/ISO for the same billing period and run type. Increments with each resettlement or correction. Version 1 is the original issuance.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalChargesUsd rdf:type rdf:Property ;
    rdfs:label 'Total Charges Usd' ;
    rdfs:comment 'Gross sum of all charge line items on this settlement statement in US dollars. Represents amounts owed by the market participant to the RTO/ISO for energy purchases, capacity obligations, ancillary service charges, and transmission fees.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalCreditsUsd rdf:type rdf:Property ;
    rdfs:label 'Total Credits Usd' ;
    rdfs:comment 'Gross sum of all credit line items on this settlement statement in US dollars. Represents amounts owed to the market participant by the RTO/ISO for energy sales, capacity revenues, ancillary service revenues, and congestion credits.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalEnergyVolumeMwh rdf:type rdf:Property ;
    rdfs:label 'Total Energy Volume Mwh' ;
    rdfs:comment 'Net energy volume in Megawatt-Hours (MWh) settled on this statement, representing the algebraic sum of all DAM and RTM energy positions. Positive = net purchase; negative = net sale. Supports FERC EQR quantity reporting.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transmissionChargesUsd rdf:type rdf:Property ;
    rdfs:label 'Transmission Charges Usd' ;
    rdfs:comment 'Charges for transmission service, congestion, and OATT-related fees assessed on this settlement statement. Includes congestion component of LMP and transmission loss charges.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:weightedAvgLmpUsdPerMwh rdf:type rdf:Property ;
    rdfs:label 'Weighted Avg Lmp Usd Per Mwh' ;
    rdfs:comment 'Volume-weighted average Locational Marginal Price (LMP) in USD per MWh across all energy positions settled on this statement. Supports market cost benchmarking, IRP analysis, and FERC EQR price reporting.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transmissionRightId rdf:type rdf:Property ;
    rdfs:label 'Transmission Right Id' ;
    rdfs:comment 'Unique surrogate identifier for each financial transmission right or transmission congestion contract record held by the utility. Primary key for the transmission_right data product.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TransmissionRight .

ind:portfolioId rdf:type rdf:Property ;
    rdfs:label 'Portfolio Id' ;
    rdfs:comment 'Reference to the wholesale energy trading portfolio or book to which this transmission right is assigned. Enables aggregation of FTR/TCC positions by portfolio for risk management, P&L reporting, and IRP resource adequacy analysis.' ;
    rdfs:domain ind:TransmissionRight ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TransmissionRightsPortfolio .

ind:primaryTransmissionPricingNodeId rdf:type rdf:Property ;
    rdfs:label 'Primary Transmission Pricing Node Id' ;
    rdfs:comment 'Reference to the source pricing node that defines the injection point of the FTR/TCC path. The LMP at the source node is used in congestion settlement calculations. Corresponds to the generation or injection location in the RTO nodal model.' ;
    rdfs:domain ind:TransmissionRight ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PricingNode .

ind:sourcePnodePricingNodeId rdf:type rdf:Property ;
    rdfs:label 'Source Pnode Pricing Node Id' ;
    rdfs:comment 'FK to market.pricing_node' ;
    rdfs:domain ind:TransmissionRight ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PricingNode .

ind:transmissionPricingNodeId rdf:type rdf:Property ;
    rdfs:label 'Transmission Pricing Node Id' ;
    rdfs:comment 'FK to market.pricing_node' ;
    rdfs:domain ind:TransmissionRight ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PricingNode .

ind:acquisitionMethod rdf:type rdf:Property ;
    rdfs:label 'Acquisition Method' ;
    rdfs:comment 'Indicates how the transmission right was obtained. PRIMARY_AUCTION indicates acquisition through the RTO/ISO annual or monthly FTR auction. SECONDARY_MARKET indicates purchase from another market participant. BILATERAL indicates a negotiated bilateral transfer. ALLOCATION indicates the right was allocated by the RTO/ISO (e.g., ARR conversion).' ;
    rdfs:domain ind:TransmissionRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auctionClearingPrice rdf:type rdf:Property ;
    rdfs:label 'Auction Clearing Price' ;
    rdfs:comment 'The price per MW at which this transmission right cleared in the RTO/ISO FTR auction, expressed in dollars per megawatt ($/MW). Used to calculate total acquisition cost and benchmark against secondary market prices.' ;
    rdfs:domain ind:TransmissionRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:auctionRound rdf:type rdf:Property ;
    rdfs:label 'Auction Round' ;
    rdfs:comment 'Identifies the specific RTO/ISO FTR auction round in which this transmission right was acquired (e.g., \'PJM-2024-ANN-R1\', \'MISO-2024-MON-JAN\'). Used to trace the right back to its originating auction event for audit and portfolio analysis.' ;
    rdfs:domain ind:TransmissionRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auctionYear rdf:type rdf:Property ;
    rdfs:label 'Auction Year' ;
    rdfs:comment 'The planning year (four-digit calendar year) associated with the FTR auction in which this right was acquired. Used for portfolio grouping, annual budget reporting, and IRP resource adequacy analysis.' ;
    rdfs:domain ind:TransmissionRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:congestionZoneSink rdf:type rdf:Property ;
    rdfs:label 'Congestion Zone Sink' ;
    rdfs:comment 'The congestion zone or load zone designation at the sink end of the transmission right path, as defined by the RTO/ISO. Used for zone-level aggregation and LMP basis spread exposure analysis.' ;
    rdfs:domain ind:TransmissionRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:congestionZoneSource rdf:type rdf:Property ;
    rdfs:label 'Congestion Zone Source' ;
    rdfs:comment 'The congestion zone or load zone designation at the source end of the transmission right path, as defined by the RTO/ISO. Used for zone-level aggregation and basis risk analysis when nodal-level detail is not required.' ;
    rdfs:domain ind:TransmissionRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cumulativeSettlementAmount rdf:type rdf:Property ;
    rdfs:label 'Cumulative Settlement Amount' ;
    rdfs:comment 'The total net congestion settlement revenue or cost received or paid to date for this transmission right since its effective date, expressed in US dollars. Positive values indicate net revenue received; negative values indicate net payments made. Supports portfolio performance tracking and FERC reporting.' ;
    rdfs:domain ind:TransmissionRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fercMarketRateAuthFlag rdf:type rdf:Property ;
    rdfs:label 'Ferc Market Rate Auth Flag' ;
    rdfs:comment 'Indicates whether this transmission right position is reportable under the utility\'s FERC market-based rate authority. True indicates the position must be included in FERC Electric Quarterly Report (EQR) filings and market power screens.' ;
    rdfs:domain ind:TransmissionRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hedgeDesignation rdf:type rdf:Property ;
    rdfs:label 'Hedge Designation' ;
    rdfs:comment 'Accounting designation of the transmission right under GAAP ASC 815. CASH_FLOW_HEDGE designates the right as hedging variability in future cash flows from LMP congestion exposure. FAIR_VALUE_HEDGE designates it as hedging changes in fair value of a recognized asset or liability. ECONOMIC_HEDGE indicates the right provides economic offset but does not qualify for hedge accounting. SPECULATIVE indicates the right is held for trading or arbitrage purposes.' ;
    rdfs:domain ind:Market ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastSettlementDate rdf:type rdf:Property ;
    rdfs:label 'Last Settlement Date' ;
    rdfs:comment 'The most recent date on which a congestion settlement payment was processed for this transmission right by the RTO/ISO. Used to confirm settlement currency and identify rights with outstanding or delayed settlements.' ;
    rdfs:domain ind:TransmissionRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lmpBasisSpread rdf:type rdf:Property ;
    rdfs:label 'Lmp Basis Spread' ;
    rdfs:comment 'The expected or realized LMP congestion price differential between the sink and source pricing nodes, expressed in dollars per megawatt-hour ($/MWh). Represents the basis spread this right is intended to hedge. Used in portfolio risk analytics and IRP congestion cost modeling.' ;
    rdfs:domain ind:TransmissionRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:markToMarketValue rdf:type rdf:Property ;
    rdfs:label 'Mark To Market Value' ;
    rdfs:comment 'The current fair market value of the transmission right expressed in US dollars, based on the most recent secondary market prices or RTO/ISO valuation. Used for financial reporting under GAAP ASC 815 fair value accounting and portfolio risk management.' ;
    rdfs:domain ind:TransmissionRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mtmValuationDate rdf:type rdf:Property ;
    rdfs:label 'Mtm Valuation Date' ;
    rdfs:comment 'The date as of which the mark-to-market value was last calculated or updated. Required for financial reporting to confirm the currency of the fair value estimate.' ;
    rdfs:domain ind:TransmissionRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mwQuantity rdf:type rdf:Property ;
    rdfs:label 'Mw Quantity' ;
    rdfs:comment 'The capacity quantity of the transmission right expressed in megawatts (MW). Represents the notional MW amount for which the holder receives or pays the congestion component of LMP between source and sink nodes. Determines the settlement payment magnitude.' ;
    rdfs:domain ind:TransmissionRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rightCode rdf:type rdf:Property ;
    rdfs:label 'Right Code' ;
    rdfs:comment 'Externally-known alphanumeric identifier assigned by the RTO/ISO auction system or internal portfolio management system to uniquely identify this FTR or TCC instrument. Used for reconciliation with RTO settlement statements.' ;
    rdfs:domain ind:TransmissionRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rightDirection rdf:type rdf:Property ;
    rdfs:label 'Right Direction' ;
    rdfs:comment 'Indicates the directional flow of the transmission right along the source-to-sink path. FORWARD denotes flow from source pricing node to sink pricing node. COUNTER denotes the reverse direction, used for counter-flow FTRs that hedge congestion in the opposite direction.' ;
    rdfs:domain ind:TransmissionRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rightType rdf:type rdf:Property ;
    rdfs:label 'Right Type' ;
    rdfs:comment 'Classification of the transmission right instrument. FTR_OBLIGATION entitles the holder to receive or pay the congestion component of LMP between source and sink. FTR_OPTION provides the right but not the obligation to collect congestion revenue. TCC (Transmission Congestion Contract) is the NYISO equivalent. ARR (Auction Revenue Right) is a pre-cursor entitlement used in some RTO markets to participate in FTR auctions.' ;
    rdfs:domain ind:TransmissionRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:termType rdf:type rdf:Property ;
    rdfs:label 'Term Type' ;
    rdfs:comment 'Categorizes the duration class of the transmission right as defined by the RTO/ISO auction structure. MONTHLY rights are acquired in monthly auctions. SEASONAL rights span a defined seasonal period. ANNUAL rights cover a full planning year. LONG_TERM rights extend beyond one year and are subject to long-term FTR auction rules under FERC Order 681.' ;
    rdfs:domain ind:TransmissionRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferEligible rdf:type rdf:Property ;
    rdfs:label 'Transfer Eligible' ;
    rdfs:comment 'Indicates whether this transmission right is eligible for transfer or sale in the secondary market under applicable RTO/ISO tariff rules. True indicates the right may be transferred; False indicates it is non-transferable (e.g., certain ARR allocations).' ;
    rdfs:domain ind:TransmissionRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transmissionRightStatus rdf:type rdf:Property ;
    rdfs:label 'Transmission Right Status' ;
    rdfs:comment 'Current lifecycle status of the transmission right. ACTIVE indicates the right is within its effective term and eligible for settlement. EXPIRED indicates the term has ended. CANCELLED indicates the right was terminated prior to expiration. PENDING indicates the right has been awarded but not yet effective. SURRENDERED indicates the holder voluntarily returned the right to the RTO.' ;
    rdfs:domain ind:TransmissionRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:affiliateFlag rdf:type rdf:Property ;
    rdfs:label 'Affiliate Flag' ;
    rdfs:comment 'Indicates whether this counterparty is an affiliate of the utility as defined under FERC 18 CFR Part 35 and the applicable OATT. Affiliate transactions are subject to additional FERC disclosure requirements and arm\'s-length pricing standards.' ;
    rdfs:domain ind:WholesaleCounterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ancillaryServicesParticipantFlag rdf:type rdf:Property ;
    rdfs:label 'Ancillary Services Participant Flag' ;
    rdfs:comment 'Indicates whether this counterparty is registered to provide or procure ancillary services (regulation, spinning reserve, non-spinning reserve, voltage support) in the applicable RTO/ISO market. Supports ancillary services procurement and settlement tracking.' ;
    rdfs:domain ind:WholesaleCounterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:capacityMarketParticipantFlag rdf:type rdf:Property ;
    rdfs:label 'Capacity Market Participant Flag' ;
    rdfs:comment 'Indicates whether this counterparty participates in capacity market auctions (e.g., PJM RPM, MISO Planning Resource Auction) as a buyer or seller. Supports capacity obligation tracking and resource adequacy compliance reporting.' ;
    rdfs:domain ind:WholesaleCounterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:counterpartyStatus rdf:type rdf:Property ;
    rdfs:label 'Counterparty Status' ;
    rdfs:comment 'Current lifecycle status of the wholesale counterparty master record. Controls eligibility for new transaction execution, credit limit enforcement, and settlement processing. Active status required before DAM/RTM bids or PPA execution.' ;
    rdfs:domain ind:WholesaleCounterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:counterpartyType rdf:type rdf:Property ;
    rdfs:label 'Counterparty Type' ;
    rdfs:comment 'Categorical classification of the wholesale counterparty\'s primary market role. Drives applicable FERC tariff treatment, credit requirements, and settlement logic. [ENUM-REF-CANDIDATE: generator|load_serving_entity|marketer|financial_participant|transmission_owner|cooperative|municipal_utility — promote to reference product]' ;
    rdfs:domain ind:WholesaleCounterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditRatingDate rdf:type rdf:Property ;
    rdfs:label 'Credit Rating Date' ;
    rdfs:comment 'Date on which the current credit rating was issued or last affirmed by the rating agency. Used to assess rating staleness and trigger re-evaluation of credit exposure limits per internal credit risk policy.' ;
    rdfs:domain ind:WholesaleCounterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:doingBusinessAsName rdf:type rdf:Property ;
    rdfs:label 'Doing Business As Name' ;
    rdfs:comment 'Trade or operating name used by the counterparty in day-to-day wholesale market transactions, if different from the legal entity name. Commonly used in RTO/ISO scheduling and settlement communications.' ;
    rdfs:domain ind:WholesaleCounterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ein rdf:type rdf:Property ;
    rdfs:label 'Ein' ;
    rdfs:comment 'IRS-issued Employer Identification Number (Federal Tax ID) for the counterparty legal entity. Required for tax reporting, 1099 issuance, and financial settlement reconciliation under GAAP and SOX compliance.' ;
    rdfs:domain ind:WholesaleCounterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fercMbrAuthorization rdf:type rdf:Property ;
    rdfs:label 'Ferc Mbr Authorization' ;
    rdfs:comment 'Indicates whether the counterparty holds a current FERC market-based rate (MBR) authorization under 18 CFR Part 35, permitting them to sell wholesale electricity at negotiated market rates. Required validation before executing bilateral power purchase agreements.' ;
    rdfs:domain ind:WholesaleCounterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:incorporationState rdf:type rdf:Property ;
    rdfs:label 'Incorporation State' ;
    rdfs:comment 'Two-letter US state code where the counterparty legal entity is incorporated or organized. Used for legal entity verification, FERC market-based rate filings, and counterparty due diligence.' ;
    rdfs:domain ind:WholesaleCounterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:kycVerifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Kyc Verified Flag' ;
    rdfs:comment 'Indicates whether the counterparty has completed Know Your Counterparty (KYC) due diligence verification, including entity authentication, beneficial ownership disclosure, and sanctions screening. Required before initiating wholesale energy transactions.' ;
    rdfs:domain ind:WholesaleCounterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastCreditReviewDate rdf:type rdf:Property ;
    rdfs:label 'Last Credit Review Date' ;
    rdfs:comment 'Date of the most recent formal credit review conducted for this counterparty. Triggers re-review workflow when the interval since last review exceeds the internal credit policy threshold (typically annual or upon rating change).' ;
    rdfs:domain ind:WholesaleCounterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:marketParticipantClass rdf:type rdf:Property ;
    rdfs:label 'Market Participant Class' ;
    rdfs:comment 'Functional classification of the counterparty\'s transactional role in wholesale energy markets — whether they primarily buy, sell, or act as an intermediary. Used to segment DAM/RTM exposure and bilateral PPA counterparty risk.' ;
    rdfs:domain ind:WholesaleCounterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:masterAgreementEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Master Agreement Effective Date' ;
    rdfs:comment 'Date on which the master trading agreement with this counterparty became legally effective. Establishes the earliest date from which transactions under the agreement are valid and enforceable.' ;
    rdfs:domain ind:WholesaleCounterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:masterAgreementExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Master Agreement Expiry Date' ;
    rdfs:comment 'Date on which the master trading agreement with this counterparty expires or is scheduled for renewal. Null indicates an evergreen agreement with no fixed termination date. Triggers contract renewal workflow when approaching.' ;
    rdfs:domain ind:WholesaleCounterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:masterAgreementType rdf:type rdf:Property ;
    rdfs:label 'Master Agreement Type' ;
    rdfs:comment 'Type of master trading agreement governing transactions with this counterparty. EEI MPSA (Master Power Purchase and Sale Agreement) is standard for physical power; ISDA governs financial derivatives; NAESB covers natural gas. Determines applicable netting, termination, and default provisions.' ;
    rdfs:domain ind:WholesaleCounterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nettingAgreementFlag rdf:type rdf:Property ;
    rdfs:label 'Netting Agreement Flag' ;
    rdfs:comment 'Indicates whether a legally enforceable close-out netting agreement is in place with this counterparty. Netting agreements reduce gross credit exposure to net exposure for settlement and capital adequacy purposes under FERC and GAAP.' ;
    rdfs:domain ind:WholesaleCounterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ofacScreenedFlag rdf:type rdf:Property ;
    rdfs:label 'Ofac Screened Flag' ;
    rdfs:comment 'Indicates whether the counterparty has been screened against the OFAC Specially Designated Nationals (SDN) and Blocked Persons list. Must be true before any financial settlement or contract execution with the counterparty.' ;
    rdfs:domain ind:WholesaleCounterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:parentCompanyName rdf:type rdf:Property ;
    rdfs:label 'Parent Company Name' ;
    rdfs:comment 'Legal name of the ultimate parent or controlling entity of the counterparty, if applicable. Required for FERC market-based rate affiliate transaction disclosure, credit consolidation, and market power analysis under FERC Order 697.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ppaCounterpartyFlag rdf:type rdf:Property ;
    rdfs:label 'Ppa Counterparty Flag' ;
    rdfs:comment 'Indicates whether this counterparty is a party to one or more active Power Purchase Agreements (PPAs) with the utility. Used to filter counterparties for IRP resource adequacy analysis and long-term procurement reporting.' ;
    rdfs:domain ind:WholesaleCounterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recRegistry rdf:type rdf:Property ;
    rdfs:label 'Rec Registry' ;
    rdfs:comment 'Name of the REC tracking registry in which this counterparty holds an active account for REC issuance, transfer, or retirement. Supports RPS compliance tracking and REC transaction settlement.' ;
    rdfs:domain ind:WholesaleCounterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recTradingParticipantFlag rdf:type rdf:Property ;
    rdfs:label 'Rec Trading Participant Flag' ;
    rdfs:comment 'Indicates whether this counterparty is an active participant in Renewable Energy Certificate (REC) trading. Used to identify eligible counterparties for RPS compliance procurement and REC transfer tracking in WREGIS or GATS registries.' ;
    rdfs:domain ind:WholesaleCounterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:registeredAddressCity rdf:type rdf:Property ;
    rdfs:label 'Registered Address City' ;
    rdfs:comment 'City of the counterparty\'s registered legal business address. Used for jurisdictional determination, state regulatory filings, and counterparty due diligence.' ;
    rdfs:domain ind:WholesaleCounterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registeredAddressCountry rdf:type rdf:Property ;
    rdfs:label 'Registered Address Country' ;
    rdfs:comment 'Three-letter ISO 3166-1 alpha-3 country code of the counterparty\'s registered legal business address (e.g., USA, CAN). Used for FERC foreign ownership disclosure and cross-border transaction compliance.' ;
    rdfs:domain ind:WholesaleCounterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registeredAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Registered Address Line1' ;
    rdfs:comment 'First line of the counterparty\'s registered legal business address. Used for FERC filings, contract execution, and regulatory correspondence.' ;
    rdfs:domain ind:WholesaleCounterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registeredAddressState rdf:type rdf:Property ;
    rdfs:label 'Registered Address State' ;
    rdfs:comment 'Two-letter US state code of the counterparty\'s registered legal business address (ISO 3166-2:US). Determines applicable state PUC jurisdiction and state tax reporting obligations.' ;
    rdfs:domain ind:WholesaleCounterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rtoParticipantCode rdf:type rdf:Property ;
    rdfs:label 'Rto Participant Code' ;
    rdfs:comment 'Unique participant identifier assigned by the counterparty\'s RTO or ISO (e.g., PJM participant ID, MISO market participant code). Used for scheduling, settlement, and transmission service requests under the applicable OATT.' ;
    rdfs:domain ind:WholesaleCounterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amiEndpointId rdf:type rdf:Property ;
    rdfs:label 'Ami Endpoint Id' ;
    rdfs:comment 'Unique system identifier for the AMI communication endpoint record. Primary key for the AMI endpoint entity. This is the surrogate key assigned by the MDMS or head-end system to track each network-layer endpoint registration.' ;
    rdfs:domain ind:Metering ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AmiEndpoint .

ind:authenticationMethod rdf:type rdf:Property ;
    rdfs:label 'Authentication Method' ;
    rdfs:comment 'Method used to authenticate the endpoint during communication sessions with the head-end system. CERTIFICATE = X.509 digital certificate; SHARED_KEY = pre-shared symmetric key; TOKEN = dynamic token-based authentication; NONE = no authentication (legacy systems only).' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:batteryLevelPercent rdf:type rdf:Property ;
    rdfs:label 'Battery Level Percent' ;
    rdfs:comment 'Current battery charge level as a percentage (0-100) for battery-powered communication modules (common in gas AMR/AMI and some electric endpoints). Null for line-powered endpoints. Used to schedule battery replacement field work before communication failure.' ;
    rdfs:domain ind:Metering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:collectorNodeCode rdf:type rdf:Property ;
    rdfs:label 'Collector Node Code' ;
    rdfs:comment 'Identifier of the parent collector, concentrator, or access point node in the AMI network hierarchy to which this endpoint is currently associated. Used in mesh and hierarchical network topologies to manage network routing, load balancing, and troubleshooting. Null for direct cellular or POTS endpoints.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissioningTimestamp rdf:type rdf:Property ;
    rdfs:label 'Commissioning Timestamp' ;
    rdfs:comment 'Timestamp when the endpoint was successfully registered and commissioned in the AMI head-end system. Marks the moment the endpoint became operational and began transmitting meter data. Distinct from installation_date which is the physical installation event.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:communicationModuleSerial rdf:type rdf:Property ;
    rdfs:label 'Communication Module Serial' ;
    rdfs:comment 'Manufacturer-assigned serial number of the physical AMI communication module (NIC card, radio module, or cellular modem) installed in or attached to the smart meter. Used for warranty tracking, firmware management, and field service operations.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:communicationStatus rdf:type rdf:Property ;
    rdfs:label 'Communication Status' ;
    rdfs:comment 'Current operational status of the AMI endpoint communication link. ACTIVE = regular successful communication; INACTIVE = no recent communication but endpoint is registered; INTERMITTENT = sporadic communication failures; FAILED = persistent communication failure requiring field service; COMMISSIONED = newly installed and registered; DECOMMISSIONED = removed from service.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataRetentionDays rdf:type rdf:Property ;
    rdfs:label 'Data Retention Days' ;
    rdfs:comment 'Number of days of interval meter data stored locally on the endpoint before being overwritten. Used for data recovery after communication outages and for backfill operations. Typical range: 35-90 days depending on memory capacity and interval frequency.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:decommissioningTimestamp rdf:type rdf:Property ;
    rdfs:label 'Decommissioning Timestamp' ;
    rdfs:comment 'Timestamp when the endpoint was decommissioned and removed from active service in the AMI head-end system. Null for active endpoints. Used for lifecycle tracking, asset retirement reporting, and historical analysis of network evolution.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:encryptionEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Encryption Enabled Flag' ;
    rdfs:comment 'Boolean flag indicating whether end-to-end encryption is enabled for communication between this endpoint and the head-end system. True = encrypted communication (AES-128 or higher); False = plaintext or legacy unencrypted communication. Critical for cybersecurity compliance and NERC CIP audit.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:endpointEui rdf:type rdf:Property ;
    rdfs:label 'Endpoint Eui' ;
    rdfs:comment '64-bit Extended Unique Identifier (EUI-64) assigned to the AMI communication module. This is the globally unique MAC-layer address used for network registration and device authentication in the AMI head-end system. Serves as the primary network identity for the endpoint.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:firmwareVersion rdf:type rdf:Property ;
    rdfs:label 'Firmware Version' ;
    rdfs:comment 'Current firmware version installed on the AMI communication module. Used for firmware upgrade planning, security patch management, and troubleshooting communication issues. Format varies by vendor (e.g., 3.2.1, v4.5.0-build2023).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:headEndSystemCode rdf:type rdf:Property ;
    rdfs:label 'Head End System Code' ;
    rdfs:comment 'Identifier of the AMI head-end system (MDMS instance or vendor platform) that manages this endpoint. Used in multi-vendor or multi-region deployments where different head-end systems manage different endpoint populations. Examples: Itron Analytics instance ID, Oracle Utilities MDMS cluster name.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ipAddress rdf:type rdf:Property ;
    rdfs:label 'Ip Address' ;
    rdfs:comment 'IP address (IPv4 or IPv6) assigned to the AMI endpoint for IP-based communication networks (cellular, fixed network, or IP-over-PLC). Used for direct addressing, remote diagnostics, and firmware updates. Null for non-IP networks (legacy RF mesh, POTS).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastFirmwareUpdateTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Firmware Update Timestamp' ;
    rdfs:comment 'Timestamp of the most recent firmware update applied to the communication module. Used to track firmware deployment progress, identify endpoints requiring security patches, and troubleshoot post-upgrade issues.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lastSuccessfulCommunicationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Successful Communication Timestamp' ;
    rdfs:comment 'Timestamp of the most recent successful bidirectional communication session between the endpoint and the head-end system. Used to detect stale endpoints, identify communication outages, and trigger field service work orders for non-communicating meters.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lastTamperEventTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Tamper Event Timestamp' ;
    rdfs:comment 'Timestamp of the most recent tamper event detected by the endpoint. Null if no tamper has ever been detected. Used for revenue protection investigations, pattern analysis of theft activity, and field service prioritization.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:manufacturerName rdf:type rdf:Property ;
    rdfs:label 'Manufacturer Name' ;
    rdfs:comment 'Name of the manufacturer of the AMI communication module hardware. Examples: Itron, Landis+Gyr, Sensus, Aclara, Trilliant. Used for vendor performance analysis, warranty claims, and procurement planning.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:networkHopCount rdf:type rdf:Property ;
    rdfs:label 'Network Hop Count' ;
    rdfs:comment 'Number of network hops (intermediate nodes) between this endpoint and the head-end system or primary collector in mesh network topologies. Lower hop counts indicate better network position and more reliable communication. Null for direct cellular or POTS endpoints.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:networkType rdf:type rdf:Property ;
    rdfs:label 'Network Type' ;
    rdfs:comment 'Type of communication network technology used by this endpoint to transmit meter data to the utility head-end. RF_MESH = radio frequency mesh network; PLC = power line carrier; CELLULAR = cellular (LTE/5G); POTS = plain old telephone service; FIXED_NETWORK = fiber or Ethernet; HYBRID = combination of technologies.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outageDetectionEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Outage Detection Enabled Flag' ;
    rdfs:comment 'Boolean flag indicating whether this endpoint is configured to send last-gasp and first-breath messages for power outage detection. True = outage detection enabled and integrated with OMS; False = disabled or not supported by hardware. Critical for outage management system integration.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:portNumber rdf:type rdf:Property ;
    rdfs:label 'Port Number' ;
    rdfs:comment 'TCP or UDP port number used for communication sessions with the endpoint. Typically standardized per vendor or protocol (e.g., port 4059 for ANSI C12.22, port 8883 for MQTT over TLS). Used for firewall configuration and network security management.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:readIntervalMinutes rdf:type rdf:Property ;
    rdfs:label 'Read Interval Minutes' ;
    rdfs:comment 'Configured interval in minutes at which the endpoint transmits meter read data to the head-end system. Common values: 15, 30, 60 minutes for interval data; 1440 minutes (daily) for daily reads. Used for data volume planning and network bandwidth management.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:remoteDisconnectCapableFlag rdf:type rdf:Property ;
    rdfs:label 'Remote Disconnect Capable Flag' ;
    rdfs:comment 'Boolean flag indicating whether this endpoint supports remote service disconnect/reconnect commands. True = endpoint has integrated disconnect switch controllable via AMI network; False = manual field service required for disconnect. Used for credit management and demand response programs.' ;
    rdfs:domain ind:Metering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:signalStrengthBaselineDbm rdf:type rdf:Property ;
    rdfs:label 'Signal Strength Baseline Dbm' ;
    rdfs:comment 'Baseline signal strength measurement in decibels relative to one milliwatt (dBm) recorded during endpoint commissioning or last successful communication. Used to monitor network health, identify degraded links, and prioritize field maintenance. Typical range: -110 to -30 dBm for RF networks.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tamperDetectionFlag rdf:type rdf:Property ;
    rdfs:label 'Tamper Detection Flag' ;
    rdfs:comment 'Boolean flag indicating whether the endpoint has detected physical or electronic tampering. True = tamper event detected (cover removal, magnetic interference, communication jamming); False = no tamper detected. Triggers field investigation and potential revenue protection action.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:timeSyncSource rdf:type rdf:Property ;
    rdfs:label 'Time Sync Source' ;
    rdfs:comment 'Source used by the endpoint to synchronize its internal clock for accurate timestamping of meter reads and events. GPS = GPS receiver; NTP = Network Time Protocol; NETWORK = head-end system time sync; INTERNAL = internal oscillator (least accurate); MANUAL = manually set. Critical for interval data accuracy and event correlation.' ;
    rdfs:domain ind:AmiEndpoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dailyUsageSummaryId rdf:type rdf:Property ;
    rdfs:label 'Daily Usage Summary Id' ;
    rdfs:comment 'Unique identifier for the daily usage summary record. Primary key for this derived entity generated by the MDMS daily aggregation process.' ;
    rdfs:domain ind:DailyUsageSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:readCycleId rdf:type rdf:Property ;
    rdfs:label 'Read Cycle Id' ;
    rdfs:comment 'Foreign key linking to metering.read_cycle. Business justification: Daily usage summaries are organized by read cycle for billing alignment. The summary aggregates interval data for a specific meter on a specific date, and read cycles define the billing period boundar' ;
    rdfs:domain ind:Metering ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ReadCycle .

ind:touScheduleId rdf:type rdf:Property ;
    rdfs:label 'Tou Schedule Id' ;
    rdfs:comment 'Foreign key linking to metering.tou_schedule. Business justification: Daily usage summaries include TOU period breakdowns (on_peak_consumption, off_peak_consumption, super_off_peak_consumption) calculated using a specific TOU schedule. The tou_schedule defines the peak/' ;
    rdfs:domain ind:Metering ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TouSchedule .

ind:actualIntervalCount rdf:type rdf:Property ;
    rdfs:label 'Actual Interval Count' ;
    rdfs:comment 'The number of valid interval reads actually received and validated for the summary date. Used to calculate data completeness percentage and identify data quality issues.' ;
    rdfs:domain ind:DailyUsageSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:aggregationJobReference rdf:type rdf:Property ;
    rdfs:label 'Aggregation Job Reference' ;
    rdfs:comment 'The unique identifier of the MDMS batch job that generated this summary record. Used for operational troubleshooting and reprocessing scenarios.' ;
    rdfs:domain ind:DailyUsageSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aggregationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Aggregation Timestamp' ;
    rdfs:comment 'The date and time when this daily summary record was generated by the MDMS aggregation process. Represents the processing time, not the business event time (which is summary_date).' ;
    rdfs:domain ind:DailyUsageSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:averageTemperatureF rdf:type rdf:Property ;
    rdfs:label 'Average Temperature F' ;
    rdfs:comment 'The average ambient temperature in Fahrenheit for the service point location on the summary date. Used for weather normalization and load forecasting. Sourced from weather data integration.' ;
    rdfs:domain ind:DailyUsageSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:baselineConsumption rdf:type rdf:Property ;
    rdfs:label 'Baseline Consumption' ;
    rdfs:comment 'The calculated baseline consumption for this meter and date, used for demand response program performance measurement. Represents expected consumption absent a DR event. Expressed in the same unit as total_consumption.' ;
    rdfs:domain ind:DailyUsageSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:billingReadyFlag rdf:type rdf:Property ;
    rdfs:label 'Billing Ready Flag' ;
    rdfs:comment 'Indicates whether this daily summary has passed all validation checks and is approved for use in billing calculations. True means the data is billing-ready; False means it requires review or correction.' ;
    rdfs:domain ind:DailyUsageSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataCompletenessPercentage rdf:type rdf:Property ;
    rdfs:label 'Data Completeness Percentage' ;
    rdfs:comment 'The ratio of actual valid intervals to expected intervals, expressed as a percentage (0.00 to 100.00). Calculated as (actual_interval_count / expected_interval_count) * 100. Values below 95% typically trigger data quality alerts.' ;
    rdfs:domain ind:DailyUsageSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:drEventFlag rdf:type rdf:Property ;
    rdfs:label 'Dr Event Flag' ;
    rdfs:comment 'Indicates whether this meter participated in a demand response event on the summary date. True if a DR event occurred; False otherwise. Used to trigger load reduction calculation.' ;
    rdfs:domain ind:Metering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:estimatedIntervalCount rdf:type rdf:Property ;
    rdfs:label 'Estimated Interval Count' ;
    rdfs:comment 'The number of interval reads that were estimated by the VEE (Validation, Estimation, and Editing) process due to missing or invalid raw reads. Indicates data quality and estimation reliance.' ;
    rdfs:domain ind:DailyUsageSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:expectedIntervalCount rdf:type rdf:Property ;
    rdfs:label 'Expected Interval Count' ;
    rdfs:comment 'The number of interval reads expected for the summary date based on the meter\'s configured interval length (e.g., 96 for 15-minute intervals, 24 for hourly intervals). Used to calculate data completeness percentage.' ;
    rdfs:domain ind:DailyUsageSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:generationKwh rdf:type rdf:Property ;
    rdfs:label 'Generation Kwh' ;
    rdfs:comment 'The total energy generated and exported to the grid by customer-owned DER (e.g., rooftop solar) on the summary date. Null for non-NEM meters. Used for NEM credit calculation and REC tracking.' ;
    rdfs:domain ind:DailyUsageSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:loadReductionKwh rdf:type rdf:Property ;
    rdfs:label 'Load Reduction Kwh' ;
    rdfs:comment 'The calculated energy reduction achieved during demand response events, measured as baseline_consumption minus total_consumption. Null if dr_event_flag is False. Used for DR program settlement.' ;
    rdfs:domain ind:DailyUsageSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:meterReadSource rdf:type rdf:Property ;
    rdfs:label 'Meter Read Source' ;
    rdfs:comment 'The source system or method by which the interval data was collected: AMI (Advanced Metering Infrastructure), AMR (Automated Meter Reading), manual field read, estimated by system, or customer-provided read.' ;
    rdfs:domain ind:DailyUsageSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netConsumptionKwh rdf:type rdf:Property ;
    rdfs:label 'Net Consumption Kwh' ;
    rdfs:comment 'The net energy consumption calculated as total_consumption minus generation_kwh for NEM meters. Represents the billable consumption after accounting for customer generation. Null for non-NEM meters.' ;
    rdfs:domain ind:DailyUsageSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:offPeakConsumption rdf:type rdf:Property ;
    rdfs:label 'Off Peak Consumption' ;
    rdfs:comment 'Total consumption during off-peak hours as defined by the applicable Time-of-Use (TOU) rate schedule. Null for non-TOU meters. Expressed in the same unit as total_consumption.' ;
    rdfs:domain ind:DailyUsageSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:onPeakConsumption rdf:type rdf:Property ;
    rdfs:label 'On Peak Consumption' ;
    rdfs:comment 'Total consumption during on-peak hours as defined by the applicable Time-of-Use (TOU) rate schedule. Null for non-TOU meters. Expressed in the same unit as total_consumption.' ;
    rdfs:domain ind:DailyUsageSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outageFlag rdf:type rdf:Property ;
    rdfs:label 'Outage Flag' ;
    rdfs:comment 'Indicates whether an outage event was recorded for this meter on the summary date. True if an outage occurred; False otherwise. Used to correlate consumption gaps with known outage events.' ;
    rdfs:domain ind:DailyUsageSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:peakDemandTimestamp rdf:type rdf:Property ;
    rdfs:label 'Peak Demand Timestamp' ;
    rdfs:comment 'The precise date and time when the peak demand occurred during the summary date. Null if peak_demand_kw is null. Used for load profile analysis and demand response event correlation.' ;
    rdfs:domain ind:DailyUsageSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:rateScheduleCode rdf:type rdf:Property ;
    rdfs:label 'Rate Schedule Code' ;
    rdfs:comment 'The tariff rate schedule code applicable to this meter on the summary date. Determines TOU period definitions, demand billing rules, and pricing structure. Links to regulatory tariff schedules.' ;
    rdfs:domain ind:Metering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reactiveEnergyKvarh rdf:type rdf:Property ;
    rdfs:label 'Reactive Energy Kvarh' ;
    rdfs:comment 'The total reactive energy in kilovolt-ampere reactive hours for the summary date. Measured for commercial and industrial meters to assess power quality and calculate reactive power charges.' ;
    rdfs:domain ind:DailyUsageSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:summaryDate rdf:type rdf:Property ;
    rdfs:label 'Summary Date' ;
    rdfs:comment 'The calendar date for which this daily consumption summary was calculated. Represents the business day of energy usage, not the aggregation processing date.' ;
    rdfs:domain ind:DailyUsageSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:superOffPeakConsumption rdf:type rdf:Property ;
    rdfs:label 'Super Off Peak Consumption' ;
    rdfs:comment 'Total consumption during super off-peak hours (typically overnight) as defined by advanced TOU rate schedules. Null for meters without super off-peak pricing. Expressed in the same unit as total_consumption.' ;
    rdfs:domain ind:DailyUsageSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:temperatureAdjustedFlag rdf:type rdf:Property ;
    rdfs:label 'Temperature Adjusted Flag' ;
    rdfs:comment 'Indicates whether the consumption values have been adjusted for temperature normalization (degree-day adjustment). Typically used for gas consumption and weather-sensitive electric loads.' ;
    rdfs:domain ind:DailyUsageSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:totalConsumption rdf:type rdf:Property ;
    rdfs:label 'Total Consumption' ;
    rdfs:comment 'The total validated energy consumption for the summary date, aggregated from all interval reads. Value is expressed in the unit specified in unit_of_measure. This is the billing-ready daily total.' ;
    rdfs:domain ind:DailyUsageSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:veeRuleSetVersion rdf:type rdf:Property ;
    rdfs:label 'Vee Rule Set Version' ;
    rdfs:comment 'The version identifier of the VEE rule set applied during the aggregation and validation process. Used for audit trail and to track changes in validation logic over time.' ;
    rdfs:domain ind:DailyUsageSummary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:veeStatus rdf:type rdf:Property ;
    rdfs:label 'Vee Status' ;
    rdfs:comment 'The overall Validation, Estimation, and Editing (VEE) processing status for this daily summary. Indicates whether the data passed validation, required estimation, was manually edited, failed VEE rules, or is pending processing.' ;
    rdfs:domain ind:Metering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:intervalReadId rdf:type rdf:Property ;
    rdfs:label 'Interval Read Id' ;
    rdfs:comment 'Unique identifier for each interval read record. Primary key for the interval read table.' ;
    rdfs:domain ind:IntervalRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:meterChannelId rdf:type rdf:Property ;
    rdfs:label 'Meter Channel Id' ;
    rdfs:comment 'Foreign key linking to metering.meter_channel. Business justification: Interval reads are captured per meter channel. The interval_read table currently has channel_number (INT) which is a denormalized reference. Since meter_channel has a surrogate PK (meter_channel_id), ' ;
    rdfs:domain ind:Metering ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MeterChannel .

ind:baselineConsumptionValue rdf:type rdf:Property ;
    rdfs:label 'Baseline Consumption Value' ;
    rdfs:comment 'Calculated baseline consumption for this interval, representing expected usage without demand response participation. Used to measure load reduction during DR events and calculate customer incentive payments. Null for non-DR participants.' ;
    rdfs:domain ind:IntervalRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:billingDeterminantFlag rdf:type rdf:Property ;
    rdfs:label 'Billing Determinant Flag' ;
    rdfs:comment 'Boolean indicator that this interval read is used as a billing determinant for the current billing cycle. True when the interval contributes to demand charges, TOU energy charges, or other rate components. Used to identify billable intervals for revenue assurance.' ;
    rdfs:domain ind:Metering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:collectionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Collection Timestamp' ;
    rdfs:comment 'Timestamp when the interval read was collected from the meter or head-end system and ingested into MDMS. Distinct from the interval timestamps, which represent the measurement period. Used for data latency analysis and SLA monitoring.' ;
    rdfs:domain ind:IntervalRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:consumptionUom rdf:type rdf:Property ;
    rdfs:label 'Consumption Uom' ;
    rdfs:comment 'Unit of measure for the consumption value. Standard units include kWh (kilowatt-hour) for electric, MCF (thousand cubic feet) or Therm for gas, CCF (hundred cubic feet) for gas distribution.' ;
    rdfs:domain ind:IntervalRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consumptionValue rdf:type rdf:Property ;
    rdfs:label 'Consumption Value' ;
    rdfs:comment 'Raw energy consumption value for the interval. For electric meters, measured in kWh (kilowatt-hours). For gas meters, measured in MCF (thousand cubic feet) or therms. This is the primary measured quantity before VEE processing.' ;
    rdfs:domain ind:Metering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:demandUom rdf:type rdf:Property ;
    rdfs:label 'Demand Uom' ;
    rdfs:comment 'Unit of measure for the demand value. Standard units include kW (kilowatt), MW (megawatt), kVA (kilovolt-ampere), MVA (megavolt-ampere) for apparent power.' ;
    rdfs:domain ind:IntervalRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:demandValue rdf:type rdf:Property ;
    rdfs:label 'Demand Value' ;
    rdfs:comment 'Peak demand value recorded during the interval period. For electric meters, measured in kW (kilowatts) or MW (megawatts). Represents the maximum instantaneous power draw within the interval. Null for gas meters or meters not configured for demand measurement.' ;
    rdfs:domain ind:IntervalRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dstFlag rdf:type rdf:Property ;
    rdfs:label 'Dst Flag' ;
    rdfs:comment 'Boolean indicator that this interval occurred during daylight saving time. Used to handle spring-forward (23-hour day) and fall-back (25-hour day) transitions in interval data processing and billing calculations.' ;
    rdfs:domain ind:IntervalRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exceptionFlag rdf:type rdf:Property ;
    rdfs:label 'Exception Flag' ;
    rdfs:comment 'Boolean indicator that this interval read triggered a VEE exception or quality alert. True when the read failed validation thresholds, exhibited anomalous patterns, or requires manual review. Used to prioritize data quality investigations.' ;
    rdfs:domain ind:IntervalRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exceptionReason rdf:type rdf:Property ;
    rdfs:label 'Exception Reason' ;
    rdfs:comment 'Textual description of why the interval read was flagged as an exception. Examples include \'consumption spike exceeds threshold\', \'negative demand value\', \'missing data gap\', \'meter clock drift detected\'. Null when exception_flag is false.' ;
    rdfs:domain ind:IntervalRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loadResearchFlag rdf:type rdf:Property ;
    rdfs:label 'Load Research Flag' ;
    rdfs:comment 'Boolean indicator that this meter is part of a load research sample. True when the meter is selected for statistical load profiling, rate design studies, or regulatory reporting. Used to identify sample meters for load research analysis.' ;
    rdfs:domain ind:IntervalRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:netConsumptionValue rdf:type rdf:Property ;
    rdfs:label 'Net Consumption Value' ;
    rdfs:comment 'Net energy consumption for the interval, calculated as delivered energy minus received energy. Used for net energy metering (NEM) billing calculations. Positive values indicate net consumption, negative values indicate net generation.' ;
    rdfs:domain ind:IntervalRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:powerOutageFlag rdf:type rdf:Property ;
    rdfs:label 'Power Outage Flag' ;
    rdfs:comment 'Boolean indicator that a power outage occurred during this interval period. True when the meter recorded a loss of service event. Used to correlate interval data with outage events from OMS and adjust billing for service interruptions.' ;
    rdfs:domain ind:IntervalRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reactiveEnergyValue rdf:type rdf:Property ;
    rdfs:label 'Reactive Energy Value' ;
    rdfs:comment 'Reactive energy consumption during the interval period, measured in kVARh (kilovolt-ampere reactive hours). Used for power factor correction billing and grid voltage support analysis. Null for gas meters or single-phase residential meters.' ;
    rdfs:domain ind:IntervalRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:readQualityCode rdf:type rdf:Property ;
    rdfs:label 'Read Quality Code' ;
    rdfs:comment 'Quality classification of the interval read. Indicates whether the value is an actual meter reading, an estimated value generated by VEE algorithms, a substituted value from a similar profile, missing data, or rejected due to validation failure.' ;
    rdfs:domain ind:Metering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reverseFlowFlag rdf:type rdf:Property ;
    rdfs:label 'Reverse Flow Flag' ;
    rdfs:comment 'Boolean indicator that energy flowed in the reverse direction during this interval (customer generation exported to grid). True for net metering scenarios with solar, wind, or other distributed energy resources. Used for NEM billing and DER integration analysis.' ;
    rdfs:domain ind:IntervalRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:temperatureUom rdf:type rdf:Property ;
    rdfs:label 'Temperature Uom' ;
    rdfs:comment 'Unit of measure for temperature value. F for Fahrenheit, C for Celsius.' ;
    rdfs:domain ind:IntervalRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:temperatureValue rdf:type rdf:Property ;
    rdfs:label 'Temperature Value' ;
    rdfs:comment 'Ambient temperature at the meter location during the interval period, measured in degrees Fahrenheit or Celsius. Used for weather normalization, load forecasting, and demand response baseline adjustments. Sourced from weather stations or meter-integrated sensors.' ;
    rdfs:domain ind:IntervalRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:timeZoneCode rdf:type rdf:Property ;
    rdfs:label 'Time Zone Code' ;
    rdfs:comment 'IANA time zone identifier for the meter location (e.g., America/New_York, America/Chicago). Used to correctly interpret interval timestamps during daylight saving time transitions and for multi-region utilities.' ;
    rdfs:domain ind:IntervalRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationRuleCode rdf:type rdf:Property ;
    rdfs:label 'Validation Rule Code' ;
    rdfs:comment 'Code identifying the VEE validation rule that processed this interval read. References the specific business rule or algorithm applied during validation (e.g., range check, spike detection, consistency check). Used for audit and troubleshooting.' ;
    rdfs:domain ind:IntervalRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Validation Timestamp' ;
    rdfs:comment 'Timestamp when the interval read completed VEE validation processing. Null for raw reads that have not yet been validated. Used to track VEE processing latency and audit data quality workflows.' ;
    rdfs:domain ind:IntervalRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:voltageValue rdf:type rdf:Property ;
    rdfs:label 'Voltage Value' ;
    rdfs:comment 'Average voltage measured at the meter during the interval period, in volts. Used for power quality monitoring, voltage regulation analysis, and grid reliability studies. Null for gas meters.' ;
    rdfs:domain ind:IntervalRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:accuracyClass rdf:type rdf:Property ;
    rdfs:label 'Accuracy Class' ;
    rdfs:comment 'Meter accuracy rating as defined by ANSI standards. Common classes include 0.2, 0.5, 1.0, and 2.0, representing the maximum percentage error under specified conditions. Higher accuracy classes (lower numbers) are required for revenue metering and large commercial customers.' ;
    rdfs:domain ind:Metering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:communicationModuleType rdf:type rdf:Property ;
    rdfs:label 'Communication Module Type' ;
    rdfs:comment 'Technology used by the meter to transmit data to the utility\'s MDMS. RF Mesh uses radio frequency mesh networks. PLC (Power Line Carrier) transmits data over electric distribution lines. Cellular uses mobile networks. Zigbee and Wi-Fi are used for home area networks. None indicates manual-read meters.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currentRating rdf:type rdf:Property ;
    rdfs:label 'Current Rating' ;
    rdfs:comment 'Maximum continuous current in amperes that the meter can accurately measure without damage. Typical ratings include 100A, 200A, 320A for residential and small commercial, and higher ratings for large commercial and industrial customers. Used to ensure meter capacity matches service load.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:demandCapable rdf:type rdf:Property ;
    rdfs:label 'Demand Capable' ;
    rdfs:comment 'Indicates whether the meter can measure and record peak demand (kW or MW) in addition to energy consumption (kWh or MWh). Demand-capable meters are required for commercial and industrial customers subject to demand charges. Essential for rate application and billing.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:encryptionEnabled rdf:type rdf:Property ;
    rdfs:label 'Encryption Enabled' ;
    rdfs:comment 'Indicates whether the meter encrypts data transmissions to the MDMS. Encryption protects customer usage data and prevents unauthorized access or tampering. Required for compliance with NIST cybersecurity guidelines for smart grid devices.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:expectedUsefulLifeYears rdf:type rdf:Property ;
    rdfs:label 'Expected Useful Life Years' ;
    rdfs:comment 'Estimated operational lifespan of the meter in years, based on manufacturer specifications and utility experience. Typical values are 15-20 years for AMI meters, 30-40 years for electromechanical meters. Used for depreciation calculations and replacement planning.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:formFactor rdf:type rdf:Property ;
    rdfs:label 'Form Factor' ;
    rdfs:comment 'Physical configuration and wiring arrangement of the meter. For electric meters, examples include Form 2S (single-phase), Form 4S (three-wire network), Form 9S (three-phase delta), Form 12S (three-phase wye), Form 16S (three-phase four-wire delta). Determines installation requirements and service compatibility.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:installationStatus rdf:type rdf:Property ;
    rdfs:label 'Installation Status' ;
    rdfs:comment 'Current physical deployment state of the meter. Installed indicates the meter is actively deployed at a service point. Removed indicates the meter has been taken out of service. In-Stock indicates the meter is in warehouse inventory. In-Transit indicates the meter is being shipped. Retired indicates the meter is permanently out of service. Failed indicates the meter has malfunctioned.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:intervalLengthMinutes rdf:type rdf:Property ;
    rdfs:label 'Interval Length Minutes' ;
    rdfs:comment 'Duration in minutes of each interval data recording period. Common values are 15, 30, or 60 minutes. AMI meters typically record 15-minute intervals. Used to determine data granularity for load profiling, demand response, and time-of-use billing.' ;
    rdfs:domain ind:Metering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastTestDate rdf:type rdf:Property ;
    rdfs:label 'Last Test Date' ;
    rdfs:comment 'Date of the most recent accuracy test or calibration performed on the meter. Regulatory requirements typically mandate periodic testing (e.g., every 10-15 years for electric meters). Used to schedule future testing and ensure measurement accuracy for billing.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lifecycleState rdf:type rdf:Property ;
    rdfs:label 'Lifecycle State' ;
    rdfs:comment 'Operational lifecycle stage of the meter asset. Active indicates the meter is in service and collecting data. Inactive indicates the meter is not currently in use but may be redeployed. Testing indicates the meter is undergoing validation or calibration. Decommissioned indicates the meter has been permanently removed from inventory.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:manufactureDate rdf:type rdf:Property ;
    rdfs:label 'Manufacture Date' ;
    rdfs:comment 'Date when the meter was manufactured by the vendor. Used to determine warranty coverage, expected lifespan, and compliance with regulatory standards in effect at time of manufacture. May differ significantly from installation date for meters held in inventory.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:meterType rdf:type rdf:Property ;
    rdfs:label 'Meter Type' ;
    rdfs:comment 'Classification of the meter based on its technology and data collection capability. AMI (Advanced Metering Infrastructure) supports two-way communication and remote disconnect. AMR (Automated Meter Reading) supports one-way read-only communication. Electromechanical meters require manual reads. Determines data collection frequency and operational capabilities.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:multiplier rdf:type rdf:Property ;
    rdfs:label 'Multiplier' ;
    rdfs:comment 'Scaling factor applied to meter register readings to calculate actual consumption. Used when current transformers (CTs) or potential transformers (PTs) are installed. For example, a multiplier of 40 means each register unit represents 40 kWh. Essential for accurate billing of high-load customers.' ;
    rdfs:domain ind:Metering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netMeteringCapable rdf:type rdf:Property ;
    rdfs:label 'Net Metering Capable' ;
    rdfs:comment 'Indicates whether the meter can measure and record bi-directional energy flow (both consumption and generation). Required for customers with distributed energy resources (DER) such as rooftop solar. Supports net energy metering (NEM) programs and renewable energy credit (REC) tracking.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nextTestDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Test Due Date' ;
    rdfs:comment 'Scheduled date for the next required accuracy test or calibration. Calculated based on last test date and regulatory testing intervals. Used to generate preventive maintenance work orders and ensure compliance with PUC testing requirements.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:numberOfDials rdf:type rdf:Property ;
    rdfs:label 'Number Of Dials' ;
    rdfs:comment 'Count of register dials on electromechanical meters, typically 4 or 5 dials. Determines the maximum reading capacity before rollover. Not applicable to electronic or AMI meters which use digital displays. Used for manual meter reading validation.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:outageDetectionCapable rdf:type rdf:Property ;
    rdfs:label 'Outage Detection Capable' ;
    rdfs:comment 'Indicates whether the meter can detect and report power outages and restoration events. AMI meters with this capability send last-gasp messages during outages and first-breath messages upon restoration. Feeds the Outage Management System (OMS) for improved outage response.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:registerCount rdf:type rdf:Property ;
    rdfs:label 'Register Count' ;
    rdfs:comment 'Number of independent measurement registers in the meter. Single-register meters measure total consumption. Multi-register meters can track time-of-use (TOU) periods, demand intervals, or separate rate schedules. Used to support complex rate structures and demand response programs.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:remoteDisconnectCapable rdf:type rdf:Property ;
    rdfs:label 'Remote Disconnect Capable' ;
    rdfs:comment 'Indicates whether the meter includes a service switch that can be remotely controlled to connect or disconnect service. Enables remote service activation for move-ins, disconnection for non-payment, and reconnection after payment. Common feature of modern AMI meters.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:removalDate rdf:type rdf:Property ;
    rdfs:label 'Removal Date' ;
    rdfs:comment 'Date when the meter was physically removed from service. Used to close out meter-to-premise associations, finalize billing periods, and track meter inventory movements. Null for meters currently in service.' ;
    rdfs:domain ind:Metering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:tamperDetectionCapable rdf:type rdf:Property ;
    rdfs:label 'Tamper Detection Capable' ;
    rdfs:comment 'Indicates whether the meter can detect and report physical tampering, meter cover removal, magnetic interference, or reverse energy flow. Tamper events trigger alerts in MDMS for investigation. Critical for revenue protection and theft detection.' ;
    rdfs:domain ind:Meter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:voltageClass rdf:type rdf:Property ;
    rdfs:label 'Voltage Class' ;
    rdfs:comment 'Rated voltage level for which the meter is designed. Common classes include 120V, 240V, 480V for distribution, and higher voltages for transmission-level metering. Must match the service point voltage to ensure accurate measurement and safety.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:warrantyExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Warranty Expiration Date' ;
    rdfs:comment 'Date when the manufacturer\'s warranty coverage ends. Used to determine whether repair or replacement costs are covered by the vendor. Calculated from manufacture date or installation date based on warranty terms. Critical for asset management and budgeting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:activationDate rdf:type rdf:Property ;
    rdfs:label 'Activation Date' ;
    rdfs:comment 'Date on which this channel was activated and began collecting measurement data. Used to determine the valid date range for interval and register reads.' ;
    rdfs:domain ind:MeterChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:channelName rdf:type rdf:Property ;
    rdfs:label 'Channel Name' ;
    rdfs:comment 'Human-readable descriptive name for the measurement channel, such as \'Delivered Energy\', \'Received Energy\', \'Reactive Power\', or \'Demand\'.' ;
    rdfs:domain ind:MeterChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:channelNumber rdf:type rdf:Property ;
    rdfs:label 'Channel Number' ;
    rdfs:comment 'Sequential numeric identifier for this channel within the meter device. Typically ranges from 1 to the maximum number of channels supported by the meter model.' ;
    rdfs:domain ind:MeterChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:channelStatus rdf:type rdf:Property ;
    rdfs:label 'Channel Status' ;
    rdfs:comment 'Current operational status of the meter channel. Only active channels participate in data collection and billing processes.' ;
    rdfs:domain ind:MeterChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:channelType rdf:type rdf:Property ;
    rdfs:label 'Channel Type' ;
    rdfs:comment 'Classification of the measurement quantity captured by this channel. Determines the nature of the data collected and how it is used in billing and analytics. [ENUM-REF-CANDIDATE: energy|demand|reactive|power_factor|voltage|current|gas_volume|temperature — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:MeterChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectionMode rdf:type rdf:Property ;
    rdfs:label 'Collection Mode' ;
    rdfs:comment 'Method by which data is collected from this channel. Interval mode captures time-series data at regular intervals; cumulative mode captures running totals; register mode captures periodic snapshots.' ;
    rdfs:domain ind:MeterChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:configurationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Configuration Timestamp' ;
    rdfs:comment 'Date and time when the current channel configuration was applied. Critical for correlating configuration changes with data quality issues.' ;
    rdfs:domain ind:MeterChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:configurationVersion rdf:type rdf:Property ;
    rdfs:label 'Configuration Version' ;
    rdfs:comment 'Version identifier for the channel configuration. Incremented when channel parameters are modified. Enables tracking of configuration changes over time.' ;
    rdfs:domain ind:Metering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:configuredByUserCode rdf:type rdf:Property ;
    rdfs:label 'Configured By User Code' ;
    rdfs:comment 'Identifier of the system user or technician who last configured or modified this channel. Supports audit trail and accountability requirements.' ;
    rdfs:domain ind:Metering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataQualityThresholdPercent rdf:type rdf:Property ;
    rdfs:label 'Data Quality Threshold Percent' ;
    rdfs:comment 'Minimum acceptable data quality score percentage for readings from this channel. Readings below this threshold trigger VEE processing or manual review.' ;
    rdfs:domain ind:MeterChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:demandIntervalMinutes rdf:type rdf:Property ;
    rdfs:label 'Demand Interval Minutes' ;
    rdfs:comment 'Length of the demand measurement interval in minutes for demand channels. Common values are 15, 30, or 60 minutes. Null for non-demand channels.' ;
    rdfs:domain ind:Metering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:demandResponseEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Demand Response Eligible Flag' ;
    rdfs:comment 'Indicates whether consumption measured by this channel is eligible for demand response program participation and curtailment event tracking.' ;
    rdfs:domain ind:MeterChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:loadProfileEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Load Profile Enabled Flag' ;
    rdfs:comment 'Indicates whether this channel participates in load profiling and load research studies. When true, interval data is retained for extended periods for analytical purposes.' ;
    rdfs:domain ind:MeterChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lossCompensationFactor rdf:type rdf:Property ;
    rdfs:label 'Loss Compensation Factor' ;
    rdfs:comment 'Adjustment factor applied to channel readings to compensate for energy losses in service transformers or distribution equipment. Used when meter is located upstream of loss-producing equipment.' ;
    rdfs:domain ind:Metering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:measurementDirection rdf:type rdf:Property ;
    rdfs:label 'Measurement Direction' ;
    rdfs:comment 'Direction of energy or commodity flow measured by this channel. Critical for Net Energy Metering (NEM) applications where delivered and received energy must be tracked separately.' ;
    rdfs:domain ind:MeterChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pressureCompensationEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Pressure Compensation Enabled Flag' ;
    rdfs:comment 'Indicates whether pressure compensation is applied to gas volume measurements from this channel. Required for accurate gas billing when pressure varies significantly from standard conditions.' ;
    rdfs:domain ind:MeterChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pulseWeight rdf:type rdf:Property ;
    rdfs:label 'Pulse Weight' ;
    rdfs:comment 'Energy or volume quantity represented by each pulse output from the meter channel. Used for pulse-based Automated Meter Reading (AMR) systems.' ;
    rdfs:domain ind:MeterChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:registerMultiplier rdf:type rdf:Property ;
    rdfs:label 'Register Multiplier' ;
    rdfs:comment 'Additional scaling factor applied to register readings for this channel. May differ from the CT/PT multiplier when register configuration requires separate adjustment.' ;
    rdfs:domain ind:Metering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:temperatureCompensationEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Temperature Compensation Enabled Flag' ;
    rdfs:comment 'Indicates whether temperature compensation is applied to gas volume measurements from this channel. Required for accurate gas billing when temperature varies significantly from standard conditions.' ;
    rdfs:domain ind:MeterChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:timeOfUseApplicableFlag rdf:type rdf:Property ;
    rdfs:label 'Time Of Use Applicable Flag' ;
    rdfs:comment 'Indicates whether this channel participates in Time-of-Use rate calculations. When true, interval reads from this channel are segmented by TOU period for billing.' ;
    rdfs:domain ind:MeterChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:veeRuleSetCode rdf:type rdf:Property ;
    rdfs:label 'Vee Rule Set Code' ;
    rdfs:comment 'Code identifying the VEE rule set applied to readings from this channel. Determines which validation, estimation, and editing rules are executed during meter data processing.' ;
    rdfs:domain ind:MeterChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meterConfigurationId rdf:type rdf:Property ;
    rdfs:label 'Meter Configuration Id' ;
    rdfs:comment 'Unique identifier for the meter configuration record. Primary key for this entity. Each configuration change creates a new version with a new ID.' ;
    rdfs:domain ind:MeterConfiguration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:veeRuleSetId rdf:type rdf:Property ;
    rdfs:label 'Vee Rule Set Id' ;
    rdfs:comment 'Identifier of the VEE rule set applied to interval reads from this meter configuration. Determines which validation checks, estimation algorithms, and editing rules are applied in MDMS before data is released to billing.' ;
    rdfs:domain ind:Metering ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:VeeRuleSet .

ind:channelCount rdf:type rdf:Property ;
    rdfs:label 'Channel Count' ;
    rdfs:comment 'Total number of measurement channels configured on this meter. Typically 1-4 for residential meters, more for commercial/industrial installations with multiple services or Net Energy Metering (NEM) export channels.' ;
    rdfs:domain ind:MeterConfiguration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:configurationSource rdf:type rdf:Property ;
    rdfs:label 'Configuration Source' ;
    rdfs:comment 'Origin of this configuration record. Indicates whether the configuration was manually entered, auto-discovered from AMI network, generated by MDMS automation, or created from a field work order.' ;
    rdfs:domain ind:MeterConfiguration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:configurationStatus rdf:type rdf:Property ;
    rdfs:label 'Configuration Status' ;
    rdfs:comment 'Current lifecycle status of this configuration record. Active indicates the configuration is currently deployed and operational in the field.' ;
    rdfs:domain ind:MeterConfiguration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:configurationType rdf:type rdf:Property ;
    rdfs:label 'Configuration Type' ;
    rdfs:comment 'Classification of the meter configuration based on its primary measurement and billing capabilities. Determines which MDMS validation and estimation rules apply.' ;
    rdfs:domain ind:MeterConfiguration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:demandResetDay rdf:type rdf:Property ;
    rdfs:label 'Demand Reset Day' ;
    rdfs:comment 'Day of the month (1-31) when the meter\'s demand register resets. Aligns with billing cycle start date to capture peak demand for the billing period. Critical for accurate demand charge calculation.' ;
    rdfs:domain ind:MeterConfiguration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:deploymentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Deployment Timestamp' ;
    rdfs:comment 'Exact date and time when this configuration was successfully deployed to the physical meter in the field. May differ from effective_date if deployment was scheduled in advance.' ;
    rdfs:domain ind:MeterConfiguration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:exportChannelNumber rdf:type rdf:Property ;
    rdfs:label 'Export Channel Number' ;
    rdfs:comment 'Channel number designated for measuring energy exported to the grid. Null for non-NEM meters. Typically channel 2 or 3 for residential solar installations.' ;
    rdfs:domain ind:MeterConfiguration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:netMeteringEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Net Metering Enabled Flag' ;
    rdfs:comment 'Indicates whether this meter is configured for Net Energy Metering with bidirectional measurement. True for customers with Distributed Energy Resources (DER) such as rooftop solar that export energy to the grid.' ;
    rdfs:domain ind:MeterConfiguration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pulseWeightKwh rdf:type rdf:Property ;
    rdfs:label 'Pulse Weight Kwh' ;
    rdfs:comment 'Energy quantity represented by each pulse output from the meter. Used to convert pulse counts to kWh for legacy Automated Meter Reading (AMR) systems. Null for Advanced Metering Infrastructure (AMI) meters that transmit engineering units directly.' ;
    rdfs:domain ind:MeterConfiguration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:readFrequencyHours rdf:type rdf:Property ;
    rdfs:label 'Read Frequency Hours' ;
    rdfs:comment 'Scheduled frequency for automated meter reads in hours. Common values are 1 (hourly), 4 (every 4 hours), or 24 (daily). Determines how often MDMS polls the meter for interval data.' ;
    rdfs:domain ind:MeterConfiguration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:registerReadResolution rdf:type rdf:Property ;
    rdfs:label 'Register Read Resolution' ;
    rdfs:comment 'Smallest increment the meter can measure and record, expressed in watt-hours. Typical values are 1, 10, or 100 Wh. Determines the precision of interval data and cumulative register reads.' ;
    rdfs:domain ind:MeterConfiguration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:transformerLossCorrectedFlag rdf:type rdf:Property ;
    rdfs:label 'Transformer Loss Corrected Flag' ;
    rdfs:comment 'Indicates whether this meter configuration includes automatic correction for transformer losses. True means the meter applies loss compensation internally; False means correction is applied in MDMS or billing.' ;
    rdfs:domain ind:MeterConfiguration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:validationErrorCode rdf:type rdf:Property ;
    rdfs:label 'Validation Error Code' ;
    rdfs:comment 'Code identifying the specific validation rule that failed, if validation_status is validation_failed. Null for validated configurations. Used for troubleshooting and configuration correction workflows.' ;
    rdfs:domain ind:MeterConfiguration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationStatus rdf:type rdf:Property ;
    rdfs:label 'Validation Status' ;
    rdfs:comment 'Status of automated validation checks performed on this configuration. Validated indicates all business rules passed; validation_failed indicates configuration anomalies requiring review.' ;
    rdfs:domain ind:MeterConfiguration ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meterEventId rdf:type rdf:Property ;
    rdfs:label 'Meter Event Id' ;
    rdfs:comment 'Unique identifier for the meter event record. Primary key for the meter event log.' ;
    rdfs:domain ind:MeterEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:customerAccountId rdf:type rdf:Property ;
    rdfs:label 'Customer Account Id' ;
    rdfs:comment 'Identifier of the customer account associated with the service point and meter. Used for customer notification and billing impact analysis.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Account .

ind:acknowledgedBy rdf:type rdf:Property ;
    rdfs:label 'Acknowledged By' ;
    rdfs:comment 'User ID or system identifier of the person or automated process that acknowledged the event. Null if unacknowledged.' ;
    rdfs:domain ind:MeterEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acknowledgedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Acknowledged Timestamp' ;
    rdfs:comment 'Date and time when the event was acknowledged. Null if the event has not been acknowledged.' ;
    rdfs:domain ind:MeterEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:acknowledgmentStatus rdf:type rdf:Property ;
    rdfs:label 'Acknowledgment Status' ;
    rdfs:comment 'Indicates whether the event has been acknowledged by operations staff or automatically cleared by the system. Tracks event lifecycle state.' ;
    rdfs:domain ind:MeterEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currentReading rdf:type rdf:Property ;
    rdfs:label 'Current Reading' ;
    rdfs:comment 'Current measurement in amperes captured at the time of the event, if applicable. Used for tamper detection and reverse flow analysis.' ;
    rdfs:domain ind:MeterEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eventCode rdf:type rdf:Property ;
    rdfs:label 'Event Code' ;
    rdfs:comment 'Raw event code or alarm identifier as transmitted by the meter or endpoint. Vendor-specific code that maps to the event type.' ;
    rdfs:domain ind:MeterEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventDescription rdf:type rdf:Property ;
    rdfs:label 'Event Description' ;
    rdfs:comment 'Human-readable description of the event, providing additional context beyond the event type and code. May include device-generated diagnostic messages.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventResolutionNotes rdf:type rdf:Property ;
    rdfs:label 'Event Resolution Notes' ;
    rdfs:comment 'Free-text notes documenting the investigation findings, corrective actions taken, and event resolution details. Entered by operations or field staff.' ;
    rdfs:domain ind:MeterEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventSeverity rdf:type rdf:Property ;
    rdfs:label 'Event Severity' ;
    rdfs:comment 'Severity level assigned to the event based on operational impact and urgency. Used for prioritization and escalation workflows.' ;
    rdfs:domain ind:MeterEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Event Source System' ;
    rdfs:comment 'Name of the head-end system or MDMS platform that received and processed the event from the meter endpoint (e.g., Itron Analytics, Oracle Utilities MDMS).' ;
    rdfs:domain ind:MeterEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventTimestamp rdf:type rdf:Property ;
    rdfs:label 'Event Timestamp' ;
    rdfs:comment 'Date and time when the event occurred at the meter or endpoint, as recorded by the device clock. This is the business event time, distinct from system receipt time.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:fieldInvestigationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Field Investigation Required Flag' ;
    rdfs:comment 'Boolean indicator of whether this event requires field crew investigation or site visit. True if investigation required, False otherwise.' ;
    rdfs:domain ind:MeterEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:forwardedToOmsFlag rdf:type rdf:Property ;
    rdfs:label 'Forwarded To Oms Flag' ;
    rdfs:comment 'Boolean indicator of whether this event was forwarded to the Outage Management System for outage correlation and crew dispatch. True if forwarded, False otherwise.' ;
    rdfs:domain ind:MeterEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:notificationChannel rdf:type rdf:Property ;
    rdfs:label 'Notification Channel' ;
    rdfs:comment 'Communication channel used to send the event notification to the customer or operations staff. Null if no notification sent.' ;
    rdfs:domain ind:MeterEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationSentFlag rdf:type rdf:Property ;
    rdfs:label 'Notification Sent Flag' ;
    rdfs:comment 'Boolean indicator of whether a customer or operations notification was sent for this event. True if notification sent, False otherwise.' ;
    rdfs:domain ind:MeterEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:omsIncidentReference rdf:type rdf:Property ;
    rdfs:label 'Oms Incident Reference' ;
    rdfs:comment 'Identifier of the outage incident created in the OMS as a result of this meter event. Null if not forwarded or no incident created.' ;
    rdfs:domain ind:MeterEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:processedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Processed Timestamp' ;
    rdfs:comment 'Date and time when the event was processed and validated by the MDMS or event management system. Used for event processing latency analysis.' ;
    rdfs:domain ind:MeterEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:resolvedBy rdf:type rdf:Property ;
    rdfs:label 'Resolved By' ;
    rdfs:comment 'User ID or system identifier of the person or automated process that resolved and closed the event. Null if unresolved.' ;
    rdfs:domain ind:MeterEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolvedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Resolved Timestamp' ;
    rdfs:comment 'Date and time when the event was marked as resolved or closed. Null for open or unresolved events.' ;
    rdfs:domain ind:MeterEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:signalStrengthDbm rdf:type rdf:Property ;
    rdfs:label 'Signal Strength Dbm' ;
    rdfs:comment 'Communication signal strength in decibels-milliwatts at the time of the event. Used for communication loss event diagnosis and network optimization.' ;
    rdfs:domain ind:Metering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tamperCount rdf:type rdf:Property ;
    rdfs:label 'Tamper Count' ;
    rdfs:comment 'Cumulative count of tamper events detected by the meter since last reset. Used for theft investigation and fraud detection.' ;
    rdfs:domain ind:MeterEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:voltageReading rdf:type rdf:Property ;
    rdfs:label 'Voltage Reading' ;
    rdfs:comment 'Voltage measurement in volts captured at the time of the event, if applicable. Used for power quality events such as voltage sag or swell.' ;
    rdfs:domain ind:MeterEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:meterPremiseId rdf:type rdf:Property ;
    rdfs:label 'Meter Premise Id' ;
    rdfs:comment 'Unique identifier for the meter-to-premise association record. Primary key for this entity.' ;
    rdfs:domain ind:MeterPremise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:billingAccountId rdf:type rdf:Property ;
    rdfs:label 'Billing Account Id' ;
    rdfs:comment 'The billing account responsible for charges associated with consumption at this meter-premise association. Links to the customer billing domain.' ;
    rdfs:domain ind:MeterPremise ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Account .

ind:primaryMeterInstallationWorkOrderId rdf:type rdf:Property ;
    rdfs:label 'Primary Meter Installation Work Order Id' ;
    rdfs:comment 'Reference to the field work order that authorized and documented the meter installation at this premise. Links to the work management system.' ;
    rdfs:domain ind:MeterPremise ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WorkOrder .

ind:associationStatus rdf:type rdf:Property ;
    rdfs:label 'Association Status' ;
    rdfs:comment 'Current lifecycle status of the meter-premise association. Active indicates the meter is currently serving the premise; inactive indicates historical association; pending indicates scheduled future installation; removed indicates meter has been physically removed; suspended indicates temporary service interruption.' ;
    rdfs:domain ind:MeterPremise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:demandMeteringFlag rdf:type rdf:Property ;
    rdfs:label 'Demand Metering Flag' ;
    rdfs:comment 'Indicates whether this meter measures peak demand (kW or MW) in addition to energy consumption (kWh or MWh). True for commercial/industrial customers with demand charges; false for energy-only metering.' ;
    rdfs:domain ind:MeterPremise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:effectiveEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Effective End Timestamp' ;
    rdfs:comment 'The precise timestamp when this meter-premise association ceased to be effective for billing and data collection. Null if currently active.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:effectiveStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Effective Start Timestamp' ;
    rdfs:comment 'The precise timestamp when this meter-premise association became effective for billing and data collection purposes. May differ from physical installation_date if backdated.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:finalRegisterRead rdf:type rdf:Property ;
    rdfs:label 'Final Register Read' ;
    rdfs:comment 'The meter register reading recorded at the time of removal from this premise. Used to calculate final consumption and close out the billing period. Null if meter is still active.' ;
    rdfs:domain ind:MeterPremise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:initialRegisterRead rdf:type rdf:Property ;
    rdfs:label 'Initial Register Read' ;
    rdfs:comment 'The meter register reading (cumulative energy consumption) recorded at the time of installation at this premise. Used to establish the starting point for consumption calculation.' ;
    rdfs:domain ind:MeterPremise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:installationReasonCode rdf:type rdf:Property ;
    rdfs:label 'Installation Reason Code' ;
    rdfs:comment 'The business reason for installing the meter at this premise. New service for first-time installations; meter upgrade for technology refresh; meter failure for replacement of defective units; AMI deployment for smart meter rollout; customer request for customer-initiated changes; move-in for tenant changes.' ;
    rdfs:domain ind:MeterPremise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:installationTechnicianCode rdf:type rdf:Property ;
    rdfs:label 'Installation Technician Code' ;
    rdfs:comment 'Identifier of the field technician who performed the meter installation. Used for quality tracking and accountability.' ;
    rdfs:domain ind:MeterPremise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:intervalDataCollectionFlag rdf:type rdf:Property ;
    rdfs:label 'Interval Data Collection Flag' ;
    rdfs:comment 'Indicates whether this meter collects interval consumption data (typically 15-minute or hourly intervals) rather than cumulative register reads only. True for AMI meters and large commercial customers; false for basic meters.' ;
    rdfs:domain ind:MeterPremise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:meterAccessibility rdf:type rdf:Property ;
    rdfs:label 'Meter Accessibility' ;
    rdfs:comment 'Indicates the accessibility of the meter for reading and maintenance. Accessible for unrestricted access; restricted for limited access requiring appointment; locked for secured locations requiring key; inside for interior locations requiring customer presence; outside for exterior locations.' ;
    rdfs:domain ind:MeterPremise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meterLocationDescription rdf:type rdf:Property ;
    rdfs:label 'Meter Location Description' ;
    rdfs:comment 'Free-text description of the physical location of the meter at the premise (e.g., basement northwest corner, exterior wall rear, utility room). Used by field technicians to locate the meter.' ;
    rdfs:domain ind:MeterPremise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meterPosition rdf:type rdf:Property ;
    rdfs:label 'Meter Position' ;
    rdfs:comment 'The functional role of the meter at the service point. Main meters are primary billing meters; sub-meters measure individual circuits or tenants; check meters validate main meter accuracy; totalizing meters aggregate multiple feeds; backup meters provide redundancy.' ;
    rdfs:domain ind:MeterPremise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readSequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Read Sequence Number' ;
    rdfs:comment 'The order in which this meter is read within its read cycle route. Used to optimize field technician routing and scheduling.' ;
    rdfs:domain ind:Metering ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:registerUnitOfMeasure rdf:type rdf:Property ;
    rdfs:label 'Register Unit Of Measure' ;
    rdfs:comment 'The unit of measure for the meter register readings. kWh and MWh for electric energy; MCF and Therm for gas volume/energy; kW and MW for demand.' ;
    rdfs:domain ind:MeterPremise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:removalReasonCode rdf:type rdf:Property ;
    rdfs:label 'Removal Reason Code' ;
    rdfs:comment 'The business reason for removing the meter from this premise. Service termination for account closure; meter upgrade for technology refresh; meter failure for defective unit replacement; AMI deployment for smart meter rollout; customer request for customer-initiated changes; move-out for tenant changes. Null if meter is still active.' ;
    rdfs:domain ind:MeterPremise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:removalTechnicianCode rdf:type rdf:Property ;
    rdfs:label 'Removal Technician Code' ;
    rdfs:comment 'Identifier of the field technician who performed the meter removal. Null if meter is still active.' ;
    rdfs:domain ind:MeterPremise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sealNumber rdf:type rdf:Property ;
    rdfs:label 'Seal Number' ;
    rdfs:comment 'The unique identifier of the tamper-evident seal applied to the meter at installation. Used for security and tamper detection. Multiple seals may be recorded as comma-separated values.' ;
    rdfs:domain ind:MeterPremise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemRecordReference rdf:type rdf:Property ;
    rdfs:label 'Source System Record Reference' ;
    rdfs:comment 'The unique identifier of this meter-premise association record in the source operational system. Used for traceability and reconciliation back to the system of record.' ;
    rdfs:domain ind:MeterPremise ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meterProgramEnrollmentId rdf:type rdf:Property ;
    rdfs:label 'Meter Program Enrollment Id' ;
    rdfs:comment 'Unique identifier for the meter program enrollment record. Primary key for this entity. Represents a single instance of a meter being enrolled in a utility program requiring specific metering configuration or data collection.' ;
    rdfs:domain ind:MeterProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cisProgramReference rdf:type rdf:Property ;
    rdfs:label 'Cis Program Reference' ;
    rdfs:comment 'External reference identifier linking this metering-domain enrollment to the corresponding customer-level program participation record in the CIS (Oracle CC&B or SAP IS-U). Supports coordination between metering configuration and billing rate application.' ;
    rdfs:domain ind:MeterProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceFlag rdf:type rdf:Property ;
    rdfs:label 'Compliance Flag' ;
    rdfs:comment 'Boolean flag indicating whether the meter and customer are in compliance with program requirements. False indicates non-compliance issues such as missing data, configuration errors, or customer behavior violations.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataCollectionRequirement rdf:type rdf:Property ;
    rdfs:label 'Data Collection Requirement' ;
    rdfs:comment 'Level of data collection required for this program enrollment. Standard indicates normal AMI interval reads; Enhanced indicates additional channels or higher frequency; Real-time indicates continuous streaming; On-demand indicates event-triggered collection.' ;
    rdfs:domain ind:MeterProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:demandThresholdKw rdf:type rdf:Property ;
    rdfs:label 'Demand Threshold Kw' ;
    rdfs:comment 'Demand threshold in kilowatts (kW) that triggers program-specific actions or billing. Used in demand response and critical peak pricing programs to define curtailment or penalty thresholds.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:enrollmentActivationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Enrollment Activation Timestamp' ;
    rdfs:comment 'Precise timestamp when the meter configuration changes were applied and the enrollment became operationally active in the MDMS (Meter Data Management System). Records the actual system activation event.' ;
    rdfs:domain ind:MeterProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:enrollmentApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Enrollment Approval Date' ;
    rdfs:comment 'Date when the program enrollment was approved by utility operations or automated validation. Applicable for programs requiring eligibility verification or technical feasibility review.' ;
    rdfs:domain ind:MeterProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:enrollmentChannel rdf:type rdf:Property ;
    rdfs:label 'Enrollment Channel' ;
    rdfs:comment 'Channel or interface through which the enrollment was initiated. Distinguishes self-service digital enrollments from assisted or batch enrollments.' ;
    rdfs:domain ind:MeterProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enrollmentEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Enrollment Effective Date' ;
    rdfs:comment 'Date when the meter program enrollment becomes active and the meter configuration changes take effect. Determines when program-specific data collection and rate application begin.' ;
    rdfs:domain ind:MeterProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:enrollmentEndDate rdf:type rdf:Property ;
    rdfs:label 'Enrollment End Date' ;
    rdfs:comment 'Date when the meter program enrollment ends or is scheduled to end. Nullable for open-ended enrollments. Determines when program-specific meter configuration and data collection cease.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:enrollmentRequestDate rdf:type rdf:Property ;
    rdfs:label 'Enrollment Request Date' ;
    rdfs:comment 'Date when the program enrollment was requested or initiated. May differ from enrollment_effective_date due to processing time, approval workflows, or scheduled future start dates.' ;
    rdfs:domain ind:MeterProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:enrollmentSource rdf:type rdf:Property ;
    rdfs:label 'Enrollment Source' ;
    rdfs:comment 'Origin or trigger of the meter program enrollment. Customer request indicates opt-in; Utility initiative indicates utility-driven enrollment; Regulatory mandate indicates compliance-driven; Automatic enrollment indicates default assignment; Pilot program indicates test/trial participation.' ;
    rdfs:domain ind:MeterProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exportChannelEnabledFlag rdf:type rdf:Property ;
    rdfs:label 'Export Channel Enabled Flag' ;
    rdfs:comment 'Boolean flag indicating whether the meter export channel (reverse energy flow measurement) is activated for this enrollment. True for NEM (Net Energy Metering) and DER (Distributed Energy Resource) programs where customer generation is measured.' ;
    rdfs:domain ind:MeterProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:incentivePaymentStatus rdf:type rdf:Property ;
    rdfs:label 'Incentive Payment Status' ;
    rdfs:comment 'Status of the program incentive payment associated with this enrollment. Tracks the lifecycle of incentive disbursement from eligibility determination through payment completion.' ;
    rdfs:domain ind:MeterProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:intervalCollectionFrequencyMinutes rdf:type rdf:Property ;
    rdfs:label 'Interval Collection Frequency Minutes' ;
    rdfs:comment 'Frequency in minutes at which interval meter data is collected for this program enrollment. Common values include 15, 30, or 60 minutes. Defines the granularity of energy consumption data required by the program.' ;
    rdfs:domain ind:MeterProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastComplianceCheckDate rdf:type rdf:Property ;
    rdfs:label 'Last Compliance Check Date' ;
    rdfs:comment 'Date of the most recent compliance validation check for this enrollment. Used to track periodic audits of program participation requirements and meter data quality.' ;
    rdfs:domain ind:MeterProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mdmsEnrollmentReference rdf:type rdf:Property ;
    rdfs:label 'Mdms Enrollment Reference' ;
    rdfs:comment 'External reference identifier for this enrollment in the source MDMS (Oracle Utilities MDMS or Itron Analytics). Enables cross-system reconciliation and audit trail back to the operational system of record.' ;
    rdfs:domain ind:MeterProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meterConfigurationProfile rdf:type rdf:Property ;
    rdfs:label 'Meter Configuration Profile' ;
    rdfs:comment 'Identifier or description of the meter configuration profile applied for this program enrollment. Defines register mappings, channel activations, TOU bin assignments, and other meter firmware settings required by the program.' ;
    rdfs:domain ind:MeterProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programIncentiveAmount rdf:type rdf:Property ;
    rdfs:label 'Program Incentive Amount' ;
    rdfs:comment 'Monetary incentive amount in USD associated with this program enrollment. Applicable for DR, EE, and EV programs that offer enrollment bonuses, rebates, or participation payments. Null for rate-only programs.' ;
    rdfs:domain ind:MeterProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:terminationReasonCode rdf:type rdf:Property ;
    rdfs:label 'Termination Reason Code' ;
    rdfs:comment 'Standardized code indicating the reason for enrollment termination. Customer request indicates opt-out; Program ended indicates utility discontinued program; Non-compliance indicates customer failed to meet program requirements; Meter removed indicates physical meter change; Account closed or Moved out indicate service discontinuation.' ;
    rdfs:domain ind:MeterProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:terminationReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Termination Reason Description' ;
    rdfs:comment 'Free-text description providing additional context or details about the enrollment termination. Supplements the termination_reason_code with case-specific information.' ;
    rdfs:domain ind:MeterProgramEnrollment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meterTestId rdf:type rdf:Property ;
    rdfs:label 'Meter Test Id' ;
    rdfs:comment 'Unique identifier for the meter test record. Primary key for the meter test transaction.' ;
    rdfs:domain ind:MeterTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:asFoundAccuracyPercent rdf:type rdf:Property ;
    rdfs:label 'As Found Accuracy Percent' ;
    rdfs:comment 'Percentage error of the meter at the start of the test, before any adjustments or calibration. Represents the meters accuracy in its as-installed or as-received condition. Positive values indicate the meter is reading high (over-registration); negative values indicate the meter is reading low (under-registration).' ;
    rdfs:domain ind:MeterTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:asLeftAccuracyPercent rdf:type rdf:Property ;
    rdfs:label 'As Left Accuracy Percent' ;
    rdfs:comment 'Percentage error of the meter at the conclusion of the test, after any adjustments or calibration. Represents the meters accuracy in its final state before being returned to service or condemned. Positive values indicate over-registration; negative values indicate under-registration.' ;
    rdfs:domain ind:MeterTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:complianceCycleCode rdf:type rdf:Property ;
    rdfs:label 'Compliance Cycle Code' ;
    rdfs:comment 'Identifier of the regulatory compliance testing cycle or program under which this test was conducted. Used to group tests for regulatory reporting to PUCs and to track compliance with mandated testing frequencies.' ;
    rdfs:domain ind:MeterTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:demandRegisterAccuracyPercent rdf:type rdf:Property ;
    rdfs:label 'Demand Register Accuracy Percent' ;
    rdfs:comment 'Percentage error of the demand register, which measures peak kilowatt (kW) or megawatt (MW) consumption over defined intervals. Critical for commercial and industrial customers billed on demand charges.' ;
    rdfs:domain ind:MeterTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fullLoadAccuracyPercent rdf:type rdf:Property ;
    rdfs:label 'Full Load Accuracy Percent' ;
    rdfs:comment 'Percentage error measured at full rated load (100% of meter capacity). Critical accuracy test point for validating meter performance under maximum demand conditions.' ;
    rdfs:domain ind:MeterTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lightLoadAccuracyPercent rdf:type rdf:Property ;
    rdfs:label 'Light Load Accuracy Percent' ;
    rdfs:comment 'Percentage error measured at light load (typically 10% of meter capacity). Critical accuracy test point for validating meter performance under low consumption conditions, which is common in residential applications.' ;
    rdfs:domain ind:MeterTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:powerFactorTestResult rdf:type rdf:Property ;
    rdfs:label 'Power Factor Test Result' ;
    rdfs:comment 'Result of the power factor accuracy test for electric meters. Validates that the meter accurately measures energy under varying power factor conditions (lagging and leading). Not applicable for gas meters.' ;
    rdfs:domain ind:MeterTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:technicianCode rdf:type rdf:Property ;
    rdfs:label 'Technician Code' ;
    rdfs:comment 'Identifier of the technician or engineer who performed the meter test. Used for quality assurance, training evaluation, and audit traceability.' ;
    rdfs:domain ind:MeterTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testCurrentAmperes rdf:type rdf:Property ;
    rdfs:label 'Test Current Amperes' ;
    rdfs:comment 'Current level (in amperes) at which the electric meter test was conducted. Used to calculate load percentage relative to meter rating. Not applicable for gas meters.' ;
    rdfs:domain ind:MeterTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:testDate rdf:type rdf:Property ;
    rdfs:label 'Test Date' ;
    rdfs:comment 'The calendar date on which the meter test was performed. Principal business event timestamp for the test transaction.' ;
    rdfs:domain ind:MeterTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:testDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Test Duration Minutes' ;
    rdfs:comment 'Total elapsed time in minutes from test start to test completion. Used for labor cost allocation, productivity analysis, and scheduling optimization.' ;
    rdfs:domain ind:MeterTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:testFacilityCode rdf:type rdf:Property ;
    rdfs:label 'Test Facility Code' ;
    rdfs:comment 'Identifier of the specific testing facility, laboratory, or service center where the test was conducted. Used for traceability and quality assurance.' ;
    rdfs:domain ind:MeterTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testFlowRate rdf:type rdf:Property ;
    rdfs:label 'Test Flow Rate' ;
    rdfs:comment 'Gas flow rate (typically in cubic feet per hour or cubic meters per hour) at which the gas meter test was conducted. Used to calculate load percentage relative to meter capacity. Not applicable for electric meters.' ;
    rdfs:domain ind:MeterTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:testHumidityPercent rdf:type rdf:Property ;
    rdfs:label 'Test Humidity Percent' ;
    rdfs:comment 'Relative humidity percentage during the test. Humidity can affect electronic meter components and is recorded to validate test conditions were within acceptable ranges.' ;
    rdfs:domain ind:MeterTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:testLocation rdf:type rdf:Property ;
    rdfs:label 'Test Location' ;
    rdfs:comment 'Physical location category where the test was performed. Field tests occur at the installed service point; laboratory and shop tests occur in controlled testing facilities; customer-premise tests are conducted on-site during service calls; warehouse tests validate inventory before distribution.' ;
    rdfs:domain ind:MeterTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testNotes rdf:type rdf:Property ;
    rdfs:label 'Test Notes' ;
    rdfs:comment 'Free-text field for technician observations, anomalies, special conditions, or additional context about the test. May include details about physical meter condition, environmental factors, or deviations from standard test procedures.' ;
    rdfs:domain ind:MeterTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testNumber rdf:type rdf:Property ;
    rdfs:label 'Test Number' ;
    rdfs:comment 'Business identifier for the test event. Externally-known unique test reference number assigned by the testing system or laboratory.' ;
    rdfs:domain ind:MeterTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testResult rdf:type rdf:Property ;
    rdfs:label 'Test Result' ;
    rdfs:comment 'Overall outcome of the meter test. Pass indicates the meter met all accuracy and performance criteria; fail indicates the meter did not meet standards and requires corrective action; adjusted indicates the meter was recalibrated during testing and now meets standards; conditional indicates the meter passed with minor observations or limitations.' ;
    rdfs:domain ind:MeterTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testStandardApplied rdf:type rdf:Property ;
    rdfs:label 'Test Standard Applied' ;
    rdfs:comment 'The industry or regulatory standard used as the basis for the test procedure and acceptance criteria. Common standards include ANSI C12.20 for North American electric meter accuracy classes, IEC 62052-11 and IEC 62053-series for international electric meter compliance, and AGA Report No. 7 for gas meter accuracy.' ;
    rdfs:domain ind:MeterTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testStatus rdf:type rdf:Property ;
    rdfs:label 'Test Status' ;
    rdfs:comment 'Current lifecycle state of the test transaction. Tracks the test workflow from scheduling through completion or cancellation.' ;
    rdfs:domain ind:MeterTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testTemperature rdf:type rdf:Property ;
    rdfs:label 'Test Temperature' ;
    rdfs:comment 'Ambient temperature (in degrees Celsius or Fahrenheit) during the test. Temperature can affect meter accuracy and is recorded for quality assurance and to validate test conditions were within acceptable ranges.' ;
    rdfs:domain ind:MeterTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:testTimestamp rdf:type rdf:Property ;
    rdfs:label 'Test Timestamp' ;
    rdfs:comment 'Precise date and time when the meter test was conducted. Provides granular event timing for audit and sequencing purposes.' ;
    rdfs:domain ind:MeterTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:testType rdf:type rdf:Property ;
    rdfs:label 'Test Type' ;
    rdfs:comment 'Classification of the test based on the business trigger and context. In-service tests are conducted on meters while installed at customer premises; shop tests are performed in a controlled laboratory environment; acceptance tests validate new meter inventory before deployment; complaint-driven tests respond to customer billing disputes; periodic tests fulfill regulatory compliance schedules; calibration tests adjust meter accuracy to standard.' ;
    rdfs:domain ind:MeterTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testVoltage rdf:type rdf:Property ;
    rdfs:label 'Test Voltage' ;
    rdfs:comment 'Voltage level (in volts) at which the electric meter test was conducted. Must match the meters rated voltage for valid test results. Not applicable for gas meters.' ;
    rdfs:domain ind:MeterTest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:replacementCycleReadCycleId rdf:type rdf:Property ;
    rdfs:label 'Replacement Cycle Read Cycle Id' ;
    rdfs:comment 'Reference to the successor reading cycle that replaced this cycle when it was retired. Used to track cycle evolution and support meter reassignment during cycle consolidation or restructuring.' ;
    rdfs:domain ind:ReadCycle ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ReadCycle .

ind:amiCollectionWindowEnd rdf:type rdf:Property ;
    rdfs:label 'Ami Collection Window End' ;
    rdfs:comment 'Timestamp marking the end of the automated interval data collection window for AMI smart meters. Collection jobs must complete before this time to allow VEE processing and billing cycle close.' ;
    rdfs:domain ind:ReadCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:amiCollectionWindowStart rdf:type rdf:Property ;
    rdfs:label 'Ami Collection Window Start' ;
    rdfs:comment 'Timestamp marking the beginning of the automated interval data collection window for AMI smart meters assigned to this cycle. Typically set to midnight or early morning hours to minimize network load.' ;
    rdfs:domain ind:ReadCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:billingCycleAlignment rdf:type rdf:Property ;
    rdfs:label 'Billing Cycle Alignment' ;
    rdfs:comment 'Indicates whether this read cycle is synchronized with billing cycle processing. Aligned cycles trigger billing immediately after reads; offset cycles allow time for validation; independent cycles are not tied to billing.' ;
    rdfs:domain ind:ReadCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:billingCycleDayOffset rdf:type rdf:Property ;
    rdfs:label 'Billing Cycle Day Offset' ;
    rdfs:comment 'Number of days between the scheduled read day and the billing cycle close date. Allows time for meter data validation, estimation, and editing (VEE) before invoices are generated. Typically 1-5 days for monthly cycles.' ;
    rdfs:domain ind:ReadCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:collectionMethod rdf:type rdf:Property ;
    rdfs:label 'Collection Method' ;
    rdfs:comment 'Primary method used to collect meter reads for this cycle. AMI automated uses smart meter network; AMR drive-by uses mobile collection units; manual methods require field personnel.' ;
    rdfs:domain ind:ReadCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cycleType rdf:type rdf:Property ;
    rdfs:label 'Cycle Type' ;
    rdfs:comment 'Classification of the reading cycle purpose. Billing cycles drive invoice generation; operational cycles support grid monitoring; on-demand cycles handle ad-hoc requests; special cycles support events like meter exchanges or audits.' ;
    rdfs:domain ind:ReadCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:demandResponseEligible rdf:type rdf:Property ;
    rdfs:label 'Demand Response Eligible' ;
    rdfs:comment 'Indicates whether meters in this cycle are eligible for Demand Response (DR) programs and curtailment events. True for AMI cycles with 15-minute or hourly interval collection supporting peak shaving and load management.' ;
    rdfs:domain ind:ReadCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:estimatedMeterCount rdf:type rdf:Property ;
    rdfs:label 'Estimated Meter Count' ;
    rdfs:comment 'Approximate number of meters assigned to this reading cycle. Used for workforce planning, collection job sizing, and performance monitoring. Updated periodically as meters are added or removed from the cycle.' ;
    rdfs:domain ind:ReadCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:geographicZoneCode rdf:type rdf:Property ;
    rdfs:label 'Geographic Zone Code' ;
    rdfs:comment 'Code identifying the geographic service territory, district, or region to which this cycle applies. Used to group cycles by operational area and align with distribution system topology.' ;
    rdfs:domain ind:ReadCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readCycleStatus rdf:type rdf:Property ;
    rdfs:label 'Read Cycle Status' ;
    rdfs:comment 'Current operational status of the reading cycle. Active cycles are in use for scheduling and collection; inactive cycles are temporarily disabled; suspended cycles are on hold pending review; archived cycles are retained for historical reference only.' ;
    rdfs:domain ind:ReadCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readFrequency rdf:type rdf:Property ;
    rdfs:label 'Read Frequency' ;
    rdfs:comment 'Scheduled frequency at which meters assigned to this cycle are read. Monthly is standard for residential billing; daily for AMI interval collection; bi-monthly for certain gas customers; on-demand for special reads. [ENUM-REF-CANDIDATE: daily|weekly|bi_weekly|monthly|bi_monthly|quarterly|on_demand — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:ReadCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryReportingFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reporting Flag' ;
    rdfs:comment 'Indicates whether reads from this cycle are included in regulatory reports submitted to state Public Utility Commissions (PUCs) or FERC. True for billing cycles used in rate case cost studies and revenue reporting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:routeSequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Route Sequence Number' ;
    rdfs:comment 'Numeric ordering of this cycle within a geographic route grouping. Used to optimize meter reader travel paths and schedule field workforce. Null for AMI-only cycles that do not require manual reading.' ;
    rdfs:domain ind:ReadCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:scheduledReadDay rdf:type rdf:Property ;
    rdfs:label 'Scheduled Read Day' ;
    rdfs:comment 'Target day of the month (1-31) when meters in this cycle should be read. Used for monthly and bi-monthly cycles to schedule meter reader routes and AMI collection jobs. Null for daily or on-demand cycles.' ;
    rdfs:domain ind:ReadCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:targetReadCompletionHours rdf:type rdf:Property ;
    rdfs:label 'Target Read Completion Hours' ;
    rdfs:comment 'Target number of hours within which all meters in this cycle should be read after the scheduled read day. Used to measure field workforce productivity and AMI collection performance. Typically 24-48 hours for monthly cycles.' ;
    rdfs:domain ind:ReadCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:timeOfUseEnabled rdf:type rdf:Property ;
    rdfs:label 'Time Of Use Enabled' ;
    rdfs:comment 'Indicates whether this cycle collects interval data for Time-of-Use (TOU) rate application. True for AMI cycles serving customers on TOU tariffs; false for standard monthly register read cycles.' ;
    rdfs:domain ind:ReadCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:veeProcessingRequired rdf:type rdf:Property ;
    rdfs:label 'Vee Processing Required' ;
    rdfs:comment 'Indicates whether meter reads collected in this cycle must undergo automated validation, estimation, and editing (VEE) processing before being released to billing. True for billing cycles; may be false for operational monitoring cycles.' ;
    rdfs:domain ind:ReadCycle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:registerReadId rdf:type rdf:Property ;
    rdfs:label 'Register Read Id' ;
    rdfs:comment 'Unique identifier for the register read record. Primary key for the register read transaction.' ;
    rdfs:domain ind:RegisterRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:consumptionDelta rdf:type rdf:Property ;
    rdfs:label 'Consumption Delta' ;
    rdfs:comment 'The difference between the current consumption value and the previous consumption value, representing the energy or volume consumed during the read period. This is the primary input to billing calculations.' ;
    rdfs:domain ind:RegisterRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:demandResetDate rdf:type rdf:Property ;
    rdfs:label 'Demand Reset Date' ;
    rdfs:comment 'The date on which the demand register was last reset to zero. Applicable only to demand registers (kW, MW) that track peak demand within a billing period. Null for energy registers.' ;
    rdfs:domain ind:RegisterRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dialCount rdf:type rdf:Property ;
    rdfs:label 'Dial Count' ;
    rdfs:comment 'The number of dials or digits on the meter register. Used for validation of register rollover events and maximum register capacity calculations.' ;
    rdfs:domain ind:RegisterRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pressureCompensationFactor rdf:type rdf:Property ;
    rdfs:label 'Pressure Compensation Factor' ;
    rdfs:comment 'Adjustment factor applied to gas volume reads to normalize for pressure variations. Gas volume varies with pressure; this factor converts measured volume to standard pressure conditions. Null for electric meters.' ;
    rdfs:domain ind:RegisterRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:previousReadDate rdf:type rdf:Property ;
    rdfs:label 'Previous Read Date' ;
    rdfs:comment 'The date of the immediately preceding read event for this register. Used to determine the consumption period length.' ;
    rdfs:domain ind:RegisterRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:previousReadValue rdf:type rdf:Property ;
    rdfs:label 'Previous Read Value' ;
    rdfs:comment 'The raw register value from the immediately preceding read event for this register. Used to calculate consumption delta between reads.' ;
    rdfs:domain ind:RegisterRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rawRegisterValue rdf:type rdf:Property ;
    rdfs:label 'Raw Register Value' ;
    rdfs:comment 'The cumulative scalar value displayed on the meter register dial at the time of read, before any multiplier or conversion is applied. This is the raw odometer-style reading from the meter.' ;
    rdfs:domain ind:RegisterRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:readByUserCode rdf:type rdf:Property ;
    rdfs:label 'Read By User Code' ;
    rdfs:comment 'Identifier of the field technician, system user, or automated process that captured or entered this read. Used for audit trail and quality assurance.' ;
    rdfs:domain ind:RegisterRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readDate rdf:type rdf:Property ;
    rdfs:label 'Read Date' ;
    rdfs:comment 'The calendar date on which the meter register was read. Used for billing cycle alignment and consumption period determination.' ;
    rdfs:domain ind:RegisterRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:readMethod rdf:type rdf:Property ;
    rdfs:label 'Read Method' ;
    rdfs:comment 'The method by which the register read was obtained. AMI (Advanced Metering Infrastructure) indicates automated remote read via two-way communication; AMR (Automated Meter Reading) indicates one-way automated read; manual indicates field technician read; estimated indicates calculated value when actual read unavailable; customer-provided indicates self-reported read.' ;
    rdfs:domain ind:RegisterRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readNote rdf:type rdf:Property ;
    rdfs:label 'Read Note' ;
    rdfs:comment 'Free-text field for field technician or system comments regarding read exceptions, site conditions, or data quality issues. Examples include inaccessible meter, customer refused entry, meter damaged, or unusual consumption pattern.' ;
    rdfs:domain ind:RegisterRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Read Source System' ;
    rdfs:comment 'The operational system from which this read record originated. MDMS (Meter Data Management System) for processed reads; CIS (Customer Information System) for billing-cycle reads; AMI-Head-End for direct AMI network reads; Field-Device for handheld meter reader uploads; Manual-Entry for exception handling.' ;
    rdfs:domain ind:RegisterRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readStatus rdf:type rdf:Property ;
    rdfs:label 'Read Status' ;
    rdfs:comment 'Current lifecycle status of the read record in the validation-estimation-editing (VEE) workflow. Valid indicates passed all validation rules; pending-validation indicates awaiting VEE processing; failed-validation indicates rule violations detected; corrected indicates manual adjustment applied; voided indicates read superseded or cancelled.' ;
    rdfs:domain ind:RegisterRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:readTimestamp rdf:type rdf:Property ;
    rdfs:label 'Read Timestamp' ;
    rdfs:comment 'The precise date and time when the meter register read was captured. Critical for interval boundary alignment and time-of-use rate application.' ;
    rdfs:domain ind:RegisterRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:readType rdf:type rdf:Property ;
    rdfs:label 'Read Type' ;
    rdfs:comment 'Classification of the read event purpose. Scheduled reads occur at regular billing cycles; on-demand reads are requested for specific business needs; move-in/move-out reads support customer transitions; special reads address exceptions or investigations. [ENUM-REF-CANDIDATE: scheduled|on-demand|move-in|move-out|special|final|initial|investigative — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:RegisterRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rolloverFlag rdf:type rdf:Property ;
    rdfs:label 'Rollover Flag' ;
    rdfs:comment 'Indicates whether the meter register rolled over (returned to zero after reaching maximum capacity) during this read period. True when rollover detected; false otherwise. Critical for accurate consumption calculation.' ;
    rdfs:domain ind:RegisterRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:temperatureCompensationFactor rdf:type rdf:Property ;
    rdfs:label 'Temperature Compensation Factor' ;
    rdfs:comment 'Adjustment factor applied to gas volume reads to normalize for temperature variations. Gas volume expands and contracts with temperature; this factor converts measured volume to standard conditions (typically 60°F or 15°C). Null for electric meters.' ;
    rdfs:domain ind:RegisterRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:validationRuleFailures rdf:type rdf:Property ;
    rdfs:label 'Validation Rule Failures' ;
    rdfs:comment 'Comma-separated list of validation rule codes that this read failed during VEE processing. Examples include high-usage, negative-consumption, zero-consumption, out-of-range, or meter-stopped. Empty when all validation rules passed.' ;
    rdfs:domain ind:RegisterRead ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remoteServiceActionId rdf:type rdf:Property ;
    rdfs:label 'Remote Service Action Id' ;
    rdfs:comment 'Unique identifier for the remote service action record. Primary key for this transactional log of remote commands issued to Advanced Metering Infrastructure (AMI) capable meters.' ;
    rdfs:domain ind:RemoteServiceAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actionSubtype rdf:type rdf:Property ;
    rdfs:label 'Action Subtype' ;
    rdfs:comment 'Detailed subtype or variant of the remote action, providing additional granularity beyond the primary action type. For example, disconnect may have subtypes such as non-payment, safety, or emergency.' ;
    rdfs:domain ind:RemoteServiceAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionType rdf:type rdf:Property ;
    rdfs:label 'Action Type' ;
    rdfs:comment 'Type of remote service action commanded to the meter. Connect and disconnect support billing collections and safety workflows; load limit enables demand response; on-demand read supports billing validation; firmware update maintains device security and functionality. [ENUM-REF-CANDIDATE: connect|disconnect|load_limit|ping|on_demand_read|firmware_update|time_sync|configuration_change — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:RemoteServiceAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commandNumber rdf:type rdf:Property ;
    rdfs:label 'Command Number' ;
    rdfs:comment 'Business-facing reference number or tracking identifier for the remote service action command, used for customer service inquiries and audit trails.' ;
    rdfs:domain ind:RemoteServiceAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commandTimestamp rdf:type rdf:Property ;
    rdfs:label 'Command Timestamp' ;
    rdfs:comment 'Date and time when the remote service action command was issued by the head-end system or Meter Data Management System (MDMS) to the meter endpoint. Represents the business event time of command initiation.' ;
    rdfs:domain ind:RemoteServiceAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:completionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Completion Timestamp' ;
    rdfs:comment 'Date and time when the remote service action workflow was fully completed, including all confirmations, callbacks, and downstream system updates. Represents the end of the action lifecycle.' ;
    rdfs:domain ind:RemoteServiceAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:configurationProfile rdf:type rdf:Property ;
    rdfs:label 'Configuration Profile' ;
    rdfs:comment 'Name or identifier of the configuration profile or parameter set applied to the meter when the action type is configuration change. Null for non-configuration actions.' ;
    rdfs:domain ind:RemoteServiceAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:executionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Execution Timestamp' ;
    rdfs:comment 'Date and time when the meter endpoint confirmed successful execution of the remote service action. Null if the action has not yet executed or failed before execution.' ;
    rdfs:domain ind:RemoteServiceAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:failureReasonCode rdf:type rdf:Property ;
    rdfs:label 'Failure Reason Code' ;
    rdfs:comment 'Standardized code indicating the reason for command failure, if applicable. Examples include communication failure, meter offline, command rejected by meter, invalid command parameters, or security authentication failure. Null if the action succeeded.' ;
    rdfs:domain ind:RemoteServiceAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failureReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Failure Reason Description' ;
    rdfs:comment 'Human-readable description of the failure reason, providing additional context beyond the failure reason code. Used for troubleshooting and customer service inquiries.' ;
    rdfs:domain ind:RemoteServiceAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:initiatingProcess rdf:type rdf:Property ;
    rdfs:label 'Initiating Process' ;
    rdfs:comment 'Name or identifier of the automated business process, workflow, or batch job that triggered the remote service action. Populated when the action was system-initiated rather than user-initiated.' ;
    rdfs:domain ind:RemoteServiceAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:initiatingSystem rdf:type rdf:Property ;
    rdfs:label 'Initiating System' ;
    rdfs:comment 'Source system or application that originated the remote service action request. Customer Information System (CIS) for account-driven actions, Outage Management System (OMS) for restoration, Demand Response Management System (DRMS) for load control, or manual for operator-initiated commands. [ENUM-REF-CANDIDATE: cis|billing|field_ops|oms|mdms|drms|manual — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:RemoteServiceAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:initiatingUser rdf:type rdf:Property ;
    rdfs:label 'Initiating User' ;
    rdfs:comment 'Username or employee identifier of the person who authorized or triggered the remote service action. Null if the action was triggered by an automated process or system rule.' ;
    rdfs:domain ind:RemoteServiceAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loadLimitDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Load Limit Duration Minutes' ;
    rdfs:comment 'Duration in minutes for which the load limit is to remain in effect. Null if the load limit is indefinite or the action type is not load limit.' ;
    rdfs:domain ind:RemoteServiceAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:loadLimitKw rdf:type rdf:Property ;
    rdfs:label 'Load Limit Kw' ;
    rdfs:comment 'Maximum power demand limit in kilowatts (kW) applied to the meter when the action type is load limit. Used for demand response programs and customer payment plan enforcement. Null for non-load-limit actions.' ;
    rdfs:domain ind:RemoteServiceAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:moratoriumOverrideReason rdf:type rdf:Property ;
    rdfs:label 'Moratorium Override Reason' ;
    rdfs:comment 'Justification or authorization code for overriding a disconnection moratorium or regulatory protection when executing a disconnect action. Required for audit and regulatory reporting when regulatory compliance flag is true.' ;
    rdfs:domain ind:RemoteServiceAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Notification Timestamp' ;
    rdfs:comment 'Date and time when the customer notification was sent. Null if no notification was sent or required.' ;
    rdfs:domain ind:RemoteServiceAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:responseTimeSeconds rdf:type rdf:Property ;
    rdfs:label 'Response Time Seconds' ;
    rdfs:comment 'Elapsed time in seconds between command transmission and receipt of acknowledgment or execution confirmation from the meter endpoint. Used to measure network and meter performance.' ;
    rdfs:domain ind:RemoteServiceAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:resultStatus rdf:type rdf:Property ;
    rdfs:label 'Result Status' ;
    rdfs:comment 'Outcome status of the remote service action command. Success indicates the meter executed the command as requested; failed indicates the command could not be executed; pending indicates the command is queued or in progress; timeout indicates no response was received within the expected window; cancelled indicates the command was aborted before execution.' ;
    rdfs:domain ind:RemoteServiceAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retryCount rdf:type rdf:Property ;
    rdfs:label 'Retry Count' ;
    rdfs:comment 'Number of times the head-end system attempted to execute the remote service action command after initial failure. Used to track communication reliability and meter responsiveness.' ;
    rdfs:domain ind:RemoteServiceAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:scheduledExecutionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Scheduled Execution Timestamp' ;
    rdfs:comment 'Date and time when the remote action was scheduled to execute at the meter. May differ from command timestamp if the action was queued for future execution. Null if the action was intended for immediate execution.' ;
    rdfs:domain ind:RemoteServiceAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:veeEventId rdf:type rdf:Property ;
    rdfs:label 'Vee Event Id' ;
    rdfs:comment 'Unique identifier for the VEE event record. Primary key for the VEE event transaction.' ;
    rdfs:domain ind:VeeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fieldInvestigationWorkOrderId rdf:type rdf:Property ;
    rdfs:label 'Field Investigation Work Order Id' ;
    rdfs:comment 'Foreign key linking to asset.work_order. Business justification: VEE exceptions with high variance or persistent validation failures trigger field investigations requiring formal work orders for meter testing, seal inspection, or CT/PT verification. Critical for da' ;
    rdfs:domain ind:VeeEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WorkOrder .

ind:analystOverrideFlag rdf:type rdf:Property ;
    rdfs:label 'Analyst Override Flag' ;
    rdfs:comment 'Boolean flag indicating whether a human analyst manually overrode the automated VEE processing result.' ;
    rdfs:domain ind:VeeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:billingImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Billing Impact Flag' ;
    rdfs:comment 'Boolean flag indicating whether this VEE event resulted in a change to billable consumption or demand data.' ;
    rdfs:domain ind:VeeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:correctedValue rdf:type rdf:Property ;
    rdfs:label 'Corrected Value' ;
    rdfs:comment 'Corrected or estimated value after VEE processing. This is the value used for billing and reporting.' ;
    rdfs:domain ind:VeeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimationConfidenceScore rdf:type rdf:Property ;
    rdfs:label 'Estimation Confidence Score' ;
    rdfs:comment 'Confidence score (0-100) indicating the reliability of the estimated value based on the estimation method and available data quality.' ;
    rdfs:domain ind:VeeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:measurementType rdf:type rdf:Property ;
    rdfs:label 'Measurement Type' ;
    rdfs:comment 'Type of measurement affected by the VEE event (e.g., consumption, demand, voltage, power factor).' ;
    rdfs:domain ind:VeeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originalRawValue rdf:type rdf:Property ;
    rdfs:label 'Original Raw Value' ;
    rdfs:comment 'Original raw meter read value before VEE processing was applied. Null if no read was received.' ;
    rdfs:domain ind:VeeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overrideAnalystCode rdf:type rdf:Property ;
    rdfs:label 'Override Analyst Code' ;
    rdfs:comment 'User ID or employee identifier of the analyst who performed the manual override.' ;
    rdfs:domain ind:VeeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overrideJustification rdf:type rdf:Property ;
    rdfs:label 'Override Justification' ;
    rdfs:comment 'Free-text justification provided by the analyst for manually overriding the automated VEE result. Required when analyst_override_flag is true.' ;
    rdfs:domain ind:VeeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overrideTimestamp rdf:type rdf:Property ;
    rdfs:label 'Override Timestamp' ;
    rdfs:comment 'Timestamp when the analyst override was applied.' ;
    rdfs:domain ind:VeeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:readEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Read End Timestamp' ;
    rdfs:comment 'End timestamp of the interval or register read period affected by the VEE event.' ;
    rdfs:domain ind:VeeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:readStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Read Start Timestamp' ;
    rdfs:comment 'Start timestamp of the interval or register read period affected by the VEE event.' ;
    rdfs:domain ind:VeeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:validationExceptionCode rdf:type rdf:Property ;
    rdfs:label 'Validation Exception Code' ;
    rdfs:comment 'Code identifying the specific validation exception or data quality issue detected (e.g., spike, dropout, missing, negative, sum-check-fail, high-limit, low-limit).' ;
    rdfs:domain ind:VeeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationExceptionDescription rdf:type rdf:Property ;
    rdfs:label 'Validation Exception Description' ;
    rdfs:comment 'Detailed description of the validation exception or data quality issue that triggered the VEE event.' ;
    rdfs:domain ind:VeeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:varianceAmount rdf:type rdf:Property ;
    rdfs:label 'Variance Amount' ;
    rdfs:comment 'Absolute difference between the original raw value and the corrected value (corrected_value - original_raw_value).' ;
    rdfs:domain ind:VeeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:variancePercentage rdf:type rdf:Property ;
    rdfs:label 'Variance Percentage' ;
    rdfs:comment 'Percentage variance between the original raw value and the corrected value, calculated as (variance_amount / original_raw_value) * 100.' ;
    rdfs:domain ind:VeeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:veeBatchReference rdf:type rdf:Property ;
    rdfs:label 'Vee Batch Reference' ;
    rdfs:comment 'Identifier of the VEE processing batch or job that generated this event, used for grouping and audit trail.' ;
    rdfs:domain ind:VeeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:veeEventNumber rdf:type rdf:Property ;
    rdfs:label 'Vee Event Number' ;
    rdfs:comment 'Business-facing unique identifier or reference number for the VEE event, used for audit trail and regulatory reporting.' ;
    rdfs:domain ind:VeeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:veeProcessingTimestamp rdf:type rdf:Property ;
    rdfs:label 'Vee Processing Timestamp' ;
    rdfs:comment 'Timestamp when the VEE processing was executed and the event record was created.' ;
    rdfs:domain ind:VeeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:veeRuleDescription rdf:type rdf:Property ;
    rdfs:label 'Vee Rule Description' ;
    rdfs:comment 'Human-readable description of the VEE rule that was applied, explaining the validation or estimation logic.' ;
    rdfs:domain ind:VeeEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectiveFinancialPeriodId rdf:type rdf:Property ;
    rdfs:label 'Effective Financial Period Id' ;
    rdfs:comment 'Foreign key linking to finance.financial_period. Business justification: Commission orders with financial impacts (rate changes, refunds, penalties, regulatory asset approvals) must be recorded in specific financial periods for GAAP compliance. Regulatory accounting posts ' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinancialPeriod .

ind:appealDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Appeal Deadline Date' ;
    rdfs:comment 'The date by which any party (utility, intervenors, or regulatory staff) must file an appeal, request for rehearing, or petition for review of the commission order. Calculated from order_date per the issuing authority\'s procedural rules.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appealFiled rdf:type rdf:Property ;
    rdfs:label 'Appeal Filed' ;
    rdfs:comment 'Indicates whether an appeal, request for rehearing, or petition for judicial review has been filed against this commission order. True when an appeal has been filed; False when no appeal has been filed within the appeal period.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appealFiledDate rdf:type rdf:Property ;
    rdfs:label 'Appeal Filed Date' ;
    rdfs:comment 'The date on which an appeal, request for rehearing, or petition for judicial review was formally filed against this commission order. Null when no appeal has been filed.' ;
    rdfs:domain ind:CommissionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appealStatus rdf:type rdf:Property ;
    rdfs:label 'Appeal Status' ;
    rdfs:comment 'Current status of any appeal filed against this commission order: not_appealed (no appeal filed), pending (appeal filed and under review), upheld (appellate authority affirmed the order), reversed (appellate authority overturned the order), remanded (appellate authority returned the order for further proceedings), withdrawn (appealing party withdrew the appeal).' ;
    rdfs:domain ind:CommissionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvedRateBase rdf:type rdf:Property ;
    rdfs:label 'Approved Rate Base' ;
    rdfs:comment 'The total rate base approved by the commission in this order, expressed in U.S. dollars. Represents the net investment in utility plant and working capital on which the utility is authorized to earn a return. Null for orders not involving rate base determinations.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approvedRateChangePct rdf:type rdf:Property ;
    rdfs:label 'Approved Rate Change Pct' ;
    rdfs:comment 'The percentage change in base rates approved by the commission order relative to existing rates. Positive values indicate a rate increase; negative values indicate a rate decrease. Null for orders not involving base rate changes.' ;
    rdfs:domain ind:CommissionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approvedRevenueRequirement rdf:type rdf:Property ;
    rdfs:label 'Approved Revenue Requirement' ;
    rdfs:comment 'The total annual revenue requirement approved by the regulatory authority in this commission order, expressed in U.S. dollars. Represents the amount the utility is authorized to collect from ratepayers to recover its prudently incurred costs plus a reasonable return. Null for orders not involving revenue requirement determinations.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approvedRoePct rdf:type rdf:Property ;
    rdfs:label 'Approved Roe Pct' ;
    rdfs:comment 'The allowed Return on Equity (ROE) percentage approved by the commission in this order. Represents the authorized rate of return on the equity component of the utility\'s capital structure. Null for orders not involving ROE determinations.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:complianceDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Compliance Deadline Date' ;
    rdfs:comment 'The date by which the utility must complete all compliance actions mandated by the commission order, such as filing compliance tariffs, implementing approved rates, submitting compliance reports, or completing required infrastructure changes.' ;
    rdfs:domain ind:CommissionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:complianceFilingDate rdf:type rdf:Property ;
    rdfs:label 'Compliance Filing Date' ;
    rdfs:comment 'The date on which the utility submitted its required compliance filing to the regulatory authority in response to this commission order. Null when no compliance filing has been submitted or is not required.' ;
    rdfs:domain ind:CommissionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:complianceFilingRequired rdf:type rdf:Property ;
    rdfs:label 'Compliance Filing Required' ;
    rdfs:comment 'Indicates whether the commission order requires the utility to submit a compliance filing (e.g., compliance tariff, compliance report, or compliance plan) to the regulatory authority by the compliance_deadline_date. True when a compliance filing is mandated.' ;
    rdfs:domain ind:CommissionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:confidentialFlag rdf:type rdf:Property ;
    rdfs:label 'Confidential Flag' ;
    rdfs:comment 'Indicates whether this commission order or any of its associated documents have been designated as confidential or protected from public disclosure by the issuing regulatory authority. True when the order or supporting materials are subject to a protective order or confidentiality designation.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cpcnProjectName rdf:type rdf:Property ;
    rdfs:label 'Cpcn Project Name' ;
    rdfs:comment 'Name of the capital project or infrastructure investment for which a Certificate of Public Convenience and Necessity (CPCN) is granted or denied by this commission order. Applicable only for CPCN proceedings. Null for all other order types.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customerClassScope rdf:type rdf:Property ;
    rdfs:label 'Customer Class Scope' ;
    rdfs:comment 'The customer class or rate class to which the commission order\'s directives or approved rates apply. Values: residential, commercial, industrial, large_power, or all_classes when the order applies universally across all customer segments.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facIndicator rdf:type rdf:Property ;
    rdfs:label 'Fac Indicator' ;
    rdfs:comment 'Indicates whether this commission order involves a Fuel Adjustment Clause (FAC) or fuel cost recovery mechanism. True when the order approves, modifies, or audits FAC rates or fuel cost pass-through provisions.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ghgProgramRef rdf:type rdf:Property ;
    rdfs:label 'Ghg Program Ref' ;
    rdfs:comment 'Reference identifier for the Greenhouse Gas (GHG) or emissions compliance program associated with this commission order (e.g., EPA Clean Air Act permit number, state GHG program ID, Renewable Portfolio Standard (RPS) compliance docket reference). Null for orders not related to GHG or emissions compliance.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuingAuthority rdf:type rdf:Property ;
    rdfs:label 'Issuing Authority' ;
    rdfs:comment 'The regulatory body that issued this commission order. Identifies the jurisdictional authority: Public Utility Commission (PUC), Federal Energy Regulatory Commission (FERC), North American Electric Reliability Corporation (NERC), U.S. Environmental Protection Agency (EPA), U.S. Department of Energy (DOE), or Pipeline and Hazardous Materials Safety Administration (PHMSA).' ;
    rdfs:domain ind:CommissionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leadAttorney rdf:type rdf:Property ;
    rdfs:label 'Lead Attorney' ;
    rdfs:comment 'Name of the utility\'s lead regulatory attorney or outside counsel responsible for managing the utility\'s response to this commission order, including compliance filings, appeals, and regulatory correspondence.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nercStandardRef rdf:type rdf:Property ;
    rdfs:label 'Nerc Standard Ref' ;
    rdfs:comment 'The specific North American Electric Reliability Corporation (NERC) reliability standard identifier (e.g., FAC-001, PRC-005, CIP-007) that is the subject of this commission order. Applicable for NERC compliance and enforcement orders. Null for non-NERC proceedings.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderDate rdf:type rdf:Property ;
    rdfs:label 'Order Date' ;
    rdfs:comment 'The official date on which the regulatory authority issued and signed the commission order. This is the authoritative date of the regulatory decision and is used for compliance deadline calculations and appeal period tracking.' ;
    rdfs:domain ind:CommissionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:orderStatus rdf:type rdf:Property ;
    rdfs:label 'Order Status' ;
    rdfs:comment 'Current lifecycle status of the commission order: issued (order is in effect), appealed (utility or intervenor has filed an appeal), stayed (order execution suspended pending appeal or court action), vacated (order overturned by appellate authority), superseded (replaced by a subsequent order), closed (all compliance obligations fulfilled and order administratively closed).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderSummary rdf:type rdf:Property ;
    rdfs:label 'Order Summary' ;
    rdfs:comment 'Plain-language summary of the commission order\'s key findings, directives, and decisions. Captures the substance of the regulatory ruling including approved actions, denied requests, required compliance measures, and any conditions imposed on the utility.' ;
    rdfs:domain ind:CommissionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderType rdf:type rdf:Property ;
    rdfs:label 'Order Type' ;
    rdfs:comment 'Classification of the commission order by its legal and procedural nature: final_order (definitive ruling concluding a proceeding), interim_order (temporary ruling pending final decision), consent_order (negotiated settlement order), show_cause_order (directive requiring the utility to demonstrate compliance or justification), penalty_notice (formal notice of civil penalty or fine). [ENUM-REF-CANDIDATE: final_order|interim_order|consent_order|show_cause_order|penalty_notice|declaratory_order|compliance_order — promote to reference product]' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pbrIndicator rdf:type rdf:Property ;
    rdfs:label 'Pbr Indicator' ;
    rdfs:comment 'Indicates whether this commission order establishes, modifies, or evaluates a Performance-Based Ratemaking (PBR) mechanism. True when the order includes PBR provisions such as earnings sharing, efficiency incentives, or reliability performance metrics tied to rate adjustments.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:proceedingType rdf:type rdf:Property ;
    rdfs:label 'Proceeding Type' ;
    rdfs:comment 'Category of the regulatory proceeding that produced this order: rate_case (general rate case), cpcn (Certificate of Public Convenience and Necessity), irp (Integrated Resource Plan), tariff_filing (tariff amendment or OATT filing), nerc_compliance (NERC reliability standard compliance), ghg_compliance (Greenhouse Gas/emissions compliance), oatt (Open Access Transmission Tariff), nem (Net Energy Metering), dr_program (Demand Response program approval). [ENUM-REF-CANDIDATE: rate_case|cpcn|irp|tariff_filing|nerc_compliance|ghg_compliance|oatt|nem|dr_program|pbr|other — promote to reference product]' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:refundDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Refund Deadline Date' ;
    rdfs:comment 'The date by which the utility must complete the distribution of ordered customer refunds. Null when no refund is required by this order.' ;
    rdfs:domain ind:CommissionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryCaseManager rdf:type rdf:Property ;
    rdfs:label 'Regulatory Case Manager' ;
    rdfs:comment 'Name of the internal regulatory affairs staff member or case manager responsible for tracking compliance obligations, coordinating cross-functional responses, and maintaining the utility\'s records for this commission order.' ;
    rdfs:domain ind:CommissionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stayExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Stay Expiration Date' ;
    rdfs:comment 'The date on which a stay of the commission order expires or is lifted, after which the order\'s directives become effective. Null when no stay has been issued.' ;
    rdfs:domain ind:CommissionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:stayIssued rdf:type rdf:Property ;
    rdfs:label 'Stay Issued' ;
    rdfs:comment 'Indicates whether a stay of the commission order has been granted by the issuing authority or an appellate court, suspending the order\'s effectiveness pending resolution of an appeal or rehearing. True when a stay is in effect.' ;
    rdfs:domain ind:CommissionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tariffScheduleRef rdf:type rdf:Property ;
    rdfs:label 'Tariff Schedule Ref' ;
    rdfs:comment 'Reference to the specific tariff schedule, rate schedule, or Open Access Transmission Tariff (OATT) section that is approved, modified, or superseded by this commission order. Used to link the order to the utility\'s filed tariff documents.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceCalendarId rdf:type rdf:Property ;
    rdfs:label 'Compliance Calendar Id' ;
    rdfs:comment 'Unique identifier for each regulatory deadline, milestone, or scheduled compliance event tracked by the utility. Primary key for the compliance calendar registry.' ;
    rdfs:domain ind:ComplianceCalendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:filingId rdf:type rdf:Property ;
    rdfs:label 'Filing Id' ;
    rdfs:comment 'Foreign key linking to regulatory.filing. Business justification: Compliance calendar events track specific filing deadlines (e.g., \'File quarterly NERC compliance report by 2024-04-15\'). Each calendar event can reference the specific filing record it tracks. This c' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Filing .

ind:responsibleEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Responsible Employee Id' ;
    rdfs:comment 'Employee identifier for the individual assigned primary accountability for this compliance deadline. Links to the workforce or human capital management system.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:alertStatus rdf:type rdf:Property ;
    rdfs:label 'Alert Status' ;
    rdfs:comment 'Current state of the alert mechanism for this deadline. Indicates whether an alert has been triggered, escalated to management, or acknowledged by the responsible party.' ;
    rdfs:domain ind:ComplianceCalendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alertThresholdDays rdf:type rdf:Property ;
    rdfs:label 'Alert Threshold Days' ;
    rdfs:comment 'The number of days before the effective due date at which an alert or notification should be triggered to the responsible party and escalation contact. Configurable per deadline type and risk level.' ;
    rdfs:domain ind:ComplianceCalendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:completionDate rdf:type rdf:Property ;
    rdfs:label 'Completion Date' ;
    rdfs:comment 'The actual date on which the filing, submission, or compliance action was completed and submitted to the regulatory body. Null if the deadline has not yet been met.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:completionStatus rdf:type rdf:Property ;
    rdfs:label 'Completion Status' ;
    rdfs:comment 'Current status of the compliance deadline indicating whether the obligation has been met, is in progress, or has been missed. Drives operational workflow and escalation logic. [ENUM-REF-CANDIDATE: pending|in_progress|completed_on_time|completed_late|missed|waived|cancelled — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:ComplianceCalendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceDomain rdf:type rdf:Property ;
    rdfs:label 'Compliance Domain' ;
    rdfs:comment 'The functional domain or category of compliance to which this deadline belongs (e.g., reliability standards, environmental reporting, safety inspections, financial filings, cybersecurity audits, rate regulation). Enables domain-specific reporting and resource planning. [ENUM-REF-CANDIDATE: reliability|environmental|safety|financial|operational|cybersecurity|rate_regulation|other — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:daysToDeadline rdf:type rdf:Property ;
    rdfs:label 'Days To Deadline' ;
    rdfs:comment 'Calculated number of calendar days remaining until the effective due date. Negative values indicate the deadline has passed. Used to trigger alerts and prioritize work queues.' ;
    rdfs:domain ind:ComplianceCalendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:deadlineType rdf:type rdf:Property ;
    rdfs:label 'Deadline Type' ;
    rdfs:comment 'Classification of the type of regulatory deadline or milestone being tracked. Determines the nature of the obligation and the required action by the utility. [ENUM-REF-CANDIDATE: filing_due_date|compliance_evidence_submission|rate_case_milestone|irp_update_cycle|annual_report_due_date|audit_window|inspection_window|testimony_deadline|tariff_filing_deadline|other — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:ComplianceCalendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectiveDueDate rdf:type rdf:Property ;
    rdfs:label 'Effective Due Date' ;
    rdfs:comment 'The current operative deadline date that the utility must meet. Equals extended_due_date if an extension was granted, otherwise equals original_due_date. This is the date used for alert calculations and compliance tracking.' ;
    rdfs:domain ind:ComplianceCalendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:escalationContact rdf:type rdf:Property ;
    rdfs:label 'Escalation Contact' ;
    rdfs:comment 'Name or identifier of the escalation contact or manager to be notified if the deadline is at risk of being missed or if issues arise during compliance preparation.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventName rdf:type rdf:Property ;
    rdfs:label 'Event Name' ;
    rdfs:comment 'Descriptive name or title of the compliance deadline or milestone (e.g., \'Q1 FERC Form 1 Filing\', \'Annual NERC CIP Audit\', \'Rate Case Testimony Submission\', \'IRP Update Cycle 2024\').' ;
    rdfs:domain ind:ComplianceCalendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventNotes rdf:type rdf:Property ;
    rdfs:label 'Event Notes' ;
    rdfs:comment 'Free-text field for additional context, instructions, special conditions, or internal notes related to this compliance deadline. Captures information not covered by structured fields.' ;
    rdfs:domain ind:ComplianceCalendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:extendedDueDate rdf:type rdf:Property ;
    rdfs:label 'Extended Due Date' ;
    rdfs:comment 'The revised deadline date if an extension has been granted by the regulatory body. Null if no extension has been requested or approved. This becomes the operative deadline when populated.' ;
    rdfs:domain ind:ComplianceCalendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:extensionApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Extension Approval Date' ;
    rdfs:comment 'The date on which the regulatory body formally approved the extension request. Null if no extension was granted.' ;
    rdfs:domain ind:ComplianceCalendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:extensionGrantedIndicator rdf:type rdf:Property ;
    rdfs:label 'Extension Granted Indicator' ;
    rdfs:comment 'Flag indicating whether the regulatory body has approved the extension request. True if the extension was granted and extended_due_date has been populated.' ;
    rdfs:domain ind:ComplianceCalendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:extensionRequestDate rdf:type rdf:Property ;
    rdfs:label 'Extension Request Date' ;
    rdfs:comment 'The date on which the utility submitted a formal request for deadline extension to the regulatory body. Null if no extension has been requested.' ;
    rdfs:domain ind:ComplianceCalendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:extensionRequestedIndicator rdf:type rdf:Property ;
    rdfs:label 'Extension Requested Indicator' ;
    rdfs:comment 'Flag indicating whether the utility has formally requested an extension of the original deadline from the regulatory body. True if an extension request has been submitted.' ;
    rdfs:domain ind:ComplianceCalendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:jurisdiction rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction' ;
    rdfs:comment 'The regulatory jurisdiction or geographic scope to which this deadline applies (e.g., federal, state-specific, multi-state, RTO/ISO region). Identifies the legal and geographic boundaries of the compliance obligation.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextOccurrenceDate rdf:type rdf:Property ;
    rdfs:label 'Next Occurrence Date' ;
    rdfs:comment 'For recurring deadlines, the date of the next scheduled occurrence after the current effective due date. Used for forward planning and resource allocation.' ;
    rdfs:domain ind:ComplianceCalendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:originalDueDate rdf:type rdf:Property ;
    rdfs:label 'Original Due Date' ;
    rdfs:comment 'The initial statutory or regulatory deadline date as established by the governing body or regulatory order. This date does not change even if extensions are granted.' ;
    rdfs:domain ind:ComplianceCalendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:penaltyExposureAmount rdf:type rdf:Property ;
    rdfs:label 'Penalty Exposure Amount' ;
    rdfs:comment 'Estimated financial penalty or fine exposure (in USD) if this deadline is missed or the compliance obligation is not met. Used for risk assessment and prioritization. Null if no specific penalty is defined.' ;
    rdfs:domain ind:ComplianceCalendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recurrenceFrequency rdf:type rdf:Property ;
    rdfs:label 'Recurrence Frequency' ;
    rdfs:comment 'The frequency at which this compliance deadline recurs, if recurrence_indicator is true. Defines the cadence for automatic generation of future deadline instances. [ENUM-REF-CANDIDATE: daily|weekly|monthly|quarterly|semi_annual|annual|biennial|ad_hoc — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recurrenceIndicator rdf:type rdf:Property ;
    rdfs:label 'Recurrence Indicator' ;
    rdfs:comment 'Flag indicating whether this is a recurring compliance deadline (e.g., quarterly FERC filings, annual NERC audits) or a one-time event (e.g., specific rate case milestone, CPCN application deadline). True for recurring events.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryBody rdf:type rdf:Property ;
    rdfs:label 'Regulatory Body' ;
    rdfs:comment 'The regulatory authority or governing body to which this deadline applies (e.g., Federal Energy Regulatory Commission (FERC), North American Electric Reliability Corporation (NERC), State Public Utility Commission (PUC), Environmental Protection Agency (EPA), Pipeline and Hazardous Materials Safety Administration (PHMSA)). [ENUM-REF-CANDIDATE: FERC|NERC|PUC|EPA|DOE|PHMSA|OSHA|state_commission|other — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryStandardRef rdf:type rdf:Property ;
    rdfs:label 'Regulatory Standard Ref' ;
    rdfs:comment 'Citation or reference to the specific regulatory standard, rule, or statute that establishes this deadline (e.g., NERC CIP-007-6, EPA 40 CFR Part 75, FERC Order 1000, state tariff section). Provides legal traceability.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsibleParty rdf:type rdf:Property ;
    rdfs:label 'Responsible Party' ;
    rdfs:comment 'Name or identifier of the internal business unit, department, or individual responsible for ensuring this deadline is met (e.g., \'Regulatory Affairs\', \'Compliance Manager\', \'Rate Case Team\', \'Environmental Compliance Officer\').' ;
    rdfs:domain ind:ComplianceCalendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionMethod rdf:type rdf:Property ;
    rdfs:label 'Submission Method' ;
    rdfs:comment 'The method or channel by which the compliance filing or evidence must be submitted to the regulatory body (e.g., electronic filing portal, email, physical mail, hand delivery).' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctiveActionPlanId rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Plan Id' ;
    rdfs:comment 'Reference to the corrective action plan (CAP) associated with this compliance event, applicable when the event type is a violation, audit finding, or deficiency requiring remediation.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CorrectiveActionPlan .

ind:closedIndicator rdf:type rdf:Property ;
    rdfs:label 'Closed Indicator' ;
    rdfs:comment 'Indicates whether this compliance event has been formally closed by the regulatory authority or internal compliance function. True = closed/resolved with no further action required; False = open and active. Supports compliance dashboard reporting and open-item tracking.' ;
    rdfs:domain ind:ComplianceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:closureDate rdf:type rdf:Property ;
    rdfs:label 'Closure Date' ;
    rdfs:comment 'Date on which this compliance event was formally closed by the regulatory authority or internal compliance function. Null if the event remains open. Used for compliance lifecycle reporting and regulatory audit trail documentation.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:emissionQuantity rdf:type rdf:Property ;
    rdfs:label 'Emission Quantity' ;
    rdfs:comment 'Quantity of regulated emissions associated with this compliance event, expressed in the applicable unit (tons, metric tons CO2e, MCF). Used for EPA GHG reporting compliance verification and environmental penalty calculations under the Clean Air Act.' ;
    rdfs:domain ind:ComplianceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:emissionQuantityUnit rdf:type rdf:Property ;
    rdfs:label 'Emission Quantity Unit' ;
    rdfs:comment 'Unit of measure for the emission_quantity field. short_tons = US short tons; metric_tons_co2e = metric tons CO2 equivalent (standard GHG reporting unit); MCF = thousand cubic feet (gas); MWh = megawatt-hours (for heat rate compliance).' ;
    rdfs:domain ind:ComplianceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventDate rdf:type rdf:Property ;
    rdfs:label 'Event Date' ;
    rdfs:comment 'The principal real-world date on which the compliance event occurred — e.g., the date evidence was submitted, the date a violation was identified, the date a self-report was filed, or the date an audit finding was issued. Distinct from record audit timestamps.' ;
    rdfs:domain ind:ComplianceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:evidenceReference rdf:type rdf:Property ;
    rdfs:label 'Evidence Reference' ;
    rdfs:comment 'Document identifier, file path, or external system reference pointing to the evidence package submitted or associated with this compliance event. Examples: document management system ID, NERC COMS submission reference, EPA CDX submission ID, or SharePoint document URL.' ;
    rdfs:domain ind:ComplianceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityName rdf:type rdf:Property ;
    rdfs:label 'Facility Name' ;
    rdfs:comment 'Name of the generation plant, substation, transmission facility, or gas distribution facility associated with this compliance event. Provides human-readable facility context for regulatory reporting and audit documentation.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ghgEmissionType rdf:type rdf:Property ;
    rdfs:label 'Ghg Emission Type' ;
    rdfs:comment 'Type of greenhouse gas or regulated air emission associated with this compliance event, applicable for EPA environmental compliance events. CO2 = carbon dioxide; CH4 = methane; N2O = nitrous oxide; SF6 = sulfur hexafluoride (electrical equipment); NOx = nitrogen oxides; SOx = sulfur oxides.' ;
    rdfs:domain ind:ComplianceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:penaltyPaidDate rdf:type rdf:Property ;
    rdfs:label 'Penalty Paid Date' ;
    rdfs:comment 'Date on which the assessed penalty was remitted to the regulatory authority. Null if penalty has not been paid or no penalty was assessed. Used for financial reconciliation and regulatory closure confirmation.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:penaltyPaidIndicator rdf:type rdf:Property ;
    rdfs:label 'Penalty Paid Indicator' ;
    rdfs:comment 'Indicates whether the assessed penalty has been paid to the regulatory authority. True = penalty paid; False = penalty outstanding or not yet assessed. Applicable only when penalty_amount is greater than zero.' ;
    rdfs:domain ind:ComplianceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatorCaseNumber rdf:type rdf:Property ;
    rdfs:label 'Regulator Case Number' ;
    rdfs:comment 'The case, docket, or tracking number assigned by the regulatory authority (NERC, FERC, EPA, PUC) to this compliance event or associated enforcement action. Used for cross-referencing with regulator records and official correspondence.' ;
    rdfs:domain ind:ComplianceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatorResponseNotes rdf:type rdf:Property ;
    rdfs:label 'Regulator Response Notes' ;
    rdfs:comment 'Notes or summary of the regulatory authority\'s response to this compliance event, including acceptance of evidence, issuance of a Notice of Penalty (NOP), approval of a corrective action plan, or closure of the enforcement action. Captures key communications from NERC, FERC, EPA, or PUC.' ;
    rdfs:domain ind:ComplianceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskLevel rdf:type rdf:Property ;
    rdfs:label 'Risk Level' ;
    rdfs:comment 'Risk severity classification of this compliance event based on potential impact to grid reliability, public safety, environmental harm, or financial exposure. critical = immediate threat to BES reliability or public safety; high = significant regulatory exposure; medium = moderate risk; low = minor administrative non-compliance. Aligns with NERC violation risk factor (VRF) methodology.' ;
    rdfs:domain ind:ComplianceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:selfReportIndicator rdf:type rdf:Property ;
    rdfs:label 'Self Report Indicator' ;
    rdfs:comment 'Indicates whether this compliance event was voluntarily self-reported by the utility to the regulator prior to detection. True = self-reported; False = identified by regulator or third party. Self-reporting is a mitigating factor in NERC CMEP and EPA penalty calculations.' ;
    rdfs:domain ind:ComplianceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:violationEndDate rdf:type rdf:Property ;
    rdfs:label 'Violation End Date' ;
    rdfs:comment 'Date on which the non-compliance condition was resolved or the violation ceased, as verified by the utility or regulator. Null if the violation is ongoing. Used with violation_start_date to determine violation duration for penalty calculation.' ;
    rdfs:domain ind:ComplianceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:violationRiskFactor rdf:type rdf:Property ;
    rdfs:label 'Violation Risk Factor' ;
    rdfs:comment 'NERC-defined Violation Risk Factor (VRF) assigned to the reliability standard requirement associated with this compliance event. Values per NERC methodology: high, medium, lower. Used in NERC CMEP penalty matrix calculations. Null for non-NERC events.' ;
    rdfs:domain ind:ComplianceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:violationSeverityLevel rdf:type rdf:Property ;
    rdfs:label 'Violation Severity Level' ;
    rdfs:comment 'NERC-defined Violation Severity Level (VSL) for this compliance event, reflecting the degree of non-compliance with the applicable reliability standard requirement. Values per NERC methodology: severe, high, medium, lower. Used in NERC CMEP penalty matrix. Null for non-NERC events.' ;
    rdfs:domain ind:ComplianceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:violationStartDate rdf:type rdf:Property ;
    rdfs:label 'Violation Start Date' ;
    rdfs:comment 'Date on which the non-compliance condition began, as determined by the utility or regulator. Applicable when event_type is violation_notice, self_report, or audit_finding. Used to calculate violation duration for penalty assessment under NERC CMEP and EPA enforcement policies.' ;
    rdfs:domain ind:ComplianceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:applicabilityScope rdf:type rdf:Property ;
    rdfs:label 'Applicability Scope' ;
    rdfs:comment 'The utility business segment or operational area to which this obligation applies. Enables filtering of obligations relevant to specific business units (e.g., a NERC CIP standard applies to \'transmission\'; a PHMSA rule applies to \'gas_distribution\'; an EPA GHG rule may apply to \'generation\').' ;
    rdfs:domain ind:ComplianceObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetClassScope rdf:type rdf:Property ;
    rdfs:label 'Asset Class Scope' ;
    rdfs:comment 'The specific class of assets or infrastructure covered by this obligation (e.g., \'BES Cyber Systems\', \'High Consequence Areas\', \'Bulk Electric System\', \'Natural Gas Transmission Pipeline\', \'Generation Unit > 20 MW\'). Supports asset-level compliance mapping in the Enterprise Asset Management (EAM) system.' ;
    rdfs:domain ind:ComplianceObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditFrequency rdf:type rdf:Property ;
    rdfs:label 'Audit Frequency' ;
    rdfs:comment 'How frequently the governing body conducts formal audits or compliance reviews of this obligation. Informs internal audit scheduling and readiness preparation cycles (e.g., NERC conducts triennial audits for most reliability standards; EPA may conduct annual inspections for Title V permits).' ;
    rdfs:domain ind:ComplianceObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cfrCitation rdf:type rdf:Property ;
    rdfs:label 'Cfr Citation' ;
    rdfs:comment 'The specific Code of Federal Regulations (CFR) citation for this obligation where applicable (e.g., \'40 CFR Part 98\', \'49 CFR Part 192\', \'18 CFR Part 35\'). Provides the authoritative legal reference for the obligation and supports regulatory correspondence.' ;
    rdfs:domain ind:ComplianceObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceFrequency rdf:type rdf:Property ;
    rdfs:label 'Compliance Frequency' ;
    rdfs:comment 'How often the utility must demonstrate or report compliance with this obligation. \'continuous\' applies to always-on operational standards (e.g., NERC CIP controls); \'event_driven\' applies to obligations triggered by specific incidents or thresholds (e.g., outage reporting, spill notification). [ENUM-REF-CANDIDATE: continuous|annual|semi_annual|quarterly|monthly|event_driven|one_time — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:ComplianceObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceNotes rdf:type rdf:Property ;
    rdfs:label 'Compliance Notes' ;
    rdfs:comment 'Free-text field for compliance staff to record observations, interpretations, open issues, regulatory guidance received, or other contextual information relevant to managing this obligation. Not a substitute for formal evidence documentation.' ;
    rdfs:domain ind:ComplianceObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceOwner rdf:type rdf:Property ;
    rdfs:label 'Compliance Owner' ;
    rdfs:comment 'Name or employee identifier of the individual designated as the primary compliance owner responsible for managing and demonstrating compliance with this obligation. This person is accountable for evidence collection, status updates, and regulatory submissions.' ;
    rdfs:domain ind:ComplianceObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctiveActionPlanStatus rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Plan Status' ;
    rdfs:comment 'Current status of any Corrective Action Plan (CAP) associated with this obligation. \'not_required\' when the utility is compliant; \'in_development\' when a CAP is being drafted following a finding; \'active\' when a CAP is approved and being executed; \'completed\' when all CAP milestones are closed; \'overdue\' when CAP milestones have been missed.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evidenceLocation rdf:type rdf:Property ;
    rdfs:label 'Evidence Location' ;
    rdfs:comment 'The system, repository, or document management location where compliance evidence and supporting documentation for this obligation is stored (e.g., SharePoint path, document management system folder, NERC CMEP portal, EPA e-GGRT system). Enables auditors to quickly locate supporting evidence.' ;
    rdfs:domain ind:ComplianceObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evidenceRetentionYears rdf:type rdf:Property ;
    rdfs:label 'Evidence Retention Years' ;
    rdfs:comment 'The number of years that compliance evidence, records, and documentation must be retained for this obligation as required by the governing body. Drives records management policy and data archival schedules (e.g., NERC CIP requires 3 years; FERC OATT requires 5 years; EPA GHG requires 3 years).' ;
    rdfs:domain ind:ComplianceObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ghgReportingApplicable rdf:type rdf:Property ;
    rdfs:label 'Ghg Reporting Applicable' ;
    rdfs:comment 'Indicates whether this compliance obligation involves Greenhouse Gas (GHG) emissions reporting or monitoring requirements under EPA regulations (e.g., 40 CFR Part 98 Mandatory GHG Reporting Rule). Enables filtering of GHG-related obligations for environmental compliance reporting.' ;
    rdfs:domain ind:ComplianceObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:governingBody rdf:type rdf:Property ;
    rdfs:label 'Governing Body' ;
    rdfs:comment 'The regulatory authority or standards body that issued and enforces this compliance obligation (e.g., FERC, NERC, EPA, PHMSA, State PUC). Determines the jurisdictional authority and applicable enforcement mechanisms. [ENUM-REF-CANDIDATE: FERC|NERC|EPA|PHMSA|PUC|DOE|OSHA|IEEE|AGA|NARUC — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:ComplianceObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastAssessmentDate rdf:type rdf:Property ;
    rdfs:label 'Last Assessment Date' ;
    rdfs:comment 'The most recent date on which a formal compliance assessment, audit, or self-certification was completed for this obligation. Used to determine assessment currency and schedule the next review cycle.' ;
    rdfs:domain ind:ComplianceObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastAuditDate rdf:type rdf:Property ;
    rdfs:label 'Last Audit Date' ;
    rdfs:comment 'The date of the most recent formal audit or compliance review conducted by the governing body for this obligation. Used to calculate time since last audit and anticipate the next audit window.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastFilingDate rdf:type rdf:Property ;
    rdfs:label 'Last Filing Date' ;
    rdfs:comment 'The date of the most recent regulatory submission, report, or filing made to the governing body in fulfillment of this obligation (e.g., last annual GHG report submitted to EPA, last NERC self-report filed). Supports audit trail and filing history tracking.' ;
    rdfs:domain ind:ComplianceObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nercViolationRiskFactor rdf:type rdf:Property ;
    rdfs:label 'Nerc Violation Risk Factor' ;
    rdfs:comment 'The Violation Risk Factor (VRF) assigned by NERC to this reliability standard requirement, indicating the potential impact of non-compliance on the reliability of the Bulk Electric System (BES). Applicable only to NERC reliability standards; null for non-NERC obligations.' ;
    rdfs:domain ind:ComplianceObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nercViolationSeverityLevel rdf:type rdf:Property ;
    rdfs:label 'Nerc Violation Severity Level' ;
    rdfs:comment 'The Violation Severity Level (VSL) category applicable to this NERC standard requirement, reflecting the degree of non-compliance (Lower, Medium, High, Severe). Used in conjunction with VRF to determine the base penalty amount under the NERC Sanction Guidelines. Null for non-NERC obligations.' ;
    rdfs:domain ind:ComplianceObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:obligationCategory rdf:type rdf:Property ;
    rdfs:label 'Obligation Category' ;
    rdfs:comment 'Functional category of the compliance obligation describing the nature of the required action. Supports compliance program segmentation and resource allocation across operational, reporting, recordkeeping, physical security, cybersecurity, financial, and environmental obligations. [ENUM-REF-CANDIDATE: operational|reporting|recordkeeping|physical|cybersecurity|financial|environmental — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:ComplianceObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:obligationCode rdf:type rdf:Property ;
    rdfs:label 'Obligation Code' ;
    rdfs:comment 'Externally-known alphanumeric code or identifier for the compliance obligation, typically matching the regulatory standard or rule identifier (e.g., NERC CIP-014-3, 40 CFR 98, 49 CFR 192.605, FERC OATT Section 37). Serves as the business-facing reference key used in regulatory filings and correspondence.' ;
    rdfs:domain ind:ComplianceObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:obligationDescription rdf:type rdf:Property ;
    rdfs:label 'Obligation Description' ;
    rdfs:comment 'Detailed narrative description of the compliance obligation, including the specific requirements the utility must meet, the actions required, and any conditions or thresholds that trigger compliance activities. Provides context for compliance staff and auditors.' ;
    rdfs:domain ind:ComplianceObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:obligationName rdf:type rdf:Property ;
    rdfs:label 'Obligation Name' ;
    rdfs:comment 'Full descriptive name of the compliance obligation as published by the governing body (e.g., \'Physical Security of BES Cyber Systems\', \'Mandatory GHG Reporting Rule\', \'Pipeline Integrity Management in High Consequence Areas\'). Used as the human-readable label in dashboards and reports.' ;
    rdfs:domain ind:ComplianceObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:openViolationCount rdf:type rdf:Property ;
    rdfs:label 'Open Violation Count' ;
    rdfs:comment 'The current number of open, unresolved violations or findings associated with this compliance obligation. A value greater than zero triggers escalation workflows and corrective action plan (CAP) tracking. Sourced from the compliance management system.' ;
    rdfs:domain ind:ComplianceObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pbrLinked rdf:type rdf:Property ;
    rdfs:label 'Pbr Linked' ;
    rdfs:comment 'Indicates whether this compliance obligation is linked to a Performance-Based Ratemaking (PBR) mechanism where non-compliance or underperformance results in financial incentives or penalties applied to the utility\'s revenue requirement. Connects compliance tracking to rate case outcomes.' ;
    rdfs:domain ind:ComplianceObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:penaltyExposureUsd rdf:type rdf:Property ;
    rdfs:label 'Penalty Exposure Usd' ;
    rdfs:comment 'The maximum potential monetary penalty per day or per violation that the utility could face for non-compliance with this obligation, expressed in US dollars. Used for risk prioritization and materiality assessment in the compliance program. For NERC violations, this reflects the NERC Sanction Guidelines maximum.' ;
    rdfs:domain ind:ComplianceObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riskPriority rdf:type rdf:Property ;
    rdfs:label 'Risk Priority' ;
    rdfs:comment 'The assessed risk priority level for this obligation, reflecting the combination of likelihood of non-compliance and severity of consequences (financial penalty, operational impact, reputational harm). Used to prioritize compliance resources and management attention.' ;
    rdfs:domain ind:ComplianceObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:saidiSaifiApplicable rdf:type rdf:Property ;
    rdfs:label 'Saidi Saifi Applicable' ;
    rdfs:comment 'Indicates whether this compliance obligation involves electric distribution service quality metrics including System Average Interruption Duration Index (SAIDI), System Average Interruption Frequency Index (SAIFI), or Customer Average Interruption Duration Index (CAIDI) targets set by the state PUC. Enables filtering of service quality obligations.' ;
    rdfs:domain ind:ComplianceObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:selfReportRequired rdf:type rdf:Property ;
    rdfs:label 'Self Report Required' ;
    rdfs:comment 'Indicates whether the utility is required to proactively self-report violations or non-compliance events to the governing body for this obligation. True for NERC standards with mandatory self-reporting under the CMEP; False for obligations where reporting is only required upon regulatory request.' ;
    rdfs:domain ind:ComplianceObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:standardVersion rdf:type rdf:Property ;
    rdfs:label 'Standard Version' ;
    rdfs:comment 'The version or revision number of the regulatory standard or rule that this obligation is based on (e.g., \'CIP-014-3\', \'Revision 2\', \'40 CFR 98 as amended 2023\'). Critical for tracking when standards are updated and ensuring the utility is complying with the current version.' ;
    rdfs:domain ind:ComplianceObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tariffSectionReference rdf:type rdf:Property ;
    rdfs:label 'Tariff Section Reference' ;
    rdfs:comment 'The specific tariff section, schedule, or Open Access Transmission Tariff (OATT) provision that this obligation is associated with, where applicable (e.g., \'OATT Section 37\', \'Rate Schedule No. 4\', \'General Service Tariff Rule 15\'). Links compliance obligations to the utility\'s filed tariffs.' ;
    rdfs:domain ind:ComplianceObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currentFinancialPeriodId rdf:type rdf:Property ;
    rdfs:label 'Current Financial Period Id' ;
    rdfs:comment 'Foreign key linking to finance.financial_period. Business justification: Cost recovery mechanisms (fuel adjustment clauses, storm cost recovery, DSM trackers) have true-up cycles tied to financial periods. Finance calculates quarterly/annual true-ups based on closed period' ;
    rdfs:domain ind:CostRecoveryMechanism ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinancialPeriod .

ind:afudcRatePct rdf:type rdf:Property ;
    rdfs:label 'Afudc Rate Pct' ;
    rdfs:comment 'The FERC-approved or PUC-approved AFUDC capitalization rate expressed as a percentage, applicable when mechanism_type is AFUDC. Represents the cost of capital applied to construction work in progress (WIP) balances. Null for non-AFUDC mechanism types.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:annualCapAmount rdf:type rdf:Property ;
    rdfs:label 'Annual Cap Amount' ;
    rdfs:comment 'Maximum dollar amount that may be recovered through this mechanism in a single calendar or regulatory year, as approved by the regulatory body. Null if no annual cap is imposed. Expressed in USD.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approvalOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Approval Order Number' ;
    rdfs:comment 'The official order, decision, or resolution number issued by the regulatory body that authorized this cost recovery mechanism. Used for audit trail and regulatory correspondence.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:balanceAsOfDate rdf:type rdf:Property ;
    rdfs:label 'Balance As Of Date' ;
    rdfs:comment 'The date as of which the current_balance was last calculated or reported. Used to determine the staleness of the balance figure for reporting and true-up purposes.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:costRecoveryMechanismStatus rdf:type rdf:Property ;
    rdfs:label 'Cost Recovery Mechanism Status' ;
    rdfs:comment 'Current lifecycle status of the cost recovery mechanism: active = currently in effect and recovering costs; suspended = temporarily halted by regulatory order; terminated = permanently closed; pending_approval = filed but not yet approved; under_review = subject to ongoing prudency or audit review; expired = reached scheduled end date.' ;
    rdfs:domain ind:CostRecoveryMechanism ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currentRateAmount rdf:type rdf:Property ;
    rdfs:label 'Current Rate Amount' ;
    rdfs:comment 'The currently approved per-unit recovery rate applied to customer bills under this mechanism (e.g., cents per kWh for FAC, dollars per MCF for gas adjustment). The unit of measure is defined by recovery_method and service_type.' ;
    rdfs:domain ind:CostRecoveryMechanism ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disallowedAmount rdf:type rdf:Property ;
    rdfs:label 'Disallowed Amount' ;
    rdfs:comment 'Dollar amount of costs disallowed by the regulatory body following a prudency review or audit. Reduces the total recoverable amount. Expressed in USD. Zero if no disallowance has occurred.' ;
    rdfs:domain ind:CostRecoveryMechanism ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dsmProgramName rdf:type rdf:Property ;
    rdfs:label 'Dsm Program Name' ;
    rdfs:comment 'Name of the DSM or EE program whose costs are being recovered through this mechanism. Applicable when mechanism_type is DSM_EE_rider. Null for non-DSM mechanisms.' ;
    rdfs:domain ind:CostRecoveryMechanism ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingFrequency rdf:type rdf:Property ;
    rdfs:label 'Filing Frequency' ;
    rdfs:comment 'Frequency at which the utility must file reports, rate adjustment applications, or compliance filings with the regulatory body for this mechanism (e.g., monthly FAC filings, annual infrastructure rider updates).' ;
    rdfs:domain ind:CostRecoveryMechanism ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interestAccrualIndicator rdf:type rdf:Property ;
    rdfs:label 'Interest Accrual Indicator' ;
    rdfs:comment 'Indicates whether interest accrues on the outstanding balance of this cost recovery mechanism as approved by the regulatory body. True = interest accrues on under- or over-recovery balances; False = no interest accrual.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:interestRatePct rdf:type rdf:Property ;
    rdfs:label 'Interest Rate Pct' ;
    rdfs:comment 'The approved interest rate percentage applied to the outstanding balance when interest_accrual_indicator is True. Typically set by the regulatory body in the approval order. Null when interest_accrual_indicator is False.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastTrueUpDate rdf:type rdf:Property ;
    rdfs:label 'Last True Up Date' ;
    rdfs:comment 'Date of the most recently completed true-up reconciliation for this mechanism. Used to track compliance with the approved true-up frequency and to identify overdue reconciliations.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mechanismCode rdf:type rdf:Property ;
    rdfs:label 'Mechanism Code' ;
    rdfs:comment 'Externally-known alphanumeric code assigned by the utility or regulatory body to uniquely identify this cost recovery mechanism or rider (e.g., FAC-001, AFUDC-2024, STORM-RIDER-TX). Used in tariff filings, rate schedules, and regulatory correspondence.' ;
    rdfs:domain ind:CostRecoveryMechanism ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mechanismDescription rdf:type rdf:Property ;
    rdfs:label 'Mechanism Description' ;
    rdfs:comment 'Detailed narrative description of the cost recovery mechanism, including its regulatory purpose, the types of costs it covers, and any special conditions or limitations imposed by the approving regulatory body.' ;
    rdfs:domain ind:CostRecoveryMechanism ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mechanismName rdf:type rdf:Property ;
    rdfs:label 'Mechanism Name' ;
    rdfs:comment 'Full descriptive name of the cost recovery mechanism as it appears in the approved tariff or regulatory order (e.g., \'Fuel Adjustment Clause\', \'Infrastructure Modernization Rider\', \'Storm Cost Recovery Tracker\').' ;
    rdfs:domain ind:CostRecoveryMechanism ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mechanismType rdf:type rdf:Property ;
    rdfs:label 'Mechanism Type' ;
    rdfs:comment 'Classification of the cost recovery mechanism by regulatory category. FAC = Fuel Adjustment Clause; AFUDC = Allowance for Funds Used During Construction; CIAC = Contribution in Aid of Construction; infrastructure_rider = capital infrastructure surcharge; storm_cost_tracker = storm damage cost recovery; DSM_EE_rider = Demand-Side Management / Energy Efficiency program cost recovery. [ENUM-REF-CANDIDATE: FAC|AFUDC|CIAC|infrastructure_rider|storm_cost_tracker|DSM_EE_rider|other — promote to reference product]' ;
    rdfs:domain ind:CostRecoveryMechanism ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextFilingDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Filing Due Date' ;
    rdfs:comment 'Date by which the next required regulatory filing or rate adjustment application for this mechanism must be submitted to the regulatory body. Supports compliance calendar management.' ;
    rdfs:domain ind:CostRecoveryMechanism ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextTrueUpDate rdf:type rdf:Property ;
    rdfs:label 'Next True Up Date' ;
    rdfs:comment 'Scheduled date for the next true-up reconciliation filing with the regulatory body. Supports proactive compliance monitoring and workload planning.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:prudencyReviewRequired rdf:type rdf:Property ;
    rdfs:label 'Prudency Review Required' ;
    rdfs:comment 'Indicates whether costs recovered under this mechanism are subject to a regulatory prudency review before final recovery is confirmed. True = prudency review required; False = costs are pre-approved without individual prudency review.' ;
    rdfs:domain ind:CostRecoveryMechanism ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:prudencyReviewStatus rdf:type rdf:Property ;
    rdfs:label 'Prudency Review Status' ;
    rdfs:comment 'Current status of the prudency review for costs recovered under this mechanism: not_required = no review required; pending = review not yet initiated; in_progress = review underway; completed = review finalized; disallowed = costs partially or fully disallowed; approved = costs found prudent and approved for full recovery.' ;
    rdfs:domain ind:CostRecoveryMechanism ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateBaseTreatment rdf:type rdf:Property ;
    rdfs:label 'Rate Base Treatment' ;
    rdfs:comment 'Regulatory accounting treatment of costs recovered under this mechanism with respect to the utility\'s rate base: included = costs are part of the approved rate base; excluded = costs are recovered outside rate base as a rider; deferred = costs are deferred pending future rate case inclusion; amortized = costs are being amortized over an approved period.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Rate Effective Date' ;
    rdfs:comment 'Date on which the current_rate_amount became effective for billing purposes. Changes when a true-up or rate adjustment is approved.' ;
    rdfs:domain ind:CostRecoveryMechanism ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:recoveryMethod rdf:type rdf:Property ;
    rdfs:label 'Recovery Method' ;
    rdfs:comment 'The billing methodology by which costs are recovered from customers: volumetric = per kWh or MCF consumed; fixed_charge = flat monthly charge per customer; percentage_of_bill = surcharge as a percentage of base bill; demand_charge = per kW of peak demand.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoveryPeriodMonths rdf:type rdf:Property ;
    rdfs:label 'Recovery Period Months' ;
    rdfs:comment 'Total approved recovery period in months over which the authorized costs are to be collected from customers. For amortized mechanisms, this defines the amortization schedule length.' ;
    rdfs:domain ind:CostRecoveryMechanism ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:regulatoryAssetLiability rdf:type rdf:Property ;
    rdfs:label 'Regulatory Asset Liability' ;
    rdfs:comment 'Indicates whether this mechanism creates a regulatory asset (under-recovery, costs deferred for future collection), a regulatory liability (over-recovery, amounts owed back to customers), or neither (pass-through with no balance accumulation). Per GAAP ASC 980.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalAuthorizedAmount rdf:type rdf:Property ;
    rdfs:label 'Total Authorized Amount' ;
    rdfs:comment 'Total dollar amount authorized by the regulatory body for recovery under this mechanism over its full approved life. Null for open-ended mechanisms without a defined total cap. Expressed in USD.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:trueUpFrequency rdf:type rdf:Property ;
    rdfs:label 'True Up Frequency' ;
    rdfs:comment 'Regulatory-approved frequency at which the cost recovery mechanism balance is reconciled and rates are adjusted to correct for over- or under-recovery (e.g., monthly for FAC, annual for infrastructure riders).' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wipBalance rdf:type rdf:Property ;
    rdfs:label 'Wip Balance' ;
    rdfs:comment 'Current construction Work in Progress balance associated with this AFUDC or infrastructure rider mechanism. Applicable when mechanism_type is AFUDC or infrastructure_rider. Expressed in USD. Null for non-capital mechanisms.' ;
    rdfs:domain ind:CostRecoveryMechanism ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:primaryAssetMasterId rdf:type rdf:Property ;
    rdfs:label 'Primary Asset Master Id' ;
    rdfs:comment 'Foreign key linking to asset.asset_master. Business justification: CPCN applications approve construction of specific major assets (transmission lines, substations, generation units). Links regulatory approval to the primary asset constructed. Essential for tracking ' ;
    rdfs:domain ind:CpcnApplication ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Master .

ind:acceptanceDate rdf:type rdf:Property ;
    rdfs:label 'Acceptance Date' ;
    rdfs:comment 'Date on which the regulatory agency formally accepted the CPCN application as complete and docketed it for review. Distinct from filing_date; acceptance triggers the official statutory review period.' ;
    rdfs:domain ind:CpcnApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:applicationStatus rdf:type rdf:Property ;
    rdfs:label 'Application Status' ;
    rdfs:comment 'Current lifecycle status of the CPCN application within the regulatory proceeding. Tracks progression from internal drafting through PUC/FERC review to final disposition. [ENUM-REF-CANDIDATE: draft|filed|pending_review|evidentiary_hearing|approved|conditionally_approved|denied|withdrawn|suspended — promote to reference product]' ;
    rdfs:domain ind:CpcnApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appliedCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Applied Capacity Mw' ;
    rdfs:comment 'Nameplate or rated capacity in megawatts (MW) for generation or substation projects as stated in the CPCN application. Null for linear infrastructure (transmission lines, pipelines) where line_length_miles is the primary measurement. Used for IRP capacity planning and PUC capacity need determinations.' ;
    rdfs:domain ind:CpcnApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:certificateExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Certificate Expiry Date' ;
    rdfs:comment 'Date on which the issued CPCN certificate expires if construction has not commenced or the project has not been placed in service. Utilities must seek an extension or re-file if this date passes without project completion.' ;
    rdfs:domain ind:CpcnApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:certificateIssuanceDate rdf:type rdf:Property ;
    rdfs:label 'Certificate Issuance Date' ;
    rdfs:comment 'Date on which the CPCN certificate was formally issued to the utility following approval. This date authorizes commencement of construction or operation and is the key milestone for capital project scheduling and AFUDC accrual start.' ;
    rdfs:domain ind:CpcnApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:conditionsOfApproval rdf:type rdf:Property ;
    rdfs:label 'Conditions Of Approval' ;
    rdfs:comment 'Narrative description of any conditions, mitigation measures, or compliance obligations imposed by the PUC or FERC as part of a conditional approval. Null for unconditional approvals or pending applications. Populated from the regulatory order text.' ;
    rdfs:domain ind:CpcnApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:constructionStartDate rdf:type rdf:Property ;
    rdfs:label 'Construction Start Date' ;
    rdfs:comment 'Earliest date on which construction may commence per the CPCN certificate conditions. May differ from the certificate_issuance_date if the certificate imposes pre-construction conditions (e.g., environmental mitigation plan approval).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:costRecoveryMechanism rdf:type rdf:Property ;
    rdfs:label 'Cost Recovery Mechanism' ;
    rdfs:comment 'Regulatory mechanism through which the utility intends to recover the costs of the project from customers. Rate_base: included in general rate case; rider/tracker: separate cost recovery surcharge; CIAC: customer-funded contribution; PPA: recovered through purchased power costs.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:decisionDate rdf:type rdf:Property ;
    rdfs:label 'Decision Date' ;
    rdfs:comment 'Date on which the PUC or FERC issued its final order approving, conditionally approving, or denying the CPCN application. Null until a final decision is rendered.' ;
    rdfs:domain ind:CpcnApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:denialReason rdf:type rdf:Property ;
    rdfs:label 'Denial Reason' ;
    rdfs:comment 'Narrative description of the regulatory agency\'s stated basis for denying the CPCN application. Null for approved or pending applications. Used for regulatory strategy analysis and re-filing preparation.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:environmentalReviewStatus rdf:type rdf:Property ;
    rdfs:label 'Environmental Review Status' ;
    rdfs:comment 'Current status of the environmental review process associated with the CPCN application. Tracks progression from initiation through draft and final publication to completion. A prerequisite for certificate issuance in most jurisdictions.' ;
    rdfs:domain ind:CpcnApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:environmentalReviewType rdf:type rdf:Property ;
    rdfs:label 'Environmental Review Type' ;
    rdfs:comment 'Type of environmental review required or completed for the project. EIS (Environmental Impact Statement) and EA (Environmental Assessment) are federal NEPA categories; CEQA applies in California; state_environmental_review covers other state-level equivalents. Drives permitting timelines and conditions of approval.' ;
    rdfs:domain ind:CpcnApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedCapexUsd rdf:type rdf:Property ;
    rdfs:label 'Estimated Capex Usd' ;
    rdfs:comment 'Total estimated capital expenditure (CAPEX) in US dollars as stated in the CPCN application. Used for rate base determination, AFUDC calculation, and prudency review. Confidential as it contains commercially sensitive cost estimates submitted in regulatory proceedings.' ;
    rdfs:domain ind:CpcnApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:evidentiaryHearingDate rdf:type rdf:Property ;
    rdfs:label 'Evidentiary Hearing Date' ;
    rdfs:comment 'Scheduled or actual date of the evidentiary hearing before the PUC or FERC administrative law judge. Null if the application is processed on the written record without a hearing.' ;
    rdfs:domain ind:CpcnApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fercSection203Flag rdf:type rdf:Property ;
    rdfs:label 'Ferc Section 203 Flag' ;
    rdfs:comment 'Indicates whether the project also requires separate authorization under Federal Power Act Section 203 (disposition of jurisdictional facilities). True if the project involves a merger, acquisition, or disposition of FERC-jurisdictional assets in addition to the state CPCN.' ;
    rdfs:domain ind:CpcnApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fuelTechnologyType rdf:type rdf:Property ;
    rdfs:label 'Fuel Technology Type' ;
    rdfs:comment 'Fuel source or generation technology type for generation projects (e.g., natural gas combined cycle, solar photovoltaic, wind, nuclear, hydro). For transmission and distribution projects, describes the primary technology (e.g., overhead line, underground cable, gas pipeline). Informs environmental review, RPS compliance, and IRP alignment. [ENUM-REF-CANDIDATE: natural_gas_cc|natural_gas_ct|nuclear|solar_pv|wind|hydro|battery_storage|overhead_transmission|underground_cable|gas_pipeline — promote to reference product]' ;
    rdfs:domain ind:CpcnApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ghgEmissionsImpactTons rdf:type rdf:Property ;
    rdfs:label 'Ghg Emissions Impact Tons' ;
    rdfs:comment 'Estimated annual greenhouse gas (GHG) emissions impact of the project in metric tons of CO2 equivalent (CO2e) as reported in the environmental review. Positive values indicate net emissions increase; negative values indicate net reduction (e.g., for renewable projects displacing fossil generation). Required for EPA and state GHG compliance reporting.' ;
    rdfs:domain ind:CpcnApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inServiceTargetDate rdf:type rdf:Property ;
    rdfs:label 'In Service Target Date' ;
    rdfs:comment 'Projected date by which the infrastructure is expected to be placed in commercial service as stated in the CPCN application. Used for IRP resource adequacy planning, RTO/ISO interconnection scheduling, and capital project milestone tracking.' ;
    rdfs:domain ind:CpcnApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:infrastructureType rdf:type rdf:Property ;
    rdfs:label 'Infrastructure Type' ;
    rdfs:comment 'Classification of the infrastructure category for which the CPCN is being sought. Determines the applicable regulatory framework, filing requirements, and reviewing authority (PUC vs. FERC). [ENUM-REF-CANDIDATE: generation|transmission|distribution|gas_pipeline|substation|storage|interconnection — promote to reference product]' ;
    rdfs:domain ind:CpcnApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:intervenorCount rdf:type rdf:Property ;
    rdfs:label 'Intervenor Count' ;
    rdfs:comment 'Number of parties that have formally intervened in the CPCN proceeding as of the most recent update. High intervenor counts indicate contested proceedings and are a leading indicator of hearing complexity and timeline risk.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:irpAlignmentFlag rdf:type rdf:Property ;
    rdfs:label 'Irp Alignment Flag' ;
    rdfs:comment 'Indicates whether the proposed project is included in the utility\'s most recently approved Integrated Resource Plan (IRP). True if the project is IRP-identified; False if it is an out-of-cycle or supplemental filing. IRP alignment is a key factor in PUC prudency review.' ;
    rdfs:domain ind:CpcnApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:jurisdictionCode rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Code' ;
    rdfs:comment 'Identifies the primary regulatory jurisdiction governing this CPCN application. FERC for interstate transmission and wholesale facilities; STATE_PUC for intrastate distribution and retail facilities; DUAL for projects requiring both federal and state authorization.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leadProjectManager rdf:type rdf:Property ;
    rdfs:label 'Lead Project Manager' ;
    rdfs:comment 'Name of the capital project manager responsible for the infrastructure project associated with this CPCN application. Links regulatory authorization tracking to project delivery accountability.' ;
    rdfs:domain ind:CpcnApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leadRegulatoryCounsel rdf:type rdf:Property ;
    rdfs:label 'Lead Regulatory Counsel' ;
    rdfs:comment 'Name of the internal or external legal counsel designated as lead attorney for the CPCN proceeding. Used for regulatory case management, document routing, and accountability tracking.' ;
    rdfs:domain ind:CpcnApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lineLengthMiles rdf:type rdf:Property ;
    rdfs:label 'Line Length Miles' ;
    rdfs:comment 'Total route length in miles for transmission lines, distribution circuits, or gas pipeline projects as stated in the CPCN application. Null for point-source generation and substation projects where applied_capacity_mw is the primary measurement.' ;
    rdfs:domain ind:CpcnApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nercBesFlag rdf:type rdf:Property ;
    rdfs:label 'Nerc Bes Flag' ;
    rdfs:comment 'Indicates whether the proposed facility meets the NERC definition of a Bulk Electric System (BES) element, triggering mandatory NERC reliability standards compliance obligations. True for transmission facilities at or above 100 kV and generation above applicable thresholds.' ;
    rdfs:domain ind:CpcnApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ppaAssociatedFlag rdf:type rdf:Property ;
    rdfs:label 'Ppa Associated Flag' ;
    rdfs:comment 'Indicates whether the CPCN application is associated with a Power Purchase Agreement (PPA) rather than a utility-owned build. True if the project involves a third-party developer under a PPA; False for utility self-build projects. Affects rate treatment and cost recovery mechanism.' ;
    rdfs:domain ind:CpcnApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rateBaseEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Rate Base Eligible Flag' ;
    rdfs:comment 'Indicates whether the project costs are expected to be included in the utility\'s regulated rate base upon completion, enabling cost recovery through customer rates. False for projects funded via CIAC (Contribution in Aid of Construction) or other non-rate-base mechanisms.' ;
    rdfs:domain ind:CpcnApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:statutoryDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Statutory Deadline Date' ;
    rdfs:comment 'The date by which the regulatory agency is statutorily required to issue a final decision on the CPCN application. Calculated from the acceptance_date based on applicable state or federal procedural rules. Used for regulatory compliance monitoring and project schedule management.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:approvedRateOfReturn rdf:type rdf:Property ;
    rdfs:label 'Approved Rate Of Return' ;
    rdfs:comment 'The overall rate of return on equity (ROE) approved by the regulatory authority in the final order, expressed as a decimal (e.g., 0.0975 for 9.75%). Null until a final order is issued or if the proceeding is not a rate case. Critical for financial planning, EBITDA projections, and investor reporting.' ;
    rdfs:domain ind:Docket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:caseManager rdf:type rdf:Property ;
    rdfs:label 'Case Manager' ;
    rdfs:comment 'Full name of the regulatory affairs case manager or project manager responsible for coordinating the utility\'s internal response, testimony preparation, and milestone tracking for this docket. Typically a regulatory affairs department employee.' ;
    rdfs:domain ind:Docket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:docketNumber rdf:type rdf:Property ;
    rdfs:label 'Docket Number' ;
    rdfs:comment 'The official externally-assigned docket or case number issued by the jurisdictional authority (e.g., PUC, FERC, NERC, EPA). This is the primary business identifier used in all regulatory correspondence, filings, and orders. Examples: FERC Docket No. ER24-1234, PUC Case No. 24-0001-EL-RDR.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:docketStatus rdf:type rdf:Property ;
    rdfs:label 'Docket Status' ;
    rdfs:comment 'Current lifecycle status of the regulatory docket or proceeding. \'open\' indicates the docket has been initiated but no active proceedings are underway; \'active\' indicates proceedings are actively ongoing; \'suspended\' indicates proceedings are temporarily halted by order or stipulation; \'closed\' indicates the proceeding has concluded with a final order or disposition; \'withdrawn\' indicates the utility voluntarily withdrew the filing.' ;
    rdfs:domain ind:Docket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedCapex rdf:type rdf:Property ;
    rdfs:label 'Estimated Capex' ;
    rdfs:comment 'The estimated capital expenditure (CAPEX) associated with the project or investment subject to this regulatory proceeding, expressed in U.S. dollars. Relevant for CPCN applications, IRP submissions, and major infrastructure rate cases. Used for prudency review tracking and AFUDC calculation. Null for proceedings not involving capital investment.' ;
    rdfs:domain ind:Docket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:finalOrderDate rdf:type rdf:Property ;
    rdfs:label 'Final Order Date' ;
    rdfs:comment 'The date on which the regulatory authority issued the final order, decision, or ruling concluding the proceeding. Null if the docket is still open or active. Used to calculate total proceeding duration, track regulatory cycle times, and trigger downstream actions such as billing system rate updates and financial reporting.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:hearingDate rdf:type rdf:Property ;
    rdfs:label 'Hearing Date' ;
    rdfs:comment 'The scheduled or actual start date of the formal evidentiary hearing before the regulatory authority or administrative law judge (ALJ). Null if no hearing is required or if the hearing has not yet been scheduled. Used for legal resource scheduling and milestone tracking.' ;
    rdfs:domain ind:Docket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:hearingRequired rdf:type rdf:Property ;
    rdfs:label 'Hearing Required' ;
    rdfs:comment 'Indicates whether the regulatory authority has ordered or is expected to require a formal evidentiary hearing (trial-type proceeding) for this docket. True if a hearing has been ordered or is anticipated; False if the proceeding is expected to be resolved on the written record. Impacts resource planning for testimony preparation and witness scheduling.' ;
    rdfs:domain ind:Docket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:irpPlanningHorizonYears rdf:type rdf:Property ;
    rdfs:label 'Irp Planning Horizon Years' ;
    rdfs:comment 'The planning horizon in years covered by an Integrated Resource Plan (IRP) submission. Typically 10, 15, or 20 years. Applicable only to IRP dockets. Used to track long-range resource adequacy planning obligations and RPS compliance trajectories. Null for non-IRP proceedings.' ;
    rdfs:domain ind:Docket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:proceedingSubtype rdf:type rdf:Property ;
    rdfs:label 'Proceeding Subtype' ;
    rdfs:comment 'Further classification within the proceeding type. For example, within a rate case: electric general rate case, gas general rate case, transmission rate case (OATT). Within tariff filings: initial tariff, tariff amendment, tariff cancellation. Provides granular categorization for reporting and analytics.' ;
    rdfs:domain ind:Docket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateCaseType rdf:type rdf:Property ;
    rdfs:label 'Rate Case Type' ;
    rdfs:comment 'Specifies the type of rate case proceeding. \'general\' is a full cost-of-service rate case; \'limited\' is a focused rate case on specific cost elements; \'formula\' is a rate case using a pre-approved formula rate mechanism (common in FERC transmission); \'pbr\' is a Performance-Based Ratemaking proceeding; \'settlement\' is a negotiated settlement rate case. Null for non-rate-case dockets.' ;
    rdfs:domain ind:Docket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestedRateOfReturn rdf:type rdf:Property ;
    rdfs:label 'Requested Rate Of Return' ;
    rdfs:comment 'The overall rate of return on equity (ROE) requested by the utility in a rate case, expressed as a decimal (e.g., 0.1050 for 10.50%). Null for non-rate-case proceedings. Used in rate case analytics, benchmarking against peer utilities, and PBR performance tracking.' ;
    rdfs:domain ind:Docket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:requestedRevenueRequirement rdf:type rdf:Property ;
    rdfs:label 'Requested Revenue Requirement' ;
    rdfs:comment 'The total annual revenue requirement requested by the utility in a rate case filing, expressed in U.S. dollars. Represents the utility\'s claimed cost of service including OPEX, CAPEX recovery (depreciation), AFUDC, taxes, and allowed return on equity (ROE). Null for non-rate-case proceedings. This is a pre-decision requested amount, not the approved amount.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rtoIsoRef rdf:type rdf:Property ;
    rdfs:label 'Rto Iso Ref' ;
    rdfs:comment 'Identifies the Regional Transmission Organization (RTO) or Independent System Operator (ISO) relevant to this docket, if applicable. Examples: PJM, MISO, CAISO, SPP, ERCOT, NYISO, ISO-NE. Relevant for FERC transmission rate cases, OATT filings, and market rule proceedings. Null for state-only or non-transmission proceedings.' ;
    rdfs:domain ind:Docket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subjectMatterSummary rdf:type rdf:Property ;
    rdfs:label 'Subject Matter Summary' ;
    rdfs:comment 'A concise narrative description of the subject matter, issues, and relief sought in the regulatory proceeding. Provides business context for users who need to understand the docket without reviewing the full filing. Sourced from the utility\'s regulatory affairs case management system or the regulatory authority\'s docket management system.' ;
    rdfs:domain ind:Docket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testYear rdf:type rdf:Property ;
    rdfs:label 'Test Year' ;
    rdfs:comment 'The test year or test period used as the basis for cost-of-service calculations in a rate case. May be a historical test year (e.g., \'2023\'), a future test year (e.g., \'2025\'), or a hybrid period (e.g., \'2023-2024\'). Null for non-rate-case proceedings. Fundamental to rate case analytics and cost allocation studies.' ;
    rdfs:domain ind:Docket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:utilityDivision rdf:type rdf:Property ;
    rdfs:label 'Utility Division' ;
    rdfs:comment 'The utility operating division or service territory to which this docket primarily applies. Distinguishes between electric distribution, gas distribution, transmission, generation, or combined proceedings. Critical for segregating regulatory obligations by business unit and for rate case cost allocation.' ;
    rdfs:domain ind:Docket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emissionsReportId rdf:type rdf:Property ;
    rdfs:label 'Emissions Report Id' ;
    rdfs:comment 'Unique surrogate identifier for each emissions report record in the Silver Layer lakehouse. Primary key for this transactional entity.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EmissionsReport .

ind:facilityId rdf:type rdf:Property ;
    rdfs:label 'Facility Id' ;
    rdfs:comment 'Reference to the generation facility or plant from which emissions are reported. Links to the asset/facility master record.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Facility .

ind:originalReportEmissionsReportId rdf:type rdf:Property ;
    rdfs:label 'Original Report Emissions Report Id' ;
    rdfs:comment 'Reference to the original emissions report record that this amended report supersedes. Populated only when amendment_indicator = True. Enables lineage tracking of report corrections and restatements.' ;
    rdfs:domain ind:EmissionsReport ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EmissionsReport .

ind:agencyConfirmationNumber rdf:type rdf:Property ;
    rdfs:label 'Agency Confirmation Number' ;
    rdfs:comment 'Confirmation or acknowledgment number issued by the regulatory agency (EPA, state air agency) upon successful receipt and acceptance of the emissions report submission. Used as proof of filing for compliance audits.' ;
    rdfs:domain ind:EmissionsReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allowanceType rdf:type rdf:Property ;
    rdfs:label 'Allowance Type' ;
    rdfs:comment 'Cap-and-trade or allowance program under which this emissions report is filed. SO2_ARP = EPA Acid Rain Program; NOx_NBP = NOx Budget Trading Program; CSAPR_NOx / CSAPR_SO2 = Cross-State Air Pollution Rule; RGGI_CO2 = Regional Greenhouse Gas Initiative; state_cap = state-specific cap program. [ENUM-REF-CANDIDATE: SO2_ARP|NOx_NBP|CSAPR_NOx|CSAPR_SO2|RGGI_CO2|state_cap|CA_AB32|other — promote to reference product]' ;
    rdfs:domain ind:EmissionsReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allowancesSurrendered rdf:type rdf:Property ;
    rdfs:label 'Allowances Surrendered' ;
    rdfs:comment 'Number of emissions allowances surrendered or retired to cover the reported emissions quantity under the applicable cap-and-trade program (e.g., EPA Acid Rain Program SO2 allowances, RGGI CO2 allowances). One allowance typically equals one ton of the regulated pollutant.' ;
    rdfs:domain ind:EmissionsReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:amendmentIndicator rdf:type rdf:Property ;
    rdfs:label 'Amendment Indicator' ;
    rdfs:comment 'Indicates whether this emissions report is an amendment (restatement) of a previously submitted report. True = this is an amended filing; False = original submission. Supports audit trail and regulatory compliance tracking.' ;
    rdfs:domain ind:EmissionsReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cemsSystemCode rdf:type rdf:Property ;
    rdfs:label 'Cems System Code' ;
    rdfs:comment 'Identifier of the Continuous Emissions Monitoring System (CEMS) used to measure emissions for this report, as registered with EPA. Applicable when measurement_methodology = CEMS. Supports audit trail and CEMS certification tracking.' ;
    rdfs:domain ind:EmissionsReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:co2eQuantityMetricTons rdf:type rdf:Property ;
    rdfs:label 'Co2e Quantity Metric Tons' ;
    rdfs:comment 'Total emissions expressed as metric tons of carbon dioxide equivalent (CO2e), calculated using IPCC global warming potential (GWP) factors. Used for aggregate GHG inventory reporting, RPS compliance, and SEC/state climate disclosure obligations.' ;
    rdfs:domain ind:EmissionsReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:emissionsIntensityLbsPerMwh rdf:type rdf:Property ;
    rdfs:label 'Emissions Intensity Lbs Per Mwh' ;
    rdfs:comment 'Emissions rate expressed as pounds of pollutant per megawatt-hour (MWh) of gross electricity generated during the reporting period. Key performance indicator for environmental compliance, RPS tracking, and EPA rate-based standards under Clean Power Plan successor rules.' ;
    rdfs:domain ind:EmissionsReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:emissionsQuantityTons rdf:type rdf:Property ;
    rdfs:label 'Emissions Quantity Tons' ;
    rdfs:comment 'Total mass of the reported pollutant emitted during the reporting period, expressed in short tons (US tons). This is the primary quantitative result for the emissions report, as required by EPA CAMD and state air quality agency submissions.' ;
    rdfs:domain ind:EmissionsReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:emissionsQuantityUnit rdf:type rdf:Property ;
    rdfs:label 'Emissions Quantity Unit' ;
    rdfs:comment 'Unit of measure for the reported emissions quantity. Short tons is the standard for EPA CAMD reporting; metric tons (MT) is used for GHG Protocol and international reporting; lbs and kg may be used for state-level criteria pollutant reporting.' ;
    rdfs:domain ind:EmissionsReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:epaFacilityCode rdf:type rdf:Property ;
    rdfs:label 'Epa Facility Code' ;
    rdfs:comment 'EPA-assigned facility identifier used in the Facility Registry Service (FRS) and Clean Air Markets Division (CAMD) systems. Required for all EPA emissions submissions under 40 CFR Part 75 and Part 98.' ;
    rdfs:domain ind:EmissionsReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:epaUnitCode rdf:type rdf:Property ;
    rdfs:label 'Epa Unit Code' ;
    rdfs:comment 'EPA-assigned unit identifier for the specific combustion or generation unit within the facility, as registered in the EPA Clean Air Markets Division (CAMD) Business System. Used for unit-level emissions tracking and compliance.' ;
    rdfs:domain ind:EmissionsReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ghgScope rdf:type rdf:Property ;
    rdfs:label 'Ghg Scope' ;
    rdfs:comment 'GHG Protocol scope classification for the reported emissions. Scope 1 = direct emissions from owned/controlled sources (combustion); Scope 2 = indirect emissions from purchased electricity/heat; Scope 3 = other indirect value chain emissions. Required for corporate GHG inventory and SEC climate disclosure.' ;
    rdfs:domain ind:EmissionsReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measurementMethodology rdf:type rdf:Property ;
    rdfs:label 'Measurement Methodology' ;
    rdfs:comment 'Method used to quantify emissions for this report. CEMS = Continuous Emissions Monitoring System (direct measurement per 40 CFR Part 75); fuel_factor = EPA-approved fuel emission factor method; mass_balance = material balance calculation; engineering_estimate = approved engineering estimation method for missing data substitution.' ;
    rdfs:domain ind:EmissionsReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:missingDataHours rdf:type rdf:Property ;
    rdfs:label 'Missing Data Hours' ;
    rdfs:comment 'Number of operating hours during the reporting period for which CEMS data was unavailable and EPA-approved missing data substitution procedures were applied per 40 CFR Part 75 Subpart D. Regulatory threshold triggers enhanced scrutiny if exceeded.' ;
    rdfs:domain ind:EmissionsReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:noxRateLbsPerMmbtu rdf:type rdf:Property ;
    rdfs:label 'Nox Rate Lbs Per Mmbtu' ;
    rdfs:comment 'Nitrogen oxides (NOx) emission rate expressed as pounds per million British thermal units (lbs/MMBtu) of heat input. Required for EPA CAMD quarterly reporting and NOx Budget Trading Program compliance. Distinct from the aggregate emissions_intensity_lbs_per_mwh field.' ;
    rdfs:domain ind:EmissionsReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Deadline Date' ;
    rdfs:comment 'Regulatory deadline by which this emissions report must be submitted to the applicable agency. Used to monitor on-time compliance and flag late submissions for regulatory risk management.' ;
    rdfs:domain ind:EmissionsReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportNotes rdf:type rdf:Property ;
    rdfs:label 'Report Notes' ;
    rdfs:comment 'Free-text field for supplemental notes, explanations of anomalies, missing data justifications, or regulatory correspondence references associated with this emissions report. Used by compliance staff to document context for auditors and regulators.' ;
    rdfs:domain ind:EmissionsReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportNumber rdf:type rdf:Property ;
    rdfs:label 'Report Number' ;
    rdfs:comment 'Externally-known business identifier assigned to this emissions report submission, used for tracking with EPA or state air quality agency. Corresponds to the submission tracking number in EPA\'s Electronic Reporting Tool or state equivalent.' ;
    rdfs:domain ind:EmissionsReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingAgency rdf:type rdf:Property ;
    rdfs:label 'Reporting Agency' ;
    rdfs:comment 'Regulatory agency or body to which this emissions report is submitted. EPA = U.S. Environmental Protection Agency (federal); state_air_agency = state environmental/air quality agency; FERC = Federal Energy Regulatory Commission; NERC = North American Electric Reliability Corporation; DOE_EIA = U.S. Department of Energy / Energy Information Administration.' ;
    rdfs:domain ind:EmissionsReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Reporting Period End Date' ;
    rdfs:comment 'End date of the emissions reporting period. Combined with reporting_period_start_date to define the measurement window for this report.' ;
    rdfs:domain ind:EmissionsReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportingPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Reporting Period Start Date' ;
    rdfs:comment 'Start date of the emissions reporting period (e.g., calendar year start, quarter start, or compliance period start). Combined with reporting_period_end_date to define the measurement window.' ;
    rdfs:domain ind:EmissionsReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportingPeriodType rdf:type rdf:Property ;
    rdfs:label 'Reporting Period Type' ;
    rdfs:comment 'Classification of the reporting period granularity: annual (calendar year), quarterly, monthly, or compliance_period (custom regulatory compliance window). Determines submission frequency and applicable regulatory deadlines.' ;
    rdfs:domain ind:EmissionsReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:so2RateLbsPerMmbtu rdf:type rdf:Property ;
    rdfs:label 'So2 Rate Lbs Per Mmbtu' ;
    rdfs:comment 'Sulfur dioxide (SO2) emission rate expressed as pounds per million British thermal units (lbs/MMBtu) of heat input. Required for EPA Acid Rain Program (ARP) compliance and CAMD quarterly reporting under 40 CFR Part 75.' ;
    rdfs:domain ind:EmissionsReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stateFacilityPermitNumber rdf:type rdf:Property ;
    rdfs:label 'State Facility Permit Number' ;
    rdfs:comment 'State-issued air quality operating permit number (Title V or minor source permit) for the facility, as assigned by the state environmental or air quality agency. Required for state-level emissions reporting submissions.' ;
    rdfs:domain ind:EmissionsReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionDate rdf:type rdf:Property ;
    rdfs:label 'Submission Date' ;
    rdfs:comment 'Date on which the emissions report was submitted to the regulatory agency. Used to verify compliance with regulatory submission deadlines and to support prudency reviews.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:submissionStatus rdf:type rdf:Property ;
    rdfs:label 'Submission Status' ;
    rdfs:comment 'Current lifecycle status of the emissions report submission to the regulatory agency. draft = in preparation; submitted = transmitted to agency; accepted = agency confirmed receipt and validity; rejected = agency returned with errors; under_review = agency is reviewing; amended = resubmitted after correction.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verifiedIndicator rdf:type rdf:Property ;
    rdfs:label 'Verified Indicator' ;
    rdfs:comment 'Indicates whether the emissions data in this report has been independently verified by a third-party verifier, as required under certain state GHG programs (e.g., California AB 32, RGGI). True = verified; False = not yet verified or not required.' ;
    rdfs:domain ind:EmissionsReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:verifierName rdf:type rdf:Property ;
    rdfs:label 'Verifier Name' ;
    rdfs:comment 'Name of the accredited third-party verification body that reviewed and verified the emissions data. Populated when verified_indicator = True. Required for California ARB and RGGI compliance submissions.' ;
    rdfs:domain ind:EmissionsReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersededByFilingId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Filing Id' ;
    rdfs:comment 'Reference to the filing_id of the subsequent filing that replaces this one when filing_status is \'superseded\'. Enables traceability of the amendment chain and identification of the current authoritative version of a filing.' ;
    rdfs:domain ind:Filing ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Filing .

ind:acceptedDate rdf:type rdf:Property ;
    rdfs:label 'Accepted Date' ;
    rdfs:comment 'Date on which the regulatory body formally accepted and docketed the filing. Distinct from the filing date; acceptance triggers statutory response deadlines and effective date calculations for tariff filings.' ;
    rdfs:domain ind:Filing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:confidentialityDesignation rdf:type rdf:Property ;
    rdfs:label 'Confidentiality Designation' ;
    rdfs:comment 'Data classification level assigned to the filing document, governing access controls and public disclosure obligations. \'public\' filings are available on the regulatory body\'s public docket; \'confidential\' filings are subject to protective order or CEII (Critical Energy Infrastructure Information) designation; \'restricted\' filings contain highly sensitive operational or security data.' ;
    rdfs:domain ind:Filing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crossExaminationDate rdf:type rdf:Property ;
    rdfs:label 'Cross Examination Date' ;
    rdfs:comment 'Scheduled date on which the witness is available for cross-examination by parties to the proceeding. Populated for testimony filings as part of the hearing schedule management. Null for non-testimony filings.' ;
    rdfs:domain ind:Filing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:documentTitle rdf:type rdf:Property ;
    rdfs:label 'Document Title' ;
    rdfs:comment 'Official title of the filed document as it appears on the submission (e.g., \'Application for Certificate of Public Convenience and Necessity\', \'Direct Testimony of Jane Doe on Revenue Requirement\', \'Annual FERC Form 1 Report\').' ;
    rdfs:domain ind:Filing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentUrl rdf:type rdf:Property ;
    rdfs:label 'Document Url' ;
    rdfs:comment 'Uniform Resource Locator (URL) or document management system path pointing to the filed document in the utility\'s internal document repository or the regulatory body\'s public docket system. Enables direct retrieval of the source document.' ;
    rdfs:domain ind:Filing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:epaRegulationCitation rdf:type rdf:Property ;
    rdfs:label 'Epa Regulation Citation' ;
    rdfs:comment 'Citation to the specific U.S. Environmental Protection Agency (EPA) regulation or rule (e.g., 40 CFR Part 75 for acid rain emissions, Clean Air Act Section 111(d)) under which this filing is submitted. Populated for EPA emissions reports and environmental compliance filings.' ;
    rdfs:domain ind:Filing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exhibitList rdf:type rdf:Property ;
    rdfs:label 'Exhibit List' ;
    rdfs:comment 'Comma-separated or delimited list of exhibit identifiers (e.g., Exhibit A, Exhibit 1, Schedule 1) attached to or sponsored by this filing. Captures the evidentiary exhibit inventory associated with the submission for record completeness.' ;
    rdfs:domain ind:Filing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filerName rdf:type rdf:Property ;
    rdfs:label 'Filer Name' ;
    rdfs:comment 'Legal name of the entity or individual submitting the filing to the regulatory body. Typically the utility\'s legal entity name, but may be an attorney, consultant, or authorized representative filing on behalf of the utility.' ;
    rdfs:domain ind:Filing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filerRole rdf:type rdf:Property ;
    rdfs:label 'Filer Role' ;
    rdfs:comment 'Designates the capacity in which the filer is participating in the proceeding. Distinguishes utility filings from intervenor, PUC staff, or independent expert submissions within the same docket.' ;
    rdfs:domain ind:Filing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingDescription rdf:type rdf:Property ;
    rdfs:label 'Filing Description' ;
    rdfs:comment 'Free-text narrative description of the filing\'s purpose, scope, and key provisions. Provides regulatory affairs staff and analysts with a plain-language summary of what the filing accomplishes and its significance to the utility\'s regulatory program.' ;
    rdfs:domain ind:Filing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingNumber rdf:type rdf:Property ;
    rdfs:label 'Filing Number' ;
    rdfs:comment 'Externally assigned document reference number issued by the regulatory body upon acceptance of the filing (e.g., FERC accession number, PUC filing number). Serves as the official public identifier for the submission.' ;
    rdfs:domain ind:Filing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingType rdf:type rdf:Property ;
    rdfs:label 'Filing Type' ;
    rdfs:comment 'Classification of the regulatory submission by its formal document category. Distinguishes the nature and purpose of the filing within the regulatory proceeding. [ENUM-REF-CANDIDATE: initial_application|testimony|exhibit|compliance_filing|annual_report|nerc_reliability_standard|epa_emissions_report|tariff_filing|rate_case|cpcn_application|irp_submission|errata — promote to reference product]' ;
    rdfs:domain ind:Filing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ghgReportingPeriodEnd rdf:type rdf:Property ;
    rdfs:label 'Ghg Reporting Period End' ;
    rdfs:comment 'End date of the greenhouse gas (GHG) emissions reporting period covered by this filing. Together with ghg_reporting_period_start, defines the compliance reporting window for EPA GHG submissions.' ;
    rdfs:domain ind:Filing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ghgReportingPeriodStart rdf:type rdf:Property ;
    rdfs:label 'Ghg Reporting Period Start' ;
    rdfs:comment 'Start date of the greenhouse gas (GHG) emissions reporting period covered by this filing. Applicable to EPA GHG emissions reports and environmental compliance submissions under the Clean Air Act.' ;
    rdfs:domain ind:Filing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:internalReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Internal Reference Number' ;
    rdfs:comment 'Utility-assigned internal tracking number for the filing, used to cross-reference the submission in internal document management and regulatory affairs systems prior to or independent of the regulatory body\'s assigned number.' ;
    rdfs:domain ind:Filing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isTestimony rdf:type rdf:Property ;
    rdfs:label 'Is Testimony' ;
    rdfs:comment 'Flag indicating whether this filing is a formal witness testimony submission (direct, rebuttal, surrebuttal, or errata testimony) as opposed to a non-testimony filing such as an application, exhibit, or compliance report. Drives testimony-specific attribute population.' ;
    rdfs:domain ind:Filing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nercStandardNumber rdf:type rdf:Property ;
    rdfs:label 'Nerc Standard Number' ;
    rdfs:comment 'Identifier of the North American Electric Reliability Corporation (NERC) reliability standard (e.g., CIP-002, FAC-001, TPL-001) to which this filing pertains. Populated for NERC compliance filings and reliability standard submissions.' ;
    rdfs:domain ind:Filing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pageCount rdf:type rdf:Property ;
    rdfs:label 'Page Count' ;
    rdfs:comment 'Total number of pages in the filed document. Used for document management, completeness verification, and regulatory record-keeping.' ;
    rdfs:domain ind:Filing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pbrMechanismFlag rdf:type rdf:Property ;
    rdfs:label 'Pbr Mechanism Flag' ;
    rdfs:comment 'Indicates whether this filing involves or establishes a performance-based ratemaking (PBR) mechanism, linking utility revenue or earnings to performance metrics such as reliability (SAIDI/SAIFI), customer satisfaction, or clean energy targets.' ;
    rdfs:domain ind:Filing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:prudencyReviewFlag rdf:type rdf:Property ;
    rdfs:label 'Prudency Review Flag' ;
    rdfs:comment 'Indicates whether this filing is subject to a regulatory prudency review of capital expenditures or operational costs. Prudency reviews assess whether utility expenditures were made in a reasonable and prudent manner for cost recovery purposes.' ;
    rdfs:domain ind:Filing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rateCaseYear rdf:type rdf:Property ;
    rdfs:label 'Rate Case Year' ;
    rdfs:comment 'The test year or rate case year associated with this filing, representing the calendar or fiscal year for which rates or revenue requirements are being established. Applicable to rate case filings, IRP submissions, and annual reports.' ;
    rdfs:domain ind:Filing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:requestedRateIncreasePct rdf:type rdf:Property ;
    rdfs:label 'Requested Rate Increase Pct' ;
    rdfs:comment 'Percentage rate increase requested in this filing relative to currently approved rates. Applicable to rate case and tariff amendment filings. Used for regulatory impact analysis and public reporting.' ;
    rdfs:domain ind:Filing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:responseDueDate rdf:type rdf:Property ;
    rdfs:label 'Response Due Date' ;
    rdfs:comment 'Deadline by which the utility or other parties must respond to a regulatory body\'s data request, deficiency letter, or order related to this filing. Critical for compliance deadline tracking and regulatory calendar management.' ;
    rdfs:domain ind:Filing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:testimonySubject rdf:type rdf:Property ;
    rdfs:label 'Testimony Subject' ;
    rdfs:comment 'Describes the primary regulatory topic addressed by the testimony. Common subjects include revenue requirement, rate design, capital structure, depreciation, demand forecast, cost of capital, performance-based ratemaking (PBR), and demand-side management (DSM). Null for non-testimony filings. [ENUM-REF-CANDIDATE: revenue_requirement|rate_design|capital_structure|depreciation|demand_forecast|cost_of_capital|pbr|dsm|ghg_compliance|fuel_adjustment — promote to reference product]' ;
    rdfs:domain ind:Filing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:testimonyType rdf:type rdf:Property ;
    rdfs:label 'Testimony Type' ;
    rdfs:comment 'For testimony filings, classifies the stage of the evidentiary record at which the testimony is submitted. \'direct\' is the initial witness statement; \'rebuttal\' responds to opposing direct testimony; \'surrebuttal\' responds to rebuttal testimony; \'errata\' corrects errors in previously filed testimony. Null for non-testimony filings.' ;
    rdfs:domain ind:Filing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:witnessAffiliation rdf:type rdf:Property ;
    rdfs:label 'Witness Affiliation' ;
    rdfs:comment 'Organizational affiliation of the testifying witness, indicating which party in the proceeding the witness represents. Distinguishes utility witnesses from intervenor, PUC staff, and independent expert witnesses for evidentiary record management.' ;
    rdfs:domain ind:Filing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:witnessName rdf:type rdf:Property ;
    rdfs:label 'Witness Name' ;
    rdfs:comment 'Full name of the expert witness sponsoring the testimony filing. Populated only for testimony-type filings. Used to track the evidentiary record and cross-examination schedule in rate cases and contested proceedings.' ;
    rdfs:domain ind:Filing ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alternativeScenariosCount rdf:type rdf:Property ;
    rdfs:label 'Alternative Scenarios Count' ;
    rdfs:comment 'The number of alternative resource portfolio scenarios evaluated and documented in the IRP filing, beyond the preferred plan (e.g., high renewable, high gas, high EE scenarios).' ;
    rdfs:domain ind:IrpSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:alternativeScenariosDescription rdf:type rdf:Property ;
    rdfs:label 'Alternative Scenarios Description' ;
    rdfs:comment 'Narrative summary of the alternative resource portfolio scenarios evaluated in the IRP, including key assumptions and distinguishing characteristics of each scenario.' ;
    rdfs:domain ind:IrpSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Dr Capacity Mw' ;
    rdfs:comment 'Total Demand Response (DR) capacity in Megawatts (MW) included in the preferred resource portfolio, representing load curtailment and peak shaving programs available to meet resource adequacy requirements.' ;
    rdfs:domain ind:IrpSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eeSavingsMw rdf:type rdf:Property ;
    rdfs:label 'Ee Savings Mw' ;
    rdfs:comment 'Total Energy Efficiency (EE) program savings in Megawatts (MW) of peak demand reduction included in the preferred resource portfolio, representing avoided capacity from DSM programs.' ;
    rdfs:domain ind:IrpSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fossilCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Fossil Capacity Mw' ;
    rdfs:comment 'Total installed or planned fossil fuel generation capacity (coal, natural gas CT/CC, oil) in Megawatts (MW) included in the preferred resource portfolio at the end of the planning horizon.' ;
    rdfs:domain ind:IrpSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ghgEmissionsTargetTons rdf:type rdf:Property ;
    rdfs:label 'Ghg Emissions Target Tons' ;
    rdfs:comment 'The GHG emissions reduction target in metric tons of CO2 equivalent (CO2e) for the utility\'s generation portfolio at the end of the planning horizon, as required by state climate policy or PUC order.' ;
    rdfs:domain ind:IrpSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:irpApprovalCondition rdf:type rdf:Property ;
    rdfs:label 'Irp Approval Condition' ;
    rdfs:comment 'Description of any conditions, modifications, or compliance requirements attached to the PUC\'s approval of the IRP, such as required supplemental filings, program modifications, or reporting obligations.' ;
    rdfs:domain ind:IrpSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:irpConsultantName rdf:type rdf:Property ;
    rdfs:label 'Irp Consultant Name' ;
    rdfs:comment 'Name of the external consulting firm or advisor engaged to support development of the IRP, if applicable. Relevant for procurement transparency and regulatory disclosure.' ;
    rdfs:domain ind:IrpSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:irpDocumentReference rdf:type rdf:Property ;
    rdfs:label 'Irp Document Reference' ;
    rdfs:comment 'File path, document management system reference, or URL pointing to the official IRP filing document(s) stored in the utility\'s document management system or the PUC\'s electronic filing system.' ;
    rdfs:domain ind:IrpSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:irpType rdf:type rdf:Property ;
    rdfs:label 'Irp Type' ;
    rdfs:comment 'Classifies the nature of the IRP submission: full plan (complete new IRP cycle), update (periodic progress update to an existing IRP), or amendment (correction or modification to a previously filed IRP).' ;
    rdfs:domain ind:IrpSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:irpVersionNumber rdf:type rdf:Property ;
    rdfs:label 'Irp Version Number' ;
    rdfs:comment 'Version identifier for the IRP document, used to distinguish successive drafts, amendments, or errata filings within the same plan cycle year (e.g., v1.0, v1.1, v2.0).' ;
    rdfs:domain ind:IrpSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isRpsCompliant rdf:type rdf:Property ;
    rdfs:label 'Is Rps Compliant' ;
    rdfs:comment 'Indicates whether the preferred resource plan as filed demonstrates compliance with the applicable state Renewable Portfolio Standard (RPS) target for the planning horizon end year. True if compliant, False if a compliance gap exists.' ;
    rdfs:domain ind:IrpSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:loadForecastMethodology rdf:type rdf:Property ;
    rdfs:label 'Load Forecast Methodology' ;
    rdfs:comment 'Description of the methodology used to develop the long-range load forecast underpinning the IRP, including econometric models, weather normalization approach, and EV/DER adoption assumptions.' ;
    rdfs:domain ind:IrpSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nercReliabilityStandardRef rdf:type rdf:Property ;
    rdfs:label 'Nerc Reliability Standard Ref' ;
    rdfs:comment 'Reference to the applicable NERC reliability standard(s) (e.g., TPL-001-4, BAL-502) that inform the resource adequacy and planning reserve margin requirements addressed in this IRP.' ;
    rdfs:domain ind:IrpSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextUpdateDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Update Due Date' ;
    rdfs:comment 'The date by which the utility is required to file the next IRP update or full plan revision, as mandated by the applicable PUC order or statute.' ;
    rdfs:domain ind:IrpSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nuclearCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Nuclear Capacity Mw' ;
    rdfs:comment 'Total installed or planned nuclear generation capacity in Megawatts (MW) included in the preferred resource portfolio at the end of the planning horizon.' ;
    rdfs:domain ind:IrpSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:peakDemandForecastMw rdf:type rdf:Property ;
    rdfs:label 'Peak Demand Forecast Mw' ;
    rdfs:comment 'Total forecasted system peak demand in Megawatts (MW) at the end of the planning horizon, representing the maximum load the utility must be capable of serving. Core resource adequacy metric.' ;
    rdfs:domain ind:IrpSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:planCycleYear rdf:type rdf:Property ;
    rdfs:label 'Plan Cycle Year' ;
    rdfs:comment 'The calendar year in which this IRP cycle is initiated, typically corresponding to the year of filing. Used to distinguish successive IRP cycles (e.g., 2022, 2025, 2028).' ;
    rdfs:domain ind:IrpSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:planningHorizonYears rdf:type rdf:Property ;
    rdfs:label 'Planning Horizon Years' ;
    rdfs:comment 'The number of years covered by the IRP\'s forward-looking resource adequacy analysis, typically 10 to 20 years. Defines the temporal scope of the resource portfolio projections.' ;
    rdfs:domain ind:IrpSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ppaCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Ppa Capacity Mw' ;
    rdfs:comment 'Total generation capacity in Megawatts (MW) to be procured through Power Purchase Agreements (PPAs) as part of the preferred resource plan, as opposed to utility-owned generation.' ;
    rdfs:domain ind:IrpSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preferredPlanDescription rdf:type rdf:Property ;
    rdfs:label 'Preferred Plan Description' ;
    rdfs:comment 'Narrative description of the utility\'s preferred resource plan, summarizing the selected portfolio of generation, storage, DR, and EE resources that best meets reliability, cost, and policy objectives over the planning horizon.' ;
    rdfs:domain ind:IrpSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publicCommentPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Public Comment Period End Date' ;
    rdfs:comment 'The date on which the public comment period for the IRP filing closes, as established by the PUC procedural schedule. After this date, no new public comments are accepted.' ;
    rdfs:domain ind:IrpSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:pucAcknowledgmentDate rdf:type rdf:Property ;
    rdfs:label 'Puc Acknowledgment Date' ;
    rdfs:comment 'The date on which the state PUC or energy authority formally acknowledged receipt and completeness of the IRP filing, initiating the official review period.' ;
    rdfs:domain ind:IrpSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryAuthorityName rdf:type rdf:Property ;
    rdfs:label 'Regulatory Authority Name' ;
    rdfs:comment 'Full name of the state PUC, energy office, or other regulatory authority to which the IRP is submitted (e.g., California Public Utilities Commission, New York Public Service Commission).' ;
    rdfs:domain ind:IrpSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewableCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Renewable Capacity Mw' ;
    rdfs:comment 'Total installed or planned renewable generation capacity (solar, wind, hydro, geothermal, biomass) in Megawatts (MW) in the preferred resource portfolio at the end of the planning horizon.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reserveMarginPct rdf:type rdf:Property ;
    rdfs:label 'Reserve Margin Pct' ;
    rdfs:comment 'The planning reserve margin percentage above forecasted peak demand required to ensure resource adequacy, expressed as a percentage (e.g., 15.0 for 15%). Typically set by the RTO/ISO or state PUC.' ;
    rdfs:domain ind:IrpSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rpsCompliancePct rdf:type rdf:Property ;
    rdfs:label 'Rps Compliance Pct' ;
    rdfs:comment 'The projected Renewable Portfolio Standard (RPS) compliance percentage achieved by the preferred resource plan at the end of the planning horizon, expressed as a percentage of total retail electricity sales from eligible renewable sources.' ;
    rdfs:domain ind:IrpSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rpsTargetPct rdf:type rdf:Property ;
    rdfs:label 'Rps Target Pct' ;
    rdfs:comment 'The mandated RPS target percentage that the utility must achieve by the end of the planning horizon, as established by state statute or PUC order.' ;
    rdfs:domain ind:IrpSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:storageCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Storage Capacity Mw' ;
    rdfs:comment 'Total installed or planned energy storage capacity in Megawatts (MW) included in the preferred resource portfolio, including battery storage and pumped hydro.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalCapexForecastUsd rdf:type rdf:Property ;
    rdfs:label 'Total Capex Forecast Usd' ;
    rdfs:comment 'Total projected Capital Expenditure (CAPEX) in U.S. dollars required to implement the preferred resource plan over the planning horizon, as presented in the IRP filing.' ;
    rdfs:domain ind:IrpSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalOpexForecastUsd rdf:type rdf:Property ;
    rdfs:label 'Total Opex Forecast Usd' ;
    rdfs:comment 'Total projected Operating Expenditure (OPEX) in U.S. dollars associated with the preferred resource plan over the planning horizon, as presented in the IRP filing.' ;
    rdfs:domain ind:IrpSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:utilityCode rdf:type rdf:Property ;
    rdfs:label 'Utility Code' ;
    rdfs:comment 'Reference to the utility legal entity or operating company filing the IRP. Supports multi-utility or holding company structures where multiple operating companies may file separate IRPs.' ;
    rdfs:domain ind:IrpSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:associatedProjectCapexProjectId rdf:type rdf:Property ;
    rdfs:label 'Associated Project Capex Project Id' ;
    rdfs:comment 'Reference identifier for the capital project or work order in the Enterprise Asset Management (EAM) system (Oracle WAM or IBM Maximo) whose expenditures are under prudency review. Enables traceability from regulatory review to the originating capital project record.' ;
    rdfs:domain ind:PrudencyReview ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CapexProject .

ind:finalOrderCommissionOrderId rdf:type rdf:Property ;
    rdfs:label 'Final Order Commission Order Id' ;
    rdfs:comment 'Foreign key linking to regulatory.commission_order. Business justification: Prudency reviews conclude with a final determination issued via commission order. The prudency_review table should reference the commission_order that contains the final determination. This links the ' ;
    rdfs:domain ind:PrudencyReview ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CommissionOrder .

ind:reviewPeriodFinancialPeriodId rdf:type rdf:Property ;
    rdfs:label 'Review Period Financial Period Id' ;
    rdfs:comment 'Foreign key linking to finance.financial_period. Business justification: Prudency reviews examine costs incurred during specific financial periods (review_period_start/end_date). Regulatory affairs and finance jointly analyze expenditures by financial period to prepare pru' ;
    rdfs:domain ind:PrudencyReview ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinancialPeriod .

ind:afudcImpactAmt rdf:type rdf:Property ;
    rdfs:label 'Afudc Impact Amt' ;
    rdfs:comment 'Dollar amount of Allowance for Funds Used During Construction (AFUDC) associated with the capital expenditures under review. Relevant for capital project prudency reviews where AFUDC capitalization is also subject to reasonableness evaluation.' ;
    rdfs:domain ind:PrudencyReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:appealFilingDate rdf:type rdf:Property ;
    rdfs:label 'Appeal Filing Date' ;
    rdfs:comment 'Date on which the appeal or request for rehearing of the prudency determination was filed. Null if appeal_indicator is False.' ;
    rdfs:domain ind:PrudencyReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appealIndicator rdf:type rdf:Property ;
    rdfs:label 'Appeal Indicator' ;
    rdfs:comment 'Indicates whether the utility or any party has filed an appeal or request for rehearing of the final prudency determination. True if an appeal is pending or has been filed; False otherwise.' ;
    rdfs:domain ind:PrudencyReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:approvedRecoveryAmt rdf:type rdf:Property ;
    rdfs:label 'Approved Recovery Amt' ;
    rdfs:comment 'Final dollar amount of expenditures approved for cost recovery from ratepayers per the final regulatory determination. Equals total_expenditure_under_review_amt minus disallowed_amt. Satisfies TRANSACTION_HEADER MONETARY_TRIPLET net total category.' ;
    rdfs:domain ind:PrudencyReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capexUnderReviewAmt rdf:type rdf:Property ;
    rdfs:label 'Capex Under Review Amt' ;
    rdfs:comment 'Total capital expenditure (CAPEX) amount in USD submitted for prudency review. Represents the gross plant investment being evaluated for reasonableness and cost recovery eligibility. Null if review covers only O&M or fuel costs.' ;
    rdfs:domain ind:PrudencyReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disallowedAmt rdf:type rdf:Property ;
    rdfs:label 'Disallowed Amt' ;
    rdfs:comment 'Final dollar amount of expenditures disallowed from rate base or cost recovery per the final regulatory determination. Represents the imprudent portion that the utility must absorb and cannot recover from ratepayers. Satisfies TRANSACTION_HEADER MONETARY_TRIPLET adjustment category.' ;
    rdfs:domain ind:PrudencyReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:finalDetermination rdf:type rdf:Property ;
    rdfs:label 'Final Determination' ;
    rdfs:comment 'The final regulatory determination on the prudency of the expenditures under review. Prudent allows full cost recovery; Imprudent disallows costs from rate base; Partially Prudent allows partial recovery; Settled indicates a negotiated resolution; Withdrawn indicates the review was dropped.' ;
    rdfs:domain ind:PrudencyReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:finalDeterminationDate rdf:type rdf:Property ;
    rdfs:label 'Final Determination Date' ;
    rdfs:comment 'Date on which the regulatory body issued its final order or determination on the prudency review. Marks the conclusion of the review proceeding and triggers cost recovery or disallowance accounting entries.' ;
    rdfs:domain ind:PrudencyReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fuelCostUnderReviewAmt rdf:type rdf:Property ;
    rdfs:label 'Fuel Cost Under Review Amt' ;
    rdfs:comment 'Total fuel procurement cost in USD submitted for prudency review under a Fuel Adjustment Clause (FAC) proceeding. Covers fossil fuel, purchased power, and gas supply costs. Null if review does not involve fuel cost prudency.' ;
    rdfs:domain ind:PrudencyReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:initiationDate rdf:type rdf:Property ;
    rdfs:label 'Initiation Date' ;
    rdfs:comment 'The date on which the prudency review was formally initiated by the regulatory body or triggered by a docket filing. Represents the principal real-world business event timestamp (date precision). Satisfies TRANSACTION_HEADER BUSINESS_EVENT_TIMESTAMP category.' ;
    rdfs:domain ind:PrudencyReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:intervenorIndicator rdf:type rdf:Property ;
    rdfs:label 'Intervenor Indicator' ;
    rdfs:comment 'Indicates whether one or more intervenors (e.g., ratepayer advocates, industrial customers, environmental groups) formally participated in the prudency review proceeding. True if intervenors are present; False if the review is conducted solely by commission staff.' ;
    rdfs:domain ind:PrudencyReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:opexUnderReviewAmt rdf:type rdf:Property ;
    rdfs:label 'Opex Under Review Amt' ;
    rdfs:comment 'Total operating expenditure (OPEX) / O&M cost amount in USD submitted for prudency review. Represents the operating costs being evaluated for reasonableness. Null if review covers only capital or fuel costs.' ;
    rdfs:domain ind:PrudencyReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preliminaryDisallowedAmt rdf:type rdf:Property ;
    rdfs:label 'Preliminary Disallowed Amt' ;
    rdfs:comment 'Dollar amount of expenditures preliminarily identified as imprudent and proposed for disallowance from rate base or cost recovery by the reviewing body. May be revised in the final determination.' ;
    rdfs:domain ind:PrudencyReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preliminaryFinding rdf:type rdf:Property ;
    rdfs:label 'Preliminary Finding' ;
    rdfs:comment 'The initial finding issued by the reviewing body prior to the final determination. Indicates whether expenditures appear prudent, imprudent, or partially prudent based on preliminary staff analysis. May differ from the final determination after hearings and rebuttal testimony.' ;
    rdfs:domain ind:PrudencyReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preliminaryFindingDate rdf:type rdf:Property ;
    rdfs:label 'Preliminary Finding Date' ;
    rdfs:comment 'Date on which the reviewing body issued its preliminary finding. Used to track regulatory timeline milestones and compliance with procedural deadlines.' ;
    rdfs:domain ind:PrudencyReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reviewNotes rdf:type rdf:Property ;
    rdfs:label 'Review Notes' ;
    rdfs:comment 'Free-text field for additional context, regulatory staff comments, utility responses, or procedural notes relevant to the prudency review. Used for internal tracking and regulatory correspondence documentation.' ;
    rdfs:domain ind:PrudencyReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewNumber rdf:type rdf:Property ;
    rdfs:label 'Review Number' ;
    rdfs:comment 'Externally-known alphanumeric identifier assigned by the regulatory body or internal tracking system to uniquely reference this prudency review (e.g., PR-2024-0042). Used in regulatory correspondence, testimony, and filings. Satisfies TRANSACTION_HEADER BUSINESS_IDENTIFIER category.' ;
    rdfs:domain ind:PrudencyReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Review Period End Date' ;
    rdfs:comment 'End date of the expenditure period under review. Defines the close of the time window for which costs are being evaluated for prudency.' ;
    rdfs:domain ind:PrudencyReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reviewPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Review Period Start Date' ;
    rdfs:comment 'Start date of the expenditure period under review. Defines the beginning of the time window for which costs are being evaluated for prudency.' ;
    rdfs:domain ind:PrudencyReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reviewStatus rdf:type rdf:Property ;
    rdfs:label 'Review Status' ;
    rdfs:comment 'Current lifecycle state of the prudency review workflow. Progresses from initiated through in-progress, preliminary finding, final determination, and closure. Satisfies TRANSACTION_HEADER LIFECYCLE_STATUS category.' ;
    rdfs:domain ind:PrudencyReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewType rdf:type rdf:Property ;
    rdfs:label 'Review Type' ;
    rdfs:comment 'Classification of the prudency review by the category of expenditure under examination. Capital Project prudency evaluates CAPEX reasonableness; O&M Expenditure covers operating costs; Fuel Cost covers FAC-related fuel procurement; Storm Cost Recovery covers major storm restoration costs; General Management Audit covers broad operational spending. Satisfies TRANSACTION_HEADER LIFECYCLE_STATUS classification dimension.' ;
    rdfs:domain ind:PrudencyReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewingBody rdf:type rdf:Property ;
    rdfs:label 'Reviewing Body' ;
    rdfs:comment 'The party or organization conducting the prudency review — e.g., PUC Staff, FERC Staff, an independent auditor appointed by the commission, or Office of Attorney General staff. Satisfies TRANSACTION_HEADER PARTY_REFERENCE category (regulatory reviewer as the counterparty).' ;
    rdfs:domain ind:PrudencyReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewingBodyName rdf:type rdf:Property ;
    rdfs:label 'Reviewing Body Name' ;
    rdfs:comment 'Full legal or organizational name of the entity conducting the prudency review (e.g., \'California Public Utilities Commission Division of Ratepayer Advocates\', \'Navigant Consulting Inc.\'). Complements reviewing_body code with a human-readable label for reporting and correspondence.' ;
    rdfs:domain ind:PrudencyReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scopeDescription rdf:type rdf:Property ;
    rdfs:label 'Scope Description' ;
    rdfs:comment 'Narrative description of the scope of the prudency review, including the specific projects, programs, time periods, and expenditure categories under examination. Provides context for regulatory testimony and rate case filings.' ;
    rdfs:domain ind:PrudencyReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementIndicator rdf:type rdf:Property ;
    rdfs:label 'Settlement Indicator' ;
    rdfs:comment 'Indicates whether the prudency review was resolved through a negotiated settlement agreement rather than a litigated final order. True if settled; False if resolved by contested commission order.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:totalExpenditureUnderReviewAmt rdf:type rdf:Property ;
    rdfs:label 'Total Expenditure Under Review Amt' ;
    rdfs:comment 'Aggregate total expenditure in USD across all cost categories (CAPEX + OPEX + fuel) submitted for prudency review. This is the gross amount subject to the regulatory determination. Satisfies TRANSACTION_HEADER MONETARY_TRIPLET gross-base amount category.' ;
    rdfs:domain ind:PrudencyReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:utilityWitnessName rdf:type rdf:Property ;
    rdfs:label 'Utility Witness Name' ;
    rdfs:comment 'Name of the primary utility witness or subject matter expert who provided testimony or documentation in support of the prudency of the expenditures under review. Used for regulatory proceeding tracking and testimony management.' ;
    rdfs:domain ind:PrudencyReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wipBalanceAmt rdf:type rdf:Property ;
    rdfs:label 'Wip Balance Amt' ;
    rdfs:comment 'Dollar amount of Work in Progress (WIP) balance associated with the capital project under prudency review at the time of review initiation. Relevant for capital project prudency reviews to assess the in-service conversion and rate base eligibility.' ;
    rdfs:domain ind:PrudencyReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:testYearFinancialPeriodId rdf:type rdf:Property ;
    rdfs:label 'Test Year Financial Period Id' ;
    rdfs:comment 'Foreign key linking to finance.financial_period. Business justification: Rate cases use specific financial periods as test years for revenue requirement calculations. Finance teams extract closed period actuals for rate case cost studies. Direct period linkage enables auto' ;
    rdfs:domain ind:RateCase ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FinancialPeriod .

ind:approvedRatesEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Approved Rates Effective Date' ;
    rdfs:comment 'Date on which the final approved rates became effective for billing purposes. May differ from the final order date if the order specifies a prospective effective date or if rates are subject to a tariff filing lag.' ;
    rdfs:domain ind:RateCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:approvedWaccPct rdf:type rdf:Property ;
    rdfs:label 'Approved Wacc Pct' ;
    rdfs:comment 'Weighted Average Cost of Capital (WACC) percentage authorized by the regulatory authority in the final order. Reflects the approved blended cost of debt and equity used to compute the authorized return on rate base.' ;
    rdfs:domain ind:RateCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:caseName rdf:type rdf:Property ;
    rdfs:label 'Case Name' ;
    rdfs:comment 'Official descriptive name or title of the rate case as filed with the regulatory authority (e.g., \'General Rate Case 2024 — Electric Distribution\'). Used for identification in regulatory filings and internal reporting.' ;
    rdfs:domain ind:RateCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:caseType rdf:type rdf:Property ;
    rdfs:label 'Case Type' ;
    rdfs:comment 'Classification of the rate proceeding by regulatory scope and commodity. Distinguishes general rate cases from transmission-only, gas distribution, electric distribution, formula rate, or limited-scope proceedings. [ENUM-REF-CANDIDATE: general_rate_case|transmission_rate_case|gas_distribution_rate_case|electric_distribution_rate_case|formula_rate_case|limited_rate_case|cost_of_service|PBR_only — promote to reference product]' ;
    rdfs:domain ind:RateCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingJurisdictionState rdf:type rdf:Property ;
    rdfs:label 'Filing Jurisdiction State' ;
    rdfs:comment 'Two-letter US state code identifying the state PUC jurisdiction where this rate case is filed (e.g., \'CA\', \'TX\', \'NY\'). Null for FERC-only proceedings.' ;
    rdfs:domain ind:RateCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interimRateEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Interim Rate Effective Date' ;
    rdfs:comment 'Date on which interim rates became effective pending the final order. Interim rates are provisional rates authorized by the regulator to allow the utility to begin collecting adjusted revenues before the proceeding concludes.' ;
    rdfs:domain ind:RateCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:interimRevenueRequirement rdf:type rdf:Property ;
    rdfs:label 'Interim Revenue Requirement' ;
    rdfs:comment 'Annual revenue requirement authorized on an interim basis pending the final order, expressed in US dollars. Subject to refund or true-up adjustment once the final order is issued.' ;
    rdfs:domain ind:RateCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pbrActualValue rdf:type rdf:Property ;
    rdfs:label 'Pbr Actual Value' ;
    rdfs:comment 'Actual measured performance value achieved by the utility for the PBR metric during the measurement period. Compared against pbr_target_value to determine variance and calculate earned incentives or assessed penalties.' ;
    rdfs:domain ind:RateCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pbrIncentivePenaltyAmount rdf:type rdf:Property ;
    rdfs:label 'Pbr Incentive Penalty Amount' ;
    rdfs:comment 'Dollar amount of the earned incentive (positive) or assessed penalty (negative) resulting from the PBR performance variance for the measurement period. Directly impacts the utility\'s allowed revenue recovery.' ;
    rdfs:domain ind:RateCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pbrMeasurementPeriodEnd rdf:type rdf:Property ;
    rdfs:label 'Pbr Measurement Period End' ;
    rdfs:comment 'End date of the PBR performance measurement period. Together with pbr_measurement_period_start defines the evaluation window for PBR metric assessment.' ;
    rdfs:domain ind:RateCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:pbrMeasurementPeriodStart rdf:type rdf:Property ;
    rdfs:label 'Pbr Measurement Period Start' ;
    rdfs:comment 'Start date of the PBR performance measurement period during which the utility\'s actual performance is evaluated against approved targets. Populated only when pbr_indicator is True.' ;
    rdfs:domain ind:RateCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:pbrMetricType rdf:type rdf:Property ;
    rdfs:label 'Pbr Metric Type' ;
    rdfs:comment 'Type of PBR performance metric tracked in this rate case. Common metrics include SAIDI (System Average Interruption Duration Index), SAIFI (System Average Interruption Frequency Index), CAIDI (Customer Average Interruption Duration Index), customer satisfaction scores, renewable integration percentage, Energy Efficiency (EE) savings, and Demand Response (DR) curtailment. Populated only when pbr_indicator is True. [ENUM-REF-CANDIDATE: SAIDI|SAIFI|CAIDI|customer_satisfaction|renewable_integration_pct|EE_savings|DR_curtailment|GHG_emissions — promote to reference product]' ;
    rdfs:domain ind:RateCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pbrTargetValue rdf:type rdf:Property ;
    rdfs:label 'Pbr Target Value' ;
    rdfs:comment 'Approved target value for the PBR metric defined in pbr_metric_type for the measurement period. Represents the performance threshold the utility must achieve to earn incentives or avoid penalties (e.g., SAIDI target of 90 minutes, customer satisfaction score of 85).' ;
    rdfs:domain ind:RateCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pbrVariance rdf:type rdf:Property ;
    rdfs:label 'Pbr Variance' ;
    rdfs:comment 'Calculated variance between the PBR actual value and the PBR target value (actual minus target). A positive variance may indicate over-performance (incentive-eligible) or under-performance depending on the metric direction convention.' ;
    rdfs:domain ind:RateCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:requestedRateBase rdf:type rdf:Property ;
    rdfs:label 'Requested Rate Base' ;
    rdfs:comment 'Total rate base (net plant in service plus working capital allowances) requested by the utility in its filing, expressed in US dollars. Rate base is the foundation for calculating the allowed return on equity and overall revenue requirement.' ;
    rdfs:domain ind:RateCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:requestedRoePct rdf:type rdf:Property ;
    rdfs:label 'Requested Roe Pct' ;
    rdfs:comment 'Return on Equity (ROE) percentage requested by the utility in its rate case filing. Represents the equity return component of the weighted average cost of capital used to calculate the allowed return on rate base.' ;
    rdfs:domain ind:RateCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:requestedWaccPct rdf:type rdf:Property ;
    rdfs:label 'Requested Wacc Pct' ;
    rdfs:comment 'Weighted Average Cost of Capital (WACC) percentage requested by the utility, reflecting the blended cost of debt and equity in the proposed capital structure. Used to calculate the overall allowed return on rate base.' ;
    rdfs:domain ind:RateCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:trueUpAmount rdf:type rdf:Property ;
    rdfs:label 'True Up Amount' ;
    rdfs:comment 'Dollar amount of the true-up adjustment calculated as the difference between interim rates collected and the final approved revenue requirement. A positive value indicates a refund owed to customers; a negative value indicates additional recovery owed to the utility.' ;
    rdfs:domain ind:RateCase ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:supersededByRiderRiderChargeId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Rider Rider Charge Id' ;
    rdfs:comment 'Foreign key reference to the rider_charge_id that supersedes this rider. Null if this rider is current or was not replaced by another rider.' ;
    rdfs:domain ind:RiderCharge ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RiderCharge .

ind:chargeBasis rdf:type rdf:Property ;
    rdfs:label 'Charge Basis' ;
    rdfs:comment 'Unit of measure or calculation method for applying the rider charge: per kilowatt-hour (kWh), per thousand cubic feet (MCF) of gas, per therm, per kilowatt (kW) of demand, fixed monthly amount, or percentage of base tariff charges.' ;
    rdfs:domain ind:RiderCharge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currentRateValue rdf:type rdf:Property ;
    rdfs:label 'Current Rate Value' ;
    rdfs:comment 'The currently effective rate value for this rider charge, expressed in the unit specified by charge_basis (e.g., 0.012345 dollars per kWh, 2.50 dollars per month). Updated through regulatory true-up filings.' ;
    rdfs:domain ind:RiderCharge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:jurisdictionStateCode rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction State Code' ;
    rdfs:comment 'Two-letter U.S. state code for the state regulatory jurisdiction (e.g., CA, NY, TX). Null for federal or multi-state riders.' ;
    rdfs:domain ind:RiderCharge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riderChargeStatus rdf:type rdf:Property ;
    rdfs:label 'Rider Charge Status' ;
    rdfs:comment 'Current lifecycle status of the rider charge. Active riders are applied to customer bills; pending riders await regulatory approval; expired riders are no longer in effect.' ;
    rdfs:domain ind:RiderCharge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riderCode rdf:type rdf:Property ;
    rdfs:label 'Rider Code' ;
    rdfs:comment 'Short alphanumeric code uniquely identifying the rider or surcharge within the utility\'s tariff structure (e.g., FAC, RPS, INFRA, DSM). Used as the business identifier for rate engine processing.' ;
    rdfs:domain ind:RiderCharge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riderDescription rdf:type rdf:Property ;
    rdfs:label 'Rider Description' ;
    rdfs:comment 'Detailed description of the rider\'s purpose, cost recovery mechanism, and regulatory basis. Includes information on the types of costs recovered and the calculation methodology.' ;
    rdfs:domain ind:RiderCharge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riderName rdf:type rdf:Property ;
    rdfs:label 'Rider Name' ;
    rdfs:comment 'Full descriptive name of the rider or surcharge as it appears on customer bills and in regulatory filings (e.g., Fuel Adjustment Clause, Renewable Portfolio Standard Surcharge, Infrastructure Investment Rider).' ;
    rdfs:domain ind:RiderCharge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riderType rdf:type rdf:Property ;
    rdfs:label 'Rider Type' ;
    rdfs:comment 'Classification of the rider based on its regulatory purpose and cost recovery mechanism. Determines the accounting treatment and regulatory reporting requirements. [ENUM-REF-CANDIDATE: fuel_adjustment|renewable_portfolio|infrastructure_investment|low_income_program|demand_response|environmental_compliance|ciac_recovery|energy_efficiency|other — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:RiderCharge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersededByTariffTariffScheduleId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Tariff Tariff Schedule Id' ;
    rdfs:comment 'Self-referencing identifier pointing to the tariff_schedule record that replaced this schedule. Enables navigation of the tariff version chain for historical rate reconstruction and regulatory audit. Null if this schedule has not been superseded.' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TariffSchedule .

ind:applicableSeason rdf:type rdf:Property ;
    rdfs:label 'Applicable Season' ;
    rdfs:comment 'The seasonal applicability of this tariff schedule or its rate components. Many utility tariffs have differentiated summer and winter rates reflecting seasonal demand patterns and fuel costs. \'All_year\' indicates no seasonal differentiation.' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drProgramApplicable rdf:type rdf:Property ;
    rdfs:label 'Dr Program Applicable' ;
    rdfs:comment 'Indicates whether this tariff schedule includes or is associated with a Demand Response (DR) or Demand-Side Management (DSM) program provision. True if customers on this schedule are eligible for or subject to DR curtailment events and associated incentives or penalties.' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:energyChargeRate rdf:type rdf:Property ;
    rdfs:label 'Energy Charge Rate' ;
    rdfs:comment 'The approved volumetric energy charge rate expressed in dollars per kilowatt-hour ($/kWh) for electric tariffs or dollars per therm ($/therm) or dollars per MCF ($/MCF) for gas tariffs. Represents the core consumption-based component of the rate structure.' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:energyChargeUnit rdf:type rdf:Property ;
    rdfs:label 'Energy Charge Unit' ;
    rdfs:comment 'The unit of measure associated with the energy charge rate (e.g., kWh for residential electric, MWh for large commercial/industrial, therm or MCF for gas distribution). Ensures unambiguous interpretation of the energy_charge_rate value.' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facRiderRate rdf:type rdf:Property ;
    rdfs:label 'Fac Rider Rate' ;
    rdfs:comment 'The current approved Fuel Adjustment Clause (FAC) rider rate in dollars per kWh or therm, applied as a pass-through adjustment to recover actual fuel and purchased power costs above or below the base rate. Updated periodically per regulatory approval.' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:filingStateCode rdf:type rdf:Property ;
    rdfs:label 'Filing State Code' ;
    rdfs:comment 'Two-letter U.S. state code (ISO 3166-2:US) identifying the state in which this tariff is filed. Used for multi-state utility jurisdictional reporting and rate case management. Null for FERC-jurisdictional interstate tariffs.' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interruptibleService rdf:type rdf:Property ;
    rdfs:label 'Interruptible Service' ;
    rdfs:comment 'Indicates whether this tariff schedule provides interruptible service, where the utility retains the right to curtail or interrupt supply during system emergencies or peak demand events in exchange for a discounted rate. Common in large commercial and industrial gas and electric tariffs.' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minimumBillAmount rdf:type rdf:Property ;
    rdfs:label 'Minimum Bill Amount' ;
    rdfs:comment 'The minimum monthly bill amount (in dollars) guaranteed under this tariff schedule, regardless of actual consumption. Ensures recovery of fixed costs for customers with very low usage. Null if no minimum bill provision applies.' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nemExportRate rdf:type rdf:Property ;
    rdfs:label 'Nem Export Rate' ;
    rdfs:comment 'The approved credit rate in dollars per kWh applied to excess energy exported to the grid by customers with Distributed Energy Resources (DER) under Net Energy Metering (NEM) tariff schedules. Null for non-NEM schedules.' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pbrApplicable rdf:type rdf:Property ;
    rdfs:label 'Pbr Applicable' ;
    rdfs:comment 'Indicates whether this tariff schedule is subject to Performance-Based Ratemaking (PBR) mechanisms, where utility revenue or earnings are tied to performance metrics such as reliability (SAIDI/SAIFI), customer satisfaction, or clean energy targets. True if PBR provisions apply.' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rateDesignType rdf:type rdf:Property ;
    rdfs:label 'Rate Design Type' ;
    rdfs:comment 'The rate design methodology applied in this tariff schedule. Distinguishes flat rates, tiered/inclining block rates, Time-of-Use (TOU), Critical Peak Pricing (CPP), Real-Time Pricing (RTP), and declining block structures. Drives billing calculation logic in Oracle CC&B or SAP IS-U. [ENUM-REF-CANDIDATE: flat|tiered|tou|cpp|rtp|inclining_block|declining_block — promote to reference product]' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleDescription rdf:type rdf:Property ;
    rdfs:label 'Schedule Description' ;
    rdfs:comment 'Full narrative description of the tariff schedule as it appears in the approved tariff filing, including applicability conditions, service limitations, and special provisions. Provides the complete regulatory text context for compliance and customer communication purposes.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleName rdf:type rdf:Property ;
    rdfs:label 'Schedule Name' ;
    rdfs:comment 'Descriptive name of the tariff schedule as it appears in the approved tariff book (e.g., \'Residential Service\', \'General Service Time-of-Use\', \'Net Energy Metering\', \'Open Access Transmission Tariff\'). Used for display and reporting purposes.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceClass rdf:type rdf:Property ;
    rdfs:label 'Service Class' ;
    rdfs:comment 'The customer service class to which this tariff schedule applies. Segments the tariff applicability by customer category (e.g., residential, commercial, industrial, agricultural, street lighting, transmission). Aligns with PUC-approved rate class definitions.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialConditions rdf:type rdf:Property ;
    rdfs:label 'Special Conditions' ;
    rdfs:comment 'Narrative description of any special conditions, eligibility restrictions, or limitations associated with this tariff schedule (e.g., minimum contract demand, geographic restrictions, equipment requirements, enrollment caps for NEM or DR programs).' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersededDate rdf:type rdf:Property ;
    rdfs:label 'Superseded Date' ;
    rdfs:comment 'The date on which this tariff schedule was superseded by a newer approved schedule or withdrawn from effect. Null if the schedule is currently effective. Used to maintain the full historical record of approved tariff structures for regulatory audit and retroactive billing adjustments.' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:tariffBookSection rdf:type rdf:Property ;
    rdfs:label 'Tariff Book Section' ;
    rdfs:comment 'The section or part of the utility\'s tariff book in which this schedule is filed (e.g., \'Part A - Electric Service\', \'Part B - Gas Service\', \'Part C - Transmission\'). Supports navigation of the regulatory tariff document structure.' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tariffNumber rdf:type rdf:Property ;
    rdfs:label 'Tariff Number' ;
    rdfs:comment 'The official tariff or rate schedule number as assigned by the regulatory authority (e.g., PUC or FERC). This is the externally-known identifier referenced in regulatory filings, dockets, and customer bills (e.g., \'Schedule E-1\', \'Rate Schedule 10\', \'OATT Schedule 1\').' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tariffSheetNumber rdf:type rdf:Property ;
    rdfs:label 'Tariff Sheet Number' ;
    rdfs:comment 'The specific tariff sheet or leaf number within the utility\'s tariff book as filed with the regulatory authority. Tariff books are organized by numbered sheets; this field identifies the precise sheet(s) containing this schedule\'s terms and conditions.' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:touOffpeakRate rdf:type rdf:Property ;
    rdfs:label 'Tou Offpeak Rate' ;
    rdfs:comment 'The approved off-peak energy charge rate in dollars per kWh for Time-of-Use (TOU) tariff schedules. Applied during hours outside the defined peak period. Null for non-TOU schedules.' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:touPeakEndTime rdf:type rdf:Property ;
    rdfs:label 'Tou Peak End Time' ;
    rdfs:comment 'The end time of the on-peak pricing period for Time-of-Use (TOU) tariff schedules, expressed in HH:MM 24-hour format. Null for non-TOU tariff schedules. Paired with tou_peak_start_time to define the peak billing window.' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:touPeakRate rdf:type rdf:Property ;
    rdfs:label 'Tou Peak Rate' ;
    rdfs:comment 'The approved on-peak energy charge rate in dollars per kWh for Time-of-Use (TOU) tariff schedules. Applied during the defined peak period hours. Null for non-TOU schedules.' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:touPeakStartTime rdf:type rdf:Property ;
    rdfs:label 'Tou Peak Start Time' ;
    rdfs:comment 'The start time of the on-peak pricing period for Time-of-Use (TOU) tariff schedules, expressed in HH:MM 24-hour format. Null for non-TOU tariff schedules. Used in billing systems to apply differentiated energy charges by time of day.' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:fuelGenerationPlantId rdf:type rdf:Property ;
    rdfs:label 'Fuel Generation Plant Id' ;
    rdfs:comment 'Reference to the generation facility receiving the fuel delivery. Identifies the power plant site where fuel is delivered.' ;
    rdfs:domain ind:FuelDelivery ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Plant .

ind:fuelPlantId rdf:type rdf:Property ;
    rdfs:label 'Fuel Plant Id' ;
    rdfs:comment 'FK to generation.plant.plant_id — Traces fuel deliveries to generation facilities — required for fuel cost allocation, FAC cost recovery filings, and fuel inventory reconciliation at each plant.' ;
    rdfs:domain ind:FuelDelivery ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Plant .

ind:deliveredQuantity rdf:type rdf:Property ;
    rdfs:label 'Delivered Quantity' ;
    rdfs:comment 'Physical quantity of fuel delivered in the specified unit of measure. Core measurement for inventory management and billing.' ;
    rdfs:domain ind:FuelDelivery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deliveryDate rdf:type rdf:Property ;
    rdfs:label 'Delivery Date' ;
    rdfs:comment 'Calendar date when the fuel was physically delivered to the generation plant site. Principal business event date for the transaction.' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deliveryNotes rdf:type rdf:Property ;
    rdfs:label 'Delivery Notes' ;
    rdfs:comment 'Free-text comments or special instructions related to the fuel delivery. Captures operational details, exceptions, or delivery conditions.' ;
    rdfs:domain ind:FuelDelivery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryPointCode rdf:type rdf:Property ;
    rdfs:label 'Delivery Point Code' ;
    rdfs:comment 'Specific location identifier within the generation plant where fuel was delivered. May reference a storage tank, pipeline tie-in, or receiving dock.' ;
    rdfs:domain ind:FuelDelivery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryStatus rdf:type rdf:Property ;
    rdfs:label 'Delivery Status' ;
    rdfs:comment 'Current lifecycle state of the fuel delivery transaction. Tracks the delivery from scheduling through final acceptance or rejection.' ;
    rdfs:domain ind:FuelDelivery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryTicketNumber rdf:type rdf:Property ;
    rdfs:label 'Delivery Ticket Number' ;
    rdfs:comment 'External delivery ticket or bill of lading number issued by the carrier or transporter. Serves as the business identifier for the physical delivery event.' ;
    rdfs:domain ind:FuelDelivery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryTimestamp rdf:type rdf:Property ;
    rdfs:label 'Delivery Timestamp' ;
    rdfs:comment 'Precise date and time when the fuel delivery was completed and accepted at the plant. Used for time-of-delivery pricing and scheduling reconciliation.' ;
    rdfs:domain ind:FuelDelivery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:environmentalComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Environmental Compliance Flag' ;
    rdfs:comment 'Indicates whether the delivered fuel meets environmental quality standards and emissions compliance requirements. True if compliant with EPA and state regulations.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:heatRateMmbtuPerUnit rdf:type rdf:Property ;
    rdfs:label 'Heat Rate Mmbtu Per Unit' ;
    rdfs:comment 'Million BTU per unit of measure for the delivered fuel. Used in generation efficiency calculations and Fuel Adjustment Clause (FAC) reporting.' ;
    rdfs:domain ind:FuelDelivery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inspectionOutcome rdf:type rdf:Property ;
    rdfs:label 'Inspection Outcome' ;
    rdfs:comment 'Result of the fuel quality inspection or lab analysis. Determines whether the delivery is accepted for use or rejected for non-conformance.' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Inspection Required Flag' ;
    rdfs:comment 'Indicates whether quality inspection or lab testing is required before the fuel can be used in generation. True if inspection is mandatory per contract terms.' ;
    rdfs:domain ind:FuelDelivery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:originLocation rdf:type rdf:Property ;
    rdfs:label 'Origin Location' ;
    rdfs:comment 'Geographic source or production location of the delivered fuel. May reference a mine, well field, refinery, or supply basin.' ;
    rdfs:domain ind:FuelDelivery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pipelineReceiptPoint rdf:type rdf:Property ;
    rdfs:label 'Pipeline Receipt Point' ;
    rdfs:comment 'Named receipt point on the natural gas pipeline system where gas entered the utility\'s system. Used for gas delivery tracking and tariff application.' ;
    rdfs:domain ind:FuelDelivery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityCertificateNumber rdf:type rdf:Property ;
    rdfs:label 'Quality Certificate Number' ;
    rdfs:comment 'Reference number for the fuel quality assurance certificate or lab analysis report accompanying the delivery. Documents compliance with contract specifications.' ;
    rdfs:domain ind:FuelDelivery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receivingPersonName rdf:type rdf:Property ;
    rdfs:label 'Receiving Person Name' ;
    rdfs:comment 'Name of the plant operations or warehouse staff member who accepted and verified the fuel delivery on site.' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduledDeliveryDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Delivery Date' ;
    rdfs:comment 'Originally planned or contracted delivery date. Used to track on-time delivery performance and schedule variance.' ;
    rdfs:domain ind:FuelDelivery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:totalDeliveryCost rdf:type rdf:Property ;
    rdfs:label 'Total Delivery Cost' ;
    rdfs:comment 'Total cost for the fuel delivery including base fuel cost and transportation charges. Represents the complete delivered cost for accounting and rate recovery.' ;
    rdfs:domain ind:FuelDelivery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transportationCost rdf:type rdf:Property ;
    rdfs:label 'Transportation Cost' ;
    rdfs:comment 'Separate transportation or freight charges for delivering the fuel to the plant site. May be billed separately from commodity cost.' ;
    rdfs:domain ind:FuelDelivery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transporterDunsNumber rdf:type rdf:Property ;
    rdfs:label 'Transporter Duns Number' ;
    rdfs:comment 'Dun & Bradstreet unique identifier for the transportation company. Provides standardized carrier identification for regulatory reporting.' ;
    rdfs:domain ind:FuelDelivery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unitPrice rdf:type rdf:Property ;
    rdfs:label 'Unit Price' ;
    rdfs:comment 'Contract price per unit of measure for the delivered fuel. Used for invoice validation and Fuel Adjustment Clause (FAC) cost recovery calculations.' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:goodsIssueId rdf:type rdf:Property ;
    rdfs:label 'Goods Issue Id' ;
    rdfs:comment 'Unique identifier for the goods issue transaction. Primary key for the goods issue record.' ;
    rdfs:domain ind:GoodsIssue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:issuingEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Issuing Employee Id' ;
    rdfs:comment 'Employee identifier of the person who issued the material, used for accountability and audit trail.' ;
    rdfs:domain ind:GoodsIssue ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:materialReservationId rdf:type rdf:Property ;
    rdfs:label 'Material Reservation Id' ;
    rdfs:comment 'Foreign key reference to the material reservation record that committed this inventory for issuance. Links the goods issue to the upstream reservation.' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MaterialReservation .

ind:primaryGoodsMaterialMasterId rdf:type rdf:Property ;
    rdfs:label 'Primary Goods Material Master Id' ;
    rdfs:comment 'Foreign key reference to the material master record identifying the specific material being issued from inventory.' ;
    rdfs:domain ind:GoodsIssue ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MaterialMaster .

ind:giDocumentNumber rdf:type rdf:Property ;
    rdfs:label 'Gi Document Number' ;
    rdfs:comment 'The externally-known goods issue document number generated by the ERP system (SAP material document number). Used for audit trail and cross-system reconciliation.' ;
    rdfs:domain ind:GoodsIssue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issueStatus rdf:type rdf:Property ;
    rdfs:label 'Issue Status' ;
    rdfs:comment 'Current lifecycle status of the goods issue transaction indicating whether it has been posted to inventory, reversed, pending approval, or cancelled.' ;
    rdfs:domain ind:GoodsIssue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issueTimestamp rdf:type rdf:Property ;
    rdfs:label 'Issue Timestamp' ;
    rdfs:comment 'The precise date and time when the material was physically issued from the warehouse or storage location.' ;
    rdfs:domain ind:GoodsIssue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:issuedQuantity rdf:type rdf:Property ;
    rdfs:label 'Issued Quantity' ;
    rdfs:comment 'The quantity of material issued from inventory stock. This is the principal quantitative fact for the goods issue transaction.' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:issuingPersonName rdf:type rdf:Property ;
    rdfs:label 'Issuing Person Name' ;
    rdfs:comment 'Name of the warehouse clerk or storekeeper who physically issued the material from inventory.' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:movementType rdf:type rdf:Property ;
    rdfs:label 'Movement Type' ;
    rdfs:comment 'SAP movement type code indicating the nature of the goods issue: 261 (goods issue for order), 262 (reversal of goods issue), 201 (goods issue for cost center), 281 (goods issue for network/project).' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mutualAidReference rdf:type rdf:Property ;
    rdfs:label 'Mutual Aid Reference' ;
    rdfs:comment 'Reference identifier for mutual aid agreements if this material was issued to support another utility during emergency response.' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receivingCostObjectType rdf:type rdf:Property ;
    rdfs:label 'Receiving Cost Object Type' ;
    rdfs:comment 'The type of cost object receiving the material: work order (maintenance), CAPEX project (capital construction), cost center (operational expense), or asset (capitalization).' ;
    rdfs:domain ind:GoodsIssue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reversalReasonCode rdf:type rdf:Property ;
    rdfs:label 'Reversal Reason Code' ;
    rdfs:comment 'Code indicating the reason for reversing the goods issue (e.g., incorrect quantity, wrong material, data entry error).' ;
    rdfs:domain ind:GoodsIssue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:storageLocationCode rdf:type rdf:Property ;
    rdfs:label 'Storage Location Code' ;
    rdfs:comment 'The specific storage location code within the warehouse from which the material was issued.' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stormEventReference rdf:type rdf:Property ;
    rdfs:label 'Storm Event Reference' ;
    rdfs:comment 'Reference identifier for the storm or emergency event if this goods issue is related to storm restoration or emergency response activities. Critical for tracking storm restoration material consumption for regulatory cost recovery.' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:threeWayMatchCompletedFlag rdf:type rdf:Property ;
    rdfs:label 'Three Way Match Completed Flag' ;
    rdfs:comment 'Boolean flag indicating whether the three-way match (purchase order, goods receipt, goods issue) has been completed for this material consumption. Critical for procurement-to-pay cycle closure.' ;
    rdfs:domain ind:GoodsIssue ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:valuationAmount rdf:type rdf:Property ;
    rdfs:label 'Valuation Amount' ;
    rdfs:comment 'The total monetary value of the issued material calculated using standard cost or moving average price. This is the principal monetary fact for cost accounting.' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:poLineItemId rdf:type rdf:Property ;
    rdfs:label 'Po Line Item Id' ;
    rdfs:comment 'Foreign key linking to supply.po_line_item. Business justification: Goods receipts are posted against specific PO line items, not just the header. Currently denormalized as po_line_item_number (INT). Adding po_line_item_id FK enables precise 3-way matching (PO line → ' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PoLineItem .

ind:deliveryCompletedFlag rdf:type rdf:Property ;
    rdfs:label 'Delivery Completed Flag' ;
    rdfs:comment 'Indicates whether this goods receipt completes the delivery for the purchase order line item. True if no further deliveries are expected; false if partial delivery with more to come.' ;
    rdfs:domain ind:GoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deliveryNoteNumber rdf:type rdf:Property ;
    rdfs:label 'Delivery Note Number' ;
    rdfs:comment 'Delivery note or shipment document number provided by the vendor. Used to match physical delivery documentation with the goods receipt.' ;
    rdfs:domain ind:GoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grDocumentNumber rdf:type rdf:Property ;
    rdfs:label 'Gr Document Number' ;
    rdfs:comment 'Externally-known goods receipt document number generated by the ERP system. Used for cross-system reconciliation and audit trail.' ;
    rdfs:domain ind:GoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grStatus rdf:type rdf:Property ;
    rdfs:label 'Gr Status' ;
    rdfs:comment 'Current lifecycle status of the goods receipt transaction. Posted indicates the GR is complete and inventory updated; pending inspection indicates quality hold; reversed indicates the GR was cancelled or corrected.' ;
    rdfs:domain ind:GoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overDeliveryToleranceExceededFlag rdf:type rdf:Property ;
    rdfs:label 'Over Delivery Tolerance Exceeded Flag' ;
    rdfs:comment 'Indicates whether the received quantity exceeds the over-delivery tolerance defined in the purchase order. True if the receipt quantity is beyond acceptable limits and requires approval.' ;
    rdfs:domain ind:GoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:packingSlipReference rdf:type rdf:Property ;
    rdfs:label 'Packing Slip Reference' ;
    rdfs:comment 'Vendor packing slip or bill of lading reference number. Provides traceability to the vendors shipping documentation.' ;
    rdfs:domain ind:GoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityInspectionRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Quality Inspection Required Flag' ;
    rdfs:comment 'Indicates whether the received materials require quality inspection before being released to unrestricted stock. True if inspection is mandatory per material master or vendor agreement.' ;
    rdfs:domain ind:GoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:receivedQuantity rdf:type rdf:Property ;
    rdfs:label 'Received Quantity' ;
    rdfs:comment 'Quantity of material physically received and recorded in this goods receipt transaction. Used for inventory stock position update and three-way match.' ;
    rdfs:domain ind:GoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:receivingTimestamp rdf:type rdf:Property ;
    rdfs:label 'Receiving Timestamp' ;
    rdfs:comment 'Timestamp when the materials were physically received at the storage location. Captures the actual receipt event time for logistics and supply chain analytics.' ;
    rdfs:domain ind:GoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:stockType rdf:type rdf:Property ;
    rdfs:label 'Stock Type' ;
    rdfs:comment 'Classification of the stock status after goods receipt. Unrestricted stock is available for use; blocked stock is held pending inspection or resolution; quality inspection stock is under testing; restricted stock has usage limitations.' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underDeliveryToleranceExceededFlag rdf:type rdf:Property ;
    rdfs:label 'Under Delivery Tolerance Exceeded Flag' ;
    rdfs:comment 'Indicates whether the received quantity is below the under-delivery tolerance defined in the purchase order. True if the receipt quantity is insufficient and requires follow-up.' ;
    rdfs:domain ind:GoodsReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:inventoryStockId rdf:type rdf:Property ;
    rdfs:label 'Inventory Stock Id' ;
    rdfs:comment 'Unique identifier for the inventory stock position record. Primary key for the inventory_stock product.' ;
    rdfs:domain ind:InventoryStock ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:abcClassification rdf:type rdf:Property ;
    rdfs:label 'Abc Classification' ;
    rdfs:comment 'ABC inventory classification based on consumption value or criticality. A = high-value/high-turnover items requiring tight control; B = moderate-value items; C = low-value/low-turnover items; X = unclassified or new materials. Used for cycle count frequency and inventory management strategy.' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:blockedStockQuantity rdf:type rdf:Property ;
    rdfs:label 'Blocked Stock Quantity' ;
    rdfs:comment 'Quantity of material blocked from use due to quality issues, damage, obsolescence, or regulatory hold. Material in this status cannot be issued and may require disposition (scrap, return to vendor, rework).' ;
    rdfs:domain ind:InventoryStock ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:consignmentStockQuantity rdf:type rdf:Property ;
    rdfs:label 'Consignment Stock Quantity' ;
    rdfs:comment 'Quantity of material held on consignment from a vendor. Material is physically at the utility location but remains vendor-owned until consumed. Common for high-value spare parts and generation fuel.' ;
    rdfs:domain ind:InventoryStock ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inTransitStockQuantity rdf:type rdf:Property ;
    rdfs:label 'In Transit Stock Quantity' ;
    rdfs:comment 'Quantity of material currently in transit between storage locations or from vendor to warehouse. Material in this status is owned but not yet physically available at the destination location. Tracked via stock transfer orders.' ;
    rdfs:domain ind:InventoryStock ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastGoodsIssueDate rdf:type rdf:Property ;
    rdfs:label 'Last Goods Issue Date' ;
    rdfs:comment 'Date of the most recent goods issue transaction that decreased stock at this location. Used for inventory turnover analysis and obsolescence detection.' ;
    rdfs:domain ind:InventoryStock ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastGoodsReceiptDate rdf:type rdf:Property ;
    rdfs:label 'Last Goods Receipt Date' ;
    rdfs:comment 'Date of the most recent goods receipt transaction that increased stock at this location. Used for inventory aging analysis and slow-moving stock identification.' ;
    rdfs:domain ind:InventoryStock ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastPhysicalInventoryCountDate rdf:type rdf:Property ;
    rdfs:label 'Last Physical Inventory Count Date' ;
    rdfs:comment 'Date of the most recent physical inventory count (cycle count or annual inventory) performed for this material at this location. Used for inventory accuracy tracking and audit compliance. Regulatory requirements may mandate minimum count frequency.' ;
    rdfs:domain ind:InventoryStock ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:maximumStockLevel rdf:type rdf:Property ;
    rdfs:label 'Maximum Stock Level' ;
    rdfs:comment 'Maximum stock quantity threshold for this material at this location. Used to prevent overstocking and optimize working capital. Replenishment orders target this level. Breach indicates potential excess inventory.' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:movingAverageCostPerUnit rdf:type rdf:Property ;
    rdfs:label 'Moving Average Cost Per Unit' ;
    rdfs:comment 'Moving average cost per unit of measure for this material. Recalculated with each goods receipt based on actual purchase prices. Used for inventory valuation when moving average costing method is applied. Confidential business financial data.' ;
    rdfs:domain ind:InventoryStock ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mrpController rdf:type rdf:Property ;
    rdfs:label 'Mrp Controller' ;
    rdfs:comment 'Three-character code identifying the MRP controller or inventory planner responsible for managing replenishment and stock levels for this material. Used for workload distribution and accountability.' ;
    rdfs:domain ind:InventoryStock ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:physicalInventoryVarianceQuantity rdf:type rdf:Property ;
    rdfs:label 'Physical Inventory Variance Quantity' ;
    rdfs:comment 'Quantity difference between system book stock and physical count from the last inventory count. Positive values indicate physical surplus; negative values indicate shortage. Used for inventory accuracy metrics and shrinkage analysis.' ;
    rdfs:domain ind:InventoryStock ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:qualityInspectionStockQuantity rdf:type rdf:Property ;
    rdfs:label 'Quality Inspection Stock Quantity' ;
    rdfs:comment 'Quantity of material currently held in quality inspection status. Material in this status cannot be issued until quality control approval is received. Common for critical spare parts and generation fuel deliveries.' ;
    rdfs:domain ind:InventoryStock ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reorderPointBreachFlag rdf:type rdf:Property ;
    rdfs:label 'Reorder Point Breach Flag' ;
    rdfs:comment 'Boolean indicator that the current unrestricted stock quantity has fallen below the reorder point threshold. True indicates replenishment action is required. Used for inventory exception reporting and automated procurement triggers.' ;
    rdfs:domain ind:InventoryStock ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reservedQuantity rdf:type rdf:Property ;
    rdfs:label 'Reserved Quantity' ;
    rdfs:comment 'Quantity of material reserved for specific work orders, CAPEX projects, or planned maintenance activities. Reserved stock is committed but not yet issued. Backed by material_reservation transactions.' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:safetyStock rdf:type rdf:Property ;
    rdfs:label 'Safety Stock' ;
    rdfs:comment 'Minimum buffer stock level maintained to protect against demand variability and supply disruptions. Safety stock is not intended for normal consumption and breach indicates critical shortage risk. Critical for storm restoration materials and generation spare parts.' ;
    rdfs:domain ind:InventoryStock ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:safetyStockBreachFlag rdf:type rdf:Property ;
    rdfs:label 'Safety Stock Breach Flag' ;
    rdfs:comment 'Boolean indicator that the current unrestricted stock quantity has fallen below the safety stock threshold. True indicates critical shortage condition requiring immediate attention. Triggers escalated replenishment and potential emergency procurement.' ;
    rdfs:domain ind:InventoryStock ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:specialStockIndicator rdf:type rdf:Property ;
    rdfs:label 'Special Stock Indicator' ;
    rdfs:comment 'Indicator for special stock types that require separate tracking. Project = stock allocated to specific CAPEX projects; sales_order = stock for specific customer orders; consignment = vendor-owned stock; returnable_packaging = containers/pallets; pipeline = in-transit between locations; subcontractor = stock at contractor site; none = standard stock. [ENUM-REF-CANDIDATE: project|sales_order|consignment|returnable_packaging|pipeline|subcontractor|none — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:InventoryStock ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:standardCostPerUnit rdf:type rdf:Property ;
    rdfs:label 'Standard Cost Per Unit' ;
    rdfs:comment 'Standard cost per unit of measure for this material. Used for inventory valuation when standard costing method is applied. Represents the planned or budgeted cost per unit. Confidential business financial data.' ;
    rdfs:domain ind:InventoryStock ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stockDeterminationGroup rdf:type rdf:Property ;
    rdfs:label 'Stock Determination Group' ;
    rdfs:comment 'Four-character code used for automatic stock determination logic in goods issue processes. Groups materials with similar characteristics for automated picking and allocation rules.' ;
    rdfs:domain ind:InventoryStock ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stockStatus rdf:type rdf:Property ;
    rdfs:label 'Stock Status' ;
    rdfs:comment 'Current operational status of the stock position. Available = normal stock levels; low_stock = below reorder point; out_of_stock = zero unrestricted quantity; excess = above maximum level; obsolete = material no longer used; inactive = location no longer stocking this material.' ;
    rdfs:domain ind:InventoryStock ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalInventoryValuationAmount rdf:type rdf:Property ;
    rdfs:label 'Total Inventory Valuation Amount' ;
    rdfs:comment 'Total monetary value of the unrestricted stock quantity at this location, calculated as unrestricted_stock_quantity multiplied by the applicable cost per unit (standard or moving average). Used for balance sheet reporting and working capital analysis. Confidential business financial data.' ;
    rdfs:domain ind:InventoryStock ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unrestrictedStockQuantity rdf:type rdf:Property ;
    rdfs:label 'Unrestricted Stock Quantity' ;
    rdfs:comment 'Quantity of material available for unrestricted use and issue. This is the freely available stock that can be issued to work orders, projects, or consumption without restrictions. Measured in the material base unit of measure (UOM).' ;
    rdfs:domain ind:InventoryStock ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:valuationCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Valuation Currency Code' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for all monetary amounts in this record (standard cost, moving average cost, total valuation). Typically USD for US-based utilities.' ;
    rdfs:domain ind:InventoryStock ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:baseUnitOfMeasure rdf:type rdf:Property ;
    rdfs:label 'Base Unit Of Measure' ;
    rdfs:comment 'Primary unit of measure for inventory and procurement transactions. Examples: EA (each), FT (feet), LB (pounds), GAL (gallons), TON (tons), KWH (kilowatt-hours), MCF (thousand cubic feet).' ;
    rdfs:domain ind:MaterialMaster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:batchManagedIndicator rdf:type rdf:Property ;
    rdfs:label 'Batch Managed Indicator' ;
    rdfs:comment 'Flag indicating whether the material requires batch-level tracking for quality control, traceability, and expiration management.' ;
    rdfs:domain ind:MaterialMaster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:createdDate rdf:type rdf:Property ;
    rdfs:label 'Created Date' ;
    rdfs:comment 'Date when the material master record was first created in the system.' ;
    rdfs:domain ind:MaterialMaster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deletionIndicator rdf:type rdf:Property ;
    rdfs:label 'Deletion Indicator' ;
    rdfs:comment 'Flag marking the material for deletion. Materials flagged for deletion cannot be used in new transactions but remain for historical reporting.' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:grossWeight rdf:type rdf:Property ;
    rdfs:label 'Gross Weight' ;
    rdfs:comment 'Total weight of the material including packaging. Used for transportation planning and freight cost calculation.' ;
    rdfs:domain ind:MaterialMaster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hazmatClass rdf:type rdf:Property ;
    rdfs:label 'Hazmat Class' ;
    rdfs:comment 'Department of Transportation hazard class for hazardous materials (e.g., Class 3 Flammable Liquids, Class 2 Gases). Null for non-hazardous materials.' ;
    rdfs:domain ind:MaterialMaster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hazmatIndicator rdf:type rdf:Property ;
    rdfs:label 'Hazmat Indicator' ;
    rdfs:comment 'Flag indicating whether the material is classified as hazardous and requires special handling, storage, and transportation procedures per OSHA and PHMSA regulations.' ;
    rdfs:domain ind:MaterialMaster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastModifiedDate rdf:type rdf:Property ;
    rdfs:label 'Last Modified Date' ;
    rdfs:comment 'Date when the material master record was last updated. Used for data governance and change tracking.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:manufacturerPartNumber rdf:type rdf:Property ;
    rdfs:label 'Manufacturer Part Number' ;
    rdfs:comment 'Original equipment manufacturer part number used for cross-referencing, warranty claims, and technical support.' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:materialDescription rdf:type rdf:Property ;
    rdfs:label 'Material Description' ;
    rdfs:comment 'Short textual description of the material, equipment, or spare part. Used for display in purchase orders, work orders, and inventory transactions.' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:materialGroup rdf:type rdf:Property ;
    rdfs:label 'Material Group' ;
    rdfs:comment 'Hierarchical grouping code used for procurement analytics, vendor assignment, and inventory segmentation. Examples include transformers, cables, meters, coal, natural gas, safety equipment.' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:materialNumber rdf:type rdf:Property ;
    rdfs:label 'Material Number' ;
    rdfs:comment 'Externally-known unique material identifier used across procurement, inventory, and work management systems. Aligns with SAP material number or equivalent ERP material code.' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:movingAveragePrice rdf:type rdf:Property ;
    rdfs:label 'Moving Average Price' ;
    rdfs:comment 'Weighted average cost per unit recalculated with each goods receipt. Used for materials valued at moving average price.' ;
    rdfs:domain ind:MaterialMaster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mrpType rdf:type rdf:Property ;
    rdfs:label 'Mrp Type' ;
    rdfs:comment 'Planning strategy code defining how the material is replenished (e.g., reorder point planning, forecast-based planning, consumption-based planning).' ;
    rdfs:domain ind:MaterialMaster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netWeight rdf:type rdf:Property ;
    rdfs:label 'Net Weight' ;
    rdfs:comment 'Weight of the material excluding packaging. Used for technical specifications and load calculations.' ;
    rdfs:domain ind:MaterialMaster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:plannedDeliveryTimeDays rdf:type rdf:Property ;
    rdfs:label 'Planned Delivery Time Days' ;
    rdfs:comment 'Expected lead time in days from purchase order creation to goods receipt. Used for MRP planning and project material scheduling.' ;
    rdfs:domain ind:MaterialMaster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:plantSpecificStatus rdf:type rdf:Property ;
    rdfs:label 'Plant Specific Status' ;
    rdfs:comment 'Material status at the plant or warehouse level, allowing different availability across locations (e.g., active at one plant, restricted at another).' ;
    rdfs:domain ind:MaterialMaster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priceControlIndicator rdf:type rdf:Property ;
    rdfs:label 'Price Control Indicator' ;
    rdfs:comment 'Defines the valuation method for the material: standard cost or moving average price.' ;
    rdfs:domain ind:MaterialMaster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:purchaseUnitOfMeasure rdf:type rdf:Property ;
    rdfs:label 'Purchase Unit Of Measure' ;
    rdfs:comment 'Unit of measure used for procurement and purchase order creation. May differ from base UOM when materials are purchased in bulk (e.g., purchased by pallet but stocked by each).' ;
    rdfs:domain ind:MaterialMaster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:purchasingGroup rdf:type rdf:Property ;
    rdfs:label 'Purchasing Group' ;
    rdfs:comment 'Buyer or procurement team responsible for sourcing this material. Used for workload distribution and vendor relationship management.' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:safetyStockLevel rdf:type rdf:Property ;
    rdfs:label 'Safety Stock Level' ;
    rdfs:comment 'Minimum inventory buffer maintained to protect against demand variability and supply disruptions. Critical for storm restoration and emergency response materials.' ;
    rdfs:domain ind:MaterialMaster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:serialNumberProfile rdf:type rdf:Property ;
    rdfs:label 'Serial Number Profile' ;
    rdfs:comment 'Configuration code defining serial number management requirements. Used for high-value equipment and assets requiring individual tracking.' ;
    rdfs:domain ind:MaterialMaster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shelfLifeDays rdf:type rdf:Property ;
    rdfs:label 'Shelf Life Days' ;
    rdfs:comment 'Maximum storage duration in days before the material expires or degrades. Critical for chemicals, lubricants, and perishable materials.' ;
    rdfs:domain ind:MaterialMaster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:standardCost rdf:type rdf:Property ;
    rdfs:label 'Standard Cost' ;
    rdfs:comment 'Standard unit cost used for inventory valuation, project costing, and financial reporting. Updated periodically through cost roll-up processes.' ;
    rdfs:domain ind:MaterialMaster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:storageClass rdf:type rdf:Property ;
    rdfs:label 'Storage Class' ;
    rdfs:comment 'Warehouse storage classification defining storage conditions and location requirements (e.g., indoor, outdoor, climate-controlled, hazmat-certified).' ;
    rdfs:domain ind:MaterialMaster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unspscCode rdf:type rdf:Property ;
    rdfs:label 'Unspsc Code' ;
    rdfs:comment 'Eight-digit commodity classification code used for spend analytics, supplier discovery, and regulatory reporting. Aligns with global procurement standards.' ;
    rdfs:domain ind:MaterialMaster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valuationClass rdf:type rdf:Property ;
    rdfs:label 'Valuation Class' ;
    rdfs:comment 'Accounting classification code that determines the general ledger accounts for inventory postings (e.g., raw materials, spare parts, fuel inventory).' ;
    rdfs:domain ind:MaterialMaster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:volume rdf:type rdf:Property ;
    rdfs:label 'Volume' ;
    rdfs:comment 'Physical volume of the material used for warehouse space planning and transportation optimization.' ;
    rdfs:domain ind:MaterialMaster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:volumeUnit rdf:type rdf:Property ;
    rdfs:label 'Volume Unit' ;
    rdfs:comment 'Unit of measure for volume (e.g., CFT for cubic feet, M3 for cubic meters, GAL for gallons).' ;
    rdfs:domain ind:MaterialMaster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:weightUnit rdf:type rdf:Property ;
    rdfs:label 'Weight Unit' ;
    rdfs:comment 'Unit of measure for weight fields (e.g., LB for pounds, KG for kilograms, TON for tons).' ;
    rdfs:domain ind:MaterialMaster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:purchaseRequisitionId rdf:type rdf:Property ;
    rdfs:label 'Purchase Requisition Id' ;
    rdfs:comment 'Foreign key linking to supply.purchase_requisition. Business justification: Material reservations can be created directly from purchase requisitions before PO conversion (e.g., emergency work orders reserve materials while procurement is in progress). This links the reservati' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PurchaseRequisition .

ind:requesterEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Requester Employee Id' ;
    rdfs:comment 'Employee identifier for the person who created the material reservation. Links to the human resources system (SuccessFactors or Workday) for organizational hierarchy and authorization validation.' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:erpDocumentNumber rdf:type rdf:Property ;
    rdfs:label 'Erp Document Number' ;
    rdfs:comment 'Native document identifier from the source Enterprise Resource Planning (ERP) system (SAP S/4HANA or Oracle ERP Cloud). Provides traceability back to the originating system transaction for audit, reconciliation, and support purposes.' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:finalIssueIndicator rdf:type rdf:Property ;
    rdfs:label 'Final Issue Indicator' ;
    rdfs:comment 'Flag set by the issuing warehouse or planner to indicate that no additional material will be issued against this reservation, even if the full reserved quantity has not been withdrawn. Used to close reservations when requirements change or work is completed with less material than originally planned.' ;
    rdfs:domain ind:MaterialReservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:goodsIssueCompletedFlag rdf:type rdf:Property ;
    rdfs:label 'Goods Issue Completed Flag' ;
    rdfs:comment 'Indicator that all required material has been issued from inventory against this reservation. True when issued quantity equals or exceeds reserved quantity and no further withdrawals are expected.' ;
    rdfs:domain ind:MaterialReservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mutualAidIndicator rdf:type rdf:Property ;
    rdfs:label 'Mutual Aid Indicator' ;
    rdfs:comment 'Flag indicating whether this material reservation supports mutual aid assistance to another utility. True when materials are being pre-staged or allocated for deployment to support neighboring utilities during major storm events or grid emergencies.' ;
    rdfs:domain ind:MaterialReservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requesterName rdf:type rdf:Property ;
    rdfs:label 'Requester Name' ;
    rdfs:comment 'Name of the employee, planner, or supervisor who created the material reservation. Identifies the person responsible for requesting the material allocation for the work order or project.' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiredQuantity rdf:type rdf:Property ;
    rdfs:label 'Required Quantity' ;
    rdfs:comment 'Total quantity of material requested for reservation. Represents the full amount needed to complete the associated work order, Capital Expenditure (CAPEX) project, or maintenance activity.' ;
    rdfs:domain ind:MaterialReservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:requirementDate rdf:type rdf:Property ;
    rdfs:label 'Requirement Date' ;
    rdfs:comment 'Date by which the reserved material is needed at the work location or project site. Drives material availability planning, warehouse picking schedules, and logistics coordination for Transmission and Distribution (T&D) construction projects, planned maintenance outages, and storm restoration activities.' ;
    rdfs:domain ind:MaterialReservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reservationDate rdf:type rdf:Property ;
    rdfs:label 'Reservation Date' ;
    rdfs:comment 'Date when the material reservation was created in the Enterprise Resource Planning (ERP) system. Represents the business event timestamp for the reservation transaction.' ;
    rdfs:domain ind:MaterialReservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reservationNotes rdf:type rdf:Property ;
    rdfs:label 'Reservation Notes' ;
    rdfs:comment 'Free-text field for additional information, special handling instructions, or business context related to the material reservation. May include details about material substitutions, delivery constraints, safety requirements, or coordination with field crews.' ;
    rdfs:domain ind:MaterialReservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reservationNumber rdf:type rdf:Property ;
    rdfs:label 'Reservation Number' ;
    rdfs:comment 'Business identifier for the material reservation document. Externally-known unique number assigned by the Enterprise Resource Planning (ERP) system (SAP S/4HANA or Oracle ERP Cloud) to track the reservation throughout its lifecycle.' ;
    rdfs:domain ind:MaterialReservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reservationStatus rdf:type rdf:Property ;
    rdfs:label 'Reservation Status' ;
    rdfs:comment 'Current lifecycle state of the material reservation. Tracks progression from open (newly created), partially issued (some quantity issued), fully issued (all quantity issued), cancelled (reservation voided), to closed (reservation completed and archived).' ;
    rdfs:domain ind:MaterialReservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reservationType rdf:type rdf:Property ;
    rdfs:label 'Reservation Type' ;
    rdfs:comment 'Classification of the material reservation based on the business purpose. Distinguishes between work order reservations, Capital Expenditure (CAPEX) project reservations, maintenance activity reservations, storm restoration pre-staging, planned generation outage reservations, and emergency response reservations.' ;
    rdfs:domain ind:MaterialReservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountAssignmentCategory rdf:type rdf:Property ;
    rdfs:label 'Account Assignment Category' ;
    rdfs:comment 'Category code that determines how the line item cost will be allocated in the financial system. K=Cost Center (OPEX), A=Asset (direct capitalization), P=Project/WBS Element (CAPEX), F=Order (internal order), N=Network (project network). Critical for proper CAPEX/OPEX classification and regulatory cost recovery.' ;
    rdfs:domain ind:PoLineItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confirmationControlKey rdf:type rdf:Property ;
    rdfs:label 'Confirmation Control Key' ;
    rdfs:comment 'Control key that determines whether and how the vendor must confirm the purchase order line item. Used for critical or long-lead-time materials (e.g., large transformers, generation turbines) where vendor acknowledgment of delivery dates is required before proceeding.' ;
    rdfs:domain ind:PoLineItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:goodsReceiptIndicator rdf:type rdf:Property ;
    rdfs:label 'Goods Receipt Indicator' ;
    rdfs:comment 'Boolean flag indicating whether a goods receipt (GR) is required for this line item. True for material line items that require physical receipt confirmation. False for service line items or limit items where goods receipt is not applicable. Used to control three-way match logic (PO-GR-Invoice).' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:incoterms rdf:type rdf:Property ;
    rdfs:label 'Incoterms' ;
    rdfs:comment 'Incoterms code defining the delivery terms and transfer of risk between buyer and seller (e.g., FOB, CIF, DDP). Determines who pays for shipping, insurance, and customs, and when title transfers. Critical for fuel procurement and international equipment purchases.' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incotermsLocation rdf:type rdf:Property ;
    rdfs:label 'Incoterms Location' ;
    rdfs:comment 'Named location associated with the Incoterms code (e.g., port of shipment, destination facility). Specifies the geographic point where risk and cost responsibility transfer per the Incoterms agreement.' ;
    rdfs:domain ind:PoLineItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:itemCategory rdf:type rdf:Property ;
    rdfs:label 'Item Category' ;
    rdfs:comment 'Category of the line item that determines procurement processing rules. Standard=normal material procurement, Consignment=vendor-owned inventory, Subcontracting=material provided to vendor for processing, Service=service procurement with service entry sheet, Limit=value-based item without quantity, Text=informational text line.' ;
    rdfs:domain ind:PoLineItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lineStatus rdf:type rdf:Property ;
    rdfs:label 'Line Status' ;
    rdfs:comment 'Current processing status of the line item. Open=awaiting delivery, Partially_received=some quantity received, Fully_received=all quantity received, Invoiced=invoice posted, Closed=administratively closed, Cancelled=line item cancelled. Drives procurement workflow and three-way match processing.' ;
    rdfs:domain ind:PoLineItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netValue rdf:type rdf:Property ;
    rdfs:label 'Net Value' ;
    rdfs:comment 'Total net value of this line item, calculated as ordered_quantity multiplied by unit_price, before taxes and additional charges. This is the base procurement cost for this line item and is used for three-way match validation and cost allocation to CAPEX or OPEX accounts.' ;
    rdfs:domain ind:PoLineItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:orderedQuantity rdf:type rdf:Property ;
    rdfs:label 'Ordered Quantity' ;
    rdfs:comment 'Quantity of material or service ordered on this line item. Expressed in the unit of measure specified in the uom field. For materials, this is the physical quantity (e.g., 100 meters of cable, 5 transformers). For services, this may represent hours, days, or service units.' ;
    rdfs:domain ind:PoLineItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overDeliveryTolerancePct rdf:type rdf:Property ;
    rdfs:label 'Over Delivery Tolerance Pct' ;
    rdfs:comment 'Percentage by which the delivered quantity may exceed the ordered quantity without requiring approval. For example, 5.00 allows up to 5% over-delivery. Used to accommodate normal shipping variances while controlling excess inventory and cost overruns.' ;
    rdfs:domain ind:PoLineItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:requisitionerName rdf:type rdf:Property ;
    rdfs:label 'Requisitioner Name' ;
    rdfs:comment 'Name of the employee or department that originated the purchase requisition leading to this PO line item. Used for procurement tracking, approval workflow, and accountability for material and service requests.' ;
    rdfs:domain ind:PoLineItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceEntrySheetRequired rdf:type rdf:Property ;
    rdfs:label 'Service Entry Sheet Required' ;
    rdfs:comment 'Boolean flag indicating whether a service entry sheet is required for this line item. True for service line items where service performance must be confirmed before invoice approval. False for material line items. Used for contractor labor, engineering services, and maintenance services.' ;
    rdfs:domain ind:PoLineItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:storageLocation rdf:type rdf:Property ;
    rdfs:label 'Storage Location' ;
    rdfs:comment 'Storage location code within the plant where the material will be stocked upon receipt. Used for warehouse management and inventory tracking of T&D equipment, generation spare parts, and O&M supplies. Null for direct-to-project deliveries or service line items.' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underDeliveryTolerancePct rdf:type rdf:Property ;
    rdfs:label 'Under Delivery Tolerance Pct' ;
    rdfs:comment 'Percentage by which the delivered quantity may fall short of the ordered quantity without requiring follow-up action. For example, 2.00 allows up to 2% under-delivery. Used to close line items with minor shortages without administrative burden.' ;
    rdfs:domain ind:PoLineItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:uom rdf:type rdf:Property ;
    rdfs:label 'Uom' ;
    rdfs:comment 'Unit of measure for the ordered quantity. Standard utility procurement units include EA (each), M (meter), FT (foot), GAL (gallon), TON (ton), HR (hour), KWH (kilowatt-hour), MCF (thousand cubic feet), BBL (barrel) for fuel oil, and service-specific units.' ;
    rdfs:domain ind:PoLineItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorMaterialNumber rdf:type rdf:Property ;
    rdfs:label 'Vendor Material Number' ;
    rdfs:comment 'Vendor\'s own material or catalog number for the item being procured. Used for cross-reference between the utility\'s material master and the vendor\'s product catalog. Facilitates order processing and invoice reconciliation with vendor systems.' ;
    rdfs:domain ind:PoLineItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amendmentCount rdf:type rdf:Property ;
    rdfs:label 'Amendment Count' ;
    rdfs:comment 'Total number of formal amendments executed against this contract. High amendment counts may indicate scope creep, pricing volatility, or contract management challenges. Used for contract performance analysis and vendor relationship assessment.' ;
    rdfs:domain ind:ProcurementContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:commodityCategory rdf:type rdf:Property ;
    rdfs:label 'Commodity Category' ;
    rdfs:comment 'High-level classification of goods or services covered by this contract. Examples include generation fuel (coal, natural gas, nuclear fuel), T&D equipment (transformers, conductors, poles), fleet services (vehicles, maintenance), IT hardware, professional services, or construction services. Used for spend analytics and category management.' ;
    rdfs:domain ind:ProcurementContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Contract Approval Date' ;
    rdfs:comment 'Date when the procurement contract received final internal authorization and was approved for execution. May represent board approval for high-value contracts, executive approval, or procurement authority approval depending on contract value and organizational delegation of authority.' ;
    rdfs:domain ind:ProcurementContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contractDocumentRepositoryPath rdf:type rdf:Property ;
    rdfs:label 'Contract Document Repository Path' ;
    rdfs:comment 'File path or URL to the executed contract document and amendments in the enterprise document management system. Enables quick access to full contract terms for legal review, audit, or dispute resolution. May reference SharePoint, SAP DMS (Document Management System), or dedicated contract management system.' ;
    rdfs:domain ind:ProcurementContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractExecutionDate rdf:type rdf:Property ;
    rdfs:label 'Contract Execution Date' ;
    rdfs:comment 'Date when the contract was signed by both utility and vendor, making it legally binding. May differ from effective start date if contract includes a future commencement provision. Used for contract age analysis and audit trail.' ;
    rdfs:domain ind:ProcurementContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contractOwner rdf:type rdf:Property ;
    rdfs:label 'Contract Owner' ;
    rdfs:comment 'Name or identifier of the utility employee responsible for managing this procurement contract. Typically a procurement specialist, category manager, or fuel supply manager. Accountable for contract performance monitoring, renewal negotiations, and vendor relationship management.' ;
    rdfs:domain ind:ProcurementContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fuelIndexLinkage rdf:type rdf:Property ;
    rdfs:label 'Fuel Index Linkage' ;
    rdfs:comment 'Specific commodity price index used for fuel contract price adjustments. Examples include Henry Hub natural gas spot price, NYMEX futures, regional coal price indices, or uranium spot price. Enables pass-through of commodity price volatility and aligns contract pricing with market conditions. Applicable primarily to generation fuel supply contracts.' ;
    rdfs:domain ind:ProcurementContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuranceRequirements rdf:type rdf:Property ;
    rdfs:label 'Insurance Requirements' ;
    rdfs:comment 'Contractually mandated insurance coverage the vendor must maintain. Typically includes general liability, workers compensation, professional liability (for service contracts), and automobile liability. May specify minimum coverage amounts and require utility to be named as additional insured. Critical for risk transfer and regulatory compliance.' ;
    rdfs:domain ind:ProcurementContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maximumQuantityCommitment rdf:type rdf:Property ;
    rdfs:label 'Maximum Quantity Commitment' ;
    rdfs:comment 'Contractually allowed maximum purchase quantity over the contract period. Protects vendor from unlimited demand and utility from supply shortages. Common in fuel supply contracts and equipment framework agreements. Nullable for open-ended service agreements.' ;
    rdfs:domain ind:ProcurementContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumQuantityCommitment rdf:type rdf:Property ;
    rdfs:label 'Minimum Quantity Commitment' ;
    rdfs:comment 'Contractually obligated minimum purchase quantity over the contract period. Common in fuel supply contracts (e.g., minimum annual MCF (Thousand Cubic Feet) of natural gas or tons of coal) and equipment blanket orders. Failure to meet minimum may trigger penalties or price adjustments. Nullable for value contracts or service agreements without quantity commitments.' ;
    rdfs:domain ind:ProcurementContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentTerms rdf:type rdf:Property ;
    rdfs:label 'Payment Terms' ;
    rdfs:comment 'Contractual payment schedule and conditions. Examples include Net 30, Net 60, 2/10 Net 30 (2% discount if paid within 10 days), progress payments for construction contracts, or milestone-based payments for project services. Impacts cash flow management and vendor relationship.' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performanceGuarantee rdf:type rdf:Property ;
    rdfs:label 'Performance Guarantee' ;
    rdfs:comment 'Contractual performance commitments and associated remedies. May include delivery time guarantees, quality specifications, service level agreements (SLAs), equipment performance warranties, or fuel quality specifications (BTU content, sulfur content). Defines vendor accountability and utility recourse for non-performance.' ;
    rdfs:domain ind:ProcurementContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priceEscalationClause rdf:type rdf:Property ;
    rdfs:label 'Price Escalation Clause' ;
    rdfs:comment 'Description of contractual price adjustment mechanism over time. May reference inflation indices (CPI, PPI), commodity indices (Henry Hub for natural gas, coal price indices), labor rate adjustments, or fixed annual percentage increases. Critical for multi-year contract cost forecasting and budget planning.' ;
    rdfs:domain ind:ProcurementContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:purchasingOrganization rdf:type rdf:Property ;
    rdfs:label 'Purchasing Organization' ;
    rdfs:comment 'Organizational unit within the utility responsible for procurement activities under this contract. May represent corporate procurement, generation fuel procurement, T&D (Transmission and Distribution) materials, or regional procurement centers. Aligns with SAP purchasing organization structure.' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quantityUnitOfMeasure rdf:type rdf:Property ;
    rdfs:label 'Quantity Unit Of Measure' ;
    rdfs:comment 'Unit of measure for quantity commitments and releases. Examples include MCF (Thousand Cubic Feet) or BCF (Billion Cubic Feet) for natural gas, tons for coal, MWh (Megawatt-Hour) for purchased power, each for equipment units, or hours for service contracts. Must align with vendor invoicing and inventory management units.' ;
    rdfs:domain ind:ProcurementContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryComplianceRequirements rdf:type rdf:Property ;
    rdfs:label 'Regulatory Compliance Requirements' ;
    rdfs:comment 'Contractual obligations for vendor compliance with utility industry regulations. May include NERC (North American Electric Reliability Corporation) CIP (Critical Infrastructure Protection) requirements for cyber security, OSHA (Occupational Safety and Health Administration) safety standards, EPA (Environmental Protection Agency) environmental regulations, or state PUC (Public Utility Commission) procurement rules. Ensures vendor activities do not create regulatory risk for utility.' ;
    rdfs:domain ind:ProcurementContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalTerms rdf:type rdf:Property ;
    rdfs:label 'Renewal Terms' ;
    rdfs:comment 'Contractual provisions for contract extension or renewal. May specify automatic renewal unless notice given, option periods with defined pricing, or requirement for renegotiation. Includes notice period requirements (e.g., 90 days prior to expiration) and conditions for renewal pricing adjustments.' ;
    rdfs:domain ind:ProcurementContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sapOutlineAgreementNumber rdf:type rdf:Property ;
    rdfs:label 'Sap Outline Agreement Number' ;
    rdfs:comment 'SAP S/4HANA system document number for the outline agreement (contract or scheduling agreement) record. Enables integration between procurement contract master data and SAP MM (Materials Management) purchase order release, goods receipt, and invoice verification processes. Critical for ERP (Enterprise Resource Planning) system traceability.' ;
    rdfs:domain ind:ProcurementContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:terminationClause rdf:type rdf:Property ;
    rdfs:label 'Termination Clause' ;
    rdfs:comment 'Contractual provisions allowing early termination by either party. May include termination for convenience (with notice period and penalties), termination for cause (vendor non-performance, safety violations), force majeure provisions, or change-in-law provisions. Critical for risk management and contract flexibility.' ;
    rdfs:domain ind:ProcurementContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalContractValue rdf:type rdf:Property ;
    rdfs:label 'Total Contract Value' ;
    rdfs:comment 'Maximum financial commitment under this contract in USD (United States Dollars). For value contracts, represents the spending limit; for quantity contracts, represents estimated total value based on committed quantities and unit prices. Used for budget planning, spend tracking, and contract authority approval thresholds.' ;
    rdfs:domain ind:ProcurementContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:employeeId rdf:type rdf:Property ;
    rdfs:label 'Employee Id' ;
    rdfs:comment 'Reference to the procurement specialist or purchasing agent responsible for this PO. Links to employee master record.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:buyerName rdf:type rdf:Property ;
    rdfs:label 'Buyer Name' ;
    rdfs:comment 'Full name of the procurement specialist responsible for this purchase order. Denormalized for reporting and audit trail.' ;
    rdfs:domain ind:PurchaseOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryAddress rdf:type rdf:Property ;
    rdfs:label 'Delivery Address' ;
    rdfs:comment 'Full physical address for material delivery or service performance location. May differ from plant master address for field construction or emergency restoration sites.' ;
    rdfs:domain ind:PurchaseOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:freightAmount rdf:type rdf:Property ;
    rdfs:label 'Freight Amount' ;
    rdfs:comment 'Shipping, transportation, or logistics charges associated with material delivery. May be vendor-charged or utility-arranged depending on incoterms.' ;
    rdfs:domain ind:PurchaseOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:invoiceReceiptIndicator rdf:type rdf:Property ;
    rdfs:label 'Invoice Receipt Indicator' ;
    rdfs:comment 'Flag indicating whether invoice verification is required before payment. Supports three-way match control (PO, goods receipt, invoice) for SOX compliance.' ;
    rdfs:domain ind:PurchaseOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:poDate rdf:type rdf:Property ;
    rdfs:label 'Po Date' ;
    rdfs:comment 'Date the purchase order was created and issued to the vendor. Establishes the contractual commitment date and payment terms baseline.' ;
    rdfs:domain ind:PurchaseOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:poNumber rdf:type rdf:Property ;
    rdfs:label 'Po Number' ;
    rdfs:comment 'Externally-known business identifier for the purchase order. Unique document number assigned by SAP S/4HANA or Oracle ERP Cloud for procurement tracking and vendor communication.' ;
    rdfs:domain ind:PurchaseOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:poStatus rdf:type rdf:Property ;
    rdfs:label 'Po Status' ;
    rdfs:comment 'Current lifecycle state of the purchase order in the procurement-to-pay workflow. Tracks progression from creation through goods receipt and final closure. [ENUM-REF-CANDIDATE: draft|approved|issued|partially_received|fully_received|closed|cancelled — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:PurchaseOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:poType rdf:type rdf:Property ;
    rdfs:label 'Po Type' ;
    rdfs:comment 'Classification of the purchase order based on procurement strategy. Standard for one-time purchases, blanket for recurring material releases, framework for long-term agreements, service for labor/consulting, contract for multi-year commitments.' ;
    rdfs:domain ind:PurchaseOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:promisedDeliveryDate rdf:type rdf:Property ;
    rdfs:label 'Promised Delivery Date' ;
    rdfs:comment 'Date committed by the vendor for delivery or service completion. Used for supplier performance tracking and expediting follow-up.' ;
    rdfs:domain ind:PurchaseOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:requestedDeliveryDate rdf:type rdf:Property ;
    rdfs:label 'Requested Delivery Date' ;
    rdfs:comment 'Date by which the utility requires materials or services to be delivered. Drives vendor lead time planning and expediting priorities for outage restoration or project schedules.' ;
    rdfs:domain ind:PurchaseOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:requisitionNumber rdf:type rdf:Property ;
    rdfs:label 'Requisition Number' ;
    rdfs:comment 'Source purchase requisition document number that originated this PO. Provides traceability from internal demand to external procurement.' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalPoValue rdf:type rdf:Property ;
    rdfs:label 'Total Po Value' ;
    rdfs:comment 'Total monetary value of the purchase order including all line items, before taxes and freight. Represents the committed spend amount for budget tracking and vendor payment.' ;
    rdfs:domain ind:PurchaseOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalPoValueWithTax rdf:type rdf:Property ;
    rdfs:label 'Total Po Value With Tax' ;
    rdfs:comment 'Grand total of the purchase order including base value, taxes, and freight. Represents the maximum payment obligation to the vendor.' ;
    rdfs:domain ind:PurchaseOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vendorSiteCode rdf:type rdf:Property ;
    rdfs:label 'Vendor Site Code' ;
    rdfs:comment 'Specific vendor location or branch code for multi-site suppliers. Identifies the remit-to address and payment processing location.' ;
    rdfs:domain ind:PurchaseOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryPurchaseMaterialMasterId rdf:type rdf:Property ;
    rdfs:label 'Primary Purchase Material Master Id' ;
    rdfs:comment 'Reference to the cataloged material master record for standard inventory items. Populated for requisitions requesting materials from the enterprise material catalog. Null for non-catalog or free-text service requisitions.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MaterialMaster .

ind:approvalWorkflowCode rdf:type rdf:Property ;
    rdfs:label 'Approval Workflow Code' ;
    rdfs:comment 'Identifier for the approval workflow instance routing this requisition through the release strategy. Tracks the multi-level approval process based on requisition value thresholds and organizational hierarchy.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvedByName rdf:type rdf:Property ;
    rdfs:label 'Approved By Name' ;
    rdfs:comment 'Name of the manager or authorized approver who granted final approval for the requisition. Null if requisition is still pending approval or was rejected.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedTotalValue rdf:type rdf:Property ;
    rdfs:label 'Estimated Total Value' ;
    rdfs:comment 'Total estimated value of the requisition line, calculated as requested quantity multiplied by estimated unit price. Used for approval threshold determination and budget commitment.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedUnitPrice rdf:type rdf:Property ;
    rdfs:label 'Estimated Unit Price' ;
    rdfs:comment 'Estimated or budgeted price per unit of measure for the requested item or service. Used for budget validation and purchase order creation. May be based on historical pricing, catalog rates, or requester estimate.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:poConversionDate rdf:type rdf:Property ;
    rdfs:label 'Po Conversion Date' ;
    rdfs:comment 'Date on which the approved requisition was converted into a purchase order by the purchasing group. Marks the transition from internal demand to external vendor commitment.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:priorityIndicator rdf:type rdf:Property ;
    rdfs:label 'Priority Indicator' ;
    rdfs:comment 'Urgency classification for the requisition. Normal for standard procurement lead times, urgent for expedited processing, emergency for immediate operational needs (e.g., equipment failure), critical for safety or regulatory compliance requirements.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestedQuantity rdf:type rdf:Property ;
    rdfs:label 'Requested Quantity' ;
    rdfs:comment 'Quantity of material or service units requested in this requisition line. Expressed in the unit of measure specified in the unit_of_measure field.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:requesterDepartment rdf:type rdf:Property ;
    rdfs:label 'Requester Department' ;
    rdfs:comment 'Organizational department or functional area of the requester. Examples include Generation Operations, Transmission Maintenance, Distribution Field Services, Gas Operations, or Capital Projects.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiredDeliveryDate rdf:type rdf:Property ;
    rdfs:label 'Required Delivery Date' ;
    rdfs:comment 'Date by which the requested material or service must be delivered to meet operational or project schedule requirements. Used for procurement planning and vendor lead time evaluation.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:requisitionNotes rdf:type rdf:Property ;
    rdfs:label 'Requisition Notes' ;
    rdfs:comment 'Free-text notes and comments providing additional context, special instructions, or business justification for the requisition. May include technical specifications, delivery instructions, or project background.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requisitionStatus rdf:type rdf:Property ;
    rdfs:label 'Requisition Status' ;
    rdfs:comment 'Current lifecycle state of the purchase requisition in the approval and procurement workflow. Tracks progression from initial creation through approval gates to conversion into a purchase order or rejection. [ENUM-REF-CANDIDATE: created|pending_approval|approved|rejected|converted_to_po|cancelled|on_hold — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requisitionType rdf:type rdf:Property ;
    rdfs:label 'Requisition Type' ;
    rdfs:comment 'Classification of the purchase requisition based on the nature of the procurement request. Standard material for cataloged inventory items, service for contracted labor or professional services, fuel for generation plant coal/gas/oil purchases, emergency for urgent unplanned needs, storm restoration for outage recovery materials, and capital project for CAPEX-funded equipment and construction materials.' ;
    rdfs:domain ind:PurchaseRequisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stockTransferId rdf:type rdf:Property ;
    rdfs:label 'Stock Transfer Id' ;
    rdfs:comment 'Unique identifier for the stock transfer transaction. Primary key for the stock transfer record.' ;
    rdfs:domain ind:StockTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:receivingWarehouseId rdf:type rdf:Property ;
    rdfs:label 'Receiving Warehouse Id' ;
    rdfs:comment 'Identifier of the warehouse or storage location to which material is being transferred. References the destination facility in the utility supply network.' ;
    rdfs:domain ind:StockTransfer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Warehouse .

ind:sendingWarehouseId rdf:type rdf:Property ;
    rdfs:label 'Sending Warehouse Id' ;
    rdfs:comment 'Identifier of the warehouse or storage location from which material is being transferred. References the originating facility in the utility supply network.' ;
    rdfs:domain ind:StockTransfer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Warehouse .

ind:actualReceiptDate rdf:type rdf:Property ;
    rdfs:label 'Actual Receipt Date' ;
    rdfs:comment 'Date on which material was physically received at the destination location. Captures the actual goods receipt date for inventory reconciliation and completion tracking.' ;
    rdfs:domain ind:StockTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:actualShipmentDate rdf:type rdf:Property ;
    rdfs:label 'Actual Shipment Date' ;
    rdfs:comment 'Date on which material was physically shipped or issued from the sending location. Captures the actual goods movement date for inventory and logistics tracking.' ;
    rdfs:domain ind:StockTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:carrierName rdf:type rdf:Property ;
    rdfs:label 'Carrier Name' ;
    rdfs:comment 'Name of the transportation carrier or logistics provider handling the material movement. May be internal utility fleet or external common carrier.' ;
    rdfs:domain ind:StockTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mutualAidUtilityName rdf:type rdf:Property ;
    rdfs:label 'Mutual Aid Utility Name' ;
    rdfs:comment 'Name of the external utility involved in the mutual aid material transfer. Identifies the lending or borrowing utility for inter-utility material loan tracking and settlement.' ;
    rdfs:domain ind:StockTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receiptTimestamp rdf:type rdf:Property ;
    rdfs:label 'Receipt Timestamp' ;
    rdfs:comment 'Precise date and time when material was received at the destination warehouse. Enables calculation of transit time and supports real-time inventory visibility.' ;
    rdfs:domain ind:StockTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:receivingPlantCode rdf:type rdf:Property ;
    rdfs:label 'Receiving Plant Code' ;
    rdfs:comment 'ERP plant code for the destination facility. Identifies the generation plant, service center, or operational facility to which material is being transferred.' ;
    rdfs:domain ind:StockTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receivingStorageLocation rdf:type rdf:Property ;
    rdfs:label 'Receiving Storage Location' ;
    rdfs:comment 'Storage location code within the receiving plant or warehouse. Identifies the specific storeroom, bin, or inventory zone where material will be received.' ;
    rdfs:domain ind:StockTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestedTransferDate rdf:type rdf:Property ;
    rdfs:label 'Requested Transfer Date' ;
    rdfs:comment 'Date on which the material transfer was requested or scheduled to occur. Represents the planned transfer date for logistics planning and coordination.' ;
    rdfs:domain ind:StockTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sendingPlantCode rdf:type rdf:Property ;
    rdfs:label 'Sending Plant Code' ;
    rdfs:comment 'ERP plant code for the originating facility. Identifies the generation plant, service center, or operational facility from which material is being transferred.' ;
    rdfs:domain ind:StockTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sendingStorageLocation rdf:type rdf:Property ;
    rdfs:label 'Sending Storage Location' ;
    rdfs:comment 'Storage location code within the sending plant or warehouse. Identifies the specific storeroom, bin, or inventory zone from which material is issued.' ;
    rdfs:domain ind:StockTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shipmentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Shipment Timestamp' ;
    rdfs:comment 'Precise date and time when material was issued from the sending warehouse. Provides granular tracking for time-sensitive transfers such as storm restoration emergency deployments.' ;
    rdfs:domain ind:StockTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:shippingDocumentNumber rdf:type rdf:Property ;
    rdfs:label 'Shipping Document Number' ;
    rdfs:comment 'Reference number of the shipping document or bill of lading accompanying the material transfer. Used for carrier tracking and proof of shipment.' ;
    rdfs:domain ind:StockTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferNotes rdf:type rdf:Property ;
    rdfs:label 'Transfer Notes' ;
    rdfs:comment 'Free-text notes or comments regarding the stock transfer. Captures special handling instructions, condition observations, or other relevant information for logistics and receiving personnel.' ;
    rdfs:domain ind:StockTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Transfer Order Number' ;
    rdfs:comment 'Business identifier for the stock transfer order. Externally-known reference number used in SAP S/4HANA or Oracle ERP for tracking material movements between locations.' ;
    rdfs:domain ind:StockTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferQuantity rdf:type rdf:Property ;
    rdfs:label 'Transfer Quantity' ;
    rdfs:comment 'Quantity of material being transferred from sending to receiving location. Measured in the unit of measure specified for the material.' ;
    rdfs:domain ind:StockTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transferReasonCode rdf:type rdf:Property ;
    rdfs:label 'Transfer Reason Code' ;
    rdfs:comment 'Code indicating the business reason for the stock transfer. Examples include stock balancing, project material allocation, emergency restoration, planned maintenance support, or mutual aid deployment.' ;
    rdfs:domain ind:StockTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferStatus rdf:type rdf:Property ;
    rdfs:label 'Transfer Status' ;
    rdfs:comment 'Current lifecycle status of the stock transfer. Tracks progression from order creation through shipment, receipt, and completion or cancellation.' ;
    rdfs:domain ind:StockTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transportMode rdf:type rdf:Property ;
    rdfs:label 'Transport Mode' ;
    rdfs:comment 'Method of transportation used for the stock transfer. Includes utility-owned vehicles, third-party carriers, emergency air transport for storm restoration, and mutual aid logistics.' ;
    rdfs:domain ind:StockTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Bank Account Number' ;
    rdfs:comment 'Vendor bank account number for EFT payment processing. Encrypted at rest and in transit per PCI DSS standards.' ;
    rdfs:domain ind:Vendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankName rdf:type rdf:Property ;
    rdfs:label 'Bank Name' ;
    rdfs:comment 'Name of the financial institution holding the vendor\'s account for Electronic Funds Transfer (EFT) payments.' ;
    rdfs:domain ind:Vendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bondingCapacityUsd rdf:type rdf:Property ;
    rdfs:label 'Bonding Capacity Usd' ;
    rdfs:comment 'Maximum dollar value of performance and payment bonds the vendor can secure from surety. Critical for large CAPEX construction projects (transmission lines, substations, generation plant construction). Expressed in US dollars.' ;
    rdfs:domain ind:Vendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:diversityClassification rdf:type rdf:Property ;
    rdfs:label 'Diversity Classification' ;
    rdfs:comment 'Supplier diversity certification status. Minority Business Enterprise (MBE), Women Business Enterprise (WBE), Small Business Enterprise (SBE), Service-Disabled Veteran-Owned Business (SDVOB), or other diversity designations. Supports regulatory supplier diversity reporting and corporate social responsibility goals. [ENUM-REF-CANDIDATE: mbe|wbe|sbe|sdvob|dbe|lgbtbe|vbe|none — promote to reference product]' ;
    rdfs:domain ind:Vendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuranceCertificateStatus rdf:type rdf:Property ;
    rdfs:label 'Insurance Certificate Status' ;
    rdfs:comment 'Status of the vendor\'s certificate of insurance (COI) demonstrating required liability, workers compensation, and other coverage. Current indicates valid coverage on file; expired triggers procurement hold; pending indicates renewal in process.' ;
    rdfs:domain ind:Vendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuranceExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Insurance Expiration Date' ;
    rdfs:comment 'Expiration date of the vendor\'s current certificate of insurance. Monitored for proactive renewal to avoid procurement disruption.' ;
    rdfs:domain ind:Vendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastTransactionDate rdf:type rdf:Property ;
    rdfs:label 'Last Transaction Date' ;
    rdfs:comment 'Date of the most recent purchase order, invoice, or payment transaction with the vendor. Used to identify inactive vendors for master data cleanup.' ;
    rdfs:domain ind:Vendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:modifiedByUser rdf:type rdf:Property ;
    rdfs:label 'Modified By User' ;
    rdfs:comment 'User ID or system account that last modified the vendor record. Supports audit trail and accountability for master data changes.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:oshaEmr rdf:type rdf:Property ;
    rdfs:label 'Osha Emr' ;
    rdfs:comment 'OSHA Experience Modification Rate (EMR) reflecting the vendor\'s workplace safety record. EMR below 1.0 indicates better-than-average safety performance; above 1.0 indicates higher incident rates. Used for contractor prequalification and risk assessment for T&D and generation services contractors.' ;
    rdfs:domain ind:Vendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentMethod rdf:type rdf:Property ;
    rdfs:label 'Payment Method' ;
    rdfs:comment 'Preferred method for remitting payment to the vendor. Electronic Funds Transfer (EFT) and Automated Clearing House (ACH) are standard for recurring payments; wire transfer for large or urgent payments; check for vendors without electronic banking; credit card for small purchases.' ;
    rdfs:domain ind:Supply ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredCurrency rdf:type rdf:Property ;
    rdfs:label 'Preferred Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for vendor invoicing and payment (e.g., USD, CAD, EUR). Determines currency for purchase orders and remittance.' ;
    rdfs:domain ind:Vendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:prequalificationExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Prequalification Expiration Date' ;
    rdfs:comment 'Date when the vendor\'s prequalification status expires and must be renewed. Typically annual or biennial review cycle.' ;
    rdfs:domain ind:Vendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:prequalificationStatus rdf:type rdf:Property ;
    rdfs:label 'Prequalification Status' ;
    rdfs:comment 'Indicates whether the vendor has completed and passed the utility\'s prequalification process for technical capability, financial stability, safety record, and regulatory compliance. Prequalified vendors are eligible for competitive bidding on major projects.' ;
    rdfs:domain ind:Vendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remittanceAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Remittance Address Line1' ;
    rdfs:comment 'Primary street address line for vendor payment remittance. Used for check mailing and correspondence.' ;
    rdfs:domain ind:Vendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remittanceAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Remittance Address Line2' ;
    rdfs:comment 'Secondary address line for vendor payment remittance (suite, floor, building).' ;
    rdfs:domain ind:Vendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remittanceCity rdf:type rdf:Property ;
    rdfs:label 'Remittance City' ;
    rdfs:comment 'City for vendor payment remittance address.' ;
    rdfs:domain ind:Vendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remittanceCountry rdf:type rdf:Property ;
    rdfs:label 'Remittance Country' ;
    rdfs:comment 'Three-letter ISO country code for vendor payment remittance address (e.g., USA, CAN, MEX).' ;
    rdfs:domain ind:Vendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remittancePostalCode rdf:type rdf:Property ;
    rdfs:label 'Remittance Postal Code' ;
    rdfs:comment 'Postal or ZIP code for vendor payment remittance address.' ;
    rdfs:domain ind:Vendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remittanceState rdf:type rdf:Property ;
    rdfs:label 'Remittance State' ;
    rdfs:comment 'State or province code for vendor payment remittance address. Two-letter US state code or equivalent.' ;
    rdfs:domain ind:Vendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sinceDate rdf:type rdf:Property ;
    rdfs:label 'Since Date' ;
    rdfs:comment 'Date the vendor relationship was established and the vendor record was first created in the system. Used for vendor tenure analysis and relationship management.' ;
    rdfs:domain ind:Vendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:vendorStatus rdf:type rdf:Property ;
    rdfs:label 'Vendor Status' ;
    rdfs:comment 'Current lifecycle status of the vendor relationship. Active vendors are approved for procurement; prequalified vendors have passed initial screening but not yet transacted; suspended vendors are temporarily blocked due to performance or compliance issues; disqualified vendors are permanently barred; pending approval vendors are under review.' ;
    rdfs:domain ind:Vendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorType rdf:type rdf:Property ;
    rdfs:label 'Vendor Type' ;
    rdfs:comment 'Categorization of vendor by transaction type. Goods vendors supply materials and equipment; services vendors provide labor, consulting, or professional services; goods and services vendors provide both.' ;
    rdfs:domain ind:Vendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:w9OnFile rdf:type rdf:Property ;
    rdfs:label 'W9 On File' ;
    rdfs:comment 'Boolean flag indicating whether a current IRS Form W-9 (Request for Taxpayer Identification Number and Certification) is on file for the vendor. Required for 1099 reporting and tax compliance.' ;
    rdfs:domain ind:Vendor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:websiteUrl rdf:type rdf:Property ;
    rdfs:label 'Website Url' ;
    rdfs:comment 'Public website URL for the vendor organization. Used for vendor research, catalog access, and due diligence.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approverName rdf:type rdf:Property ;
    rdfs:label 'Approver Name' ;
    rdfs:comment 'Name of the person who approved the invoice for payment. Used for audit trail and accountability.' ;
    rdfs:domain ind:VendorInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discountAmount rdf:type rdf:Property ;
    rdfs:label 'Discount Amount' ;
    rdfs:comment 'Cash discount or early payment discount amount available if payment is made within discount period.' ;
    rdfs:domain ind:VendorInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:duplicateInvoiceFlag rdf:type rdf:Property ;
    rdfs:label 'Duplicate Invoice Flag' ;
    rdfs:comment 'Flag indicating whether this invoice has been identified as a potential duplicate of a previously processed invoice. True if duplicate detected.' ;
    rdfs:domain ind:VendorInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fiDocumentNumber rdf:type rdf:Property ;
    rdfs:label 'Fi Document Number' ;
    rdfs:comment 'SAP FI document number assigned when the invoice is posted to the general ledger. Links invoice to financial accounting entries.' ;
    rdfs:domain ind:VendorInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grossInvoiceAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Invoice Amount' ;
    rdfs:comment 'Total invoice amount before any deductions or adjustments. Includes line item amounts and freight charges.' ;
    rdfs:domain ind:VendorInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:invoiceDescription rdf:type rdf:Property ;
    rdfs:label 'Invoice Description' ;
    rdfs:comment 'Free-text description of the invoice contents or purpose. Provides additional context for invoice review and approval.' ;
    rdfs:domain ind:VendorInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netInvoiceAmount rdf:type rdf:Property ;
    rdfs:label 'Net Invoice Amount' ;
    rdfs:comment 'Net payable amount after applying taxes, discounts, and adjustments. Amount to be paid to vendor.' ;
    rdfs:domain ind:VendorInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentBlockIndicator rdf:type rdf:Property ;
    rdfs:label 'Payment Block Indicator' ;
    rdfs:comment 'Flag indicating whether payment is blocked pending resolution of discrepancies or approval. True if payment is blocked.' ;
    rdfs:domain ind:VendorInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentBlockReason rdf:type rdf:Property ;
    rdfs:label 'Payment Block Reason' ;
    rdfs:comment 'Reason code or description explaining why payment is blocked (e.g., price variance, quantity variance, missing approval, duplicate invoice).' ;
    rdfs:domain ind:VendorInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Payment Reference Number' ;
    rdfs:comment 'Payment document number or check number assigned when payment is executed. Links invoice to payment transaction.' ;
    rdfs:domain ind:VendorInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentTermsCode rdf:type rdf:Property ;
    rdfs:label 'Payment Terms Code' ;
    rdfs:comment 'Code representing the payment terms agreed with the vendor (e.g., Net 30, 2/10 Net 30). Determines due date and discount eligibility.' ;
    rdfs:domain ind:VendorInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:threeWayMatchStatus rdf:type rdf:Property ;
    rdfs:label 'Three Way Match Status' ;
    rdfs:comment 'Result of the three-way match verification comparing purchase order, goods receipt, and invoice. Indicates whether invoice can be approved for payment.' ;
    rdfs:domain ind:VendorInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Vendor Reference Number' ;
    rdfs:comment 'Vendor\'s internal reference number or order confirmation number cited on the invoice. Used for vendor inquiry and dispute resolution.' ;
    rdfs:domain ind:VendorInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:withholdingTaxAmount rdf:type rdf:Property ;
    rdfs:label 'Withholding Tax Amount' ;
    rdfs:comment 'Amount of withholding tax deducted from vendor payment per tax regulations. Reduces net payment to vendor.' ;
    rdfs:domain ind:VendorInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vendorPerformanceId rdf:type rdf:Property ;
    rdfs:label 'Vendor Performance Id' ;
    rdfs:comment 'Unique identifier for the vendor performance evaluation record.' ;
    rdfs:domain ind:VendorPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:approvedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Approved By Employee Id' ;
    rdfs:comment 'Reference to the procurement manager or director who approved the final performance evaluation. Null if not yet approved.' ;
    rdfs:domain ind:VendorPerformance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:evaluatorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Evaluator Employee Id' ;
    rdfs:comment 'Reference to the buyer, contract manager, or procurement specialist who conducted the performance evaluation.' ;
    rdfs:domain ind:VendorPerformance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:bidEvaluationScoreAdjustment rdf:type rdf:Property ;
    rdfs:label 'Bid Evaluation Score Adjustment' ;
    rdfs:comment 'Adjustment factor (positive or negative) applied to future bid evaluation scores based on historical performance. High performers receive positive adjustments; poor performers receive negative adjustments.' ;
    rdfs:domain ind:VendorPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contractRenewalRecommendation rdf:type rdf:Property ;
    rdfs:label 'Contract Renewal Recommendation' ;
    rdfs:comment 'Evaluator\'s recommendation regarding contract renewal or continuation based on the performance assessment. Used in contract renewal negotiations.' ;
    rdfs:domain ind:VendorPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctiveActionPlanDueDate rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Plan Due Date' ;
    rdfs:comment 'The date by which the vendor must complete the corrective action plan. Null if no CAP is required.' ;
    rdfs:domain ind:VendorPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:correctiveActionPlanRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Plan Required Flag' ;
    rdfs:comment 'Indicates whether a corrective action plan (CAP) is required due to performance deficiencies identified in this evaluation. True if CAP is required, False otherwise.' ;
    rdfs:domain ind:VendorPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deliveryWeightPercentage rdf:type rdf:Property ;
    rdfs:label 'Delivery Weight Percentage' ;
    rdfs:comment 'The weighting percentage applied to on-time delivery performance in the overall performance rating calculation. Default is 30.00%.' ;
    rdfs:domain ind:VendorPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:diversitySpendPercentage rdf:type rdf:Property ;
    rdfs:label 'Diversity Spend Percentage' ;
    rdfs:comment 'Percentage of the vendor\'s subcontractor spend or workforce that qualifies under the utility\'s supplier diversity program (minority-owned, women-owned, veteran-owned, small business). Expressed as a percentage (0.00 to 100.00).' ;
    rdfs:domain ind:VendorPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:diversityWeightPercentage rdf:type rdf:Property ;
    rdfs:label 'Diversity Weight Percentage' ;
    rdfs:comment 'The weighting percentage applied to diversity spend performance in the overall performance rating calculation. Default is 10.00%.' ;
    rdfs:domain ind:VendorPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:emrScore rdf:type rdf:Property ;
    rdfs:label 'Emr Score' ;
    rdfs:comment 'The Experience Modification Rate (EMR) for the contractor, a multiplier used by insurance companies to price workers\' compensation premiums. A score of 1.0 is average; below 1.0 indicates better-than-average safety performance; above 1.0 indicates worse-than-average. Critical for field service contractors.' ;
    rdfs:domain ind:VendorPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:environmentalComplianceIncidents rdf:type rdf:Property ;
    rdfs:label 'Environmental Compliance Incidents' ;
    rdfs:comment 'Count of environmental compliance violations or incidents (spills, emissions exceedances, permit violations) attributed to the vendor during the evaluation period.' ;
    rdfs:domain ind:VendorPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:evaluationDate rdf:type rdf:Property ;
    rdfs:label 'Evaluation Date' ;
    rdfs:comment 'The date on which the performance evaluation was completed and recorded.' ;
    rdfs:domain ind:VendorPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:evaluationNotes rdf:type rdf:Property ;
    rdfs:label 'Evaluation Notes' ;
    rdfs:comment 'Free-text notes and comments from the evaluator providing additional context, highlighting specific incidents, commendations, or concerns not captured in quantitative metrics.' ;
    rdfs:domain ind:VendorPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evaluationPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Evaluation Period End Date' ;
    rdfs:comment 'The end date of the performance evaluation period.' ;
    rdfs:domain ind:VendorPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:evaluationPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Evaluation Period Start Date' ;
    rdfs:comment 'The start date of the performance evaluation period (quarterly, annual, or project-specific).' ;
    rdfs:domain ind:VendorPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:evaluationStatus rdf:type rdf:Property ;
    rdfs:label 'Evaluation Status' ;
    rdfs:comment 'Current workflow status of the performance evaluation record. Tracks progression from draft through approval and finalization.' ;
    rdfs:domain ind:VendorPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evaluationType rdf:type rdf:Property ;
    rdfs:label 'Evaluation Type' ;
    rdfs:comment 'The type or frequency of the performance evaluation (quarterly for strategic suppliers, annual for standard vendors, project-based for major T&D construction and generation outage contractors, or contract renewal assessment).' ;
    rdfs:domain ind:VendorPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evaluatorName rdf:type rdf:Property ;
    rdfs:label 'Evaluator Name' ;
    rdfs:comment 'Full name of the person who conducted the vendor performance evaluation.' ;
    rdfs:domain ind:VendorPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:invoiceAccuracyRate rdf:type rdf:Property ;
    rdfs:label 'Invoice Accuracy Rate' ;
    rdfs:comment 'Percentage of vendor invoices that were accurate and required no correction or dispute during the evaluation period. Expressed as a percentage (0.00 to 100.00).' ;
    rdfs:domain ind:VendorPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:invoiceAccuracyWeightPercentage rdf:type rdf:Property ;
    rdfs:label 'Invoice Accuracy Weight Percentage' ;
    rdfs:comment 'The weighting percentage applied to invoice accuracy performance in the overall performance rating calculation. Default is 10.00%.' ;
    rdfs:domain ind:VendorPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:materialRejectionRate rdf:type rdf:Property ;
    rdfs:label 'Material Rejection Rate' ;
    rdfs:comment 'Percentage of received materials or services that failed quality inspection and were rejected during the evaluation period. Expressed as a percentage (0.00 to 100.00).' ;
    rdfs:domain ind:VendorPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:onTimeDeliveryRate rdf:type rdf:Property ;
    rdfs:label 'On Time Delivery Rate' ;
    rdfs:comment 'Percentage of purchase orders or deliverables delivered on or before the scheduled delivery date during the evaluation period. Expressed as a percentage (0.00 to 100.00).' ;
    rdfs:domain ind:VendorPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:oshaRecordableIncidentRate rdf:type rdf:Property ;
    rdfs:label 'Osha Recordable Incident Rate' ;
    rdfs:comment 'The number of OSHA recordable safety incidents per 200,000 work hours for contractor field crews during the evaluation period. Critical for T&D construction and generation outage contractors.' ;
    rdfs:domain ind:VendorPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overallPerformanceRating rdf:type rdf:Property ;
    rdfs:label 'Overall Performance Rating' ;
    rdfs:comment 'Weighted overall performance rating on a 1.00 to 5.00 scale, calculated using configurable weighting: 30% delivery, 25% quality, 25% safety, 10% invoice accuracy, 10% diversity. Used for vendor qualification and contract renewal decisions.' ;
    rdfs:domain ind:VendorPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preferredVendorListEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Preferred Vendor List Eligible Flag' ;
    rdfs:comment 'Indicates whether the vendor qualifies for inclusion on the preferred vendor list based on this performance evaluation. True if eligible, False if performance does not meet preferred vendor criteria.' ;
    rdfs:domain ind:VendorPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qualityWeightPercentage rdf:type rdf:Property ;
    rdfs:label 'Quality Weight Percentage' ;
    rdfs:comment 'The weighting percentage applied to quality performance (material rejection rate) in the overall performance rating calculation. Default is 25.00%.' ;
    rdfs:domain ind:VendorPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:safetyComplianceScore rdf:type rdf:Property ;
    rdfs:label 'Safety Compliance Score' ;
    rdfs:comment 'Overall safety compliance score based on adherence to utility safety protocols, completion of required safety training, and audit results. Expressed as a percentage (0.00 to 100.00).' ;
    rdfs:domain ind:VendorPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:safetyWeightPercentage rdf:type rdf:Property ;
    rdfs:label 'Safety Weight Percentage' ;
    rdfs:comment 'The weighting percentage applied to safety performance (OSHA rate, EMR, compliance score) in the overall performance rating calculation. Default is 25.00%.' ;
    rdfs:domain ind:VendorPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalPurchaseOrdersEvaluated rdf:type rdf:Property ;
    rdfs:label 'Total Purchase Orders Evaluated' ;
    rdfs:comment 'The total number of purchase orders or delivery events included in this performance evaluation period.' ;
    rdfs:domain ind:VendorPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalSpendAmount rdf:type rdf:Property ;
    rdfs:label 'Total Spend Amount' ;
    rdfs:comment 'The total dollar amount spent with this vendor during the evaluation period. Used to weight vendor importance in strategic sourcing decisions.' ;
    rdfs:domain ind:VendorPerformance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:backupPowerAvailable rdf:type rdf:Property ;
    rdfs:label 'Backup Power Available' ;
    rdfs:comment 'Indicates whether the warehouse facility has backup power generation capability (e.g., diesel generator, battery storage) to maintain operations during grid outages. Critical for facilities supporting emergency restoration.' ;
    rdfs:domain ind:Warehouse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:buildingYear rdf:type rdf:Property ;
    rdfs:label 'Building Year' ;
    rdfs:comment 'Year the warehouse facility was originally constructed. Used for asset age analysis and maintenance planning.' ;
    rdfs:domain ind:Warehouse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:climateControlled rdf:type rdf:Property ;
    rdfs:label 'Climate Controlled' ;
    rdfs:comment 'Indicates whether the warehouse facility has climate control capabilities (heating, ventilation, and air conditioning) required for temperature-sensitive materials and equipment.' ;
    rdfs:domain ind:Warehouse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:facilityType rdf:type rdf:Property ;
    rdfs:label 'Facility Type' ;
    rdfs:comment 'Classification of the warehouse facility based on its operational purpose and scope. Central warehouses serve as primary distribution hubs, field storerooms support local Transmission and Distribution (T&D) operations, generation plant stores support power plant Operations and Maintenance (O&M), mobile storm units provide emergency restoration logistics, and yards support outdoor equipment staging.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fireSuppressionSystem rdf:type rdf:Property ;
    rdfs:label 'Fire Suppression System' ;
    rdfs:comment 'Type of fire suppression system installed in the warehouse facility. Required for insurance compliance and Occupational Safety and Health Administration (OSHA) safety standards.' ;
    rdfs:domain ind:Warehouse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hazmatCertificationExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Hazmat Certification Expiry Date' ;
    rdfs:comment 'Expiration date of the hazardous materials storage certification. Facilities must maintain current certification to store regulated substances.' ;
    rdfs:domain ind:Warehouse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:hazmatCertificationNumber rdf:type rdf:Property ;
    rdfs:label 'Hazmat Certification Number' ;
    rdfs:comment 'Official certification number issued by regulatory authority for hazardous materials storage. Required for facilities storing regulated substances under Pipeline and Hazardous Materials Safety Administration (PHMSA) and Occupational Safety and Health Administration (OSHA) regulations.' ;
    rdfs:domain ind:Warehouse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hazmatCertified rdf:type rdf:Property ;
    rdfs:label 'Hazmat Certified' ;
    rdfs:comment 'Indicates whether the warehouse facility is certified for storage of hazardous materials including transformer oil, sulfur hexafluoride (SF6), and other regulated substances. Certification required by Pipeline and Hazardous Materials Safety Administration (PHMSA) and Occupational Safety and Health Administration (OSHA).' ;
    rdfs:domain ind:Warehouse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:inventorySystemCode rdf:type rdf:Property ;
    rdfs:label 'Inventory System Code' ;
    rdfs:comment 'Code identifying the inventory management system or Warehouse Management System (WMS) used at this facility. Supports integration with Enterprise Resource Planning (ERP) systems (SAP S/4HANA or Oracle ERP Cloud) for procurement-to-pay processes.' ;
    rdfs:domain ind:Warehouse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastRenovationYear rdf:type rdf:Property ;
    rdfs:label 'Last Renovation Year' ;
    rdfs:comment 'Year of the most recent major renovation or upgrade to the warehouse facility. Used for asset condition assessment and capital planning.' ;
    rdfs:domain ind:Warehouse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:leaseExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Lease Expiry Date' ;
    rdfs:comment 'Expiration date of the lease agreement for leased warehouse facilities. Used for contract management and facility planning. Null for owned facilities.' ;
    rdfs:domain ind:Warehouse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:loadingDocks rdf:type rdf:Property ;
    rdfs:label 'Loading Docks' ;
    rdfs:comment 'Number of loading docks available at the warehouse facility for receiving and shipping materials. Used for logistics capacity planning and delivery scheduling.' ;
    rdfs:domain ind:Warehouse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:managerName rdf:type rdf:Property ;
    rdfs:label 'Manager Name' ;
    rdfs:comment 'Name of the individual responsible for day-to-day operations of the warehouse facility. Business reference, not direct Personally Identifiable Information (PII).' ;
    rdfs:domain ind:Warehouse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:palletPositions rdf:type rdf:Property ;
    rdfs:label 'Pallet Positions' ;
    rdfs:comment 'Number of standard pallet positions available in the warehouse facility. Used for inventory capacity planning and material staging for Capital Expenditure (CAPEX) projects and storm restoration.' ;
    rdfs:domain ind:Warehouse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:responsiblePlantCode rdf:type rdf:Property ;
    rdfs:label 'Responsible Plant Code' ;
    rdfs:comment 'Code identifying the organizational plant or operating unit responsible for managing the warehouse facility. Used for cost allocation and operational accountability in Enterprise Resource Planning (ERP) systems.' ;
    rdfs:domain ind:Warehouse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:securityLevel rdf:type rdf:Property ;
    rdfs:label 'Security Level' ;
    rdfs:comment 'Physical security classification of the warehouse facility. Standard facilities have basic access controls, enhanced facilities have additional monitoring and restricted access, and critical infrastructure facilities have maximum security measures required by North American Electric Reliability Corporation (NERC) Critical Infrastructure Protection (CIP) standards.' ;
    rdfs:domain ind:Warehouse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:storageCapacitySqft rdf:type rdf:Property ;
    rdfs:label 'Storage Capacity Sqft' ;
    rdfs:comment 'Total indoor storage capacity of the warehouse facility measured in square feet. Used for capacity planning and inventory allocation decisions.' ;
    rdfs:domain ind:Warehouse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stormStagingCapable rdf:type rdf:Property ;
    rdfs:label 'Storm Staging Capable' ;
    rdfs:comment 'Indicates whether the warehouse facility is designated and equipped for pre-positioning materials and equipment for storm restoration events. Critical for emergency response planning and System Average Interruption Duration Index (SAIDI) performance.' ;
    rdfs:domain ind:Warehouse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:twentyFourSevenAccess rdf:type rdf:Property ;
    rdfs:label 'Twenty Four Seven Access' ;
    rdfs:comment 'Indicates whether the warehouse facility provides 24-hour, 7-day-per-week access for emergency storm restoration and critical outage response. Essential for Outage Management System (OMS) integration and Demand Response (DR) program support.' ;
    rdfs:domain ind:Warehouse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:warehouseName rdf:type rdf:Property ;
    rdfs:label 'Warehouse Name' ;
    rdfs:comment 'Official name of the warehouse facility used for identification and reporting purposes.' ;
    rdfs:domain ind:Warehouse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:warehouseNumber rdf:type rdf:Property ;
    rdfs:label 'Warehouse Number' ;
    rdfs:comment 'Business identifier for the warehouse facility used in operational systems and documentation. Typically assigned by Enterprise Resource Planning (ERP) system (SAP S/4HANA or Oracle ERP Cloud) for procurement and inventory management.' ;
    rdfs:domain ind:Warehouse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:yardStorageAvailable rdf:type rdf:Property ;
    rdfs:label 'Yard Storage Available' ;
    rdfs:comment 'Indicates whether the warehouse facility has outdoor yard storage for large Transmission and Distribution (T&D) equipment such as transformers, poles, and cable reels.' ;
    rdfs:domain ind:Warehouse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:yardStorageCapacitySqft rdf:type rdf:Property ;
    rdfs:label 'Yard Storage Capacity Sqft' ;
    rdfs:comment 'Total outdoor yard storage capacity measured in square feet. Used for planning storage of large Transmission and Distribution (T&D) equipment and Capital Expenditure (CAPEX) project materials.' ;
    rdfs:domain ind:Warehouse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:congestionEventId rdf:type rdf:Property ;
    rdfs:label 'Congestion Event Id' ;
    rdfs:comment 'Unique identifier for the transmission congestion event record. Primary key for the congestion event entity.' ;
    rdfs:domain ind:CongestionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:constrainedElementId rdf:type rdf:Property ;
    rdfs:label 'Constrained Element Id' ;
    rdfs:comment 'Reference to the transmission asset (line, transformer, flowgate, or monitored element) that experienced the binding or near-binding constraint during this congestion event.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConstrainedElement .

ind:constrainedPricingNodeId rdf:type rdf:Property ;
    rdfs:label 'Constrained Pricing Node Id' ;
    rdfs:comment 'Foreign key linking to market.pricing_node. Business justification: Congestion events occur at specific pricing nodes where transmission constraints bind. Real-time market operations, LMP decomposition reporting, and congestion revenue rights settlement all require li' ;
    rdfs:domain ind:CongestionEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PricingNode .

ind:flowgateId rdf:type rdf:Property ;
    rdfs:label 'Flowgate Id' ;
    rdfs:comment 'The unique identifier for the flowgate (a monitored transmission interface or corridor) associated with this congestion event. Used for inter-RTO coordination and Available Flowgate Capability (AFC) calculations.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Flowgate .

ind:outageId rdf:type rdf:Property ;
    rdfs:label 'Outage Id' ;
    rdfs:comment 'Reference to the transmission outage record that caused or contributed to the congestion event. Null if the event was not outage-related.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Outage .

ind:besElementFlag rdf:type rdf:Property ;
    rdfs:label 'Bes Element Flag' ;
    rdfs:comment 'Indicates whether the constrained element is classified as part of the Bulk Electric System (true) under NERC definitions, which determines applicability of NERC reliability standards and FERC jurisdiction.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bindingConstraintFlag rdf:type rdf:Property ;
    rdfs:label 'Binding Constraint Flag' ;
    rdfs:comment 'Indicates whether the constraint was fully binding (true) or near-binding/monitoring (false) during the event. Binding constraints directly impact dispatch and pricing.' ;
    rdfs:domain ind:CongestionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:congestionCostUsd rdf:type rdf:Property ;
    rdfs:label 'Congestion Cost Usd' ;
    rdfs:comment 'Total economic cost of the congestion event in US dollars, calculated as the product of shadow price, curtailed MW, and duration. Used for transmission upgrade economic justification and FTR/ARR hedging analysis.' ;
    rdfs:domain ind:CongestionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:constraintName rdf:type rdf:Property ;
    rdfs:label 'Constraint Name' ;
    rdfs:comment 'The RTO/ISO-assigned name or identifier for the binding constraint as reported in the market systems (e.g., constraint ID from day-ahead or real-time market).' ;
    rdfs:domain ind:CongestionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:constraintType rdf:type rdf:Property ;
    rdfs:label 'Constraint Type' ;
    rdfs:comment 'Classification of the physical or economic constraint that caused the congestion event: thermal (line/transformer loading limit), voltage (voltage stability limit), stability (transient or dynamic stability limit), contractual (OATT or tariff-based limit), or other.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contingencyElementName rdf:type rdf:Property ;
    rdfs:label 'Contingency Element Name' ;
    rdfs:comment 'The name of the transmission element whose outage or failure would cause the monitored element to exceed its limit. Used for N-1 and N-2 contingency analysis and NERC TPL compliance.' ;
    rdfs:domain ind:CongestionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:curtailedMw rdf:type rdf:Property ;
    rdfs:label 'Curtailed Mw' ;
    rdfs:comment 'The amount of power flow in megawatts that was curtailed or limited due to the binding constraint. Represents the difference between desired and actual flow on the constrained element.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:durationHours rdf:type rdf:Property ;
    rdfs:label 'Duration Hours' ;
    rdfs:comment 'Total duration of the congestion event in hours, calculated as the difference between event start and end timestamps. Used for congestion cost allocation and transmission planning analysis.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:elementRatingMw rdf:type rdf:Property ;
    rdfs:label 'Element Rating Mw' ;
    rdfs:comment 'The thermal, voltage, or stability rating of the constrained element in megawatts, representing the maximum allowable power flow under the applicable operating conditions (normal, emergency, or contingency).' ;
    rdfs:domain ind:CongestionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:generationRedispatchMw rdf:type rdf:Property ;
    rdfs:label 'Generation Redispatch Mw' ;
    rdfs:comment 'The total amount of generation redispatch in megawatts that was required to relieve the congestion event. Represents the change in generation output across multiple units to reduce constraint loading.' ;
    rdfs:domain ind:CongestionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interconnectionName rdf:type rdf:Property ;
    rdfs:label 'Interconnection Name' ;
    rdfs:comment 'The North American electric interconnection in which the congestion event occurred: Eastern, Western, ERCOT (Texas), or Quebec. Interconnections operate as synchronous grids with limited DC ties between them.' ;
    rdfs:domain ind:CongestionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loadShedMw rdf:type rdf:Property ;
    rdfs:label 'Load Shed Mw' ;
    rdfs:comment 'The amount of customer load in megawatts that was curtailed or shed as a last-resort action to relieve the congestion event. Non-zero values indicate emergency operating conditions.' ;
    rdfs:domain ind:CongestionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:marketIntervalType rdf:type rdf:Property ;
    rdfs:label 'Market Interval Type' ;
    rdfs:comment 'The market timeframe in which the congestion event occurred: day_ahead (DAM), real_time (RTM), or intra_day (intermediate market run). Used for market settlement and congestion revenue rights allocation.' ;
    rdfs:domain ind:CongestionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:monitoredElementName rdf:type rdf:Property ;
    rdfs:label 'Monitored Element Name' ;
    rdfs:comment 'The name or designation of the specific transmission element (line, transformer, or interface) that was monitored and experienced the constraint. May differ from the constrained element if the constraint is a proxy or aggregate.' ;
    rdfs:domain ind:CongestionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outageRelatedFlag rdf:type rdf:Property ;
    rdfs:label 'Outage Related Flag' ;
    rdfs:comment 'Indicates whether the congestion event was caused by or related to a planned or forced outage of a transmission element (true) or occurred under normal system topology (false).' ;
    rdfs:domain ind:CongestionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:postContingencyFlowMw rdf:type rdf:Property ;
    rdfs:label 'Post Contingency Flow Mw' ;
    rdfs:comment 'The projected or actual power flow in megawatts on the monitored element following the contingency event. Used to determine constraint severity and required relief actions.' ;
    rdfs:domain ind:CongestionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preContingencyFlowMw rdf:type rdf:Property ;
    rdfs:label 'Pre Contingency Flow Mw' ;
    rdfs:comment 'The power flow in megawatts on the monitored element under normal (pre-contingency) operating conditions, before the contingency event that triggered the constraint.' ;
    rdfs:domain ind:CongestionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ratingType rdf:type rdf:Property ;
    rdfs:label 'Rating Type' ;
    rdfs:comment 'The type of facility rating that was exceeded or approached during the congestion event: normal (continuous rating), emergency (short-term rating for system disturbances), or contingency (post-contingency rating for N-1 or N-2 analysis).' ;
    rdfs:domain ind:CongestionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolutionAction rdf:type rdf:Property ;
    rdfs:label 'Resolution Action' ;
    rdfs:comment 'The operational action taken to resolve or mitigate the congestion event: redispatch (generation re-optimization), tlr (Transmission Loading Relief procedure), switching (network reconfiguration), load_shed (demand curtailment), topology_change (line/transformer switching), or none (constraint self-resolved).' ;
    rdfs:domain ind:CongestionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shadowPricePerMwh rdf:type rdf:Property ;
    rdfs:label 'Shadow Price Per Mwh' ;
    rdfs:comment 'The marginal cost of the transmission constraint in dollars per MWh, representing the economic value of relieving the constraint by one additional MWh. Also known as the congestion component of LMP.' ;
    rdfs:domain ind:CongestionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tlrLevel rdf:type rdf:Property ;
    rdfs:label 'Tlr Level' ;
    rdfs:comment 'The NERC Transmission Loading Relief procedure level invoked to manage the congestion event, ranging from TLR0 (monitoring) to TLR6 (emergency curtailment of firm transactions). Null if no TLR was required. [ENUM-REF-CANDIDATE: TLR0|TLR1|TLR2|TLR3|TLR4|TLR5|TLR6 — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contingencyScenarioId rdf:type rdf:Property ;
    rdfs:label 'Contingency Scenario Id' ;
    rdfs:comment 'Reference identifier for the contingency scenario (N-1, N-2, or N-k) that this topology represents, if applicable. Null for base case topologies. Links to the contingency analysis study that generated this scenario. Used in transmission planning and reliability studies per NERC TPL standards.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ContingencyScenario .

ind:controlAreaId rdf:type rdf:Property ;
    rdfs:label 'Control Area Id' ;
    rdfs:comment 'Identifier for the Balancing Authority (BA) or Control Area within which this topology model is operative. Aligns with NERC Balancing Authority Area definitions and is used for interchange scheduling, ACE calculations, and reliability coordination.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ControlArea .

ind:previousVersionGridTopologyId rdf:type rdf:Property ;
    rdfs:label 'Previous Version Grid Topology Id' ;
    rdfs:comment 'Self-referencing identifier pointing to the immediately preceding topology version that this record supersedes. Enables reconstruction of the topology version chain for historical analysis, model rollback, and change audit. Null for the initial topology version.' ;
    rdfs:domain ind:GridTopology ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GridTopology .

ind:branchCount rdf:type rdf:Property ;
    rdfs:label 'Branch Count' ;
    rdfs:comment 'Total number of branches (transmission lines, transformers, series capacitors/reactors) in this topology model. Together with bus_count, characterizes the size and complexity of the network model. Used for model validation and change tracking.' ;
    rdfs:domain ind:GridTopology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:busCount rdf:type rdf:Property ;
    rdfs:label 'Bus Count' ;
    rdfs:comment 'Total number of electrical buses (nodes) in this topology model. A bus represents an electrical connection point in the network. Used to characterize model size, validate model completeness, and track network growth over topology versions.' ;
    rdfs:domain ind:GridTopology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:changeDescription rdf:type rdf:Property ;
    rdfs:label 'Change Description' ;
    rdfs:comment 'Free-text narrative describing the specific change that caused this topology version to be created (e.g., \'Opened breaker 52-A at Substation XYZ for planned maintenance on 138kV line L-101\'). Provides operational context for model change audits and post-event analysis.' ;
    rdfs:domain ind:GridTopology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contingencyType rdf:type rdf:Property ;
    rdfs:label 'Contingency Type' ;
    rdfs:comment 'Classification of the contingency level this topology models. \'N-0\' = normal (base case); \'N-1\' = single element outage; \'N-2\' = double element outage; \'N-k\' = multiple element outage; \'extreme_event\' = beyond design basis event per NERC TPL-007. Null for base case records.' ;
    rdfs:domain ind:GridTopology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emsModelReference rdf:type rdf:Property ;
    rdfs:label 'Ems Model Reference' ;
    rdfs:comment 'The native model identifier assigned by the ABB or GE Energy Management System to this topology configuration. Used for cross-referencing between the Silver layer data product and the operational EMS/SCADA platform for model reconciliation and audit.' ;
    rdfs:domain ind:GridTopology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emsModelSyncStatus rdf:type rdf:Property ;
    rdfs:label 'Ems Model Sync Status' ;
    rdfs:comment 'Indicates whether this topology version is synchronized with the real-time EMS/SCADA network model (ABB or GE EMS). \'synchronized\' = topology matches current EMS model; \'out_of_sync\' = discrepancy detected; \'pending_sync\' = synchronization in progress; \'sync_failed\' = synchronization attempt failed. Critical for ensuring real-time grid operations use the correct model.' ;
    rdfs:domain ind:GridTopology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:generatorCount rdf:type rdf:Property ;
    rdfs:label 'Generator Count' ;
    rdfs:comment 'Total number of generating units (including conventional, nuclear, and renewable) represented in this topology model. Used to validate model completeness against the known generation fleet and to support capacity adequacy assessments.' ;
    rdfs:domain ind:GridTopology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isBaseCase rdf:type rdf:Property ;
    rdfs:label 'Is Base Case' ;
    rdfs:comment 'Indicates whether this topology version represents the base case (pre-contingency, normal operating configuration) of the network model. True = base case; False = contingency or modified scenario. Base cases are the reference point for N-1 and N-k contingency analysis.' ;
    rdfs:domain ind:GridTopology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCipApplicable rdf:type rdf:Property ;
    rdfs:label 'Is Cip Applicable' ;
    rdfs:comment 'Indicates whether this topology model includes Critical Infrastructure Protection (CIP) applicable assets (High or Medium impact BES Cyber Systems). True = CIP standards apply; False = no CIP-applicable assets in scope. Drives cybersecurity and access control requirements for model handling.' ;
    rdfs:domain ind:GridTopology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isNercBes rdf:type rdf:Property ;
    rdfs:label 'Is Nerc Bes' ;
    rdfs:comment 'Indicates whether the elements represented in this topology model are classified as part of the NERC Bulk Electric System (BES). True = BES-applicable elements subject to NERC reliability standards and FERC jurisdiction; False = non-BES distribution elements. Drives NERC CIP compliance applicability.' ;
    rdfs:domain ind:GridTopology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:loadCount rdf:type rdf:Property ;
    rdfs:label 'Load Count' ;
    rdfs:comment 'Total number of load buses or load injection points represented in this topology model. Used for model validation and to ensure all significant load centers are represented in power flow and contingency studies.' ;
    rdfs:domain ind:GridTopology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:modelChangeReason rdf:type rdf:Property ;
    rdfs:label 'Model Change Reason' ;
    rdfs:comment 'Business reason that triggered the creation of this new topology version. Captures the operational event or administrative action that altered the electrical connectivity of the BES. [ENUM-REF-CANDIDATE: switching_operation|new_construction|seasonal_reconfiguration|maintenance_outage|emergency_reconfiguration|model_correction|interconnection_addition — promote to reference product]' ;
    rdfs:domain ind:GridTopology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelType rdf:type rdf:Property ;
    rdfs:label 'Model Type' ;
    rdfs:comment 'Specifies the electrical network representation paradigm used in this topology model. \'bus_branch\' is the simplified model used for power flow studies (PSS/E, PSLF); \'node_breaker\' is the detailed model used in real-time EMS/SCADA state estimation reflecting individual breaker and switch positions.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelVersionNotes rdf:type rdf:Property ;
    rdfs:label 'Model Version Notes' ;
    rdfs:comment 'Free-text field for additional notes, caveats, or known limitations associated with this topology version (e.g., \'Pending interconnection queue additions not yet reflected\', \'Temporary configuration during substation expansion\'). Supports model management and peer review processes.' ;
    rdfs:domain ind:GridTopology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nercReliabilityRegion rdf:type rdf:Property ;
    rdfs:label 'Nerc Reliability Region' ;
    rdfs:comment 'The NERC Regional Entity (RE) jurisdiction applicable to this topology model. Determines which regional reliability standards and compliance obligations apply to the BES elements represented in this topology.' ;
    rdfs:domain ind:GridTopology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:networkIslandCode rdf:type rdf:Property ;
    rdfs:label 'Network Island Code' ;
    rdfs:comment 'Identifier for the electrically isolated network island (synchronous zone) to which this topology belongs. A network island is a set of buses electrically connected and operating synchronously. Multiple islands may exist during islanding events or planned separations. Sourced from EMS state estimator island detection.' ;
    rdfs:domain ind:GridTopology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:powerFlowSolutionStatus rdf:type rdf:Property ;
    rdfs:label 'Power Flow Solution Status' ;
    rdfs:comment 'Result status of the power flow (load flow) solution for this topology model. \'converged\' indicates a valid AC power flow solution was obtained; \'diverged\' indicates the power flow failed to converge; \'not_run\' indicates no power flow was executed; \'infeasible\' indicates no feasible solution exists under the modeled conditions. Distinct from state_estimator_status which applies to real-time EMS.' ;
    rdfs:domain ind:GridTopology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seasonalPeriod rdf:type rdf:Property ;
    rdfs:label 'Seasonal Period' ;
    rdfs:comment 'The seasonal operating period this topology model represents. Seasonal configurations may differ due to line ratings, transformer tap positions, and generation dispatch patterns. Used for seasonal transmission planning studies and NERC TPL compliance assessments.' ;
    rdfs:domain ind:GridTopology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:snapshotTimestamp rdf:type rdf:Property ;
    rdfs:label 'Snapshot Timestamp' ;
    rdfs:comment 'The precise real-world date and time at which this topology snapshot was captured from the EMS/SCADA system (ABB or GE EMS). Represents the actual grid state at that moment, distinct from the effective validity window. Critical for real-time state estimation and post-event analysis.' ;
    rdfs:domain ind:GridTopology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:stateEstimatorStatus rdf:type rdf:Property ;
    rdfs:label 'State Estimator Status' ;
    rdfs:comment 'Result status of the EMS state estimator solution for this topology snapshot. \'converged\' indicates a valid, solved network state; \'diverged\' indicates the state estimator failed to find a solution (unreliable topology); \'not_run\' indicates state estimation was not executed; \'flat_start\' indicates initialization from flat voltage profile; \'initializing\' indicates solution in progress.' ;
    rdfs:domain ind:GridTopology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:studyModelFileReference rdf:type rdf:Property ;
    rdfs:label 'Study Model File Reference' ;
    rdfs:comment 'File path or object storage reference to the PSS/E (.raw/.sav) or PSLF (.epc) study model file corresponding to this topology version. Enables traceability between the data product record and the physical power flow model file used in transmission planning studies.' ;
    rdfs:domain ind:GridTopology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:studyYear rdf:type rdf:Property ;
    rdfs:label 'Study Year' ;
    rdfs:comment 'The planning horizon year this topology model represents (e.g., 2024, 2025, 2030). For future-year planning models, this may differ from the snapshot_timestamp year. Used to organize transmission planning study portfolios and IRP model sets.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:topologyName rdf:type rdf:Property ;
    rdfs:label 'Topology Name' ;
    rdfs:comment 'Human-readable descriptive name for this topology version (e.g., \'Summer Peak Base Case 2024\', \'Post-Switching N-1 Contingency Model\'). Used for identification in power flow studies and EMS model management.' ;
    rdfs:domain ind:GridTopology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:topologyStatus rdf:type rdf:Property ;
    rdfs:label 'Topology Status' ;
    rdfs:comment 'Current lifecycle state of this topology version. \'active\' indicates the current operative model; \'archived\' indicates a historical snapshot retained for audit; \'draft\' indicates a model under construction; \'superseded\' indicates replaced by a newer version; \'under_review\' indicates pending validation.' ;
    rdfs:domain ind:GridTopology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:topologyVersionNumber rdf:type rdf:Property ;
    rdfs:label 'Topology Version Number' ;
    rdfs:comment 'Externally-known version identifier for this topology snapshot (e.g., \'BES-2024-001\', \'BASECASE-Q3-2024\'). Used by EMS/SCADA, PSS/E, and PSLF study models to reference a specific network configuration. Serves as the business-facing identifier for this topology record.' ;
    rdfs:domain ind:GridTopology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalInstalledCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Total Installed Capacity Mw' ;
    rdfs:comment 'Aggregate installed generation capacity in megawatts (MW) represented in this topology model. Represents the principal quantitative measure of the generation resources modeled. Used for capacity adequacy analysis, IRP studies, and FERC Form 715 reporting.' ;
    rdfs:domain ind:GridTopology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalLineLengthMiles rdf:type rdf:Property ;
    rdfs:label 'Total Line Length Miles' ;
    rdfs:comment 'Aggregate circuit miles of transmission lines represented in this topology model. Used for asset inventory reconciliation, rate base calculations, and FERC Form 1 reporting. Expressed in miles per U.S. utility convention.' ;
    rdfs:domain ind:GridTopology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interchangeScheduleId rdf:type rdf:Property ;
    rdfs:label 'Interchange Schedule Id' ;
    rdfs:comment 'Unique surrogate identifier for each interchange schedule record in the Databricks Silver Layer. Primary key for this entity. Entity role: TRANSACTION_HEADER — represents a discrete scheduled energy interchange event with a full lifecycle (draft/confirmed/curtailed/settled).' ;
    rdfs:domain ind:InterchangeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:counterpartyBaId rdf:type rdf:Property ;
    rdfs:label 'Counterparty Ba Id' ;
    rdfs:comment 'Reference to the counterparty balancing authority entity involved in this interchange schedule. Represents the neighboring BA or RTO/ISO with which energy is being exchanged. Satisfies TRANSACTION_HEADER PARTY_REFERENCE category.' ;
    rdfs:domain ind:InterchangeSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BalancingAuthority .

ind:actualMw rdf:type rdf:Property ;
    rdfs:label 'Actual Mw' ;
    rdfs:comment 'The actual metered interchange amount in MW for this interval, as recorded by the EMS/SCADA historian (OSIsoft PI or GE Proficy). Compared against scheduled_mw to compute inadvertent interchange for NERC BAL-006 compliance reporting.' ;
    rdfs:domain ind:InterchangeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:checkoutStatus rdf:type rdf:Property ;
    rdfs:label 'Checkout Status' ;
    rdfs:comment 'Current approval/checkout status of the interchange schedule as returned by the counterparty BA or RTO/ISO scheduling portal: confirmed (approved by all parties), denied (rejected), or pending (awaiting confirmation). Satisfies TRANSACTION_HEADER LIFECYCLE_STATUS category.' ;
    rdfs:domain ind:InterchangeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:curtailmentFlag rdf:type rdf:Property ;
    rdfs:label 'Curtailment Flag' ;
    rdfs:comment 'Indicates whether this interchange schedule has been curtailed (True) or is operating at full scheduled capacity (False). Curtailment may be initiated by the transmission provider, RTO/ISO, or counterparty BA due to congestion, reliability events, or emergency conditions.' ;
    rdfs:domain ind:InterchangeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:curtailmentPriority rdf:type rdf:Property ;
    rdfs:label 'Curtailment Priority' ;
    rdfs:comment 'Numeric priority ranking assigned to this interchange schedule for curtailment sequencing. Lower numbers indicate higher priority (curtailed last). Determined by the transmission service agreement and OATT curtailment provisions. Used by EMS during congestion management.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:energyMwh rdf:type rdf:Property ;
    rdfs:label 'Energy Mwh' ;
    rdfs:comment 'The scheduled energy quantity in megawatt-hours (MWh) for this interval, derived from scheduled_mw and interval_duration_min. Stored as a business field for direct use in settlement calculations and FERC EQR energy quantity reporting without requiring runtime computation.' ;
    rdfs:domain ind:InterchangeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:etagReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Etag Reference Number' ;
    rdfs:comment 'The e-Tag reference number assigned by the NERC e-Tag system (OATI webTrans) for this interchange transaction. Used to track the energy transaction across all involved balancing authorities, transmission providers, and generation/load entities. Required for NERC INT compliance.' ;
    rdfs:domain ind:InterchangeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fercEqrReportable rdf:type rdf:Property ;
    rdfs:label 'Ferc Eqr Reportable' ;
    rdfs:comment 'Indicates whether this interchange schedule must be reported in the FERC Electric Quarterly Report (EQR) (True) or is exempt (False). Bilateral transactions above FERC threshold quantities are reportable. Drives automated EQR filing population.' ;
    rdfs:domain ind:InterchangeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:inadvertentMw rdf:type rdf:Property ;
    rdfs:label 'Inadvertent Mw' ;
    rdfs:comment 'The difference between actual_mw and scheduled_mw for this interval, representing inadvertent interchange. Positive values indicate over-delivery; negative values indicate under-delivery. Directly used in NERC BAL-006 (Inadvertent Interchange) compliance calculations and regulatory reporting.' ;
    rdfs:domain ind:InterchangeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:intervalDurationMin rdf:type rdf:Property ;
    rdfs:label 'Interval Duration Min' ;
    rdfs:comment 'Duration of the scheduled interchange interval in minutes (e.g., 60 for hourly, 15 for sub-hourly quarter-hour intervals, 5 for five-minute real-time intervals). Determines the granularity of the schedule and aligns with RTO/ISO market interval definitions.' ;
    rdfs:domain ind:InterchangeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:intervalEndDatetime rdf:type rdf:Property ;
    rdfs:label 'Interval End Datetime' ;
    rdfs:comment 'The end datetime of the scheduled interchange interval. Combined with interval_start_datetime defines the precise scheduling window for this energy transfer. Required for NERC INT compliance and inadvertent interchange accounting.' ;
    rdfs:domain ind:InterchangeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:intervalStartDatetime rdf:type rdf:Property ;
    rdfs:label 'Interval Start Datetime' ;
    rdfs:comment 'The start datetime of the scheduled interchange interval (hourly or sub-hourly). Represents the principal real-world business event time for this schedule. Stored in ISO 8601 format with timezone offset. Satisfies TRANSACTION_HEADER BUSINESS_EVENT_TIMESTAMP category.' ;
    rdfs:domain ind:InterchangeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:isDynamicTransfer rdf:type rdf:Property ;
    rdfs:label 'Is Dynamic Transfer' ;
    rdfs:comment 'Indicates whether this interchange schedule involves a dynamic transfer (True), where generation control is transferred in real time between BAs, as opposed to a static scheduled interchange (False). Dynamic transfers require special EMS coordination and NERC INT-004 dynamic schedule provisions.' ;
    rdfs:domain ind:InterchangeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nercBal006Reportable rdf:type rdf:Property ;
    rdfs:label 'Nerc Bal006 Reportable' ;
    rdfs:comment 'Indicates whether this interchange schedule contributes to the utility\'s NERC BAL-006 (Inadvertent Interchange) compliance reporting obligation (True) or is excluded (e.g., dynamic transfers handled separately). Drives automated inclusion in regulatory compliance extracts.' ;
    rdfs:domain ind:InterchangeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nercEtagNumber rdf:type rdf:Property ;
    rdfs:label 'Nerc Etag Number' ;
    rdfs:comment 'The unique NERC-assigned e-Tag identifier for this interchange transaction, distinct from the internal reference number. Serves as the authoritative cross-BA identifier for the scheduled energy transfer and is required for NERC INT-004 and FERC EQR reporting.' ;
    rdfs:domain ind:InterchangeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleConfirmedDatetime rdf:type rdf:Property ;
    rdfs:label 'Schedule Confirmed Datetime' ;
    rdfs:comment 'The datetime when the interchange schedule received confirmed checkout status from all required parties (counterparty BA, transmission provider, RTO/ISO). Null if checkout_status is pending or denied. Used for NERC INT-006 compliance timing analysis.' ;
    rdfs:domain ind:InterchangeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:scheduleNumber rdf:type rdf:Property ;
    rdfs:label 'Schedule Number' ;
    rdfs:comment 'Externally-known alphanumeric identifier for this interchange schedule, as assigned by the EMS or RTO/ISO scheduling portal (e.g., ABB/GE EMS schedule reference). Used for cross-system reconciliation and NERC e-Tag correlation. Satisfies TRANSACTION_HEADER BUSINESS_IDENTIFIER category.' ;
    rdfs:domain ind:InterchangeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleSubmittedDatetime rdf:type rdf:Property ;
    rdfs:label 'Schedule Submitted Datetime' ;
    rdfs:comment 'The datetime when this interchange schedule was submitted to the RTO/ISO scheduling portal or counterparty BA via OATI webTrans or EMS. Used for deadline compliance tracking under NERC INT-004 (schedule submission timing requirements).' ;
    rdfs:domain ind:InterchangeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:schedulingEntityCode rdf:type rdf:Property ;
    rdfs:label 'Scheduling Entity Code' ;
    rdfs:comment 'The NERC-registered code of the entity responsible for submitting this interchange schedule (typically the utility\'s transmission scheduling desk or a third-party scheduling coordinator). Required for NERC INT-009 compliance and e-Tag accountability.' ;
    rdfs:domain ind:InterchangeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sinkBaCode rdf:type rdf:Property ;
    rdfs:label 'Sink Ba Code' ;
    rdfs:comment 'NERC-assigned code for the balancing authority area where the energy is delivered (sink BA). For import schedules, this is the utility\'s own BA code. For export schedules, this is the counterparty BA code. Required field in NERC e-Tag and INT standard reporting.' ;
    rdfs:domain ind:InterchangeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceBaCode rdf:type rdf:Property ;
    rdfs:label 'Source Ba Code' ;
    rdfs:comment 'NERC-assigned code for the balancing authority area where the energy originates (source BA). For export schedules, this is the utility\'s own BA code. For import schedules, this is the counterparty BA code. Required field in NERC e-Tag and INT standard reporting.' ;
    rdfs:domain ind:InterchangeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transmissionPath rdf:type rdf:Property ;
    rdfs:label 'Transmission Path' ;
    rdfs:comment 'The designated transmission path or flowgate identifier over which this interchange is scheduled (e.g., \'PJM-MISO Interface\', \'Seams path designation\'). Used for transmission capacity reservation tracking and OATT compliance. May reference an ATC/TTC path.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:poiBusId rdf:type rdf:Property ;
    rdfs:label 'Poi Bus Id' ;
    rdfs:comment 'Foreign key linking to transmission.bus. Business justification: Interconnection requests specify a point of interconnection (POI), which is a specific bus in the transmission system. This FK links the request to the actual bus. Removes poi_voltage_kv as redundant ' ;
    rdfs:domain ind:InterconnectionRequest ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Bus .

ind:actualCod rdf:type rdf:Property ;
    rdfs:label 'Actual Cod' ;
    rdfs:comment 'Actual date when the project achieved commercial operation. Populated only after the project is energized and operational.' ;
    rdfs:domain ind:InterconnectionRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:applicantContactEmail rdf:type rdf:Property ;
    rdfs:label 'Applicant Contact Email' ;
    rdfs:comment 'Primary email address for the applicant or their authorized representative for interconnection request communications.' ;
    rdfs:domain ind:InterconnectionRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicantContactPhone rdf:type rdf:Property ;
    rdfs:label 'Applicant Contact Phone' ;
    rdfs:comment 'Primary telephone number for the applicant or their authorized representative.' ;
    rdfs:domain ind:InterconnectionRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicantName rdf:type rdf:Property ;
    rdfs:label 'Applicant Name' ;
    rdfs:comment 'Legal name of the entity or individual submitting the interconnection request. May be a generation developer, industrial customer, or distributed energy resource owner.' ;
    rdfs:domain ind:InterconnectionRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:environmentalPermitStatus rdf:type rdf:Property ;
    rdfs:label 'Environmental Permit Status' ;
    rdfs:comment 'Status of required environmental permits (e.g., EPA air quality permits, state environmental permits, wetlands permits) for the generation project.' ;
    rdfs:domain ind:InterconnectionRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedInterconnectionFacilityCost rdf:type rdf:Property ;
    rdfs:label 'Estimated Interconnection Facility Cost' ;
    rdfs:comment 'Estimated cost in USD for the direct interconnection facilities (e.g., generator lead line, metering equipment, protective relays) required to connect the project to the point of interconnection.' ;
    rdfs:domain ind:InterconnectionRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedNetworkUpgradeCost rdf:type rdf:Property ;
    rdfs:label 'Estimated Network Upgrade Cost' ;
    rdfs:comment 'Estimated total cost in USD for transmission network upgrades required to accommodate the interconnection. Includes substation modifications, line upgrades, and protection system enhancements. Based on facilities study results.' ;
    rdfs:domain ind:InterconnectionRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:facilitiesStudyCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Facilities Study Completion Date' ;
    rdfs:comment 'Date when the facilities study was completed and results delivered to the applicant.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:facilitiesStudyStartDate rdf:type rdf:Property ;
    rdfs:label 'Facilities Study Start Date' ;
    rdfs:comment 'Date when the facilities study phase commenced. Facilities study provides detailed engineering design and final cost estimates for required upgrades.' ;
    rdfs:domain ind:InterconnectionRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:feasibilityStudyCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Feasibility Study Completion Date' ;
    rdfs:comment 'Date when the feasibility study was completed and results delivered to the applicant.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:feasibilityStudyStartDate rdf:type rdf:Property ;
    rdfs:label 'Feasibility Study Start Date' ;
    rdfs:comment 'Date when the feasibility study phase commenced. Feasibility study evaluates high-level technical viability and preliminary cost estimates.' ;
    rdfs:domain ind:InterconnectionRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:interconnectionAgreementExecutedDate rdf:type rdf:Property ;
    rdfs:label 'Interconnection Agreement Executed Date' ;
    rdfs:comment 'Date when the formal interconnection agreement (IA) or generator interconnection agreement (GIA) was executed between the applicant and the transmission provider.' ;
    rdfs:domain ind:InterconnectionRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isEnergyOnly rdf:type rdf:Property ;
    rdfs:label 'Is Energy Only' ;
    rdfs:comment 'Boolean flag indicating whether the applicant requested Energy Resource Interconnection Service (ERIS), which allows energy-only delivery without firm capacity rights.' ;
    rdfs:domain ind:InterconnectionRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isNetworkResource rdf:type rdf:Property ;
    rdfs:label 'Is Network Resource' ;
    rdfs:comment 'Boolean flag indicating whether the applicant requested Network Resource Interconnection Service (NRIS), which allows the generator to be designated as a network resource for capacity and energy delivery.' ;
    rdfs:domain ind:InterconnectionRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:poiLatitude rdf:type rdf:Property ;
    rdfs:label 'Poi Latitude' ;
    rdfs:comment 'Geographic latitude coordinate of the proposed point of interconnection in decimal degrees. Used for GIS mapping and transmission planning analysis.' ;
    rdfs:domain ind:InterconnectionRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:poiLongitude rdf:type rdf:Property ;
    rdfs:label 'Poi Longitude' ;
    rdfs:comment 'Geographic longitude coordinate of the proposed point of interconnection in decimal degrees. Used for GIS mapping and transmission planning analysis.' ;
    rdfs:domain ind:InterconnectionRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:queuePosition rdf:type rdf:Property ;
    rdfs:label 'Queue Position' ;
    rdfs:comment 'Numeric position of this request in the interconnection queue, determining study and construction priority. Lower numbers indicate earlier queue entry.' ;
    rdfs:domain ind:InterconnectionRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:requestNumber rdf:type rdf:Property ;
    rdfs:label 'Request Number' ;
    rdfs:comment 'Externally-known business identifier for the interconnection request, typically assigned by the transmission provider or RTO/ISO. Used in regulatory filings and customer communications.' ;
    rdfs:domain ind:InterconnectionRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestStatus rdf:type rdf:Property ;
    rdfs:label 'Request Status' ;
    rdfs:comment 'Current lifecycle status of the interconnection request in the queue management process. Tracks progression through FERC-mandated study phases. [ENUM-REF-CANDIDATE: submitted|under_review|feasibility_study|system_impact_study|facilities_study|approved|withdrawn|suspended|rejected|completed — 10 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestedCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Requested Capacity Mw' ;
    rdfs:comment 'Total generating or load capacity in megawatts (MW) requested for interconnection. Determines study scope and network upgrade requirements.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:requiresNercRegistration rdf:type rdf:Property ;
    rdfs:label 'Requires Nerc Registration' ;
    rdfs:comment 'Boolean flag indicating whether the project will require NERC registration as a Generator Owner (GO) or Generator Operator (GOP) based on capacity and voltage thresholds.' ;
    rdfs:domain ind:InterconnectionRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:studyPhase rdf:type rdf:Property ;
    rdfs:label 'Study Phase' ;
    rdfs:comment 'Current phase of the FERC-mandated interconnection study process. Progresses from feasibility study through system impact study to facilities study.' ;
    rdfs:domain ind:InterconnectionRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:systemImpactStudyCompletionDate rdf:type rdf:Property ;
    rdfs:label 'System Impact Study Completion Date' ;
    rdfs:comment 'Date when the system impact study was completed and results delivered to the applicant.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:systemImpactStudyStartDate rdf:type rdf:Property ;
    rdfs:label 'System Impact Study Start Date' ;
    rdfs:comment 'Date when the system impact study phase commenced. System impact study analyzes detailed grid impacts and required network upgrades.' ;
    rdfs:domain ind:InterconnectionRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:targetCod rdf:type rdf:Property ;
    rdfs:label 'Target Cod' ;
    rdfs:comment 'Applicant\'s proposed date for the project to achieve commercial operation and begin delivering energy or capacity to the grid. Critical for transmission planning and resource adequacy forecasting.' ;
    rdfs:domain ind:InterconnectionRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:transmissionOwnerName rdf:type rdf:Property ;
    rdfs:label 'Transmission Owner Name' ;
    rdfs:comment 'Legal name of the transmission owner responsible for the facilities at the point of interconnection. May differ from the RTO/ISO in organized markets.' ;
    rdfs:domain ind:InterconnectionRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:withdrawalDate rdf:type rdf:Property ;
    rdfs:label 'Withdrawal Date' ;
    rdfs:comment 'Date when the applicant formally withdrew the interconnection request from the queue. Populated only if request_status is withdrawn.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:withdrawalReason rdf:type rdf:Property ;
    rdfs:label 'Withdrawal Reason' ;
    rdfs:comment 'Business reason provided by the applicant for withdrawing the interconnection request (e.g., project financing failed, site permitting issues, cost prohibitive).' ;
    rdfs:domain ind:InterconnectionRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lineId rdf:type rdf:Property ;
    rdfs:label 'Line Id' ;
    rdfs:comment 'Primary key for line' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fromBusId rdf:type rdf:Property ;
    rdfs:label 'From Bus Id' ;
    rdfs:comment 'Foreign key linking to transmission.bus. Business justification: Transmission lines connect two buses (electrical connection points). The from_bus_id FK establishes the origin bus. This is a critical topological relationship for power flow modeling and grid analysi' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Bus .

ind:toTransmissionSubstationId rdf:type rdf:Property ;
    rdfs:label 'To Transmission Substation Id' ;
    rdfs:comment 'FK to transmission.transmission_substation' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TransmissionSubstation .

ind:availableTransferCapabilityMw rdf:type rdf:Property ;
    rdfs:label 'Available Transfer Capability Mw' ;
    rdfs:comment 'Available Transfer Capability of the transmission line in Megawatts (MW), representing the remaining transfer capacity available for additional transactions after accounting for existing commitments and reliability margins. Published on OASIS per FERC OATT requirements.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:besClassified rdf:type rdf:Property ;
    rdfs:label 'Bes Classified' ;
    rdfs:comment 'Indicates whether this transmission line is classified as part of the NERC Bulk Electric System (BES). BES-classified lines are subject to NERC Reliability Standards (CIP, FAC, TPL, etc.) and FERC jurisdiction. True = BES; False = non-BES (sub-transmission or distribution).' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coOwnerName rdf:type rdf:Property ;
    rdfs:label 'Co Owner Name' ;
    rdfs:comment 'Name of the joint owner(s) of the transmission line when ownership_percentage is less than 100%. Relevant for joint-use agreements, cost-sharing arrangements, and FERC Form 1 disclosure of jointly-owned plant.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissioningCostUsd rdf:type rdf:Property ;
    rdfs:label 'Commissioning Cost Usd' ;
    rdfs:comment 'Total capital cost incurred to construct and commission the transmission line, expressed in US dollars. Represents the gross plant-in-service value for FERC rate base inclusion, depreciation base, and CAPEX tracking. Classified confidential as it contains sensitive financial data.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:emergencyRatingMva rdf:type rdf:Property ;
    rdfs:label 'Emergency Rating Mva' ;
    rdfs:comment 'Short-term emergency thermal rating of the transmission line in Megavolt-Amperes (MVA). Represents the maximum allowable power flow for a limited duration (typically 15–30 minutes) during contingency conditions. Used in N-1 and N-2 contingency analysis.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:emsElementReference rdf:type rdf:Property ;
    rdfs:label 'Ems Element Reference' ;
    rdfs:comment 'Identifier for this transmission line element within the ABB or GE Energy Management System (EMS) / SCADA platform. Used for real-time monitoring, state estimation, and contingency analysis in the EMS network model.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fercJurisdictional rdf:type rdf:Property ;
    rdfs:label 'Ferc Jurisdictional' ;
    rdfs:comment 'Indicates whether this transmission line is subject to FERC jurisdiction under the Federal Power Act. FERC-jurisdictional lines must comply with OATT requirements, transmission pricing rules, and FERC Form 1 reporting obligations.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gisFeatureReference rdf:type rdf:Property ;
    rdfs:label 'Gis Feature Reference' ;
    rdfs:comment 'Reference identifier for the transmission line feature in the ESRI ArcGIS geospatial network model. Enables spatial joins, route tracing, and GIS-based outage analysis.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insulationType rdf:type rdf:Property ;
    rdfs:label 'Insulation Type' ;
    rdfs:comment 'Type of insulation used on the transmission line conductors or cable. For overhead lines: ceramic, glass, or polymer insulators. For underground/submarine cables: XLPE or oil-paper. Affects dielectric performance, maintenance intervals, and failure mode analysis.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interconnectionType rdf:type rdf:Property ;
    rdfs:label 'Interconnection Type' ;
    rdfs:comment 'Classification of the transmission line based on the entities it interconnects. Intra-utility lines connect points within the same utility system; inter-utility lines connect different utilities; interstate lines cross state boundaries; international lines cross national borders.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lineCode rdf:type rdf:Property ;
    rdfs:label 'Line Code' ;
    rdfs:comment 'Externally-known alphanumeric code or tag uniquely identifying the transmission line across operational systems (GIS, EMS, SCADA, WAM). Serves as the business key for cross-system integration.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lineName rdf:type rdf:Property ;
    rdfs:label 'Line Name' ;
    rdfs:comment 'Human-readable name or designation assigned to the transmission line (e.g., \'Northgate–Riverside 345kV\'). Used in operational communications, SCADA displays, and regulatory filings.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lineType rdf:type rdf:Property ;
    rdfs:label 'Line Type' ;
    rdfs:comment 'Physical construction type of the transmission line. Overhead lines use towers/poles with air insulation; underground lines use buried cable; submarine lines cross bodies of water. Affects maintenance practices, outage risk, and capital cost classification.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:multiStateFlag rdf:type rdf:Property ;
    rdfs:label 'Multi State Flag' ;
    rdfs:comment 'Indicates whether the transmission line crosses state boundaries. Multi-state lines may be subject to multiple PUC jurisdictions and require coordinated regulatory reporting. True = crosses state lines; False = single-state.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:numberOfStructures rdf:type rdf:Property ;
    rdfs:label 'Number Of Structures' ;
    rdfs:comment 'Total count of towers, poles, or support structures along the transmission line route. Used for asset inventory, maintenance planning, and storm restoration resource estimation.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:operatingStatus rdf:type rdf:Property ;
    rdfs:label 'Operating Status' ;
    rdfs:comment 'Current operational lifecycle status of the transmission line. Drives inclusion in power flow models, maintenance scheduling, NERC compliance scope, and FERC rate base eligibility. [ENUM-REF-CANDIDATE: in_service|out_of_service|mothballed|retired|under_construction|planned — promote to reference product]' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reactanceOhmsPerMile rdf:type rdf:Property ;
    rdfs:label 'Reactance Ohms Per Mile' ;
    rdfs:comment 'Positive-sequence inductive reactance of the conductor in ohms per mile. Essential parameter for power flow, stability, and short-circuit analysis in the transmission network model.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:resistanceOhmsPerMile rdf:type rdf:Property ;
    rdfs:label 'Resistance Ohms Per Mile' ;
    rdfs:comment 'Positive-sequence AC resistance of the conductor in ohms per mile at operating temperature. Core electrical parameter used in power flow models, load flow studies, and loss calculations.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rightOfWayWidthFt rdf:type rdf:Property ;
    rdfs:label 'Right Of Way Width Ft' ;
    rdfs:comment 'Width of the transmission line right-of-way corridor in feet. Used for vegetation management compliance (NERC FAC-003), land use planning, encroachment management, and environmental permitting.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scadaMonitored rdf:type rdf:Property ;
    rdfs:label 'Scada Monitored' ;
    rdfs:comment 'Indicates whether this transmission line is monitored and controllable via the SCADA/EMS system. SCADA-monitored lines provide real-time telemetry (MW flow, MVAr, voltage, breaker status) to the Energy Management System for grid operations.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:structureType rdf:type rdf:Property ;
    rdfs:label 'Structure Type' ;
    rdfs:comment 'Type of tower or pole structure supporting the overhead transmission line. Affects structural loading calculations, maintenance practices, and asset replacement planning.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalTransferCapabilityMw rdf:type rdf:Property ;
    rdfs:label 'Total Transfer Capability Mw' ;
    rdfs:comment 'Total Transfer Capability of the transmission line in Megawatts (MW), representing the maximum amount of electric power that can be transferred reliably over the line under specified system conditions. Basis for ATC calculations published on OASIS.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:voltageClassKv rdf:type rdf:Property ;
    rdfs:label 'Voltage Class Kv' ;
    rdfs:comment 'Nominal operating voltage class of the transmission line expressed in kilovolts (kV). Common BES voltage classes include 69 kV, 115 kV, 138 kV, 230 kV, 345 kV, 500 kV, and 765 kV. Determines NERC BES applicability threshold (≥100 kV) and FERC jurisdictional classification.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wamAssetReference rdf:type rdf:Property ;
    rdfs:label 'Wam Asset Reference' ;
    rdfs:comment 'Asset identifier assigned by the Enterprise Asset Management system (Oracle WAM or IBM Maximo) for maintenance scheduling, work order management, and asset lifecycle tracking.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:yearConstructed rdf:type rdf:Property ;
    rdfs:label 'Year Constructed' ;
    rdfs:comment 'Calendar year in which the transmission line was originally constructed. Distinct from in_service_date; used for asset age analysis, infrastructure investment planning, and IRP long-range capital forecasting.' ;
    rdfs:domain ind:Line ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:nercCipAssetId rdf:type rdf:Property ;
    rdfs:label 'Nerc Cip Asset Id' ;
    rdfs:comment 'Unique identifier for the NERC CIP regulated BES cyber system asset record.' ;
    rdfs:domain ind:NercCipAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:controlCenterId rdf:type rdf:Property ;
    rdfs:label 'Control Center Id' ;
    rdfs:comment 'Foreign key reference to the control center facility where this BES cyber system asset is located, if applicable.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ControlCenter .

ind:applicableCipStandards rdf:type rdf:Property ;
    rdfs:label 'Applicable Cip Standards' ;
    rdfs:comment 'Comma-separated list of applicable NERC CIP standard requirements for this asset (e.g., CIP-002, CIP-003, CIP-004, CIP-005, CIP-006, CIP-007, CIP-008, CIP-009, CIP-010, CIP-011, CIP-014).' ;
    rdfs:domain ind:NercCipAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetOwner rdf:type rdf:Property ;
    rdfs:label 'Asset Owner' ;
    rdfs:comment 'The organizational unit or department that owns and maintains this BES cyber system asset.' ;
    rdfs:domain ind:NercCipAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:besCyberSystemIdentifier rdf:type rdf:Property ;
    rdfs:label 'Bes Cyber System Identifier' ;
    rdfs:comment 'The unique identifier assigned to the BES cyber system (e.g., EMS, SCADA RTU, relay communication processor) within the transmission facility.' ;
    rdfs:domain ind:NercCipAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cipVersion rdf:type rdf:Property ;
    rdfs:label 'Cip Version' ;
    rdfs:comment 'The version of the NERC CIP standards applicable to this asset (e.g., CIP Version 5, CIP Version 6).' ;
    rdfs:domain ind:NercCipAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:configurationBaselineReference rdf:type rdf:Property ;
    rdfs:label 'Configuration Baseline Reference' ;
    rdfs:comment 'Reference identifier to the configuration baseline documentation for this BES cyber system asset per NERC CIP-010 configuration management requirements.' ;
    rdfs:domain ind:NercCipAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criticalityScore rdf:type rdf:Property ;
    rdfs:label 'Criticality Score' ;
    rdfs:comment 'A numerical score representing the criticality of this BES cyber system asset to grid reliability and operations, used for prioritization of security controls and assessments.' ;
    rdfs:domain ind:NercCipAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cyberSecurityIncidentCount rdf:type rdf:Property ;
    rdfs:label 'Cyber Security Incident Count' ;
    rdfs:comment 'The total number of reportable cyber security incidents associated with this BES cyber system asset.' ;
    rdfs:domain ind:NercCipAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:espIdentifier rdf:type rdf:Property ;
    rdfs:label 'Esp Identifier' ;
    rdfs:comment 'The unique identifier of the Electronic Security Perimeter to which this asset belongs, if applicable.' ;
    rdfs:domain ind:NercCipAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:espMembership rdf:type rdf:Property ;
    rdfs:label 'Esp Membership' ;
    rdfs:comment 'Indicates whether the asset is a member of an Electronic Security Perimeter as defined in NERC CIP-005.' ;
    rdfs:domain ind:NercCipAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:evidenceArtifactReference rdf:type rdf:Property ;
    rdfs:label 'Evidence Artifact Reference' ;
    rdfs:comment 'Reference identifier or URI to the compliance evidence artifacts (documentation, logs, reports) associated with this BES cyber system asset.' ;
    rdfs:domain ind:NercCipAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:impactRating rdf:type rdf:Property ;
    rdfs:label 'Impact Rating' ;
    rdfs:comment 'The CIP impact rating assigned to the BES cyber system per NERC CIP-002-5.1a categorization (high, medium, or low impact).' ;
    rdfs:domain ind:NercCipAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastCipAuditDate rdf:type rdf:Property ;
    rdfs:label 'Last Cip Audit Date' ;
    rdfs:comment 'The date of the most recent NERC CIP compliance audit that included this BES cyber system asset.' ;
    rdfs:domain ind:NercCipAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastIncidentDate rdf:type rdf:Property ;
    rdfs:label 'Last Incident Date' ;
    rdfs:comment 'The date of the most recent cyber security incident involving this BES cyber system asset.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastVulnerabilityAssessmentDate rdf:type rdf:Property ;
    rdfs:label 'Last Vulnerability Assessment Date' ;
    rdfs:comment 'The date of the most recent vulnerability assessment performed on this BES cyber system asset per NERC CIP-010 requirements.' ;
    rdfs:domain ind:NercCipAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:networkZone rdf:type rdf:Property ;
    rdfs:label 'Network Zone' ;
    rdfs:comment 'The network security zone or segment where this BES cyber system asset resides (e.g., control network, corporate network, DMZ).' ;
    rdfs:domain ind:NercCipAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextCipAuditDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Cip Audit Due Date' ;
    rdfs:comment 'The date by which the next NERC CIP compliance audit is scheduled or due for this asset.' ;
    rdfs:domain ind:NercCipAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextVulnerabilityAssessmentDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Vulnerability Assessment Due Date' ;
    rdfs:comment 'The date by which the next vulnerability assessment must be completed for this BES cyber system asset.' ;
    rdfs:domain ind:NercCipAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:physicalSecurityAssessmentDate rdf:type rdf:Property ;
    rdfs:label 'Physical Security Assessment Date' ;
    rdfs:comment 'The date of the most recent physical security assessment performed for this asset per NERC CIP-014 requirements.' ;
    rdfs:domain ind:NercCipAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:pspIdentifier rdf:type rdf:Property ;
    rdfs:label 'Psp Identifier' ;
    rdfs:comment 'The unique identifier of the Physical Security Perimeter where this asset is located, if applicable.' ;
    rdfs:domain ind:NercCipAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pspMembership rdf:type rdf:Property ;
    rdfs:label 'Psp Membership' ;
    rdfs:comment 'Indicates whether the asset is located within a Physical Security Perimeter as defined in NERC CIP-006.' ;
    rdfs:domain ind:NercCipAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:remediationPlanReference rdf:type rdf:Property ;
    rdfs:label 'Remediation Plan Reference' ;
    rdfs:comment 'Reference identifier to the remediation or mitigation plan for any identified non-compliance or vulnerabilities associated with this asset.' ;
    rdfs:domain ind:NercCipAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsibleEntity rdf:type rdf:Property ;
    rdfs:label 'Responsible Entity' ;
    rdfs:comment 'The name of the registered entity responsible for the compliance of this BES cyber system asset under NERC CIP standards.' ;
    rdfs:domain ind:NercCipAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retirementReason rdf:type rdf:Property ;
    rdfs:label 'Retirement Reason' ;
    rdfs:comment 'The reason or justification for retiring or decommissioning this BES cyber system asset.' ;
    rdfs:domain ind:NercCipAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignedCrewId rdf:type rdf:Property ;
    rdfs:label 'Assigned Crew Id' ;
    rdfs:comment 'Foreign key linking to transmission.crew. Business justification: Outages are resolved by crews. The outage table has crew_assignment STRING. Normalizing to FK to crew. Removes crew_assignment string.' ;
    rdfs:domain ind:Outage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Crew .

ind:causedDistributionOutageEventId rdf:type rdf:Property ;
    rdfs:label 'Caused Distribution Outage Event Id' ;
    rdfs:comment 'Foreign key linking to distribution.outage_event. Business justification: Transmission outages frequently cause downstream distribution outages. Critical for root cause analysis, customer impact assessment, SAIDI/SAIFI attribution, restoration coordination, and regulatory r' ;
    rdfs:domain ind:Outage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DistributionOutageEvent .

ind:outagedLineId rdf:type rdf:Property ;
    rdfs:label 'Outaged Line Id' ;
    rdfs:comment 'Foreign key linking to transmission.line. Business justification: Outages affect specific transmission elements. The current schema uses polymorphic pattern (element_reference STRING + element_name STRING + element_type STRING). Normalizing to explicit FKs for lines' ;
    rdfs:domain ind:Outage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Line .

ind:outagedTransformerId rdf:type rdf:Property ;
    rdfs:label 'Outaged Transformer Id' ;
    rdfs:comment 'Foreign key linking to transmission.transformer. Business justification: Outages also affect transformers. This FK links outages to transformers. Together with outaged_line_id, replaces the polymorphic element_reference pattern with explicit typed FKs.' ;
    rdfs:domain ind:Outage ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Transformer .

ind:actualEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Actual End Timestamp' ;
    rdfs:comment 'Actual date and time when the transmission element was restored to service and returned to normal operation.' ;
    rdfs:domain ind:Outage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:contingencyAnalysisPerformedFlag rdf:type rdf:Property ;
    rdfs:label 'Contingency Analysis Performed Flag' ;
    rdfs:comment 'Indicates whether a contingency analysis was performed to assess the impact of the outage on system reliability and identify potential N-1 or N-2 violations. Required for planned outages of critical BES elements.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coordinator rdf:type rdf:Property ;
    rdfs:label 'Coordinator' ;
    rdfs:comment 'Name or identifier of the transmission operations staff member responsible for coordinating the outage with the RTO/ISO, adjacent utilities, and internal stakeholders.' ;
    rdfs:domain ind:Outage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loadImpactMw rdf:type rdf:Property ;
    rdfs:label 'Load Impact Mw' ;
    rdfs:comment 'Estimated or actual megawatt load impact of the outage on the transmission system. Represents the amount of power flow interrupted or curtailed due to the outage.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nercTadsReportingFlag rdf:type rdf:Property ;
    rdfs:label 'Nerc Tads Reporting Flag' ;
    rdfs:comment 'Indicates whether this outage must be reported to NERC TADS. True for outages of BES elements that meet NERC reporting thresholds. False for minor outages below reporting thresholds.' ;
    rdfs:domain ind:Outage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:restorationPriority rdf:type rdf:Property ;
    rdfs:label 'Restoration Priority' ;
    rdfs:comment 'Priority level assigned for restoration activities. Critical priority for outages affecting critical infrastructure or large customer populations. High priority for significant system impacts. Medium and low for routine maintenance outages.' ;
    rdfs:domain ind:Outage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rtoIsoNotificationReference rdf:type rdf:Property ;
    rdfs:label 'Rto Iso Notification Reference' ;
    rdfs:comment 'Reference number or identifier for the outage notification submitted to the RTO or ISO. Required for coordination of transmission outages that affect the bulk electric system.' ;
    rdfs:domain ind:Outage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduledEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Scheduled End Timestamp' ;
    rdfs:comment 'Planned date and time when the outage is scheduled to end and the element is expected to be restored to service.' ;
    rdfs:domain ind:Outage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:scheduledStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Scheduled Start Timestamp' ;
    rdfs:comment 'Planned date and time when the outage is scheduled to begin. For forced outages, this may be null or equal to actual start time.' ;
    rdfs:domain ind:Outage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:switchingOrderReference rdf:type rdf:Property ;
    rdfs:label 'Switching Order Reference' ;
    rdfs:comment 'Reference to the associated switching order or operating order that authorizes the isolation and de-energization of the transmission element. Links to the switching procedure documentation.' ;
    rdfs:domain ind:Outage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:toBusCode rdf:type rdf:Property ;
    rdfs:label 'To Bus Code' ;
    rdfs:comment 'Identifier of the terminating bus or electrical node for transmission line outages. Defines the ending point of the affected line segment.' ;
    rdfs:domain ind:Outage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workOrderReference rdf:type rdf:Property ;
    rdfs:label 'Work Order Reference' ;
    rdfs:comment 'Reference to the associated work order in the Enterprise Asset Management (EAM) system that documents the maintenance or construction activities performed during the outage.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:protectionSystemId rdf:type rdf:Property ;
    rdfs:label 'Protection System Id' ;
    rdfs:comment 'Unique identifier for the protective relay system or protection scheme. Primary key for the protection system entity. Serves as the authoritative reference for all protection equipment records across relay management systems, Enterprise Asset Management (EAM), and NERC Protection and Control (PRC) compliance tracking.' ;
    rdfs:domain ind:ProtectionSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:backupProtectionSystemId rdf:type rdf:Property ;
    rdfs:label 'Backup Protection System Id' ;
    rdfs:comment 'Foreign key reference to the backup or redundant protection system that provides secondary protection for the same transmission element. Used for coordination studies and reliability analysis per NERC PRC-023 requirements.' ;
    rdfs:domain ind:ProtectionSystem ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProtectionSystem .

ind:protectedLineId rdf:type rdf:Property ;
    rdfs:label 'Protected Line Id' ;
    rdfs:comment 'Foreign key linking to transmission.line. Business justification: Protection systems protect specific transmission elements. The current schema uses a polymorphic pattern (transmission_element_reference BIGINT + transmission_element_type STRING). Normalizing to expl' ;
    rdfs:domain ind:ProtectionSystem ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Line .

ind:protectedTransformerId rdf:type rdf:Property ;
    rdfs:label 'Protected Transformer Id' ;
    rdfs:comment 'Foreign key linking to transmission.transformer. Business justification: Protection systems also protect transformers. This FK links protection systems to the transformers they protect. Together with protected_line_id, this replaces the polymorphic transmission_element_ref' ;
    rdfs:domain ind:ProtectionSystem ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Transformer .

ind:relayMaterialMasterId rdf:type rdf:Property ;
    rdfs:label 'Relay Material Master Id' ;
    rdfs:comment 'Foreign key linking to supply.material_master. Business justification: Protection relays are procured equipment with manufacturer part numbers and specifications. Material master enables spare parts inventory management, standardization of relay types across substations,' ;
    rdfs:domain ind:ProtectionSystem ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MaterialMaster .

ind:coordinationStudyReference rdf:type rdf:Property ;
    rdfs:label 'Coordination Study Reference' ;
    rdfs:comment 'Reference identifier to the protection coordination study that validated this systems settings and selectivity with adjacent devices. Links to engineering analysis documentation required for NERC PRC compliance and fault investigation.' ;
    rdfs:domain ind:ProtectionSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ctRatio rdf:type rdf:Property ;
    rdfs:label 'Ct Ratio' ;
    rdfs:comment 'Current transformer turns ratio (e.g., 2000:5, 1200:1) that scales primary current to secondary relay input. Essential for relay setting calculations, coordination studies, and accurate fault current measurement.' ;
    rdfs:domain ind:ProtectionSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:faultRecordCount rdf:type rdf:Property ;
    rdfs:label 'Fault Record Count' ;
    rdfs:comment 'Total number of fault events recorded by this protection system since commissioning or last counter reset. Used for reliability analysis, equipment stress assessment, and predictive maintenance planning.' ;
    rdfs:domain ind:ProtectionSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isBesProtection rdf:type rdf:Property ;
    rdfs:label 'Is Bes Protection' ;
    rdfs:comment 'Boolean indicator of whether this protection system is classified as protecting a BES element and therefore subject to NERC reliability standards. Determines applicability of NERC PRC and CIP compliance requirements.' ;
    rdfs:domain ind:ProtectionSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastCalibrationDate rdf:type rdf:Property ;
    rdfs:label 'Last Calibration Date' ;
    rdfs:comment 'Date when the protective relay was last tested, calibrated, and verified to be operating within manufacturer specifications. Critical for NERC PRC-005 maintenance compliance and reliability assurance.' ;
    rdfs:domain ind:ProtectionSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastFaultDate rdf:type rdf:Property ;
    rdfs:label 'Last Fault Date' ;
    rdfs:comment 'Date when this protection system last detected and responded to a fault condition. Used for operational trending and to correlate protection performance with transmission outage events.' ;
    rdfs:domain ind:ProtectionSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastMisoperationDate rdf:type rdf:Property ;
    rdfs:label 'Last Misoperation Date' ;
    rdfs:comment 'Date of the most recent documented protection system misoperation. Triggers NERC PRC-004 investigation and corrective action plan requirements. Nullable if no misoperations have occurred.' ;
    rdfs:domain ind:ProtectionSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:misoperationCount rdf:type rdf:Property ;
    rdfs:label 'Misoperation Count' ;
    rdfs:comment 'Cumulative count of documented protection system misoperations (incorrect trips or failures to trip) as defined by NERC PRC-004. Used for reliability trending, root cause analysis, and identification of systematic protection issues.' ;
    rdfs:domain ind:ProtectionSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:nercPrcComplianceStatus rdf:type rdf:Property ;
    rdfs:label 'Nerc Prc Compliance Status' ;
    rdfs:comment 'Current compliance status with applicable NERC PRC standards (PRC-005, PRC-019, PRC-023, PRC-025, PRC-027). Tracks whether maintenance, testing, coordination, and documentation requirements are met. Critical for regulatory audits and reliability assurance.' ;
    rdfs:domain ind:ProtectionSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextCalibrationDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Calibration Due Date' ;
    rdfs:comment 'Scheduled date for the next required calibration or maintenance test based on NERC PRC-005 time-based or performance-based maintenance intervals. Used for preventive maintenance planning and compliance tracking.' ;
    rdfs:domain ind:ProtectionSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:originalCostUsd rdf:type rdf:Property ;
    rdfs:label 'Original Cost Usd' ;
    rdfs:comment 'Original installed cost of the protection system in US dollars, including equipment, engineering, installation labor, and commissioning. Used for FERC rate base calculations, depreciation, and capital expenditure tracking.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:protectionSchemeType rdf:type rdf:Property ;
    rdfs:label 'Protection Scheme Type' ;
    rdfs:comment 'Primary protection principle or relay logic employed by this system (e.g., distance protection for transmission lines, differential for transformers, pilot schemes for critical circuits). Defines the protection philosophy and coordination requirements per IEEE and NERC standards. [ENUM-REF-CANDIDATE: distance|differential|overcurrent|pilot|directional_comparison|transfer_trip|breaker_failure|undervoltage|overvoltage|underfrequency|overfrequency — 11 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:ProtectionSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:protectionSystemCode rdf:type rdf:Property ;
    rdfs:label 'Protection System Code' ;
    rdfs:comment 'Standardized alphanumeric code or tag number assigned to the protection system for asset tracking, SCADA integration, and maintenance scheduling. Often follows utility-specific naming conventions aligned with substation or transmission line designations.' ;
    rdfs:domain ind:ProtectionSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:protectionSystemName rdf:type rdf:Property ;
    rdfs:label 'Protection System Name' ;
    rdfs:comment 'Human-readable name or designation of the protection system, typically including location and function identifiers (e.g., \'Main-1 Line Differential\', \'Bus 5 Overcurrent\'). Used for operational identification and work order references.' ;
    rdfs:domain ind:ProtectionSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:protectionZone rdf:type rdf:Property ;
    rdfs:label 'Protection Zone' ;
    rdfs:comment 'Protection zone classification defining the reach and coordination tier of the relay (e.g., Zone 1 instantaneous, Zone 2 time-delayed, Zone 3 remote backup). Critical for selectivity and coordination with adjacent protection systems per IEEE standards.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ptRatio rdf:type rdf:Property ;
    rdfs:label 'Pt Ratio' ;
    rdfs:comment 'Potential (voltage) transformer turns ratio (e.g., 115000:115, 345000:120) that scales primary voltage to secondary relay input. Required for distance relay reach calculations and voltage-based protection schemes.' ;
    rdfs:domain ind:ProtectionSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relayManagementSystemReference rdf:type rdf:Property ;
    rdfs:label 'Relay Management System Reference' ;
    rdfs:comment 'External reference to the protection system record in the relay management system (SEL AcSELerator, GE UR Setup, ABB PCM600). Links to relay settings files, event records, and firmware management.' ;
    rdfs:domain ind:ProtectionSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relaySerialNumber rdf:type rdf:Property ;
    rdfs:label 'Relay Serial Number' ;
    rdfs:comment 'Unique manufacturer-assigned serial number for the physical relay device. Used for warranty tracking, asset inventory, and device-specific configuration management in relay management systems.' ;
    rdfs:domain ind:ProtectionSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settingsLastModifiedDate rdf:type rdf:Property ;
    rdfs:label 'Settings Last Modified Date' ;
    rdfs:comment 'Date when the relay settings were last changed or updated. Critical for change management tracking, NERC PRC compliance documentation, and correlation with system performance changes.' ;
    rdfs:domain ind:ProtectionSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:settingsModifiedBy rdf:type rdf:Property ;
    rdfs:label 'Settings Modified By' ;
    rdfs:comment 'Name or identifier of the engineer or technician who last modified the relay settings. Required for audit trails, accountability, and NERC CIP access control compliance.' ;
    rdfs:domain ind:ProtectionSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tripSettingReference rdf:type rdf:Property ;
    rdfs:label 'Trip Setting Reference' ;
    rdfs:comment 'Reference identifier or file path to the approved relay settings document, including pickup values, time delays, reach settings, and logic configurations. Required for NERC PRC-019 compliance and protection coordination verification.' ;
    rdfs:domain ind:ProtectionSystem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceRequestId rdf:type rdf:Property ;
    rdfs:label 'Service Request Id' ;
    rdfs:comment 'Primary key for service_request' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:receiptSubstationId rdf:type rdf:Property ;
    rdfs:label 'Receipt Substation Id' ;
    rdfs:comment 'Foreign key linking to transmission.transmission_substation. Business justification: OATT service requests specify point of receipt (where power enters the transmission system). The current point_of_receipt is a STRING. Normalizing to FK to transmission_substation. Removes point_of_re' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TransmissionSubstation .

ind:approvedCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Approved Capacity Mw' ;
    rdfs:comment 'The amount of transmission capacity approved by the transmission provider following study completion, expressed in Megawatts (MW). May differ from requested capacity due to system constraints or congestion. Null until approval decision is made.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:atcAvailableMw rdf:type rdf:Property ;
    rdfs:label 'Atc Available Mw' ;
    rdfs:comment 'The Available Transfer Capability (ATC) in Megawatts on the relevant transmission path at the time the service request was submitted. Captured as a snapshot to document the grid conditions that informed the feasibility assessment.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depositAmountUsd rdf:type rdf:Property ;
    rdfs:label 'Deposit Amount Usd' ;
    rdfs:comment 'The deposit amount in US Dollars collected from the requesting entity to fund the feasibility, system impact, and facilities studies. Refundable or credited against final upgrade costs per OATT provisions.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depositReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Deposit Received Date' ;
    rdfs:comment 'Date on which the study deposit was received from the requesting entity. Receipt of deposit typically triggers the start of the study process under OATT timelines.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:estimatedUpgradeCostUsd rdf:type rdf:Property ;
    rdfs:label 'Estimated Upgrade Cost Usd' ;
    rdfs:comment 'Estimated cost in US Dollars of transmission network upgrades required to accommodate the requested service, as determined by the Facilities Study. Used for cost allocation, Contribution in Aid of Construction (CIAC) determination, and rate case support.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:facilitiesStudyStatus rdf:type rdf:Property ;
    rdfs:label 'Facilities Study Status' ;
    rdfs:comment 'Current status of the Facilities Study identifying the specific transmission upgrades or new facilities required to accommodate the requested service. Third and final study phase under FERC Order 2003.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feasibilityStudyStatus rdf:type rdf:Property ;
    rdfs:label 'Feasibility Study Status' ;
    rdfs:comment 'Current status of the feasibility study conducted to assess whether the requested transmission service can be accommodated on the existing grid without violating reliability criteria. First study phase under FERC Order 2003 interconnection process.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fercFilingReference rdf:type rdf:Property ;
    rdfs:label 'Ferc Filing Reference' ;
    rdfs:comment 'FERC docket number or filing reference associated with this transmission service request, if the request or resulting agreement requires a FERC filing (e.g., for long-term firm service agreements). Links to regulatory docket tracking.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:firmnessIndicator rdf:type rdf:Property ;
    rdfs:label 'Firmness Indicator' ;
    rdfs:comment 'Indicates whether the requested transmission service is firm (reserved, curtailed last) or non-firm (interruptible, curtailed first during congestion). Drives curtailment priority and pricing under the OATT.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nercPathDesignation rdf:type rdf:Property ;
    rdfs:label 'Nerc Path Designation' ;
    rdfs:comment 'The NERC-designated transmission path or flowgate associated with this service request. Used for reliability assessments, Available Transfer Capability (ATC) calculations, and congestion management.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:oasisQueueNumber rdf:type rdf:Property ;
    rdfs:label 'Oasis Queue Number' ;
    rdfs:comment 'The externally-known queue number assigned by the OASIS portal when the transmission service request is submitted. Used for FERC OATT compliance tracking and public disclosure of transmission queue position.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pointOfDelivery rdf:type rdf:Property ;
    rdfs:label 'Point Of Delivery' ;
    rdfs:comment 'The designated point on the transmission provider\'s system where energy exits the grid for delivery to the requesting entity. Defined per OATT and corresponds to a specific substation or load node. Industry-standard term: POD.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestNotes rdf:type rdf:Property ;
    rdfs:label 'Request Notes' ;
    rdfs:comment 'Free-text field for transmission planners and OATT administrators to record supplemental information, special conditions, study assumptions, or coordination notes related to the service request. Not used for structured data.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestedEndDate rdf:type rdf:Property ;
    rdfs:label 'Requested End Date' ;
    rdfs:comment 'The date on which the requesting entity desires transmission service to terminate. Null for open-ended or long-term service requests. Used for capacity planning and OATT compliance.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:requestedStartDate rdf:type rdf:Property ;
    rdfs:label 'Requested Start Date' ;
    rdfs:comment 'The date on which the requesting entity desires transmission service to commence. Used for scheduling, capacity reservation, and OATT compliance tracking.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:requestingEntityDuns rdf:type rdf:Property ;
    rdfs:label 'Requesting Entity Duns' ;
    rdfs:comment 'Nine-digit DUNS number uniquely identifying the requesting entity for FERC regulatory reporting and OASIS registration. Required for FERC Form 1 and OATT compliance filings.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestingEntityName rdf:type rdf:Property ;
    rdfs:label 'Requesting Entity Name' ;
    rdfs:comment 'Legal name of the entity requesting transmission service under the OATT. May be a load-serving entity, independent power producer, energy marketer, or other eligible customer. Retained for reporting without requiring a join.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceAgreementNumber rdf:type rdf:Property ;
    rdfs:label 'Service Agreement Number' ;
    rdfs:comment 'Reference number of the executed Transmission Service Agreement (TSA) resulting from an approved service request. Links the request to the binding contractual instrument filed with FERC. Null until agreement is executed.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceTermType rdf:type rdf:Property ;
    rdfs:label 'Service Term Type' ;
    rdfs:comment 'Classification of the duration of the requested transmission service. Long-term firm service (one year or more) has different OATT rights and study requirements than short-term service. Drives tariff rate application.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sinkLoadName rdf:type rdf:Property ;
    rdfs:label 'Sink Load Name' ;
    rdfs:comment 'Name or identifier of the load or sink associated with the transmission service request at the point of delivery. Used for network modeling and system impact study analysis.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceResourceName rdf:type rdf:Property ;
    rdfs:label 'Source Resource Name' ;
    rdfs:comment 'Name or identifier of the generation resource or energy source associated with the transmission service request at the point of receipt. Used for interconnection queue coordination and system impact studies.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:systemImpactStudyStatus rdf:type rdf:Property ;
    rdfs:label 'System Impact Study Status' ;
    rdfs:comment 'Current status of the System Impact Study (SIS) evaluating the effect of the requested transmission service on the reliability and security of the bulk electric system. Second study phase under FERC Order 2003.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tariffRateSchedule rdf:type rdf:Property ;
    rdfs:label 'Tariff Rate Schedule' ;
    rdfs:comment 'The specific OATT rate schedule applicable to this transmission service request (e.g., Schedule 7 for firm PTP, Schedule 8 for non-firm PTP). Determines the transmission rate and ancillary service charges applied.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transmissionProviderCode rdf:type rdf:Property ;
    rdfs:label 'Transmission Provider Code' ;
    rdfs:comment 'NERC-assigned or FERC-registered code identifying the transmission provider (utility) responsible for processing this service request. Required for OASIS filings and FERC Form 1 reporting.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transmissionRateMwPerYear rdf:type rdf:Property ;
    rdfs:label 'Transmission Rate Mw Per Year' ;
    rdfs:comment 'The applicable transmission rate in US Dollars per Megawatt per year as specified in the OATT rate schedule for this service request. Used for revenue requirement calculation and billing.' ;
    rdfs:domain ind:ServiceRequest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:switchingOrderId rdf:type rdf:Property ;
    rdfs:label 'Switching Order Id' ;
    rdfs:comment 'Unique identifier for the switching order. Primary key for the switching order record.' ;
    rdfs:domain ind:SwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:authorizingOperatorId rdf:type rdf:Property ;
    rdfs:label 'Authorizing Operator Id' ;
    rdfs:comment 'Identifier of the transmission system operator or supervisor who approved and authorized the switching order for execution. Required for compliance with switching authority protocols.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Operator .

ind:executingCrewId rdf:type rdf:Property ;
    rdfs:label 'Executing Crew Id' ;
    rdfs:comment 'Identifier of the field crew assigned to physically execute the switching operations. Links to workforce management system for crew scheduling and dispatch.' ;
    rdfs:domain ind:SwitchingOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Crew .

ind:switchedLineId rdf:type rdf:Property ;
    rdfs:label 'Switched Line Id' ;
    rdfs:comment 'Foreign key linking to transmission.line. Business justification: Switching orders operate on specific transmission elements. The current schema uses polymorphic pattern (transmission_element_reference BIGINT + transmission_element_name STRING + transmission_element' ;
    rdfs:domain ind:SwitchingOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Line .

ind:switchedTransformerId rdf:type rdf:Property ;
    rdfs:label 'Switched Transformer Id' ;
    rdfs:comment 'Foreign key linking to transmission.transformer. Business justification: Switching orders also operate on transformers. This FK links switching orders to transformers being switched. Together with switched_line_id, replaces the polymorphic transmission_element_reference pa' ;
    rdfs:domain ind:SwitchingOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Transformer .

ind:actualEndDatetime rdf:type rdf:Property ;
    rdfs:label 'Actual End Datetime' ;
    rdfs:comment 'Actual date and time when the switching operation was completed. Enables calculation of actual duration and comparison against planned schedule for operational efficiency metrics.' ;
    rdfs:domain ind:SwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:actualStartDatetime rdf:type rdf:Property ;
    rdfs:label 'Actual Start Datetime' ;
    rdfs:comment 'Actual date and time when the switching operation execution began. Used for performance tracking, variance analysis, and regulatory reporting of switching activities.' ;
    rdfs:domain ind:SwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:authorizingOperatorName rdf:type rdf:Property ;
    rdfs:label 'Authorizing Operator Name' ;
    rdfs:comment 'Full name of the transmission system operator or supervisor who approved and authorized the switching order for execution.' ;
    rdfs:domain ind:SwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cancellationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Cancellation Timestamp' ;
    rdfs:comment 'Date and time when the switching order was cancelled. Populated only for orders that were cancelled before completion.' ;
    rdfs:domain ind:SwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:clearanceTagReference rdf:type rdf:Property ;
    rdfs:label 'Clearance Tag Reference' ;
    rdfs:comment 'Reference number or identifier of the physical clearance tag(s) or tagout permit(s) associated with this switching order. Used for lockout/tagout compliance and worker safety protection.' ;
    rdfs:domain ind:SwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emsReference rdf:type rdf:Property ;
    rdfs:label 'Ems Reference' ;
    rdfs:comment 'Reference identifier from the Energy Management System (ABB or GE EMS) where this switching order was created or synchronized. Enables bidirectional integration between EMS and switching order management.' ;
    rdfs:domain ind:SwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:executingCrewName rdf:type rdf:Property ;
    rdfs:label 'Executing Crew Name' ;
    rdfs:comment 'Name or designation of the field crew assigned to physically execute the switching operations.' ;
    rdfs:domain ind:SwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nercCipApplicableFlag rdf:type rdf:Property ;
    rdfs:label 'Nerc Cip Applicable Flag' ;
    rdfs:comment 'Indicates whether this switching order involves Critical Infrastructure Protection (CIP) assets requiring cyber security and physical security controls under NERC CIP standards.' ;
    rdfs:domain ind:SwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nercIroComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Nerc Iro Compliance Flag' ;
    rdfs:comment 'Indicates whether this switching order requires coordination with the Reliability Coordinator under NERC Interchange and Reliability Operations (IRO) standards. True for switching operations affecting Bulk Electric System (BES) reliability.' ;
    rdfs:domain ind:SwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:omsReference rdf:type rdf:Property ;
    rdfs:label 'Oms Reference' ;
    rdfs:comment 'Reference identifier from the Outage Management System (Schneider Electric AMS or GE PowerOn) where this switching order was created or synchronized. Links switching operations to outage restoration workflows.' ;
    rdfs:domain ind:SwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:plannedEndDatetime rdf:type rdf:Property ;
    rdfs:label 'Planned End Datetime' ;
    rdfs:comment 'Scheduled date and time when the switching operation is planned to be completed and equipment returned to normal state. Critical for outage duration planning and customer impact assessment.' ;
    rdfs:domain ind:SwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:plannedStartDatetime rdf:type rdf:Property ;
    rdfs:label 'Planned Start Datetime' ;
    rdfs:comment 'Scheduled date and time when the switching operation is planned to begin. Used for coordination with field crews, outage scheduling, and system operator shift planning.' ;
    rdfs:domain ind:SwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:requestingOperatorCode rdf:type rdf:Property ;
    rdfs:label 'Requesting Operator Code' ;
    rdfs:comment 'Identifier of the transmission system operator or dispatcher who initiated the switching order request. Used for accountability and audit trail purposes.' ;
    rdfs:domain ind:SwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestingOperatorName rdf:type rdf:Property ;
    rdfs:label 'Requesting Operator Name' ;
    rdfs:comment 'Full name of the transmission system operator or dispatcher who initiated the switching order request.' ;
    rdfs:domain ind:SwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rtoIsoNotificationFlag rdf:type rdf:Property ;
    rdfs:label 'Rto Iso Notification Flag' ;
    rdfs:comment 'Indicates whether this switching order requires notification to the Regional Transmission Organization (RTO) or Independent System Operator (ISO) due to potential impact on transmission capacity or market operations.' ;
    rdfs:domain ind:SwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:safetyGroundPlacement rdf:type rdf:Property ;
    rdfs:label 'Safety Ground Placement' ;
    rdfs:comment 'Description of safety ground locations and installation requirements for this switching order. Specifies where protective grounds must be installed to protect workers from induced voltage or backfeed.' ;
    rdfs:domain ind:SwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:switchingSequenceSteps rdf:type rdf:Property ;
    rdfs:label 'Switching Sequence Steps' ;
    rdfs:comment 'Detailed step-by-step instructions for the switching operation sequence. Specifies the order of breaker and disconnect operations, verification steps, and safety checkpoints. May reference standard operating procedures.' ;
    rdfs:domain ind:SwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferCapabilityImpactMw rdf:type rdf:Property ;
    rdfs:label 'Transfer Capability Impact Mw' ;
    rdfs:comment 'Estimated reduction in Available Transfer Capability (ATC) in megawatts resulting from this switching operation. Critical for transmission service scheduling and market operations.' ;
    rdfs:domain ind:SwitchingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tariffRateId rdf:type rdf:Property ;
    rdfs:label 'Tariff Rate Id' ;
    rdfs:comment 'Primary key for tariff_rate' ;
    rdfs:domain ind:TariffRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ancillaryServiceRate rdf:type rdf:Property ;
    rdfs:label 'Ancillary Service Rate' ;
    rdfs:comment 'Rate component for ancillary services required to support transmission service, including scheduling, system control, reactive supply, voltage support, regulation, frequency response, operating reserves, and energy imbalance. Expressed in dollars per unit (kW or MWh depending on service type).' ;
    rdfs:domain ind:TariffRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approvingAuthority rdf:type rdf:Property ;
    rdfs:label 'Approving Authority' ;
    rdfs:comment 'Regulatory body or authority that approved this transmission rate. FERC has jurisdiction over interstate transmission rates under the Federal Power Act; state PUCs may have jurisdiction over intrastate rates; RTO/ISO may approve rates under delegated authority; internal indicates rates set under formula rate mechanisms.' ;
    rdfs:domain ind:TariffRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:congestionChargeApplicableFlag rdf:type rdf:Property ;
    rdfs:label 'Congestion Charge Applicable Flag' ;
    rdfs:comment 'Indicates whether transmission congestion charges (based on Locational Marginal Price differences) apply in addition to the stated transmission rate. Typically true in RTO/ISO markets with nodal pricing.' ;
    rdfs:domain ind:TariffRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:demandChargePerKwMonth rdf:type rdf:Property ;
    rdfs:label 'Demand Charge Per Kw Month' ;
    rdfs:comment 'Monthly demand charge component of the transmission rate, expressed in dollars per kilowatt (kW) of reserved transmission capacity per month. This is the primary cost driver for firm transmission service.' ;
    rdfs:domain ind:TariffRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:discountPolicyFlag rdf:type rdf:Property ;
    rdfs:label 'Discount Policy Flag' ;
    rdfs:comment 'Indicates whether this rate schedule permits discounting below the stated maximum rate. FERC allows transmission providers to offer discounted rates for competitive reasons, subject to non-discrimination requirements.' ;
    rdfs:domain ind:TariffRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:energyChargePerMwh rdf:type rdf:Property ;
    rdfs:label 'Energy Charge Per Mwh' ;
    rdfs:comment 'Energy-based charge component of the transmission rate, expressed in dollars per megawatt-hour (MWh) of energy transmitted. Typically applies to non-firm or short-term point-to-point service.' ;
    rdfs:domain ind:TariffRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastRateCaseDate rdf:type rdf:Property ;
    rdfs:label 'Last Rate Case Date' ;
    rdfs:comment 'Date of the most recent general transmission rate case filing that established or modified this rate. Rate cases are comprehensive regulatory proceedings to review and approve transmission revenue requirements and rate design.' ;
    rdfs:domain ind:TariffRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lossCompensationPercent rdf:type rdf:Property ;
    rdfs:label 'Loss Compensation Percent' ;
    rdfs:comment 'Percentage of transmitted energy that must be provided by the transmission customer to compensate for electrical losses on the transmission system. Typically ranges from 1% to 5% depending on distance and voltage class.' ;
    rdfs:domain ind:TariffRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maximumReservationKw rdf:type rdf:Property ;
    rdfs:label 'Maximum Reservation Kw' ;
    rdfs:comment 'Maximum transmission capacity reservation allowed under this rate schedule, expressed in kilowatts (kW). Null if no maximum applies.' ;
    rdfs:domain ind:TariffRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minimumReservationKw rdf:type rdf:Property ;
    rdfs:label 'Minimum Reservation Kw' ;
    rdfs:comment 'Minimum transmission capacity reservation required to qualify for this rate, expressed in kilowatts (kW). Some rate schedules have minimum thresholds below which different rates or service terms apply.' ;
    rdfs:domain ind:TariffRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:nercRegionCode rdf:type rdf:Property ;
    rdfs:label 'Nerc Region Code' ;
    rdfs:comment 'NERC regional reliability entity code indicating the geographic reliability region in which this transmission rate applies. Used for compliance reporting and reliability coordination. [ENUM-REF-CANDIDATE: WECC|ERCOT|MRO|NPCC|RF|SERC|TRE|SPP — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextRateCaseScheduledDate rdf:type rdf:Property ;
    rdfs:label 'Next Rate Case Scheduled Date' ;
    rdfs:comment 'Scheduled date for the next general transmission rate case filing, if known. Null if no rate case is currently scheduled. Some formula rates update annually without full rate case proceedings.' ;
    rdfs:domain ind:TariffRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rateBasis rdf:type rdf:Property ;
    rdfs:label 'Rate Basis' ;
    rdfs:comment 'Methodology used to determine the transmission rate. Cost-of-service rates are based on embedded transmission system costs and allowed return on equity (ROE); market-based rates reflect competitive market conditions; formula rates adjust automatically based on actual costs; negotiated rates are bilaterally agreed; stated rates are fixed tariff rates.' ;
    rdfs:domain ind:TariffRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratePancakingFlag rdf:type rdf:Property ;
    rdfs:label 'Rate Pancaking Flag' ;
    rdfs:comment 'Indicates whether this rate is subject to pancaking (multiple transmission rate charges applied sequentially as power crosses multiple transmission owner service territories). FERC has worked to eliminate pancaking through RTO/ISO formation.' ;
    rdfs:domain ind:TariffRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rateType rdf:type rdf:Property ;
    rdfs:label 'Rate Type' ;
    rdfs:comment 'Classification of the transmission rate based on the type of service provided. Network rates apply to bundled transmission service; point-to-point rates apply to firm or non-firm transmission reservations; ancillary service rates cover scheduling, voltage support, and operating reserves.' ;
    rdfs:domain ind:TariffRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateZoneCode rdf:type rdf:Property ;
    rdfs:label 'Rate Zone Code' ;
    rdfs:comment 'Geographic or operational zone identifier to which this transmission rate applies. Rate zones segment the transmission system for cost allocation and pricing purposes, often aligned with load-serving areas or transmission owner territories.' ;
    rdfs:domain ind:TariffRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reactiveSupplyCharge rdf:type rdf:Property ;
    rdfs:label 'Reactive Supply Charge' ;
    rdfs:comment 'Charge for reactive power supply and voltage control service necessary to maintain transmission system voltage within acceptable limits. Typically expressed in dollars per kilovar (kVAR) or as a percentage of demand charge.' ;
    rdfs:domain ind:TariffRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rolloverRightsFlag rdf:type rdf:Property ;
    rdfs:label 'Rollover Rights Flag' ;
    rdfs:comment 'Indicates whether customers holding long-term firm point-to-point transmission service under this rate have rollover rights to renew their service at contract expiration, subject to system capability.' ;
    rdfs:domain ind:TariffRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:schedulingCoordinationCharge rdf:type rdf:Property ;
    rdfs:label 'Scheduling Coordination Charge' ;
    rdfs:comment 'Charge for scheduling, system control, and dispatch services provided by the transmission provider to coordinate the movement of power across the transmission system.' ;
    rdfs:domain ind:TariffRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transferCapabilityId rdf:type rdf:Property ;
    rdfs:label 'Transfer Capability Id' ;
    rdfs:comment 'Primary key for transfer_capability' ;
    rdfs:domain ind:TransferCapability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fromControlAreaId rdf:type rdf:Property ;
    rdfs:label 'From Control Area Id' ;
    rdfs:comment 'Foreign key linking to transmission.control_area. Business justification: Transfer capability is calculated between control areas. The transfer_capability table has from_area STRING. Normalizing to FK to control_area. Removes from_area string.' ;
    rdfs:domain ind:TransferCapability ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ControlArea .

ind:supersededByTransferCapabilityId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Transfer Capability Id' ;
    rdfs:comment 'Reference to the transmission_capacity_id of the newer ATC calculation record that supersedes this one, when atc_status = SUPERSEDED. Enables lineage tracking of ATC revisions for audit and regulatory review.' ;
    rdfs:domain ind:TransferCapability ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TransferCapability .

ind:atcMw rdf:type rdf:Property ;
    rdfs:label 'Atc Mw' ;
    rdfs:comment 'Available Transfer Capability in megawatts (MW) — the measure of the transfer capability remaining in the physical transmission network for further commercial activity over and above already committed uses. Calculated as: ATC = TTC - TRM - CBM - Existing Commitments - Pending Commitments. This is the principal QUANTITATIVE_RESULT posted to OASIS for market participants.' ;
    rdfs:domain ind:TransferCapability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:atcStatus rdf:type rdf:Property ;
    rdfs:label 'Atc Status' ;
    rdfs:comment 'Current lifecycle status of this ATC calculation record. POSTED: active and visible on OASIS; REVISED: updated due to recalculation trigger; SUPERSEDED: replaced by a newer calculation for the same path/direction/horizon; WITHDRAWN: removed from OASIS posting; PENDING: calculated but not yet posted. This is the LIFECYCLE_STATUS for the ATC record.' ;
    rdfs:domain ind:TransferCapability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bindingConstraintType rdf:type rdf:Property ;
    rdfs:label 'Binding Constraint Type' ;
    rdfs:comment 'The type of physical constraint that is binding (limiting) the TTC and therefore ATC for this path or flowgate. THERMAL: current/thermal rating; VOLTAGE: voltage stability; STABILITY: transient/dynamic stability; LOOP_FLOW: unscheduled loop flow; OTHER: other constraint type. Informs congestion management and grid planning decisions.' ;
    rdfs:domain ind:TransferCapability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:calculationEngine rdf:type rdf:Property ;
    rdfs:label 'Calculation Engine' ;
    rdfs:comment 'Identifier or name of the system or software engine that performed the ATC calculation (e.g., \'ABB EMS ATC Module\', \'GE EMS\', \'Internal ATC Engine v2.1\'). Supports auditability and traceability of calculation results to the source system.' ;
    rdfs:domain ind:TransferCapability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cbmMw rdf:type rdf:Property ;
    rdfs:label 'Cbm Mw' ;
    rdfs:comment 'Capacity Benefit Margin in megawatts (MW) — the amount of transmission transfer capability reserved by load-serving entities to ensure access to generation from interconnected systems to meet generation reliability requirements. Deducted from TTC in the ATC calculation per NERC MOD-030.' ;
    rdfs:domain ind:TransferCapability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contingencySet rdf:type rdf:Property ;
    rdfs:label 'Contingency Set' ;
    rdfs:comment 'Name or identifier of the contingency set (N-1, N-1-1, or N-2 criteria) applied during the ATC calculation to ensure reliability under credible outage scenarios. Reflects the reliability criteria used per NERC TPL standards.' ;
    rdfs:domain ind:TransferCapability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:direction rdf:type rdf:Property ;
    rdfs:label 'Direction' ;
    rdfs:comment 'Direction of power flow for which ATC is calculated on the path or flowgate. FORWARD indicates the defined positive flow direction; REVERSE indicates the opposite direction. Both directions must be posted per NERC MOD and FERC OATT requirements.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:existingCommitmentsMw rdf:type rdf:Property ;
    rdfs:label 'Existing Commitments Mw' ;
    rdfs:comment 'Total megawatts (MW) of transmission capacity already committed under existing confirmed transmission service agreements (firm and non-firm) at the time of this ATC calculation. Deducted from TTC along with TRM and CBM to derive ATC.' ;
    rdfs:domain ind:TransferCapability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:horizonEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Horizon End Timestamp' ;
    rdfs:comment 'End date and time of the study horizon period for which this ATC calculation is valid. Defines the closing boundary of the interval covered by this record.' ;
    rdfs:domain ind:TransferCapability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:horizonStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Horizon Start Timestamp' ;
    rdfs:comment 'Start date and time of the study horizon period for which this ATC calculation is valid. Represents the beginning of the interval (hourly, daily, weekly, or monthly) covered by this record. This is the principal BUSINESS_EVENT_TIMESTAMP for the ATC calculation.' ;
    rdfs:domain ind:TransferCapability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:isCoordinatedPath rdf:type rdf:Property ;
    rdfs:label 'Is Coordinated Path' ;
    rdfs:comment 'Indicates whether this transmission path requires coordinated ATC calculation with neighboring Transmission Providers or Balancing Authorities (True) or is calculated independently (False). Coordinated paths require inter-utility data exchange per NERC MOD-028.' ;
    rdfs:domain ind:TransferCapability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isFirmService rdf:type rdf:Property ;
    rdfs:label 'Is Firm Service' ;
    rdfs:comment 'Indicates whether the ATC calculation applies to firm transmission service (True) or non-firm transmission service (False). Firm service has higher priority and cannot be curtailed except under emergency conditions; non-firm service may be curtailed to accommodate firm service.' ;
    rdfs:domain ind:TransferCapability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:loopFlowAdjustmentMw rdf:type rdf:Property ;
    rdfs:label 'Loop Flow Adjustment Mw' ;
    rdfs:comment 'Adjustment in megawatts (MW) applied to the ATC calculation to account for unscheduled loop flows (parallel path flows) that reduce the effective transfer capability of the path. Loop flow adjustments are required when parallel paths carry unscheduled power flows that consume capacity.' ;
    rdfs:domain ind:TransferCapability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nercModMethodology rdf:type rdf:Property ;
    rdfs:label 'Nerc Mod Methodology' ;
    rdfs:comment 'The specific NERC MOD reliability standard methodology applied for this ATC calculation. MOD-028: Available Transfer Capability Methodology; MOD-029: Rated System Path Methodology; MOD-030: Flowgate Methodology. Identifies the approved calculation approach for regulatory audit purposes.' ;
    rdfs:domain ind:TransferCapability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:oasisPostingReference rdf:type rdf:Property ;
    rdfs:label 'Oasis Posting Reference' ;
    rdfs:comment 'Unique reference number or transaction identifier assigned by the OASIS portal for this ATC posting. Used to cross-reference the internal ATC record with the publicly posted OASIS entry for audit and regulatory compliance under 18 CFR §37.' ;
    rdfs:domain ind:TransferCapability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:oattTariffRateSchedule rdf:type rdf:Property ;
    rdfs:label 'Oatt Tariff Rate Schedule' ;
    rdfs:comment 'The FERC-approved OATT rate schedule under which this transmission path\'s ATC is calculated and posted (e.g., \'Schedule 1 - Network Integration\', \'Schedule 7 - Point-to-Point\'). Links the ATC record to the applicable tariff provisions.' ;
    rdfs:domain ind:TransferCapability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pathFlowgateCode rdf:type rdf:Property ;
    rdfs:label 'Path Flowgate Code' ;
    rdfs:comment 'Externally-known identifier for the transmission path or flowgate for which ATC is being calculated and posted. Corresponds to the path/flowgate designation used in OASIS postings and NERC MOD studies (e.g., \'PATH-NW-01\', \'FG-345-EAST\'). This is the BUSINESS_IDENTIFIER for the ATC record.' ;
    rdfs:domain ind:TransferCapability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pathFlowgateName rdf:type rdf:Property ;
    rdfs:label 'Path Flowgate Name' ;
    rdfs:comment 'Human-readable name or description of the transmission path or flowgate (e.g., \'Northwest Import Path\', \'Eastern 345kV Flowgate\'). Used for display in OASIS postings and regulatory reports.' ;
    rdfs:domain ind:TransferCapability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pendingCommitmentsMw rdf:type rdf:Property ;
    rdfs:label 'Pending Commitments Mw' ;
    rdfs:comment 'Total megawatts (MW) of transmission capacity reserved for pending (queued but not yet confirmed) transmission service requests at the time of this ATC calculation. Included in the ATC deduction per NERC MOD-028 to reflect capacity under evaluation.' ;
    rdfs:domain ind:TransferCapability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recalculationTrigger rdf:type rdf:Property ;
    rdfs:label 'Recalculation Trigger' ;
    rdfs:comment 'The event or condition that triggered this ATC recalculation. TOPOLOGY_CHANGE: network topology modification (line switching, outage); SCHEDULE_UPDATE: change in transmission schedules; TLR_EVENT: Transmission Loading Relief event; PERIODIC: routine scheduled recalculation; MANUAL: operator-initiated recalculation; OUTAGE_UPDATE: planned or forced outage affecting the path. [ENUM-REF-CANDIDATE: TOPOLOGY_CHANGE|SCHEDULE_UPDATE|TLR_EVENT|PERIODIC|MANUAL|OUTAGE_UPDATE — promote to reference product]' ;
    rdfs:domain ind:TransferCapability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stabilityLimitMw rdf:type rdf:Property ;
    rdfs:label 'Stability Limit Mw' ;
    rdfs:comment 'The transient or dynamic stability limit in megawatts (MW) for the transmission path, representing the maximum power transfer before loss of synchronism. May be the binding constraint on TTC when stability governs over thermal or voltage limits.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:studyAnalyst rdf:type rdf:Property ;
    rdfs:label 'Study Analyst' ;
    rdfs:comment 'Name or identifier of the transmission planning or operations analyst responsible for reviewing and approving this ATC calculation before OASIS posting. Supports accountability and audit trail for regulatory compliance.' ;
    rdfs:domain ind:TransferCapability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:studyHorizon rdf:type rdf:Property ;
    rdfs:label 'Study Horizon' ;
    rdfs:comment 'Time horizon for which the ATC calculation applies. Determines the granularity of the posting: HOURLY (real-time/intraday), DAILY (next-day), WEEKLY, or MONTHLY. Required for OASIS posting categorization under 18 CFR §37.' ;
    rdfs:domain ind:TransferCapability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thermalLimitMw rdf:type rdf:Property ;
    rdfs:label 'Thermal Limit Mw' ;
    rdfs:comment 'The thermal (current-carrying) rating limit in megawatts (MW) for the transmission path or flowgate, representing the maximum continuous power flow before equipment damage risk. Used as a constraint in TTC and ATC calculations.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:toArea rdf:type rdf:Property ;
    rdfs:label 'To Area' ;
    rdfs:comment 'Name or identifier of the receiving (sink) control area or Balancing Authority Area for the transmission path. Defines the destination end of the transfer path for directional ATC calculations and OASIS postings.' ;
    rdfs:domain ind:TransferCapability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transmissionProvider rdf:type rdf:Property ;
    rdfs:label 'Transmission Provider' ;
    rdfs:comment 'Name of the Transmission Provider (TP) responsible for calculating and posting this ATC value. Identifies the utility or entity with FERC OATT obligations for this path. This is the PARTY_REFERENCE for the ATC record (the responsible transmission owner/operator).' ;
    rdfs:domain ind:TransferCapability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trmMw rdf:type rdf:Property ;
    rdfs:label 'Trm Mw' ;
    rdfs:comment 'Transmission Reliability Margin in megawatts (MW) — the amount of transmission transfer capability reserved to ensure that the interconnected transmission network is secure under a reasonable range of uncertainties in system conditions. Deducted from TTC in the ATC calculation per NERC MOD-029.' ;
    rdfs:domain ind:TransferCapability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ttcMw rdf:type rdf:Property ;
    rdfs:label 'Ttc Mw' ;
    rdfs:comment 'Total Transfer Capability in megawatts (MW) — the maximum amount of electric power that can be transferred reliably over the interconnected transmission network in a reliable manner while meeting all applicable reliability criteria. Calculated per NERC MOD-028 methodology. TTC is the starting point for ATC derivation: ATC = TTC - TRM - CBM - existing commitments - pending commitments.' ;
    rdfs:domain ind:TransferCapability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:voltageLimitMw rdf:type rdf:Property ;
    rdfs:label 'Voltage Limit Mw' ;
    rdfs:comment 'The voltage stability limit in megawatts (MW) for the transmission path, representing the maximum power transfer before voltage collapse risk. May be the binding constraint on TTC when voltage stability governs over thermal limits.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:primaryBusId rdf:type rdf:Property ;
    rdfs:label 'Primary Bus Id' ;
    rdfs:comment 'Foreign key linking to transmission.bus. Business justification: Transformers connect to buses on the primary (high-voltage) side. This FK establishes the primary bus connection point, essential for power flow analysis and transformer topology modeling.' ;
    rdfs:domain ind:Transformer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Bus .

ind:coolingClass rdf:type rdf:Property ;
    rdfs:label 'Cooling Class' ;
    rdfs:comment 'IEEE/IEC cooling class designation indicating the cooling medium and circulation method (e.g., ONAN = Oil Natural Air Natural, ONAF = Oil Natural Air Forced, OFAF = Oil Forced Air Forced). Determines the MVA rating steps and informs maintenance procedures for cooling equipment.' ;
    rdfs:domain ind:Transformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dgaBaselineDate rdf:type rdf:Property ;
    rdfs:label 'Dga Baseline Date' ;
    rdfs:comment 'Date of the initial dissolved gas analysis (DGA) oil sample that established the baseline gas concentration profile for this transformer. Used as the reference point for trending fault gas evolution and detecting incipient faults per IEEE C57.104.' ;
    rdfs:domain ind:Transformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dgaConditionCode rdf:type rdf:Property ;
    rdfs:label 'Dga Condition Code' ;
    rdfs:comment 'Current DGA health condition code derived from the most recent oil sample analysis per IEEE C57.104 Duval Triangle or Rogers Ratio method. Drives maintenance prioritization and outage risk assessment. Updated each time a new DGA sample is analyzed.' ;
    rdfs:domain ind:Transformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gisLatitude rdf:type rdf:Property ;
    rdfs:label 'Gis Latitude' ;
    rdfs:comment 'WGS84 decimal-degree latitude coordinate of the transformer\'s physical installation location, sourced from ESRI ArcGIS. Used for outage management, emergency response routing, and transmission network topology mapping.' ;
    rdfs:domain ind:Transformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gisLongitude rdf:type rdf:Property ;
    rdfs:label 'Gis Longitude' ;
    rdfs:comment 'WGS84 decimal-degree longitude coordinate of the transformer\'s physical installation location, sourced from ESRI ArcGIS. Used in conjunction with gis_latitude for spatial analysis and GIS network modeling.' ;
    rdfs:domain ind:Transformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hvKvRating rdf:type rdf:Property ;
    rdfs:label 'Hv Kv Rating' ;
    rdfs:comment 'Nameplate rated voltage in kilovolts (kV) for the high-voltage winding. Determines the transmission voltage class (e.g., 345 kV, 500 kV, 765 kV) and is used in grid topology modeling and OATT filings.' ;
    rdfs:domain ind:Transformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:impedancePct rdf:type rdf:Property ;
    rdfs:label 'Impedance Pct' ;
    rdfs:comment 'Positive-sequence leakage impedance expressed as a percentage of the transformer\'s base MVA and kV ratings, as stated on the nameplate. Critical input for short-circuit fault current calculations, protection coordination, and power flow studies.' ;
    rdfs:domain ind:Transformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isBesAsset rdf:type rdf:Property ;
    rdfs:label 'Is Bes Asset' ;
    rdfs:comment 'Indicates whether this transformer is classified as a Bulk Electric System (BES) asset under NERC BES Definition. BES assets are subject to NERC reliability standards and FERC jurisdictional oversight. True = BES asset; False = non-BES (e.g., station service transformer).' ;
    rdfs:domain ind:Transformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lvKvRating rdf:type rdf:Property ;
    rdfs:label 'Lv Kv Rating' ;
    rdfs:comment 'Nameplate rated voltage in kilovolts (kV) for the low-voltage winding. Used in substation design, protection relay settings, and interconnection studies.' ;
    rdfs:domain ind:Transformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maximoAssetNum rdf:type rdf:Property ;
    rdfs:label 'Maximo Asset Num' ;
    rdfs:comment 'The externally-known asset number assigned by Oracle WAM or IBM Maximo — the operational system of record for this transformer. Used for cross-system reconciliation and work order linkage.' ;
    rdfs:domain ind:Transformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mvaRatingNameplate rdf:type rdf:Property ;
    rdfs:label 'Mva Rating Nameplate' ;
    rdfs:comment 'Manufacturer nameplate continuous MVA rating of the transformer at its base cooling class (e.g., ONAN). This is the principal quantitative capacity fact for the asset and is used in transmission planning, OATT capacity filings, and NERC reliability assessments.' ;
    rdfs:domain ind:Transformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mvaRatingUltimate rdf:type rdf:Property ;
    rdfs:label 'Mva Rating Ultimate' ;
    rdfs:comment 'Maximum MVA rating achievable at the highest cooling class (e.g., OFAF) as stated on the nameplate. Used in emergency loading assessments and contingency analysis to determine maximum permissible loading.' ;
    rdfs:domain ind:Transformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nercCipAssetClass rdf:type rdf:Property ;
    rdfs:label 'Nerc Cip Asset Class' ;
    rdfs:comment 'NERC CIP-002 impact classification for this transformer as a bulk electric system (BES) cyber asset or associated physical asset. Determines the applicable NERC CIP security controls, physical security perimeter requirements, and regulatory audit scope.' ;
    rdfs:domain ind:Transformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:numPhases rdf:type rdf:Property ;
    rdfs:label 'Num Phases' ;
    rdfs:comment 'Number of electrical phases (1 or 3) for this transformer unit. Bulk transmission transformers are typically three-phase; single-phase units may be used in spare bank configurations. Affects protection design and spare equipment strategy.' ;
    rdfs:domain ind:Transformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:oilType rdf:type rdf:Property ;
    rdfs:label 'Oil Type' ;
    rdfs:comment 'Type of dielectric insulating fluid used in the transformer tank. Mineral oil is conventional; FR3 natural ester is fire-resistant and biodegradable; silicone is used in fire-sensitive locations; askarel (PCB-based) is legacy and subject to EPA TSCA regulations. Drives environmental compliance and DGA interpretation.' ;
    rdfs:domain ind:Transformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:oilVolumeGallons rdf:type rdf:Property ;
    rdfs:label 'Oil Volume Gallons' ;
    rdfs:comment 'Total volume of insulating oil contained in the transformer tank, expressed in US gallons. Required for EPA Spill Prevention, Control, and Countermeasure (SPCC) plan compliance and environmental risk assessment.' ;
    rdfs:domain ind:Transformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tapChangerType rdf:type rdf:Property ;
    rdfs:label 'Tap Changer Type' ;
    rdfs:comment 'Type of voltage regulation mechanism: LTC (Load Tap Changer) allows on-load voltage adjustment; fixed tap has no regulation capability; DETC (De-Energized Tap Changer) requires de-energization for adjustment. Drives voltage control strategy and SCADA integration requirements.' ;
    rdfs:domain ind:Transformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tapPositionMax rdf:type rdf:Property ;
    rdfs:label 'Tap Position Max' ;
    rdfs:comment 'Maximum allowable tap position for the tap changer, defining the upper bound of the voltage regulation range. Used in voltage control studies and protection relay settings.' ;
    rdfs:domain ind:Transformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tapPositionMin rdf:type rdf:Property ;
    rdfs:label 'Tap Position Min' ;
    rdfs:comment 'Minimum allowable tap position for the tap changer, defining the lower bound of the voltage regulation range. Used in voltage control studies and protection relay settings.' ;
    rdfs:domain ind:Transformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tapPositionNominal rdf:type rdf:Property ;
    rdfs:label 'Tap Position Nominal' ;
    rdfs:comment 'The nominal (design) tap position number for the transformer\'s tap changer, as specified on the nameplate. Used as the baseline reference for voltage regulation studies and SCADA setpoint configuration.' ;
    rdfs:domain ind:Transformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:transformerName rdf:type rdf:Property ;
    rdfs:label 'Transformer Name' ;
    rdfs:comment 'Human-readable designation for the transformer, typically combining substation name and bank identifier (e.g., \'RIVERSIDE-T1\'). Used in operational displays, SCADA, and outage management systems.' ;
    rdfs:domain ind:Transformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tvKvRating rdf:type rdf:Property ;
    rdfs:label 'Tv Kv Rating' ;
    rdfs:comment 'Nameplate rated voltage in kilovolts (kV) for the tertiary winding, if present (three-winding transformer). Nullable for two-winding units. Used in reactive power compensation and station service supply modeling.' ;
    rdfs:domain ind:Transformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:weightLbs rdf:type rdf:Property ;
    rdfs:label 'Weight Lbs' ;
    rdfs:comment 'Total shipping/installed weight of the transformer in pounds, including oil. Critical for transportation logistics planning, foundation structural design, and spare transformer procurement and mobilization planning.' ;
    rdfs:domain ind:Transformer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:operatorId rdf:type rdf:Property ;
    rdfs:label 'Operator Id' ;
    rdfs:comment 'FK to transmission.operator' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Operator .

ind:besFlag rdf:type rdf:Property ;
    rdfs:label 'Bes Flag' ;
    rdfs:comment 'Indicates whether this substation is classified as part of the Bulk Electric System (BES) per the NERC BES definition. BES classification triggers NERC reliability standard applicability including CIP, FAC, TPL, and PRC standards.' ;
    rdfs:domain ind:TransmissionSubstation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:busConfiguration rdf:type rdf:Property ;
    rdfs:label 'Bus Configuration' ;
    rdfs:comment 'Electrical bus arrangement scheme of the substation switchyard. Determines switching flexibility, reliability, and maintenance capability. Used in protection coordination studies and reliability modeling. [ENUM-REF-CANDIDATE: single_bus|double_bus|ring_bus|breaker_and_half|main_and_transfer|double_bus_double_breaker — promote to reference product]' ;
    rdfs:domain ind:TransmissionSubstation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:communicationsType rdf:type rdf:Property ;
    rdfs:label 'Communications Type' ;
    rdfs:comment 'Primary telecommunications medium used for SCADA telemetry and protection signaling at this substation. Relevant for NERC CIP-005 Electronic Security Perimeter and CIP-006 Physical Security compliance assessments.' ;
    rdfs:domain ind:TransmissionSubstation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:elevationM rdf:type rdf:Property ;
    rdfs:label 'Elevation M' ;
    rdfs:comment 'Elevation of the substation site above mean sea level in meters. Used for equipment insulation coordination (altitude derating), flood risk assessment, and GIS spatial modeling.' ;
    rdfs:domain ind:TransmissionSubstation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:emsNodeReference rdf:type rdf:Property ;
    rdfs:label 'Ems Node Reference' ;
    rdfs:comment 'Node or bus identifier within the ABB or GE Energy Management System (EMS) network topology model corresponding to this substation. Used for state estimation, contingency analysis, and generation dispatch coordination.' ;
    rdfs:domain ind:TransmissionSubstation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fercJurisdictionFlag rdf:type rdf:Property ;
    rdfs:label 'Ferc Jurisdiction Flag' ;
    rdfs:comment 'Indicates whether this substation is subject to FERC jurisdictional oversight under the Federal Power Act (FPA). True for interstate transmission facilities; False for state-jurisdictional or non-jurisdictional assets. Drives FERC Form 1 inclusion and OATT applicability.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:landOwnershipType rdf:type rdf:Property ;
    rdfs:label 'Land Ownership Type' ;
    rdfs:comment 'Classification of the land tenure arrangement for the substation site. Affects property accounting treatment under GAAP, FERC Uniform System of Accounts land account classification, and site access rights for maintenance.' ;
    rdfs:domain ind:TransmissionSubstation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nercNodeCode rdf:type rdf:Property ;
    rdfs:label 'Nerc Node Code' ;
    rdfs:comment 'NERC-assigned unique node identifier for this substation within the bulk electric system (BES) topology model. Used for NERC compliance reporting, reliability assessments, and RTO/ISO power flow models.' ;
    rdfs:domain ind:TransmissionSubstation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:numTransformerBanks rdf:type rdf:Property ;
    rdfs:label 'Num Transformer Banks' ;
    rdfs:comment 'Count of transformer banks installed at the substation. Used for capacity planning, N-1 contingency analysis, and maintenance scheduling in Oracle WAM/IBM Maximo.' ;
    rdfs:domain ind:TransmissionSubstation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:numTransmissionLines rdf:type rdf:Property ;
    rdfs:label 'Num Transmission Lines' ;
    rdfs:comment 'Count of transmission line circuits terminating at this substation. Indicates the substation\'s connectivity degree in the network topology. Used for contingency analysis and switching studies.' ;
    rdfs:domain ind:TransmissionSubstation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ownerName rdf:type rdf:Property ;
    rdfs:label 'Owner Name' ;
    rdfs:comment 'Legal name of the entity that owns the substation assets. May differ from the operating entity in jointly-owned or leased facilities. Required for FERC Form 1 plant ownership reporting and CIAC accounting.' ;
    rdfs:domain ind:TransmissionSubstation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:physicalAddress rdf:type rdf:Property ;
    rdfs:label 'Physical Address' ;
    rdfs:comment 'Street address or location description of the substation site. Used for emergency response, field crew dispatch, permitting, and property tax records. Classified as confidential due to critical infrastructure location sensitivity.' ;
    rdfs:domain ind:TransmissionSubstation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transmissionZone rdf:type rdf:Property ;
    rdfs:label 'Transmission Zone' ;
    rdfs:comment 'Tariff or rate zone designation within the utility\'s transmission system or RTO/ISO footprint. Used for OATT transmission service rate calculation, congestion revenue rights (CRR) allocation, and zonal LMP settlement.' ;
    rdfs:domain ind:TransmissionSubstation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:voltageHighKv rdf:type rdf:Property ;
    rdfs:label 'Voltage High Kv' ;
    rdfs:comment 'Nominal high-side (primary) voltage level of the substation in kilovolts (kV). Represents the incoming bulk transmission voltage. Critical for BES classification, NERC CIP applicability determination, and OATT tariff rate zone assignment.' ;
    rdfs:domain ind:TransmissionSubstation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:voltageLowKv rdf:type rdf:Property ;
    rdfs:label 'Voltage Low Kv' ;
    rdfs:comment 'Nominal low-side (secondary) voltage level of the substation in kilovolts (kV). Represents the outgoing sub-transmission or distribution voltage after transformation. Used in network topology modeling and load flow analysis.' ;
    rdfs:domain ind:TransmissionSubstation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:derDispatchId rdf:type rdf:Property ;
    rdfs:label 'Der Dispatch Id' ;
    rdfs:comment 'Unique surrogate identifier for each DER dispatch record. Primary key for the association.' ;
    rdfs:domain ind:DerDispatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:baselineKw rdf:type rdf:Property ;
    rdfs:label 'Baseline Kw' ;
    rdfs:comment 'Calculated baseline load for this specific DER asset during the demand response event window, representing expected load absent the DR event. Used to calculate actual load reduction achieved. Explicitly identified in detection phase relationship data.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dispatchInstruction rdf:type rdf:Property ;
    rdfs:label 'Dispatch Instruction' ;
    rdfs:comment 'Operational instruction sent to this DER asset for this event (e.g., curtail to 50% capacity, discharge battery at 5kW, disable EV charging). Captures asset-specific dispatch commands from DERMS.' ;
    rdfs:domain ind:DerDispatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispatchTimestamp rdf:type rdf:Property ;
    rdfs:label 'Dispatch Timestamp' ;
    rdfs:comment 'Date and time when the dispatch instruction was sent to this specific DER asset for this demand response event. May differ from event start time due to staggered dispatch or asset-specific lead times. Explicitly identified in detection phase relationship data.' ;
    rdfs:domain ind:DerDispatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:incentiveEarned rdf:type rdf:Property ;
    rdfs:label 'Incentive Earned' ;
    rdfs:comment 'Financial incentive amount in US dollars earned by this DER asset for participation in this specific demand response event. Calculated based on response_kw, compliance_flag, and program tariff rates. Used for DR program settlement. Explicitly identified in detection phase relationship data.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:optOutFlag rdf:type rdf:Property ;
    rdfs:label 'Opt Out Flag' ;
    rdfs:comment 'Boolean indicator of whether the customer or DER asset operator exercised an opt-out right for this specific demand response event. Affects compliance assessment and incentive calculation. Explicitly identified in detection phase relationship data.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:participationStatus rdf:type rdf:Property ;
    rdfs:label 'Participation Status' ;
    rdfs:comment 'Current status of this DER asset\'s participation in the demand response event. Tracks lifecycle from dispatch through completion and compliance assessment. Explicitly identified in detection phase relationship data.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Response Duration Minutes' ;
    rdfs:comment 'Actual duration in minutes that this DER asset actively responded to the demand response event. May differ from overall event duration if the asset was dispatched late, released early, or experienced operational issues. Explicitly identified in detection phase relationship data.' ;
    rdfs:domain ind:DerDispatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:responseKw rdf:type rdf:Property ;
    rdfs:label 'Response Kw' ;
    rdfs:comment 'Actual load reduction or curtailment capacity delivered by this DER asset during the demand response event, measured in kilowatts. This is the measured performance specific to this DER-event combination. Explicitly identified in detection phase relationship data.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:servicePointDrParticipationId rdf:type rdf:Property ;
    rdfs:label 'Service Point Dr Participation Id' ;
    rdfs:comment 'Unique surrogate identifier for this service point demand response participation record. Primary key for the association.' ;
    rdfs:domain ind:ServicePointDrParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actualLoadKw rdf:type rdf:Property ;
    rdfs:label 'Actual Load Kw' ;
    rdfs:comment 'Measured actual load in kilowatts consumed by this service point during the DR event window. Used with baseline_kw to calculate response_kw.' ;
    rdfs:domain ind:ServicePointDrParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:curtailmentPercentage rdf:type rdf:Property ;
    rdfs:label 'Curtailment Percentage' ;
    rdfs:comment 'Percentage of baseline load curtailed by this service point, calculated as (response_kw / baseline_kw) * 100. Performance metric for program evaluation.' ;
    rdfs:domain ind:ServicePointDrParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:notificationSentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Notification Sent Timestamp' ;
    rdfs:comment 'Date and time when the DR event notification was sent to this specific service point (customer). Used to calculate lead time and validate compliance with notification requirements. Sourced from detection phase relationship_data.' ;
    rdfs:domain ind:ServicePointDrParticipation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:authorizedAssetClasses rdf:type rdf:Property ;
    rdfs:label 'Authorized Asset Classes' ;
    rdfs:comment 'Comma-separated list of asset class codes that the inspector is certified and authorized to inspect based on training and certification.' ;
    rdfs:domain ind:Inspector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:backgroundCheckDate rdf:type rdf:Property ;
    rdfs:label 'Background Check Date' ;
    rdfs:comment 'Date when the most recent background check was completed for the inspector, required for access to critical infrastructure.' ;
    rdfs:domain ind:Inspector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:certificationLevel rdf:type rdf:Property ;
    rdfs:label 'Certification Level' ;
    rdfs:comment 'Qualification level of the inspector indicating scope of inspection authority and asset complexity they are authorized to inspect.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emergencyContactName rdf:type rdf:Property ;
    rdfs:label 'Emergency Contact Name' ;
    rdfs:comment 'Name of the emergency contact person for the inspector in case of workplace incidents or accidents.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emergencyContactPhone rdf:type rdf:Property ;
    rdfs:label 'Emergency Contact Phone' ;
    rdfs:comment 'Phone number of the emergency contact person for the inspector.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographicTerritory rdf:type rdf:Property ;
    rdfs:label 'Geographic Territory' ;
    rdfs:comment 'Geographic service territory or region assigned to the inspector for inspection coverage (e.g., district codes, county names, or service area identifiers).' ;
    rdfs:domain ind:Inspector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hireDate rdf:type rdf:Property ;
    rdfs:label 'Hire Date' ;
    rdfs:comment 'Date when the inspector was hired or contracted by the utility company.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:homeLocationCode rdf:type rdf:Property ;
    rdfs:label 'Home Location Code' ;
    rdfs:comment 'Code identifying the primary work location or service center where the inspector is based for dispatch and assignment purposes.' ;
    rdfs:domain ind:Inspector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionCount rdf:type rdf:Property ;
    rdfs:label 'Inspection Count' ;
    rdfs:comment 'Cumulative number of inspections completed by this inspector across all asset types and inspection programs.' ;
    rdfs:domain ind:Inspector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:inspectorNumber rdf:type rdf:Property ;
    rdfs:label 'Inspector Number' ;
    rdfs:comment 'Business identifier assigned to the inspector for external reference and reporting. Typically follows utility-specific numbering convention.' ;
    rdfs:domain ind:Inspector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectorType rdf:type rdf:Property ;
    rdfs:label 'Inspector Type' ;
    rdfs:comment 'Classification of the inspector based on employment relationship. Internal inspectors are utility employees, contractors are external resources, third-party are independent auditors, and regulatory are government agency inspectors.' ;
    rdfs:domain ind:Inspector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseExpirationDate rdf:type rdf:Property ;
    rdfs:label 'License Expiration Date' ;
    rdfs:comment 'Date when the inspector\'s license expires and requires renewal to continue performing inspections.' ;
    rdfs:domain ind:Inspector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:licenseNumber rdf:type rdf:Property ;
    rdfs:label 'License Number' ;
    rdfs:comment 'State or regulatory body issued license number authorizing the inspector to perform inspections on utility assets.' ;
    rdfs:domain ind:Inspector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:middleInitial rdf:type rdf:Property ;
    rdfs:label 'Middle Initial' ;
    rdfs:comment 'Middle initial of the inspector, if applicable.' ;
    rdfs:domain ind:Inspector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mobileDeviceCode rdf:type rdf:Property ;
    rdfs:label 'Mobile Device Code' ;
    rdfs:comment 'Identifier of the mobile device or tablet assigned to the inspector for field data collection and work order management.' ;
    rdfs:domain ind:Inspector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nercClearanceLevel rdf:type rdf:Property ;
    rdfs:label 'Nerc Clearance Level' ;
    rdfs:comment 'Security clearance level for the inspector to access critical cyber and physical assets under NERC Critical Infrastructure Protection standards.' ;
    rdfs:domain ind:Inspector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualityRating rdf:type rdf:Property ;
    rdfs:label 'Quality Rating' ;
    rdfs:comment 'Performance quality score for the inspector based on inspection accuracy, completeness, and audit results. Scale of 0.00 to 5.00.' ;
    rdfs:domain ind:Inspector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:safetyCertificationDate rdf:type rdf:Property ;
    rdfs:label 'Safety Certification Date' ;
    rdfs:comment 'Date when the inspector last completed required safety training and certification for working on energized equipment and in hazardous environments.' ;
    rdfs:domain ind:Inspector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:specialization rdf:type rdf:Property ;
    rdfs:label 'Specialization' ;
    rdfs:comment 'Primary area of technical expertise for the inspector (e.g., transmission lines, substations, transformers, gas pipelines, distribution equipment, generation facilities). [ENUM-REF-CANDIDATE: transmission_lines|substations|transformers|gas_pipelines|distribution_equipment|generation_facilities|metering|protection_systems — promote to reference product]' ;
    rdfs:domain ind:Inspector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:status rdf:type rdf:Property ;
    rdfs:label 'Status' ;
    rdfs:comment 'Current operational status of the inspector indicating availability for inspection assignments.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unionMembershipFlag rdf:type rdf:Property ;
    rdfs:label 'Union Membership Flag' ;
    rdfs:comment 'Indicates whether the inspector is a member of a labor union. True if union member, False otherwise.' ;
    rdfs:domain ind:Inspector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:yearsOfExperience rdf:type rdf:Property ;
    rdfs:label 'Years Of Experience' ;
    rdfs:comment 'Total number of years the inspector has been performing asset inspections in the utility industry.' ;
    rdfs:domain ind:Inspector ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supervisorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Supervisor Employee Id' ;
    rdfs:comment 'FK to workforce.employee' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:activeFromDate rdf:type rdf:Property ;
    rdfs:label 'Active From Date' ;
    rdfs:comment 'Date when this inspection crew was established and became available for work assignment.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:activeUntilDate rdf:type rdf:Property ;
    rdfs:label 'Active Until Date' ;
    rdfs:comment 'Date when this inspection crew was or will be deactivated or disbanded. Null for currently active crews with no planned end date.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:averageInspectionCapacityPerDay rdf:type rdf:Property ;
    rdfs:label 'Average Inspection Capacity Per Day' ;
    rdfs:comment 'Average number of asset inspections this crew can complete per working day, used for work order planning and resource allocation.' ;
    rdfs:domain ind:InspectionCrew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contractorCompanyName rdf:type rdf:Property ;
    rdfs:label 'Contractor Company Name' ;
    rdfs:comment 'Name of the contracting company providing this inspection crew, applicable only when contractor_flag is True.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractorFlag rdf:type rdf:Property ;
    rdfs:label 'Contractor Flag' ;
    rdfs:comment 'Indicates whether this inspection crew is composed of contractor personnel (True) or internal utility employees (False).' ;
    rdfs:domain ind:InspectionCrew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:crewCode rdf:type rdf:Property ;
    rdfs:label 'Crew Code' ;
    rdfs:comment 'Externally-known unique alphanumeric code assigned to the inspection crew for identification in work orders, scheduling systems, and field operations.' ;
    rdfs:domain ind:InspectionCrew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crewName rdf:type rdf:Property ;
    rdfs:label 'Crew Name' ;
    rdfs:comment 'Human-readable name or designation of the inspection crew, typically including geographic area or specialization (e.g., \'North Region T&D Inspection Team\').' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crewSize rdf:type rdf:Property ;
    rdfs:label 'Crew Size' ;
    rdfs:comment 'Number of personnel assigned to this inspection crew, representing the team\'s capacity for field inspection work.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:crewStatus rdf:type rdf:Property ;
    rdfs:label 'Crew Status' ;
    rdfs:comment 'Current operational status of the inspection crew indicating availability for assignment to inspection work orders.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crewType rdf:type rdf:Property ;
    rdfs:label 'Crew Type' ;
    rdfs:comment 'Classification of the inspection crew based on the asset infrastructure type they specialize in inspecting.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emergencyResponseQualified rdf:type rdf:Property ;
    rdfs:label 'Emergency Response Qualified' ;
    rdfs:comment 'Indicates whether this inspection crew is qualified and available for emergency response and storm restoration inspection work.' ;
    rdfs:domain ind:InspectionCrew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:equipmentAssigned rdf:type rdf:Property ;
    rdfs:label 'Equipment Assigned' ;
    rdfs:comment 'List of specialized inspection equipment and tools assigned to this crew (e.g., thermal cameras, ultrasonic detectors, climbing gear).' ;
    rdfs:domain ind:InspectionCrew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gisMobileDeviceIds rdf:type rdf:Property ;
    rdfs:label 'Gis Mobile Device Ids' ;
    rdfs:comment 'Comma-separated list of GIS-enabled mobile device identifiers assigned to this crew for field data collection and asset location verification.' ;
    rdfs:domain ind:InspectionCrew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hourlyLaborRate rdf:type rdf:Property ;
    rdfs:label 'Hourly Labor Rate' ;
    rdfs:comment 'Standard hourly labor rate for this inspection crew, used for work order costing and budget planning. Expressed in local currency.' ;
    rdfs:domain ind:InspectionCrew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastPerformanceReviewDate rdf:type rdf:Property ;
    rdfs:label 'Last Performance Review Date' ;
    rdfs:comment 'Date of the most recent formal performance review conducted for this inspection crew.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastSafetyTrainingDate rdf:type rdf:Property ;
    rdfs:label 'Last Safety Training Date' ;
    rdfs:comment 'Date when the inspection crew last completed mandatory safety training, used to ensure compliance with safety certification requirements.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextCertificationRenewalDate rdf:type rdf:Property ;
    rdfs:label 'Next Certification Renewal Date' ;
    rdfs:comment 'Scheduled date for the crew\'s next certification renewal or recertification assessment, ensuring continued qualification for inspection work.' ;
    rdfs:domain ind:InspectionCrew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:operatingRegion rdf:type rdf:Property ;
    rdfs:label 'Operating Region' ;
    rdfs:comment 'Geographic region or service territory where the inspection crew primarily operates, used for work assignment and resource planning.' ;
    rdfs:domain ind:InspectionCrew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performanceRating rdf:type rdf:Property ;
    rdfs:label 'Performance Rating' ;
    rdfs:comment 'Most recent performance evaluation rating for this inspection crew based on inspection quality, timeliness, and safety metrics.' ;
    rdfs:domain ind:InspectionCrew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:safetyIncidentCount rdf:type rdf:Property ;
    rdfs:label 'Safety Incident Count' ;
    rdfs:comment 'Cumulative count of reportable safety incidents involving this inspection crew, tracked for safety performance monitoring.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:shiftSchedule rdf:type rdf:Property ;
    rdfs:label 'Shift Schedule' ;
    rdfs:comment 'Standard work shift pattern for this inspection crew, determining availability windows for work order assignment.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specializationTags rdf:type rdf:Property ;
    rdfs:label 'Specialization Tags' ;
    rdfs:comment 'Comma-separated list of specialized inspection capabilities or equipment expertise (e.g., \'infrared thermography, drone inspection, high voltage\').' ;
    rdfs:domain ind:InspectionCrew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unionAffiliation rdf:type rdf:Property ;
    rdfs:label 'Union Affiliation' ;
    rdfs:comment 'Labor union or collective bargaining unit to which the inspection crew members belong, relevant for scheduling and labor relations.' ;
    rdfs:domain ind:InspectionCrew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vehicleFleetIds rdf:type rdf:Property ;
    rdfs:label 'Vehicle Fleet Ids' ;
    rdfs:comment 'Comma-separated list of vehicle identifiers assigned to this inspection crew for field mobility and equipment transport.' ;
    rdfs:domain ind:InspectionCrew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workOrderSystemUserGroup rdf:type rdf:Property ;
    rdfs:label 'Work Order System User Group' ;
    rdfs:comment 'User group or role identifier in the EAM work order system (Oracle WAM/IBM Maximo) that this crew is assigned to for work visibility and assignment.' ;
    rdfs:domain ind:InspectionCrew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectionsActionId rdf:type rdf:Property ;
    rdfs:label 'Collections Action Id' ;
    rdfs:comment 'Primary key for collections_action' ;
    rdfs:domain ind:CollectionsAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actionCategory rdf:type rdf:Property ;
    rdfs:label 'Action Category' ;
    rdfs:comment 'High-level classification of the collections action type. Notification includes letters and notices; contact_attempt includes calls and visits; payment_arrangement includes plans and extensions; legal_action includes liens and judgments; service_action includes disconnection and reconnection; account_adjustment includes write-offs and settlements; escalation includes agency referrals; resolution includes payment received and account closure.' ;
    rdfs:domain ind:CollectionsAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionCode rdf:type rdf:Property ;
    rdfs:label 'Action Code' ;
    rdfs:comment 'Standardized code representing the type of collections action (e.g., NOTICE_1, CALL_ATTEMPT, PAYMENT_PLAN, DISCONNECT_WARN, SERVICE_SUSPEND). Used as a business identifier for integration with Customer Information System (CIS) and billing workflows.' ;
    rdfs:domain ind:CollectionsAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionName rdf:type rdf:Property ;
    rdfs:label 'Action Name' ;
    rdfs:comment 'Human-readable name of the collections action (e.g., First Delinquency Notice, Payment Arrangement Offer, Service Disconnection Warning, Final Notice Before Shutoff).' ;
    rdfs:domain ind:CollectionsAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionSequence rdf:type rdf:Property ;
    rdfs:label 'Action Sequence' ;
    rdfs:comment 'Numeric ordering of this action within a standard collections workflow. Lower numbers represent earlier actions in the escalation path (e.g., 1 for first notice, 5 for final notice, 10 for disconnection).' ;
    rdfs:domain ind:CollectionsAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:applicableCustomerClass rdf:type rdf:Property ;
    rdfs:label 'Applicable Customer Class' ;
    rdfs:comment 'Customer segment(s) to which this collections action applies. Residential for household customers; commercial for small/medium business; industrial for large commercial and manufacturing; all for universal actions. Different customer classes may have different regulatory protections and collections workflows.' ;
    rdfs:domain ind:CollectionsAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autoTriggerEnabled rdf:type rdf:Property ;
    rdfs:label 'Auto Trigger Enabled' ;
    rdfs:comment 'Indicates whether this collections action can be automatically triggered by the billing or collections system based on predefined rules (e.g., days past due, balance threshold). True for system-automated actions; false for manual-only actions requiring human review.' ;
    rdfs:domain ind:CollectionsAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:autoTriggerRule rdf:type rdf:Property ;
    rdfs:label 'Auto Trigger Rule' ;
    rdfs:comment 'Business rule or condition that automatically triggers this collections action. Examples: \'Balance > $100 AND Days Past Due >= 30\', \'Second missed payment on payment plan\', \'No response to prior notice within 15 days\'. Null if action is manual-only.' ;
    rdfs:domain ind:CollectionsAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costAmount rdf:type rdf:Property ;
    rdfs:label 'Cost Amount' ;
    rdfs:comment 'Standard cost or fee associated with executing this collections action, charged to the customer account. Includes costs such as certified mail fees, field visit charges, reconnection fees, or collection agency commissions. Null if no cost is assessed.' ;
    rdfs:domain ind:CollectionsAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costRecoverable rdf:type rdf:Property ;
    rdfs:label 'Cost Recoverable' ;
    rdfs:comment 'Indicates whether the cost of this collections action can be billed to and recovered from the customer account. True if cost is customer-billable; false if cost is absorbed by the utility as a business expense.' ;
    rdfs:domain ind:CollectionsAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:creditReportingImpact rdf:type rdf:Property ;
    rdfs:label 'Credit Reporting Impact' ;
    rdfs:comment 'Indicates the impact of this collections action on customer credit bureau reporting. None for actions with no credit impact; negative_report for delinquency or charge-off reporting; positive_report for successful payment plan completion; dispute_flag for contested accounts.' ;
    rdfs:domain ind:CollectionsAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:description rdf:type rdf:Property ;
    rdfs:label 'Description' ;
    rdfs:comment 'Detailed business description of the collections action, including purpose, typical use cases, and any special handling instructions. Provides context for collections staff and system administrators.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disputeEligible rdf:type rdf:Property ;
    rdfs:label 'Dispute Eligible' ;
    rdfs:comment 'Indicates whether the customer has the right to dispute or appeal this collections action. True for actions subject to customer dispute rights; false for non-disputable administrative actions.' ;
    rdfs:domain ind:CollectionsAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:legalActionIndicator rdf:type rdf:Property ;
    rdfs:label 'Legal Action Indicator' ;
    rdfs:comment 'Indicates whether this collections action involves or initiates legal proceedings (e.g., filing a lien, initiating small claims, referring to attorney). True for legal actions; false for operational collections activities.' ;
    rdfs:domain ind:CollectionsAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minimumNoticeDays rdf:type rdf:Property ;
    rdfs:label 'Minimum Notice Days' ;
    rdfs:comment 'Minimum number of days required by regulation between this action and any subsequent service disconnection or legal action. Null if no regulatory minimum applies. Varies by jurisdiction and customer class (residential vs. commercial).' ;
    rdfs:domain ind:CollectionsAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:paymentPlanEligible rdf:type rdf:Property ;
    rdfs:label 'Payment Plan Eligible' ;
    rdfs:comment 'Indicates whether customers receiving this collections action are eligible to enter into a payment arrangement or installment plan to avoid further escalation. True if payment plan option is available; false if account is past payment plan eligibility.' ;
    rdfs:domain ind:CollectionsAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:protectedCustomerExempt rdf:type rdf:Property ;
    rdfs:label 'Protected Customer Exempt' ;
    rdfs:comment 'Indicates whether this collections action is prohibited for protected customer categories (e.g., medical necessity customers, low-income assistance participants, elderly or disabled customers with special protections). True if action cannot be applied to protected customers; false if action is universally applicable.' ;
    rdfs:domain ind:CollectionsAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryNoticeRequired rdf:type rdf:Property ;
    rdfs:label 'Regulatory Notice Required' ;
    rdfs:comment 'Indicates whether this collections action must comply with state or federal regulatory notice requirements (e.g., minimum notice periods before disconnection, specific language mandates, customer rights disclosures). True for actions subject to Public Utility Commission (PUC) or Federal Energy Regulatory Commission (FERC) rules.' ;
    rdfs:domain ind:CollectionsAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryReference rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reference' ;
    rdfs:comment 'Citation of the specific state Public Utility Commission (PUC) rule, tariff section, or federal regulation that governs this collections action. Examples: \'PUC Rule 25.483\', \'Tariff Section 6.2.1\', \'FERC Order 2222\'. Null if no specific regulatory mandate applies.' ;
    rdfs:domain ind:CollectionsAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresCustomerResponse rdf:type rdf:Property ;
    rdfs:label 'Requires Customer Response' ;
    rdfs:comment 'Indicates whether this collections action requires an explicit response or action from the customer (e.g., payment, contact, dispute filing). True for actions requiring customer engagement; false for informational or system-driven actions.' ;
    rdfs:domain ind:CollectionsAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresSupervisorApproval rdf:type rdf:Property ;
    rdfs:label 'Requires Supervisor Approval' ;
    rdfs:comment 'Indicates whether this collections action requires managerial or supervisory approval before execution. True for high-impact actions such as disconnection, legal referral, or large write-offs; false for routine automated actions.' ;
    rdfs:domain ind:CollectionsAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:responseDueDays rdf:type rdf:Property ;
    rdfs:label 'Response Due Days' ;
    rdfs:comment 'Number of days from action delivery date by which the customer must respond or take action. Null if no response deadline applies. Used to calculate follow-up action triggers and compliance with regulatory notice periods.' ;
    rdfs:domain ind:CollectionsAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:seasonalRestrictionApplies rdf:type rdf:Property ;
    rdfs:label 'Seasonal Restriction Applies' ;
    rdfs:comment 'Indicates whether this collections action is subject to seasonal restrictions (e.g., winter moratorium on disconnections, extreme weather protections). True if action is restricted during certain months or weather conditions; false if action can be taken year-round.' ;
    rdfs:domain ind:CollectionsAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:serviceActionType rdf:type rdf:Property ;
    rdfs:label 'Service Action Type' ;
    rdfs:comment 'Specifies the type of field service action triggered by this collections action. Disconnect for service termination; reconnect for service restoration; meter_lock for physical access prevention; meter_removal for complete meter extraction; limiter_install for reduced service capacity; none if no service action is triggered.' ;
    rdfs:domain ind:CollectionsAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:severityLevel rdf:type rdf:Property ;
    rdfs:label 'Severity Level' ;
    rdfs:comment 'Indicates the urgency and escalation level of the collections action. Informational for early reminders; low for initial notices; medium for follow-up actions; high for pre-disconnection warnings; critical for imminent service termination; final for last action before legal or agency referral.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:templateDocumentCode rdf:type rdf:Property ;
    rdfs:label 'Template Document Code' ;
    rdfs:comment 'Reference identifier for the standard letter, notice, or script template used for this collections action. Links to document management system for content retrieval and version control. Null if no template is used (e.g., for system-automated actions).' ;
    rdfs:domain ind:CollectionsAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thirdPartyAgencyEligible rdf:type rdf:Property ;
    rdfs:label 'Third Party Agency Eligible' ;
    rdfs:comment 'Indicates whether accounts subject to this collections action are eligible for referral to external collection agencies. True if action can trigger agency placement; false if action must remain internal.' ;
    rdfs:domain ind:CollectionsAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:triggersServiceAction rdf:type rdf:Property ;
    rdfs:label 'Triggers Service Action' ;
    rdfs:comment 'Indicates whether this collections action directly triggers a field service action such as disconnection, reconnection, or meter lock. True for actions that initiate service orders; false for administrative or notification-only actions.' ;
    rdfs:domain ind:CollectionsAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:busId rdf:type rdf:Property ;
    rdfs:label 'Bus Id' ;
    rdfs:comment 'Primary key for bus' ;
    rdfs:domain ind:Bus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:substationId rdf:type rdf:Property ;
    rdfs:label 'Substation Id' ;
    rdfs:comment 'Reference to the substation where this bus is physically located. Links bus to its parent substation facility for asset management and outage coordination.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:UtilityCompany .

ind:activePowerMw rdf:type rdf:Property ;
    rdfs:label 'Active Power Mw' ;
    rdfs:comment 'Net active power injection or withdrawal at the bus in megawatts. Positive values indicate generation; negative values indicate load consumption.' ;
    rdfs:domain ind:Bus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:baseVoltageKv rdf:type rdf:Property ;
    rdfs:label 'Base Voltage Kv' ;
    rdfs:comment 'Base voltage used for per-unit calculations in power flow and short circuit analysis. Typically matches the nominal voltage level but may differ for analytical purposes.' ;
    rdfs:domain ind:Bus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:busName rdf:type rdf:Property ;
    rdfs:label 'Bus Name' ;
    rdfs:comment 'Human-readable name or designation of the bus, typically reflecting its location, substation, or functional role in the distribution network.' ;
    rdfs:domain ind:Bus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:busType rdf:type rdf:Property ;
    rdfs:label 'Bus Type' ;
    rdfs:comment 'Classification of the bus based on its electrical function in the power system. Slack bus maintains system voltage and frequency reference; generator bus has active power generation; load bus serves consumption; isolated bus is disconnected.' ;
    rdfs:domain ind:Bus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:energizedFlag rdf:type rdf:Property ;
    rdfs:label 'Energized Flag' ;
    rdfs:comment 'Indicates whether the bus is currently energized with voltage. True means the bus has voltage applied; false means it is de-energized for maintenance or due to outage.' ;
    rdfs:domain ind:Bus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:groundingType rdf:type rdf:Property ;
    rdfs:label 'Grounding Type' ;
    rdfs:comment 'Method of neutral grounding at the bus. Critical for fault current calculations, protective relay coordination, and personnel safety.' ;
    rdfs:domain ind:Bus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loadServingFlag rdf:type rdf:Property ;
    rdfs:label 'Load Serving Flag' ;
    rdfs:comment 'Indicates whether this bus directly serves customer load. True for buses with connected customers; false for transmission or interconnection buses.' ;
    rdfs:domain ind:Bus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maxVoltageLimitPu rdf:type rdf:Property ;
    rdfs:label 'Max Voltage Limit Pu' ;
    rdfs:comment 'Upper voltage limit for the bus in per-unit. Violations trigger voltage regulation actions or alarms in distribution management systems.' ;
    rdfs:domain ind:Bus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minVoltageLimitPu rdf:type rdf:Property ;
    rdfs:label 'Min Voltage Limit Pu' ;
    rdfs:comment 'Lower voltage limit for the bus in per-unit. Violations trigger voltage regulation actions or alarms in distribution management systems.' ;
    rdfs:domain ind:Bus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:shortCircuitMva rdf:type rdf:Property ;
    rdfs:label 'Short Circuit Mva' ;
    rdfs:comment 'Three-phase short circuit capacity at the bus in megavolt-amperes. Critical for protective device coordination, equipment ratings, and safety analysis.' ;
    rdfs:domain ind:Bus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:voltageAngleDegrees rdf:type rdf:Property ;
    rdfs:label 'Voltage Angle Degrees' ;
    rdfs:comment 'Phase angle of the bus voltage relative to the system reference bus, expressed in degrees. Critical for power flow calculations and system stability analysis.' ;
    rdfs:domain ind:Bus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:voltageMagnitudePu rdf:type rdf:Property ;
    rdfs:label 'Voltage Magnitude Pu' ;
    rdfs:comment 'Current voltage magnitude at the bus expressed in per-unit of base voltage. Used for voltage regulation monitoring and power flow analysis. Typically ranges from 0.95 to 1.05 pu under normal conditions.' ;
    rdfs:domain ind:Bus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:xRRatio rdf:type rdf:Property ;
    rdfs:label 'X R Ratio' ;
    rdfs:comment 'Ratio of reactance to resistance at the bus, used for short circuit analysis and protective relay settings. Higher ratios indicate more inductive systems.' ;
    rdfs:domain ind:Bus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:phmsaOperatorId rdf:type rdf:Property ;
    rdfs:label 'Phmsa Operator Id' ;
    rdfs:comment 'PHMSA-assigned operator identification number for regulatory reporting and compliance tracking.' ;
    rdfs:domain ind:CityGateStation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Operator .

ind:backupSupplyAvailable rdf:type rdf:Property ;
    rdfs:label 'Backup Supply Available' ;
    rdfs:comment 'Indicates whether an alternate or backup gas supply source is available to serve the territory if this city gate station is unavailable.' ;
    rdfs:domain ind:CityGateStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:constructionMaterial rdf:type rdf:Property ;
    rdfs:label 'Construction Material' ;
    rdfs:comment 'Primary material used in the construction of piping and pressure vessels at the city gate station.' ;
    rdfs:domain ind:CityGateStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:designCapacityMcfd rdf:type rdf:Property ;
    rdfs:label 'Design Capacity Mcfd' ;
    rdfs:comment 'Maximum designed throughput capacity of the city gate station measured in million cubic feet per day under standard operating conditions.' ;
    rdfs:domain ind:CityGateStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:emergencyShutdownCapable rdf:type rdf:Property ;
    rdfs:label 'Emergency Shutdown Capable' ;
    rdfs:comment 'Indicates whether the city gate station is equipped with automated emergency shutdown systems for safety protection.' ;
    rdfs:domain ind:CityGateStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:facilitySizeClassification rdf:type rdf:Property ;
    rdfs:label 'Facility Size Classification' ;
    rdfs:comment 'Size classification of the city gate station based on throughput capacity and infrastructure footprint.' ;
    rdfs:domain ind:CityGateStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inletPressurePsig rdf:type rdf:Property ;
    rdfs:label 'Inlet Pressure Psig' ;
    rdfs:comment 'Typical or design inlet gas pressure at the city gate station measured in pounds per square inch gauge from the upstream transmission system.' ;
    rdfs:domain ind:CityGateStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:meterCount rdf:type rdf:Property ;
    rdfs:label 'Meter Count' ;
    rdfs:comment 'Number of gas metering devices installed at the city gate station for flow measurement and custody transfer.' ;
    rdfs:domain ind:CityGateStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:odorizationRequired rdf:type rdf:Property ;
    rdfs:label 'Odorization Required' ;
    rdfs:comment 'Indicates whether odorant injection is required at this city gate station to meet safety regulations for natural gas distribution.' ;
    rdfs:domain ind:CityGateStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outletPressurePsig rdf:type rdf:Property ;
    rdfs:label 'Outlet Pressure Psig' ;
    rdfs:comment 'Regulated outlet gas pressure at the city gate station measured in pounds per square inch gauge delivered to the distribution system.' ;
    rdfs:domain ind:CityGateStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ownerOperator rdf:type rdf:Property ;
    rdfs:label 'Owner Operator' ;
    rdfs:comment 'Legal entity or business unit that owns and operates the city gate station.' ;
    rdfs:domain ind:CityGateStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatorCount rdf:type rdf:Property ;
    rdfs:label 'Regulator Count' ;
    rdfs:comment 'Number of pressure regulating devices installed at the city gate station to control downstream pressure.' ;
    rdfs:domain ind:CityGateStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:stationCode rdf:type rdf:Property ;
    rdfs:label 'Station Code' ;
    rdfs:comment 'Unique alphanumeric code assigned to the city gate station for operational tracking and system integration.' ;
    rdfs:domain ind:CityGateStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stationName rdf:type rdf:Property ;
    rdfs:label 'Station Name' ;
    rdfs:comment 'Official name or designation of the city gate station used for identification and operational reference.' ;
    rdfs:domain ind:CityGateStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stationType rdf:type rdf:Property ;
    rdfs:label 'Station Type' ;
    rdfs:comment 'Classification of the city gate station based on its operational function and pressure regulation role in the gas distribution network.' ;
    rdfs:domain ind:CityGateStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:telemetryEnabled rdf:type rdf:Property ;
    rdfs:label 'Telemetry Enabled' ;
    rdfs:comment 'Indicates whether remote telemetry data transmission is enabled for operational parameters at this city gate station.' ;
    rdfs:domain ind:CityGateStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:upstreamPipelineName rdf:type rdf:Property ;
    rdfs:label 'Upstream Pipeline Name' ;
    rdfs:comment 'Name or identifier of the upstream transmission pipeline connected to this city gate station.' ;
    rdfs:domain ind:CityGateStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:upstreamPipelineOperator rdf:type rdf:Property ;
    rdfs:label 'Upstream Pipeline Operator' ;
    rdfs:comment 'Name of the interstate or transmission pipeline operator that delivers gas to this city gate station.' ;
    rdfs:domain ind:CityGateStation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gasNetworkNodeId rdf:type rdf:Property ;
    rdfs:label 'Gas Network Node Id' ;
    rdfs:comment 'Primary key for gas_network_node' ;
    rdfs:domain ind:GasNetworkNode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:districtId rdf:type rdf:Property ;
    rdfs:label 'District Id' ;
    rdfs:comment 'Reference to the operational district responsible for maintenance and operations of this node.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:District .

ind:networkModelId rdf:type rdf:Property ;
    rdfs:label 'Network Model Id' ;
    rdfs:comment 'Identifier used in hydraulic network modeling and simulation systems for gas flow analysis.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:NetworkModel .

ind:serviceAreaId rdf:type rdf:Property ;
    rdfs:label 'Service Area Id' ;
    rdfs:comment 'Reference to the service area or district that this gas network node serves.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ServiceArea .

ind:commissionedDate rdf:type rdf:Property ;
    rdfs:label 'Commissioned Date' ;
    rdfs:comment 'Date when the gas network node was officially commissioned for operational use.' ;
    rdfs:domain ind:GasNetworkNode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:decommissionedDate rdf:type rdf:Property ;
    rdfs:label 'Decommissioned Date' ;
    rdfs:comment 'Date when the gas network node was taken out of service and decommissioned, if applicable.' ;
    rdfs:domain ind:GasNetworkNode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:designPressurePsig rdf:type rdf:Property ;
    rdfs:label 'Design Pressure Psig' ;
    rdfs:comment 'Design pressure rating for the gas network node infrastructure, establishing the engineering basis for safe operation.' ;
    rdfs:domain ind:GasNetworkNode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maximumAllowableOperatingPressurePsig rdf:type rdf:Property ;
    rdfs:label 'Maximum Allowable Operating Pressure Psig' ;
    rdfs:comment 'Maximum allowable operating pressure at the node as defined by PHMSA regulations for pipeline safety.' ;
    rdfs:domain ind:GasNetworkNode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nodeName rdf:type rdf:Property ;
    rdfs:label 'Node Name' ;
    rdfs:comment 'Human-readable name or designation of the gas network node, typically reflecting geographic location or functional purpose.' ;
    rdfs:domain ind:GasNetworkNode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nodeNumber rdf:type rdf:Property ;
    rdfs:label 'Node Number' ;
    rdfs:comment 'Externally-known unique business identifier for the gas network node, used in operational systems and field documentation.' ;
    rdfs:domain ind:GasNetworkNode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nodeType rdf:type rdf:Property ;
    rdfs:label 'Node Type' ;
    rdfs:comment 'Classification of the gas network node based on its functional role in the distribution network topology.' ;
    rdfs:domain ind:GasNetworkNode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownerType rdf:type rdf:Property ;
    rdfs:label 'Owner Type' ;
    rdfs:comment 'Classification indicating the ownership of the gas network node infrastructure.' ;
    rdfs:domain ind:GasNetworkNode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pressureClass rdf:type rdf:Property ;
    rdfs:label 'Pressure Class' ;
    rdfs:comment 'Classification of the node based on operating pressure range, determining regulatory requirements and safety protocols.' ;
    rdfs:domain ind:GasNetworkNode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:telemetryDeviceCode rdf:type rdf:Property ;
    rdfs:label 'Telemetry Device Code' ;
    rdfs:comment 'Identifier of the telemetry or remote monitoring device installed at the node, if applicable.' ;
    rdfs:domain ind:GasNetworkNode ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crewId rdf:type rdf:Property ;
    rdfs:label 'Crew Id' ;
    rdfs:comment 'Reference to the crew assigned to this dispatch. Links to the crew master table.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Crew .

ind:outageEventId rdf:type rdf:Property ;
    rdfs:label 'Outage Event Id' ;
    rdfs:comment 'Reference to the outage event record if this dispatch is responding to a service interruption. Null for non-outage work.' ;
    rdfs:domain ind:CrewDispatch ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DistributionOutageEvent .

ind:serviceTerritoryId rdf:type rdf:Property ;
    rdfs:label 'Service Territory Id' ;
    rdfs:comment 'Reference to the utility service territory where this dispatch is located. Used for jurisdictional and operational boundaries.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ServiceTerritory .

ind:actualDurationHours rdf:type rdf:Property ;
    rdfs:label 'Actual Duration Hours' ;
    rdfs:comment 'Actual time in hours spent by the crew to complete the dispatch work. Calculated from start and completion timestamps.' ;
    rdfs:domain ind:CrewDispatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:afterHoursFlag rdf:type rdf:Property ;
    rdfs:label 'After Hours Flag' ;
    rdfs:comment 'Indicates whether this dispatch occurred outside of normal business hours, triggering premium labor rates.' ;
    rdfs:domain ind:CrewDispatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:crewCount rdf:type rdf:Property ;
    rdfs:label 'Crew Count' ;
    rdfs:comment 'Number of crew members assigned to this dispatch.' ;
    rdfs:domain ind:CrewDispatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:customerPresentRequired rdf:type rdf:Property ;
    rdfs:label 'Customer Present Required' ;
    rdfs:comment 'Indicates whether customer presence is required on-site for the crew to perform the work.' ;
    rdfs:domain ind:CrewDispatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dispatchArrivalTimestamp rdf:type rdf:Property ;
    rdfs:label 'Dispatch Arrival Timestamp' ;
    rdfs:comment 'Date and time when the crew arrived on-site at the dispatch location.' ;
    rdfs:domain ind:CrewDispatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dispatchAssignedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Dispatch Assigned Timestamp' ;
    rdfs:comment 'Date and time when the crew was assigned to this dispatch.' ;
    rdfs:domain ind:CrewDispatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dispatchCancelledTimestamp rdf:type rdf:Property ;
    rdfs:label 'Dispatch Cancelled Timestamp' ;
    rdfs:comment 'Date and time when the dispatch was cancelled. Null if dispatch was not cancelled.' ;
    rdfs:domain ind:CrewDispatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dispatchCompletedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Dispatch Completed Timestamp' ;
    rdfs:comment 'Date and time when the crew completed all work and closed the dispatch assignment.' ;
    rdfs:domain ind:CrewDispatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dispatchDescription rdf:type rdf:Property ;
    rdfs:label 'Dispatch Description' ;
    rdfs:comment 'Detailed description of the dispatch work scope, problem reported, or work to be performed.' ;
    rdfs:domain ind:CrewDispatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispatchEnRouteTimestamp rdf:type rdf:Property ;
    rdfs:label 'Dispatch En Route Timestamp' ;
    rdfs:comment 'Date and time when the crew departed their current location and began traveling to the dispatch site.' ;
    rdfs:domain ind:CrewDispatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dispatchLocationAddress rdf:type rdf:Property ;
    rdfs:label 'Dispatch Location Address' ;
    rdfs:comment 'Street address of the dispatch work location. May include customer premises or infrastructure location.' ;
    rdfs:domain ind:CrewDispatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispatchLocationCity rdf:type rdf:Property ;
    rdfs:label 'Dispatch Location City' ;
    rdfs:comment 'City where the dispatch work is located.' ;
    rdfs:domain ind:CrewDispatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispatchLocationLatitude rdf:type rdf:Property ;
    rdfs:label 'Dispatch Location Latitude' ;
    rdfs:comment 'Geographic latitude coordinate of the dispatch work site. Used for crew routing and GIS integration.' ;
    rdfs:domain ind:CrewDispatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dispatchLocationLongitude rdf:type rdf:Property ;
    rdfs:label 'Dispatch Location Longitude' ;
    rdfs:comment 'Geographic longitude coordinate of the dispatch work site. Used for crew routing and GIS integration.' ;
    rdfs:domain ind:CrewDispatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dispatchLocationPostalCode rdf:type rdf:Property ;
    rdfs:label 'Dispatch Location Postal Code' ;
    rdfs:comment 'ZIP code of the dispatch work location.' ;
    rdfs:domain ind:CrewDispatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispatchLocationState rdf:type rdf:Property ;
    rdfs:label 'Dispatch Location State' ;
    rdfs:comment 'Two-letter state code where the dispatch work is located.' ;
    rdfs:domain ind:CrewDispatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispatchNumber rdf:type rdf:Property ;
    rdfs:label 'Dispatch Number' ;
    rdfs:comment 'Externally-known unique business identifier for the crew dispatch assignment. Used for tracking and reference across operational systems.' ;
    rdfs:domain ind:CrewDispatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispatchRequestedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Dispatch Requested Timestamp' ;
    rdfs:comment 'Date and time when the dispatch was initially requested or created in the system. Represents the business event time for dispatch initiation.' ;
    rdfs:domain ind:CrewDispatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dispatchStartWorkTimestamp rdf:type rdf:Property ;
    rdfs:label 'Dispatch Start Work Timestamp' ;
    rdfs:comment 'Date and time when the crew began active work on the dispatch assignment.' ;
    rdfs:domain ind:CrewDispatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:hazardFlag rdf:type rdf:Property ;
    rdfs:label 'Hazard Flag' ;
    rdfs:comment 'Indicates whether hazardous conditions are present at the dispatch location requiring special safety protocols.' ;
    rdfs:domain ind:CrewDispatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scheduledArrivalDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Arrival Date' ;
    rdfs:comment 'Planned date for crew arrival at the dispatch location. Used for scheduled maintenance and non-emergency work.' ;
    rdfs:domain ind:CrewDispatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:scheduledArrivalTimeWindowEnd rdf:type rdf:Property ;
    rdfs:label 'Scheduled Arrival Time Window End' ;
    rdfs:comment 'End of the scheduled time window for crew arrival. Used for customer appointment scheduling.' ;
    rdfs:domain ind:CrewDispatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:scheduledArrivalTimeWindowStart rdf:type rdf:Property ;
    rdfs:label 'Scheduled Arrival Time Window Start' ;
    rdfs:comment 'Beginning of the scheduled time window for crew arrival. Used for customer appointment scheduling.' ;
    rdfs:domain ind:CrewDispatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:vehicleCount rdf:type rdf:Property ;
    rdfs:label 'Vehicle Count' ;
    rdfs:comment 'Number of vehicles deployed for this dispatch.' ;
    rdfs:domain ind:CrewDispatch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:controlType rdf:type rdf:Property ;
    rdfs:label 'Control Type' ;
    rdfs:comment 'Method by which the protective device is operated or controlled in the distribution network.' ;
    rdfs:domain ind:ProtectiveDevice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coordinationGroup rdf:type rdf:Property ;
    rdfs:label 'Coordination Group' ;
    rdfs:comment 'Protection coordination group identifier used to ensure proper sequence of device operations during fault conditions.' ;
    rdfs:domain ind:ProtectiveDevice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currentState rdf:type rdf:Property ;
    rdfs:label 'Current State' ;
    rdfs:comment 'Real-time operational state of the protective device as reported by monitoring systems.' ;
    rdfs:domain ind:ProtectiveDevice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customersAffected rdf:type rdf:Property ;
    rdfs:label 'Customers Affected' ;
    rdfs:comment 'Number of customer accounts downstream of this protective device that would be impacted by its operation or failure.' ;
    rdfs:domain ind:ProtectiveDevice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:deviceFunctionCode rdf:type rdf:Property ;
    rdfs:label 'Device Function Code' ;
    rdfs:comment 'IEEE standard function number identifying the specific protection or control function (e.g., 50 for instantaneous overcurrent, 51 for time overcurrent, 27 for undervoltage).' ;
    rdfs:domain ind:ProtectiveDevice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deviceNumber rdf:type rdf:Property ;
    rdfs:label 'Device Number' ;
    rdfs:comment 'Externally-known unique identifier or asset tag for the protective device, used in field operations and work orders.' ;
    rdfs:domain ind:ProtectiveDevice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:environmentalRating rdf:type rdf:Property ;
    rdfs:label 'Environmental Rating' ;
    rdfs:comment 'Environmental protection classification indicating the device\'s suitability for different installation environments.' ;
    rdfs:domain ind:ProtectiveDevice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gasInsulated rdf:type rdf:Property ;
    rdfs:label 'Gas Insulated' ;
    rdfs:comment 'Indicates whether the protective device uses gas insulation technology (e.g., SF6) rather than air or oil insulation.' ;
    rdfs:domain ind:ProtectiveDevice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:interruptingCapacityKa rdf:type rdf:Property ;
    rdfs:label 'Interrupting Capacity Ka' ;
    rdfs:comment 'Maximum fault current in kiloamperes that the device can safely interrupt without damage.' ;
    rdfs:domain ind:ProtectiveDevice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastTripDate rdf:type rdf:Property ;
    rdfs:label 'Last Trip Date' ;
    rdfs:comment 'Timestamp of the most recent trip or operation event of the protective device.' ;
    rdfs:domain ind:ProtectiveDevice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:normalState rdf:type rdf:Property ;
    rdfs:label 'Normal State' ;
    rdfs:comment 'Default or normal operating position of the protective device under standard network conditions.' ;
    rdfs:domain ind:ProtectiveDevice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratedCurrentAmperes rdf:type rdf:Property ;
    rdfs:label 'Rated Current Amperes' ;
    rdfs:comment 'Continuous current rating of the protective device in amperes under normal operating conditions.' ;
    rdfs:domain ind:ProtectiveDevice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:replacementCostUsd rdf:type rdf:Property ;
    rdfs:label 'Replacement Cost Usd' ;
    rdfs:comment 'Estimated cost in US dollars to replace the protective device with an equivalent unit, including equipment and installation.' ;
    rdfs:domain ind:ProtectiveDevice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scadaEnabled rdf:type rdf:Property ;
    rdfs:label 'Scada Enabled' ;
    rdfs:comment 'Indicates whether the protective device is integrated with the SCADA system for remote monitoring and control.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tripCount rdf:type rdf:Property ;
    rdfs:label 'Trip Count' ;
    rdfs:comment 'Cumulative number of times the protective device has operated or tripped due to fault conditions since installation or last reset.' ;
    rdfs:domain ind:ProtectiveDevice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priorStudyId rdf:type rdf:Property ;
    rdfs:label 'Prior Study Id' ;
    rdfs:comment 'Reference to the previous depreciation study that this study supersedes or updates. Nullable for initial studies.' ;
    rdfs:domain ind:DepreciationStudy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DepreciationStudy .

ind:actuarialMethod rdf:type rdf:Property ;
    rdfs:label 'Actuarial Method' ;
    rdfs:comment 'Statistical method used to estimate service life and survivor characteristics of asset groups. Iowa curves are industry standard for utility depreciation studies.' ;
    rdfs:domain ind:DepreciationStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:annualDepreciationExpense rdf:type rdf:Property ;
    rdfs:label 'Annual Depreciation Expense' ;
    rdfs:comment 'Projected annual depreciation expense resulting from the rates recommended in this study, measured in US dollars.' ;
    rdfs:domain ind:DepreciationStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assetBaseAmount rdf:type rdf:Property ;
    rdfs:label 'Asset Base Amount' ;
    rdfs:comment 'Total gross plant value (original cost) of all assets included in the scope of this depreciation study, measured in US dollars.' ;
    rdfs:domain ind:DepreciationStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:averageRemainingLifeYears rdf:type rdf:Property ;
    rdfs:label 'Average Remaining Life Years' ;
    rdfs:comment 'Weighted average remaining service life for existing assets in the study scope, measured in years.' ;
    rdfs:domain ind:DepreciationStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:averageServiceLifeYears rdf:type rdf:Property ;
    rdfs:label 'Average Service Life Years' ;
    rdfs:comment 'Weighted average estimated service life across all asset classes included in the study, measured in years.' ;
    rdfs:domain ind:DepreciationStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:consultantFirmName rdf:type rdf:Property ;
    rdfs:label 'Consultant Firm Name' ;
    rdfs:comment 'Name of the external consulting firm that prepared or assisted with the depreciation study. Nullable if study was performed entirely in-house.' ;
    rdfs:domain ind:DepreciationStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingDocketNumber rdf:type rdf:Property ;
    rdfs:label 'Filing Docket Number' ;
    rdfs:comment 'Official docket or case number assigned by the regulatory body when the depreciation study is filed for approval. Nullable for internal studies not requiring regulatory filing.' ;
    rdfs:domain ind:DepreciationStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gaapComplianceIndicator rdf:type rdf:Property ;
    rdfs:label 'Gaap Compliance Indicator' ;
    rdfs:comment 'Flag indicating whether the depreciation study methodology and rates comply with Generally Accepted Accounting Principles. True for studies used in GAAP financial reporting.' ;
    rdfs:domain ind:DepreciationStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:leadAnalystName rdf:type rdf:Property ;
    rdfs:label 'Lead Analyst Name' ;
    rdfs:comment 'Name of the primary analyst or actuary responsible for conducting the depreciation study.' ;
    rdfs:domain ind:DepreciationStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netBookValueAmount rdf:type rdf:Property ;
    rdfs:label 'Net Book Value Amount' ;
    rdfs:comment 'Net plant value (gross plant minus accumulated depreciation) for all assets in the study scope, measured in US dollars.' ;
    rdfs:domain ind:DepreciationStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netSalvagePercent rdf:type rdf:Property ;
    rdfs:label 'Net Salvage Percent' ;
    rdfs:comment 'Weighted average net salvage value as a percentage of original cost across all asset classes. Net salvage represents gross salvage minus cost of removal. Can be negative when removal costs exceed salvage value.' ;
    rdfs:domain ind:DepreciationStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateCaseDocketNumber rdf:type rdf:Property ;
    rdfs:label 'Rate Case Docket Number' ;
    rdfs:comment 'Docket number of the associated rate case if this study was prepared for rate case purposes. Nullable if not associated with a rate case.' ;
    rdfs:domain ind:DepreciationStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateCaseIndicator rdf:type rdf:Property ;
    rdfs:label 'Rate Case Indicator' ;
    rdfs:comment 'Flag indicating whether this depreciation study was prepared specifically to support a rate case filing. True if study is part of rate case, false otherwise.' ;
    rdfs:domain ind:DepreciationStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:soxComplianceIndicator rdf:type rdf:Property ;
    rdfs:label 'Sox Compliance Indicator' ;
    rdfs:comment 'Flag indicating whether this depreciation study was subject to Sarbanes-Oxley internal control requirements and review. True for studies affecting financial statements of publicly traded utilities.' ;
    rdfs:domain ind:DepreciationStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:studyCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Study Completion Date' ;
    rdfs:comment 'Date when the depreciation study analysis was completed and finalized for submission or approval.' ;
    rdfs:domain ind:DepreciationStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:studyDocumentationUrl rdf:type rdf:Property ;
    rdfs:label 'Study Documentation Url' ;
    rdfs:comment 'File path or URL to the complete depreciation study report and supporting documentation in the document management system.' ;
    rdfs:domain ind:DepreciationStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:studyName rdf:type rdf:Property ;
    rdfs:label 'Study Name' ;
    rdfs:comment 'Descriptive name of the depreciation study, typically including the asset class or scope covered.' ;
    rdfs:domain ind:DepreciationStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:studyScopeDescription rdf:type rdf:Property ;
    rdfs:label 'Study Scope Description' ;
    rdfs:comment 'Detailed description of the asset classes, FERC accounts, and organizational units covered by this depreciation study.' ;
    rdfs:domain ind:DepreciationStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:studyStartDate rdf:type rdf:Property ;
    rdfs:label 'Study Start Date' ;
    rdfs:comment 'Date when the depreciation study analysis and data collection commenced.' ;
    rdfs:domain ind:DepreciationStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:studyStatus rdf:type rdf:Property ;
    rdfs:label 'Study Status' ;
    rdfs:comment 'Current lifecycle status of the depreciation study. Tracks progression from initial draft through regulatory approval and implementation.' ;
    rdfs:domain ind:DepreciationStudy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:journalEntryTemplateId rdf:type rdf:Property ;
    rdfs:label 'Journal Entry Template Id' ;
    rdfs:comment 'Primary key for journal_entry_template' ;
    rdfs:domain ind:JournalEntryTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supersededByTemplateId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Template Id' ;
    rdfs:comment 'Reference to the newer template that replaces this template when it is deprecated or archived. Null for current active templates.' ;
    rdfs:domain ind:JournalEntryTemplate ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:JournalEntryTemplate .

ind:accountingStandard rdf:type rdf:Property ;
    rdfs:label 'Accounting Standard' ;
    rdfs:comment 'Primary accounting standard framework that governs the use and structure of this journal entry template.' ;
    rdfs:domain ind:JournalEntryTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autoReverseFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Reverse Flag' ;
    rdfs:comment 'Indicates whether journal entries created from this template should automatically generate reversing entries in the subsequent accounting period.' ;
    rdfs:domain ind:JournalEntryTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:balanceType rdf:type rdf:Property ;
    rdfs:label 'Balance Type' ;
    rdfs:comment 'Indicates whether the template enforces balanced debits and credits, allows unbalanced entries, or relies on system calculation for balancing.' ;
    rdfs:domain ind:JournalEntryTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:controlObjective rdf:type rdf:Property ;
    rdfs:label 'Control Objective' ;
    rdfs:comment 'Description of the internal control objective this template supports for financial reporting accuracy and compliance purposes.' ;
    rdfs:domain ind:JournalEntryTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costCenterRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Cost Center Required Flag' ;
    rdfs:comment 'Indicates whether a cost center assignment is mandatory for journal entries created from this template for cost accounting purposes.' ;
    rdfs:domain ind:JournalEntryTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:defaultPostingPeriod rdf:type rdf:Property ;
    rdfs:label 'Default Posting Period' ;
    rdfs:comment 'Default accounting period relative to the entry creation date where journal entries from this template should be posted.' ;
    rdfs:domain ind:JournalEntryTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:intercompanyFlag rdf:type rdf:Property ;
    rdfs:label 'Intercompany Flag' ;
    rdfs:comment 'Indicates whether this template is used for intercompany transactions requiring elimination entries during financial consolidation.' ;
    rdfs:domain ind:JournalEntryTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastUsedDate rdf:type rdf:Property ;
    rdfs:label 'Last Used Date' ;
    rdfs:comment 'Most recent date when this template was used to create a journal entry, supporting template usage analysis and archival decisions.' ;
    rdfs:domain ind:JournalEntryTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:projectRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Project Required Flag' ;
    rdfs:comment 'Indicates whether a project or work order assignment is mandatory for entries using this template to support capital expenditure (CAPEX) tracking.' ;
    rdfs:domain ind:JournalEntryTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recurrenceDay rdf:type rdf:Property ;
    rdfs:label 'Recurrence Day' ;
    rdfs:comment 'Day of the month (1-31) or week (1-7) when recurring journal entries using this template should be posted. Null for non-recurring templates.' ;
    rdfs:domain ind:JournalEntryTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:regulatoryAccountClass rdf:type rdf:Property ;
    rdfs:label 'Regulatory Account Class' ;
    rdfs:comment 'Federal Energy Regulatory Commission (FERC) account classification applicable to this template for regulatory reporting and rate case preparation.' ;
    rdfs:domain ind:JournalEntryTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresApprovalFlag rdf:type rdf:Property ;
    rdfs:label 'Requires Approval Flag' ;
    rdfs:comment 'Indicates whether journal entries created from this template require supervisory approval before posting to the general ledger.' ;
    rdfs:domain ind:JournalEntryTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reversePeriodOffset rdf:type rdf:Property ;
    rdfs:label 'Reverse Period Offset' ;
    rdfs:comment 'Number of accounting periods after the original entry when the automatic reversing entry should be posted. Null if auto_reverse_flag is false.' ;
    rdfs:domain ind:JournalEntryTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:soxControlFlag rdf:type rdf:Property ;
    rdfs:label 'Sox Control Flag' ;
    rdfs:comment 'Indicates whether this template is subject to Sarbanes-Oxley internal control requirements and enhanced audit trail documentation.' ;
    rdfs:domain ind:JournalEntryTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:taxRelevantFlag rdf:type rdf:Property ;
    rdfs:label 'Tax Relevant Flag' ;
    rdfs:comment 'Indicates whether journal entries from this template have tax implications requiring special handling for tax accounting and reporting.' ;
    rdfs:domain ind:JournalEntryTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:templateCategory rdf:type rdf:Property ;
    rdfs:label 'Template Category' ;
    rdfs:comment 'Business category classification of the template indicating the functional area or accounting domain it serves within utility operations.' ;
    rdfs:domain ind:JournalEntryTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:templateCode rdf:type rdf:Property ;
    rdfs:label 'Template Code' ;
    rdfs:comment 'Unique business identifier code for the journal entry template used for external reference and system integration.' ;
    rdfs:domain ind:JournalEntryTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:templateDescription rdf:type rdf:Property ;
    rdfs:label 'Template Description' ;
    rdfs:comment 'Detailed description of the journal entry template including its purpose, usage guidelines, and business scenarios where it should be applied.' ;
    rdfs:domain ind:JournalEntryTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:templateName rdf:type rdf:Property ;
    rdfs:label 'Template Name' ;
    rdfs:comment 'Human-readable name of the journal entry template describing its business purpose and usage context.' ;
    rdfs:domain ind:JournalEntryTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:templateType rdf:type rdf:Property ;
    rdfs:label 'Template Type' ;
    rdfs:comment 'Classification of the journal entry template based on its accounting purpose and timing within the financial cycle.' ;
    rdfs:domain ind:JournalEntryTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usageCount rdf:type rdf:Property ;
    rdfs:label 'Usage Count' ;
    rdfs:comment 'Total number of times this template has been used to create journal entries, supporting template effectiveness analysis.' ;
    rdfs:domain ind:JournalEntryTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:usageInstructions rdf:type rdf:Property ;
    rdfs:label 'Usage Instructions' ;
    rdfs:comment 'Detailed instructions for accounting staff on how to properly use this template including data entry requirements and business rules.' ;
    rdfs:domain ind:JournalEntryTemplate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentWbsElementId rdf:type rdf:Property ;
    rdfs:label 'Parent Wbs Element Id' ;
    rdfs:comment 'Reference to the parent WBS element in the hierarchical structure. Null for top-level elements.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WbsElement .

ind:projectId rdf:type rdf:Property ;
    rdfs:label 'Project Id' ;
    rdfs:comment 'Reference to the capital or operational project to which this WBS element belongs.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CapexProject .

ind:responsibleOrganizationId rdf:type rdf:Property ;
    rdfs:label 'Responsible Organization Id' ;
    rdfs:comment 'Reference to the organizational unit or department responsible for executing and managing this WBS element.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Organization .

ind:actualEndDate rdf:type rdf:Property ;
    rdfs:label 'Actual End Date' ;
    rdfs:comment 'Actual date when work was completed on this WBS element.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:actualStartDate rdf:type rdf:Property ;
    rdfs:label 'Actual Start Date' ;
    rdfs:comment 'Actual date when work commenced on this WBS element.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:complianceRequirement rdf:type rdf:Property ;
    rdfs:label 'Compliance Requirement' ;
    rdfs:comment 'Regulatory or compliance mandate driving this WBS element (e.g., NERC CIP, EPA emissions, state PUC order).' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isActive rdf:type rdf:Property ;
    rdfs:label 'Is Active' ;
    rdfs:comment 'Indicates whether this WBS element is currently active and available for cost posting and project management.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isBillable rdf:type rdf:Property ;
    rdfs:label 'Is Billable' ;
    rdfs:comment 'Indicates whether costs associated with this WBS element are billable to customers or included in rate base calculations.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCapitalizable rdf:type rdf:Property ;
    rdfs:label 'Is Capitalizable' ;
    rdfs:comment 'Indicates whether costs for this WBS element qualify for capitalization as plant assets under GAAP and FERC accounting rules.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:plannedEndDate rdf:type rdf:Property ;
    rdfs:label 'Planned End Date' ;
    rdfs:comment 'Scheduled completion date for work on this WBS element.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:plannedStartDate rdf:type rdf:Property ;
    rdfs:label 'Planned Start Date' ;
    rdfs:comment 'Scheduled start date for work on this WBS element.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryTreatment rdf:type rdf:Property ;
    rdfs:label 'Regulatory Treatment' ;
    rdfs:comment 'Classification of how costs for this WBS element are treated for regulatory accounting and rate recovery purposes.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskCategory rdf:type rdf:Property ;
    rdfs:label 'Risk Category' ;
    rdfs:comment 'Primary risk category associated with this WBS element for risk management and mitigation planning.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wbsCode rdf:type rdf:Property ;
    rdfs:label 'Wbs Code' ;
    rdfs:comment 'Hierarchical alphanumeric code representing the WBS element position in the project structure. Used for external identification and reporting to FERC and regulatory bodies.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wbsDescription rdf:type rdf:Property ;
    rdfs:label 'Wbs Description' ;
    rdfs:comment 'Detailed description of the scope, deliverables, and purpose of the WBS element.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wbsLevel rdf:type rdf:Property ;
    rdfs:label 'Wbs Level' ;
    rdfs:comment 'Numeric level in the WBS hierarchy where 1 is the top level (project) and higher numbers represent deeper decomposition.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:wbsName rdf:type rdf:Property ;
    rdfs:label 'Wbs Name' ;
    rdfs:comment 'Business name or title of the WBS element describing the work package, project phase, or cost center.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wbsType rdf:type rdf:Property ;
    rdfs:label 'Wbs Type' ;
    rdfs:comment 'Classification of the WBS element indicating its role in the project structure.' ;
    rdfs:domain ind:WbsElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:departmentId rdf:type rdf:Property ;
    rdfs:label 'Department Id' ;
    rdfs:comment 'Identifier of the department to which the employee is assigned. Links to organizational structure.' ;
    rdfs:domain ind:Workforce ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Department .

ind:workLocationId rdf:type rdf:Property ;
    rdfs:label 'Work Location Id' ;
    rdfs:comment 'Identifier of the primary physical work location or facility where the employee is based. May reference generation plant, substation, service center, or office.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Location .

ind:badgeNumber rdf:type rdf:Property ;
    rdfs:label 'Badge Number' ;
    rdfs:comment 'Physical security badge identifier assigned to the employee for facility access and time tracking.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certificationCodes rdf:type rdf:Property ;
    rdfs:label 'Certification Codes' ;
    rdfs:comment 'Comma-separated list of professional certifications held by the employee. May include electrical licenses, safety certifications, or technical qualifications required for utility operations.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disabilityStatus rdf:type rdf:Property ;
    rdfs:label 'Disability Status' ;
    rdfs:comment 'Self-disclosed disability status of the employee. Used for reasonable accommodation and compliance with disability employment regulations.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emergencyContactRelationship rdf:type rdf:Property ;
    rdfs:label 'Emergency Contact Relationship' ;
    rdfs:comment 'Relationship of the emergency contact to the employee (e.g., spouse, parent, sibling, friend).' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employeeNumber rdf:type rdf:Property ;
    rdfs:label 'Employee Number' ;
    rdfs:comment 'Externally-known unique employee identifier assigned by human resources. Used on badges, timesheets, and payroll systems.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employmentStatus rdf:type rdf:Property ;
    rdfs:label 'Employment Status' ;
    rdfs:comment 'Current lifecycle status of the employee within the organization. Determines access rights and payroll processing.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employmentType rdf:type rdf:Property ;
    rdfs:label 'Employment Type' ;
    rdfs:comment 'Classification of the employee\'s employment arrangement. Determines benefits eligibility and scheduling rules.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ethnicity rdf:type rdf:Property ;
    rdfs:label 'Ethnicity' ;
    rdfs:comment 'Self-identified ethnicity of the employee. Used for diversity reporting and compliance with equal employment opportunity regulations.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exemptStatus rdf:type rdf:Property ;
    rdfs:label 'Exempt Status' ;
    rdfs:comment 'Indicates whether the employee is exempt or non-exempt from overtime pay requirements under FLSA regulations.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gender rdf:type rdf:Property ;
    rdfs:label 'Gender' ;
    rdfs:comment 'Self-identified gender of the employee. Used for diversity reporting and compliance with equal employment opportunity regulations.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jobCode rdf:type rdf:Property ;
    rdfs:label 'Job Code' ;
    rdfs:comment 'Standardized code representing the employee\'s job classification. Used for compensation and workforce planning.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jobTitle rdf:type rdf:Property ;
    rdfs:label 'Job Title' ;
    rdfs:comment 'Official job title or position name assigned to the employee. Reflects role and responsibilities.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nationalIdNumber rdf:type rdf:Property ;
    rdfs:label 'National Id Number' ;
    rdfs:comment 'Government-issued national identification number (e.g., Social Security Number in USA). Used for tax reporting and benefits administration.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payGrade rdf:type rdf:Property ;
    rdfs:label 'Pay Grade' ;
    rdfs:comment 'Compensation grade or band assigned to the employee. Determines salary range and benefits tier.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:securityClearanceLevel rdf:type rdf:Property ;
    rdfs:label 'Security Clearance Level' ;
    rdfs:comment 'Level of security clearance granted to the employee for access to critical infrastructure and sensitive systems. Required for employees working on generation, transmission, or distribution control systems.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unionCode rdf:type rdf:Property ;
    rdfs:label 'Union Code' ;
    rdfs:comment 'Code identifying the specific labor union to which the employee belongs. Null for non-union employees.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unionMemberFlag rdf:type rdf:Property ;
    rdfs:label 'Union Member Flag' ;
    rdfs:comment 'Indicates whether the employee is a member of a labor union. Affects collective bargaining agreement applicability.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:veteranStatus rdf:type rdf:Property ;
    rdfs:label 'Veteran Status' ;
    rdfs:comment 'Indicates whether the employee is a military veteran. Used for affirmative action and veteran hiring programs.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workScheduleType rdf:type rdf:Property ;
    rdfs:label 'Work Schedule Type' ;
    rdfs:comment 'Type of work schedule assigned to the employee. Utility operations often require 24/7 coverage with rotating shifts for plant operators and field crews.' ;
    rdfs:domain ind:Employee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ancillaryServicesFlag rdf:type rdf:Property ;
    rdfs:label 'Ancillary Services Flag' ;
    rdfs:comment 'Indicates whether the RTO/ISO operates markets for ancillary services such as regulation, spinning reserves, and non-spinning reserves.' ;
    rdfs:domain ind:RtoIso ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:apiAvailableFlag rdf:type rdf:Property ;
    rdfs:label 'Api Available Flag' ;
    rdfs:comment 'Indicates whether the RTO/ISO provides programmatic API access for market data retrieval.' ;
    rdfs:domain ind:RtoIso ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:capacityMarketFlag rdf:type rdf:Property ;
    rdfs:label 'Capacity Market Flag' ;
    rdfs:comment 'Indicates whether the RTO/ISO operates a capacity market for resource adequacy obligations.' ;
    rdfs:domain ind:RtoIso ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataPublicationLagHours rdf:type rdf:Property ;
    rdfs:label 'Data Publication Lag Hours' ;
    rdfs:comment 'Typical lag time in hours between market operations and public data availability for LMP, load, and generation data.' ;
    rdfs:domain ind:RtoIso ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dayAheadMarketFlag rdf:type rdf:Property ;
    rdfs:label 'Day Ahead Market Flag' ;
    rdfs:comment 'Indicates whether the RTO/ISO operates a day-ahead energy market for forward commitment and scheduling.' ;
    rdfs:domain ind:Market ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fercApprovedDate rdf:type rdf:Property ;
    rdfs:label 'Ferc Approved Date' ;
    rdfs:comment 'Date when FERC granted approval for the RTO/ISO to operate as a market operator.' ;
    rdfs:domain ind:RtoIso ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:financialTransmissionRightsFlag rdf:type rdf:Property ;
    rdfs:label 'Financial Transmission Rights Flag' ;
    rdfs:comment 'Indicates whether the RTO/ISO offers financial transmission rights or congestion revenue rights for hedging congestion costs.' ;
    rdfs:domain ind:Market ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:geographicFootprint rdf:type rdf:Property ;
    rdfs:label 'Geographic Footprint' ;
    rdfs:comment 'Description of the geographic territory covered by the RTO/ISO, typically listing states or provinces within the service area.' ;
    rdfs:domain ind:RtoIso ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:headquartersAddress rdf:type rdf:Property ;
    rdfs:label 'Headquarters Address' ;
    rdfs:comment 'Physical address of the RTO/ISO headquarters office.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:headquartersCity rdf:type rdf:Property ;
    rdfs:label 'Headquarters City' ;
    rdfs:comment 'City where the RTO/ISO headquarters is located.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:headquartersCountry rdf:type rdf:Property ;
    rdfs:label 'Headquarters Country' ;
    rdfs:comment 'Country where the RTO/ISO headquarters is located. Typically USA or CAN for North American markets.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:headquartersPostalCode rdf:type rdf:Property ;
    rdfs:label 'Headquarters Postal Code' ;
    rdfs:comment 'Postal or ZIP code for the RTO/ISO headquarters address.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:headquartersStateProvince rdf:type rdf:Property ;
    rdfs:label 'Headquarters State Province' ;
    rdfs:comment 'State or province where the RTO/ISO headquarters is located.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lmpPricingFlag rdf:type rdf:Property ;
    rdfs:label 'Lmp Pricing Flag' ;
    rdfs:comment 'Indicates whether the RTO/ISO uses locational marginal pricing methodology for energy settlement.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:marketMonitorName rdf:type rdf:Property ;
    rdfs:label 'Market Monitor Name' ;
    rdfs:comment 'Name of the independent market monitor responsible for oversight and reporting on market performance and participant behavior.' ;
    rdfs:domain ind:RtoIso ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketParticipantPortalUrl rdf:type rdf:Property ;
    rdfs:label 'Market Participant Portal Url' ;
    rdfs:comment 'Web address for the RTO/ISO market participant portal used for bid submission, scheduling, and settlement access.' ;
    rdfs:domain ind:RtoIso ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketSettlementCurrency rdf:type rdf:Property ;
    rdfs:label 'Market Settlement Currency' ;
    rdfs:comment 'Currency used for financial settlement of energy transactions. Typically USD for US markets, CAD for Canadian markets.' ;
    rdfs:domain ind:RtoIso ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberUtilitiesCount rdf:type rdf:Property ;
    rdfs:label 'Member Utilities Count' ;
    rdfs:comment 'Number of utility companies that are members or participants in the RTO/ISO.' ;
    rdfs:domain ind:RtoIso ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:name rdf:type rdf:Property ;
    rdfs:label 'Name' ;
    rdfs:comment 'Full legal name of the Regional Transmission Organization or Independent System Operator.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:oasisUrl rdf:type rdf:Property ;
    rdfs:label 'Oasis Url' ;
    rdfs:comment 'Web address for the RTO/ISO OASIS system providing transmission availability and reservation information.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operationalEndDate rdf:type rdf:Property ;
    rdfs:label 'Operational End Date' ;
    rdfs:comment 'Date when the RTO/ISO ceased market operations, if applicable. Null for active operators.' ;
    rdfs:domain ind:RtoIso ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:operationalStartDate rdf:type rdf:Property ;
    rdfs:label 'Operational Start Date' ;
    rdfs:comment 'Date when the RTO/ISO began market operations and settlement activities.' ;
    rdfs:domain ind:RtoIso ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:populationServedMillions rdf:type rdf:Property ;
    rdfs:label 'Population Served Millions' ;
    rdfs:comment 'Estimated population in millions served by utilities within the RTO/ISO footprint.' ;
    rdfs:domain ind:RtoIso ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:realTimeMarketFlag rdf:type rdf:Property ;
    rdfs:label 'Real Time Market Flag' ;
    rdfs:comment 'Indicates whether the RTO/ISO operates a real-time energy market for balancing and dispatch.' ;
    rdfs:domain ind:Market ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:settlementCycleDays rdf:type rdf:Property ;
    rdfs:label 'Settlement Cycle Days' ;
    rdfs:comment 'Number of days in the standard settlement cycle from trade date to final invoice issuance.' ;
    rdfs:domain ind:RtoIso ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:shortName rdf:type rdf:Property ;
    rdfs:label 'Short Name' ;
    rdfs:comment 'Commonly used abbreviated name or acronym for the RTO/ISO (e.g., PJM Interconnection, California ISO).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tariffDocumentUrl rdf:type rdf:Property ;
    rdfs:label 'Tariff Document Url' ;
    rdfs:comment 'Web address for accessing the RTO/ISO FERC-approved tariff documents governing market rules and rates.' ;
    rdfs:domain ind:RtoIso ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timeZone rdf:type rdf:Property ;
    rdfs:label 'Time Zone' ;
    rdfs:comment 'Primary time zone used for market operations, scheduling, and settlement. Critical for day-ahead and real-time market timing.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalGenerationCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Total Generation Capacity Mw' ;
    rdfs:comment 'Total installed generation capacity in megawatts within the RTO/ISO footprint.' ;
    rdfs:domain ind:RtoIso ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transmissionMiles rdf:type rdf:Property ;
    rdfs:label 'Transmission Miles' ;
    rdfs:comment 'Total miles of high-voltage transmission lines under RTO/ISO operational control.' ;
    rdfs:domain ind:RtoIso ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:auctionCloseTimestamp rdf:type rdf:Property ;
    rdfs:label 'Auction Close Timestamp' ;
    rdfs:comment 'Date and time when the capacity auction bidding window officially closed and no further bids were accepted.' ;
    rdfs:domain ind:CapacityMarketAuction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:auctionDescription rdf:type rdf:Property ;
    rdfs:label 'Auction Description' ;
    rdfs:comment 'Detailed textual description of the capacity auction including special conditions, rule changes, or notable characteristics specific to this auction event.' ;
    rdfs:domain ind:CapacityMarketAuction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auctionIdentifier rdf:type rdf:Property ;
    rdfs:label 'Auction Identifier' ;
    rdfs:comment 'Externally-known unique code or reference number assigned by the RTO/ISO to identify this specific capacity auction event.' ;
    rdfs:domain ind:CapacityMarketAuction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auctionName rdf:type rdf:Property ;
    rdfs:label 'Auction Name' ;
    rdfs:comment 'Human-readable name or title of the capacity market auction event, typically including the delivery year and auction type designation.' ;
    rdfs:domain ind:CapacityMarketAuction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auctionOpenTimestamp rdf:type rdf:Property ;
    rdfs:label 'Auction Open Timestamp' ;
    rdfs:comment 'Date and time when the capacity auction bidding window officially opened and participants could begin submitting bids.' ;
    rdfs:domain ind:CapacityMarketAuction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:auctionStatus rdf:type rdf:Property ;
    rdfs:label 'Auction Status' ;
    rdfs:comment 'Current lifecycle state of the capacity market auction indicating whether it is scheduled, actively open for bidding, closed, settled with final results, or cancelled.' ;
    rdfs:domain ind:CapacityMarketAuction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capacityPerformanceProductFlag rdf:type rdf:Property ;
    rdfs:label 'Capacity Performance Product Flag' ;
    rdfs:comment 'Indicates whether this auction procured Capacity Performance product with enhanced performance requirements and penalties for non-delivery during emergency conditions.' ;
    rdfs:domain ind:CapacityMarketAuction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:clearingPriceUsdPerMwDay rdf:type rdf:Property ;
    rdfs:label 'Clearing Price Usd Per Mw Day' ;
    rdfs:comment 'The market-clearing price established by the auction for capacity obligations, expressed in US dollars per megawatt per day for the delivery year.' ;
    rdfs:domain ind:CapacityMarketAuction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:demandCurveParameters rdf:type rdf:Property ;
    rdfs:label 'Demand Curve Parameters' ;
    rdfs:comment 'Key parameters defining the demand curve used in this auction, including slope, intercepts, and reference points that determine price-quantity relationships.' ;
    rdfs:domain ind:CapacityMarketAuction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationalDeliverabilityAreaCount rdf:type rdf:Property ;
    rdfs:label 'Locational Deliverability Area Count' ;
    rdfs:comment 'Number of distinct Locational Deliverability Areas or capacity zones included in this auction with separate clearing prices.' ;
    rdfs:domain ind:CapacityMarketAuction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minimumOfferPriceRuleApplied rdf:type rdf:Property ;
    rdfs:label 'Minimum Offer Price Rule Applied' ;
    rdfs:comment 'Indicates whether the Minimum Offer Price Rule was applied to certain resources in this auction to mitigate potential market power or state-subsidized capacity.' ;
    rdfs:domain ind:CapacityMarketAuction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:netCostOfNewEntryUsdPerMwDay rdf:type rdf:Property ;
    rdfs:label 'Net Cost Of New Entry Usd Per Mw Day' ;
    rdfs:comment 'The estimated annual cost per megawatt-day for a new generation resource to recover its fixed costs, used as a reference price in the auction demand curve.' ;
    rdfs:domain ind:CapacityMarketAuction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:planningReserveMarginPercent rdf:type rdf:Property ;
    rdfs:label 'Planning Reserve Margin Percent' ;
    rdfs:comment 'The percentage of installed capacity above forecasted peak demand required to maintain system reliability, as established by the RTO/ISO for this auction.' ;
    rdfs:domain ind:CapacityMarketAuction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryFilingReference rdf:type rdf:Property ;
    rdfs:label 'Regulatory Filing Reference' ;
    rdfs:comment 'Reference number or identifier for any FERC filings, tariff amendments, or regulatory approvals associated with this capacity auction.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reliabilityRequirementMw rdf:type rdf:Property ;
    rdfs:label 'Reliability Requirement Mw' ;
    rdfs:comment 'The total capacity requirement established by the RTO/ISO to meet reliability standards for the delivery year, measured in megawatts.' ;
    rdfs:domain ind:CapacityMarketAuction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:resultsPostedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Results Posted Timestamp' ;
    rdfs:comment 'Date and time when the RTO/ISO officially published the final auction results including clearing prices and awarded capacity quantities.' ;
    rdfs:domain ind:CapacityMarketAuction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:totalBidsSubmittedCount rdf:type rdf:Property ;
    rdfs:label 'Total Bids Submitted Count' ;
    rdfs:comment 'Total number of capacity bids submitted by all market participants during this auction event.' ;
    rdfs:domain ind:CapacityMarketAuction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalCapacityProcuredMw rdf:type rdf:Property ;
    rdfs:label 'Total Capacity Procured Mw' ;
    rdfs:comment 'Total quantity of capacity procured through this auction across all zones and resource types, measured in megawatts.' ;
    rdfs:domain ind:CapacityMarketAuction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalClearedBidsCount rdf:type rdf:Property ;
    rdfs:label 'Total Cleared Bids Count' ;
    rdfs:comment 'Total number of capacity bids that cleared and were awarded capacity obligations in this auction.' ;
    rdfs:domain ind:CapacityMarketAuction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:variableResourceRequirementCurveApplied rdf:type rdf:Property ;
    rdfs:label 'Variable Resource Requirement Curve Applied' ;
    rdfs:comment 'Indicates whether a Variable Resource Requirement curve was applied in this auction to establish the demand curve and clearing price mechanism.' ;
    rdfs:domain ind:CapacityMarketAuction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:marketZoneId rdf:type rdf:Property ;
    rdfs:label 'Market Zone Id' ;
    rdfs:comment 'Primary key for market_zone' ;
    rdfs:domain ind:MarketZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:balancingAuthorityParticipantRegistrationId rdf:type rdf:Property ;
    rdfs:label 'Balancing Authority Participant Registration Id' ;
    rdfs:comment 'Reference to the Balancing Authority responsible for maintaining load-resource balance and reliability in this zone.' ;
    rdfs:domain ind:MarketZone ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ParticipantRegistration .

ind:parentZoneId rdf:type rdf:Property ;
    rdfs:label 'Parent Zone Id' ;
    rdfs:comment 'Reference to a parent or aggregate market zone if this zone is a sub-zone within a larger market area. Null for top-level zones.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:UtilityCompany .

ind:ancillaryServicesRegion rdf:type rdf:Property ;
    rdfs:label 'Ancillary Services Region' ;
    rdfs:comment 'The ancillary services region this zone belongs to for procurement of regulation, spinning reserves, non-spinning reserves, and operating reserves.' ;
    rdfs:domain ind:MarketZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capacityZoneFlag rdf:type rdf:Property ;
    rdfs:label 'Capacity Zone Flag' ;
    rdfs:comment 'Indicates whether this zone participates in capacity market auctions and has capacity obligations (True) or is energy-only (False).' ;
    rdfs:domain ind:MarketZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:congestionFrequencyScore rdf:type rdf:Property ;
    rdfs:label 'Congestion Frequency Score' ;
    rdfs:comment 'Historical metric indicating the frequency of transmission congestion events in this zone, used for risk assessment and hedging strategy. Scale 0-100.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:externalZoneReference rdf:type rdf:Property ;
    rdfs:label 'External Zone Reference' ;
    rdfs:comment 'External reference code or identifier used by the RTO/ISO or other market systems to identify this zone in data exchanges and settlement files.' ;
    rdfs:domain ind:MarketZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographicBoundary rdf:type rdf:Property ;
    rdfs:label 'Geographic Boundary' ;
    rdfs:comment 'Textual description of the geographic boundaries of this market zone, including states, counties, or transmission substations that define the zone perimeter.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lmpCalculationMethod rdf:type rdf:Property ;
    rdfs:label 'Lmp Calculation Method' ;
    rdfs:comment 'Method used to calculate the Locational Marginal Price for this zone: nodal (specific location), zonal (area average), hub average (multiple node average), or weighted average (load-weighted).' ;
    rdfs:domain ind:MarketZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossFactor rdf:type rdf:Property ;
    rdfs:label 'Loss Factor' ;
    rdfs:comment 'Average transmission loss factor applied to energy transactions in this zone, representing the percentage of energy lost in transmission (e.g., 0.02 for 2% loss).' ;
    rdfs:domain ind:MarketZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:marketParticipantCount rdf:type rdf:Property ;
    rdfs:label 'Market Participant Count' ;
    rdfs:comment 'Number of registered market participants (generators, load serving entities, traders) actively transacting in this zone.' ;
    rdfs:domain ind:MarketZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:renewableEnergyZoneFlag rdf:type rdf:Property ;
    rdfs:label 'Renewable Energy Zone Flag' ;
    rdfs:comment 'Indicates whether this zone is designated as a Renewable Energy Zone with special interconnection or transmission rules for renewable generation (True/False).' ;
    rdfs:domain ind:MarketZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reserveMarginPercent rdf:type rdf:Property ;
    rdfs:label 'Reserve Margin Percent' ;
    rdfs:comment 'Required planning reserve margin for this zone expressed as a percentage above peak load, mandated by the RTO/ISO or reliability coordinator.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:settlementIntervalMinutes rdf:type rdf:Property ;
    rdfs:label 'Settlement Interval Minutes' ;
    rdfs:comment 'Standard settlement interval duration in minutes for this zone (typically 5, 15, or 60 minutes depending on RTO/ISO rules).' ;
    rdfs:domain ind:Market ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:transmissionConstraintArea rdf:type rdf:Property ;
    rdfs:label 'Transmission Constraint Area' ;
    rdfs:comment 'Identifier for the transmission constraint area or congestion zone that this market zone belongs to, used for managing grid congestion and calculating congestion charges.' ;
    rdfs:domain ind:MarketZone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zoneCode rdf:type rdf:Property ;
    rdfs:label 'Zone Code' ;
    rdfs:comment 'Externally-recognized unique code for the market zone as defined by the RTO/ISO (e.g., ZONE_A, PJM_WEST, NYISO_J). Used in market bids, schedules, and settlement reports.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zoneName rdf:type rdf:Property ;
    rdfs:label 'Zone Name' ;
    rdfs:comment 'Human-readable name of the market zone (e.g., Western Hub, New York City, Northern Illinois).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zoneType rdf:type rdf:Property ;
    rdfs:label 'Zone Type' ;
    rdfs:comment 'Classification of the market zone indicating its primary function: load zone (demand aggregation), generation zone (supply aggregation), hub (pricing node), interface (interconnection point), or aggregate (composite zone).' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capacityTransferAgreementId rdf:type rdf:Property ;
    rdfs:label 'Capacity Transfer Agreement Id' ;
    rdfs:comment 'Primary key for capacity_transfer_agreement' ;
    rdfs:domain ind:CapacityTransferAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:resourceId rdf:type rdf:Property ;
    rdfs:label 'Resource Id' ;
    rdfs:comment 'Identifier of the specific generation or demand response resource associated with the transferred capacity.' ;
    rdfs:domain ind:CapacityTransferAgreement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CapacityResource .

ind:transfereePartyWholesaleCounterpartyId rdf:type rdf:Property ;
    rdfs:label 'Transferee Party Wholesale Counterparty Id' ;
    rdfs:comment 'Identifier of the party receiving capacity rights under this agreement.' ;
    rdfs:domain ind:CapacityTransferAgreement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WholesaleCounterparty .

ind:auctionClearingPeriod rdf:type rdf:Property ;
    rdfs:label 'Auction Clearing Period' ;
    rdfs:comment 'Capacity auction delivery year or period for which this transfer applies.' ;
    rdfs:domain ind:CapacityTransferAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autoRenewalFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Renewal Flag' ;
    rdfs:comment 'Indicates whether the agreement automatically renews for subsequent delivery periods unless terminated.' ;
    rdfs:domain ind:CapacityTransferAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bilateralFlag rdf:type rdf:Property ;
    rdfs:label 'Bilateral Flag' ;
    rdfs:comment 'Indicates whether this is a bilateral capacity transfer outside of centralized auction mechanisms.' ;
    rdfs:domain ind:CapacityTransferAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:capacityAmountMw rdf:type rdf:Property ;
    rdfs:label 'Capacity Amount Mw' ;
    rdfs:comment 'Total capacity amount being transferred under this agreement measured in megawatts.' ;
    rdfs:domain ind:CapacityTransferAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contractDocumentReference rdf:type rdf:Property ;
    rdfs:label 'Contract Document Reference' ;
    rdfs:comment 'Reference identifier or file path to the executed legal contract document for this agreement.' ;
    rdfs:domain ind:CapacityTransferAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:createdByUser rdf:type rdf:Property ;
    rdfs:label 'Created By User' ;
    rdfs:comment 'Username or identifier of the user who created this capacity transfer agreement record.' ;
    rdfs:domain ind:CapacityTransferAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditRequirementAmount rdf:type rdf:Property ;
    rdfs:label 'Credit Requirement Amount' ;
    rdfs:comment 'Financial security or credit support amount required from the transferee to support this agreement.' ;
    rdfs:domain ind:CapacityTransferAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastModifiedByUser rdf:type rdf:Property ;
    rdfs:label 'Last Modified By User' ;
    rdfs:comment 'Username or identifier of the user who last modified this capacity transfer agreement record.' ;
    rdfs:domain ind:CapacityTransferAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentFrequency rdf:type rdf:Property ;
    rdfs:label 'Payment Frequency' ;
    rdfs:comment 'Frequency at which capacity transfer payments are due under this agreement.' ;
    rdfs:domain ind:CapacityTransferAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performanceObligationFlag rdf:type rdf:Property ;
    rdfs:label 'Performance Obligation Flag' ;
    rdfs:comment 'Indicates whether the transferee assumes performance obligations and potential penalties under capacity performance rules.' ;
    rdfs:domain ind:CapacityTransferAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pointOfReceipt rdf:type rdf:Property ;
    rdfs:label 'Point Of Receipt' ;
    rdfs:comment 'Transmission system location where capacity is received for point-to-point transfers.' ;
    rdfs:domain ind:CapacityTransferAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Settlement Account Number' ;
    rdfs:comment 'RTO/ISO settlement account number used for capacity transfer payment settlements.' ;
    rdfs:domain ind:Market ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:terminationNoticeDays rdf:type rdf:Property ;
    rdfs:label 'Termination Notice Days' ;
    rdfs:comment 'Number of days advance notice required for early termination of the agreement.' ;
    rdfs:domain ind:CapacityTransferAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:transferPricePerMw rdf:type rdf:Property ;
    rdfs:label 'Transfer Price Per Mw' ;
    rdfs:comment 'Negotiated price per megawatt for the capacity transfer. Business-confidential contract term.' ;
    rdfs:domain ind:CapacityTransferAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:aggregationAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Aggregation Allowed Flag' ;
    rdfs:comment 'Indicates whether multiple customer sites can be aggregated to meet the minimum participation threshold.' ;
    rdfs:domain ind:DemandResponseProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:baselineMethodology rdf:type rdf:Property ;
    rdfs:label 'Baseline Methodology' ;
    rdfs:comment 'The calculation method used to establish the customer baseline load (CBL) against which demand reductions are measured.' ;
    rdfs:domain ind:DemandResponseProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capacityCommitmentMw rdf:type rdf:Property ;
    rdfs:label 'Capacity Commitment Mw' ;
    rdfs:comment 'The total committed demand reduction capacity in megawatts that this program is obligated to deliver to the market.' ;
    rdfs:domain ind:DemandResponseProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capacityPaymentRatePerMw rdf:type rdf:Property ;
    rdfs:label 'Capacity Payment Rate Per Mw' ;
    rdfs:comment 'The fixed payment rate per megawatt of committed capacity, typically paid monthly or annually regardless of dispatch.' ;
    rdfs:domain ind:DemandResponseProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dispatchInstructionsUrl rdf:type rdf:Property ;
    rdfs:label 'Dispatch Instructions Url' ;
    rdfs:comment 'Web link to the operational dispatch instructions and participant guidelines for this program.' ;
    rdfs:domain ind:DemandResponseProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibleCustomerClasses rdf:type rdf:Property ;
    rdfs:label 'Eligible Customer Classes' ;
    rdfs:comment 'Comma-separated list of customer rate classes eligible to participate in this demand response program (e.g., commercial, industrial, residential).' ;
    rdfs:domain ind:DemandResponseProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:energyPaymentRatePerMwh rdf:type rdf:Property ;
    rdfs:label 'Energy Payment Rate Per Mwh' ;
    rdfs:comment 'The variable payment rate per megawatt-hour of actual demand reduction delivered during dispatch events.' ;
    rdfs:domain ind:DemandResponseProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:enrollmentStartDate rdf:type rdf:Property ;
    rdfs:label 'Enrollment Start Date' ;
    rdfs:comment 'The date when customer enrollment for this demand response program opens.' ;
    rdfs:domain ind:DemandResponseProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:incentivePaymentType rdf:type rdf:Property ;
    rdfs:label 'Incentive Payment Type' ;
    rdfs:comment 'The structure of financial compensation provided to participants for their demand reduction commitment and performance.' ;
    rdfs:domain ind:DemandResponseProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maximumEventDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Maximum Event Duration Minutes' ;
    rdfs:comment 'The maximum duration in minutes that a demand response event can last under this program.' ;
    rdfs:domain ind:DemandResponseProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maximumEventHoursPerYear rdf:type rdf:Property ;
    rdfs:label 'Maximum Event Hours Per Year' ;
    rdfs:comment 'The maximum cumulative hours of demand response events allowed per calendar year under this program.' ;
    rdfs:domain ind:DemandResponseProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maximumEventsPerYear rdf:type rdf:Property ;
    rdfs:label 'Maximum Events Per Year' ;
    rdfs:comment 'The maximum number of demand response dispatch events allowed per calendar year under this program.' ;
    rdfs:domain ind:DemandResponseProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maximumLoadReductionMw rdf:type rdf:Property ;
    rdfs:label 'Maximum Load Reduction Mw' ;
    rdfs:comment 'The maximum demand reduction in megawatts that this program can deliver during a dispatch event.' ;
    rdfs:domain ind:DemandResponseProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumEnrollmentKw rdf:type rdf:Property ;
    rdfs:label 'Minimum Enrollment Kw' ;
    rdfs:comment 'The minimum demand reduction capacity in kilowatts required for a customer to enroll in this program.' ;
    rdfs:domain ind:DemandResponseProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumEventDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Minimum Event Duration Minutes' ;
    rdfs:comment 'The minimum duration in minutes that a demand response event must last once dispatched.' ;
    rdfs:domain ind:DemandResponseProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minimumLoadReductionMw rdf:type rdf:Property ;
    rdfs:label 'Minimum Load Reduction Mw' ;
    rdfs:comment 'The minimum demand reduction in megawatts required for a dispatch event under this program.' ;
    rdfs:domain ind:DemandResponseProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:penaltyRatePerMw rdf:type rdf:Property ;
    rdfs:label 'Penalty Rate Per Mw' ;
    rdfs:comment 'The financial penalty assessed per megawatt of committed capacity not delivered during a dispatch event.' ;
    rdfs:domain ind:DemandResponseProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:programAdministrator rdf:type rdf:Property ;
    rdfs:label 'Program Administrator' ;
    rdfs:comment 'The name of the internal department or external curtailment service provider (CSP) responsible for administering this program.' ;
    rdfs:domain ind:DemandResponseProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programDescription rdf:type rdf:Property ;
    rdfs:label 'Program Description' ;
    rdfs:comment 'Detailed narrative description of the program objectives, operational characteristics, and participant obligations.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programStatus rdf:type rdf:Property ;
    rdfs:label 'Program Status' ;
    rdfs:comment 'Current lifecycle status of the demand response program indicating its operational availability.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryApprovalDocket rdf:type rdf:Property ;
    rdfs:label 'Regulatory Approval Docket' ;
    rdfs:comment 'The public utility commission or FERC docket number under which this demand response program was approved.' ;
    rdfs:domain ind:DemandResponseProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:telemetryRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Telemetry Required Flag' ;
    rdfs:comment 'Indicates whether real-time telemetry and interval metering data submission to the RTO/ISO is required for program participation.' ;
    rdfs:domain ind:DemandResponseProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:carbonConstraintScenario rdf:type rdf:Property ;
    rdfs:label 'Carbon Constraint Scenario' ;
    rdfs:comment 'The greenhouse gas emissions reduction policy or target applied to this portfolio scenario, reflecting regulatory mandates or voluntary commitments.' ;
    rdfs:domain ind:IrpPortfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:carbonReductionTargetPercent rdf:type rdf:Property ;
    rdfs:label 'Carbon Reduction Target Percent' ;
    rdfs:comment 'The percentage reduction in carbon dioxide equivalent emissions targeted by this portfolio relative to a baseline year, if applicable.' ;
    rdfs:domain ind:IrpPortfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:demandSideManagementMw rdf:type rdf:Property ;
    rdfs:label 'Demand Side Management Mw' ;
    rdfs:comment 'The total peak demand reduction in megawatts achieved through energy efficiency and demand response programs included in this portfolio.' ;
    rdfs:domain ind:IrpPortfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:energyForecastGwh rdf:type rdf:Property ;
    rdfs:label 'Energy Forecast Gwh' ;
    rdfs:comment 'The total forecasted annual energy requirement in gigawatt-hours at the end of the planning horizon for this portfolio scenario.' ;
    rdfs:domain ind:IrpPortfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:filingYear rdf:type rdf:Property ;
    rdfs:label 'Filing Year' ;
    rdfs:comment 'The calendar year in which this IRP portfolio was filed with the regulatory commission.' ;
    rdfs:domain ind:IrpPortfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:levelizedCostPerMwh rdf:type rdf:Property ;
    rdfs:label 'Levelized Cost Per Mwh' ;
    rdfs:comment 'The levelized cost of energy for this portfolio expressed in dollars per megawatt-hour, representing the average cost to generate and deliver electricity over the planning horizon.' ;
    rdfs:domain ind:IrpPortfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:loadForecastScenario rdf:type rdf:Property ;
    rdfs:label 'Load Forecast Scenario' ;
    rdfs:comment 'The demand growth assumption applied in this portfolio scenario, reflecting expected customer load patterns over the planning horizon.' ;
    rdfs:domain ind:IrpPortfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelingTool rdf:type rdf:Property ;
    rdfs:label 'Modeling Tool' ;
    rdfs:comment 'The name of the capacity expansion or production cost modeling software used to develop and optimize this portfolio scenario (e.g., PLEXOS, Aurora, PROMOD).' ;
    rdfs:domain ind:IrpPortfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:peakDemandMw rdf:type rdf:Property ;
    rdfs:label 'Peak Demand Mw' ;
    rdfs:comment 'The forecasted system peak demand in megawatts at the end of the planning horizon for this portfolio scenario.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:planningHorizonEndDate rdf:type rdf:Property ;
    rdfs:label 'Planning Horizon End Date' ;
    rdfs:comment 'The last date of the planning period covered by this IRP portfolio scenario, typically 10-20 years from the start date depending on regulatory requirements.' ;
    rdfs:domain ind:IrpPortfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:planningHorizonStartDate rdf:type rdf:Property ;
    rdfs:label 'Planning Horizon Start Date' ;
    rdfs:comment 'The first date of the planning period covered by this IRP portfolio scenario, typically the beginning of the first forecast year.' ;
    rdfs:domain ind:IrpPortfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:portfolioCode rdf:type rdf:Property ;
    rdfs:label 'Portfolio Code' ;
    rdfs:comment 'Short alphanumeric code used to reference this portfolio in regulatory filings, internal planning documents, and cross-system references.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:portfolioName rdf:type rdf:Property ;
    rdfs:label 'Portfolio Name' ;
    rdfs:comment 'Business name or label assigned to this IRP portfolio scenario for identification and reporting purposes.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:portfolioType rdf:type rdf:Property ;
    rdfs:label 'Portfolio Type' ;
    rdfs:comment 'Classification of the portfolio scenario based on planning assumptions and strategic objectives. Base case represents the most likely scenario; preferred represents the utility\'s recommended resource plan.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reliabilityScore rdf:type rdf:Property ;
    rdfs:label 'Reliability Score' ;
    rdfs:comment 'A quantitative reliability assessment score for this portfolio based on resource adequacy, transmission constraints, and operational flexibility metrics.' ;
    rdfs:domain ind:IrpPortfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:renewablePortfolioStandardPercent rdf:type rdf:Property ;
    rdfs:label 'Renewable Portfolio Standard Percent' ;
    rdfs:comment 'The target percentage of energy generation from renewable sources required by state RPS mandates or voluntary commitments in this portfolio.' ;
    rdfs:domain ind:IrpPortfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sensitivityAnalysisPerformed rdf:type rdf:Property ;
    rdfs:label 'Sensitivity Analysis Performed' ;
    rdfs:comment 'Indicates whether sensitivity analysis was performed on this portfolio to test robustness against variations in key assumptions such as fuel prices, load growth, and technology costs.' ;
    rdfs:domain ind:IrpPortfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stakeholderInputSummary rdf:type rdf:Property ;
    rdfs:label 'Stakeholder Input Summary' ;
    rdfs:comment 'A summary of key stakeholder feedback received during the IRP public comment process, including input from consumer advocates, environmental groups, and industry participants.' ;
    rdfs:domain ind:IrpPortfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Total Capacity Mw' ;
    rdfs:comment 'The total installed generation capacity in megawatts included in this portfolio at the end of the planning horizon.' ;
    rdfs:domain ind:IrpPortfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalPortfolioCostMillion rdf:type rdf:Property ;
    rdfs:label 'Total Portfolio Cost Million' ;
    rdfs:comment 'The total net present value cost of this portfolio in millions of dollars over the planning horizon, including capital, operating, fuel, and environmental compliance costs.' ;
    rdfs:domain ind:IrpPortfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:alternativeCompliancePaymentRate rdf:type rdf:Property ;
    rdfs:label 'Alternative Compliance Payment Rate' ;
    rdfs:comment 'Dollar amount per megawatt-hour that utilities must pay as an alternative compliance payment if they fail to meet RPS targets.' ;
    rdfs:domain ind:RpsProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bankingAllowed rdf:type rdf:Property ;
    rdfs:label 'Banking Allowed' ;
    rdfs:comment 'Indicates whether excess renewable energy credits can be banked and carried forward to future compliance periods.' ;
    rdfs:domain ind:RpsProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bankingLimitYears rdf:type rdf:Property ;
    rdfs:label 'Banking Limit Years' ;
    rdfs:comment 'Maximum number of years that banked renewable energy credits can be carried forward for compliance use.' ;
    rdfs:domain ind:RpsProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:carveOutSolarPercentage rdf:type rdf:Property ;
    rdfs:label 'Carve Out Solar Percentage' ;
    rdfs:comment 'Specific percentage of the RPS target that must be met through solar energy resources, if mandated by the program.' ;
    rdfs:domain ind:RpsProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:carveOutWindPercentage rdf:type rdf:Property ;
    rdfs:label 'Carve Out Wind Percentage' ;
    rdfs:comment 'Specific percentage of the RPS target that must be met through wind energy resources, if mandated by the program.' ;
    rdfs:domain ind:RpsProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:complianceYear rdf:type rdf:Property ;
    rdfs:label 'Compliance Year' ;
    rdfs:comment 'Calendar year for which the RPS program compliance obligations and targets apply.' ;
    rdfs:domain ind:RpsProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:costCapAmount rdf:type rdf:Property ;
    rdfs:label 'Cost Cap Amount' ;
    rdfs:comment 'Maximum dollar amount or percentage of retail rates that can be allocated to RPS program costs, if a cost cap is mandated.' ;
    rdfs:domain ind:RpsProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eligibleResourceTypes rdf:type rdf:Property ;
    rdfs:label 'Eligible Resource Types' ;
    rdfs:comment 'Comma-separated list of renewable energy resource types that qualify for RPS compliance credit under this program (e.g., solar, wind, hydro, biomass, geothermal).' ;
    rdfs:domain ind:RpsProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enablingLegislation rdf:type rdf:Property ;
    rdfs:label 'Enabling Legislation' ;
    rdfs:comment 'Citation of the statute, law, or legislative act that established the RPS program mandate.' ;
    rdfs:domain ind:RpsProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ghgReductionTargetPercentage rdf:type rdf:Property ;
    rdfs:label 'Ghg Reduction Target Percentage' ;
    rdfs:comment 'Associated greenhouse gas emissions reduction target percentage linked to the RPS program, if mandated.' ;
    rdfs:domain ind:RpsProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:penaltyRate rdf:type rdf:Property ;
    rdfs:label 'Penalty Rate' ;
    rdfs:comment 'Dollar amount per megawatt-hour assessed as a penalty for non-compliance with RPS program requirements.' ;
    rdfs:domain ind:RpsProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recTradingAllowed rdf:type rdf:Property ;
    rdfs:label 'Rec Trading Allowed' ;
    rdfs:comment 'Indicates whether the program permits trading or purchasing of renewable energy certificates to meet compliance obligations.' ;
    rdfs:domain ind:RpsProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryAuthority rdf:type rdf:Property ;
    rdfs:label 'Regulatory Authority' ;
    rdfs:comment 'Name of the regulatory body or commission that oversees and enforces the RPS program requirements.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Reporting Deadline Date' ;
    rdfs:comment 'Annual deadline date by which RPS compliance reports must be filed with the regulatory authority.' ;
    rdfs:domain ind:RpsProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:targetMwh rdf:type rdf:Property ;
    rdfs:label 'Target Mwh' ;
    rdfs:comment 'Absolute renewable energy procurement target expressed in megawatt-hours for the compliance period.' ;
    rdfs:domain ind:RpsProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetPercentage rdf:type rdf:Property ;
    rdfs:label 'Target Percentage' ;
    rdfs:comment 'Mandated percentage of total retail electricity sales that must be sourced from renewable energy resources under this RPS program.' ;
    rdfs:domain ind:RpsProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transmissionRightsPortfolioId rdf:type rdf:Property ;
    rdfs:label 'Transmission Rights Portfolio Id' ;
    rdfs:comment 'Primary key for transmission_rights_portfolio' ;
    rdfs:domain ind:TransmissionRightsPortfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:acquisitionCostUsd rdf:type rdf:Property ;
    rdfs:label 'Acquisition Cost Usd' ;
    rdfs:comment 'Total cost paid to acquire the transmission rights in this portfolio through auctions or bilateral transactions.' ;
    rdfs:domain ind:TransmissionRightsPortfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:auctionPeriod rdf:type rdf:Property ;
    rdfs:label 'Auction Period' ;
    rdfs:comment 'Time period classification for which the transmission rights were acquired through RTO/ISO auctions.' ;
    rdfs:domain ind:TransmissionRightsPortfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessUnit rdf:type rdf:Property ;
    rdfs:label 'Business Unit' ;
    rdfs:comment 'Internal business unit or division responsible for managing this transmission rights portfolio.' ;
    rdfs:domain ind:TransmissionRightsPortfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditRequirementUsd rdf:type rdf:Property ;
    rdfs:label 'Credit Requirement Usd' ;
    rdfs:comment 'Total credit or collateral requirement imposed by the RTO/ISO for holding these transmission rights.' ;
    rdfs:domain ind:TransmissionRightsPortfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:irpResourceFlag rdf:type rdf:Property ;
    rdfs:label 'Irp Resource Flag' ;
    rdfs:comment 'Indicates whether transmission rights in this portfolio are included in the utility\'s Integrated Resource Plan for resource adequacy analysis.' ;
    rdfs:domain ind:TransmissionRightsPortfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:portfolioManagerName rdf:type rdf:Property ;
    rdfs:label 'Portfolio Manager Name' ;
    rdfs:comment 'Name of the individual or team responsible for managing and optimizing this transmission rights portfolio.' ;
    rdfs:domain ind:TransmissionRightsPortfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:portfolioStatus rdf:type rdf:Property ;
    rdfs:label 'Portfolio Status' ;
    rdfs:comment 'Current lifecycle status of the transmission rights portfolio indicating whether it is actively managed and traded.' ;
    rdfs:domain ind:TransmissionRightsPortfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:portfolioValueUsd rdf:type rdf:Property ;
    rdfs:label 'Portfolio Value Usd' ;
    rdfs:comment 'Current market value of the transmission rights portfolio in US dollars based on latest mark-to-market valuation.' ;
    rdfs:domain ind:TransmissionRightsPortfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riskLimitUsd rdf:type rdf:Property ;
    rdfs:label 'Risk Limit Usd' ;
    rdfs:comment 'Maximum dollar exposure limit approved for this transmission rights portfolio under enterprise risk management policies.' ;
    rdfs:domain ind:TransmissionRightsPortfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:strategyType rdf:type rdf:Property ;
    rdfs:label 'Strategy Type' ;
    rdfs:comment 'Investment strategy classification for this portfolio indicating whether rights are held for hedging congestion risk, speculative trading, or physical transmission coverage.' ;
    rdfs:domain ind:TransmissionRightsPortfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalMwCapacity rdf:type rdf:Property ;
    rdfs:label 'Total Mw Capacity' ;
    rdfs:comment 'Total transmission capacity in megawatts represented by all rights held in this portfolio.' ;
    rdfs:domain ind:TransmissionRightsPortfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tradingDesk rdf:type rdf:Property ;
    rdfs:label 'Trading Desk' ;
    rdfs:comment 'Trading desk or group within the utility responsible for executing transactions related to this portfolio.' ;
    rdfs:domain ind:TransmissionRightsPortfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersededByScheduleId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Schedule Id' ;
    rdfs:comment 'Reference to the TOU schedule that replaces this schedule when it is retired or superseded. Null if this is the current active schedule.' ;
    rdfs:domain ind:TouSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TouSchedule .

ind:amiRequired rdf:type rdf:Property ;
    rdfs:label 'Ami Required' ;
    rdfs:comment 'Indicates whether an AMI smart meter is required for customers to be enrolled in this TOU schedule.' ;
    rdfs:domain ind:TouSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:criticalPeakEnabled rdf:type rdf:Property ;
    rdfs:label 'Critical Peak Enabled' ;
    rdfs:comment 'Indicates whether this TOU schedule includes critical peak pricing events that can be triggered during extreme demand or supply conditions.' ;
    rdfs:domain ind:TouSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:criticalPeakMaxEventsPerYear rdf:type rdf:Property ;
    rdfs:label 'Critical Peak Max Events Per Year' ;
    rdfs:comment 'Maximum number of critical peak pricing events that can be called in a calendar year under this TOU schedule. Null if critical peak pricing is not enabled.' ;
    rdfs:domain ind:TouSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:criticalPeakMaxHoursPerEvent rdf:type rdf:Property ;
    rdfs:label 'Critical Peak Max Hours Per Event' ;
    rdfs:comment 'Maximum duration in hours for a single critical peak pricing event. Null if critical peak pricing is not enabled.' ;
    rdfs:domain ind:TouSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:demandWindowMinutes rdf:type rdf:Property ;
    rdfs:label 'Demand Window Minutes' ;
    rdfs:comment 'Rolling window length in minutes used to calculate peak demand under this TOU schedule.' ;
    rdfs:domain ind:TouSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:holidayTreatment rdf:type rdf:Property ;
    rdfs:label 'Holiday Treatment' ;
    rdfs:comment 'Defines how holidays are treated in the TOU schedule, whether they follow off-peak rates, standard weekday rates, weekend rates, or a custom definition.' ;
    rdfs:domain ind:TouSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:offPeakPeriodDefinition rdf:type rdf:Property ;
    rdfs:label 'Off Peak Period Definition' ;
    rdfs:comment 'Textual definition of the off-peak period hours and days when the lowest rates apply under this TOU schedule.' ;
    rdfs:domain ind:TouSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:optInRequired rdf:type rdf:Property ;
    rdfs:label 'Opt In Required' ;
    rdfs:comment 'Indicates whether customers must explicitly opt in to this TOU schedule or if it is the default schedule for the rate class.' ;
    rdfs:domain ind:TouSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:peakPeriodDefinition rdf:type rdf:Property ;
    rdfs:label 'Peak Period Definition' ;
    rdfs:comment 'Textual definition of the peak demand period hours and days when the highest rates apply under this TOU schedule.' ;
    rdfs:domain ind:TouSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryApprovalNumber rdf:type rdf:Property ;
    rdfs:label 'Regulatory Approval Number' ;
    rdfs:comment 'Reference number of the regulatory filing or approval authorizing this TOU schedule, issued by the governing public utility commission.' ;
    rdfs:domain ind:TouSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleCode rdf:type rdf:Property ;
    rdfs:label 'Schedule Code' ;
    rdfs:comment 'Business identifier code for the TOU schedule used in billing and rate systems. Externally-known unique code referenced in tariff documents and customer communications.' ;
    rdfs:domain ind:TouSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seasonDefinition rdf:type rdf:Property ;
    rdfs:label 'Season Definition' ;
    rdfs:comment 'Textual definition of seasonal periods if the TOU schedule varies by season, including summer, winter, and transition periods with their date ranges.' ;
    rdfs:domain ind:TouSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shoulderPeriodDefinition rdf:type rdf:Property ;
    rdfs:label 'Shoulder Period Definition' ;
    rdfs:comment 'Textual definition of the shoulder or mid-peak period hours and days when intermediate rates apply. Null if the schedule does not include a shoulder period.' ;
    rdfs:domain ind:TouSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tariffReference rdf:type rdf:Property ;
    rdfs:label 'Tariff Reference' ;
    rdfs:comment 'Reference to the tariff document section or schedule number where this TOU schedule is published and documented.' ;
    rdfs:domain ind:TouSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:weekendTreatment rdf:type rdf:Property ;
    rdfs:label 'Weekend Treatment' ;
    rdfs:comment 'Defines how weekends are treated in the TOU schedule, whether they follow off-peak rates, standard rates, or a custom definition.' ;
    rdfs:domain ind:TouSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentRuleSetId rdf:type rdf:Property ;
    rdfs:label 'Parent Rule Set Id' ;
    rdfs:comment 'Reference to the parent rule set if this rule set is a specialized variant or child of another rule set. Null for top-level rule sets.' ;
    rdfs:domain ind:VeeRuleSet ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:VeeRuleSet .

ind:appliesToCustomerClass rdf:type rdf:Property ;
    rdfs:label 'Applies To Customer Class' ;
    rdfs:comment 'Customer class this rule set applies to: residential, commercial, industrial, or all customer classes.' ;
    rdfs:domain ind:VeeRuleSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appliesToMeterType rdf:type rdf:Property ;
    rdfs:label 'Applies To Meter Type' ;
    rdfs:comment 'Type of utility meters this rule set applies to: electric meters, gas meters, water meters, or all meter types.' ;
    rdfs:domain ind:VeeRuleSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appliesToRateSchedule rdf:type rdf:Property ;
    rdfs:label 'Applies To Rate Schedule' ;
    rdfs:comment 'Specific rate schedule codes this rule set applies to. Null indicates the rule set applies to all rate schedules.' ;
    rdfs:domain ind:VeeRuleSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditTrailEnabled rdf:type rdf:Property ;
    rdfs:label 'Audit Trail Enabled' ;
    rdfs:comment 'Indicates whether detailed audit logging is enabled for all data modifications made by this rule set.' ;
    rdfs:domain ind:VeeRuleSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:autoCorrectionEnabled rdf:type rdf:Property ;
    rdfs:label 'Auto Correction Enabled' ;
    rdfs:comment 'Indicates whether this rule set is authorized to automatically correct meter data without manual review.' ;
    rdfs:domain ind:VeeRuleSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:errorCodePrefix rdf:type rdf:Property ;
    rdfs:label 'Error Code Prefix' ;
    rdfs:comment 'Prefix used for error codes generated when this rule set identifies data quality issues.' ;
    rdfs:domain ind:VeeRuleSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:executionSequence rdf:type rdf:Property ;
    rdfs:label 'Execution Sequence' ;
    rdfs:comment 'Order in which this rule set is executed within its priority level during VEE processing workflows.' ;
    rdfs:domain ind:VeeRuleSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lookbackPeriodDays rdf:type rdf:Property ;
    rdfs:label 'Lookback Period Days' ;
    rdfs:comment 'Number of days of historical data used for validation comparisons and estimation calculations.' ;
    rdfs:domain ind:VeeRuleSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:manualReviewRequired rdf:type rdf:Property ;
    rdfs:label 'Manual Review Required' ;
    rdfs:comment 'Indicates whether data processed by this rule set requires manual analyst review before being released to billing systems.' ;
    rdfs:domain ind:VeeRuleSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mdmsSystemCode rdf:type rdf:Property ;
    rdfs:label 'Mdms System Code' ;
    rdfs:comment 'External identifier for this rule set in the source MDMS platform (Oracle Utilities MDMS or Itron Analytics).' ;
    rdfs:domain ind:VeeRuleSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumDataQualityScore rdf:type rdf:Property ;
    rdfs:label 'Minimum Data Quality Score' ;
    rdfs:comment 'Minimum acceptable data quality score (0-100) for meter data processed by this rule set. Data below this threshold is flagged for review.' ;
    rdfs:domain ind:VeeRuleSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ruleLogicExpression rdf:type rdf:Property ;
    rdfs:label 'Rule Logic Expression' ;
    rdfs:comment 'Technical expression or pseudocode defining the validation, estimation, or editing logic implemented by this rule set.' ;
    rdfs:domain ind:VeeRuleSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ruleSetCategory rdf:type rdf:Property ;
    rdfs:label 'Rule Set Category' ;
    rdfs:comment 'Business category of the rule set based on the type of meter data it processes: interval consumption data, register reads, demand measurements, power quality events, outage detection, or tamper detection.' ;
    rdfs:domain ind:VeeRuleSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ruleSetCode rdf:type rdf:Property ;
    rdfs:label 'Rule Set Code' ;
    rdfs:comment 'Business identifier code for the VEE rule set used in meter data management systems and operational workflows.' ;
    rdfs:domain ind:VeeRuleSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ruleSetDescription rdf:type rdf:Property ;
    rdfs:label 'Rule Set Description' ;
    rdfs:comment 'Detailed description of the VEE rule set including its validation logic, estimation algorithms, and editing procedures.' ;
    rdfs:domain ind:VeeRuleSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ruleSetName rdf:type rdf:Property ;
    rdfs:label 'Rule Set Name' ;
    rdfs:comment 'Human-readable name of the VEE rule set describing its purpose and application context.' ;
    rdfs:domain ind:VeeRuleSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ruleSetType rdf:type rdf:Property ;
    rdfs:label 'Rule Set Type' ;
    rdfs:comment 'Classification of the rule set by its primary function: validation (data quality checks), estimation (missing data inference), editing (data correction), or composite (multiple functions).' ;
    rdfs:domain ind:VeeRuleSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationThresholdPercent rdf:type rdf:Property ;
    rdfs:label 'Validation Threshold Percent' ;
    rdfs:comment 'Percentage threshold for validation rules. Data variance exceeding this threshold triggers validation failure flags.' ;
    rdfs:domain ind:VeeRuleSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:violationId rdf:type rdf:Property ;
    rdfs:label 'Violation Id' ;
    rdfs:comment 'Reference to the underlying violation, non-compliance finding, or audit exception that triggered this corrective action plan.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Violation .

ind:actualCostAmount rdf:type rdf:Property ;
    rdfs:label 'Actual Cost Amount' ;
    rdfs:comment 'Actual total cost in USD incurred to implement the corrective action plan, tracked upon completion.' ;
    rdfs:domain ind:CorrectiveActionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:closureNotes rdf:type rdf:Property ;
    rdfs:label 'Closure Notes' ;
    rdfs:comment 'Final notes or comments documenting the closure of the corrective action plan, including any lessons learned or follow-up actions required.' ;
    rdfs:domain ind:CorrectiveActionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedCostAmount rdf:type rdf:Property ;
    rdfs:label 'Estimated Cost Amount' ;
    rdfs:comment 'Projected total cost in USD to implement all corrective actions, including capital expenditures, operational expenses, consulting fees, and internal labor.' ;
    rdfs:domain ind:CorrectiveActionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:extensionGrantedFlag rdf:type rdf:Property ;
    rdfs:label 'Extension Granted Flag' ;
    rdfs:comment 'Indicates whether the regulatory authority granted an extension to the original target completion date.' ;
    rdfs:domain ind:CorrectiveActionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:extensionRequestedFlag rdf:type rdf:Property ;
    rdfs:label 'Extension Requested Flag' ;
    rdfs:comment 'Indicates whether an extension to the target completion date has been requested from the regulatory authority.' ;
    rdfs:domain ind:CorrectiveActionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:internalAuditReference rdf:type rdf:Property ;
    rdfs:label 'Internal Audit Reference' ;
    rdfs:comment 'Reference to the internal audit report or compliance assessment that identified the deficiency requiring corrective action.' ;
    rdfs:domain ind:CorrectiveActionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:milestoneCount rdf:type rdf:Property ;
    rdfs:label 'Milestone Count' ;
    rdfs:comment 'Total number of discrete milestones or action items defined within the corrective action plan.' ;
    rdfs:domain ind:CorrectiveActionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:milestonesCompletedCount rdf:type rdf:Property ;
    rdfs:label 'Milestones Completed Count' ;
    rdfs:comment 'Number of milestones that have been completed and verified as of the current reporting date.' ;
    rdfs:domain ind:CorrectiveActionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:penaltyMitigationFlag rdf:type rdf:Property ;
    rdfs:label 'Penalty Mitigation Flag' ;
    rdfs:comment 'Indicates whether successful completion of the corrective action plan resulted in reduction or waiver of the assessed penalty.' ;
    rdfs:domain ind:CorrectiveActionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:percentComplete rdf:type rdf:Property ;
    rdfs:label 'Percent Complete' ;
    rdfs:comment 'Overall completion percentage of the corrective action plan, calculated as (milestones_completed_count / milestone_count) * 100.' ;
    rdfs:domain ind:CorrectiveActionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:planDescription rdf:type rdf:Property ;
    rdfs:label 'Plan Description' ;
    rdfs:comment 'Detailed narrative describing the corrective actions, remediation steps, process improvements, and controls to be implemented to address the identified deficiency or violation.' ;
    rdfs:domain ind:CorrectiveActionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planNumber rdf:type rdf:Property ;
    rdfs:label 'Plan Number' ;
    rdfs:comment 'Business identifier for the corrective action plan, typically assigned by the regulatory body or internal compliance system.' ;
    rdfs:domain ind:CorrectiveActionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planOwnerEmail rdf:type rdf:Property ;
    rdfs:label 'Plan Owner Email' ;
    rdfs:comment 'Email address of the individual or team responsible for day-to-day management and execution of the corrective action plan.' ;
    rdfs:domain ind:CorrectiveActionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planStatus rdf:type rdf:Property ;
    rdfs:label 'Plan Status' ;
    rdfs:comment 'Current lifecycle status of the corrective action plan indicating its stage in the regulatory review and implementation process.' ;
    rdfs:domain ind:CorrectiveActionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planTitle rdf:type rdf:Property ;
    rdfs:label 'Plan Title' ;
    rdfs:comment 'Descriptive title or name of the corrective action plan summarizing the remediation focus.' ;
    rdfs:domain ind:CorrectiveActionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:prudencyReviewRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Prudency Review Required Flag' ;
    rdfs:comment 'Indicates whether the corrective action plan costs are subject to a prudency review by the regulatory commission to determine cost recovery eligibility.' ;
    rdfs:domain ind:CorrectiveActionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recurrenceRiskLevel rdf:type rdf:Property ;
    rdfs:label 'Recurrence Risk Level' ;
    rdfs:comment 'Assessment of the likelihood that the underlying violation or non-compliance issue will recur after corrective actions are implemented.' ;
    rdfs:domain ind:CorrectiveActionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsibleDepartment rdf:type rdf:Property ;
    rdfs:label 'Responsible Department' ;
    rdfs:comment 'The internal department, business unit, or functional area responsible for executing and completing the corrective action plan.' ;
    rdfs:domain ind:Regulatory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsibleOfficerName rdf:type rdf:Property ;
    rdfs:label 'Responsible Officer Name' ;
    rdfs:comment 'Name of the executive or officer accountable for ensuring the corrective action plan is completed and compliance is restored.' ;
    rdfs:domain ind:CorrectiveActionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revisedCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Revised Completion Date' ;
    rdfs:comment 'Updated target completion date following approval of an extension or plan modification by the regulatory authority.' ;
    rdfs:domain ind:CorrectiveActionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rootCauseAnalysisCompletedFlag rdf:type rdf:Property ;
    rdfs:label 'Root Cause Analysis Completed Flag' ;
    rdfs:comment 'Indicates whether a formal root cause analysis was conducted to identify the underlying systemic issues that led to the violation.' ;
    rdfs:domain ind:CorrectiveActionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rootCauseSummary rdf:type rdf:Property ;
    rdfs:label 'Root Cause Summary' ;
    rdfs:comment 'Summary of the root cause analysis findings identifying the fundamental reasons for the non-compliance or deficiency.' ;
    rdfs:domain ind:CorrectiveActionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Target Completion Date' ;
    rdfs:comment 'Planned or mandated date by which all corrective actions must be completed and compliance fully restored.' ;
    rdfs:domain ind:CorrectiveActionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:verificationMethod rdf:type rdf:Property ;
    rdfs:label 'Verification Method' ;
    rdfs:comment 'The method or process used to verify completion and effectiveness of corrective actions (e.g., internal audit, third-party assessment, regulatory inspection, self-certification).' ;
    rdfs:domain ind:CorrectiveActionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capacityUnitOfMeasure rdf:type rdf:Property ;
    rdfs:label 'Capacity Unit Of Measure' ;
    rdfs:comment 'Unit of measurement for the facility capacity. MW for electric generation, MVA for substations, MCF or MMBTU for gas facilities.' ;
    rdfs:domain ind:Facility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:constructionCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Construction Completion Date' ;
    rdfs:comment 'Date when construction was substantially completed and the facility was ready for commissioning or placed in service.' ;
    rdfs:domain ind:Facility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:environmentalPermitRequired rdf:type rdf:Property ;
    rdfs:label 'Environmental Permit Required' ;
    rdfs:comment 'Indicates whether the facility requires environmental permits or regulatory approvals for operation (e.g., air quality, water discharge, hazardous materials).' ;
    rdfs:domain ind:Facility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:facilityCode rdf:type rdf:Property ;
    rdfs:label 'Facility Code' ;
    rdfs:comment 'Externally-known unique business identifier for the facility, used across operational systems and regulatory reporting. Typically assigned by the enterprise asset management system.' ;
    rdfs:domain ind:Facility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilitySubtype rdf:type rdf:Property ;
    rdfs:label 'Facility Subtype' ;
    rdfs:comment 'Detailed classification providing additional granularity within the facility type (e.g., coal plant, solar farm, switching station, distribution warehouse).' ;
    rdfs:domain ind:Facility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nameplateCapacity rdf:type rdf:Property ;
    rdfs:label 'Nameplate Capacity' ;
    rdfs:comment 'Maximum rated capacity of the facility in megawatts (MW) for generation facilities, or maximum throughput capacity for transmission and distribution facilities.' ;
    rdfs:domain ind:Facility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:operatingOrganization rdf:type rdf:Property ;
    rdfs:label 'Operating Organization' ;
    rdfs:comment 'Business unit or department responsible for day-to-day operations and maintenance of the facility.' ;
    rdfs:domain ind:Facility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownerOrganization rdf:type rdf:Property ;
    rdfs:label 'Owner Organization' ;
    rdfs:comment 'Business unit or legal entity that owns the facility for financial and regulatory reporting purposes.' ;
    rdfs:domain ind:Facility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:balancingAuthorityId rdf:type rdf:Property ;
    rdfs:label 'Balancing Authority Id' ;
    rdfs:comment 'FK to transmission.balancing_authority' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BalancingAuthority .

ind:fromTransmissionSubstationId rdf:type rdf:Property ;
    rdfs:label 'From Transmission Substation Id' ;
    rdfs:comment 'FK to transmission.transmission_substation' ;
    rdfs:domain ind:ConstrainedElement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TransmissionSubstation .

ind:lmpNodeId rdf:type rdf:Property ;
    rdfs:label 'Lmp Node Id' ;
    rdfs:comment 'Associated LMP pricing node identifier used for market settlement and congestion pricing at this element.' ;
    rdfs:domain ind:ConstrainedElement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PricingNode .

ind:cipClassification rdf:type rdf:Property ;
    rdfs:label 'Cip Classification' ;
    rdfs:comment 'NERC CIP impact rating classification for cybersecurity and physical security requirements.' ;
    rdfs:domain ind:ConstrainedElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:circuitNumber rdf:type rdf:Property ;
    rdfs:label 'Circuit Number' ;
    rdfs:comment 'Circuit identifier for parallel transmission lines between the same substations.' ;
    rdfs:domain ind:ConstrainedElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contingencyFlag rdf:type rdf:Property ;
    rdfs:label 'Contingency Flag' ;
    rdfs:comment 'Indicates whether this element is monitored as part of contingency analysis for N-1 or N-2 reliability assessments.' ;
    rdfs:domain ind:ConstrainedElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:elementIdentifier rdf:type rdf:Property ;
    rdfs:label 'Element Identifier' ;
    rdfs:comment 'External business identifier or code used by RTO/ISO and market participants to reference this constrained element (e.g., flowgate ID, contingency element ID).' ;
    rdfs:domain ind:ConstrainedElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:elementName rdf:type rdf:Property ;
    rdfs:label 'Element Name' ;
    rdfs:comment 'Human-readable name or designation of the constrained transmission element (e.g., line name, transformer name, interface name).' ;
    rdfs:domain ind:ConstrainedElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:elementType rdf:type rdf:Property ;
    rdfs:label 'Element Type' ;
    rdfs:comment 'Classification of the constrained element by infrastructure type within the bulk electric system.' ;
    rdfs:domain ind:ConstrainedElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographicLatitude rdf:type rdf:Property ;
    rdfs:label 'Geographic Latitude' ;
    rdfs:comment 'Latitude coordinate of the constrained element location in decimal degrees.' ;
    rdfs:domain ind:ConstrainedElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:geographicLongitude rdf:type rdf:Property ;
    rdfs:label 'Geographic Longitude' ;
    rdfs:comment 'Longitude coordinate of the constrained element location in decimal degrees.' ;
    rdfs:domain ind:ConstrainedElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interconnectionQueueFlag rdf:type rdf:Property ;
    rdfs:label 'Interconnection Queue Flag' ;
    rdfs:comment 'Indicates whether this element is associated with pending generator interconnection requests that may affect its constraint status.' ;
    rdfs:domain ind:ConstrainedElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:normalRatingMva rdf:type rdf:Property ;
    rdfs:label 'Normal Rating Mva' ;
    rdfs:comment 'Normal continuous operating rating of the element in megavolt-amperes (MVA) under standard ambient conditions.' ;
    rdfs:domain ind:ConstrainedElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:oattServiceType rdf:type rdf:Property ;
    rdfs:label 'Oatt Service Type' ;
    rdfs:comment 'Type of transmission service available on this element under FERC OATT requirements.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seasonalRatingFlag rdf:type rdf:Property ;
    rdfs:label 'Seasonal Rating Flag' ;
    rdfs:comment 'Indicates whether this element has different ratings based on seasonal ambient temperature conditions.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transmissionOwner rdf:type rdf:Property ;
    rdfs:label 'Transmission Owner' ;
    rdfs:comment 'The entity that owns and maintains the physical transmission infrastructure for this constrained element.' ;
    rdfs:domain ind:ConstrainedElement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fromSubstationId rdf:type rdf:Property ;
    rdfs:label 'From Substation Id' ;
    rdfs:comment 'Identifier of the originating substation or node at one end of the flowgate for directional flow analysis.' ;
    rdfs:domain ind:Flowgate ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TransmissionSubstation .

ind:toSubstationId rdf:type rdf:Property ;
    rdfs:label 'To Substation Id' ;
    rdfs:comment 'Identifier of the destination substation or node at the other end of the flowgate for directional flow analysis.' ;
    rdfs:domain ind:Flowgate ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TransmissionSubstation .

ind:congestionThresholdPercent rdf:type rdf:Property ;
    rdfs:label 'Congestion Threshold Percent' ;
    rdfs:comment 'Percentage of capacity utilization at which the flowgate is considered congested and may trigger transmission loading relief or pricing adjustments.' ;
    rdfs:domain ind:Flowgate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contingencyRatingMw rdf:type rdf:Property ;
    rdfs:label 'Contingency Rating Mw' ;
    rdfs:comment 'Power transfer limit for the flowgate under single contingency conditions (N-1 criteria) to maintain system reliability.' ;
    rdfs:domain ind:Flowgate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:criticalInfrastructureFlag rdf:type rdf:Property ;
    rdfs:label 'Critical Infrastructure Flag' ;
    rdfs:comment 'Indicates whether this flowgate is designated as critical infrastructure under NERC CIP standards requiring enhanced cybersecurity and physical security controls.' ;
    rdfs:domain ind:UtilityCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:emergencyCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Emergency Capacity Mw' ;
    rdfs:comment 'Maximum power transfer capacity of the flowgate under emergency operating conditions, typically higher than normal capacity for short durations.' ;
    rdfs:domain ind:Flowgate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:flowgateCode rdf:type rdf:Property ;
    rdfs:label 'Flowgate Code' ;
    rdfs:comment 'Externally-known unique code or identifier for the flowgate used in interchange scheduling and RTO/ISO coordination.' ;
    rdfs:domain ind:Flowgate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flowgateName rdf:type rdf:Property ;
    rdfs:label 'Flowgate Name' ;
    rdfs:comment 'Human-readable name or designation of the flowgate used for operational identification and communication.' ;
    rdfs:domain ind:Flowgate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flowgateType rdf:type rdf:Property ;
    rdfs:label 'Flowgate Type' ;
    rdfs:comment 'Classification of the flowgate based on the physical infrastructure element it represents (transmission line, transformer, interface, corridor, or path).' ;
    rdfs:domain ind:Flowgate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographicRegion rdf:type rdf:Property ;
    rdfs:label 'Geographic Region' ;
    rdfs:comment 'Geographic area or market zone in which the flowgate is located, used for regional transmission planning and congestion management.' ;
    rdfs:domain ind:Flowgate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:monitoringRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Monitoring Required Flag' ;
    rdfs:comment 'Indicates whether real-time monitoring and reporting of this flowgate is required for reliability coordination and market operations.' ;
    rdfs:domain ind:Flowgate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:parallelPathAdjustmentFactor rdf:type rdf:Property ;
    rdfs:label 'Parallel Path Adjustment Factor' ;
    rdfs:comment 'Factor used to account for loop flow and parallel path impacts when calculating Available Transfer Capability (ATC) across this flowgate.' ;
    rdfs:domain ind:Flowgate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:affectedVoltageClassKv rdf:type rdf:Property ;
    rdfs:label 'Affected Voltage Class Kv' ;
    rdfs:comment 'Voltage level(s) of the Bulk Electric System (BES) facilities affected by the contingency scenario, expressed in kilovolts.' ;
    rdfs:domain ind:ContingencyScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cascadingPotentialFlag rdf:type rdf:Property ;
    rdfs:label 'Cascading Potential Flag' ;
    rdfs:comment 'Indicator of whether the contingency scenario has the potential to result in cascading outages beyond the initial event.' ;
    rdfs:domain ind:ContingencyScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:category rdf:type rdf:Property ;
    rdfs:label 'Category' ;
    rdfs:comment 'NERC Transmission Planning (TPL) category designation (P0 through P7) indicating the severity and probability class of the contingency.' ;
    rdfs:domain ind:ContingencyScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commonModeFlag rdf:type rdf:Property ;
    rdfs:label 'Common Mode Flag' ;
    rdfs:comment 'Indicator of whether the contingency scenario involves common mode failures affecting multiple facilities simultaneously.' ;
    rdfs:domain ind:ContingencyScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fercReportableFlag rdf:type rdf:Property ;
    rdfs:label 'Ferc Reportable Flag' ;
    rdfs:comment 'Indicator of whether the contingency scenario results must be included in FERC jurisdictional reporting.' ;
    rdfs:domain ind:ContingencyScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:generationDispatch rdf:type rdf:Property ;
    rdfs:label 'Generation Dispatch' ;
    rdfs:comment 'Description of the generation resource commitment and dispatch pattern assumed in the contingency scenario analysis.' ;
    rdfs:domain ind:ContingencyScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographicScope rdf:type rdf:Property ;
    rdfs:label 'Geographic Scope' ;
    rdfs:comment 'Spatial extent of the contingency scenario impact across the transmission system footprint.' ;
    rdfs:domain ind:ContingencyScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:initiatingEvent rdf:type rdf:Property ;
    rdfs:label 'Initiating Event' ;
    rdfs:comment 'Primary triggering event or equipment failure that defines the start of the contingency scenario sequence.' ;
    rdfs:domain ind:ContingencyScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastReviewDate rdf:type rdf:Property ;
    rdfs:label 'Last Review Date' ;
    rdfs:comment 'Most recent date on which the contingency scenario definition was reviewed and validated by planning engineers.' ;
    rdfs:domain ind:ContingencyScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:loadLevel rdf:type rdf:Property ;
    rdfs:label 'Load Level' ;
    rdfs:comment 'System demand condition under which the contingency scenario is evaluated in planning studies.' ;
    rdfs:domain ind:ContingencyScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextReviewDate rdf:type rdf:Property ;
    rdfs:label 'Next Review Date' ;
    rdfs:comment 'Scheduled date for the next periodic review and update of the contingency scenario definition.' ;
    rdfs:domain ind:ContingencyScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:outageCount rdf:type rdf:Property ;
    rdfs:label 'Outage Count' ;
    rdfs:comment 'Number of simultaneous equipment or facility outages included in the contingency scenario definition.' ;
    rdfs:domain ind:ContingencyScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:probabilityClass rdf:type rdf:Property ;
    rdfs:label 'Probability Class' ;
    rdfs:comment 'Expected likelihood classification of the contingency scenario occurrence based on historical data and engineering judgment.' ;
    rdfs:domain ind:ContingencyScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rtoIsoCoordinationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Rto Iso Coordination Required Flag' ;
    rdfs:comment 'Indicator of whether the contingency scenario requires coordination with the RTO or ISO for analysis or operational response.' ;
    rdfs:domain ind:ContingencyScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scenarioCode rdf:type rdf:Property ;
    rdfs:label 'Scenario Code' ;
    rdfs:comment 'Externally-known unique code identifying the contingency scenario for planning and operational reference.' ;
    rdfs:domain ind:ContingencyScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scenarioName rdf:type rdf:Property ;
    rdfs:label 'Scenario Name' ;
    rdfs:comment 'Human-readable name of the contingency scenario describing the event or condition being modeled.' ;
    rdfs:domain ind:ContingencyScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scenarioType rdf:type rdf:Property ;
    rdfs:label 'Scenario Type' ;
    rdfs:comment 'Classification of the contingency scenario based on the number and nature of simultaneous outages or events.' ;
    rdfs:domain ind:ContingencyScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:season rdf:type rdf:Property ;
    rdfs:label 'Season' ;
    rdfs:comment 'Seasonal period during which the contingency scenario is most relevant or critical for planning analysis.' ;
    rdfs:domain ind:ContingencyScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceDocument rdf:type rdf:Property ;
    rdfs:label 'Source Document' ;
    rdfs:comment 'Reference to the planning study, engineering report, or regulatory filing that defines or documents the contingency scenario.' ;
    rdfs:domain ind:ContingencyScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentControlAreaId rdf:type rdf:Property ;
    rdfs:label 'Parent Control Area Id' ;
    rdfs:comment 'Reference to a parent or umbrella control area if this control area is a sub-area or nested within a larger operational boundary.' ;
    rdfs:domain ind:ControlArea ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ControlArea .

ind:balancingAuthorityFlag rdf:type rdf:Property ;
    rdfs:label 'Balancing Authority Flag' ;
    rdfs:comment 'Indicates whether this control area is registered as a NERC Balancing Authority responsible for load-resource balance within its metered boundaries.' ;
    rdfs:domain ind:ControlArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cipCriticalAssetFlag rdf:type rdf:Property ;
    rdfs:label 'Cip Critical Asset Flag' ;
    rdfs:comment 'Indicates whether this control area contains facilities designated as critical cyber assets under NERC CIP standards.' ;
    rdfs:domain ind:ControlArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contactName rdf:type rdf:Property ;
    rdfs:label 'Contact Name' ;
    rdfs:comment 'Name of the primary operational contact or control area operator responsible for coordination and communications.' ;
    rdfs:domain ind:ControlArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:controlPerformanceStandard1Target rdf:type rdf:Property ;
    rdfs:label 'Control Performance Standard 1 Target' ;
    rdfs:comment 'Target compliance value for NERC Control Performance Standard 1, measuring frequency control performance over a rolling 12-month period.' ;
    rdfs:domain ind:ControlArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:controlPerformanceStandard2Target rdf:type rdf:Property ;
    rdfs:label 'Control Performance Standard 2 Target' ;
    rdfs:comment 'Target compliance value for NERC Control Performance Standard 2, measuring the control area\'s ability to limit unscheduled flow.' ;
    rdfs:domain ind:ControlArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disturbanceControlStandardTargetMinutes rdf:type rdf:Property ;
    rdfs:label 'Disturbance Control Standard Target Minutes' ;
    rdfs:comment 'Target recovery time in minutes for returning Area Control Error to specified limits following a reportable disturbance, per NERC DCS requirements.' ;
    rdfs:domain ind:ControlArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fercJurisdictionalFlag rdf:type rdf:Property ;
    rdfs:label 'Ferc Jurisdictional Flag' ;
    rdfs:comment 'Indicates whether this control area falls under FERC jurisdiction for interstate transmission and wholesale power transactions.' ;
    rdfs:domain ind:ControlArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:frequencyBiasSettingMwPer01Hz rdf:type rdf:Property ;
    rdfs:label 'Frequency Bias Setting Mw Per 0 1 Hz' ;
    rdfs:comment 'The frequency bias setting in MW per 0.1 Hz used in Area Control Error (ACE) calculations for automatic generation control.' ;
    rdfs:domain ind:ControlArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:installedGenerationCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Installed Generation Capacity Mw' ;
    rdfs:comment 'Total installed generation capacity in megawatts within the control area boundaries.' ;
    rdfs:domain ind:ControlArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interconnection rdf:type rdf:Property ;
    rdfs:label 'Interconnection' ;
    rdfs:comment 'The major North American interconnection to which this control area belongs. Defines the synchronous grid boundary.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nercRegistrationNumber rdf:type rdf:Property ;
    rdfs:label 'Nerc Registration Number' ;
    rdfs:comment 'Official NERC registration identifier assigned to this control area for compliance and reporting purposes.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextAuditDate rdf:type rdf:Property ;
    rdfs:label 'Next Audit Date' ;
    rdfs:comment 'Scheduled date for the next NERC compliance audit or reliability assessment.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:oattOnFileFlag rdf:type rdf:Property ;
    rdfs:label 'Oatt On File Flag' ;
    rdfs:comment 'Indicates whether this control area has an approved Open Access Transmission Tariff on file with FERC for non-discriminatory transmission service.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reliabilityCoordinatorCode rdf:type rdf:Property ;
    rdfs:label 'Reliability Coordinator Code' ;
    rdfs:comment 'Reference to the NERC Reliability Coordinator that provides wide-area reliability oversight for this control area.' ;
    rdfs:domain ind:ControlArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rtoIsoAffiliation rdf:type rdf:Property ;
    rdfs:label 'Rto Iso Affiliation' ;
    rdfs:comment 'Name of the RTO or ISO that operates or coordinates this control area, if applicable. Examples include PJM, MISO, CAISO, NYISO, ISO-NE, SPP.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceTerritoryDescription rdf:type rdf:Property ;
    rdfs:label 'Service Territory Description' ;
    rdfs:comment 'Textual description of the geographic or jurisdictional boundaries served by this control area.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transmissionOperatorFlag rdf:type rdf:Property ;
    rdfs:label 'Transmission Operator Flag' ;
    rdfs:comment 'Indicates whether this control area operates transmission facilities and is registered as a NERC Transmission Operator.' ;
    rdfs:domain ind:ControlArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:type rdf:type rdf:Property ;
    rdfs:label 'Type' ;
    rdfs:comment 'Functional classification of the control area based on its operational role within the bulk electric system.' ;
    rdfs:domain ind:Transmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aceReportingFlag rdf:type rdf:Property ;
    rdfs:label 'Ace Reporting Flag' ;
    rdfs:comment 'Indicates whether this balancing authority reports Area Control Error (ACE) metrics to NERC for compliance monitoring.' ;
    rdfs:domain ind:BalancingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:baCode rdf:type rdf:Property ;
    rdfs:label 'Ba Code' ;
    rdfs:comment 'Standard alphanumeric code assigned to the balancing authority by NERC. Typically 2-4 uppercase letters (e.g., PJM, MISO, CAISO, ERCOT).' ;
    rdfs:domain ind:BalancingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:baName rdf:type rdf:Property ;
    rdfs:label 'Ba Name' ;
    rdfs:comment 'Full legal or operating name of the balancing authority organization.' ;
    rdfs:domain ind:BalancingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:baType rdf:type rdf:Property ;
    rdfs:label 'Ba Type' ;
    rdfs:comment 'Classification of the balancing authority organizational structure: Independent System Operator (ISO), Regional Transmission Organization (RTO), investor-owned utility, cooperative, federal power authority, or municipal utility.' ;
    rdfs:domain ind:BalancingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cps1ThresholdPercent rdf:type rdf:Property ;
    rdfs:label 'Cps1 Threshold Percent' ;
    rdfs:comment 'NERC Control Performance Standard 1 (CPS1) compliance threshold percentage for this balancing authority. CPS1 measures how well the BA controls ACE over a one-year period.' ;
    rdfs:domain ind:BalancingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disturbanceControlStandardMw rdf:type rdf:Property ;
    rdfs:label 'Disturbance Control Standard Mw' ;
    rdfs:comment 'NERC Disturbance Control Standard (DCS) requirement for this balancing authority, representing the most severe single contingency loss in megawatts (MW).' ;
    rdfs:domain ind:BalancingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:headquartersAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Headquarters Address Line1' ;
    rdfs:comment 'First line of the street address for the balancing authority headquarters or control center.' ;
    rdfs:domain ind:BalancingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:headquartersAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Headquarters Address Line2' ;
    rdfs:comment 'Second line of the street address for the balancing authority headquarters (suite, floor, building).' ;
    rdfs:domain ind:BalancingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:headquartersCountryCode rdf:type rdf:Property ;
    rdfs:label 'Headquarters Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code for the balancing authority headquarters location (USA, CAN, MEX).' ;
    rdfs:domain ind:BalancingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastComplianceAuditDate rdf:type rdf:Property ;
    rdfs:label 'Last Compliance Audit Date' ;
    rdfs:comment 'Date of the most recent NERC compliance audit conducted for this balancing authority.' ;
    rdfs:domain ind:BalancingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:marketOperatorFlag rdf:type rdf:Property ;
    rdfs:label 'Market Operator Flag' ;
    rdfs:comment 'Indicates whether this balancing authority operates organized wholesale electricity markets (day-ahead, real-time energy, capacity, ancillary services).' ;
    rdfs:domain ind:BalancingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nextComplianceAuditDate rdf:type rdf:Property ;
    rdfs:label 'Next Compliance Audit Date' ;
    rdfs:comment 'Scheduled date for the next NERC compliance audit for this balancing authority.' ;
    rdfs:domain ind:BalancingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:registeredCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Registered Capacity Mw' ;
    rdfs:comment 'Total registered generation capacity under the balancing authority control area, measured in megawatts (MW).' ;
    rdfs:domain ind:BalancingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:registrationEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Registration Effective Date' ;
    rdfs:comment 'Date when the balancing authority registration with NERC became effective.' ;
    rdfs:domain ind:BalancingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:registrationExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Registration Expiration Date' ;
    rdfs:comment 'Date when the balancing authority registration with NERC expires or is scheduled for renewal. Null for indefinite registrations.' ;
    rdfs:domain ind:BalancingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:serviceTerritoryAreaSqMi rdf:type rdf:Property ;
    rdfs:label 'Service Territory Area Sq Mi' ;
    rdfs:comment 'Geographic area covered by the balancing authority service territory, measured in square miles.' ;
    rdfs:domain ind:BalancingAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:backupControlCenterId rdf:type rdf:Property ;
    rdfs:label 'Backup Control Center Id' ;
    rdfs:comment 'Reference to the designated backup control center that can assume operational control if this primary control center becomes unavailable.' ;
    rdfs:domain ind:ControlCenter ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ControlCenter .

ind:annualOperatingBudgetUsd rdf:type rdf:Property ;
    rdfs:label 'Annual Operating Budget Usd' ;
    rdfs:comment 'Annual operating budget allocated for this control center in US dollars. Business-confidential financial data.' ;
    rdfs:domain ind:ControlCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:certificationExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Certification Expiry Date' ;
    rdfs:comment 'Expiration date of the control center operational certification or NERC registration requiring renewal.' ;
    rdfs:domain ind:ControlCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:controlAreaMwCapacity rdf:type rdf:Property ;
    rdfs:label 'Control Area Mw Capacity' ;
    rdfs:comment 'Total generation capacity in megawatts under the operational control of this control center.' ;
    rdfs:domain ind:ControlCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:controlCenterCode rdf:type rdf:Property ;
    rdfs:label 'Control Center Code' ;
    rdfs:comment 'Unique alphanumeric code assigned to the control center for system identification and interchange scheduling. Used in OASIS postings and RTO/ISO communications.' ;
    rdfs:domain ind:ControlCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disasterRecoverySiteLocation rdf:type rdf:Property ;
    rdfs:label 'Disaster Recovery Site Location' ;
    rdfs:comment 'Geographic location description of the disaster recovery or backup site for this control center. Confidential for security reasons.' ;
    rdfs:domain ind:ControlCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emergencyPhone rdf:type rdf:Property ;
    rdfs:label 'Emergency Phone' ;
    rdfs:comment '24/7 emergency contact telephone number for the control center used during grid disturbances or critical events. Business-confidential organizational contact data.' ;
    rdfs:domain ind:ControlCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emsPlatformVersion rdf:type rdf:Property ;
    rdfs:label 'Ems Platform Version' ;
    rdfs:comment 'Version identifier of the energy management system software platform deployed at this control center.' ;
    rdfs:domain ind:ControlCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isPrimaryControlCenter rdf:type rdf:Property ;
    rdfs:label 'Is Primary Control Center' ;
    rdfs:comment 'Indicates whether this control center serves as the primary operational control facility (true) or a backup/secondary facility (false).' ;
    rdfs:domain ind:ControlCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:monitoredTransmissionElementsCount rdf:type rdf:Property ;
    rdfs:label 'Monitored Transmission Elements Count' ;
    rdfs:comment 'Number of bulk electric system transmission elements (lines, transformers, breakers) actively monitored by this control center.' ;
    rdfs:domain ind:ControlCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:nercRegisteredEntityNumber rdf:type rdf:Property ;
    rdfs:label 'Nerc Registered Entity Number' ;
    rdfs:comment 'NERC-assigned identifier for the registered entity operating this control center. Required for compliance reporting and CIP standards adherence.' ;
    rdfs:domain ind:ControlCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Primary Address Line 1' ;
    rdfs:comment 'First line of the physical street address where the control center facility is located. Business-confidential organizational location data.' ;
    rdfs:domain ind:ControlCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Primary Address Line 2' ;
    rdfs:comment 'Second line of the physical street address (suite, floor, building) for the control center facility. Business-confidential organizational location data.' ;
    rdfs:domain ind:ControlCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryEmail rdf:type rdf:Property ;
    rdfs:label 'Primary Email' ;
    rdfs:comment 'Primary email address for operational communications with the control center. Business-confidential organizational contact data.' ;
    rdfs:domain ind:ControlCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:redundancyLevel rdf:type rdf:Property ;
    rdfs:label 'Redundancy Level' ;
    rdfs:comment 'Level of system redundancy implemented at the control center for critical systems and infrastructure.' ;
    rdfs:domain ind:ControlCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scadaSystemVendor rdf:type rdf:Property ;
    rdfs:label 'Scada System Vendor' ;
    rdfs:comment 'Name of the primary SCADA system vendor providing the energy management system platform for this control center.' ;
    rdfs:domain ind:ControlCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:staffingLevel rdf:type rdf:Property ;
    rdfs:label 'Staffing Level' ;
    rdfs:comment 'Typical number of operators and support personnel staffing the control center during normal operations.' ;
    rdfs:domain ind:ControlCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supportsMarketOperations rdf:type rdf:Property ;
    rdfs:label 'Supports Market Operations' ;
    rdfs:comment 'Indicates whether this control center performs energy market operations including day-ahead and real-time market functions.' ;
    rdfs:domain ind:ControlCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:supportsRealTimeOperations rdf:type rdf:Property ;
    rdfs:label 'Supports Real Time Operations' ;
    rdfs:comment 'Indicates whether this control center is equipped and staffed for real-time grid monitoring and control operations.' ;
    rdfs:domain ind:ControlCenter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deregistrationDate rdf:type rdf:Property ;
    rdfs:label 'Deregistration Date' ;
    rdfs:comment 'Date when the operator ceased operations or was deregistered from NERC, if applicable.' ;
    rdfs:domain ind:Operator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nercCipComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Nerc Cip Compliance Flag' ;
    rdfs:comment 'Indicates whether the operator is subject to NERC CIP cybersecurity standards for bulk electric system protection.' ;
    rdfs:domain ind:Operator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:oasisNodeUrl rdf:type rdf:Property ;
    rdfs:label 'Oasis Node Url' ;
    rdfs:comment 'Web address of the operator\'s OASIS node for posting available transmission capacity and accepting transmission service requests.' ;
    rdfs:domain ind:Operator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:oattTariffNumber rdf:type rdf:Property ;
    rdfs:label 'Oatt Tariff Number' ;
    rdfs:comment 'FERC-approved tariff number under which the operator provides transmission service. Required for FERC jurisdictional operators.' ;
    rdfs:domain ind:Operator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operatorCode rdf:type rdf:Property ;
    rdfs:label 'Operator Code' ;
    rdfs:comment 'Standardized alphanumeric code uniquely identifying the transmission operator within the interconnection. Used for interchange scheduling and NERC reporting.' ;
    rdfs:domain ind:Operator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operatorType rdf:type rdf:Property ;
    rdfs:label 'Operator Type' ;
    rdfs:comment 'Functional classification of the operator within the bulk electric system. Defines the operational role and regulatory responsibilities.' ;
    rdfs:domain ind:Operator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalTransmissionCapacityMw rdf:type rdf:Property ;
    rdfs:label 'Total Transmission Capacity Mw' ;
    rdfs:comment 'Total rated transmission capacity in megawatts managed by the operator across all transmission lines and substations.' ;
    rdfs:domain ind:Operator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:voltageClassRange rdf:type rdf:Property ;
    rdfs:label 'Voltage Class Range' ;
    rdfs:comment 'Range of voltage classes operated by the transmission operator, typically expressed as minimum to maximum kilovolts (e.g., 115 kV to 500 kV).' ;
    rdfs:domain ind:Operator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractEndDate rdf:type rdf:Property ;
    rdfs:label 'Contract End Date' ;
    rdfs:comment 'End date of the contract period for contractor crews. Null for internal crews or open-ended contracts. Used for contract renewal planning.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contractStartDate rdf:type rdf:Property ;
    rdfs:label 'Contract Start Date' ;
    rdfs:comment 'Start date of the contract period for contractor crews. Null for internal crews. Used for contract lifecycle management.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:crewClassification rdf:type rdf:Property ;
    rdfs:label 'Crew Classification' ;
    rdfs:comment 'Organizational classification of the crew. Internal crews are utility employees, contractor crews are third-party resources, mutual aid crews are from other utilities under mutual assistance agreements, emergency support crews are specialized external resources for major events.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crewLeadContact rdf:type rdf:Property ;
    rdfs:label 'Crew Lead Contact' ;
    rdfs:comment 'Primary contact phone number for the crew lead. Used for dispatch coordination and emergency communication.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crewLeadName rdf:type rdf:Property ;
    rdfs:label 'Crew Lead Name' ;
    rdfs:comment 'Full name of the crew lead or foreman responsible for directing crew activities and ensuring safety compliance.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crewNumber rdf:type rdf:Property ;
    rdfs:label 'Crew Number' ;
    rdfs:comment 'Business identifier for the crew, used in work orders and dispatch systems. Externally visible crew designation.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:daysSinceLastIncident rdf:type rdf:Property ;
    rdfs:label 'Days Since Last Incident' ;
    rdfs:comment 'Number of days since the last safety incident. Used for safety performance recognition and monitoring.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:emergencyResponseCapable rdf:type rdf:Property ;
    rdfs:label 'Emergency Response Capable' ;
    rdfs:comment 'Indicates whether this crew is equipped and trained for emergency outage restoration and storm response. Emergency-capable crews have specialized equipment and 24/7 availability.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hotLineQualified rdf:type rdf:Property ;
    rdfs:label 'Hot Line Qualified' ;
    rdfs:comment 'Indicates whether the crew is qualified to perform energized (hot) work on transmission lines. Requires specialized training and equipment per OSHA 1910.269.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hourlyRate rdf:type rdf:Property ;
    rdfs:label 'Hourly Rate' ;
    rdfs:comment 'Standard hourly billing rate for this crew in USD. Used for cost estimation and budget planning. Applies to contractor crews; may be average rate for internal crews.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastTrainingDate rdf:type rdf:Property ;
    rdfs:label 'Last Training Date' ;
    rdfs:comment 'Date of the most recent safety or technical training completed by this crew. Used to track training currency and compliance with NERC PER standards.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mutualAidEligible rdf:type rdf:Property ;
    rdfs:label 'Mutual Aid Eligible' ;
    rdfs:comment 'Indicates whether this crew can be deployed to assist other utilities under mutual assistance agreements during major events or emergencies.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nercCipClearance rdf:type rdf:Property ;
    rdfs:label 'Nerc Cip Clearance' ;
    rdfs:comment 'Indicates whether all crew members hold valid NERC CIP personnel risk assessment clearances required for access to Bulk Electric System (BES) Cyber Systems and associated physical security perimeters.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nextTrainingDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Training Due Date' ;
    rdfs:comment 'Date by which the crew must complete next required training to maintain qualifications. Used for training schedule planning and compliance tracking.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:overtimeRate rdf:type rdf:Property ;
    rdfs:label 'Overtime Rate' ;
    rdfs:comment 'Overtime hourly billing rate for this crew in USD. Used for after-hours and emergency work cost calculations.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:primaryEquipmentSpecialization rdf:type rdf:Property ;
    rdfs:label 'Primary Equipment Specialization' ;
    rdfs:comment 'Type of transmission equipment this crew specializes in (e.g., \'transmission towers\', \'power transformers\', \'circuit breakers\', \'disconnect switches\', \'series capacitors\', \'static VAR compensators\'). Free text to accommodate diverse equipment types.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:substationAccessAuthorized rdf:type rdf:Property ;
    rdfs:label 'Substation Access Authorized' ;
    rdfs:comment 'Indicates whether the crew is authorized for unescorted access to transmission substations. Requires NERC CIP training and background checks.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:vehicleFleetAssigned rdf:type rdf:Property ;
    rdfs:label 'Vehicle Fleet Assigned' ;
    rdfs:comment 'List or description of vehicles and mobile equipment assigned to this crew (e.g., bucket trucks, digger derricks, line trucks, trailers). Used for resource tracking and dispatch planning.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:voltageClassQualified rdf:type rdf:Property ;
    rdfs:label 'Voltage Class Qualified' ;
    rdfs:comment 'Voltage levels this crew is qualified and authorized to work on (e.g., \'69kV\', \'138kV\', \'230kV\', \'345kV\', \'500kV\'). Pipe-separated list for crews qualified at multiple voltage classes. Critical for safety and NERC CIP compliance.' ;
    rdfs:domain ind:Crew ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:areaId rdf:type rdf:Property ;
    rdfs:label 'Area Id' ;
    rdfs:comment 'Reference to the control area or balancing authority area to which this bus belongs. Used for interchange scheduling and area control error (ACE) calculations.' ;
    rdfs:domain ind:Bus ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ControlArea .

ind:besDesignation rdf:type rdf:Property ;
    rdfs:label 'Bes Designation' ;
    rdfs:comment 'Indicates whether this bus is part of the NERC-defined Bulk Electric System (BES). True if the bus meets BES criteria and is subject to NERC reliability standards and CIP compliance.' ;
    rdfs:domain ind:Bus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:generationMvar rdf:type rdf:Property ;
    rdfs:label 'Generation Mvar' ;
    rdfs:comment 'Reactive power generation at the bus in megavolt-amperes reactive (MVAR). Sum of all generator reactive outputs connected to this bus.' ;
    rdfs:domain ind:Bus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:generationMw rdf:type rdf:Property ;
    rdfs:label 'Generation Mw' ;
    rdfs:comment 'Active power generation at the bus in megawatts (MW). Sum of all generator outputs connected to this bus.' ;
    rdfs:domain ind:Bus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:loadMvar rdf:type rdf:Property ;
    rdfs:label 'Load Mvar' ;
    rdfs:comment 'Reactive power load at the bus in megavolt-amperes reactive (MVAR). Represents reactive demand connected to this bus.' ;
    rdfs:domain ind:Bus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:loadMw rdf:type rdf:Property ;
    rdfs:label 'Load Mw' ;
    rdfs:comment 'Active power load served at the bus in megawatts (MW). Represents demand connected to this bus.' ;
    rdfs:domain ind:Bus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:shuntSusceptanceMvar rdf:type rdf:Property ;
    rdfs:label 'Shunt Susceptance Mvar' ;
    rdfs:comment 'Fixed shunt susceptance at the bus in MVAR at nominal voltage. Represents capacitor banks or reactor banks permanently connected to the bus for voltage support.' ;
    rdfs:domain ind:Bus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:centroidLatitude rdf:type rdf:Property ;
    rdfs:label 'Centroid Latitude' ;
    rdfs:comment 'Latitude coordinate of the geographic centroid of the zone for mapping and spatial reference.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:centroidLongitude rdf:type rdf:Property ;
    rdfs:label 'Centroid Longitude' ;
    rdfs:comment 'Longitude coordinate of the geographic centroid of the zone for mapping and spatial reference.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commercialCustomerCount rdf:type rdf:Property ;
    rdfs:label 'Commercial Customer Count' ;
    rdfs:comment 'Number of commercial customers served within this zone.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:gasMainMiles rdf:type rdf:Property ;
    rdfs:label 'Gas Main Miles' ;
    rdfs:comment 'Total length of gas distribution mains within the zone measured in miles, applicable for gas or dual-service zones.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gasServiceLateralCount rdf:type rdf:Property ;
    rdfs:label 'Gas Service Lateral Count' ;
    rdfs:comment 'Number of gas service laterals (customer connections) within this zone.' ;
    rdfs:domain ind:Zone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:gisBoundaryWkt rdf:type rdf:Property ;
    rdfs:label 'Gis Boundary Wkt' ;
    rdfs:comment 'Geographic boundary of the zone represented in Well-Known Text format for GIS integration and spatial analysis.' ;
    rdfs:domain ind:Zone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:industrialCustomerCount rdf:type rdf:Property ;
    rdfs:label 'Industrial Customer Count' ;
    rdfs:comment 'Number of industrial customers served within this zone.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:poleCount rdf:type rdf:Property ;
    rdfs:label 'Pole Count' ;
    rdfs:comment 'Total number of utility poles within this zone used for overhead distribution infrastructure.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:residentialCustomerCount rdf:type rdf:Property ;
    rdfs:label 'Residential Customer Count' ;
    rdfs:comment 'Number of residential customers served within this zone.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:zoneClassification rdf:type rdf:Property ;
    rdfs:label 'Zone Classification' ;
    rdfs:comment 'Geographic and demographic classification of the zone based on customer density and land use patterns.' ;
    rdfs:domain ind:Zone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:annualEnergyConsumptionMwh rdf:type rdf:Property ;
    rdfs:label 'Annual Energy Consumption Mwh' ;
    rdfs:comment 'Total annual electric energy consumption for this service area measured in megawatt-hours.' ;
    rdfs:domain ind:ServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:annualGasThroughputMcf rdf:type rdf:Property ;
    rdfs:label 'Annual Gas Throughput Mcf' ;
    rdfs:comment 'Total annual natural gas throughput for this service area measured in thousand cubic feet.' ;
    rdfs:domain ind:ServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:areaSquareMiles rdf:type rdf:Property ;
    rdfs:label 'Area Square Miles' ;
    rdfs:comment 'Total geographic area covered by this service area measured in square miles.' ;
    rdfs:domain ind:ServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:distributionFeederCount rdf:type rdf:Property ;
    rdfs:label 'Distribution Feeder Count' ;
    rdfs:comment 'Number of electric distribution feeders operating within this service area.' ;
    rdfs:domain ind:ServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:distributionSubstationCount rdf:type rdf:Property ;
    rdfs:label 'Distribution Substation Count' ;
    rdfs:comment 'Number of distribution substations serving this service area.' ;
    rdfs:domain ind:ServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:electricOverheadLineMiles rdf:type rdf:Property ;
    rdfs:label 'Electric Overhead Line Miles' ;
    rdfs:comment 'Total length of overhead electric distribution lines within this service area measured in miles.' ;
    rdfs:domain ind:ServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:electricUndergroundLineMiles rdf:type rdf:Property ;
    rdfs:label 'Electric Underground Line Miles' ;
    rdfs:comment 'Total length of underground electric distribution lines within this service area measured in miles.' ;
    rdfs:domain ind:ServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:franchiseAgreementId rdf:type rdf:Property ;
    rdfs:label 'Franchise Agreement Id' ;
    rdfs:comment 'Reference to the franchise agreement governing utility operations in this service area.' ;
    rdfs:domain ind:ServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastBoundaryUpdateDate rdf:type rdf:Property ;
    rdfs:label 'Last Boundary Update Date' ;
    rdfs:comment 'Date when the geographic boundary of this service area was last modified in the Geographic Information System (GIS).' ;
    rdfs:domain ind:ServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:operatingDistrictId rdf:type rdf:Property ;
    rdfs:label 'Operating District Id' ;
    rdfs:comment 'Reference to the operating district responsible for maintenance and operations in this service area.' ;
    rdfs:domain ind:ServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:serviceAreaCode rdf:type rdf:Property ;
    rdfs:label 'Service Area Code' ;
    rdfs:comment 'Business identifier code for the service area used in operational systems and customer communications.' ;
    rdfs:domain ind:ServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceAreaType rdf:type rdf:Property ;
    rdfs:label 'Service Area Type' ;
    rdfs:comment 'Classification of the service area based on customer density and land use characteristics.' ;
    rdfs:domain ind:ServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceTransformerCount rdf:type rdf:Property ;
    rdfs:label 'Service Transformer Count' ;
    rdfs:comment 'Number of service transformers installed within this service area.' ;
    rdfs:domain ind:ServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:voltageClassPrimaryKv rdf:type rdf:Property ;
    rdfs:label 'Voltage Class Primary Kv' ;
    rdfs:comment 'Primary distribution voltage level serving this service area measured in kilovolts.' ;
    rdfs:domain ind:ServiceArea ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:annualEnergyDeliveredMwh rdf:type rdf:Property ;
    rdfs:label 'Annual Energy Delivered Mwh' ;
    rdfs:comment 'Total electric energy delivered to customers in the district annually, measured in megawatt-hours.' ;
    rdfs:domain ind:District ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:annualGasDeliveredMcf rdf:type rdf:Property ;
    rdfs:label 'Annual Gas Delivered Mcf' ;
    rdfs:comment 'Total natural gas delivered to customers in the district annually, measured in thousand cubic feet (MCF).' ;
    rdfs:domain ind:District ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:caidiIndex rdf:type rdf:Property ;
    rdfs:label 'Caidi Index' ;
    rdfs:comment 'Average outage duration per interrupted customer in minutes for the district. Calculated as SAIDI/SAIFI.' ;
    rdfs:domain ind:District ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:districtManagerName rdf:type rdf:Property ;
    rdfs:label 'District Manager Name' ;
    rdfs:comment 'Name of the manager responsible for operations within this district.' ;
    rdfs:domain ind:District ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:districtOfficeAddress rdf:type rdf:Property ;
    rdfs:label 'District Office Address' ;
    rdfs:comment 'Physical address of the district operations office.' ;
    rdfs:domain ind:District ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:districtOfficePhone rdf:type rdf:Property ;
    rdfs:label 'District Office Phone' ;
    rdfs:comment 'Primary contact phone number for the district operations office.' ;
    rdfs:domain ind:District ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:districtType rdf:type rdf:Property ;
    rdfs:label 'District Type' ;
    rdfs:comment 'Classification of the district by service type: electric-only, gas-only, or dual-service (both electric and gas).' ;
    rdfs:domain ind:District ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dmsDistrictCode rdf:type rdf:Property ;
    rdfs:label 'Dms District Code' ;
    rdfs:comment 'District identifier used in the Distribution Management System for real-time network monitoring and control.' ;
    rdfs:domain ind:District ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:electricCircuitMiles rdf:type rdf:Property ;
    rdfs:label 'Electric Circuit Miles' ;
    rdfs:comment 'Total length of electric distribution circuits in miles within the district.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gisDistrictCode rdf:type rdf:Property ;
    rdfs:label 'Gis District Code' ;
    rdfs:comment 'District identifier used in the GIS for spatial network topology and asset mapping.' ;
    rdfs:domain ind:District ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:omsDistrictCode rdf:type rdf:Property ;
    rdfs:label 'Oms District Code' ;
    rdfs:comment 'District identifier used in the Outage Management System for outage event tracking and dispatch.' ;
    rdfs:domain ind:District ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regionId rdf:type rdf:Property ;
    rdfs:label 'Region Id' ;
    rdfs:comment 'Reference to the operational region that this district is part of for organizational hierarchy.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:saidiIndex rdf:type rdf:Property ;
    rdfs:label 'Saidi Index' ;
    rdfs:comment 'Average outage duration per customer in minutes for the district, excluding major events. Key reliability metric.' ;
    rdfs:domain ind:District ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:saifiIndex rdf:type rdf:Property ;
    rdfs:label 'Saifi Index' ;
    rdfs:comment 'Average number of interruptions per customer for the district, excluding major events. Key reliability metric.' ;
    rdfs:domain ind:District ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:serviceAreaSquareMiles rdf:type rdf:Property ;
    rdfs:label 'Service Area Square Miles' ;
    rdfs:comment 'Geographic area covered by the district measured in square miles.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:substationCount rdf:type rdf:Property ;
    rdfs:label 'Substation Count' ;
    rdfs:comment 'Number of distribution substations located within or serving the district.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:derIntegrationEnabled rdf:type rdf:Property ;
    rdfs:label 'Der Integration Enabled' ;
    rdfs:comment 'Indicates whether the network model supports integration of distributed energy resources such as solar, wind, and battery storage systems.' ;
    rdfs:domain ind:NetworkModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gasPipelineSafetyCompliant rdf:type rdf:Property ;
    rdfs:label 'Gas Pipeline Safety Compliant' ;
    rdfs:comment 'Indicates whether the network model for gas distribution infrastructure complies with Pipeline and Hazardous Materials Safety Administration (PHMSA) safety regulations.' ;
    rdfs:domain ind:NetworkModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gisLayerReference rdf:type rdf:Property ;
    rdfs:label 'Gis Layer Reference' ;
    rdfs:comment 'Reference identifier to the GIS layer or spatial dataset that contains the geographic representation of this network model.' ;
    rdfs:domain ind:NetworkModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastValidationDate rdf:type rdf:Property ;
    rdfs:label 'Last Validation Date' ;
    rdfs:comment 'Date when the network model was last validated for accuracy, completeness, and alignment with physical infrastructure.' ;
    rdfs:domain ind:NetworkModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:modelDescription rdf:type rdf:Property ;
    rdfs:label 'Model Description' ;
    rdfs:comment 'Detailed textual description of the network model, including its purpose, scope, coverage area, and key characteristics.' ;
    rdfs:domain ind:NetworkModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelName rdf:type rdf:Property ;
    rdfs:label 'Model Name' ;
    rdfs:comment 'Human-readable name or designation of the network model used for identification and reference purposes.' ;
    rdfs:domain ind:NetworkModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Model Source System' ;
    rdfs:comment 'Name or identifier of the source system from which the network model data originates, such as GIS, OMS, DMS, or ADMS.' ;
    rdfs:domain ind:NetworkModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelStatus rdf:type rdf:Property ;
    rdfs:label 'Model Status' ;
    rdfs:comment 'Current lifecycle status of the network model, indicating whether it is active for operational use, in draft, archived, or deprecated.' ;
    rdfs:domain ind:NetworkModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelVersion rdf:type rdf:Property ;
    rdfs:label 'Model Version' ;
    rdfs:comment 'Version identifier of the network model, tracking iterations and updates to the model configuration.' ;
    rdfs:domain ind:NetworkModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nodeCount rdf:type rdf:Property ;
    rdfs:label 'Node Count' ;
    rdfs:comment 'Total number of nodes (connection points, junctions, or vertices) represented in the network model topology.' ;
    rdfs:domain ind:NetworkModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reliabilityIndexCaidi rdf:type rdf:Property ;
    rdfs:label 'Reliability Index Caidi' ;
    rdfs:comment 'Customer Average Interruption Duration Index calculated for the network model, measuring average outage duration per customer interruption in minutes.' ;
    rdfs:domain ind:NetworkModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reliabilityIndexSaidi rdf:type rdf:Property ;
    rdfs:label 'Reliability Index Saidi' ;
    rdfs:comment 'System Average Interruption Duration Index calculated for the network model, measuring average outage duration per customer in minutes per year.' ;
    rdfs:domain ind:NetworkModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reliabilityIndexSaifi rdf:type rdf:Property ;
    rdfs:label 'Reliability Index Saifi' ;
    rdfs:comment 'System Average Interruption Frequency Index calculated for the network model, measuring average number of interruptions per customer per year.' ;
    rdfs:domain ind:NetworkModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:segmentCount rdf:type rdf:Property ;
    rdfs:label 'Segment Count' ;
    rdfs:comment 'Total number of line segments or edges connecting nodes in the network model.' ;
    rdfs:domain ind:NetworkModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:topologyType rdf:type rdf:Property ;
    rdfs:label 'Topology Type' ;
    rdfs:comment 'Physical topology configuration of the network model, describing the structural arrangement of feeders, nodes, and interconnections.' ;
    rdfs:domain ind:NetworkModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalCircuitMiles rdf:type rdf:Property ;
    rdfs:label 'Total Circuit Miles' ;
    rdfs:comment 'Total length of all circuits in the network model measured in miles, representing the cumulative distance of distribution infrastructure.' ;
    rdfs:domain ind:NetworkModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:updatedBy rdf:type rdf:Property ;
    rdfs:label 'Updated By' ;
    rdfs:comment 'Identifier of the user or system that last updated this network model record.' ;
    rdfs:domain ind:NetworkModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:annualEnergySalesMwh rdf:type rdf:Property ;
    rdfs:label 'Annual Energy Sales Mwh' ;
    rdfs:comment 'Total electric energy sold annually within the service territory measured in megawatt-hours.' ;
    rdfs:domain ind:ServiceTerritory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:boundaryDescription rdf:type rdf:Property ;
    rdfs:label 'Boundary Description' ;
    rdfs:comment 'Textual description of the geographic boundaries defining the service territory, including landmarks and jurisdictional limits.' ;
    rdfs:domain ind:ServiceTerritory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:boundaryGeojson rdf:type rdf:Property ;
    rdfs:label 'Boundary Geojson' ;
    rdfs:comment 'GeoJSON representation of the service territory polygon for GIS mapping and spatial analysis.' ;
    rdfs:domain ind:ServiceTerritory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:franchiseAgreementNumber rdf:type rdf:Property ;
    rdfs:label 'Franchise Agreement Number' ;
    rdfs:comment 'Identifier for the municipal or county franchise agreement authorizing utility service in the territory.' ;
    rdfs:domain ind:ServiceTerritory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:franchiseExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Franchise Expiration Date' ;
    rdfs:comment 'Date on which the current franchise agreement expires and requires renewal or renegotiation.' ;
    rdfs:domain ind:ServiceTerritory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:gasPipelineMiles rdf:type rdf:Property ;
    rdfs:label 'Gas Pipeline Miles' ;
    rdfs:comment 'Total length of natural gas distribution pipeline infrastructure within the service territory measured in miles.' ;
    rdfs:domain ind:ServiceTerritory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gasThroughputMcf rdf:type rdf:Property ;
    rdfs:label 'Gas Throughput Mcf' ;
    rdfs:comment 'Total natural gas volume delivered annually within the service territory measured in thousand cubic feet.' ;
    rdfs:domain ind:ServiceTerritory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:operatingCompanyId rdf:type rdf:Property ;
    rdfs:label 'Operating Company Id' ;
    rdfs:comment 'Reference to the legal operating entity responsible for utility service delivery within this territory.' ;
    rdfs:domain ind:ServiceTerritory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:populationServed rdf:type rdf:Property ;
    rdfs:label 'Population Served' ;
    rdfs:comment 'Estimated total population residing within the service territory boundaries.' ;
    rdfs:domain ind:ServiceTerritory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:territoryName rdf:type rdf:Property ;
    rdfs:label 'Territory Name' ;
    rdfs:comment 'Human-readable name of the service territory, typically reflecting geographic or administrative boundaries.' ;
    rdfs:domain ind:ServiceTerritory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:territoryType rdf:type rdf:Property ;
    rdfs:label 'Territory Type' ;
    rdfs:comment 'Classification of the service territory by utility service type provided within the geographic area.' ;
    rdfs:domain ind:ServiceTerritory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:urbanRuralClassification rdf:type rdf:Property ;
    rdfs:label 'Urban Rural Classification' ;
    rdfs:comment 'Demographic classification of the service territory based on population density and development patterns.' ;
    rdfs:domain ind:ServiceTerritory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:organizationId rdf:type rdf:Property ;
    rdfs:label 'Organization Id' ;
    rdfs:comment 'Primary key for organization' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:annualBudgetAmount rdf:type rdf:Property ;
    rdfs:label 'Annual Budget Amount' ;
    rdfs:comment 'Total approved budget for the current fiscal year in US dollars. Used for budget variance analysis and financial planning.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:budgetOwnerId rdf:type rdf:Property ;
    rdfs:label 'Budget Owner Id' ;
    rdfs:comment 'Reference to the employee or executive responsible for budget planning and variance management for this organization.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isRegulated rdf:type rdf:Property ;
    rdfs:label 'Is Regulated' ;
    rdfs:comment 'Indicates whether this organization is subject to regulatory oversight and rate regulation. True for generation, transmission, and distribution organizations; false for unregulated competitive business units.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:legalEntityId rdf:type rdf:Property ;
    rdfs:label 'Legal Entity Id' ;
    rdfs:comment 'Identifier of the legal entity that owns or operates this organization. Used for consolidation in GAAP financial statements and SOX compliance reporting.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:managerId rdf:type rdf:Property ;
    rdfs:label 'Manager Id' ;
    rdfs:comment 'Reference to the employee who manages this organization unit. Used for accountability and approval workflows.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:organizationCode rdf:type rdf:Property ;
    rdfs:label 'Organization Code' ;
    rdfs:comment 'Unique business identifier code for the organization used in financial reporting and cost allocation. Typically assigned by the enterprise resource planning system.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:organizationLevel rdf:type rdf:Property ;
    rdfs:label 'Organization Level' ;
    rdfs:comment 'Numeric level in the organizational hierarchy where 1 represents the top level (enterprise) and higher numbers represent deeper nested levels. Used for roll-up reporting and consolidation.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:organizationName rdf:type rdf:Property ;
    rdfs:label 'Organization Name' ;
    rdfs:comment 'Full legal or business name of the organization unit. Used for financial reporting, regulatory filings, and internal cost center identification.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:organizationShortName rdf:type rdf:Property ;
    rdfs:label 'Organization Short Name' ;
    rdfs:comment 'Abbreviated name or acronym for the organization used in reports and user interfaces.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:organizationType rdf:type rdf:Property ;
    rdfs:label 'Organization Type' ;
    rdfs:comment 'Classification of the organization entity indicating its role in the financial structure. Cost centers track expenses only; profit centers track both revenue and expenses; business units are strategic operational divisions; departments are functional groups; divisions are major organizational segments; subsidiaries are legally separate entities.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentOrganizationId rdf:type rdf:Property ;
    rdfs:label 'Parent Organization Id' ;
    rdfs:comment 'Reference to the parent organization in the hierarchy. Null for top-level organizations. Enables hierarchical cost allocation and financial consolidation.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:soxScopeFlag rdf:type rdf:Property ;
    rdfs:label 'Sox Scope Flag' ;
    rdfs:comment 'Indicates whether this organization is within the scope of SOX internal controls testing and audit requirements. True for organizations with material financial impact.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:taxIdentificationNumber rdf:type rdf:Property ;
    rdfs:label 'Tax Identification Number' ;
    rdfs:comment 'Federal employer identification number (EIN) or tax ID assigned to this organization for tax reporting purposes. Format: XX-XXXXXXX.' ;
    rdfs:domain ind:Organization ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appealFiledFlag rdf:type rdf:Property ;
    rdfs:label 'Appeal Filed Flag' ;
    rdfs:comment 'Indicates whether the utility has filed an appeal or contest of the violation finding or penalty.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appealOutcome rdf:type rdf:Property ;
    rdfs:label 'Appeal Outcome' ;
    rdfs:comment 'The final outcome of the appeal process, if an appeal was filed.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetId rdf:type rdf:Property ;
    rdfs:label 'Asset Id' ;
    rdfs:comment 'Identifier of the specific asset or equipment involved in the violation event.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:correctiveActionSummary rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Summary' ;
    rdfs:comment 'Summary of corrective actions taken or planned to prevent recurrence of the violation.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discoveryDate rdf:type rdf:Property ;
    rdfs:label 'Discovery Date' ;
    rdfs:comment 'The date on which the violation was first identified or discovered by the utility or regulatory body.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:impactDescription rdf:type rdf:Property ;
    rdfs:label 'Impact Description' ;
    rdfs:comment 'Description of the actual or potential impact of the violation on system reliability, safety, environment, or customers.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mitigationCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Mitigation Completion Date' ;
    rdfs:comment 'The actual date on which all mitigation activities were completed and verified.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mitigationDueDate rdf:type rdf:Property ;
    rdfs:label 'Mitigation Due Date' ;
    rdfs:comment 'The deadline by which corrective actions must be completed to remedy the violation.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mitigationPlanId rdf:type rdf:Property ;
    rdfs:label 'Mitigation Plan Id' ;
    rdfs:comment 'Identifier of the formal mitigation plan submitted to address the violation.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:occurrenceDate rdf:type rdf:Property ;
    rdfs:label 'Occurrence Date' ;
    rdfs:comment 'The date on which the violation actually occurred or the non-compliance event took place.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:penaltyCurrency rdf:type rdf:Property ;
    rdfs:label 'Penalty Currency' ;
    rdfs:comment 'Currency code for the penalty amount. Utility operates in US dollars.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publicDisclosureFlag rdf:type rdf:Property ;
    rdfs:label 'Public Disclosure Flag' ;
    rdfs:comment 'Indicates whether the violation has been publicly disclosed or reported in regulatory filings.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:repeatViolationFlag rdf:type rdf:Property ;
    rdfs:label 'Repeat Violation Flag' ;
    rdfs:comment 'Indicates whether this is a repeat violation of the same standard within the lookback period.' ;
    rdfs:domain ind:Violation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rootCauseAnalysis rdf:type rdf:Property ;
    rdfs:label 'Root Cause Analysis' ;
